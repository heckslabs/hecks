{
  "domain": "examples/banking",
  "source_fixture": "given_first_failure_wins.json",
  "note": "Register, Open, Suspend: the suspension policy freezes the account and its save refreshes customer_status.",
  "steps": [
    {
      "verb": "Banking::Customer.Register",
      "args": {
        "reference": {
          "value": "cust-1"
        },
        "name": {
          "given": "Ada",
          "family": "Lovelace"
        },
        "email": {
          "address": "ada@example.com"
        }
      }
    },
    {
      "verb": "Banking::Account.Open",
      "args": {
        "customer": "cust-1",
        "number": {
          "value": "acct-1"
        },
        "kind": {
          "name": "current"
        },
        "daily_limit": {
          "cents": 50000
        }
      }
    },
    {
      "verb": "Banking::Customer.Suspend",
      "args": {
        "reference": {
          "value": "cust-1"
        },
        "standing": {
          "value": "under review"
        }
      }
    }
  ],
  "expect": {
    "instances": {
      "Banking::Customer#cust-1": {
        "reference": {"value":"cust-1"},
        "name": {"given":"Ada","family":"Lovelace"},
        "email": {"address":"ada@example.com"},
        "standing": {"value":"under review"},
        "status": "suspended"
      },
      "Banking::Account#acct-1": {
        "customer": "cust-1",
        "number": {"value":"acct-1"},
        "balance": {"cents":0,"currency":"USD"},
        "kind": {"name":"current"},
        "daily_limit": {"cents":50000},
        "ledger": [],
        "fees_cents": {"cents":0,"currency":"USD"},
        "interest_cents": {"cents":0,"currency":"USD"},
        "status": "frozen",
        "customer_status": "suspended"
      }
    },
    "events": [
      {
        "name": "CustomerRegistered",
        "aggregate": "Banking::Customer",
        "id": "cust-1",
        "payload": {
          "reference": {"value":"cust-1"},
          "name": {"given":"Ada","family":"Lovelace"},
          "email": {"address":"ada@example.com"}
        }
      },
      {
        "name": "AccountOpened",
        "aggregate": "Banking::Account",
        "id": "acct-1",
        "payload": {
          "customer": "cust-1",
          "number": {"value":"acct-1"},
          "kind": {"name":"current"},
          "daily_limit": {"cents":50000}
        }
      },
      {
        "name": "CustomerSuspended",
        "aggregate": "Banking::Customer",
        "id": "cust-1",
        "payload": {
          "reference": {
            "value": "cust-1"
          },
          "standing": {"value":"under review"}
        }
      },
      {
        "name": "AccountFrozen",
        "aggregate": "Banking::Account",
        "id": "acct-1",
        "payload": {}
      }
    ],
    "refusals": []
  }
}
