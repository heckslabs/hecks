Hecks.behaviors "Harness" do
  vision "A session opens on a brief and runs until it is stopped; a message one session sends another is posted here, delivered by policy and timed from sent to delivered."

  # No supervisor runs in a behaviors boot, so every ask is refused: a session is not opened and a
  # message is not delivered. The run with a supervisor is the Harness spec's, over replay tapes.
  loads "harness.hecksagon", "harness.bluebook"

  test "a session opened with no supervisor running is refused its child" do
    tests "Open", on: "Session"
    input name: { value: "reviewer" }, brief: { value: "You are the reviewer." }
    expect emits: %w[SessionOpenRequested SessionNotSpawned SessionNotOpened], status: "refused"
  end

  test "a session with no brief is not opened" do
    tests "Open", on: "Session"
    input name: { value: "reviewer" }, brief: { value: "" }
    expect refused: "Brief.value must match"
  end

  test "a session that never ran is not stopped" do
    tests "Stop", on: "Session"
    setup "Harness::Session.Open", name: { value: "reviewer" }, brief: { value: "You are the reviewer." }
    input session: "reviewer"
    expect refused: "Stop moves it only from"
  end

  test "a turn is not recorded for a session that never ran" do
    tests "RecordTurnEnded", on: "Session"
    setup "Harness::Session.Open", name: { value: "reviewer" }, brief: { value: "You are the reviewer." }
    input session: "reviewer", said: { value: "done" }, outcome: { value: "success" }
    expect refused: "a turn ends only in a session that runs or is stopping"
  end

  test "a message posted with no supervisor running is undeliverable" do
    tests "Post", on: "Message"
    input key: { value: "reviewer-1" }, sender: { value: "reviewer" }, addressee: { value: "coder" },
          text: { value: "Does post! refuse zero?" }, sent_at: { value: 100 }, about: nil, urgency: nil
    expect emits: %w[MessagePosted DeliveryRefused MessageUndeliverable], status: "undeliverable"
  end

  test "a message about another, sent with no supervisor running, is undeliverable" do
    tests "Post", on: "Message"
    input key: { value: "coder-1" }, sender: { value: "coder" }, addressee: { value: "reviewer" },
          text: { value: "It refuses zero." }, sent_at: { value: 200 }, about: { value: "reviewer-1" },
          urgency: nil
    expect emits: %w[MessagePosted DeliveryRefused MessageUndeliverable], status: "undeliverable"
  end

  # With no supervisor a coder's question goes on to the lead at once. Its reactions reach the
  # depth limit, where the two behaviors runners differ, so these check where it ended; the scrum
  # master spec checks each event in order.
  test "a coder's question for the orchestrator is routed to the scrum master, and handed on when it is not reached" do
    tests "Post", on: "Message"
    input key: { value: "coder-1" }, sender: { value: "coder" }, addressee: { value: "orchestrator" },
          text: { value: "May I land before the freeze lifts?" }, sent_at: { value: 300 }, about: nil, urgency: nil
    expect hold: "handed-on", addressee: "orchestrator"
  end

  test "a coder's question for the scrum master is held, and handed on when it is not reached" do
    tests "Post", on: "Message"
    input key: { value: "coder-1" }, sender: { value: "coder" }, addressee: { value: "scrum-master" },
          text: { value: "May I land before the freeze lifts?" }, sent_at: { value: 300 }, about: nil, urgency: nil
    expect hold: "handed-on", addressee: "orchestrator"
  end

  test "a coder's answer to the orchestrator goes straight to it" do
    tests "Post", on: "Message"
    input key: { value: "coder-2" }, sender: { value: "coder" }, addressee: { value: "orchestrator" },
          text: { value: "Done; the branch is green." }, sent_at: { value: 400 }, about: { value: "orchestrator-1" },
          urgency: nil
    expect emits: %w[MessagePosted DeliveryRefused MessageUndeliverable], hold: "none", addressee: "orchestrator"
  end

  test "a run whose session is refused its child is refused, and never started" do
    tests "Start", on: "AgentRun"
    input run: { value: "work-1" }, session: { value: "coder" }, brief: { value: "You are the coder." }
    expect emits: %w[RunRequested SessionOpenRequested SessionNotSpawned SessionNotOpened RunRefused],
           status: "refused", condition: ""
  end

  test "a run with no brief is not started" do
    tests "Start", on: "AgentRun"
    input run: { value: "work-1" }, session: { value: "coder" }, brief: { value: "" }
    expect refused: "Brief.value must match"
  end

  test "a session that never stopped is not reopened" do
    tests "Reopen", on: "Session"
    setup "Harness::Session.Open", name: { value: "scrum-master" }, brief: { value: "You are the scrum master." }
    input session: "scrum-master", brief: { value: "You are the scrum master." }
    expect refused: "Reopen moves it only from"
  end

  test "a seat's next run whose session never ran waits, and is never started" do
    tests "TakeSeat", on: "AgentRun"
    input run: { value: "seat-2" }, session: { value: "scrum-master" }, brief: { value: "You are the scrum master." }
    expect emits: %w[SeatRunRequested], status: "requested", condition: ""
  end

  test "a tick of the clock is recorded at its moment" do
    tests "Tick", on: "Clock"
    input reading: { value: "tick-60000" }, now: { value: 60_000 }
    expect emits: %w[ClockTicked]
  end

  test "an urgent message is posted urgent, and undeliverable with no supervisor running" do
    tests "Post", on: "Message"
    input key: { value: "lead-1" }, sender: { value: "lead" }, addressee: { value: "worker" },
          text: { value: "Stop: main moved under your branch." }, sent_at: { value: 500 }, about: nil,
          urgency: { value: "urgent" }
    expect emits: %w[MessagePosted DeliveryRefused MessageUndeliverable], urgency: "urgent"
  end

  test "a message is not posted with an urgency other than normal or urgent" do
    tests "Post", on: "Message"
    input key: { value: "lead-1" }, sender: { value: "lead" }, addressee: { value: "worker" },
          text: { value: "Soon, please." }, sent_at: { value: 500 }, about: nil, urgency: { value: "soon" }
    expect refused: "Urgency admits"
  end

  test "a turn is not recorded as cut short for a session that never ran" do
    tests "RecordInterrupted", on: "Session"
    setup "Harness::Session.Open", name: { value: "worker" }, brief: { value: "You are the worker." }
    input session: "worker", cutter: { value: "lead-1" }
    expect refused: "only a turn of a session that runs or is stopping is cut short"
  end

  test "a message with no text is not posted" do
    tests "Post", on: "Message"
    input key: { value: "reviewer-1" }, sender: { value: "reviewer" }, addressee: { value: "coder" },
          text: { value: "" }, sent_at: { value: 100 }
    expect refused: "MessageText.value must match"
  end

  test "a sprint's first hour is recorded as its baseline" do
    tests "Record", on: "Baseline"
    input key: { value: "2026-11-28/first_hour" }, sprint: { value: "2026-11-28" }, window: { value: "first_hour" },
          minutes: { value: 60 }, tokens_per_minute: { value: 41000.5 }, items_per_hour: { value: 3.0 },
          cache_hit_rate: { value: 0.62 }, by_role: { value: "coder=30000/0.7" }
    expect emits: %w[BaselineRecorded]
  end

  test "the same window of the same sprint is not recorded twice" do
    tests "Record", on: "Baseline"
    setup "Harness::Baseline.Record", key: { value: "2026-11-28/first_hour" }, sprint: { value: "2026-11-28" }, window: { value: "first_hour" },
          minutes: { value: 60 }, tokens_per_minute: { value: 41000.5 }, items_per_hour: { value: 3.0 },
          cache_hit_rate: { value: 0.62 }, by_role: { value: "coder=30000/0.7" }
    input key: { value: "2026-11-28/first_hour" }, sprint: { value: "2026-11-28" }, window: { value: "first_hour" },
          minutes: { value: 60 }, tokens_per_minute: { value: 41000.5 }, items_per_hour: { value: 3.0 },
          cache_hit_rate: { value: 0.62 }, by_role: { value: "coder=30000/0.7" }
    expect refused: "already exists"
  end

  test "a baseline is recorded for the first hour or the fourth, no other window" do
    tests "Record", on: "Baseline"
    input key: { value: "2026-11-28/hour_4" }, sprint: { value: "2026-11-28" }, window: { value: "hour_9" },
          minutes: { value: 60 }, tokens_per_minute: { value: 41000.5 }, items_per_hour: { value: 3.0 },
          cache_hit_rate: { value: 0.62 }, by_role: { value: "coder=30000/0.7" }
    expect refused: "BaselineWindow admits"
  end

  test "a cache hit rate above one is not recorded" do
    tests "Record", on: "Baseline"
    input key: { value: "2026-11-28/first_hour" }, sprint: { value: "2026-11-28" }, window: { value: "first_hour" },
          minutes: { value: 60 }, tokens_per_minute: { value: 41000.5 }, items_per_hour: { value: 3.0 },
          cache_hit_rate: { value: 1.4 }, by_role: { value: "coder=30000/0.7" }
    expect refused: "a rate is between 0 and 1"
  end
end
