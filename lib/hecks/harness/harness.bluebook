# The Harness: agent sessions run inside Hecks. Each session is a Claude Code child the harness
# supervisor (rust/harness) holds. What one session sends another is posted here as a Message, and
# the bluebook's policy delivers it, so every message, its sender and its delivery are on record.

Hecks.bluebook "Harness" do
  vision "A session opens on a brief and runs until it is stopped; a message one session sends another is posted here, delivered by policy and timed from sent to delivered."

  supporting

  # One session: a Claude Code child the supervisor holds, from its opening to its exit. A session
  # that stopped can be reopened, so a standing seat keeps its name across the sessions that fill it,
  # and each one starts from the handover the last one left.
  aggregate "Session" do
    description "One agent session: its name, its brief, the Claude session it became, the handover it leaves its seat, and where it stands from opening to stopped."

    identified_by :name

    attribute :name,     SessionName
    attribute :brief,    Brief
    attribute :claude,   ClaudeSession, optional: true
    attribute :handover, Handover, optional: true

    value_object "SessionName" do
      attribute :value, String, matches: :present
    end

    value_object "Brief" do
      attribute :value, String, matches: :present
    end

    # The id Claude Code gave the session, so a transcript can be found again.
    value_object "ClaudeSession" do
      attribute :value, String, matches: :present
    end

    value_object "ToolName" do
      attribute :value, String, matches: :present
    end

    # The role a session was opened for, the one whose tools it holds.
    value_object "RoleName" do
      attribute :value, String, matches: :present
    end

    # Why a tool was refused, in the words the model was told.
    value_object "Reason" do
      attribute :value, String, matches: :present
    end

    # What the model said last in a turn; an empty turn says nothing.
    value_object "TurnText" do
      attribute :value, String, default: ""
    end

    # What the session said at the end of its last turn that said something: where it stopped, which
    # the next session opened in its seat is told after its brief.
    value_object "Handover" do
      attribute :value, String, matches: :present
    end

    value_object "Outcome" do
      attribute :value, String, one_of: ["success", "error"]
    end

    # The child's exit code as text; empty when the child was killed.
    value_object "ExitCode" do
      attribute :value, String, default: ""
    end

    # The urgent message that cut a turn short, by its key.
    value_object "Cutter" do
      attribute :value, String, matches: :present
    end

    lifecycle :status, default: "opening" do
      transition "RecordRunning"   => "running",  from: "opening"
      transition "RecordNotOpened" => "refused",  from: "opening"
      transition "Stop"            => "stopping", from: "running"
      transition "RecordStopped"   => "stopped",  from: ["running", "stopping"]
      transition "Reopen"          => "opening",  from: "stopped"
      # A session runs until it is stopped, and a stopping child is killed by the supervisor once
      # its grace runs out, so neither state is a wait the bluebook times. A stopped session waits
      # for its seat to be filled again, which no clock decides.
      mark :rests, "running", "stopping", "stopped"
      mark :terminal, "refused"
    end

    command "Open" do
      role "Owner"
      goal "Open a session on a brief, and ask the supervisor for its child"

      attribute :name,  SessionName
      attribute :brief, Brief

      emits "SessionOpenRequested"
    end

    command "RecordRunning" do
      role "System"
      policy_only
      goal "Record the session running, once the supervisor started its child"

      reference_to Session

      emits "SessionRunning"
    end

    command "RecordNotOpened" do
      role "System"
      policy_only
      goal "Record that the supervisor did not start the session's child"

      reference_to Session

      emits "SessionNotOpened"
    end

    command "RecordStarted" do
      role "System"
      goal "Record the Claude session id the child reported"

      reference_to Session
      attribute :claude, ClaudeSession, sets: true

      given("a session reports its Claude session only while it runs") { status == "running" }

      emits "SessionStarted"
    end

    command "RecordTurnEnded" do
      role "System"
      goal "Record that one of the session's turns ended, with its last words"

      reference_to Session
      attribute :said,    TurnText
      attribute :outcome, Outcome

      given("a turn ends only in a session that runs or is stopping") { status == "running" || status == "stopping" }

      emits "TurnEnded"
    end

    # An urgent message did not wait for the turn: the supervisor interrupted it, the cut turn's end
    # is recorded as an error, and the urgent message is the session's next turn.
    command "RecordInterrupted" do
      role "System"
      goal "Record that an urgent message cut the session's running turn short"

      reference_to Session
      attribute :cutter, Cutter

      given("only a turn of a session that runs or is stopping is cut short") { status == "running" || status == "stopping" }

      emits "TurnInterrupted"
    end

    # A turn that said something leaves the session's handover: the last words its seat's next
    # session starts from.
    command "RecordHandover" do
      role "System"
      policy_only
      goal "Record what the session said at the end of a turn as the handover it leaves its seat"

      reference_to Session
      attribute :handover, Handover, sets: true

      given("a session leaves a handover only while it runs or is stopping") { status == "running" || status == "stopping" }

      emits "HandoverLeft"
    end

    # The session asked for a tool the harness withholds; the model was told and went on.
    # A session opened for a role holds the tools its role names; the supervisor allows a use of one
    # of them, and both answers are recorded.
    command "RecordAllowed" do
      role "System"
      goal "Record a tool the session asked for and was allowed, as one its role names"

      reference_to Session
      attribute :tool, ToolName
      attribute :role, RoleName, optional: true

      emits "ToolAllowed"
    end

    command "RecordWithheld" do
      role "System"
      goal "Record a tool the session asked for and was refused"

      reference_to Session
      attribute :tool,   ToolName
      attribute :role,   RoleName, optional: true
      attribute :reason, Reason, optional: true

      emits "ToolWithheld"
    end

    command "Stop" do
      role "Owner"
      goal "Stop a running session, and ask the supervisor to close its child"

      reference_to Session

      emits "SessionStopRequested"
    end

    command "RecordStopped" do
      role "System"
      goal "Record that the session's child exited"

      reference_to Session
      attribute :code, ExitCode

      emits "SessionStopped"
    end

    # The next session in a standing seat: the seat's name and its handover stay, and the new child
    # is told its brief and then the handover the last session left.
    command "Reopen" do
      role "Owner"
      goal "Reopen a stopped session on a brief, and ask the supervisor for a child that starts from its handover"

      reference_to Session
      attribute :brief, Brief, sets: true

      emits "SessionReopenRequested"
    end
  end

  policy "OpenTheSessionsChild" do
    on  "Session.SessionOpenRequested"
    ask :open_session, with: { name: :name, brief: :brief }
  end

  policy "RecordTheSessionRunning" do
    on      "Session.SessionSpawned"
    acts_as "System"
    trigger Session::RecordRunning, with: { session: :name }
  end

  policy "RecordTheSessionNotOpened" do
    on      "Session.SessionNotSpawned"
    acts_as "System"
    trigger Session::RecordNotOpened, with: { session: :name }
  end

  policy "CloseTheSessionsChild" do
    on  "Session.SessionStopRequested"
    ask :stop_session, with: { name: :session }
  end

  # The supervisor is handed the session as the ledger holds it, its handover with it.
  policy "ReopenTheSessionsChild" do
    on  "Session.SessionReopenRequested"
    ask :reopen_session, with: { name: :name }
  end

  # A turn that said nothing leaves the last handover as it was.
  policy "LeaveTheSessionsHandover" do
    on      "Session.TurnEnded"
    acts_as "System"
    where   { said.value != "" }
    trigger Session::RecordHandover, with: { session: :session, handover: :said }
  end

  # One role's work in a session. A turn that ends with the role's closing words is a report, not
  # an end: the session may be answered and work on. The run is finished only when the session's
  # child exited, and how it exited says whether it ended done or failed.
  aggregate "AgentRun" do
    description "One role's work in a harness session: started with its session, holding the session's last report, and finished only when the session ended."

    identified_by :run

    attribute :run,       RunKey
    attribute :session,   Seat
    attribute :brief,     Brief
    attribute :report,    Said, optional: true
    attribute :condition, Condition
    attribute :code,      ExitCode

    # The run's own key, such as the work item a coder serves.
    value_object "RunKey" do
      attribute :value, String, matches: :present
    end

    # The session the run works in, by name.
    value_object "Seat" do
      attribute :value, String, matches: :present
    end

    value_object "Brief" do
      attribute :value, String, matches: :present
    end

    # What the session said at the end of its last turn that said something.
    value_object "Said" do
      attribute :value, String, matches: :present
    end

    # How the run ended: done when the session's child exited cleanly, failed otherwise.
    value_object "Condition" do
      attribute :value, String, default: "", one_of: ["", "done", "failed"]
    end

    # The session's exit code as text, as the Session records it; empty until it ended.
    value_object "ExitCode" do
      attribute :value, String, default: ""
    end

    lifecycle :status, default: "requested" do
      transition "Begin"   => "started",  from: "requested"
      transition "Decline" => "refused",  from: "requested"
      transition "Finish"  => "finished", from: "started"
      # A requested run waits only for the supervisor's answer to its session's open, and a started
      # one on its session, which runs until it is stopped or exits. An ended run frees its key for
      # the next run of the work item.
      mark :rests, "requested", "started"
      mark :terminal, "finished", "refused"
      mark :reusable, "finished", "refused"
    end

    command "Start" do
      role "Owner"
      goal "Start a run of one role, opening its session on the brief"

      attribute :run,     RunKey
      attribute :session, Seat
      attribute :brief,   Brief

      emits "RunRequested"
    end

    # A standing seat's next run: its session stopped and is reopened, starting from the handover
    # its last run left. A seat whose session still runs refuses the reopening, and the run waits.
    command "TakeSeat" do
      role "Owner"
      goal "Start a run in a standing seat whose session stopped, reopening it on the brief to start from its handover"

      attribute :run,     RunKey
      attribute :session, Seat
      attribute :brief,   Brief

      emits "SeatRunRequested"
    end

    command "Begin" do
      role "System"
      policy_only
      goal "Record the run started, once its session runs"

      reference_to AgentRun

      emits "RunStarted"
    end

    command "Decline" do
      role "System"
      policy_only
      goal "Record that the run's session was not opened"

      reference_to AgentRun

      emits "RunRefused"
    end

    # A turn's end is the session's report so far; the run stays started.
    command "RecordReport" do
      role "System"
      policy_only
      goal "Record what the run's session said at the end of a turn"

      reference_to AgentRun
      attribute :report, Said, sets: true

      given("only a started run reports") { status == "started" }

      emits "RunReported"
    end

    command "Finish" do
      role "System"
      policy_only
      goal "Record that the run's session ended, and how"

      reference_to AgentRun
      attribute :condition, Condition, sets: true
      attribute :code,      ExitCode, sets: true

      emits "RunFinished"
    end

    query "Waiting" do
      description "The runs whose session has been asked for and is not yet running."
      # The session's own name, which a Session event carries as its id.
      attribute :name, String
      where(status: "requested", session: :name)
    end

    query "Working" do
      description "The started runs in one session: what its turns and its end are recorded on."
      # The session's own name, which a Session event carries as its id.
      attribute :name, String
      where(status: "started", session: :name)
    end
  end

  policy "OpenTheRunsSession" do
    on      "AgentRun.RunRequested"
    acts_as "Owner"
    trigger Session::Open, with: { name: :session, brief: :brief }
  end

  policy "ReopenTheRunsSeat" do
    on      "AgentRun.SeatRunRequested"
    acts_as "Owner"
    trigger Session::Reopen, with: { session: :session, brief: :brief }
  end

  policy "BeginTheRunOfTheRunningSession" do
    on       "Session.SessionRunning"
    acts_as  "System"
    for_each "AgentRun.Waiting"
    trigger  AgentRun::Begin, with: { agent_run: :agent_run }
  end

  policy "DeclineTheRunOfTheUnopenedSession" do
    on       "Session.SessionNotOpened"
    acts_as  "System"
    for_each "AgentRun.Waiting"
    trigger  AgentRun::Decline, with: { agent_run: :agent_run }
  end

  # A turn that said nothing leaves the run's last report as it was.
  policy "RecordTheRunsReport" do
    on       "Session.TurnEnded"
    acts_as  "System"
    where    { said.value != "" }
    for_each "AgentRun.Working"
    trigger  AgentRun::RecordReport, with: { agent_run: :agent_run, report: :said }
  end

  policy "FinishTheRunDone" do
    on       "Session.SessionStopped"
    acts_as  "System"
    where    { code.value == "0" }
    for_each "AgentRun.Working"
    trigger  AgentRun::Finish, with: { agent_run: :agent_run, condition: { value: "done" }, code: :code }
  end

  policy "FinishTheRunFailed" do
    on       "Session.SessionStopped"
    acts_as  "System"
    where    { code.value != "0" }
    for_each "AgentRun.Working"
    trigger  AgentRun::Finish, with: { agent_run: :agent_run, condition: { value: "failed" }, code: :code }
  end

  # One message, from the moment its sender's send_message reached the supervisor.
  aggregate "Message" do
    description "One message a session sent another: who sent it, to whom, what it says, and when it was sent and delivered."

    identified_by :key

    attribute :key,          MessageKey
    attribute :sender,       Party
    attribute :addressee,    Party
    attribute :text,         MessageText
    attribute :sent_at,      Moment
    attribute :delivered_at, Moment, optional: true
    # The message this one answers or relays, when its sender named one.
    attribute :about,        MessageKey, optional: true
    # Whether the scrum master holds it as a coder's question, and how that ended.
    attribute :hold,         Hold
    # Whether it waits for its addressee's turn to end (normal) or cuts the turn short (urgent).
    attribute :urgency,      Urgency
    # The scrum master's message on the question, when it handed the question on.
    attribute :findings,     MessageKey, optional: true

    # The supervisor's id for the message: the sender's name and a count.
    value_object "MessageKey" do
      attribute :value, String, matches: :present
    end

    # A session, by name.
    value_object "Party" do
      attribute :value, String, matches: :present
    end

    value_object "MessageText" do
      attribute :value, String, matches: :present
    end

    # Milliseconds on the supervisor's clock, from its start.
    value_object "Moment" do
      attribute :value, Integer, default: 0
    end

    # A coder's question is held by the scrum master until it answers the coder (settled) or the
    # question goes on to the lead (handed-on); any other message is held by nobody.
    value_object "Hold" do
      attribute :value, String, default: "none", one_of: ["none", "held", "settled", "handed-on"]
    end

    # A sender marks a message urgent only when it cannot wait: the addressee's turn is interrupted.
    value_object "Urgency" do
      attribute :value, String, default: "normal", one_of: ["normal", "urgent"]
    end

    lifecycle :status, default: "posted" do
      transition "RecordDelivered"     => "delivered",     from: "posted"
      transition "RecordUndeliverable" => "undeliverable", from: "posted"
      # Handing a question on posts it again, to the lead, whether or not the scrum master had it.
      transition "HandOn"              => "posted",        from: ["posted", "delivered", "undeliverable"]
      # A posted message waits for its addressee's turn to end; an addressee that exits first
      # leaves it undeliverable, so the wait ends with the session. A delivered message rests
      # there unless it is a coder's question handed on; an undeliverable one is handed on or ends.
      mark :rests, "posted", "delivered"
    end

    command "Post" do
      role "System"
      goal "Post a message a session sent, to be delivered by policy"

      attribute :key,       MessageKey
      attribute :sender,    Party
      attribute :addressee, Party
      attribute :text,      MessageText
      attribute :sent_at,   Moment
      # Given on every post, nil when the message answers nothing or is not urgent: DeliverEachMessage
      # reads both, and a policy's with: refuses a field the event does not carry.
      attribute :about,     MessageKey, optional: true
      attribute :urgency,   Urgency, optional: true

      emits "MessagePosted"
    end

    # The addressee started on the message: written as its next turn, at once or once its turn ended.
    command "RecordDelivered" do
      role "System"
      goal "Record when the addressee started on the message"

      reference_to Message
      attribute :delivered_at, Moment, sets: true

      emits "MessageDelivered"
    end

    # The supervisor refused the delivery, or the addressee exited with the message still held.
    command "RecordUndeliverable" do
      role "System"
      goal "Record that the message will not reach its addressee"

      reference_to Message

      emits "MessageUndeliverable"
    end

    # The scrum master settles what written rules or code answer, citing file:line; the rest is the
    # lead's. A coder's question reaches it first, sent to it or routed from the orchestrator.
    command "Hold" do
      role "System"
      policy_only
      goal "Hold a coder's question sent to the scrum master until it is answered or handed on"

      reference_to Message
      attribute :held, Hold, default: { value: "held" }

      given("a coder asks") { sender.value.start_with?("coder") }
      given("it is for the scrum master") { addressee.value == "scrum-master" }
      given("it answers nothing") { about.unset? }

      sets :hold, to: :held

      emits "QuestionHeld"
    end

    command "Route" do
      role "System"
      policy_only
      goal "Address a coder's question for the orchestrator to the scrum master first, and hold it there"

      reference_to Message
      attribute :seat, Party, default: { value: "scrum-master" }
      attribute :held, Hold,  default: { value: "held" }

      given("a coder asks") { sender.value.start_with?("coder") }
      given("it is for the orchestrator") { addressee.value == "orchestrator" }
      given("it answers nothing") { about.unset? }

      sets :addressee, to: :seat
      sets :hold, to: :held

      emits "MessageRouted"
    end

    # The scrum master's answer to the coder who asked settles the question, so it never reaches the lead.
    command "Settle" do
      role "System"
      policy_only
      goal "Record that the scrum master answered a question it held"

      reference_to Message
      attribute :asker,   Party
      attribute :settled, Hold, default: { value: "settled" }

      given("the scrum master holds the question") { hold.value == "held" }
      given("the answer goes to the coder who asked") { asker.value == sender.value }

      sets :hold, to: :settled

      emits "QuestionSettled"
    end

    # The question goes on to the lead when the scrum master sends it what it found, when the scrum
    # master could not be reached, or when it has waited fifteen minutes unanswered.
    command "HandOn" do
      role "System"
      policy_only
      goal "Hand a question the scrum master did not settle to the orchestrator"

      reference_to Message
      attribute :findings, MessageKey, optional: true, sets: true
      attribute :now,      Moment, optional: true
      attribute :window,   Moment, default: { value: 900000 }
      attribute :lead,     Party,  default: { value: "orchestrator" }
      attribute :handed,   Hold,   default: { value: "handed-on" }

      given("the scrum master holds the question") { hold.value == "held" }
      given("the scrum master sent what it found, was not reached, or let fifteen minutes pass") do
        findings.set? || status == "undeliverable" || (now.set? && sent_at.value + window.value <= now.value)
      end

      sets :addressee, to: :lead
      sets :hold, to: :handed

      emits "QuestionHandedOn"
    end

    query "Unsettled" do
      description "The coders' questions the scrum master holds and has neither answered nor handed on: what each tick of the clock checks against its window."
      where(hold: "held")
      order_by :key
    end
  end

  # A sprint's baseline: the crew's tokens per minute, items per hour and cache hit rate over one hour.
  # The day is a plain ISO date, not a reference to the Tickets sprint: the `BaselineRecorded` event
  # on the shared bus is what shows on the sprint record.
  aggregate "Baseline" do
    description "One reading of the crew over an hour of a sprint: tokens per minute, items per hour and cache hit rate, once per sprint and window."

    identified_by :key

    attribute :key,               BaselineKey
    attribute :sprint,            BaselineDay
    attribute :window,            BaselineWindow
    attribute :minutes,           Minutes
    attribute :tokens_per_minute, Rate
    attribute :items_per_hour,    Rate
    attribute :cache_hit_rate,    Share
    attribute :by_role,           RoleFigures
    created_by "Baseline.Record"

    # The sprint day and the window, joined with a slash: a sprint has one reading of each window.
    value_object "BaselineKey" do
      attribute :value, String, pattern: '\A[0-9]{4}-[0-9]{2}-[0-9]{2}/(first_hour|hour_4)\z'
    end

    value_object "BaselineDay" do
      attribute :value, String, pattern: '\A[0-9]{4}-[0-9]{2}-[0-9]{2}\z'
    end

    # Hour 1 is read before any change under test is in force; hour 4 is read under the same load.
    value_object "BaselineWindow" do
      attribute :value, String, one_of: ["first_hour", "hour_4"]
    end

    # The moment the window opens, an ISO 8601 time; the first moment of the day when none is given.
    value_object "WindowStart", String

    value_object "Minutes" do
      attribute :value, Integer, default: 60

      invariant("a window is at least a minute") { value >= 1 }
    end

    # Tokens per minute or items per hour: never below nothing.
    value_object "Rate" do
      attribute :value, Float, default: 0.0

      invariant("a rate is not below zero") { value >= 0 }
    end

    # Cache-read tokens over all input tokens.
    value_object "Share" do
      attribute :value, Float, default: 0.0

      invariant("a rate is between 0 and 1") { value >= 0 && value <= 1 }
    end

    # One `role=tokens_per_minute/cache_hit_rate` entry per crew role, as the reading prints them.
    value_object "RoleFigures" do
      attribute :value, String, default: ""
    end

    # The text the Reading query returns: one `name: value` line per figure.
    value_object "Document" do
      attribute :text, String
    end

    command "Record" do
      role "System"
      goal "Record one window's reading of the crew as the sprint's baseline"

      attribute :key,               BaselineKey, sets: true
      attribute :sprint,            BaselineDay, sets: true
      attribute :window,            BaselineWindow, sets: true
      attribute :minutes,           Minutes, sets: true
      attribute :tokens_per_minute, Rate, sets: true
      attribute :items_per_hour,    Rate, sets: true
      attribute :cache_hit_rate,    Share, sets: true
      attribute :by_role,           RoleFigures, sets: true

      emits "BaselineRecorded"
    end

    query "Reading" do
      description "The crew's tokens per minute and cache hit rate by role over one sixty-minute window starting at a moment on a day, and the items finished per hour, with tokens per finished item derived. Read-only."
      attribute :day,   BaselineDay
      attribute :start, WindowStart, optional: true
      returns Document
    end
  end

  # The crew's move into the harness, one role at a time. It holds the order, how many switches are
  # measured and whether the checkpoint after the first two is recorded, so every rule about what
  # may begin next is a guard on this one record.
  aggregate "Rollout" do
    description "The crew's move into the harness: the order of its roles, the switches measured, and the checkpoint after the first two."

    identified_by :key

    attribute :key,        RolloutKey
    attribute :seat_1,     Role
    attribute :seat_2,     Role
    attribute :seat_3,     Role
    attribute :seat_4,     Role
    attribute :seat_5,     Role
    attribute :seat_6,     Role
    attribute :seat_7,     Role
    attribute :seat_8,     Role
    attribute :measured,   Measured
    attribute :checkpoint, Checkpointed
    attribute :current,    Switching
    created_by "Rollout.Plan"

    value_object "RolloutKey" do
      attribute :value, String, matches: :present
    end

    # How many roles have been switched and measured.
    value_object "Measured" do
      attribute :value, Integer, default: 0
    end

    # Whether the re-evaluation after the first two switches is recorded: sizes, fill rules, load rule.
    value_object "Checkpointed" do
      attribute :value, String, default: "no", one_of: ["no", "yes"]
    end

    # The role now switching; empty between switches.
    value_object "Switching" do
      attribute :value, String, default: ""
    end

    value_object "Role" do
      attribute :value, String, matches: :present
    end

    # The Baseline reading the switch is measured against, as its BaselineKey.
    value_object "Reading" do
      attribute :value, String, matches: :present
    end

    value_object "Seconds" do
      attribute :value, Float, default: 0.0

      invariant("a time is not below zero") { value >= 0 }
    end

    value_object "Count" do
      attribute :value, Integer, default: 0

      invariant("a count is not below zero") { value >= 0 }
    end

    value_object "Held" do
      attribute :value, String, matches: :present
    end

    lifecycle :status, default: "planned" do
      transition "Begin"   => "switching", from: "planned"
      transition "Measure" => "planned",   from: "switching"
      # A rollout waits on a role's measuring, which takes live runs, and on the checkpoint, which
      # the crew decides: neither is a wait the bluebook times.
      mark :rests, "planned", "switching"
    end

    command "Plan" do
      role "Owner"
      goal "Plan the order the crew's roles switch into the harness, the scrum master last"

      attribute :key, RolloutKey, sets: true
      attribute :seat_1, Role, sets: true
      attribute :seat_2, Role, sets: true
      attribute :seat_3, Role, sets: true
      attribute :seat_4, Role, sets: true
      attribute :seat_5, Role, sets: true
      attribute :seat_6, Role, sets: true
      attribute :seat_7, Role, sets: true
      attribute :seat_8, Role, sets: true

      given("the scrum master is last") { seat_8.value == "scrum-master" }

      emits "RolloutPlanned"
    end

    command "Begin" do
      role "Owner"
      goal "Begin switching the next role in the order into the harness"

      reference_to Rollout
      attribute :role, Role

      given("it is the next role in the order") do
        (measured.value == 0 && role.value == seat_1.value) ||
        (measured.value == 1 && role.value == seat_2.value) ||
        (measured.value == 2 && role.value == seat_3.value) ||
        (measured.value == 3 && role.value == seat_4.value) ||
        (measured.value == 4 && role.value == seat_5.value) ||
        (measured.value == 5 && role.value == seat_6.value) ||
        (measured.value == 6 && role.value == seat_7.value) ||
        (measured.value == 7 && role.value == seat_8.value)
      end
      given("fewer than two roles are measured, or the checkpoint is recorded") { measured.value < 2 || checkpoint.value == "yes" }

      sets :current, to: :role

      emits "SwitchBegan"
    end

    command "Measure" do
      role "Owner"
      goal "Record the switching role's waiting time, cold starts and claim age against a baseline reading"

      reference_to Rollout
      attribute :role,        Role
      attribute :baseline,    Reading
      attribute :waiting_p90, Seconds
      attribute :cold_starts, Count
      attribute :claim_age,   Seconds
      attribute :settled,     Switching, default: { value: "" }

      given("it is the role switching") { current.value == role.value }

      sets :measured, increment: { value: 1 }
      sets :current, to: :settled

      emits "SwitchMeasured"
    end

    command "Checkpoint" do
      role "Owner"
      goal "Record the re-evaluation after the first two switches: do sizes, the fill rules and the load rule still hold"

      reference_to Rollout
      attribute :held,    Held
      attribute :checked, Checkpointed, default: { value: "yes" }

      given("two roles are measured") { measured.value >= 2 }

      sets :checkpoint, to: :checked

      emits "RolloutCheckpointed"
    end
  end

  # The supervisor's clock: a tick it writes every interval, read here so a wait is timed even
  # when no session says anything.
  aggregate "Clock" do
    description "The supervisor's clock: each tick, at its moment on the supervisor's clock."

    identified_by :reading

    attribute :reading, Reading
    attribute :now,     Instant

    value_object "Reading" do
      attribute :value, String, matches: :present
    end

    # Milliseconds on the supervisor's clock, from its start, as a Message's moments are.
    value_object "Instant" do
      attribute :value, Integer, default: 0
    end

    command "Tick" do
      role "System"
      goal "Record one tick of the supervisor's clock"

      attribute :reading, Reading
      attribute :now,     Instant

      emits "ClockTicked"
    end
  end

  # The scrum master's policies come before the delivery: a question is held before it is
  # delivered, and a question handed on reaches the lead before the findings sent with it.
  policy "HoldACoderQuestionForTheScrumMaster" do
    on      "Message.MessagePosted"
    acts_as "System"
    where   { sender.value.start_with?("coder") && addressee.value == "scrum-master" && about.unset? }
    trigger Message::Hold, with: { message: :key }
  end

  # One stated here and negated in DeliverEachMessage; a spec covers both sides.
  policy "RouteACoderQuestionToTheScrumMaster" do
    on      "Message.MessagePosted"
    acts_as "System"
    where   { sender.value.start_with?("coder") && addressee.value == "orchestrator" && about.unset? }
    trigger Message::Route, with: { message: :key }
  end

  policy "SettleWhatTheScrumMasterAnswered" do
    on      "Message.MessagePosted"
    acts_as "System"
    where   { sender.value == "scrum-master" && addressee.value != "orchestrator" && about.set? }
    trigger Message::Settle, with: { message: :about, asker: :addressee }
  end

  policy "HandOnWhatTheScrumMasterNoted" do
    on      "Message.MessagePosted"
    acts_as "System"
    where   { sender.value == "scrum-master" && addressee.value == "orchestrator" && about.set? }
    trigger Message::HandOn, with: { message: :about, findings: :key, now: :sent_at }
  end

  policy "DeliverEachMessage" do
    on    "Message.MessagePosted"
    where { !(sender.value.start_with?("coder") && addressee.value == "orchestrator" && about.unset?) }
    ask   :deliver, with: { key: :key, sender: :sender, addressee: :addressee, text: :text, about: :about,
                            urgency: :urgency }
  end

  # A routed or handed-on question is delivered as the ledger holds it, to its new addressee.
  policy "DeliverWhatWasRouted" do
    on  "Message.MessageRouted"
    ask :deliver_recorded, with: { key: :key }
  end

  policy "DeliverWhatWasHandedOn" do
    on  "Message.QuestionHandedOn"
    ask :deliver_recorded, with: { key: :key }
  end

  # A question the scrum master cannot be handed goes on to the lead at once.
  policy "HandOnWhatTheScrumMasterCannotTake" do
    on      "Message.MessageUndeliverable"
    acts_as "System"
    trigger Message::HandOn, with: { message: :key }
  end

  # Each tick hands on every question held past its window; one inside it refuses by its given.
  policy "HandOnWhatTheScrumMasterLeft" do
    on       "Clock.ClockTicked"
    acts_as "System"
    for_each "Message.Unsettled"
    trigger  Message::HandOn, with: { message: :message, now: :now }
  end

  policy "RecordTheUndeliverable" do
    on      "Message.DeliveryRefused"
    acts_as "System"
    trigger Message::RecordUndeliverable, with: { message: :key }
  end

  policy "RecordTheRecordedUndeliverable" do
    on      "Message.RecordedDeliveryRefused"
    acts_as "System"
    trigger Message::RecordUndeliverable, with: { message: :key }
  end

  # The staff engineer's relays, recorded in StaffEngineer as the mail passes: a question opens one,
  # Miette's answer about it is received, the send on to the asker is forwarded only in her words,
  # and a send to her that is refused declines it, so nothing is said in her place.
  policy "AskMietteThroughTheStaffEngineer" do
    on      "Message.MessagePosted"
    acts_as "Operator"
    where   { addressee.value == "staff-engineer" && sender.value != "miette" }
    across  "StaffEngineer"
    trigger Relay::Ask, with: { relay: :key, question: :text, run: :sender }
  end

  policy "ReceiveMiettesAnswer" do
    on      "Message.MessagePosted"
    acts_as "Operator"
    where   { sender.value == "miette" && addressee.value == "staff-engineer" }
    across  "StaffEngineer"
    trigger Relay::Receive, with: { relay: :about, received: :text }
  end

  policy "ForwardMiettesAnswer" do
    on      "Message.MessagePosted"
    acts_as "Operator"
    where   { sender.value == "staff-engineer" && addressee.value != "miette" }
    across  "StaffEngineer"
    trigger Relay::Forward, with: { relay: :about, words: :text, author: "miette" }
  end

  policy "DeclineWhenMietteIsNotReached" do
    on      "Message.DeliveryRefused"
    acts_as "System"
    where   { sender.value == "staff-engineer" && addressee.value == "miette" }
    across  "StaffEngineer"
    trigger Relay::Decline, with: { relay: :about }
  end
end
