__BANNER__

// The library screen: the pictures (or files) the content system keeps, as a grid with a small
// picture, the file's name, its description, and where it is used. A search narrows it by
// description or name; pages are links. Choosing one for a field is done on that field (see
// browser/uploads.js); this screen is for looking and for seeing what a picture is used by.
import type { LibraryItem, LibraryPage } from "../library.ts";
import { collectionWords, libraryCollections } from "../library.ts";
import { at } from "../names.ts";
import { esc, href } from "./html.ts";
import { page } from "./shell.ts";

/** What the navigation holds the library under. */
export const LIBRARY = "__library";

const size = (bytes: number | null): string => (bytes === null ? "" : bytes >= 1_048_576 ? `${(bytes / 1_048_576).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`);

function usedBy(item: LibraryItem): string {
  if (item.used.length === 0) {
    return `<p class="text-sm text-muted">Not held by any record here. (A section of a page may still use it.)</p>`;
  }
  const links = item.used.map((record) => {
    const to = href(...at({ name: record.aggregate, chapter: record.chapter } as Parameters<typeof at>[0]), "id", record.id);
    return `<li><a class="link" href="${esc(to)}">${esc(record.title)}</a></li>`;
  });
  return `<div class="text-sm"><p class="text-muted">Used by:</p><ul class="list-disc pl-5">${links.join("")}</ul></div>`;
}

function card(item: LibraryItem, accept: "image" | "pdf"): string {
  const thumb =
    accept === "image" && item.thumb
      ? `<img class="aspect-[4/3] w-full border-b border-base-300 bg-base-200 object-cover" src="${esc(item.thumb)}" alt="${esc(item.alt)}" loading="lazy" width="400" height="300">`
      : `<div class="grid aspect-[4/3] w-full place-items-center border-b border-base-300 bg-base-200 text-sm text-muted" aria-hidden="true">PDF</div>`;
  const dims = item.width && item.height ? ` · ${item.width} × ${item.height}` : "";
  return `<li class="flex min-w-0 flex-col border border-base-300 bg-base-100">
${thumb}
<div class="grid min-w-0 gap-2 p-3">
<p class="break-words font-semibold">${esc(item.alt || item.filename)}</p>
<p class="break-all text-xs text-muted"><a class="link" href="${esc(item.address)}">${esc(item.filename)}</a>${esc(dims)} · ${esc(size(item.size))}</p>
${usedBy(item)}
</div>
</li>`;
}

function pager(view: LibraryPage): string {
  if (view.pages <= 1) return "";
  const link = (number: number, text: string): string => `<a class="btn btn-sm" href="${esc(`${href("library")}?collection=${encodeURIComponent(view.collection)}&q=${encodeURIComponent(view.q)}&page=${number}`)}">${text}</a>`;
  return `<nav class="mt-6 flex items-center gap-3" aria-label="Pages">${view.page > 1 ? link(view.page - 1, "Newer") : ""}<span class="text-sm text-muted">Page ${view.page} of ${view.pages}</span>${view.page < view.pages ? link(view.page + 1, "Older") : ""}</nav>`;
}

/** The library screen for one collection's page. */
export function libraryPage(view: LibraryPage | { error: string }, collection: string, q: string): string {
  const tabs = libraryCollections()
    .map((one) => {
      const words = collectionWords(one.accept);
      const current = one.collection === collection;
      return `<a class="tab${current ? " tab-active" : ""}"${current ? ' aria-current="page"' : ""} href="${esc(`${href("library")}?collection=${encodeURIComponent(one.collection)}`)}">${esc(words.plural)}</a>`;
    })
    .join("");
  const search = `<form class="mb-4 flex flex-wrap items-end gap-2" method="get" action="${esc(href("library"))}" role="search"><input type="hidden" name="collection" value="${esc(collection)}"><label class="grid gap-1 text-sm font-semibold">Search by description or file name<input class="input w-72 max-w-full" type="search" name="q" value="${esc(q)}"></label><button class="btn btn-neutral" type="submit">Search</button></form>`;
  let body: string;
  if ("error" in view) {
    body = `<div class="alert alert-error alert-soft" role="alert"><p>${esc(view.error)}</p></div>`;
  } else if (view.items.length === 0) {
    body = q === "" ? `<p class="text-muted">Nothing has been uploaded here yet. Add a ${esc(collectionWords(view.accept).singular)} from the field that needs it, and it will be listed.</p>` : `<p class="text-muted">Nothing matches "${esc(q)}". Try fewer words.</p>`;
  } else {
    body = `<p class="mb-3 text-sm text-muted">${view.total} ${view.total === 1 ? "item" : "items"}, newest first.</p><ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label="${esc(collectionWords(view.accept).plural)}">${view.items.map((item) => card(item, view.accept)).join("\n")}</ul>${pager(view)}`;
  }
  const main = `<div class="mb-6"><h1 class="text-3xl">Pictures and files</h1><p class="mt-1 max-w-prose text-muted">Everything already uploaded, for choosing again and for seeing where it is used. To add a new one, use the field that needs it.</p></div>
<div role="navigation" aria-label="Kinds of file" class="tabs tabs-border mb-4">${tabs}</div>
${search}
${body}`;
  return page("Pictures and files", main, { active: LIBRARY, crumbs: [["Home", href()], ["Pictures and files"]] });
}
