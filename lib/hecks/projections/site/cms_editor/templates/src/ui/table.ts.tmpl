__BANNER__

// An aggregate's list: a title with its primary command, the views the domain's queries give, a
// filter, and the instances as hairline rows. Everything works without the script; the script adds
// the filter, the sort and the live count. A list that is empty says so in one sentence and offers
// the command that makes the first one.
import type { Aggregate, Attr, Command, Query } from "../schema.ts";
import { esc, href, refusal, statusBadge } from "./html.ts";
import { icon } from "./icons.ts";
import { fields } from "./fields.ts";
import { summary, summaryText } from "./outline.ts";
import { commandLabel, humanize, label, plural, singular } from "./words.ts";

type State = Record<string, unknown>;
type Row = [string, State];

const numeric = (attr: Attr): boolean => !attr.list && (attr.kind === "integer" || attr.kind === "number");

const columns = (agg: Aggregate): Attr[] => agg.attributes.filter((attr) => !attr.list && attr.widget !== "body" && attr.name !== agg.identity).slice(0, 4);

/** The most characters a cell shows before the rest is cut; the whole text stays in its title. */
const CLIP = 80;

function cell(attr: Attr, value: unknown): string {
  const text = summaryText(value);
  const long = text.length > CLIP;
  const classes = numeric(attr) ? "text-right" : long ? "max-w-sm truncate" : "";
  const title = long ? ` title="${esc(text)}"` : "";
  return `<td class="${classes}"${title} data-value="${esc(text)}">${summary(value)}</td>`;
}

function head(attr: Attr | null, text: string): string {
  const kind = attr && numeric(attr) ? "number" : "text";
  return `<th scope="col" class="${attr && numeric(attr) ? "text-right " : ""}whitespace-nowrap" data-sort="${kind}">${esc(text)}</th>`;
}

function rows(agg: Aggregate, found: Row[]): string {
  const cols = columns(agg);
  const heads = [head(null, label(agg.identity)), ...cols.map((attr) => head(attr, label(attr.name))), ...(agg.lifecycle ? [head(null, "Status")] : [])];
  const lines = found.map(([id, state]) => {
    const status = agg.lifecycle ? `<td data-value="${esc(state[agg.lifecycle.field])}">${statusBadge(agg, state[agg.lifecycle.field])}</td>` : "";
    return `<tr class="hover:bg-base-200/60" data-row><th scope="row" class="font-normal" data-value="${esc(id)}"><a class="link link-hover font-semibold" href="${esc(href(agg.name, "id", id))}">${esc(id)}</a></th>${cols.map((attr) => cell(attr, state[attr.name])).join("")}${status}</tr>`;
  });
  return `<div class="overflow-x-auto border-y border-base-300 bg-base-100 lg:overflow-visible">
<table class="table lg:[&_thead_th]:sticky lg:[&_thead_th]:top-14 lg:[&_thead_th]:z-10 [&_thead_th]:bg-base-100 [&_thead_th]:text-xs [&_thead_th]:text-muted" data-sortable>
<thead><tr>${heads.join("")}</tr></thead>
<tbody>
${lines.join("\n")}
</tbody>
</table>
</div>`;
}

function empty(agg: Aggregate, primary: Command | undefined, matching: boolean): string {
  const noun = esc(humanize(plural(agg.name)));
  const action = primary && !matching ? `<a class="btn btn-neutral" href="${esc(href(agg.name, "new", primary.name))}">${icon("plus")}<span>${esc(commandLabel(agg, primary))}</span></a>` : "";
  const text = matching ? `No ${noun} match.` : `No ${noun} yet.${primary ? " Add the first one." : ""}`;
  return `<div class="grid justify-items-center gap-3 border-y border-base-300 bg-base-100 px-4 py-16 text-center text-muted">${icon("inbox")}<p class="text-lg text-base-content">${text}</p>${action}</div>`;
}

function views(agg: Aggregate, current: Query | null): string {
  const link = (to: string, text: string, active: boolean, title = ""): string =>
    `<a role="tab" class="${active ? "tab tab-active font-semibold" : "tab"}" href="${esc(to)}"${active ? ' aria-current="page"' : ""}${title ? ` title="${esc(title)}"` : ""}>${esc(text)}</a>`;
  const all = link(href(agg.name), "All", current === null);
  const each = agg.queries.map((query) => link(`${href(agg.name)}?query=${encodeURIComponent(query.name)}`, label(query.name), current?.name === query.name, query.description ?? ""));
  return agg.queries.length === 0 ? "" : `<nav class="tabs tabs-border mb-4" role="tablist" aria-label="Views of ${esc(humanize(plural(agg.name)))}">${[all, ...each].join("")}</nav>`;
}

function queryForm(agg: Aggregate, query: Query | null): string {
  if (!query || query.attributes.length === 0) return "";
  const note = query.description ? `<p class="mb-2 text-muted">${esc(query.description)}</p>` : "";
  return `<form class="mb-6 max-w-xl" method="get" action="${esc(href(agg.name))}">${note}<input type="hidden" name="query" value="${esc(query.name)}">
${fields(agg, query.attributes, {}, null, false)}
<button type="submit" class="btn mt-3">${icon("search")}<span>Show matching</span></button></form>`;
}

function filter(agg: Aggregate, total: number): string {
  const noun = total === 1 ? singular(agg.name) : humanize(plural(agg.name));
  return `<div class="mb-3 flex flex-wrap items-center justify-between gap-3">
<label class="input input-sm h-9 w-full max-w-sm items-center gap-2">${icon("search")}<span class="sr-only">Filter ${esc(humanize(plural(agg.name)))}</span><input type="search" class="grow" data-filter placeholder="Filter this list" autocomplete="off"></label>
<p class="tabular-nums text-muted" data-count data-noun="${esc(singular(agg.name))}" data-nouns="${esc(humanize(plural(agg.name)))}" aria-live="polite">${total} ${esc(noun)}</p>
</div>`;
}

function actions(agg: Aggregate): string {
  const creating = agg.commands.filter((command) => command.creates);
  const elsewhere = agg.commands.filter((command) => !command.creates && command.on !== agg.name);
  const primary = (command: Command): string => `<a class="btn btn-neutral" href="${esc(href(agg.name, "new", command.name))}">${icon("plus")}<span>${esc(commandLabel(agg, command))}</span></a>`;
  const secondary = (command: Command, verb: string): string => `<a class="btn" href="${esc(href(agg.name, verb, command.name))}"><span>${esc(commandLabel(agg, command))}</span></a>`;
  return [...creating.map((command, at) => (at === 0 ? primary(command) : secondary(command, "new"))), ...elsewhere.map((command) => secondary(command, "run"))].join("\n");
}

/** An aggregate's list: the rows of the query asked, or of everything it holds. */
export function listPage(agg: Aggregate, found: Row[], query: Query | null, error: string | null, asked = true): string {
  const primary = agg.commands.find((command) => command.creates);
  const body = found.length > 0 ? `${filter(agg, found.length)}\n${rows(agg, found)}` : !asked || error ? "" : empty(agg, primary, query !== null);
  return `<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
<div><h1 class="text-3xl">${esc(plural(agg.name))}</h1>${agg.description ? `<p class="mt-1 max-w-prose text-muted">${esc(agg.description)}</p>` : ""}</div>
<div class="flex flex-wrap gap-2">${actions(agg)}</div>
</div>
${views(agg, query)}
${queryForm(agg, query)}${refusal(error)}
${body}`;
}
