__BANNER__

// Moments in time. An integer the bluebook names as a date or a time is whole seconds since 1970 UTC.
// The server does not know the viewer's time zone, so it writes the moment in UTC inside a `time`
// element that carries the seconds, and the page's script (browser/moments.js) rewrites it in the
// viewer's own zone with how long ago or from now it is. A form carries the seconds in a plain
// number input that works without a script; the script replaces it with a native date or
// date-and-time input and keeps the seconds in step.
import type { Attr } from "../schema.ts";
import { esc } from "./html.ts";

/** Whether the attribute is a moment. */
export const isMoment = (attr: Attr): boolean => attr.widget === "date" || attr.widget === "datetime";

/** The whole seconds a stored value holds: the number itself, or the single part of a value object. */
export function secondsOf(value: unknown): number | null {
  const held = value && typeof value === "object" && !Array.isArray(value) ? Object.values(value as object)[0] : value;
  if (held === null || held === undefined || held === "" || typeof held === "boolean") return null;
  const seconds = Number(held);
  return Number.isFinite(seconds) && Math.abs(seconds) <= 8_640_000_000_000 ? Math.trunc(seconds) : null;
}

/** A moment in UTC, for a page read with no script: `YYYY-MM-DD`, or `YYYY-MM-DD HH:MM UTC` with a time. */
export function utcText(seconds: number, mode: string): string {
  const iso = new Date(seconds * 1000).toISOString();
  return mode === "date" ? iso.slice(0, 10) : `${iso.slice(0, 10)} ${iso.slice(11, 16)} UTC`;
}

/** A stored moment as a `time` element the script restates in the viewer's zone. */
export function momentTime(seconds: number, mode: string): string {
  const iso = new Date(seconds * 1000).toISOString();
  return `<time class="whitespace-nowrap" datetime="${esc(iso)}" data-moment="${esc(mode)}" data-epoch="${seconds}">${esc(utcText(seconds, mode))}</time>`;
}

/** A stored value (or a list of them) of a moment attribute, shown read-only. */
export function momentValue(attr: Attr, value: unknown): string {
  const mode = attr.widget ?? "datetime";
  const seconds = (item: unknown): string => {
    const held = secondsOf(item);
    return held === null ? `<span class="text-muted">Not set</span>` : momentTime(held, mode);
  };
  if (Array.isArray(value)) return value.length === 0 ? `<span class="text-muted">None</span>` : value.map(seconds).join(", ");
  return seconds(value);
}
