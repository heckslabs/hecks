__BANNER__

// One instance: its values as a single document column, and beside it a margin panel with its
// lifecycle state and the commands that apply now. Values are shown by shape (a value object as its
// parts, a list of value objects as a small table, a rich-text body as typeset text). A command that
// asks for nothing and is safe runs from a button; one that asks for input opens its own page; one
// that is destructive asks first, in a native dialog (the page of the command is the same question
// for a browser with no script).
import { at } from "../names.ts";
import type { Aggregate, Attr, Command } from "../schema.ts";
import { bodyToHtml } from "./body_model.js";
import { copyButton, copyable, esc, href, refusal, statusBadge } from "./html.ts";
import { isMoment, momentValue } from "./moments.ts";
import { outline } from "./outline.ts";
import { commandLabel, label, singular } from "./words.ts";

type State = Record<string, unknown>;

/** What a submitted command left behind: the refusal to show, and the values to put back. */
export interface Submitted {
  command: string;
  message: string | null;
  values: State;
  /** The attribute the refusal names, when it names one. */
  field?: string;
}

/** Whether a command applies to an instance in its present state: a lifecycle move only from its states. */
export function available(agg: Aggregate, command: Command, state: State): boolean {
  const move = agg.lifecycle?.transitions.find((transition) => transition.verb === command.name);
  return !move || !agg.lifecycle || move.from.includes(String(state[agg.lifecycle.field]));
}

/** What a command needs asked first: it takes input, or it is destructive. */
export const needsPage = (command: Command): boolean => command.attributes.length > 0 || command.destructive;

const dialogId = (command: Command): string => `confirm-${command.name}`;

/** The question a destructive command asks, as a native dialog that posts to `action` when confirmed. */
export function confirmDialog(agg: Aggregate, command: Command, action: string, id: string, form?: string): string {
  const what = commandLabel(agg, command);
  const detail = command.goal ? `${esc(command.goal)}.` : `This applies to ${esc(id)}.`;
  const owner = form ? ` form="${esc(form)}"` : "";
  const head = `<h2 id="${dialogId(command)}-title" class="text-xl">${esc(what)}?</h2>\n<p class="mt-2 text-muted">${detail}</p>`;
  const buttons = `<div class="modal-action"><button type="submit" class="btn btn-ghost" formmethod="dialog" formnovalidate>Cancel</button><button type="submit" class="btn btn-error"${owner}>${esc(what)}</button></div>`;
  const box = form ? `${head}\n${buttons}` : `<form method="post" action="${esc(action)}">\n${head}\n${buttons}\n</form>`;
  const close = `<form method="dialog" class="modal-backdrop"><button aria-label="Close">close</button></form>`;
  return `<dialog class="modal" id="${dialogId(command)}" aria-labelledby="${dialogId(command)}-title">\n<div class="modal-box">\n${box}\n</div>\n${close}\n</dialog>`;
}

function action(agg: Aggregate, id: string, command: Command, first: boolean): string {
  const to = href(...at(agg), "id", id, command.name);
  const text = esc(commandLabel(agg, command));
  const tone = command.destructive ? "btn btn-error btn-outline lg:w-full" : first ? "btn btn-neutral lg:w-full" : "btn lg:w-full";
  if (!needsPage(command)) return `<form method="post" action="${esc(to)}"><button type="submit" class="${tone}">${text}</button></form>`;
  const confirm = command.destructive && command.attributes.length === 0 ? ` data-confirm="${dialogId(command)}"` : "";
  return `<a class="${tone}" href="${esc(to)}"${confirm}>${text}</a>`;
}

function dialogs(agg: Aggregate, id: string, commands: Command[]): string {
  return commands
    .filter((command) => command.destructive && command.attributes.length === 0)
    .map((command) => confirmDialog(agg, command, href(...at(agg), "id", id, command.name), id))
    .join("\n");
}

function panel(agg: Aggregate, id: string, values: State, commands: Command[]): string {
  const status = agg.lifecycle ? `<div class="lg:pb-5"><h2 class="mb-2 text-sm">Status</h2><p>${statusBadge(agg, values[agg.lifecycle.field])}</p></div>` : "";
  const rule = agg.lifecycle ? "lg:border-t lg:border-base-300 lg:pt-5" : "";
  const buttons = commands.map((command, at) => action(agg, id, command, at === 0));
  const list = commands.length === 0 ? `<p class="text-muted">Nothing to do with this ${esc(singular(agg.name))} right now.</p>` : `<div class="flex flex-wrap gap-2 lg:grid">${buttons.join("\n")}</div>`;
  return `<aside class="order-first flex flex-wrap items-start gap-x-8 gap-y-4 border-b border-base-300 pb-5 lg:sticky lg:top-20 lg:order-none lg:block lg:border-b-0 lg:pb-0" aria-label="Status and actions">${status}<div class="${rule}"><h2 class="mb-2 text-sm">Actions</h2>${list}</div></aside>`;
}

function value(agg: Aggregate, attr: Attr, values: State): string {
  const held = values[attr.name];
  if (isMoment(attr)) return momentValue(attr, held);
  if (attr.widget === "body") return held && typeof held === "object" ? `<div class="prose">${bodyToHtml(held)}</div>` : `<span class="text-muted">Not set</span>`;
  const copy = attr.name === agg.identity || attr.kind === "reference";
  return copy && typeof held !== "object" && held !== undefined && held !== null && held !== "" ? copyable(String(held), label(attr.name).toLowerCase()) : outline(held);
}

function document(agg: Aggregate, values: State): string {
  const rows = agg.attributes.map((attr) => {
    const wide = attr.widget === "body" || attr.list || attr.kind === "object";
    const layout = wide ? "grid gap-2 py-4" : "grid gap-1 py-4 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-4";
    return `<div class="${layout}"><dt class="font-medium text-muted">${esc(label(attr.name))}</dt><dd class="min-w-0 break-words">${value(agg, attr, values)}</dd></div>`;
  });
  return `<dl class="divide-y divide-base-300">\n${rows.join("\n")}\n</dl>`;
}

/** One instance: its values, its status, and a button for each command that applies to it now. */
export function detailPage(agg: Aggregate, id: string, values: State, shown: Submitted | null): string {
  const commands = agg.commands.filter((command) => command.on === agg.name && available(agg, command, values));
  return `<div class="mb-6">
<h1 class="flex items-center gap-2 break-all text-3xl">${esc(id)}${copyButton(id, "id")}</h1><p class="mt-1 text-muted">${esc(label(agg.name))}</p>
</div>
${refusal(shown?.message ?? null)}
<div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_16rem]">
<section class="min-w-0 border border-base-300 bg-base-100 px-4 sm:px-6" aria-label="${esc(label(agg.name))}">
${document(agg, values)}
</section>
${panel(agg, id, values, commands)}
</div>
${dialogs(agg, id, commands)}`;
}
