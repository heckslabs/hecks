__BANNER__

// The picture picker the rich-text widget opens for an image block. It lists the pictures the domain
// has registered (thumbnails come from the storage adapter's own addresses), uploads a new one by
// button or by dropping a file, and hands the widget a media key, alt text and an optional caption.
// Alt text is required before anything is inserted; the editor server and the domain refuse a picture
// without one, and whatever they refuse with is shown here, next to the form. Everything the server
// sends is put into the page as text, never as markup.

const make = (tag, props = {}, ...children) => {
  const element = Object.assign(document.createElement(tag), props);
  element.append(...children);
  return element;
};

const field = (label, input) => make("label", {}, label, input);

async function getPictures(url) {
  const response = await fetch(url, { headers: { Accept: "application/json" } });
  if (!response.ok) throw new Error((await response.json().catch(() => ({}))).error ?? "The pictures could not be listed.");
  return (await response.json()).pictures;
}

async function upload(url, file, alt) {
  const form = new FormData();
  form.append("alt", alt);
  form.append("file", file);
  const response = await fetch(url, { method: "POST", body: form, headers: { Accept: "application/json" } });
  const answer = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(answer.error ?? "The upload failed.");
  return answer;
}

/** One registered picture as a button: its thumbnail, its alt text and a short key. */
function entry(picture, choose) {
  const image = make("img", { src: picture.url, alt: "", loading: "lazy", width: 64, height: 64 });
  const button = make("button", { type: "button", title: picture.alt }, image, make("span", {}, picture.alt || picture.key.slice(0, 12)));
  button.addEventListener("click", () => choose(picture, button));
  return make("li", {}, button);
}

/**
 * Opens the picker inside `root` (the widget's element). `options.url` is the media endpoint,
 * `options.current` the figure being replaced (or null), `options.onPick(key, alt, caption)` is called
 * with the choice.
 */
export function openPicker(root, options) {
  root.querySelector("[data-picker]")?.remove();
  const { url, current, onPick } = options;
  let chosen = current && current.key ? current.key : null;
  const list = make("ul", { className: "picker-list" });
  const status = make("p", { className: "refusal", role: "alert", hidden: true });
  const file = make("input", { type: "file", accept: "image/jpeg,image/png,image/webp,image/gif,image/avif" });
  const alt = make("input", { type: "text", required: true, value: current?.alt ?? "" });
  const caption = make("input", { type: "text", value: current?.caption ?? "" });
  const drop = make("p", { className: "note" }, "Choose a file or drop one here. JPEG, PNG, WebP, GIF or AVIF.");
  const insert = make("button", { type: "button" }, "Insert");
  const cancel = make("button", { type: "button" }, "Cancel");
  const panel = make("div", { className: "body-picker" }, make("strong", {}, "Insert a picture"), drop, field("Upload a new picture", file), make("p", { className: "note" }, "Or choose a registered picture:"), list, field("Alt text (required)", alt), field("Caption (optional)", caption), status, insert, " ", cancel);
  panel.setAttribute("data-picker", "");

  const say = (message) => {
    status.textContent = message ?? "";
    status.hidden = !message;
  };
  const close = () => panel.remove();

  const choose = (picture, button) => {
    chosen = picture.key;
    file.value = "";
    if (!alt.value.trim()) alt.value = picture.alt;
    for (const other of list.querySelectorAll("button")) other.removeAttribute("aria-pressed");
    button.setAttribute("aria-pressed", "true");
    say(null);
  };

  const submit = async () => {
    say(null);
    if (!alt.value.trim()) return say("Alt text is required: describe the picture for someone who cannot see it.");
    try {
      const key = file.files[0] ? (await upload(url, file.files[0], alt.value.trim())).key : chosen;
      if (!key) return say("Choose a registered picture or upload one.");
      onPick(key, alt.value.trim(), caption.value.trim());
      close();
    } catch (err) {
      say(err.message);
    }
  };

  panel.addEventListener("dragover", (event) => event.preventDefault());
  panel.addEventListener("drop", (event) => {
    event.preventDefault();
    if (event.dataTransfer.files.length) file.files = event.dataTransfer.files;
  });
  file.addEventListener("change", () => { chosen = null; });
  panel.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" || event.target.tagName !== "INPUT" || event.target.type === "file") return;
    event.preventDefault();
    submit();
  });
  insert.addEventListener("click", submit);
  cancel.addEventListener("click", close);

  root.querySelector("[data-toolbar]").after(panel);
  getPictures(url)
    .then((pictures) => list.append(...pictures.map((picture) => entry(picture, choose))))
    .catch((err) => say(err.message));
  alt.focus();
}
