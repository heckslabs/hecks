__BANNER__

// The Help page: one short section per job, written from the words the route chapter already gives
// the editor (what a thing is, what each button does, what each field wants), so it cannot drift
// from the screens. For each kind of record: what it is, how to add one (the fields in order, which
// are needed), what the buttons on a record do, and what happens to the live site when they are
// used. Then the parts every record shares: scheduling, history, pictures, people.
import { EDITOR } from "../config.ts";
import { keyOf } from "../names.ts";
import { SCHEMA } from "../schema.ts";
import type { Aggregate, Command } from "../schema.ts";
import { esc, href } from "./html.ts";
import { page } from "./shell.ts";
import { schedulingAggregate } from "./world.ts";
import { commandLabel, label, labelOf, nameOf, pluralName } from "./words.ts";

/** What the navigation holds the Help page under. */
export const HELP = "__help";

/** The commands a person starts a record with. */
const startersOf = (agg: Aggregate): Command[] => agg.commands.filter((command) => command.creates && command.role !== "System");

/** The buttons a record shows, once it exists: moves between states and other acts, not the edit form. */
const actsOf = (agg: Aggregate): Command[] => agg.commands.filter((command) => !command.creates && command.on === agg.name && command.role !== "System" && command.attributes.length === 0);

function fieldList(agg: Aggregate, command: Command): string {
  const items = command.attributes
    .filter((attr) => !attr.advanced && attr.widget !== "body")
    .map((attr) => {
      const need = attr.optional || attr.softOptional ? "optional" : "needed";
      return `<li><span class="font-semibold">${esc(labelOf(attr))}</span> (${need})${attr.help ? `: ${esc(attr.help.replace(/\.$/, ""))}.` : ""}</li>`;
    });
  return items.length === 0 ? "" : `<ul class="mt-2 list-disc space-y-1 pl-6">${items.join("")}</ul>`;
}

function job(agg: Aggregate): string {
  const starters = startersOf(agg);
  const acts = actsOf(agg);
  const about = agg.words?.about ?? agg.description ?? "";
  const make = starters
    .map(
      (command) =>
        `<div class="mt-3"><h3 class="font-semibold">To ${esc(commandLabel(agg, command).toLowerCase())}</h3><p class="text-sm text-muted">Choose <span class="font-semibold">${esc(commandLabel(agg, command))}</span>${command.goal || command.help ? `: ${esc((command.help ?? command.goal ?? "").replace(/\.$/, ""))}.` : "."}</p>${fieldList(agg, command)}</div>`,
    )
    .join("");
  const buttons =
    acts.length === 0
      ? ""
      : `<div class="mt-3"><h3 class="font-semibold">Buttons on a ${esc(nameOf(agg))}</h3><ul class="mt-2 list-disc space-y-1 pl-6">${acts.map((command) => `<li><span class="font-semibold">${esc(commandLabel(agg, command))}</span>${command.help || command.goal ? `: ${esc((command.help ?? command.goal ?? "").replace(/\.$/, ""))}.` : ""}</li>`).join("")}</ul></div>`;
  return `<section class="border border-base-300 bg-base-100 p-4 sm:p-6" aria-labelledby="help-${esc(keyOf(agg))}">
<h2 id="help-${esc(keyOf(agg))}" class="text-xl">${esc(pluralName(agg))}</h2>
${about ? `<p class="mt-1 max-w-prose text-muted">${esc(about)}</p>` : ""}
${make}
${buttons}
<p class="mt-3 text-sm"><a class="link" href="${esc(href(...(agg.chapter ? [agg.chapter, agg.name] : [agg.name])))}">Open ${esc(pluralName(agg).toLowerCase())}</a></p>
</section>`;
}

/** The page. */
export function helpPage(): string {
  const jobs = SCHEMA.aggregates.filter((agg) => agg.words?.advanced !== true && agg !== schedulingAggregate() && startersOf(agg).length + actsOf(agg).length > 0);
  const sched = schedulingAggregate();
  const shared = [
    `<section class="border border-base-300 bg-base-100 p-4 sm:p-6"><h2 class="text-xl">Saving, and what the site shows</h2><p class="mt-2 max-w-prose">A change reaches the public site a few seconds after you save it. The word <span class="font-semibold">Saved</span> or a green notice at the top says it worked; a red notice says what to fix, and the field is marked.</p></section>`,
    sched
      ? `<section class="border border-base-300 bg-base-100 p-4 sm:p-6"><h2 class="text-xl">Scheduling</h2><p class="mt-2 max-w-prose">On a record's page, under <span class="font-semibold">Schedule</span>, choose what should happen and when (on the center's clock). The editor does it when the time comes, within a minute. The <a class="link" href="${esc(href("scheduled"))}">Scheduled</a> screen lists what is waiting; change the time or cancel there.</p></section>`
      : "",
    `<section class="border border-base-300 bg-base-100 p-4 sm:p-6"><h2 class="text-xl">History and putting a change back</h2><p class="mt-2 max-w-prose">Every record has a <span class="font-semibold">History</span> panel: who changed it and when, and what changed. <span class="font-semibold">Put it back as it was before</span> sends the old values through the same Save, so the same rules apply. It lists changes made through this editor only.</p></section>`,
    `<section class="border border-base-300 bg-base-100 p-4 sm:p-6"><h2 class="text-xl">Previewing</h2><p class="mt-2 max-w-prose">On a form, <span class="font-semibold">Preview (approximate)</span> shows what you have typed laid out like a page, in a new tab, without saving. Where a record is already on the site, <span class="font-semibold">View on the site</span> opens the real page.</p></section>`,
    EDITOR.upload
      ? `<section class="border border-base-300 bg-base-100 p-4 sm:p-6"><h2 class="text-xl">Pictures and files</h2><p class="mt-2 max-w-prose">In a picture field, choose a file from your computer and describe it, or <span class="font-semibold">Choose one already uploaded</span>. <a class="link" href="${esc(href("library"))}">Pictures and files</a> lists everything uploaded and where each is used.</p></section>`
      : "",
    EDITOR.members
      ? `<section class="border border-base-300 bg-base-100 p-4 sm:p-6"><h2 class="text-xl">Who may edit</h2><p class="mt-2 max-w-prose">Administrators see <span class="font-semibold">People</span>: add a person with a role, change a role, turn someone off or back on. An editor can change content; an administrator can also decide who may edit.</p></section>`
      : "",
  ].filter((html) => html !== "");
  const main = `<div class="mb-6"><h1 class="text-3xl">Help</h1><p class="mt-1 max-w-prose text-muted">What each job is, and what the buttons do. Everything here is read from the same words the screens use.</p></div>
<div class="grid gap-6">${jobs.map((agg) => job(agg)).join("\n")}${shared.join("\n")}</div>`;
  return page("Help", main, { active: HELP, crumbs: [["Home", href()], ["Help"]] });
}
