__BANNER__

// How one record reaches another. A record is named to the rest of the domain by a plain key of the
// form `<kind>:<slug>`, where the kind is its aggregate's snake-case name (`post:first-light`), so
// this file makes that key, fills an input named by dotted path with it, and keeps the way back: a
// page reached from a record's page carries `_back` (an address under the editor), and the form on it
// posts `__back`, so a save returns to the record the person came from.
import { EDITOR } from "../config.ts";
import type { Aggregate, Attr } from "../schema.ts";
import { esc } from "./html.ts";
import { label } from "./words.ts";

/** A record's names, as a key and its parts: `post:first-light` is kind `post`, slug `first-light`. */
export interface Parts {
  key: string;
  kind: string;
  slug: string;
  id: string;
}

/** The snake-case name a kind is spelled: "MediaItem" is "media_item". */
export const snake = (name: string): string => name.replace(/([a-z0-9])([A-Z])/g, "$1_$2").toLowerCase();

/**
 * A record's key and its parts. An identity that already reads `<kind>:<slug>` is that key; any
 * other identity is the slug of a key whose kind is its aggregate's.
 */
export function partsOf(agg: Aggregate, id: string): Parts {
  const given = /^([a-z][a-z0-9_]*):(.+)$/.exec(id);
  if (given) return { key: id, kind: given[1], slug: given[2], id };
  const kind = snake(agg.name);
  return { key: `${kind}:${id}`, kind, slug: id, id };
}

/** The value object's one plain part that an attribute is entered as, or null when it has several. */
function onlyPart(agg: Aggregate, attr: Attr): Attr | null {
  const parts = attr.kind === "object" ? (agg.valueObjects[attr.type] ?? []) : [];
  return parts.length === 1 && parts[0].kind !== "object" && !parts[0].list ? parts[0] : null;
}

/** The name of the input that holds an attribute of one plain value, as a form posts it. */
export function plainName(agg: Aggregate, attr: Attr): string {
  const part = onlyPart(agg, attr);
  return part ? `${attr.name}.${part.name}` : attr.name;
}

/** `text` as a value of the attribute, wrapped in its value object when it has one. */
export function plainValue(agg: Aggregate, attr: Attr, text: string): unknown {
  const part = onlyPart(agg, attr);
  return part ? { [part.name]: text } : text;
}

/** The text an attribute of one plain value holds. */
export function plainText(value: unknown): string {
  if (value && typeof value === "object") return plainText(Object.values(value as object).find((part) => part !== null && part !== undefined));
  return value === null || value === undefined ? "" : String(value);
}

/** Where a page was reached from: the address to go back to, and the words for the link. */
export interface Back {
  path: string;
  label: string;
}

/**
 * The way back a request names, or null. Only an address under the editor's base path is one, so a
 * link written by anyone cannot send a person off the editor; a control character or a backslash is
 * refused as well.
 */
export function backOf(raw: string | null | undefined): Back | null {
  if (!raw || raw.length > 400 || /[\u0000-\u001f\\]/.test(raw)) return null;
  if (raw !== EDITOR.basePath && !raw.startsWith(`${EDITOR.basePath}/`)) return null;
  const segments = raw.split(/[?#]/)[0].split("/").filter(Boolean);
  const at = segments.indexOf("id");
  const named = at >= 0 && segments[at + 1] ? segments[at + 1] : (segments.at(-1) ?? "");
  return { path: raw, label: decoded(named) };
}

function decoded(text: string): string {
  try {
    return decodeURIComponent(text);
  } catch {
    return text;
  }
}

/** `path` with the way back added to its query. */
export const withBack = (path: string, back: string): string => `${path}${path.includes("?") ? "&" : "?"}_back=${encodeURIComponent(back)}`;

/** The hidden input a form posts so that a save returns to `back`. */
export const backInput = (back: Back | null): string => (back ? `<input type="hidden" name="__back" value="${esc(back.path)}">` : "");

/** The link at the top of a page that leads back to the record it was reached from. */
export function backLink(back: Back | null): string {
  if (!back) return "";
  return `<p class="mb-3"><a class="btn btn-ghost btn-sm" href="${esc(back.path)}">Back to ${esc(back.label)}</a></p>`;
}

/** What a record is called in a heading, such as "Search wording" or "Pictures", by the aggregate's own words. */
export const titled = (agg: Aggregate): string => label(agg.name);
