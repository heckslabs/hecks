__BANNER__

// The page frame and the small helpers every page shares. Pages are plain strings built on the
// server; every value that came from the domain or the person is escaped on its way in.
import { EDITOR } from "../config.ts";
import { SCHEMA } from "../schema.ts";

/** Escapes text for an HTML body or a double-quoted attribute. */
export function esc(value: unknown): string {
  return String(value ?? "").replace(/[&<>"']/g, (char) => `&#${char.charCodeAt(0)};`);
}

/** A path under the editor's base path; each segment is URL-encoded. */
export function href(...segments: string[]): string {
  return [EDITOR.basePath, ...segments.map(encodeURIComponent)].join("/");
}

const STYLE = `
  :root { color-scheme: light dark; --edge: #8886; --accent: #2457c5; }
  body { font: 16px/1.5 system-ui, sans-serif; margin: 0; }
  header, main { max-width: 64rem; margin: 0 auto; padding: 0.75rem 1rem; }
  header { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; border-bottom: 1px solid var(--edge); align-items: baseline; }
  header a.brand { font-weight: 700; }
  a { color: var(--accent); }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: 0.35rem 0.5rem; border-bottom: 1px solid var(--edge); vertical-align: top; }
  fieldset { border: 1px solid var(--edge); border-radius: 6px; margin: 0.5rem 0; padding: 0.5rem 0.75rem; }
  label { display: block; margin: 0.4rem 0; }
  label small { opacity: 0.7; }
  input:not([type=checkbox]), select, textarea { display: block; width: 100%; max-width: 32rem; font: inherit; padding: 0.3rem; box-sizing: border-box; }
  button { font: inherit; padding: 0.35rem 0.9rem; cursor: pointer; }
  .badge { display: inline-block; padding: 0 0.6rem; border-radius: 1rem; border: 1px solid var(--edge); font-size: 0.85rem; }
  .refusal { border: 1px solid #c33; border-radius: 6px; padding: 0.5rem 0.75rem; margin: 0.75rem 0; }
  .outline { border-left: 3px solid var(--edge); margin: 0.25rem 0 0.25rem 0.25rem; padding-left: 0.75rem; }
  .outline ul { margin: 0.2rem 0; padding-left: 1.25rem; }
  .note { opacity: 0.7; font-size: 0.85rem; }
`;

/** The frame of every page: the editor's name, a link to each aggregate, and `body`. */
export function page(title: string, body: string): string {
  const nav = SCHEMA.aggregates.map((agg) => `<a href="${esc(href(agg.name))}">${esc(agg.name)}</a>`).join("\n    ");
  return `<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>${esc(title)} - ${esc(EDITOR.title)}</title>
  <style>${STYLE}</style>
</head>
<body>
<header>
  <a class="brand" href="${esc(EDITOR.basePath)}">${esc(EDITOR.title)}</a>
  <nav>
    ${nav}
  </nav>
</header>
<main>
${body}
</main>
</body>
</html>
`;
}

/** The inline message a refused command shows above its form. */
export function refusal(message: string | null): string {
  return message ? `<div class="refusal" role="alert">${esc(message)}</div>` : "";
}

/** A lifecycle state as a badge. */
export function badge(status: unknown): string {
  return status ? `<span class="badge">${esc(status)}</span>` : "";
}
