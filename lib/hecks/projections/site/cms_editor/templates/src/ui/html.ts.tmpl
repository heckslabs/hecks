__BANNER__

// The page frame and the small helpers every page shares. Pages are plain strings built on the
// server; every value that came from the domain or the person is escaped on its way in.
import { EDITOR } from "../config.ts";
import { SCHEMA } from "../schema.ts";

/** Escapes text for an HTML body or a double-quoted attribute. */
export function esc(value: unknown): string {
  return String(value ?? "").replace(/[&<>"']/g, (char) => `&#${char.charCodeAt(0)};`);
}

/** A path under the editor's base path; each segment is URL-encoded. */
export function href(...segments: string[]): string {
  return [EDITOR.basePath, ...segments.map(encodeURIComponent)].join("/");
}

const STYLE = `
