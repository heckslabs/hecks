__BANNER__

// The small helpers every page shares. Pages are plain strings built on the server; every value that
// came from the domain or the person is escaped on its way in, so no text becomes markup.
//
// Every class name below is written out whole. The stylesheet is built by Tailwind, which finds
// classes by reading these files as text, so a class made by joining strings would not be found and
// would have no style.
import { EDITOR } from "../config.ts";
import type { Aggregate } from "../schema.ts";
import { icon } from "./icons.ts";
import { label } from "./words.ts";

/** Escapes text for an HTML body or a double-quoted attribute. */
export function esc(value: unknown): string {
  return String(value ?? "").replace(/[&<>"']/g, (char) => `&#${char.charCodeAt(0)};`);
}

/** A path under the editor's base path; each segment is URL-encoded. */
export function href(...segments: string[]): string {
  return [EDITOR.basePath, ...segments.map(encodeURIComponent)].join("/");
}

/**
 * The inline message a refused command shows above its form. The page's script moves focus to the
 * first field marked invalid, or to this block when no field is named.
 */
export function refusal(message: string | null): string {
  return message ? `<div class="alert alert-error alert-soft mb-4 items-start" tabindex="-1" data-refusal>${icon("alert")}<p class="font-medium">${esc(message)}</p></div>` : "";
}

/** A badge's classes and mark by tone. Colour is never the only cue: each tone has its own shape and the state's words. */
const TONES: Record<string, [classes: string, mark: string]> = {
  neutral: ["badge badge-soft gap-1 font-semibold", "dot"],
  ok: ["badge badge-soft badge-success gap-1 font-semibold", "success"],
  info: ["badge badge-soft badge-info gap-1 font-semibold", "info"],
  warn: ["badge badge-soft badge-warning gap-1 font-semibold", "alert"],
  danger: ["badge badge-soft badge-error gap-1 font-semibold", "alert"],
};

/** A status as a badge: its words, a shape and a colour. */
export function badge(status: unknown, tone = "neutral"): string {
  if (!status) return "";
  const [classes, mark] = TONES[tone] ?? TONES.neutral;
  return `<span class="${classes}">${icon(mark)}${esc(label(String(status)))}</span>`;
}

/** The badge of an aggregate's lifecycle state, in the tone the schema gives that state. */
export function statusBadge(agg: Aggregate, status: unknown): string {
  return badge(status, agg.lifecycle?.tones[String(status)] ?? "neutral");
}

/** A button that copies `value` to the clipboard (the page's script shows it and wires it; without a script it stays hidden). */
export function copyButton(value: string, what: string): string {
  return `<button type="button" class="btn btn-ghost btn-square btn-xs text-muted" data-copy="${esc(value)}" title="Copy ${esc(what)}" aria-label="Copy ${esc(what)}" hidden>${icon("copy")}</button>`;
}

/** A value with a button that copies it. */
export function copyable(value: string, what: string): string {
  return `<span class="inline-flex items-center gap-1"><span>${esc(value)}</span>${copyButton(value, what)}</span>`;
}
