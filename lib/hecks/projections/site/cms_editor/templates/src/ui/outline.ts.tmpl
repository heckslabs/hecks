__BANNER__

// A value shown read-only, whatever its shape: a scalar as text, a list as a list, a value object
// as its named parts. A rich-text body is not shown this way; pages.ts renders it with bodyToHtml.
import { esc } from "./html.ts";

const blank = (value: unknown): boolean => value === null || value === undefined || value === "";

/** `value` as a nested read-only outline. */
export function outline(value: unknown): string {
  if (blank(value)) return `<em>empty</em>`;
  if (Array.isArray(value)) return value.length === 0 ? `<em>none</em>` : `<ul>${value.map((item) => `<li>${outline(item)}</li>`).join("")}</ul>`;
  if (typeof value !== "object") return esc(value);
  const entries = Object.entries(value as Record<string, unknown>);
  if (entries.length === 1 && entries[0][0] === "value") return outline(entries[0][1]);
  const rows = entries.map(([key, part]) => `<div><strong>${esc(key)}</strong>: ${outline(part)}</div>`);
  return `<div class="outline">${rows.join("")}</div>`;
}

/** A one-line summary of a value, for a table cell: single-part objects show the part, lists their size. */
export function summary(value: unknown): string {
  if (blank(value)) return "";
  if (Array.isArray(value)) return `${value.length} ${value.length === 1 ? "item" : "items"}`;
  if (typeof value !== "object") return esc(value);
  const parts = Object.values(value as Record<string, unknown>).filter((part) => !blank(part) && !Array.isArray(part));
  return esc(parts.join(", "));
}
