__BANNER__

// The structured document body (`blocks` of `spans` and `items`) as read-only HTML and as form
// fields. Plain JavaScript with no dependencies, so the same file runs in node (the pages) and in
// the browser (the widget). The domain's own tree is the only format: nothing here is an editor
// format, and every text, address and attribute value is escaped on its way into markup.

export const KINDS = ["paragraph", "heading", "quote", "bullet_list", "numbered_list", "image", "divider"];
export const ALIGNS = ["left", "center", "right", "justify"];
export const MARKS = ["bold", "italic", "underline", "strike", "code"];
export const TAGS = { bold: "strong", italic: "em", underline: "u", strike: "s", code: "code" };
export const MAX_INDENT = 8;
export const MAX_DEPTH = 5;

/** The body of a document with nothing in it. */
export const emptyBody = () => ({ blocks: [] });

/** Escapes text for an HTML body or a double-quoted attribute. */
export function esc(value) {
  return String(value ?? "").replace(/[&<>"']/g, (char) => `&#${char.charCodeAt(0)};`);
}

/**
 * The address when it is one a link may carry: a path (not `//`), http://, https://, mailto: or
 * tel:, with no whitespace or control characters; otherwise null.
 */
export function safeHref(value) {
  const text = String(value ?? "");
  if (text === "" || /[\u0000- \u007f-\u009f\\]/.test(text)) return null;
  return /^(\/(?!\/)|https?:\/\/|mailto:|tel:)/i.test(text) ? text : null;
}

const markName = (mark) => (typeof mark === "string" ? mark : mark?.name);
const whole = (value, low, high) => (Number.isInteger(Number(value)) && value !== "" && value !== null ? Math.min(high, Math.max(low, Number(value))) : null);
const list = (value) => (Array.isArray(value) ? value : []);

function wrap(span, inner) {
  const names = list(span.marks).map(markName).filter((name) => MARKS.includes(name));
  const marked = [...names].reverse().reduce((html, name) => `<${TAGS[name]}>${html}</${TAGS[name]}>`, inner);
  const href = safeHref(span.href);
  return href ? `<a href="${esc(href)}" rel="noopener noreferrer">${marked}</a>` : marked;
}

/** The spans as inline HTML; a span of "\n" is a line break. */
export function spansToHtml(spans) {
  return list(spans)
    .map((span) => String(span?.text ?? "").split("\n").map((part, at) => wrap(span, (at > 0 ? "<br>" : "") + esc(part))).join(""))
    .join("");
}

const attrs = (pairs) => pairs.filter(([, value]) => value !== null && value !== undefined).map(([name, value]) => ` ${name}="${esc(value)}"`).join("");

function layout(block) {
  const align = ALIGNS.includes(block.align) ? block.align : null;
  return attrs([["data-align", align], ["data-indent", whole(block.indent, 0, MAX_INDENT)]]);
}

function itemHtml(item) {
  const kind = KINDS.slice(3, 5).includes(item?.list_kind) ? item.list_kind : null;
  const depth = whole(item?.depth, 0, MAX_DEPTH);
  return `<li${attrs([["data-depth", depth], ["data-list-kind", kind]])}>${spansToHtml(item?.spans)}</li>`;
}

function imageHtml(block) {
  const note = `<span class="body-media">image <code>${esc(block.media_ref ?? "")}</code>${block.alt ? ` ${esc(block.alt)}` : ""}</span>`;
  const caption = block.caption ? `<figcaption>${esc(block.caption)}</figcaption>` : "";
  return `<figure${attrs([["data-media-ref", block.media_ref ?? ""], ["data-alt", block.alt], ["data-caption", block.caption]])}>${note}${caption}</figure>`;
}

/**
 * One block as HTML. An unknown kind is shown as a paragraph. `demote` moves a heading down that
 * many levels (to at most 6), for a body shown inside a page that has its own headings above it.
 */
export function blockToHtml(block, demote = 0) {
  const kind = block?.kind;
  if (kind === "divider") return "<hr>";
  if (kind === "image") return imageHtml(block);
  if (kind === "bullet_list" || kind === "numbered_list") {
    const tag = kind === "bullet_list" ? "ul" : "ol";
    return `<${tag}${layout(block)}>${list(block.items).map(itemHtml).join("")}</${tag}>`;
  }
  const level = Math.min(6, (whole(block?.level, 1, 4) ?? 2) + demote);
  const tag = kind === "heading" ? `h${level}` : kind === "quote" ? "blockquote" : "p";
  return `<${tag}${layout(block ?? {})}>${spansToHtml(block?.spans)}</${tag}>`;
}

/** The body as HTML, one block after another; the same body gives the same text. */
export function bodyToHtml(body, demote = 0) {
  return list(body?.blocks).map((block) => blockToHtml(block, demote)).join("\n");
}

const present = (value) => value !== undefined && value !== null && value !== "";

function spanFields(span, name) {
  const marks = list(span.marks).map(markName).filter(present).map((mark, at) => [`${name}.marks.${at}.name`, mark]);
  return [[`${name}.text`, span.text ?? ""], ...marks, ...(present(span.href) ? [[`${name}.href`, span.href]] : [])];
}

function itemFields(item, name) {
  const spans = list(item.spans).flatMap((span, at) => spanFields(span, `${name}.spans.${at}`));
  return [...spans, ...(present(item.depth) ? [[`${name}.depth`, item.depth]] : []), ...(present(item.list_kind) ? [[`${name}.list_kind`, item.list_kind]] : [])];
}

function blockFields(block, name) {
  const spans = list(block.spans).flatMap((span, at) => spanFields(span, `${name}.spans.${at}`));
  const items = list(block.items).flatMap((item, at) => itemFields(item, `${name}.items.${at}`));
  const scalars = ["level", "align", "indent", "media_ref", "alt", "caption"].filter((key) => present(block[key])).map((key) => [`${name}.${key}`, block[key]]);
  return [[`${name}.kind`, block.kind], ...scalars, ...spans, ...items];
}

/**
 * The body as the form's own fields: `[name, value]` pairs named by dotted path under `name`
 * (`body.blocks.0.spans.1.marks.0.name`), the encoding the editor's other value objects and lists
 * use, which the server reads back into the tree the command takes.
 */
export function bodyToFields(body, name) {
  return list(body?.blocks).flatMap((block, at) => blockFields(block, `${name}.blocks.${at}`));
}

/** The fields as hidden inputs. */
export function fieldsToInputs(pairs) {
  return pairs.map(([name, value]) => `<input type="hidden" name="${esc(name)}" value="${esc(value)}">`).join("\n");
}
