__BANNER__

// Applies the remembered theme before the page is painted, so a person who chose dark never sees a
// flash of light. It is a separate small file, loaded first, because a page may carry no inline
// script. The choice is kept in localStorage (see browser/shell.js); a browser that blocks storage
// simply follows the system setting.
(function () {
  var root = document.documentElement;
  root.classList.add("js");
  try {
    var saved = window.localStorage.getItem("editor-theme");
    if (saved === "dark" || saved === "light") root.setAttribute("data-theme", "editor-" + saved);
  } catch (error) {
    /* storage is blocked: follow the system */
  }
})();
