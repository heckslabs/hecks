__BANNER__

// The pages: an overview of what the domain holds, a list per aggregate (table.ts), one instance
// (detail.ts), and a form per command generated from the command's attributes. Every page is built
// into the frame in shell.ts. Lifecycle state is a badge, and a lifecycle move is offered only from
// the states it applies in. An editor of several chapters groups the overview and the navigation by
// chapter and puts the chapter in each address.
import { EDITOR } from "../config.ts";
import { at, keyOf, membersOf } from "../names.ts";
import type { Aggregate, Attr, Command, Family, Query } from "../schema.ts";
import { SCHEMA } from "../schema.ts";
import { drafted } from "./availability.ts";
import { statusBadge } from "./html.ts";
import { detailPage as detail, titled as recordTitle } from "./detail.ts";
import type { Submitted } from "./detail.ts";
import { confirmDialog } from "./dialogs.ts";
import { fields, textBox } from "./fields.ts";
import type { Invalid } from "./fields.ts";
import { esc, href, refusal } from "./html.ts";
import { backInput, backLink, withBack } from "./links.ts";
import type { Back } from "./links.ts";
import type { View } from "./paging.ts";
import type { Choices } from "./pickers.ts";
import { PREVIEW_BUTTON, previewAction, previewable } from "./approximate.ts";
import { previewTools } from "./preview.ts";
import { scheduledTable } from "./schedule.ts";
import { SCHEDULED, chapterTitle, countMark, familiesIn, familyCountMark, groupOf, groups, onlyFor, onlyForFamily, page, tucked } from "./shell.ts";
import type { Crumb } from "./shell.ts";
import { listPage as list } from "./table.ts";
import type { World } from "./world.ts";
import { capital, commandLabel, humanize, label, nameOf, pluralName } from "./words.ts";

type State = Record<string, unknown>;
type Row = [string, State];

export type { Submitted };

const OVERVIEW: Crumb = ["Home", href()];

const head = (title: string, note: string, extra = ""): string =>
  `<div class="mb-6 flex flex-wrap items-start justify-between gap-3"><div><h1 class="text-3xl">${esc(title)}</h1><p class="mt-1 max-w-prose text-muted">${esc(note)}</p></div>${extra}</div>`;

/** The trail to an aggregate's list: the overview, then the chapter when there are several. */
const trail = (agg: Aggregate): Crumb[] => [OVERVIEW, ...(agg.chapter ? [[chapterTitle(agg.chapter)] as Crumb] : []), [pluralName(agg), href(...at(agg))]];

/** The words a page of an aggregate carries in its title: the plural, and the chapter when it could be mistaken for another. */
const titleOf = (agg: Aggregate): string => (agg.chapter ? `${pluralName(agg)} (${chapterTitle(agg.chapter)})` : pluralName(agg));

/** The commands of an aggregate that make a record a person starts: not those only a machine runs. */
const startersOf = (agg: Aggregate): Command[] => agg.commands.filter((command) => command.creates && command.role !== "System");

/**
 * One aggregate as a card of jobs: what it is (its description), a "New" task for each command that
 * makes a record, with the command's own goal as the sentence under it, and an "Edit" task that opens
 * the list, or the one record when the aggregate holds only one. Words come from the route chapter's
 * `EditorThing` and `EditorField` rows when it has them, else from the bluebook's names.
 */
function taskCard(agg: Aggregate, existing: Set<string>): string {
  const about = agg.words?.about ?? agg.description;
  const own = (to: string, text: string, note: string | null | undefined, primary: boolean): string =>
    `<li class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><a class="btn btn-sm ${primary ? "btn-neutral" : ""}" href="${esc(to)}">${esc(text)}</a>${note ? `<span class="min-w-0 text-sm text-muted">${esc(note)}</span>` : ""}</li>`;
  const single = agg.single !== undefined;
  const starters = single && existing.has(keyOf(agg)) ? [] : startersOf(agg);
  const news = starters.map((command, index) => own(href(...at(agg), "new", command.name), index === 0 ? `New ${nameOf(agg)}` : commandLabel(agg, command), command.help ?? command.goal, index === 0));
  const edit = single
    ? existing.has(keyOf(agg))
      ? [own(href(...at(agg), "id", agg.single as string), `Change ${nameOf(agg)}`, null, true)]
      : []
    : [own(href(...at(agg)), `Edit ${humanize(pluralName(agg))}`, null, false)];
  const count = single ? "" : `<span class="tabular-nums text-muted" aria-label="How many">${countMark(keyOf(agg))}</span>`;
  const note = about ? `<p class="mt-1 max-w-prose text-sm text-muted">${esc(about)}</p>` : "";
  return onlyFor(agg, `<section class="border border-base-300 bg-base-100 p-4 sm:p-5" aria-labelledby="task-${esc(keyOf(agg))}">
<div class="flex items-baseline justify-between gap-3"><h3 id="task-${esc(keyOf(agg))}" class="text-lg">${esc(pluralName(agg))}</h3>${count}</div>${note}
<ul class="mt-4 grid gap-3">
${[...news, ...edit].join("\n")}
</ul>
</section>`);
}

/**
 * A family as one card of jobs: a "New" task for each of its members' first creating command, each with
 * what that member is (its description), and one "Edit" task that opens the list of all of them.
 */
function familyCard(family: Family): string {
  const members = membersOf(family);
  const own = (to: string, text: string, note: string | null | undefined, primary: boolean): string =>
    `<li class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><a class="btn btn-sm ${primary ? "btn-neutral" : ""}" href="${esc(to)}">${esc(text)}</a>${note ? `<span class="min-w-0 text-sm text-muted">${esc(note)}</span>` : ""}</li>`;
  const news = members.flatMap((agg, index) => {
    const command = startersOf(agg)[0];
    return command ? [own(href(...at(agg), "new", command.name), `New ${nameOf(agg)}`, agg.words?.about ?? agg.description, index === 0)] : [];
  });
  const edit = own(href(family.key), `Edit ${family.plural}`, null, false);
  const note = family.about ? `<p class="mt-1 max-w-prose text-sm text-muted">${esc(family.about)}</p>` : "";
  return onlyForFamily(family, `<section class="border border-base-300 bg-base-100 p-4 sm:p-5" aria-labelledby="task-family-${esc(family.key)}">
<div class="flex items-baseline justify-between gap-3"><h3 id="task-family-${esc(family.key)}" class="text-lg">${esc(capital(family.plural))}</h3><span class="tabular-nums text-muted" aria-label="How many">${familyCountMark(family)}</span></div>${note}
<ul class="mt-4 grid gap-3">
${[edit, ...news].join("\n")}
</ul>
</section>`);
}

function cards(aggregates: Aggregate[], existing: Set<string>, chapter: string | null = null): string {
  const all = [...familiesIn(chapter).map(familyCard), ...aggregates.map((agg) => taskCard(agg, existing))];
  return `<div class="grid gap-4 lg:grid-cols-2">\n${all.join("\n")}\n</div>`;
}

/**
 * The home page: the jobs a person does, by what they are about. Aggregates the route chapter marks
 * as advanced are one fold at the end. `existing` holds the single-record aggregates that already have
 * their one record.
 */
export function home(existing: Set<string> = new Set()): string {
  const sections = groups().map(([chapter, aggregates]) => {
    if (chapter === null) return cards(aggregates, existing, null);
    return groupOf(chapter, `<h2 class="mb-3 mt-8 text-xl">${esc(chapterTitle(chapter))}</h2>\n${cards(aggregates, existing, chapter)}`);
  });
  const more = tucked();
  const behind = more.length === 0 ? "" : `<details class="mt-10 border-t border-base-300 pt-4"><summary class="cursor-pointer font-semibold">More</summary><p class="mt-2 text-sm text-muted">What the pages above are made from. Most jobs never need these.</p><div class="mt-4">${cards(more, existing)}</div></details>`;
  const body = `${head(SCHEMA.chapters ? EDITOR.brand : SCHEMA.domain, "What would you like to do?")}
${sections.join("\n")}
${behind}`;
  return page("Home", body, { crumbs: [["Home"]] });
}

/**
 * The page for a path that names nothing, or, with a `title`, for another reason the person is
 * sent back (the domain not answering, a chapter closed to their role): the heading and the tab
 * say that reason, not "Not found".
 */
export function notFound(what: string, title = "Not found"): string {
  const body = `${head(title, what)}
<p><a class="btn" href="${esc(href())}">Back to the home page</a></p>`;
  return page(title, body, { crumbs: [OVERVIEW, [title]] });
}

/** An aggregate's list: one page of its rows, with the filters in `view`. */
export function listPage(agg: Aggregate, rows: Row[], query: Query | null, error: string | null, asked: boolean, view: View, choices: Choices = {}): string {
  return page(titleOf(agg), list(agg, rows, query, error, asked, view, choices), { active: keyOf(agg), crumbs: [OVERVIEW, ...(agg.chapter ? [[chapterTitle(agg.chapter)] as Crumb] : []), [pluralName(agg)]] });
}

/** One record of a family, as its list shows it. */
export interface FamilyRow {
  member: Aggregate;
  id: string;
  title: string;
  /** The state of the family's `titles` record, when it has a lifecycle (live, down), or undefined. */
  status?: unknown;
  titles?: Aggregate;
}

/** A family's list: every record of every member, named, typed and with whether it shows and has an unpublished edit. */
export function familyPage(family: Family, rows: [FamilyRow, State][]): string {
  const members = membersOf(family);
  const adds = members.flatMap((agg, index) => {
    const command = startersOf(agg)[0];
    return command ? [`<a class="btn ${index === 0 ? "btn-neutral" : ""}" href="${esc(href(...at(agg), "new", command.name))}">${esc(`New ${nameOf(agg)}`)}</a>`] : [];
  });
  const lines = rows.map(([row, state]) => {
    const to = href(...at(row.member), "id", row.id);
    const edit = row.member.drafts ? href(...at(row.member), "id", row.id, row.member.drafts.save) : to;
    const status = row.titles?.lifecycle && row.status !== undefined ? statusBadge(row.titles, row.status) : "";
    const unpublished = drafted(row.member, state) ? `<span class="badge badge-soft badge-info">Changes not published yet</span>` : "";
    return `<tr class="hover:bg-base-200/60" data-row><th scope="row" class="min-w-44 font-normal" data-value="${esc(row.title)}"><a class="link link-hover font-semibold" href="${esc(to)}">${esc(row.title)}</a><span class="block text-xs text-muted">${esc(row.id)}</span></th><td data-value="${esc(nameOf(row.member))}">${esc(capital(nameOf(row.member)))}</td><td data-value="${esc(String(row.status ?? ""))}">${status}</td><td>${unpublished}</td><td class="text-right"><a class="btn btn-sm" href="${esc(edit)}">Edit</a></td></tr>`;
  });
  const table = lines.length === 0
    ? `<p class="border-y border-base-300 bg-base-100 px-4 py-16 text-center text-muted">No ${esc(family.plural)} yet.</p>`
    : `<div class="overflow-x-auto border-y border-base-300 bg-base-100 lg:overflow-visible"><table class="table [&_thead_th]:bg-base-100 [&_thead_th]:text-xs [&_thead_th]:text-muted" data-sortable><thead><tr><th scope="col" data-sort="text">${esc(capital(family.name))}</th><th scope="col" data-sort="text">Kind</th><th scope="col" data-sort="text">Status</th><th scope="col">Draft</th><th scope="col"><span class="sr-only">Edit</span></th></tr></thead><tbody>
${lines.join("\n")}
</tbody></table></div>`;
  const body = `<div class="mb-6 flex flex-wrap items-end justify-between gap-4"><div><h1 class="text-3xl">${esc(capital(family.plural))}</h1>${family.about ? `<p class="mt-1 max-w-prose text-muted">${esc(family.about)}</p>` : ""}</div><div class="flex flex-wrap gap-2">${adds.join("\n")}</div></div>
<p class="mb-3 tabular-nums text-muted">${rows.length} ${esc(rows.length === 1 ? family.name : family.plural)}</p>
${table}`;
  const crumbs: Crumb[] = [OVERVIEW, ...(family.chapter ? [[chapterTitle(family.chapter)] as Crumb] : []), [capital(family.plural)]];
  return page(capital(family.plural), body, { active: `family:${family.key}`, crumbs });
}

/** One instance, with the records and actions that go with it and its preview. `named` is what a person calls it, when that is not its key. */
export function detailPage(agg: Aggregate, id: string, values: State, shown: Submitted | null, world: World, named?: string): string {
  const crumbs: Crumb[] = [...trail(agg), [named ?? id]];
  const tools = previewTools(agg, id);
  const title = named ?? recordTitle(agg, id, values);
  return page(title, detail(agg, id, values, shown, world, tools, named), { active: keyOf(agg), crumbs: [...crumbs.slice(0, -1), [title]], drawer: tools.drawer });
}

/** Every action waiting to run, soonest first. */
export function scheduledPage(world: World): string {
  const body = `${head("Scheduled", SCHEMA.scheduling?.runs?.length ? "What is waiting to go up or come down, soonest first. The editor does each one when its time comes." : "What is waiting to run, soonest first. These are saved here and run by something outside this editor.")}
${scheduledTable(world, href("scheduled"))}`;
  return page("Scheduled", body, { active: SCHEDULED, crumbs: [OVERVIEW, ["Scheduled"]] });
}

/**
 * What a command's form starts from: the instance's values, and for a working copy the instance has
 * not saved yet (a draft not yet saved) the live content it stands for, and for a rich-text body or a
 * block list the one it holds of the same shape, so an edit begins from the current content and not
 * an empty page.
 */
function startingValues(agg: Aggregate, command: Command, state: State): State {
  const values = { ...state };
  const unset = (value: unknown): boolean => value == null || (Array.isArray(value) && value.length === 0);
  const drafts = agg.drafts;
  if (drafts && drafts.save === command.name && unset(values[drafts.attribute]) && !unset(state[drafts.live])) values[drafts.attribute] = state[drafts.live];
  for (const attr of command.attributes.filter((candidate: Attr) => (candidate.widget === "body" || candidate.blockList) && unset(values[candidate.name]))) {
    const held = agg.attributes.find((other) => other.type === attr.type && other.name !== attr.name && !unset(state[other.name]));
    if (held) values[attr.name] = state[held.name];
  }
  if (command.creates) {
    for (const attr of command.attributes.filter((candidate: Attr) => candidate.default !== undefined && unset(values[candidate.name]))) {
      const parts = attr.kind === "object" ? (agg.valueObjects[attr.type] ?? []) : [];
      values[attr.name] = parts.length === 1 ? { [parts[0].name]: attr.default } : attr.default;
    }
  }
  return values;
}

const FORM = "command-form";

function invalidOf(own: Submitted | null): Invalid | null {
  return own?.field && own.message ? { field: own.field, message: own.message.replace(/^.*?: /s, "") } : null;
}

/** The buttons of a command's form: the command itself, and for one that makes something, the same and then another. */
function submits(agg: Aggregate, command: Command, back: Back | null, action: string): string {
  const text = esc(commandLabel(agg, command));
  if (command.destructive) return `<button type="submit" class="btn btn-error" data-busy data-confirm="confirm-${esc(command.name)}">${text}</button>`;
  const again = command.creates && !back ? `<button type="submit" class="btn" name="__again" value="1" data-busy>Save and add another</button>` : "";
  const view = previewable(agg) && command.attributes.length > 0 ? `<button type="submit" class="btn btn-ghost" name="__previewcmd" value="${esc(command.name)}" formaction="${esc(previewAction(action, command.creates))}" formtarget="_blank" formnovalidate>${PREVIEW_BUTTON}</button>` : "";
  return `${view}${again}<button type="submit" class="btn btn-neutral" data-busy>${text}</button>`;
}

/** What a command's form may be given beyond the command: the instance's values, the choices on offer and the way back. */
interface Extras {
  state?: State;
  /** Whether the form names the instance to act on, for a command that acts on another aggregate's. */
  to?: boolean;
  cancel?: string;
  choices?: Choices;
  back?: Back | null;
  /** The instance the form acts on, which a draft's buttons need. */
  id?: string;
  /** The text of the records that go with this one, written on this form (see texts.ts): each box and what it holds now. */
  texts?: { index: number; label: string; help?: string; attr: Attr; target: Aggregate; value: string }[];
}

/**
 * The status line, and the buttons that publish or throw away the draft, on the page of the command
 * that saves one. The question each asks is a dialog after the form; the publish dialog saves what is
 * still unsaved first (`data-flush-draft`, see browser/autosave.js).
 */
function draftTools(agg: Aggregate, command: Command, extras: Extras): { bar: string; dialogs: string } {
  const drafts = agg.drafts;
  if (!drafts || drafts.save !== command.name || !extras.id) return { bar: "", dialogs: "" };
  const id = extras.id;
  const back = extras.back ?? null;
  const saved = (extras.state ?? {})[drafts.attribute];
  const held = saved != null && !(Array.isArray(saved) && saved.length === 0);
  const make = (name?: string): Command | undefined => agg.commands.find((candidate) => candidate.name === name && candidate.on === agg.name && candidate.attributes.length === 0);
  const ask = (command: Command | undefined, words: string, classes: string, tone: "neutral" | "error", flush: boolean, hidden: boolean): [string, string] => {
    if (!command) return ["", ""];
    const to = href(...at(agg), "id", id, command.name);
    const link = back ? withBack(to, back.path) : to;
    const button = `<a class="${classes}" href="${esc(link)}" data-confirm="confirm-${esc(command.name)}"${hidden ? " hidden data-draft-discard" : ""}>${esc(words)}</a>`;
    return [button, confirmDialog(agg, command, to, id, undefined, { back, tone, button: words, flush })];
  };
  const publish = ask(make(drafts.publish), "Publish draft", "btn btn-neutral", "neutral", true, false);
  const discard = ask(make(drafts.discard), "Discard draft", "btn btn-error btn-outline", "error", false, !held);
  const live = esc(label(drafts.live).toLowerCase());
  const note = `${held ? "A draft is saved." : "No draft is saved yet."} The live ${live} changes only when the draft is published.`;
  const bar = `<div class="mb-4 flex flex-wrap items-center gap-2" data-draft-bar><p class="mr-auto text-sm text-muted" role="status" aria-live="polite" data-draft-status>${note}</p>${discard[0]}${publish[0]}</div>`;
  return { bar, dialogs: `${publish[1]}\n${discard[1]}` };
}

/** A form for one command; `to` adds the id input a command acting on another aggregate needs. */
export function commandForm(agg: Aggregate, command: Command, action: string, shown: Submitted | null, extras: Extras = {}): string {
  const { state = {}, to = false, choices = {}, back = null } = extras;
  const own = shown && shown.command === command.name ? shown : null;
  const said = command.help ?? command.goal;
  const note = said ? `<p class="mb-4 max-w-prose text-muted">${esc(said.replace(/\.$/, ""))}.</p>` : "";
  const target = to
    ? `<div class="my-4 grid gap-1"><label for="f-to" class="font-semibold">${esc(command.on ?? "")} id <span class="text-primary" aria-hidden="true">*</span></label><input type="text" class="input w-full max-w-xl" id="f-to" name="__to" value="${esc(own?.values.__to ?? "")}"></div>`
    : "";
  const dialog = command.destructive ? confirmDialog(agg, command, action, "", FORM, { back }) : "";
  const draft = draftTools(agg, command, extras);
  const saved = command.attributes.find((attr) => attr.name === agg.drafts?.attribute);
  const whole = saved !== undefined && saved.widget !== "body" && saved.blockList === undefined;
  const mode = draft.bar ? ` data-draft="${esc(agg.drafts?.attribute)}"${whole ? " data-draft-form" : ""}` : "";
  const leave = back?.path ?? extras.cancel ?? href(...at(agg));
  const boxes = (extras.texts ?? []).map((box) => textBox(box.target, box.attr, `__text.${box.index}`, box, own ? String(own.values[`__text.${box.index}`] ?? "") : box.value, own?.textField === `__text.${box.index}` && own.textMessage ? { field: `__text.${box.index}`, message: own.textMessage } : null)).join("\n");
  return `<form class="max-w-3xl" id="${FORM}" method="post" action="${esc(action)}" data-form${mode}>
${backInput(back)}${refusal(own?.message ?? null)}${note}
${draft.bar}
${target}
${fields(agg, command.attributes, own ? own.values : startingValues(agg, command, state), invalidOf(own), true, choices, draft.bar ? agg.drafts?.attribute : undefined, own?.problems ?? [], boxes)}
<div data-actionbar class="sticky bottom-0 z-10 -mx-4 mt-8 flex items-center justify-end gap-2 border-t border-base-300 bg-base-100 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-8px_16px_-12px_rgb(0_0_0/0.25)]"><p class="mr-auto text-xs text-muted"><span class="text-primary" aria-hidden="true">*</span> Required</p><a class="btn btn-ghost" href="${esc(leave)}">Cancel</a>${submits(agg, command, back, action)}</div>
</form>
${dialog}${draft.dialogs}`;
}

/** The page of one creating command (or a command that acts on another aggregate's instance); `state` fills it, `back` is where saving returns to. */
export function commandPage(agg: Aggregate, command: Command, action: string, shown: Submitted | null, choices: Choices = {}, extras: Extras = {}): string {
  const crumbs: Crumb[] = [...trail(agg), [commandLabel(agg, command)]];
  const form = commandForm(agg, command, action, shown, { ...extras, to: command.on !== null && command.on !== agg.name, choices });
  const title = command.creates ? `New ${nameOf(agg)}` : commandLabel(agg, command);
  const kind = command.creates ? "" : label(nameOf(agg));
  return page(title, `${backLink(extras.back ?? null)}${head(title, kind)}\n${form}`, { active: keyOf(agg), crumbs });
}

/** The page of a command that acts on one instance: its form, or the question a destructive one asks. */
export function instanceCommandPage(agg: Aggregate, id: string, command: Command, values: State, shown: Submitted | null, choices: Choices = {}, back: Back | null = null, texts: Extras["texts"] = [], named?: string): string {
  const action = href(...at(agg), "id", id, command.name);
  const crumbs: Crumb[] = [...trail(agg), [named ?? id, href(...at(agg), "id", id)], [commandLabel(agg, command)]];
  const tools = previewTools(agg, id);
  const title = `${backLink(back)}${head(commandLabel(agg, command), `${capital(nameOf(agg))} ${named ?? id}`, tools.button)}`;
  const cancel = back?.path ?? href(...at(agg), "id", id);
  const frame = { active: keyOf(agg), crumbs, drawer: tools.drawer };
  if (command.destructive && command.attributes.length === 0) {
    const own = shown && shown.command === command.name ? shown.message : null;
    const ask = `<form class="max-w-3xl" method="post" action="${esc(action)}" data-form>${backInput(back)}${refusal(own)}<p>${esc(command.goal ?? `This applies to ${id}`)}. Choose ${esc(commandLabel(agg, command))} to go ahead.</p>
<div class="mt-6 flex justify-end gap-2"><a class="btn btn-ghost" href="${esc(cancel)}">Cancel</a><button type="submit" class="btn btn-error" data-busy>${esc(commandLabel(agg, command))}</button></div></form>`;
    return page(commandLabel(agg, command), `${title}\n${ask}`, frame);
  }
  return page(commandLabel(agg, command), `${title}\n${commandForm(agg, command, action, shown, { state: values, cancel, choices, back, id, texts })}`, frame);
}
