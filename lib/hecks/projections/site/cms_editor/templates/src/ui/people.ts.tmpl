__BANNER__

// The People screen: who may edit, in plain words. One row a person with their role, whether they are
// turned off or have yet to sign in, a way to change the role and to turn them off or on, and a form
// to add someone. It is for the roles that administer; the editor refuses the rest.
import { EDITOR } from "../config.ts";
import type { Person } from "../people.ts";
import { givable, roleWords } from "../people.ts";
import { badge, esc, href } from "./html.ts";
import { page } from "./shell.ts";

/** What the navigation holds the People screen under. */
export const PEOPLE = "__people";

function status(person: Person): string {
  if (person.disabled) return badge("Turned off", "danger");
  return person.signedIn ? badge("Active", "ok") : badge("Waiting for first sign-in", "info");
}

function roleForm(person: Person): string {
  const options = givable()
    .map((role) => `<option value="${esc(role)}"${role === person.role ? " selected" : ""}>${esc(role)}</option>`)
    .join("");
  const other = person.role && !givable().includes(person.role) ? `<option value="${esc(person.role)}" selected>${esc(person.role)}</option>` : "";
  return `<form class="flex flex-wrap items-center gap-2" method="post" action="${esc(href("people", "role"))}"><input type="hidden" name="email" value="${esc(person.email)}"><label class="sr-only" for="role-${esc(person.email)}">Role of ${esc(person.name || person.email)}</label><select class="select select-sm" id="role-${esc(person.email)}" name="role"${person.disabled ? " disabled" : ""}>${other}${options}</select><button class="btn btn-sm" type="submit"${person.disabled ? " disabled" : ""}>Change role</button></form>`;
}

function toggle(person: Person, me: string): string {
  if (person.email === me.toLowerCase()) return `<span class="text-sm text-muted">This is you.</span>`;
  const to = href("people", person.disabled ? "turn-on" : "turn-off");
  const text = person.disabled ? "Turn back on" : "Turn off";
  return `<form method="post" action="${esc(to)}"><input type="hidden" name="email" value="${esc(person.email)}"><button class="btn btn-sm ${person.disabled ? "" : "btn-error btn-outline"}" type="submit">${text}</button></form>`;
}

function row(person: Person, me: string): string {
  return `<tr><td><span class="font-semibold">${esc(person.name || person.email)}</span><br><span class="break-all text-sm text-muted">${esc(person.email)}</span></td><td>${esc(person.role ?? "No role")}<br><span class="text-xs text-muted">${esc(person.role ? roleWords(person.role) : "Cannot sign in to edit.")}</span></td><td>${status(person)}</td><td>${roleForm(person)}</td><td>${toggle(person, me)}</td></tr>`;
}

/** The screen: the list and the form that adds a person. `error` is shown above, for a refused change. */
export function peoplePage(people: Person[], me: string, error: string | null = null): string {
  const roles = givable().map((role) => `<option value="${esc(role)}">${esc(role)}: ${esc(roleWords(role))}</option>`).join("");
  const table =
    people.length === 0
      ? `<p class="text-muted">Nobody is on the list yet.</p>`
      : `<div class="overflow-x-auto border border-base-300 bg-base-100"><table class="table"><thead><tr><th scope="col">Person</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Change role</th><th scope="col"><span class="sr-only">Turn off or on</span></th></tr></thead><tbody>${people.map((person) => row(person, me)).join("\n")}</tbody></table></div>`;
  const add = `<form class="mt-8 max-w-xl border border-base-300 bg-base-100 p-4 sm:p-6" method="post" action="${esc(href("people", "add"))}" aria-labelledby="add-person">
<h2 id="add-person" class="text-lg">Add a person</h2>
<p class="mt-1 text-sm text-muted">They sign in with the Google account for this email. Nothing is sent to them; tell them yourself.</p>
<label class="mt-4 grid gap-1 font-semibold">Name<input class="input w-full" name="name" autocomplete="off" required aria-required="true"></label>
<label class="mt-4 grid gap-1 font-semibold">Email<input class="input w-full" type="email" name="email" autocomplete="off" required aria-required="true"></label>
<label class="mt-4 grid gap-1 font-semibold">Role<select class="select w-full" name="role">${roles}</select></label>
<div class="mt-4"><button class="btn btn-neutral" type="submit">Add this person</button></div>
</form>`;
  const alert = error ? `<div class="alert alert-error alert-soft mb-4" role="alert" tabindex="-1" data-refusal><p class="font-medium">${esc(error)}</p></div>` : "";
  const main = `<div class="mb-6"><h1 class="text-3xl">People</h1><p class="mt-1 max-w-prose text-muted">Who may sign in to ${esc(EDITOR.brand || EDITOR.title)} and change the site. A person turned off keeps their place but cannot sign in until you turn them back on.</p></div>
${alert}${table}
${add}`;
  return page("People", main, { active: PEOPLE, crumbs: [["Home", href()], ["People"]] });
}
