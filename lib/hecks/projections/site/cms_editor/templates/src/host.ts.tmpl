__BANNER__

// The domain host, reached the way every server-side caller reaches it: @hecks/client's HostClient
// posting to /dispatch from this machine. The host accepts that protocol from a loopback peer only,
// which is why this server, not the browser, talks to it; it authenticates each person itself
// (auth/) before any of these calls is made on their behalf.
import { HostClient } from "@hecks/client";

import { EDITOR } from "./config.ts";
import { SCHEMA } from "./schema.ts";

export interface HostOptions {
  /** The host's address, when not read from the environment variable the Editor row names. */
  url?: string;
  fetch?: typeof fetch;
}

/** The host's base URL, without a trailing slash. */
export function hostUrl(options: HostOptions = {}): string {
  return (options.url ?? (process.env[EDITOR.hostEnv] || EDITOR.hostDefault)).replace(/\/+$/, "");
}

/** A client for the domain this editor edits. */
export function hostClient(options: HostOptions = {}): HostClient {
  return new HostClient({ domain: SCHEMA.domain, url: hostUrl(options), fetch: options.fetch, timeoutMs: EDITOR.timeoutMs });
}
