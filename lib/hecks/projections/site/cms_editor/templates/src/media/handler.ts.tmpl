__BANNER__

// The pictures: `POST <base>/media` takes an upload, `GET <base>/media` lists the registered
// pictures, and `GET <base>/media/<key>` serves one. Every request reaching here is already
// authenticated by app.ts; nothing is read or written before that.
//
// An upload is checked before anything is kept: a bounded read of the body, an allow-list of raster
// types decided by the picture's own first bytes, a size cap from the Editor row, and alt text. The
// bytes then go through the storage port under a key made from their own digest, and the domain's
// register-picture command records the picture (key, alt text, type, size). The domain never holds
// the bytes, and a client-supplied filename is never used.
import { createHash } from "node:crypto";

import { DomainRefusal, rowsOf } from "@hecks/client";
import type { HostClient } from "@hecks/client";

import { instanceIn, leaf, runCommand } from "../commands.ts";
import type { State } from "../commands.ts";
import { EDITOR } from "../config.ts";
import { hostClient } from "../host.ts";
import type { HostOptions } from "../host.ts";
import { SCHEMA } from "../schema.ts";
import type { Aggregate, Media, MediaField } from "../schema.ts";
import { boundaryOf, parts } from "./multipart.ts";
import { EXTENSION_OF, KEY_PATTERN, TYPE_OF, sizeOf, sniff } from "./sniff.ts";
import { diskStorage } from "./storage.ts";
import type { MediaStorage } from "./storage.ts";

/** The room the form's framing takes beyond the picture's own size cap. */
const OVERHEAD_BYTES = 65_536;

const json = (value: unknown, status = 200): Response =>
  new Response(JSON.stringify(value), { status, headers: { "Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store" } });

const refuse = (status: number, error: string): Response => json({ error }, status);

/** The body, or null when it is larger than `limit`: no more than `limit` bytes are ever held. */
async function readBounded(request: Request, limit: number): Promise<Uint8Array | null> {
  const declared = Number(request.headers.get("content-length") ?? 0);
  if (declared > limit) return null;
  const reader = request.body?.getReader();
  const chunks: Uint8Array[] = [];
  let size = 0;
  while (reader) {
    const { done, value } = await reader.read();
    if (done) break;
    size += value.length;
    if (size > limit) {
      await reader.cancel();
      return null;
    }
    chunks.push(value);
  }
  return Buffer.concat(chunks);
}

/** A value as the command takes it: in the value object's part when the attribute is one. */
function sent(field: MediaField, value: string | number): unknown {
  return field.wrap ? { [field.wrap]: value } : value;
}

function recordOf(media: Media, key: string, alt: string, mime: string, bytes: Uint8Array): State {
  const record: State = {
    [media.fields.key.name]: sent(media.fields.key, key),
    [media.fields.alt.name]: sent(media.fields.alt, alt),
    [media.fields.mime.name]: sent(media.fields.mime, mime),
  };
  const size = sizeOf(bytes, mime);
  const { width, height } = media.fields;
  if (size && width) record[width.name] = sent(width, size.width);
  if (size && height) record[height.name] = sent(height, size.height);
  return record;
}

function picture(storage: MediaStorage, media: Media, state: State) {
  const key = leaf(state[media.fields.key.name]);
  return key === null ? null : { key, alt: leaf(state[media.fields.alt.name]) ?? "", mime: leaf(state[media.fields.mime.name]) ?? "", url: storage.url(key) };
}

function aggregateOf(media: Media): Aggregate {
  return media.definition ?? (SCHEMA.aggregates.find((candidate) => candidate.name === media.aggregate) as Aggregate);
}

/** What was uploaded, or the refusal to answer with. */
async function received(request: Request): Promise<{ file: Uint8Array; alt: string; error?: undefined } | { error: Response }> {
  const limit = EDITOR.mediaMaxBytes;
  const body = await readBounded(request, limit + OVERHEAD_BYTES);
  if (!body) return { error: refuse(413, `A picture may be at most ${limit} bytes.`) };
  const boundary = boundaryOf(request.headers.get("content-type"));
  const sections = boundary ? parts(body, boundary) : [];
  const file = sections.find((part) => part.name === "file" && part.filename !== null);
  if (!file || file.data.length === 0) return { error: refuse(400, "Choose a picture to upload.") };
  if (file.data.length > limit) return { error: refuse(413, `A picture may be at most ${limit} bytes.`) };
  const alt = Buffer.from(sections.find((part) => part.name === "alt")?.data ?? []).toString("utf8").trim();
  return { file: file.data, alt };
}

async function upload(client: HostClient, storage: MediaStorage, request: Request, media: Media): Promise<Response> {
  const got = await received(request);
  if (got.error) return got.error;
  const mime = sniff(got.file);
  if (!mime) return refuse(415, "Only JPEG, PNG, WebP, GIF and AVIF pictures are accepted.");
  if (got.alt === "") return refuse(422, "Describe the picture in alt text before adding it.");
  const key = `${createHash("sha256").update(got.file).digest("hex")}.${EXTENSION_OF[mime]}`;
  const agg = aggregateOf(media);
  const answer = await client.read();
  const known = instanceIn(client, answer, agg, key);
  if (known) return json({ ...picture(storage, media, known), registered: false });
  await storage.put(key, got.file, mime);
  const command = agg.commands.find((candidate) => candidate.name === media.command) as NonNullable<typeof agg.commands[number]>;
  const outcome = await runCommand(client, agg, command, recordOf(media, key, got.alt, mime, got.file));
  if (!outcome.ok) return refuse(422, outcome.message);
  return json({ key, alt: got.alt, mime, url: storage.url(key), registered: true }, 201);
}

async function stateOf(client: HostClient, media: Media): Promise<State[]> {
  const agg = aggregateOf(media);
  if (!media.listing) return client.instancesOf(await client.read(), agg.name).map(([, state]) => state);
  const name = `${agg.name}.${media.listing}`;
  return (rowsOf(await client.query(name, {}), name) ?? []) as State[];
}

async function listing(client: HostClient, storage: MediaStorage, media: Media): Promise<Response> {
  try {
    const pictures = (await stateOf(client, media)).flatMap((state) => picture(storage, media, state) ?? []);
    return json({ pictures });
  } catch (err) {
    if (err instanceof DomainRefusal) return refuse(422, err.message);
    throw err;
  }
}

async function serve(storage: MediaStorage, key: string): Promise<Response> {
  const bytes = KEY_PATTERN.test(key) ? await storage.read(key) : null;
  if (!bytes) return refuse(404, "No such picture.");
  return new Response(bytes as BodyInit, {
    headers: {
      "Content-Type": TYPE_OF[key.slice(key.lastIndexOf(".") + 1)],
      "Content-Length": String(bytes.length),
      "X-Content-Type-Options": "nosniff",
      "Content-Security-Policy": "default-src 'none'; sandbox",
      "Cache-Control": "private, max-age=300",
    },
  });
}

/**
 * The handler of everything under `<base>/media`, given the path segments after `media`. When the
 * pictures are kept in another chapter (`media.domain`), they are read and registered through a
 * client for that chapter, not the editor's own.
 */
export function mediaHandler(storage: MediaStorage = diskStorage(), options: HostOptions = {}) {
  const media = SCHEMA.media as Media;
  const elsewhere = media.domain ? hostClient({ ...options, domain: media.domain }) : null;
  return (editors: HostClient, request: Request, rest: string[]): Promise<Response> | Response => {
    const client = elsewhere ?? editors;
    if (rest.length === 0 && request.method === "POST") return upload(client, storage, request, media);
    if (rest.length === 0 && request.method === "GET") return listing(client, storage, media);
    if (rest.length === 1 && request.method === "GET") return serve(storage, rest[0]);
    return refuse(404, "No such page.");
  };
}
