__BANNER__

// Where a picture's bytes are kept. The domain holds a picture's record (key, alt text, type, size)
// and never its bytes; the bytes go through this port. `diskStorage` writes them under the directory
// the Editor row names (`media_dir`). A project that keeps pictures in an object store implements the
// same interface (`put` a key's bytes, `read` them back, and `url` where a browser can show one) and
// passes it to `createApp({ storage })`; nothing else in the editor changes.
import { mkdir, readFile, rename, writeFile } from "node:fs/promises";
import { join, resolve } from "node:path";

import { EDITOR } from "../config.ts";
import { KEY_PATTERN } from "./sniff.ts";

export interface MediaStorage {
  /** Keeps `bytes` under `key`; keeping the same key again keeps the same bytes. */
  put(key: string, bytes: Uint8Array, mime: string): Promise<void>;
  /** The address a signed-in editor's browser shows the picture from. */
  url(key: string): string;
  /** The bytes kept under `key`, or null when there are none. */
  read(key: string): Promise<Uint8Array | null>;
}

/** The directory's file for `key`; a key that is not one this editor generates is refused. */
function fileFor(directory: string, key: string): string {
  if (!KEY_PATTERN.test(key)) throw new RangeError("not a picture key");
  return join(directory, key);
}

/** Pictures on the local disk, under `directory` (resolved from the working directory). */
export function diskStorage(directory: string = EDITOR.mediaDir): MediaStorage {
  const root = resolve(directory);
  return {
    async put(key, bytes) {
      const file = fileFor(root, key);
      await mkdir(root, { recursive: true });
      const partial = `${file}.${process.pid}.part`;
      await writeFile(partial, bytes);
      await rename(partial, file);
    },
    url: (key) => `${EDITOR.basePath}/media/${key}`,
    async read(key) {
      try {
        return await readFile(fileFor(root, key));
      } catch (err) {
        if ((err as NodeJS.ErrnoException).code === "ENOENT" || err instanceof RangeError) return null;
        throw err;
      }
    },
  };
}
