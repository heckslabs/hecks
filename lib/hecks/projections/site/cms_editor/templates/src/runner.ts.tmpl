__BANNER__

// The runner of scheduled actions. The editor only ever made the records of what is due (ui/schedule.ts);
// this is what does it. At a fixed interval it reads the scheduling aggregate, and for each action
// still waiting whose time has come it runs the command the route chapter's `EditorRun` rows say for
// the record's kind and the action, through the host like any person's save, so the domain's own
// rules still apply, and then reports back with the scheduling aggregate's own commands: done, or
// failed with the reason. An action is settled once. A record already in the state the action wants
// is done; one that cannot be moved is failed, in words, and left for a person.
//
// It lives in the editor's own process so that there is nothing more to start: the editor is the
// one writer of these records and the host is reached the way the editor reaches it. Two editors
// would not double a run: a record that moved is refused the second time and the action settles once.
import { DomainRefusal, DomainUnavailable } from "@hecks/client";
import type { HostClient } from "@hecks/client";

import { instanceIn, runCommand } from "./commands.ts";
import { hostClient } from "./host.ts";
import { qualified } from "./names.ts";
import { SCHEMA } from "./schema.ts";
import type { Aggregate, Command } from "./schema.ts";
import { available } from "./ui/availability.ts";
import { plainText, plainValue } from "./ui/links.ts";
import { secondsOf } from "./ui/moments.ts";
import { schedulingAggregate } from "./ui/world.ts";

type State = Record<string, unknown>;

/** What came of one due action. */
export interface Report {
  /** The scheduled action's own identity. */
  id: string;
  subject: string;
  action: string;
  outcome: "done" | "failed";
  /** For a failure, why, in words; for a done action what was changed ("" when nothing had to be). */
  message: string;
}

/** How long a reason may be: the scheduling aggregate keeps it as plain text. */
const REASON_LIMIT = 300;

/** The aggregate a subject key's kind names, among the subject's kinds. */
function targetOf(kind: string): Aggregate | undefined {
  const sched = schedulingAggregate();
  const subject = sched?.attributes.find((attr) => attr.name === SCHEMA.scheduling?.subject);
  const named = subject?.picker?.kinds?.find((candidate) => candidate.kind === kind && candidate.target);
  return named && SCHEMA.aggregates.find((agg) => agg.name === named.target && agg.chapter === named.chapter);
}

/** The state a command moves a record to, when it is a lifecycle move. */
const movesTo = (agg: Aggregate, command: Command): string | undefined => agg.lifecycle?.transitions.find((move) => move.verb === command.name)?.to;

/** What one due action does, as a report, without reporting it back (see `settle`). */
async function perform(client: HostClient, key: string, word: string): Promise<{ ok: true; message: string } | { ok: false; message: string }> {
  const colon = key.indexOf(":");
  const kind = colon > 0 ? key.slice(0, colon) : "";
  const slug = colon > 0 ? key.slice(colon + 1) : key;
  const agg = targetOf(kind);
  if (!agg) return { ok: false, message: `Nothing in this editor is called "${kind}".` };
  const run = (SCHEMA.scheduling?.runs ?? []).find((row) => row.aggregate === agg.name && (!row.chapter || row.chapter === agg.chapter) && row.action === word);
  if (!run) return { ok: false, message: `This editor does not know how to ${word} a ${kind.replace(/_/g, " ")}.` };
  const values = instanceIn(client, await client.read(), agg, slug) as State | undefined;
  if (!values) return { ok: false, message: `There is no ${kind.replace(/_/g, " ")} called ${slug} any more.` };
  const commands = run.commands.map((name) => agg.commands.find((command) => command.name === name)).filter((command): command is Command => command !== undefined);
  const state = agg.lifecycle ? String(values[agg.lifecycle.field]) : "";
  if (commands.some((command) => movesTo(agg, command) === state)) return { ok: true, message: "" };
  const pick = commands.find((command) => available(agg, command, values));
  if (!pick) return { ok: false, message: `It is ${state}, so "${word}" does not apply to it now.` };
  if (pick.attributes.length > 0) return { ok: false, message: `${pick.name} needs details a schedule cannot give.` };
  const outcome = await runCommand(client, agg, pick, {}, slug);
  return outcome.ok ? { ok: true, message: pick.name } : { ok: false, message: outcome.message };
}

/** Reports an action back to the scheduling aggregate as done, or failed with the reason. */
async function settle(client: HostClient, id: string, result: { ok: boolean; message: string }): Promise<void> {
  const spec = SCHEMA.scheduling;
  const sched = schedulingAggregate();
  if (!spec || !sched) return;
  const reason = spec.reason ? sched.attributes.find((attr) => attr.name === spec.reason) : undefined;
  if (result.ok && spec.complete) {
    await client.dispatch(`${qualified(sched)}.${spec.complete}`, {}, id, "System");
  } else if (spec.fail && reason) {
    const words = result.message.slice(0, REASON_LIMIT) || "It could not be done.";
    await client.dispatch(`${qualified(sched)}.${spec.fail}`, { [reason.name]: plainValue(sched, reason, words) }, id, "System");
  }
}

/**
 * Runs every action that is due at `seconds` (whole seconds since 1970), soonest first, one at a
 * time with a fresh read before each so two actions for one record see each other's result.
 *
 * @throws {DomainUnavailable} when the host cannot be reached
 */
export async function runDue(client: HostClient, seconds: number): Promise<Report[]> {
  const spec = SCHEMA.scheduling;
  const sched = schedulingAggregate();
  if (!spec || !sched || !sched.lifecycle || !spec.runs || spec.runs.length === 0) return [];
  const rows = client.instancesOf(await client.read(), qualified(sched));
  const dueAt = (row: State): number => secondsOf(row[spec.due]) ?? Number.POSITIVE_INFINITY;
  const waiting = rows.filter(([, row]) => row[sched.lifecycle?.field ?? ""] === spec.pending && dueAt(row) <= seconds);
  waiting.sort((a, b) => dueAt(a[1]) - dueAt(b[1]));
  const reports: Report[] = [];
  for (const [id, row] of waiting) {
    const subject = plainText(row[spec.subject]);
    const action = plainText(row[spec.action]);
    const result = await perform(client, subject, action);
    await settle(client, id, result);
    reports.push({ id, subject, action, outcome: result.ok ? "done" : "failed", message: result.message });
  }
  return reports;
}

export interface RunnerOptions {
  client?: HostClient;
  /** Seconds between looks; `EDITOR_RUN_EVERY` when not given, 30 otherwise; 0 means do not run. */
  every?: number;
  now?: () => number;
  log?: (line: string) => void;
}

/** One line of what came of an action, for the process's log. */
export const line = (report: Report): string => `runner: ${report.subject} ${report.action} ${report.outcome}${report.message ? `: ${report.message}` : ""}`;

/**
 * Starts the loop and returns the function that stops it. A pass that finds the host unreachable
 * says so once and tries again at the next interval; a pass never overlaps the one before.
 */
export function startRunner(options: RunnerOptions = {}): () => void {
  const every = options.every ?? Number(process.env.EDITOR_RUN_EVERY ?? 30);
  const log = options.log ?? ((text: string) => console.log(text));
  if (!(every > 0) || !SCHEMA.scheduling?.runs?.length) return () => {};
  const client = options.client ?? hostClient();
  const now = options.now ?? Date.now;
  let stopped = false;
  let down = false;
  let timer: ReturnType<typeof setTimeout> | undefined;
  const pass = async (): Promise<void> => {
    try {
      for (const report of await runDue(client, Math.floor(now() / 1000))) log(line(report));
      down = false;
    } catch (err) {
      if (!(err instanceof DomainUnavailable || err instanceof DomainRefusal)) throw err;
      if (!down) log(`runner: the domain did not answer (${err.message}); trying again`);
      down = true;
    }
    if (!stopped) timer = setTimeout(() => void pass(), every * 1000);
  };
  timer = setTimeout(() => void pass(), 1000);
  log(`runner: looking for due actions every ${every} seconds`);
  return () => {
    stopped = true;
    if (timer) clearTimeout(timer);
  };
}
