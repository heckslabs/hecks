__BANNER__

// Who may edit. The people are the records of the aggregate the Editor row names (`members_aggregate`)
// and the host keeps the rules about them: it will not turn off the last administrator or the person
// asking. This is the editor's screen over them, for the roles that administer (`adminRoles`):
// list, add a person with a role, change a role, turn a person off and back on.
//
// Adding and changing a role are the aggregate's own commands over the host's loopback protocol (the
// host's `/members` routes grant only a fixed set of roles, which has no editor role). Turning a
// person off and on is the host's own route, asked as the signed-in person with the short account
// token the membership check uses, so its rules (not yourself, not the last administrator) answer
// in its words. A role change that would leave no administrator is refused here, since it goes
// around that route.
import { accountToken, resolveAccountCookieName } from "@hecks/client";
import type { HostClient } from "@hecks/client";

import { authSecret } from "./auth/membership.ts";
import { EDITOR } from "./config.ts";
import { hostClient, hostUrl } from "./host.ts";

type State = Record<string, unknown>;

export interface Person {
  email: string;
  name: string;
  role: string | null;
  disabled: boolean;
  /** Whether they have signed in at least once. */
  signedIn: boolean;
}

export interface PeopleOptions {
  url?: string;
  fetch?: typeof fetch;
  secret?: string;
  client?: HostClient;
}

const plain = (value: unknown): string => {
  if (value && typeof value === "object") return plain(Object.values(value as object).find((part) => part !== null && part !== undefined));
  return value === null || value === undefined ? "" : String(value);
};

/** The roles a person may be given here: the editor's own, without the one that is a synonym of administrator. */
export const givable = (): string[] => EDITOR.roles.filter((role) => role !== "Owner");

/** What each role lets a person do, in the words the screen shows beside it. */
export function roleWords(role: string): string {
  if (EDITOR.adminRoles.includes(role)) return "Can edit everything and decide who may edit.";
  return "Can edit the site's content.";
}

const isAdmin = (person: Person): boolean => person.role !== null && EDITOR.adminRoles.includes(person.role) && !person.disabled;

/** The service over the people. */
export function peopleService(options: PeopleOptions = {}) {
  const members = EDITOR.members;
  const send = options.fetch ?? fetch;
  const client = (): HostClient => options.client ?? hostClient({ url: options.url, fetch: options.fetch, domain: members?.domain });

  /** The host's own members list, asked as the person at the screen: it alone says who is turned off. */
  async function list(caller: string): Promise<Person[]> {
    const secret = options.secret ?? authSecret();
    const cookieName = resolveAccountCookieName(process.env.HECKS_SESSION_COOKIE || EDITOR.hostCookie);
    const res = await send(`${hostUrl({ url: options.url })}${EDITOR.membersPath}`, {
      headers: { Cookie: `${cookieName}=${accountToken(secret, caller, 60)}` },
      signal: AbortSignal.timeout(EDITOR.timeoutMs),
    });
    if (!res.ok) throw new Error(`the host did not list the people (${res.status})`);
    const rows = (await res.json()) as { name?: string | null; email?: string; role?: string | null; linked?: boolean; disabled?: boolean }[];
    return rows
      .map((row) => ({ email: String(row.email ?? "").toLowerCase(), name: row.name ?? "", role: row.role ?? null, disabled: row.disabled === true, signedIn: row.linked === true }))
      .sort((a, b) => (a.name || a.email).localeCompare(b.name || b.email));
  }

  /** Admits a person and gives them a role; refused in words when they are on the list already or the role is not one to give. */
  async function add(caller: string, name: string, emailText: string, role: string): Promise<{ ok: true } | { ok: false; message: string }> {
    const email = emailText.trim().toLowerCase();
    if (name.trim() === "") return { ok: false, message: "Write the person's name." };
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return { ok: false, message: "That does not look like an email address. Write it like name@example.org." };
    if (!givable().includes(role)) return { ok: false, message: `Choose one of: ${givable().join(", ")}.` };
    const held = (await list(caller)).find((person) => person.email === email);
    if (held) {
      return { ok: false, message: held.disabled ? `${email} is on the list but turned off. Turn them back on instead.` : `${email} is already on the list as ${held.role ?? "someone with no role"}. Change their role there.` };
    }
    const from = client();
    const admit = await from.dispatch(`${members?.aggregate}.Admit`, { email: { value: email }, name: { value: name.trim() } }, undefined, "Admin");
    if (admit.refusals?.length) return { ok: false, message: String(admit.refusals.at(-1)?.error ?? "The host did not add them.") };
    const grant = await from.dispatch(`${members?.aggregate}.GrantAccess`, { role: { value: role } }, email, "Admin");
    if (grant.refusals?.length) return { ok: false, message: String(grant.refusals.at(-1)?.error ?? "They were added but the role was not given. Change their role from the list.") };
    return { ok: true };
  }

  /** Changes a role, refusing what would leave no administrator or touch someone who is turned off. */
  async function changeRole(caller: string, emailText: string, role: string): Promise<{ ok: true } | { ok: false; message: string }> {
    const email = emailText.trim().toLowerCase();
    if (!givable().includes(role)) return { ok: false, message: `Choose one of: ${givable().join(", ")}.` };
    const people = await list(caller);
    const target = people.find((person) => person.email === email);
    if (!target) return { ok: false, message: "That person is not on the list." };
    if (target.disabled) return { ok: false, message: "That person is turned off. Turn them back on first, then change their role." };
    if (target.role === role) return { ok: true };
    if (isAdmin(target) && !EDITOR.adminRoles.includes(role) && people.filter(isAdmin).length <= 1) {
      return { ok: false, message: "There must always be at least one administrator, so the last one cannot become an editor. Make someone else an administrator first." };
    }
    const grant = await client().dispatch(`${members?.aggregate}.GrantAccess`, { role: { value: role } }, email, "Admin");
    return grant.refusals?.length ? { ok: false, message: String(grant.refusals.at(-1)?.error ?? "The role was not changed.") } : { ok: true };
  }

  /** Turns a person off or back on through the host's own route, asked as the person at the screen. */
  async function setDisabled(caller: string, emailText: string, disable: boolean): Promise<{ ok: true } | { ok: false; message: string }> {
    const secret = options.secret ?? authSecret();
    const cookieName = resolveAccountCookieName(process.env.HECKS_SESSION_COOKIE || EDITOR.hostCookie);
    const res = await send(`${hostUrl({ url: options.url })}${disable ? "/members/disable" : "/members/enable"}`, {
      method: "POST",
      headers: { "Content-Type": "application/json", Cookie: `${cookieName}=${accountToken(secret, caller, 60)}` },
      body: JSON.stringify({ email: emailText.trim() }),
      signal: AbortSignal.timeout(EDITOR.timeoutMs),
    });
    if (res.ok) return { ok: true };
    const words: Record<number, string> = {
      401: "You are signed out. Sign in again and try once more.",
      403: disable ? "You cannot turn off your own access. Ask another administrator to do it." : "Only an administrator can do this.",
      404: "That person is not on the list.",
      409: "There must always be at least one administrator, so the last one cannot be turned off. Make someone else an administrator first.",
    };
    return { ok: false, message: words[res.status] ?? "The host did not make the change. Try again." };
  }

  return { list, add, changeRole, setDisabled };
}
