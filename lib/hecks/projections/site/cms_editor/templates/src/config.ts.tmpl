__BANNER__

// What the editor is built from: the project's Editor row, defaults filled. Change the row and run
// `hecks site site_projection.project_site`; with `--check` it fails when this file is out of date.

export const EDITOR = {
  title: __TITLE__,
  brand: __BRAND__,
  logo: __LOGO__,
  basePath: __BASE_PATH__,
  ssoPath: __SSO_PATH__,
  login: __LOGIN__,
  sessionCookie: __SESSION_COOKIE__,
  sessionMaxAge: 28800,
  flashMaxAge: 60,
  hostCookie: __HOST_COOKIE__,
  hostEnv: __HOST_ENV__,
  hostDefault: __HOST_DEFAULT__,
  roles: __ROLES__,
  mediaDir: __MEDIA_DIR__,
  mediaMaxBytes: __MEDIA_MAX_BYTES__,
  pageSize: __PAGE_SIZE__,
  /** Where a record is shown on the site, with `{key}`, `{kind}`, `{slug}` and `{id}`; null for no preview. */
  preview: __PREVIEW__ as string | null,
  /** `drawer` frames the site's page beside the record; `tab` opens it in a new tab (a site that will not be framed). */
  previewIn: __PREVIEW_IN__ as "drawer" | "tab",
  /** Where files are sent to be kept (the content system's API root and its address), or null for none. */
  upload: __UPLOAD__ as { env: string; default: string; api: string } | null,
  /** The aggregate of people who may edit, read over the host's own protocol, or null to ask the members list. */
  members: __MEMBERS__ as { domain: string; aggregate: string; email: string; role: string } | null,
  /** The site's own modules for reading and showing Markdown (see browser/markdown_site.js), or null. */
  markdown: __MARKDOWN__ as { parse: string; render: string } | null,
  accountPath: "/accounts/me",
  membersPath: "/members",
  rememberMs: 60000,
  timeoutMs: 5000,
} as const;
