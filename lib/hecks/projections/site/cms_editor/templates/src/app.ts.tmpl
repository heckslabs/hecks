export interface AppOptions {
  /** The host's address, when not read from the environment variable the Editor row names. */
  url?: string;
  /** The content system's address that files are sent to, when not read from the environment variable the Editor row names. */
  cms?: string;
  fetch?: typeof fetch;
  secret?: string;
  now?: () => number;
  membership?: Membership;
__MEDIA_OPTION__
}

/**
 * What every page is sent with. The editor loads its own script, stylesheet, pictures and icons and
 * nothing else, so the policy names no other origin and allows no inline script and no inline style
 * (no `style` attribute, no style element: the stylesheet is a file, and the writing surface is told
 * to inject none). `data:` in `img-src` is for the sprite-free case of a picture drawn from a data
 * address; `blob:` shows a picture chosen for upload before it is sent. Script may still set styles
 * through the page's object model, which the policy allows.
 */
const POLICY = [
  "default-src 'none'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self' data: blob:",
  "connect-src 'self'",
  "form-action 'self'",
__FRAME_POLICY__
  "base-uri 'none'",
  "frame-ancestors 'none'",
].join("; ");

const PAGE_HEADERS = {
  "Content-Type": "text/html; charset=utf-8",
  "Cache-Control": "no-store",
  "Content-Security-Policy": POLICY,
  "Referrer-Policy": "same-origin",
  "X-Content-Type-Options": "nosniff",
};

const plain = (body: string, status: number): Response => new Response(body, { status, headers: { "Content-Type": "text/plain; charset=utf-8" } });

const redirect = (location: string, status = 303, ...cookies: string[]): Response => {
  const headers = new Headers({ Location: location });
  for (const cookie of cookies) headers.append("Set-Cookie", cookie);
  return new Response(null, { status, headers });
};

/** A post is refused when the browser says it came from another site. */
function sameSite(request: Request): boolean {
  const origin = request.headers.get("origin");
  if (origin) return new URL(origin).host === new URL(request.url).host;
  return (request.headers.get("sec-fetch-site") ?? "same-origin") !== "cross-site";
}

/** What a route needs to answer: show a page for this person, or send them on with a notice. */
interface Scene {
  /** The person's role, which decides the chapters they may edit. */
  role: string | null;
  /** The clock a form's blank "now" is read from. */
  now: () => number;
  show(body: string, status?: number, notice?: Flash): Promise<Response>;
  sent(location: string, message: string): Response;
}

/** The editor, as a handler. */
export function createApp(options: AppOptions = {}): (request: Request) => Promise<Response> {
  const secret = options.secret ?? authSecret();
  const now = options.now ?? Date.now;
  const membership = options.membership ?? membershipCheck({ url: options.url, fetch: options.fetch, secret, now });
  const client = hostClient({ url: options.url, fetch: options.fetch });
  const upload = uploadHandler({ url: options.cms, fetch: options.fetch, secret, now });
  const library = libraryService({ url: options.cms, fetch: options.fetch, secret, now });
  const people = peopleService({ url: options.url, fetch: options.fetch, secret });
__MEDIA_SETUP__

  /**
   * The instances each aggregate holds, for the navigation; a host that cannot say shows no counts.
   * The host has no count to ask for, so they are the lengths of what one read answers, the same
   * read a page of a list is made from.
   */
  async function counts(from: HostClient): Promise<Record<string, number>> {
    try {
      const answer = await from.read();
      return Object.fromEntries(SCHEMA.aggregates.map((agg) => [keyOf(agg), from.instancesOf(answer, qualified(agg)).length]));
    } catch {
      return {};
    }
  }

  /**
   * The People screen and what it posts: add, change a role, turn off, turn on. Only the roles that
   * administer reach it. A refusal is shown on the screen again, in words; a change that worked
   * is a notice on the screen.
   */
  async function peopleView(email: string, role: string | null, request: Request, segments: string[]): Promise<Response> {
    const flash = readFlash(request.headers.get("cookie"), secret, now);
    const scene = sceneFor(email, role, flash, client);
    if (role === null || !EDITOR.adminRoles.includes(role)) return scene.show(notFound("Only an administrator decides who may edit.", "Not open to your role"), 403);
    if (request.method === "GET" && segments.length === 1) return scene.show(peoplePage(await people.list(email), email));
    if (request.method !== "POST" || segments.length !== 2) return scene.show(notFound("No such page."), 404);
    const form = parseForm(await request.text());
    const value = (name: string): string => (form.get(name) ?? "").trim();
    const done = (message: string): Response => scene.sent(href("people"), message);
    const refuse = async (message: string): Promise<Response> => scene.show(peoplePage(await people.list(email), email, message), 422);
    const action = segments[1];
    if (action === "add") {
      const result = await people.add(email, value("name"), value("email"), value("role"));
      return result.ok ? done(`${value("email").toLowerCase()} was added as ${value("role")}.`) : refuse(result.message);
    }
    if (action === "role") {
      const result = await people.changeRole(email, value("email"), value("role"));
      return result.ok ? done(`${value("email").toLowerCase()} is now ${value("role")}.`) : refuse(result.message);
    }
    if (action === "turn-off" || action === "turn-on") {
      const result = await people.setDisabled(email, value("email"), action === "turn-off");
      return result.ok ? done(`${value("email").toLowerCase()} was turned ${action === "turn-off" ? "off" : "back on"}.`) : refuse(result.message);
    }
    return scene.show(notFound("No such page."), 404);
  }

  /** The library screen, or with `/data` the same page as JSON for a field's chooser. */
  async function libraryView(email: string, role: string | null, request: Request, url: URL): Promise<Response> {
    const known = libraryCollections();
    const wanted = url.searchParams.get("collection") ?? known[0]?.collection ?? "";
    const collection = known.find((one) => one.collection === wanted)?.collection ?? known[0]?.collection ?? "";
    const q = (url.searchParams.get("q") ?? "").trim().slice(0, 200);
    const number = Number.parseInt(url.searchParams.get("page") ?? "1", 10) || 1;
    const asJson = url.pathname.endsWith("/data");
    const from = reading(client);
    const found = await library(email, collection, q, number, asJson ? undefined : from);
    if (asJson) {
      return new Response(JSON.stringify(found), { status: "error" in found ? 502 : 200, headers: { "Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store" } });
    }
    const scene = sceneFor(email, role, readFlash(request.headers.get("cookie"), secret, now), from);
    return scene.show(libraryPage(found, collection, q));
  }

  function sceneFor(email: string, role: string | null, flash: Flash | null, from: HostClient): Scene {
    return {
      role,
      now,
      async show(body, status = 200, notice) {
        const text = decorate(body, { email, role, counts: await counts(from), flash: notice ?? flash });
        const response = new Response(text, { status, headers: PAGE_HEADERS });
        if (flash) response.headers.append("Set-Cookie", spentFlash());
        return response;
      },
      sent: (location, message) => redirect(location, 303, flashCookie({ kind: "success", message }, secret, now)),
    };
  }

  /**
   * A person who is signed in on the site but has no editor session yet: the site's own session
   * cookie says who they are (it is the host's account token, checked here with the shared secret),
   * and the membership list says whether they may edit. This is how a person who may edit but not
   * administer the site arrives, since the site's admin pages send only administrators on. An
   * admitted person gets their session and the page they asked for; one who is not is told so.
   */
  async function enterFromSite(request: Request, url: URL): Promise<Response | null> {
    if (request.method !== "GET") return null;
    const name = resolveAccountCookieName(process.env.HECKS_SESSION_COOKIE || EDITOR.hostCookie);
    const claims = accountFromCookieHeader(request.headers.get("cookie"), secret, { cookieName: name, now, normalizeEmail: true });
    if (!claims) return null;
    if (!(await membership.isAdmitted(claims.email))) {
      const words = `You are signed in as ${claims.email}, which is not allowed to edit here. Ask someone who runs the site to add you as an editor, then come back.`;
      return anonymous(notFound(words, "You cannot sign in here"), 403);
    }
    return redirect(`${url.pathname}${url.search}`, 303, sessionCookie(signSession(secret, claims.email, now)));
  }

  /**
   * The edge's question before it serves a page: is this address a page that is hidden? Answered
   * without a session (it says nothing a visitor cannot learn from the 404 itself): 404 for a hidden
   * page, 204 for anything else. The path is `?path=`, or the original address a forwarding proxy sends.
   */
  async function gate(url: URL, request: Request): Promise<Response> {
    const asked = url.searchParams.get("path") ?? request.headers.get("x-forwarded-uri") ?? "";
    // A host that cannot answer is not a reason to hide the site: an unknown page is shown.
    const hidden = asked !== "" && (await isHidden(client, asked, now()).catch(() => false));
    return new Response(hidden ? "Page not found." : null, { status: hidden ? 404 : 204, headers: { "Cache-Control": "no-store", ...(hidden ? { "Content-Type": "text/plain; charset=utf-8" } : {}) } });
  }

  /**
   * The site's sitemap without the pages that are hidden (the edge routes `/sitemap.xml` here). The
   * site's own is read as a visitor would, from the address the Editor row names.
   */
  async function sitemap(): Promise<Response> {
    const origin = (process.env[EDITOR.site?.env ?? ""] || EDITOR.site?.default || "").replace(/\/+$/, "");
    try {
      const own = await (options.fetch ?? fetch)(`${origin}/sitemap.xml`, { signal: AbortSignal.timeout(EDITOR.timeoutMs) });
      if (!own.ok) return plain("The site's sitemap could not be read.", 502);
      const hidden = await hiddenSet(client, now()).catch(() => new Set<string>());
      return new Response(withoutHidden(await own.text(), hidden), { status: 200, headers: { "Content-Type": "application/xml; charset=utf-8", "Cache-Control": "no-store" } });
    } catch {
      return plain("The site's sitemap could not be read.", 502);
    }
  }

  async function handle(request: Request): Promise<Response> {
    const url = new URL(request.url);
    const path = url.pathname.replace(/\/+$/, "") || "/";
    if (path === EDITOR.ssoPath) return enter(url, secret, membership, now);
    if (EDITOR.landing && path === EDITOR.landing) return redirect(href(), 303);
    if (SCHEMA.pages?.length && path === href("gate") && request.method === "GET") return gate(url, request);
    if (SCHEMA.pages?.length && EDITOR.site && path === href("sitemap.xml") && request.method === "GET") return sitemap();
    if (path !== EDITOR.basePath && !path.startsWith(`${EDITOR.basePath}/`)) return anonymous(notFound(path), 404);
    if (path === href("logout") && request.method === "POST") return signOut(request);

    const email = readSession(request.headers.get("cookie"), secret, now);
    if (!email) {
      const entered = await enterFromSite(request, url);
      if (entered) return entered;
    }
    if (EDITOR.signIn && path === href("login") && request.method === "GET") {
      if (email && (await membership.isAdmitted(email))) return redirect(href(), 303);
      return new Response(loginPage((url.searchParams.get("note") as LoginNote | null) ?? null), { status: 200, headers: PAGE_HEADERS });
    }
    if (!email || !(await membership.isAdmitted(email))) {
      return request.method === "GET" ? redirect(EDITOR.signIn ? href("login") : EDITOR.login, 302) : plain("Sign in again.", 403);
    }
    if (request.method === "POST" && !sameSite(request)) return plain("Cross-site post refused.", 403);
    const segments = path.slice(EDITOR.basePath.length).split("/").filter(Boolean).map(decodeURIComponent);
    if (segments[0] === "upload" && segments.length === 2) return upload(email, request, segments[1]);
    const role = membership.roleOf ? await membership.roleOf(email) : null;
    if (segments[0] === "library" && request.method === "GET" && EDITOR.upload) return libraryView(email, role, request, url);
    if (segments[0] === "people" && EDITOR.members) return peopleView(email, role, request, segments);
__MEDIA_ROUTE__
    const reader = request.method === "GET" ? reading(client) : client;
    const scene = sceneFor(email, role, readFlash(request.headers.get("cookie"), secret, now), reader);
    return actor.run({ email }, () => route(reader, request, url, segments, scene));
  }

  return async (request) => {
    try {
      return await handle(request);
    } catch (err) {
      if (err instanceof DomainUnavailable) return anonymous(notFound(`The domain could not be reached: ${err.message}`, "The domain is not answering"), 502);
      throw err;
    }
  };
}

/** A page for someone with no session to show, such as a path the editor does not serve. */
function anonymous(body: string, status: number): Response {
  return new Response(decorate(body, { email: "", role: null, counts: {}, flash: null }), { status, headers: PAGE_HEADERS });
}

/** Ends the session: the cookie is cleared and the person is sent to the site's login page. */
function signOut(request: Request): Response {
  if (!sameSite(request)) return plain("Cross-site post refused.", 403);
  // The site's own sign-in cookie goes too, or the next visit would walk straight back in through it.
  const host = `${resolveAccountCookieName(process.env.HECKS_SESSION_COOKIE || EDITOR.hostCookie)}=; Max-Age=0; Path=/; HttpOnly; SameSite=Lax`;
  return redirect(EDITOR.signIn ? `${href("login")}?note=signed-out` : EDITOR.login, 303, clearedCookie(), host);
}

async function enter(url: URL, secret: string, membership: Membership, now: () => number): Promise<Response> {
  const result = await signIn(url.searchParams.get("token"), secret, membership, now);
  if (!result.ok) return anonymous(notFound(result.message, "You cannot sign in here"), result.status);
  return redirect(result.location, 302, result.cookie);
}

function route(client: HostClient, request: Request, url: URL, segments: string[], scene: Scene): Promise<Response> | Response {
  if (segments.length === 0) return homeView(client, scene);
  if (segments[0] === "assets" && segments.length === 2 && request.method === "GET") return serveAsset(segments[1], request);
  if (segments[0] === "help" && segments.length === 1 && request.method === "GET") return scene.show(helpPage());
  if (segments[0] === "scheduled" && segments.length === 1 && request.method === "GET" && SCHEMA.scheduling) return scheduledView(client, scene);
  const family = SCHEMA.families?.find((candidate) => candidate.key === segments[0]);
  if (family && segments.length === 1 && request.method === "GET") return familyView(client, family, scene);
  const { agg, rest: [verb, ...rest] } = locate(segments);
  if (!agg) return scene.show(notFound(`No aggregate ${segments.slice(0, SCHEMA.chapters ? 2 : 1).join("/")}.`), 404);
  if (!mayEdit(agg, scene.role)) return scene.show(notFound(`${plural(agg.name)} are not open to your role.`, "Not open to your role"), 403);
  if (verb === undefined) return list(client, agg, url, scene);
  if (verb === "id" && rest.length === 1 && request.method === "GET") return detail(client, agg, rest[0], null, scene);
  if (verb === "id" && rest.length === 2 && request.method === "GET") return instanceView(client, agg, rest[0], rest[1], url, scene);
  if (verb === "id" && rest.length === 2 && rest[1] === "restore" && request.method === "POST") return restore(client, request, agg, rest[0], scene);
  if (request.method === "POST" && rest.at(-1) === "preview" && ((verb === "id" && rest.length === 2) || (verb === "new" && rest.length === 2))) {
    return approximate(client, request, agg, verb === "id" ? rest[0] : null, scene);
  }
  if (request.method === "POST") return post(client, request, agg, verb, rest, scene);
  if ((verb === "new" || verb === "run") && rest.length === 1) return commandView(client, agg, verb, rest[0], url, scene);
  return scene.show(notFound(`No page ${segments.join("/")}.`), 404);
}

/** The home page; it needs to know which one-record aggregates already hold their record. */
async function homeView(client: HostClient, scene: Scene): Promise<Response> {
  const singles = SCHEMA.aggregates.filter((agg) => agg.single !== undefined);
  const existing = new Set<string>();
  if (singles.length > 0) {
    try {
      const answer = await client.read();
      for (const agg of singles) if (client.instancesOf(answer, qualified(agg)).some(([id]) => id === agg.single)) existing.add(keyOf(agg));
    } catch {
      /* a host that cannot say shows the tasks as if none existed */
    }
  }
  return scene.show(home(existing));
}

/** A family's list: every record of its members the person may edit, named by the family's `titles` records. */
async function familyView(client: HostClient, family: Family, scene: Scene): Promise<Response> {
  const answer = await client.read();
  const titles = family.titles ? aggregateOf(family.titles) : undefined;
  const lookup = (agg: Aggregate, id: string) => instanceIn(client, answer, agg, id);
  const rows = membersOf(family)
    .filter((member) => mayEdit(member, scene.role))
    .flatMap((member) =>
      client.instancesOf(answer, qualified(member)).map(([id, state]): [FamilyRow, State] => {
        const record = titles ? lookup(titles, slugOf(id)) : undefined;
        const status = record && titles?.lifecycle ? record[titles.lifecycle.field] : undefined;
        return [{ member, id, title: titleFor(member, id, lookup) ?? id, status, titles }, state];
      }),
    )
    .sort(([a], [b]) => a.title.localeCompare(b.title));
  return scene.show(familyPage(family, rows));
}

/** The pairs of an address a list keeps on every link: its view and that view's arguments, not the filters or the page. */
const KEPT = (key: string): boolean => !["_page", "_q", "_status"].includes(key);

/** The filters and the page an address asks for. */
function asked(url: URL): { q: string; status: string; page: number; size: number; params: [string, string][] } {
  const page = Number.parseInt(url.searchParams.get("_page") ?? "1", 10);
  return {
    q: (url.searchParams.get("_q") ?? "").trim().slice(0, 200),
    status: url.searchParams.get("_status") ?? "",
    page: Number.isFinite(page) ? page : 1,
    size: EDITOR.pageSize,
    params: [...url.searchParams].filter(([key]) => KEPT(key)),
  };
}

async function list(client: HostClient, agg: Aggregate, url: URL, scene: Scene): Promise<Response> {
  const query = agg.queries.find((candidate) => candidate.name === url.searchParams.get("query")) ?? null;
  const form = parseForm(url.search.slice(1));
  const args = query ? commandArguments(agg, query.attributes, form) : {};
  const wanted = query !== null && (query.attributes.length === 0 || Object.keys(args).length > 0);
  const raw = asked(url);
  const filters = { ...raw, status: knownStatus(agg, raw.status) };
  const choices = query ? await choicesFor(client, agg, query.attributes) : {};
  const none = viewOf(0, 0, filters);
  if (query && !wanted) return scene.show(listPage(agg, [], query, null, false, none, choices));
  try {
    const found = await rowsFor(client, agg, wanted ? query : null, args);
    const matching = narrow(agg, found, filters.q, filters.status);
    const view: View = viewOf(matching.length, found.length, filters);
    return scene.show(listPage(agg, slice(matching, view), query, null, true, view, choices));
  } catch (err) {
    if (err instanceof DomainRefusal) return scene.show(listPage(agg, [], query, err.message, true, none, choices), 200);
    throw err;
  }
}

async function rowsFor(client: HostClient, agg: Aggregate, query: { name: string } | null, args: State): Promise<[string, State][]> {
  if (!query) return client.instancesOf(await client.read(), qualified(agg));
  const name = `${qualified(agg)}.${query.name}`;
  const rows = rowsAnswered(await client.query(name, args), name);
  return rows.flatMap((row): [string, State][] => {
    const id = idOf(agg, row);
    return id === null ? [] : [[id, row]];
  });
}

const refused = (agg: Aggregate, command: Command): Flash => ({ kind: "error", message: `${commandLabel(agg, command)} was not applied. Fix what is marked and try again.` });

/** What a page of one record may read of the rest of the domain, from the read the page already made. */
async function worldFor(client: HostClient, answer: Answer, role: string | null, record?: { agg: Aggregate; id: string }): Promise<World> {
  const world: World = { role, lookup: (agg, id) => instanceIn(client, answer, agg, id), rows: (agg) => client.instancesOf(answer, qualified(agg)) };
  if (record) {
    const own = instanceIn(client, answer, record.agg, record.id) ?? {};
    world.history = entriesFor([{ aggregate: qualified(record.agg), id: record.id }, ...companionRecords(record.agg, record.id, own, role)]);
  }
  const asked = record && schedules(record.agg, role) ? subjectQuery(record.agg, record.id) : null;
  const sched = schedulingAggregate();
  if (!asked || !sched) return world;
  const name = `${qualified(sched)}.${asked.name}`;
  try {
    const rows = rowsAnswered(await client.query(name, asked.args), name);
    return { ...world, actions: rows.flatMap((row): [string, State][] => (idOf(sched, row) === null ? [] : [[idOf(sched, row) as string, row]])) };
  } catch (err) {
    if (err instanceof DomainRefusal || err instanceof DomainUnavailable) return world;
    throw err;
  }
}

/** The screen of every pending action, for those who may edit them. */
async function scheduledView(client: HostClient, scene: Scene): Promise<Response> {
  const sched = schedulingAggregate();
  if (!sched) return scene.show(notFound("Nothing is scheduled here."), 404);
  if (!mayEdit(sched, scene.role)) return scene.show(notFound("Scheduled actions are not open to your role.", "Not open to your role"), 403);
  return scene.show(scheduledPage(await worldFor(client, await client.read(), scene.role)));
}

async function detail(client: HostClient, agg: Aggregate, id: string, shown: Submitted | null, scene: Scene, status = 200): Promise<Response> {
  const answer = await client.read();
  const values = instanceIn(client, answer, agg, id);
  if (!values) return scene.show(notFound(`No ${agg.name} ${id}.`), 404);
  const command = agg.commands.find((candidate) => candidate.name === shown?.command);
  const world = await worldFor(client, answer, scene.role, { agg, id });
  return scene.show(detailPage(agg, id, values, shown, world, titleFor(agg, id, world.lookup)), status, shown && command ? refused(agg, command) : undefined);
}

/** The page of a command that acts on one instance, when that instance is in a state it applies to. */
async function instanceView(client: HostClient, agg: Aggregate, id: string, name: string, url: URL, scene: Scene): Promise<Response> {
  const answer = await client.read();
  const values = instanceIn(client, answer, agg, id);
  if (!values) return scene.show(notFound(`No ${agg.name} ${id}.`), 404);
  const command = commandFor(agg, "id", name);
  if (!command || !available(agg, command, values)) return scene.show(notFound(`${name} does not apply to ${id} now.`), 404);
  const choices = await choicesFor(client, agg, command.attributes);
  const named = titleFor(agg, id, (other, key) => instanceIn(client, answer, other, key));
  return scene.show(instanceCommandPage(agg, id, command, values, null, choices, backOf(url.searchParams.get("_back")), await boxesFor(client, agg, command, scene.role, id), named));
}

/** A command's page; a link may fill its inputs from the address and name the page to return to. */
async function commandView(client: HostClient, agg: Aggregate, verb: string, name: string, url: URL, scene: Scene): Promise<Response> {
  const command = commandFor(agg, verb, name);
  if (!command) return scene.show(notFound(`No command ${name}.`), 404);
  const state = commandArguments(agg, command.attributes, parseForm(url.search.slice(1)));
  const back = backOf(url.searchParams.get("_back"));
  const texts = await boxesFor(client, agg, command, scene.role);
  return scene.show(commandPage(agg, command, href(...at(agg), verb, name), null, await choicesFor(client, agg, command.attributes), { state, back, texts }));
}

/** The command a `new` (creating) or `run` (acting on another aggregate) path names, or null. */
function commandFor(agg: Aggregate, verb: string, name: string): Command | null {
  const command = agg.commands.find((candidate) => candidate.name === name);
  if (!command) return null;
  if (verb === "new") return command.creates ? command : null;
  if (verb === "run") return !command.creates && command.on !== agg.name ? command : null;
  return command.on === agg.name ? command : null;
}

/** What a form is refused for before the command is sent: a key a picker names that is not there. */
async function unchecked(client: HostClient, agg: Aggregate, command: Command, args: State): Promise<{ ok: false; message: string; field: string } | null> {
  const problem = await unknownKey(client, agg, command.attributes, args);
  return problem ? { ok: false, message: problem.message, field: problem.field } : null;
}

/** What a form is refused for before it is sent: a key a picker names that is not there, an address already held, a range that ends before it starts. */
async function beforeSending(client: HostClient, agg: Aggregate, command: Command, args: State): Promise<{ ok: false; message: string; field?: string; problems?: Problem[] } | null> {
  return (await unchecked(client, agg, command, args)) ?? backwards(agg, command, args) ?? (await duplicate(client, agg, command, args));
}

/**
 * The start of a page. A new page's form asks for its title and address with the rest of it; the
 * record that holds those (the family's `titles`) is made first, then the page under the key
 * `<kind>:<address>`, so a person fills in one form. A record of that address that is already there
 * with no page of this kind under it (an earlier try that was refused after it was made) is used, not
 * refused. Returns the arguments of the page's own command, or what to show instead.
 */
async function startPage(client: HostClient, agg: Aggregate, command: Command, args: State): Promise<{ ok: true; args: State } | { ok: false; message: string; field?: string; problems?: Problem[] }> {
  const start = command.starts;
  const titles = start ? aggregateOf(start.aggregate) : undefined;
  const create = titles?.commands.find((candidate) => candidate.name === start?.command);
  const keyAttr = start ? agg.attributes.find((attr) => attr.name === start.key) : undefined;
  if (!start || !titles || !create || !keyAttr) return { ok: true, args };
  const address = addressOf(plainText(args[start.identity]));
  const key = `${start.kind}:${address}`;
  const own: State = Object.fromEntries(Object.entries(args).filter(([name]) => start.keep.includes(name)));
  const identity = create.attributes.find((attr) => attr.name === start.identity);
  if (identity && address !== "") own[start.identity] = plainValue(titles, identity, address);
  const rest: State = { ...Object.fromEntries(Object.entries(args).filter(([name]) => !start.keep.includes(name))), [start.key]: plainValue(agg, keyAttr, key) };
  const answer = await client.read();
  if (address !== "" && instanceIn(client, answer, agg, key)) {
    const named = titleFor(agg, key, (other, id) => instanceIn(client, answer, other, id));
    return { ok: false, field: start.identity, message: `That address is already used by ${named ?? key}. Change the address, or open that one to edit it.` };
  }
  const refused = await beforeSending(client, agg, command, rest);
  if (refused) return refused;
  if (address !== "" && instanceIn(client, answer, titles, address)) return { ok: true, args: rest };
  const sent: State = { ...own };
  for (const attr of create.attributes) if (attr.list && sent[attr.name] === undefined) sent[attr.name] = [];
  const made = await runCommand(client, titles, create, sent);
  return made.ok ? { ok: true, args: rest } : { ok: false, message: made.message, field: made.field, problems: [] };
}

/** The scheduled-action record the editor makes itself: a creating command gets an identity nobody typed. */
function withMadeIdentity(agg: Aggregate, command: Command, args: State): State {
  const spec = SCHEMA.scheduling;
  if (!spec?.generated || !command.creates || command.name !== spec.schedule || agg.name !== spec.aggregate || agg.chapter !== spec.chapter) return args;
  const identity = agg.attributes.find((attr) => attr.name === agg.identity);
  return identity ? { ...args, [identity.name]: plainValue(agg, identity, randomUUID()) } : args;
}

/**
 * A draft saved by the page's script while the person writes. It is answered in plain text, never
 * with a redirect or a notice, and it only ever runs the aggregate's draft-saving command, so the
 * live attribute is never written from here.
 */
async function autosave(client: HostClient, agg: Aggregate, command: Command, args: State, to: string | undefined): Promise<Response> {
  if (!to || agg.drafts?.save !== command.name) return plain("Only a draft can be saved this way.", 400);
  const outcome = (await unchecked(client, agg, command, args)) ?? (await runCommand(client, agg, command, args, to));
  if (outcome.ok) return plain("Saved.", 200);
  const refused = plain(outcome.message, 422);
  if ("problems" in outcome && outcome.problems?.length) refused.headers.set("x-editor-problems", encodeURIComponent(JSON.stringify(outcome.problems)));
  return refused;
}

/** Where a command that worked leads: the page the person came from, another blank form, or the instance. */
function afterwards(agg: Aggregate, command: Command, again: boolean, id: string, back: Back | null): string {
  if (back) return back.path;
  return command.creates && again ? href(...at(agg), "new", command.name) : href(...at(agg), "id", id);
}

/** The text boxes of a command's form, each with what its companion holds now for the record `id`. */
async function boxesFor(client: HostClient, agg: Aggregate, command: Command, role: string | null, id?: string): Promise<NonNullable<Parameters<typeof instanceCommandPage>[7]>> {
  const texts = textsFor(agg, command, role);
  if (texts.length === 0) return [];
  const held = id ? currentTexts(client, await client.read(), agg, id, texts) : {};
  return texts.map((text) => ({ index: text.index, label: text.label, help: text.help, attr: text.attr, target: text.target, value: held[inputName(text.index)] ?? "" }));
}

/** What the person typed in the text boxes, to put back on a form that is shown again. */
function typedTexts(form: Form): State {
  return Object.fromEntries([...form].filter(([key]) => key.startsWith("__text.")));
}

/**
 * The page after a record was kept but its text was refused: the form that edits the record, with
 * the text the person typed still in its box, said plainly: the record is saved, the text is not.
 */
async function textRefused(client: HostClient, agg: Aggregate, id: string, unsaved: Unsaved[], form: Form, scene: Scene, back: Back | null): Promise<Response> {
  const first = unsaved[0];
  const words = first.text.label.toLowerCase();
  const message = `The ${nameOf(agg)} was saved, but its ${words} was not. ${first.message}`;
  const flash: Flash = { kind: "error", message };
  const editor = editing(agg);
  const values = instanceIn(client, await client.read(), agg, id);
  if (!editor || !values) return scene.sent(href(...at(agg), "id", id), message);
  const shown: Submitted = { command: editor.name, message, values: { ...values, ...typedTexts(form) }, textField: inputName(first.text.index), textMessage: first.message };
  const boxes = await boxesFor(client, agg, editor, scene.role, id);
  return scene.show(instanceCommandPage(agg, id, editor, values, shown, await choicesFor(client, agg, editor.attributes), back, boxes), 422, flash);
}

/**
 * The editor's own, approximate preview of what a form holds: the arguments as they would be sent,
 * over the record as it is now, with the texts typed beside it. Nothing is sent to the domain.
 */
async function approximate(client: HostClient, request: Request, agg: Aggregate, id: string | null, scene: Scene): Promise<Response> {
  const form = parseForm(await request.text());
  const command = agg.commands.find((candidate) => candidate.name === form.get("__previewcmd")) ?? editing(agg);
  if (!command) return scene.show(notFound("This cannot be previewed."), 404);
  const args = commandArguments(agg, command.attributes, form, command.empty, scene.now);
  const current = id ? (instanceIn(client, await client.read(), agg, id) ?? {}) : {};
  const values: State = { ...current, ...args };
  const answer = id ? await client.read() : null;
  const held = id && answer ? currentTexts(client, answer, agg, id, textsFor(agg, command, scene.role)) : {};
  const texts = textsFor(agg, command, scene.role).map((text) => ({ label: text.label, value: form.get(inputName(text.index)) ?? held[inputName(text.index)] ?? "" }));
  return scene.show(approximatePage(agg, id, values, texts));
}

/**
 * Puts a record back as it was before one of the changes listed in its History: the change's own
 * editing command is sent the values the record held, so the domain's rules apply as to any save,
 * and the restore is itself listed.
 */
async function restore(client: HostClient, request: Request, agg: Aggregate, id: string, scene: Scene): Promise<Response> {
  const form = parseForm(await request.text());
  const entry = entryOf(form.get("__entry") ?? "");
  const back = backOf(form.get("__back")) ?? { path: href(...at(agg), "id", id), label: id };
  const found = entry && entry.id === id ? restoreCommand(entry) : null;
  if (!entry || !found || found.agg.name !== agg.name) return scene.sent(back.path, "That change cannot be put back.");
  const values = instanceIn(client, await client.read(), found.agg, id);
  if (!values) return scene.sent(back.path, "That record is not here any more.");
  if (alreadyThat(entry, found.command, values)) return scene.sent(back.path, "It already says that; nothing was changed.");
  const outcome = await runCommand(client, found.agg, found.command, restoreArguments(entry, found.command), id, { restores: entry.n });
  return scene.sent(back.path, outcome.ok ? "Put back as it was." : `It could not be put back: ${outcome.message}`);
}

async function post(client: HostClient, request: Request, agg: Aggregate, verb: string, rest: string[], scene: Scene): Promise<Response> {
  const onInstance = verb === "id" && rest.length === 2;
  const command = onInstance ? commandFor(agg, "id", rest[1]) : rest.length === 1 ? commandFor(agg, verb, rest[0]) : null;
  if (!command) return scene.show(notFound("No such command."), 404);
  const form = parseForm(await request.text());
  const args = withMadeIdentity(agg, command, commandArguments(agg, command.attributes, form, command.empty, scene.now));
  const to = onInstance ? rest[0] : command.creates ? undefined : (form.get("__to") ?? "");
  if (request.headers.get("x-editor-autosave") === "1") return autosave(client, agg, command, args, to);
  const missing = unfilled(command.attributes, args);
  const started = to === "" || missing || !command.starts ? { ok: true as const, args } : await startPage(client, agg, command, args);
  const outcome = to === "" ? { ok: false as const, message: "Name the instance to act on." } : (missing ? { ok: false as const, ...missing } : started.ok ? ((await beforeSending(client, agg, command, started.args)) ?? (await runCommand(client, agg, command, started.args, to))) : started);
  const back = backOf(form.get("__back"));
  if (outcome.ok) {
    const unsaved = await saveTexts(client, agg, outcome.id, textsFor(agg, command, scene.role), form, scene.now);
    if (unsaved.length > 0) return textRefused(client, agg, outcome.id, unsaved, form, scene, back);
    return scene.sent(afterwards(agg, command, form.get("__again") === "1", outcome.id, back), done(agg, command));
  }
  const shown: Submitted = { command: command.name, message: outcome.message, values: { ...args, ...typedTexts(form), __to: to }, field: outcome.field, problems: "problems" in outcome ? outcome.problems : undefined };
  if (onInstance) return refusedOnInstance(client, agg, rest[0], command, shown, scene, back);
  const choices = await choicesFor(client, agg, command.attributes);
  const texts = await boxesFor(client, agg, command, scene.role);
  return scene.show(commandPage(agg, command, href(...at(agg), verb, command.name), shown, choices, { back, texts }), 422, refused(agg, command));
}

/** The refusal of a command run on one instance: shown on its form, or on the page it was run from. */
async function refusedOnInstance(client: HostClient, agg: Aggregate, id: string, command: Command, shown: Submitted, scene: Scene, back: Back | null): Promise<Response> {
  if (!needsPage(command)) return detail(client, agg, id, shown, scene, 422);
  const answer = await client.read();
  const values = instanceIn(client, answer, agg, id);
  if (!values) return scene.show(notFound(`No ${agg.name} ${id}.`), 404);
  const texts = await boxesFor(client, agg, command, scene.role, id);
  const named = titleFor(agg, id, (other, key) => instanceIn(client, answer, other, key));
  return scene.show(instanceCommandPage(agg, id, command, values, shown, await choicesFor(client, agg, command.attributes), back, texts, named), 422, refused(agg, command));
}
