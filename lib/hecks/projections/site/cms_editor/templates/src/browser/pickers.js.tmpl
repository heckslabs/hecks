__BANNER__

// What a script does with pickers (see ui/pickers.ts). A text box that suggests keys is checked as it
// is typed, so the form cannot be sent with a key that is not on offer. A `<kind>:<key>` value is
// built from a kind and a record, two controls that write the one input the form posts. The server
// checks every key again, whatever the script did.

/** How many choices a native select holds before a text box with suggestions takes over (as in the page). */
const SELECT_MAX = 30;

/** The keys a text box's list offers. */
const offered = (input) => [...(document.getElementById(input.getAttribute("list"))?.options ?? [])].map((option) => option.value);

/** Whether `input` names something on offer, or nothing, or what it named when the page was made. */
function valid(input) {
  if (input.dataset.open !== undefined || input.value === "" || input.value === input.dataset.initial) return true;
  return offered(input).includes(input.value);
}

/** Marks a strict box invalid, with the words the browser shows, until it names something on offer. */
function check(input) {
  input.setCustomValidity(valid(input) ? "" : `Nothing is called "${input.value}". Choose one of the suggestions.`);
}

const words = (option) => (option.label && option.label !== option.key ? `${option.label} (${option.key})` : option.key);

let counter = 0;

/** A text box for a record, with its list of suggestions when there are some. */
function suggesting(options, strict, value) {
  const input = document.createElement("input");
  input.type = "text";
  input.className = "input w-full";
  input.setAttribute("aria-label", "Record");
  input.autocomplete = "off";
  input.value = value;
  const holder = document.createElement("span");
  holder.className = "flex min-w-0 flex-1";
  holder.append(input);
  if (options.length > 0) {
    const list = document.createElement("datalist");
    list.id = `kind-choices-${(counter += 1)}`;
    for (const option of options) list.append(Object.assign(document.createElement("option"), { value: option.key, label: words(option) }));
    input.setAttribute("list", list.id);
    holder.append(list);
  }
  if (strict && options.length > 0) {
    input.dataset.strict = "";
    input.dataset.initial = value;
    check(input);
  }
  return holder;
}

/** A native select of a kind's records. */
function choosing(options, value) {
  const select = document.createElement("select");
  select.className = "select min-w-0 flex-1";
  select.setAttribute("aria-label", "Record");
  select.append(new Option("Choose...", ""));
  for (const option of options) select.append(new Option(words(option), option.key, false, option.key === value));
  if (value !== "" && !options.some((option) => option.key === value)) select.append(new Option(`${value} (not on offer)`, value, false, true));
  return select;
}

/** The record's control for a kind: a select for a few records, a box that suggests for more, a plain box for none. */
function control(kind, value) {
  const options = kind?.options ?? [];
  return kind?.strict && options.length > 0 && options.length <= SELECT_MAX ? choosing(options, value) : suggesting(options, Boolean(kind?.strict), value);
}

const fieldOf = (element) => (element.matches("input, select") ? element : element.querySelector("input"));

/** The `<kind>:<key>` the pair of controls stand for, or empty when either is. */
function sync(box) {
  const kind = box.querySelector("[data-kind]");
  const record = fieldOf(box.querySelector("[data-record]"));
  box.querySelector("input[type=hidden]").value = kind.value !== "" && record.value !== "" ? `${kind.value}:${record.value}` : "";
}

/** Puts a record control for the chosen kind in place of the one there. */
function place(box, value) {
  box.querySelector("[data-record]")?.remove();
  const kinds = JSON.parse(box.dataset.kinds);
  const element = control(kinds.find((kind) => kind.kind === box.querySelector("[data-kind]").value), value);
  element.dataset.record = "";
  box.querySelector("[data-pair]").append(element);
}

/** Builds the kind and record controls of one `<kind>:<key>` input. */
function mount(box) {
  if (box.dataset.mounted) return;
  const kinds = JSON.parse(box.dataset.kinds);
  const input = box.querySelector("input");
  const [first, ...rest] = input.value.split(":");
  const known = kinds.some((kind) => kind.kind === first);
  const kind = document.createElement("select");
  kind.className = "select";
  kind.id = input.id;
  kind.dataset.kind = "";
  kind.setAttribute("aria-label", "Kind");
  kind.append(new Option("Kind...", ""));
  for (const each of kinds) kind.append(new Option(each.kind, each.kind, false, known && each.kind === first));
  const pair = document.createElement("div");
  pair.className = "flex flex-wrap gap-2";
  pair.dataset.pair = "";
  pair.append(kind);
  input.type = "hidden";
  input.removeAttribute("id");
  box.append(pair);
  box.dataset.mounted = "true";
  place(box, known ? rest.join(":") : "");
  sync(box);
}

/** Mounts every `<kind>:<key>` input under `root` that has not been; a copied row is first undone so it can be. */
export function mountPickers(root = document) {
  for (const box of root.querySelectorAll("[data-key-picker]")) mount(box);
}

/** Undoes a copied `<kind>:<key>` row's controls, so the row can be mounted as a new one. */
export function unmountPickers(root) {
  for (const box of root.querySelectorAll("[data-key-picker][data-mounted]")) {
    const hidden = box.querySelector("input[type=hidden]");
    const id = box.querySelector("select[data-kind]")?.id;
    box.querySelector("[data-pair]")?.remove();
    hidden.type = "text";
    hidden.value = "";
    if (id) hidden.id = id;
    delete box.dataset.mounted;
  }
}

export function enhancePickers() {
  for (const input of document.querySelectorAll("input[data-strict]")) {
    input.dataset.initial = input.value;
    check(input);
  }
  document.addEventListener("input", (event) => {
    const target = event.target;
    if (target.matches?.("input[data-strict]")) check(target);
    const box = target.closest?.("[data-key-picker]");
    if (box && !target.matches("[data-kind]")) sync(box);
  });
  document.addEventListener("change", (event) => {
    const box = event.target.closest?.("[data-key-picker]");
    if (!box) return;
    if (event.target.matches("[data-kind]")) place(box, "");
    sync(box);
  });
  mountPickers();
}
