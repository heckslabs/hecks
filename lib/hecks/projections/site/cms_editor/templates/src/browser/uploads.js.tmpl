__BANNER__

// The upload controls of a picture or file field. The field is a text box that holds the address the
// site shows the picture or file from; this adds, beside it, a way to choose a file from the
// computer, say what it is (the content system requires a description for both), send it to be kept,
// and see it. The address in the box is replaced by the one the content system gives back, which is
// exactly what the site reads; nothing else about the page changes. A picture is shown as a
// thumbnail, with what it is described as, and may be replaced or (when the field is optional)
// removed. The file is checked here for its kind and size before it is sent, and again by the
// server, which decides by the file's own bytes.
const make = (tag, props = {}, ...children) => {
  const element = Object.assign(document.createElement(tag), props);
  element.append(...children);
  return element;
};

const TYPES = {
  image: { match: /^image\/(jpeg|png|webp|gif|avif)$/, words: "a JPEG, PNG, WebP, GIF or AVIF picture", accept: "image/jpeg,image/png,image/webp,image/gif,image/avif", noun: "picture" },
  pdf: { match: /^application\/pdf$/, words: "a PDF file", accept: "application/pdf", noun: "file" },
};

const megabytes = (bytes) => `${Math.max(1, Math.round(bytes / 1048576))} MB`;

/** The name of the file at an address: its last path segment, undone from address spelling. */
function nameAt(address) {
  const last = address.split("?")[0].split("/").filter(Boolean).pop() ?? "";
  try { return decodeURIComponent(last); } catch (error) { return last; }
}

/** Sends the file with its description; resolves with the answer or rejects with the words to show. */
function send(url, file, alt, progress) {
  return new Promise((resolve, reject) => {
    const request = new XMLHttpRequest();
    request.open("POST", url);
    request.setRequestHeader("Accept", "application/json");
    request.upload.addEventListener("progress", (event) => event.lengthComputable && progress(event.loaded / event.total));
    request.addEventListener("load", () => {
      let answer = {};
      try { answer = JSON.parse(request.responseText); } catch (error) { /* not JSON */ }
      if (request.status >= 200 && request.status < 300) resolve(answer);
      else if (request.status === 413) reject(new Error("That file is too large."));
      else if (request.status === 403 && !answer.error) reject(new Error("You are signed out. Sign in again, then try once more."));
      else reject(new Error(answer.error ?? "The upload did not work. Try again."));
    });
    request.addEventListener("error", () => reject(new Error("The upload could not be sent. Check the connection and try again.")));
    const form = new FormData();
    form.append("alt", alt);
    form.append("file", file);
    request.send(form);
  });
}

function mount(root) {
  if (root.dataset.mounted) return;
  root.dataset.mounted = "true";
  const kind = TYPES[root.dataset.accept] ?? TYPES.image;
  const limit = Number(root.dataset.limit || 0);
  const optional = root.dataset.optional === "true";
  const address = root.querySelector("[data-upload-address]");
  const id = address.id;

  const thumb = make("img", { alt: "", width: 96, height: 96, className: "size-24 shrink-0 border border-base-300 bg-base-200 object-cover", hidden: true });
  const current = make("p", { className: "min-w-0 break-words text-sm", id: `${id}-current` });
  const file = make("input", { type: "file", accept: kind.accept, className: "file-input file-input-sm w-full max-w-sm", id: `${id}-file` });
  file.setAttribute("aria-label", `Choose ${kind.words}`);
  const altBox = make("input", { type: "text", className: "input input-sm w-full max-w-md", id: `${id}-alt`, maxLength: 300 });
  const altLabel = make("label", { className: "grid gap-1 text-sm font-semibold", hidden: true }, kind.noun === "picture" ? "Describe the picture for people who cannot see it (required)" : "What is this file? (required)", altBox);
  altBox.setAttribute("aria-required", "true");
  const progress = make("progress", { className: "progress progress-primary w-full max-w-sm", max: 1, value: 0, hidden: true });
  const status = make("p", { className: "text-sm", role: "status" });
  status.setAttribute("aria-live", "polite");
  const sendButton = make("button", { type: "button", className: "btn btn-sm btn-neutral w-fit", hidden: true }, `Upload this ${kind.noun}`);
  const clear = make("button", { type: "button", className: "btn btn-sm btn-ghost w-fit", hidden: true }, `Remove the ${kind.noun}`);
  const cancel = make("button", { type: "button", className: "btn btn-sm btn-ghost w-fit", hidden: true }, "Cancel");
  const pick = make("div", { className: "grid gap-2" }, make("label", { className: "text-sm font-semibold", htmlFor: file.id }, "Choose a file from this computer"), file);
  const body = make("div", { className: "grid min-w-0 flex-1 gap-2" }, current, pick, altLabel, progress, make("div", { className: "flex flex-wrap gap-2" }, sendButton, cancel, clear), status);
  const row = make("div", { className: "flex flex-wrap items-start gap-3 border border-base-300 bg-base-100 p-3" }, thumb, body);
  address.closest("div[data-upload]").insertBefore(row, address.nextSibling);

  let staged = null;
  let objectUrl = null;
  const say = (text, tone = "") => {
    status.textContent = text;
    status.className = `text-sm ${tone === "error" ? "font-semibold text-error" : tone === "ok" ? "font-semibold text-success" : "text-muted"}`;
  };
  const forget = () => {
    if (objectUrl) URL.revokeObjectURL(objectUrl);
    objectUrl = null;
    staged = null;
    file.value = "";
    altBox.value = "";
    altBox.removeAttribute("aria-invalid");
    altLabel.hidden = true;
    sendButton.hidden = true;
    cancel.hidden = true;
    progress.hidden = true;
  };
  const showHeld = () => {
    const held = address.value.trim();
    if (held === "") {
      current.textContent = `No ${kind.noun} chosen yet.`;
      thumb.hidden = true;
      clear.hidden = true;
      return;
    }
    thumb.hidden = kind.noun !== "picture";
    if (!thumb.hidden) thumb.src = held;
    current.textContent = kind.noun === "picture" ? `Now: ${nameAt(held)}` : `Now: ${nameAt(held)}`;
    clear.hidden = !optional;
  };

  file.addEventListener("change", () => {
    const chosen = file.files[0];
    forget();
    say("");
    if (!chosen) return;
    if (!kind.match.test(chosen.type)) {
      say(`${chosen.name} is not ${kind.words}.`, "error");
      file.value = "";
      return;
    }
    if (limit > 0 && chosen.size > limit) {
      say(`${chosen.name} is larger than ${megabytes(limit)}. Choose a smaller one.`, "error");
      file.value = "";
      return;
    }
    staged = chosen;
    if (kind.noun === "picture") {
      objectUrl = URL.createObjectURL(chosen);
      thumb.src = objectUrl;
      thumb.hidden = false;
    }
    current.textContent = `Chosen: ${chosen.name}. It is not on the site until it is uploaded and the form is saved.`;
    altLabel.hidden = false;
    sendButton.hidden = false;
    cancel.hidden = false;
    altBox.focus();
  });

  const upload = async () => {
    if (!staged) return;
    const words = altBox.value.trim();
    if (words === "") {
      altBox.setAttribute("aria-invalid", "true");
      say(kind.noun === "picture" ? "Describe the picture before uploading it." : "Say what this file is before uploading it.", "error");
      altBox.focus();
      return;
    }
    altBox.removeAttribute("aria-invalid");
    say("");
    progress.value = 0;
    progress.hidden = false;
    sendButton.disabled = true;
    try {
      const made = await send(root.dataset.endpoint, staged, words, (fraction) => { progress.value = fraction; });
      address.value = made.address;
      address.dispatchEvent(new Event("input", { bubbles: true }));
      forget();
      showHeld();
      say(`Uploaded. Save the form to put it on the site.`, "ok");
    } catch (error) {
      progress.hidden = true;
      say(error.message, "error");
    } finally {
      sendButton.disabled = false;
    }
  };

  sendButton.addEventListener("click", upload);
  cancel.addEventListener("click", () => {
    forget();
    showHeld();
    say("");
  });
  clear.addEventListener("click", () => {
    address.value = "";
    address.dispatchEvent(new Event("input", { bubbles: true }));
    showHeld();
    say(`The ${kind.noun} is taken off. Save the form to take it off the site.`, "ok");
  });
  altBox.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      event.preventDefault();
      upload();
    }
  });
  address.addEventListener("change", showHeld);
  showHeld();
}

/** Makes every upload field on the page live. */
export function mountAll(scope = document) {
  for (const root of scope.querySelectorAll("[data-upload]")) mount(root);
}
