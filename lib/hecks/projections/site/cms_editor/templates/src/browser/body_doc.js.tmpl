__BANNER__

// The domain's document body and the rich-text editor's document, converted one into the other. This
// is the only place the two meet: the editor (body_editor.js) holds a Tiptap document while a person
// writes, and every change is turned back into the body the domain takes and posted as the same
// dotted-path form fields as any other value object. The editor's own format is never sent or stored.
//
// Plain JavaScript with no dependencies and no DOM, so the conversion runs the same in node (where
// the specs hold it) and in the browser. The two models agree on lists because the editor's lists are
// flat: each item is a block of its own with an `indent`, as a body's list item has a `depth`, so an
// item converts to an item. A body list block becomes a run of items, and a run of adjacent items
// with the same alignment and shift becomes one list block again (its kind is that of its first
// item, and an item of the other kind carries `list_kind`). Where the editor's document holds
// something the body cannot, it is reduced to the nearest thing the body holds.
import { ALIGNS, MARKS, MAX_DEPTH, MAX_INDENT, safeHref } from "../ui/body_model.js";

/** The editor's list item node for each kind of body list, and back. */
const ITEMS = { bullet_list: "flatListItemUnordered", numbered_list: "flatListItemOrdered" };
const KINDS = { flatListItemUnordered: "bullet_list", flatListItemOrdered: "numbered_list" };

const whole = (value, low, high) => (Number.isInteger(Number(value)) && value !== "" && value !== null && value !== undefined ? Math.min(high, Math.max(low, Number(value))) : null);

const list = (value) => (Array.isArray(value) ? value : []);

const markName = (mark) => (typeof mark === "string" ? mark : mark?.name);

/** The layout attributes of a block, as the editor's nodes carry them (`shift` is the block's indent). */
function layoutAttrs(block) {
  return { align: ALIGNS.includes(block.align) ? block.align : null, shift: whole(block.indent, 0, MAX_INDENT) };
}

/** The inline nodes of `spans`: text carrying its marks and address, and a hard break for a line break. */
export function spansToInline(spans) {
  const out = [];
  for (const span of list(spans)) {
    const names = MARKS.filter((name) => list(span?.marks).map(markName).includes(name));
    const href = safeHref(span?.href);
    const marks = [...names.map((type) => ({ type })), ...(href ? [{ type: "link", attrs: { href } }] : [])];
    String(span?.text ?? "").split("\n").forEach((part, at) => {
      if (at > 0) out.push({ type: "hardBreak" });
      if (part !== "") out.push({ type: "text", text: part, ...(marks.length ? { marks } : {}) });
    });
  }
  return out;
}

const paragraph = (spans, attrs = {}) => ({ type: "paragraph", attrs, content: spansToInline(spans) });

/** The items of a body list block as flat items, numbering ordered ones as the editor does. */
function itemsToNodes(block) {
  const kind = block.kind;
  const layout = layoutAttrs(block);
  const counts = [];
  let above = -1;
  return list(block.items).map((item) => {
    const depth = Math.min(whole(item?.depth, 0, MAX_DEPTH) ?? 0, above + 1);
    above = depth;
    counts.length = depth + 1;
    const own = item?.list_kind in ITEMS ? item.list_kind : kind;
    counts[depth] = own === "numbered_list" ? (counts[depth] ?? 0) + 1 : 0;
    const attrs = { ...layout, ...(depth > 0 ? { indent: depth } : {}), ...(own === "numbered_list" ? { counter: counts[depth] } : {}) };
    return { type: ITEMS[own], attrs, content: spansToInline(item?.spans) };
  });
}

function blockToNodes(block) {
  const kind = block?.kind;
  if (kind === "divider") return [{ type: "horizontalRule" }];
  if (kind === "image") return [{ type: "image", attrs: { mediaRef: block.media_ref ?? "", alt: block.alt ?? "", caption: block.caption ?? "" } }];
  if (kind in ITEMS) return itemsToNodes(block);
  const layout = layoutAttrs(block ?? {});
  if (kind === "quote") return [{ type: "blockquote", attrs: layout, content: [paragraph(block.spans)] }];
  if (kind === "heading") return [{ type: "heading", attrs: { level: whole(block.level, 1, 4) ?? 2, ...layout }, content: spansToInline(block.spans) }];
  return [paragraph(block?.spans, layout)];
}

/** The editor's document for a body: a body with no blocks is one empty paragraph, as the editor needs. */
export function bodyToDoc(body) {
  const content = list(body?.blocks).flatMap(blockToNodes);
  return { type: "doc", content: content.length ? content : [{ type: "paragraph", attrs: {} }] };
}

/** The mark names of an inline node, in the body's own order, and its address. */
function marksOf(node) {
  const held = list(node.marks);
  const names = MARKS.filter((name) => held.some((mark) => mark.type === name));
  const link = held.find((mark) => mark.type === "link");
  return { marks: names.map((name) => ({ name })), href: safeHref(link?.attrs?.href) ?? undefined };
}

/** The spans of inline nodes: adjacent spans of the same marks and address become one, empty ones go. */
export function inlineToSpans(nodes) {
  const out = [];
  for (const node of list(nodes)) {
    const span = node.type === "hardBreak" ? { text: "\n", marks: [] } : node.type === "text" ? { text: node.text ?? "", ...marksOf(node) } : null;
    if (!span || span.text === "") continue;
    const last = out[out.length - 1];
    const same = last && last.text !== "\n" && span.text !== "\n" && last.href === span.href && JSON.stringify(last.marks) === JSON.stringify(span.marks);
    if (same) last.text += span.text;
    else out.push({ text: span.text, marks: span.marks, ...(span.href ? { href: span.href } : {}) });
  }
  return out;
}

const withLayout = (node) => {
  const attrs = node.attrs ?? {};
  const shift = whole(attrs.shift, 0, MAX_INDENT);
  return { ...(ALIGNS.includes(attrs.align) ? { align: attrs.align } : {}), ...(shift !== null && shift > 0 ? { indent: shift } : {}) };
};

const layoutKey = (node) => JSON.stringify(withLayout(node));

/** Groups the run of flat items that starts `nodes[from]` into one list block; returns it and where it ends. */
function listBlock(nodes, from) {
  const first = nodes[from];
  const kind = KINDS[first.type];
  const items = [];
  let at = from;
  while (at < nodes.length && nodes[at].type in KINDS && layoutKey(nodes[at]) === layoutKey(first)) {
    const node = nodes[at];
    const above = items.length === 0 ? -1 : items[items.length - 1].depth;
    const depth = Math.min(whole(node.attrs?.indent, 0, MAX_DEPTH) ?? 0, above + 1);
    items.push({ spans: inlineToSpans(node.content), depth, ...(KINDS[node.type] !== kind ? { list_kind: KINDS[node.type] } : {}) });
    at += 1;
  }
  return [{ kind, ...withLayout(first), items }, at];
}

function blockFromNode(node) {
  switch (node.type) {
    case "horizontalRule":
      return [{ kind: "divider" }];
    case "image":
      return [{ kind: "image", ...(node.attrs?.mediaRef ? { media_ref: node.attrs.mediaRef } : {}), ...(node.attrs?.alt ? { alt: node.attrs.alt } : {}), ...(node.attrs?.caption ? { caption: node.attrs.caption } : {}) }];
    case "heading":
      return [{ kind: "heading", level: whole(node.attrs?.level, 1, 4) ?? 2, ...withLayout(node), spans: inlineToSpans(node.content) }];
    case "blockquote":
      return list(node.content).filter((child) => child.type === "paragraph").map((child) => ({ kind: "quote", ...withLayout(node), spans: inlineToSpans(child.content) }));
    default:
      return [{ kind: "paragraph", ...withLayout(node), spans: inlineToSpans(node.content) }];
  }
}

const emptyParagraph = (block) => block.kind === "paragraph" && block.spans.length === 0 && !("align" in block) && !("indent" in block);

/** The body for an editor document. Trailing empty paragraphs, which the editor keeps for typing, are not blocks. */
export function docToBody(doc) {
  const nodes = list(doc?.content);
  const blocks = [];
  for (let at = 0; at < nodes.length;) {
    if (nodes[at].type in KINDS) {
      const [made, next] = listBlock(nodes, at);
      blocks.push(made);
      at = next;
    } else {
      blocks.push(...blockFromNode(nodes[at]));
      at += 1;
    }
  }
  while (blocks.length > 0 && emptyParagraph(blocks[blocks.length - 1])) blocks.pop();
  return { blocks };
}

/**
 * What loading a body into the editor changes, so the editor can say so: a list item more than one
 * level below the one above it is moved up, because the editor's lists cannot skip a level.
 */
export function reductions(body) {
  const notes = [];
  for (const block of list(body?.blocks)) {
    const depths = list(block.items).map((item) => whole(item?.depth, 0, MAX_DEPTH) ?? 0);
    if (depths.some((depth, at) => depth > (at === 0 ? 0 : depths[at - 1] + 1))) notes.push("a list item more than one level below the one above it was moved up to one level below");
  }
  return notes;
}
