__BANNER__

// What a script does with moments (see ui/moments.ts and browser/epoch.js). A moment shown read-only
// is restated in the viewer's own zone, with how far away it is. A moment in a form is a native date
// or date-and-time input in that zone; the seconds the domain holds stay in the plain input the form
// posts, which is hidden, and are rewritten only when the person changes the date, so a moment that
// is not edited is sent back exactly as it came.
import { formatMoment, fromLocal, relative, toLocal, zoneLabel } from "./epoch.js";

/** Restates every `time` the page carries in the viewer's zone, followed by how far from now it is. */
function restate() {
  const now = Math.floor(Date.now() / 1000);
  for (const element of document.querySelectorAll("time[data-moment]")) {
    const seconds = Number(element.dataset.epoch);
    const mode = element.dataset.moment;
    element.textContent = formatMoment(seconds, mode);
    element.title = zoneLabel(seconds);
    const ago = document.createElement("span");
    ago.className = "ml-1 text-muted";
    ago.textContent = `(${relative(seconds, now, mode)})`;
    element.after(ago);
  }
}

/** The note under a field: which zone the date is in. */
function note(field, seconds) {
  const text = field.querySelector("[data-epoch-note]");
  if (text) text.textContent = `Shown in your time zone, ${zoneLabel(seconds ?? Math.floor(Date.now() / 1000))}.`;
}

/** Swaps a number input of seconds for a native date input in the viewer's zone. */
function mount(field) {
  const raw = field.querySelector("[data-epoch-raw]");
  if (!raw || field.dataset.mounted) return;
  const mode = field.dataset.momentField;
  const local = document.createElement("input");
  local.type = mode === "date" ? "date" : "datetime-local";
  local.className = raw.classList.contains("input-error") ? "input input-error w-full max-w-xl" : "input w-full max-w-xl";
  local.id = raw.id;
  for (const name of ["aria-required", "aria-invalid", "aria-describedby"]) {
    if (raw.hasAttribute(name)) local.setAttribute(name, raw.getAttribute(name));
    raw.removeAttribute(name);
  }
  raw.removeAttribute("id");
  const held = raw.value === "" ? null : Number(raw.value);
  if (held !== null && Number.isFinite(held)) local.value = toLocal(held, mode);
  raw.type = "hidden";
  raw.before(local);
  field.dataset.mounted = "true";
  note(field, held);
}

/** The seconds follow the input as it is edited; a cleared or incomplete input leaves the field empty. */
function follow(event) {
  const local = event.target;
  const field = local.closest?.("[data-moment-field]");
  if (!field || local.matches("[data-epoch-raw]")) return;
  const raw = field.querySelector("[data-epoch-raw]");
  const seconds = fromLocal(local.value, field.dataset.momentField);
  raw.value = seconds === null ? "" : String(seconds);
  note(field, seconds);
}

/** Mounts the date inputs under `scope` that are not yet (a card made after the page loaded holds some). */
export function mountMoments(scope) {
  for (const field of scope.querySelectorAll("[data-moment-field]")) mount(field);
}

export function enhanceMoments() {
  restate();
  for (const field of document.querySelectorAll("[data-moment-field]")) mount(field);
  document.addEventListener("input", follow);
}
