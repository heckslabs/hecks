__BANNER__

// The picture picker the writing surface opens for an image block. Pictures are dropped or chosen,
// each with the alt text the domain requires, uploaded with a progress bar and a message of its
// own when it is refused, and then shown beside the pictures the domain already holds, as a grid of
// thumbnails (they come from the storage adapter's own addresses). A picture is chosen, given alt
// text for this place in the text and an optional caption, and handed to the editor as a media key.
// Everything the server sends is put into the page as text, never as markup.
const icon = (name) => `<svg class="icon" aria-hidden="true" focusable="false"><use href="#i-${name}"/></svg>`;

const make = (tag, props = {}, ...children) => {
  const element = Object.assign(document.createElement(tag), props);
  element.append(...children);
  return element;
};

const ALLOWED = "image/jpeg,image/png,image/webp,image/gif,image/avif";

async function getPictures(url) {
  const response = await fetch(url, { headers: { Accept: "application/json" } });
  if (!response.ok) throw new Error((await response.json().catch(() => ({}))).error ?? "The pictures could not be listed.");
  return (await response.json()).pictures;
}

/** Uploads one picture, reporting progress as a fraction; resolves with the picture or rejects with the words to show. */
function upload(url, file, alt, progress) {
  return new Promise((resolve, reject) => {
    const request = new XMLHttpRequest();
    request.open("POST", url);
    request.setRequestHeader("Accept", "application/json");
    request.upload.addEventListener("progress", (event) => event.lengthComputable && progress(event.loaded / event.total));
    request.addEventListener("load", () => {
      let answer = {};
      try { answer = JSON.parse(request.responseText); } catch (error) { /* not JSON */ }
      if (request.status >= 200 && request.status < 300) resolve(answer);
      else reject(new Error(answer.error ?? "The upload failed."));
    });
    request.addEventListener("error", () => reject(new Error("The upload could not be sent. Check the connection and try again.")));
    const form = new FormData();
    form.append("alt", alt);
    form.append("file", file);
    request.send(form);
  });
}

/** One registered picture as a button: its thumbnail and its alt text. */
function entry(picture, choose) {
  const image = make("img", { src: picture.url, alt: "", loading: "lazy", width: 88, height: 88, className: "aspect-square w-full rounded object-cover" });
  const button = make("button", { type: "button", title: picture.alt, className: "grid w-full gap-1 rounded-field border border-transparent p-1 text-left text-xs hover:bg-base-200" }, image, make("span", { className: "truncate", textContent: picture.alt || picture.key.slice(0, 12) }));
  button.dataset.key = picture.key;
  button.addEventListener("click", () => choose(picture, button));
  return make("li", {}, button);
}

/**
 * Opens the picker inside `frame`, below `bar`. `options.url` is the media endpoint,
 * `options.current` the picture being replaced (or null), `options.onPick(key, alt, caption)` is called
 * with the choice and `options.onClose()` when the picker goes away.
 */
export function openPicker(frame, bar, options) {
  frame.querySelector("[data-picker]")?.remove();
  const { url, current, onPick, onClose } = options;
  let chosen = current?.mediaRef || null;
  const staged = [];

  const grid = make("ul", { className: "grid max-h-56 grid-cols-[repeat(auto-fill,minmax(5.5rem,1fr))] gap-2 overflow-auto" });
  grid.setAttribute("aria-label", "Pictures already registered");
  const list = make("ul", { className: "grid gap-1" });
  const problem = make("div", { className: "alert alert-error alert-soft", hidden: true });
  problem.setAttribute("role", "alert");
  const files = make("input", { type: "file", accept: ALLOWED, multiple: true, className: "file-input file-input-sm w-full max-w-xs" });
  files.setAttribute("aria-label", "Choose pictures to upload");
  const zone = make("div", { className: "grid justify-items-center gap-2 rounded-field border-2 border-dashed border-edge p-5 text-center text-muted" },
    make("span", { innerHTML: icon("upload") }), make("p", { textContent: "Drop pictures here, or choose them. JPEG, PNG, WebP, GIF or AVIF." }), files);
  const upButton = make("button", { type: "button", className: "btn btn-sm", hidden: true });
  const alt = make("input", { type: "text", className: "input w-full", required: true, value: current?.alt ?? "" });
  alt.setAttribute("aria-required", "true");
  const caption = make("input", { type: "text", className: "input w-full", value: current?.caption ?? "" });
  const insert = make("button", { type: "button", className: "btn btn-neutral" }, "Insert");
  const cancel = make("button", { type: "button", className: "btn btn-ghost" }, "Cancel");
  const close = make("button", { type: "button", className: "btn btn-ghost btn-square btn-sm", innerHTML: icon("close") });
  close.setAttribute("aria-label", "Close the picker");
  const field = (text, input) => make("label", { className: "grid gap-1 font-semibold" }, text, input);
  const panel = make("div", { className: "absolute left-2 right-2 z-20 mt-1 grid max-w-2xl gap-4 rounded-box border border-base-300 bg-base-100 p-4 shadow-xl" },
    make("div", { className: "flex items-center justify-between" }, make("h3", { className: "text-lg", textContent: "Insert a picture" }), close),
    zone, list, upButton, make("p", { className: "text-sm text-muted", textContent: "Or choose a picture already registered:" }), grid,
    field("Alt text for this picture (required)", alt), field("Caption (optional)", caption), problem, make("div", { className: "flex gap-2" }, insert, cancel));
  panel.dataset.picker = "";
  panel.setAttribute("role", "dialog");
  panel.setAttribute("aria-label", "Insert a picture");
  panel.style.top = `${bar.offsetHeight}px`;

  const say = (message) => {
    problem.textContent = message ?? "";
    problem.hidden = !message;
  };
  const shut = () => { panel.remove(); onClose?.(); };

  const choose = (picture, button) => {
    chosen = picture.key;
    if (!alt.value.trim()) alt.value = picture.alt;
    for (const other of grid.querySelectorAll("button")) {
      other.removeAttribute("aria-pressed");
      other.classList.remove("ring-2", "ring-primary");
    }
    button.setAttribute("aria-pressed", "true");
    button.classList.add("ring-2", "ring-primary");
    say(null);
  };

  const stage = (file) => {
    const preview = make("img", { src: URL.createObjectURL(file), alt: "", className: "size-14 rounded object-cover" });
    const text = make("input", { type: "text", className: "input input-sm w-full", placeholder: "Alt text (required)" });
    text.setAttribute("aria-label", `Alt text for ${file.name}`);
    text.setAttribute("aria-required", "true");
    const bar = make("progress", { className: "progress progress-primary w-full", max: 1, value: 0, hidden: true });
    const result = make("p", { className: "text-xs" });
    const drop = make("button", { type: "button", className: "btn btn-ghost btn-square btn-xs", innerHTML: icon("close") });
    drop.setAttribute("aria-label", `Remove ${file.name}`);
    const row = make("li", { className: "grid grid-cols-[3.5rem_minmax(0,1fr)_auto] items-start gap-3 border-t border-base-300 py-2" },
      preview, make("div", { className: "grid gap-1" }, make("p", { className: "truncate text-xs text-muted", textContent: file.name }), text, bar, result), drop);
    const item = { file, row, text, bar, result, done: false };
    drop.addEventListener("click", () => { staged.splice(staged.indexOf(item), 1); URL.revokeObjectURL(preview.src); row.remove(); refresh(); });
    staged.push(item);
    list.append(row);
  };

  const refresh = () => {
    const pending = staged.filter((item) => !item.done);
    upButton.hidden = pending.length === 0;
    upButton.textContent = pending.length === 1 ? "Upload this picture" : `Upload ${pending.length} pictures`;
  };

  const add = (picked) => {
    for (const file of picked) {
      if (!ALLOWED.split(",").includes(file.type)) {
        say(`${file.name} is not a JPEG, PNG, WebP, GIF or AVIF picture.`);
        continue;
      }
      stage(file);
    }
    refresh();
    staged.at(-1)?.text.focus();
  };

  const send = async () => {
    say(null);
    for (const item of staged.filter((entryItem) => !entryItem.done)) {
      const words = item.text.value.trim();
      if (!words) {
        item.result.textContent = "Add alt text to upload this picture.";
        item.result.className = "text-xs font-semibold text-error";
        item.text.setAttribute("aria-invalid", "true");
        item.text.focus();
        continue;
      }
      item.text.removeAttribute("aria-invalid");
      item.bar.hidden = false;
      item.result.textContent = "";
      try {
        const made = await upload(url, item.file, words, (fraction) => { item.bar.value = fraction; });
        item.done = true;
        item.bar.value = 1;
        item.result.textContent = "Uploaded.";
        item.result.className = "text-xs font-semibold text-success";
        item.text.disabled = true;
        const picture = { key: made.key, alt: made.alt ?? words, url: made.url ?? `${url}/${encodeURIComponent(made.key)}` };
        const node = entry(picture, choose);
        grid.prepend(node);
        choose(picture, node.firstChild);
      } catch (err) {
        item.bar.hidden = true;
        item.result.textContent = err.message;
        item.result.className = "text-xs font-semibold text-error";
      }
    }
    refresh();
  };

  const submit = () => {
    say(null);
    if (!chosen) return say("Choose a picture, or upload one first.");
    if (!alt.value.trim()) return say("Add alt text: describe the picture for someone who cannot see it.");
    onPick(chosen, alt.value.trim(), caption.value.trim());
    shut();
  };

  files.addEventListener("change", () => { add([...files.files]); files.value = ""; });
  zone.addEventListener("dragover", (event) => { event.preventDefault(); zone.classList.add("border-primary", "bg-soft", "text-primary"); });
  zone.addEventListener("dragleave", () => zone.classList.remove("border-primary", "bg-soft", "text-primary"));
  zone.addEventListener("drop", (event) => {
    event.preventDefault();
    zone.classList.remove("border-primary", "bg-soft", "text-primary");
    add([...event.dataTransfer.files]);
  });
  upButton.addEventListener("click", send);
  insert.addEventListener("click", submit);
  cancel.addEventListener("click", shut);
  close.addEventListener("click", shut);
  panel.addEventListener("keydown", (event) => {
    if (event.key === "Escape") { event.preventDefault(); shut(); }
    if (event.key === "Enter" && event.target.tagName === "INPUT" && event.target.type !== "file") {
      event.preventDefault();
      if (staged.includes(staged.find((item) => item.text === event.target))) send();
      else submit();
    }
  });

  frame.append(panel);
  getPictures(url)
    .then((pictures) => {
      for (const picture of pictures) {
        const node = entry(picture, choose);
        grid.append(node);
        if (picture.key === chosen) choose(picture, node.firstChild);
      }
      if (pictures.length === 0) grid.replaceWith(make("p", { className: "text-sm text-muted", textContent: "No pictures yet." }));
    })
    .catch((err) => say(err.message));
  files.focus();
}
