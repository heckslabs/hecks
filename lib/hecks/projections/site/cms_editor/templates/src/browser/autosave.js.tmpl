__BANNER__

// A body written as a draft saves by itself. The form's command saves a draft beside the live body
// (the page says which: `data-draft`), so this posts that same form, form-encoded, to its own address
// with a header that makes the server answer in plain text instead of redirecting. It never posts to
// the live body: the server runs only the draft-saving command for such a post.
//
// A save happens after five seconds with no typing, and when the writing surface loses focus, and
// only when something changed and the form passes its own checks. The status line says what is
// happening: "Saving...", "Draft saved 14:03", or "Could not save: <reason>" with a way to try again.
// The browser asks before the page is left only while there are changes that are not saved.

const QUIET_MS = 5000;

/** The time of day, as the person's browser writes it, without seconds. */
const clock = () => new Date().toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });

/**
 * Starts saving the draft of the body `root` holds.
 *
 * @param {HTMLElement} root the element that holds the writing surface (`data-body-editor`), or a
 *   list of mixed blocks (`data-block-list`)
 * @param {{ form?: HTMLFormElement, blocked?: () => string | null, refused?: (problems: object[]) => void }} [options]
 *   `form` when it is not the root's own; `blocked` says why the form is not ready to save (null when
 *   it is); `refused` is given the blocks a refused save named
 * @returns {{ touch(): void, blur(): void }} what the writing surface calls when the text changes
 *   and when it loses focus
 */
export function startDraft(root, options = {}) {
  const form = options.form ?? root.closest("form");
  const status = document.querySelector("[data-draft-status]");
  const discard = document.querySelector("[data-draft-discard]");
  let dirty = false;
  let version = 0;
  let timer = null;
  let current = null;
  let leaving = false;

  const say = (text, retry = false) => {
    if (!status) return;
    status.replaceChildren(text);
    if (!retry) return;
    const button = Object.assign(document.createElement("button"), { type: "button", className: "link ml-2", textContent: "Try again" });
    button.addEventListener("click", () => save());
    status.append(button);
  };

  /** Whether the form may be sent: its own checks pass and the body has something in it. */
  const passes = () => form.checkValidity() && !root.editor?.isEmpty;

  const send = async () => {
    const sent = version;
    say("Saving...");
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new URLSearchParams(new FormData(form)),
        headers: { "X-Editor-Autosave": "1" },
        credentials: "same-origin",
        redirect: "manual",
      });
      if (response.type === "opaqueredirect") return fail("Sign in again to keep saving.");
      const text = (await response.text()).trim();
      if (!response.ok) {
        named(response.headers.get("x-editor-problems"));
        return fail(text || `The editor answered ${response.status}.`);
      }
      if (version === sent) dirty = false;
      say(`Draft saved ${clock()}`);
      discard?.removeAttribute("hidden");
      document.dispatchEvent(new CustomEvent("editor:saved"));
      return version === sent;
    } catch {
      return fail("the editor could not be reached.");
    }
  };

  /** Hands the blocks a refusal names to the list, which opens them. */
  const named = (header) => {
    try {
      if (header) options.refused?.(JSON.parse(decodeURIComponent(header)));
    } catch {
      /* a header that is not ours is ignored */
    }
  };

  const fail = (reason) => {
    say(`Could not save: ${reason}`, true);
    return false;
  };

  /** Saves what is unsaved, once at a time; resolves to whether everything is saved. */
  const save = () => {
    clearTimeout(timer);
    if (current) return current.then(() => save());
    if (!dirty) return Promise.resolve(true);
    const why = options.blocked?.();
    if (why) {
      say(`Not saved: ${why}`);
      return Promise.resolve(false);
    }
    if (!passes()) {
      say("Not saved: write something first, or fix what the form marks.");
      return Promise.resolve(false);
    }
    current = send().finally(() => {
      current = null;
    });
    return current;
  };

  window.addEventListener("beforeunload", (event) => {
    if (leaving || (!dirty && !current)) return;
    event.preventDefault();
    event.returnValue = "";
  });

  document.addEventListener("submit", async (event) => {
    const target = event.target;
    if (target === form) {
      leaving = true;
      return;
    }
    if (!target.matches?.("[data-flush-draft]") || (!dirty && !current)) return;
    event.preventDefault();
    if (await save()) {
      leaving = true;
      target.submit();
    }
  });

  return {
    touch() {
      dirty = true;
      version += 1;
      say("Changes not saved yet.");
      clearTimeout(timer);
      timer = setTimeout(save, QUIET_MS);
    },
    blur() {
      if (dirty) save();
    },
  };
}
