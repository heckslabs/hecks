function handler(event) {
  var request = event.request;
  var canonical = __CANONICAL__;
  var aliases = __ALIASES__;
  var watched = __WATCHED__;
  var header = request.headers.host;
  var host = header && header.value ? header.value.toLowerCase().replace(/:\d+$/, "") : "";
  var reads = request.method === "GET" || request.method === "HEAD";
  if (!reads || watched.indexOf(request.uri) < 0) { return request; }
  if (host === canonical || aliases.indexOf(host) < 0) { return request; }
  var parts = [];
  Object.keys(request.querystring).forEach(function (key) {
    var entry = request.querystring[key];
    var values = entry.multiValue ? entry.multiValue.map(function (item) { return item.value; }) : [entry.value];
    values.forEach(function (value) {
      var name = encode(key);
      parts.push(value === "" || value === undefined ? name : name + "=" + encode(value));
    });
  });
  var query = parts.length ? "?" + parts.join("&") : "";
  return {
    statusCode: 302,
    statusDescription: "Found",
    headers: {
      location: { value: "https://" + canonical + request.uri + query },
      "cache-control": { value: "no-store" }
    }
  };
}

// Percent-encodes what cannot stand in a query string and keeps what is already encoded, so the
// location header carries no space, control character, "&" or "#" whether the runtime hands over
// the raw text or the decoded one. It walks the text one UTF-16 unit at a time and pairs the
// surrogates itself (a lone one becomes U+FFFD), because CloudFront's regex engine refuses a
// pattern that names a surrogate code point and fails the whole function at compile time.
var SAFE = /[A-Za-z0-9\-._~!$'()*,;:@\/?+]/;
var HEX = /^[0-9A-Fa-f]{2}$/;
var REPLACEMENT = "%EF%BF%BD";

function encode(text) {
  var input = String(text);
  var output = "";
  var index = 0;
  while (index < input.length) {
    var unit = input.charAt(index);
    var code = input.charCodeAt(index);
    index += 1;
    if (code >= 55296 && code <= 56319) {
      var next = index < input.length ? input.charCodeAt(index) : 0;
      if (next >= 56320 && next <= 57343) {
        output += encodeURIComponent(unit + input.charAt(index));
        index += 1;
      } else {
        output += REPLACEMENT;
      }
    } else if (code >= 56320 && code <= 57343) {
      output += REPLACEMENT;
    } else if (unit === "%") {
      output += HEX.test(input.substr(index, 2)) ? unit : "%25";
    } else {
      output += SAFE.test(unit) ? unit : encodeURIComponent(unit);
    }
  }
  return output;
}
