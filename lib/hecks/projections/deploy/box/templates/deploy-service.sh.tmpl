#!/usr/bin/env bash
# GENERATED by hecks deploy project -- re-run it to refresh this file rather than hand-editing.
# Settings come from the domain's deployed_to("AwsBox") block (hosting_scripts true).
#
# Deploys ONE container's freshly built local image to @@STACK@@'s app box, under a fresh, unique ECR tag.
#
#   bash deploy-service.sh <service>
#   EXISTING_TAG=<tag> bash deploy-service.sh <service>    redeploy a tag already in ECR (no push)
#
# Why it exists: pushing a floating tag and restarting a container looks like a deploy, but nothing
# records which image the box was told to run, and a box that pulls a tag it already has keeps the old
# image. This script pushes the local image under a never-reused tag (<service>-<UTC timestamp>),
# refuses a tag that is already in ECR, and names that tag in the roll.
@@MODE_SUMMARY@@
#
# It ends with smoke-after-deploy.sh, whose own exit codes (20-23) are distinct from a failed deploy
# step's. SKIP_POST_DEPLOY_SMOKE=1 skips it.
#
# Environment:
#   LOCAL_IMAGE               local image to push, default <ecr repository>:latest
#   EXISTING_TAG              redeploy this tag from ECR instead of building and pushing
#   SETTLE_TIMEOUT_SECS       default 1200, how long to wait for a stack update
#   SKIP_POST_DEPLOY_SMOKE=1  passed through to smoke-after-deploy.sh
set -euo pipefail

@@SETTINGS@@

@@SERVICES@@

SERVICE_NAME="${1:?usage: deploy-service.sh <service> (one of: ${SERVICES})}"
resolve_service "$SERVICE_NAME"

cd "$(dirname "${BASH_SOURCE[0]}")"
SETTLE_TIMEOUT_SECS="${SETTLE_TIMEOUT_SECS:-1200}"
ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"
ECR_HOST="${ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com"
SCRATCH_DIR="$(mktemp -d)"
trap 'rm -rf "$SCRATCH_DIR"' EXIT

# True once $1 (a value of $SECONDS) is further in the past than the settle timeout.
timed_out() { [ $((SECONDS - $1)) -gt "$SETTLE_TIMEOUT_SECS" ]; }

@@REPOSITORY_STEP@@
TAG="${EXISTING_TAG:-${SERVICE_NAME}-$(date -u +%Y%m%d%H%M%S)}"
IMAGE_URI="${ECR_HOST}/${ECR_REPOSITORY}:${TAG}"
LOCAL_IMAGE="${LOCAL_IMAGE:-${ECR_REPOSITORY}:latest}"

if [ -n "${EXISTING_TAG:-}" ]; then
  echo "==> reusing ${IMAGE_URI} (no push)"
  aws ecr describe-images --repository-name "$ECR_REPOSITORY" --region "$REGION" \
    --image-ids "imageTag=${TAG}" --query 'imageDetails[0].imageTags' --output text > /dev/null \
    || { echo "tag ${TAG} is not in ECR" >&2; exit 1; }
else
  if aws ecr describe-images --repository-name "$ECR_REPOSITORY" --region "$REGION" \
      --image-ids "imageTag=${TAG}" > /dev/null 2>&1; then
    echo "tag ${TAG} is already in ECR; a tag is never reused. Run again." >&2
    exit 1
  fi
  echo "==> tagging ${LOCAL_IMAGE} as ${IMAGE_URI}"
  docker tag "$LOCAL_IMAGE" "$IMAGE_URI"

  # A private docker config with no credential helper: a helper that blocks on a keychain prompt
  # hangs forever in any unattended shell.
  echo "==> ecr login"
  DOCKER_CONFIG_DIR="${SCRATCH_DIR}/docker-config"
  mkdir -p "$DOCKER_CONFIG_DIR"
  echo '{}' > "${DOCKER_CONFIG_DIR}/config.json"
  aws ecr get-login-password --region "$REGION" \
    | docker --config "$DOCKER_CONFIG_DIR" login --username AWS --password-stdin "$ECR_HOST"

  echo "==> pushing ${IMAGE_URI}"
  docker --config "$DOCKER_CONFIG_DIR" push "$IMAGE_URI"
fi

@@ROLL_STEPS@@

# The deploy itself is done. End with the smoke, which reports separately.
echo "==> deploy succeeded"
bash ./smoke-after-deploy.sh
