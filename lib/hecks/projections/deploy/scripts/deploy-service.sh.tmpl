#!/usr/bin/env bash
# GENERATED by bin/project_deploy -- re-run it to refresh this file rather
# than hand-editing. Settings come from the domain's deployed_to("AwsFargate")
# block; see Hecks::Projections::Deploy::Scripts for each key.
#
# Deploys ONE container's freshly built local image to the live ECS service,
# under a fresh, unique ECR tag.
#
#   bash deploy-service.sh <service>
#
# Why it exists: `docker push` of a floating tag plus
# `aws ecs update-service --force-new-deployment` looks like a deploy, but the
# task definition still names the old tag, so the new image never runs. This
# script reads the CURRENTLY ACTIVE task definition (the real source of truth,
# not the template's parameters), pushes the local image under a never-reused
# tag (<service>-<UTC timestamp>), swaps only that one container's image, and
# registers and deploys the result. Every other container keeps its image.
#
# It then syncs the CloudFormation stack's matching *ImageTag parameter, with
# --use-previous-template and UsePreviousValue for every other parameter, and
# checks that only that one parameter changed. The template stays the source of
# truth for what is live instead of drifting from it.
#
# Environment:
#   LOCAL_IMAGE               local image to push, default <ecr repository>:latest
#   SETTLE_TIMEOUT_SECS       default 1200, how long to wait for a rollout or stack update
#   SKIP_POST_DEPLOY_SMOKE=1  passed through to smoke-after-deploy.sh
set -euo pipefail

#@@SETTINGS@@

#@@SERVICES@@

SERVICE_NAME="${1:?usage: deploy-service.sh <service> (one of: ${SERVICES})}"
resolve_service "$SERVICE_NAME"

SETTLE_TIMEOUT_SECS="${SETTLE_TIMEOUT_SECS:-1200}"
LOCAL_IMAGE="${LOCAL_IMAGE:-${ECR_REPOSITORY}:latest}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text)"
ECR_HOST="${ACCOUNT_ID}.dkr.ecr.${REGION}.amazonaws.com"
TAG="${SERVICE_NAME}-$(date -u +%Y%m%d%H%M%S)"
IMAGE_URI="${ECR_HOST}/${ECR_REPOSITORY}:${TAG}"
SCRATCH_DIR="$(mktemp -d)"
trap 'rm -rf "$SCRATCH_DIR"' EXIT

# Seconds elapsed since $1 (a value of $SECONDS) exceeds the settle timeout.
timed_out() { [ $((SECONDS - $1)) -gt "$SETTLE_TIMEOUT_SECS" ]; }

echo "==> tagging ${LOCAL_IMAGE} as ${IMAGE_URI}"
docker tag "$LOCAL_IMAGE" "$IMAGE_URI"

# A private docker config with no credential helper: a helper that blocks on a
# keychain prompt hangs forever in any unattended shell.
echo "==> ecr login"
DOCKER_CONFIG_DIR="${SCRATCH_DIR}/docker-config"
mkdir -p "$DOCKER_CONFIG_DIR"
echo '{}' > "${DOCKER_CONFIG_DIR}/config.json"
aws ecr get-login-password --region "$REGION" \
  | docker --config "$DOCKER_CONFIG_DIR" login --username AWS --password-stdin "$ECR_HOST"

echo "==> pushing ${IMAGE_URI}"
docker --config "$DOCKER_CONFIG_DIR" push "$IMAGE_URI"

echo "==> reading the ACTIVE task definition (the real source of truth)"
CURRENT_TASKDEF="$(aws ecs describe-services --cluster "$CLUSTER" --services "$ECS_SERVICE" \
  --region "$REGION" --query 'services[0].taskDefinition' --output text)"
aws ecs describe-task-definition --task-definition "$CURRENT_TASKDEF" --region "$REGION" \
  --query 'taskDefinition' --output json > "${SCRATCH_DIR}/current.json"

SERVICE_NAME="$SERVICE_NAME" IMAGE_URI="$IMAGE_URI" python3 - "${SCRATCH_DIR}/current.json" "${SCRATCH_DIR}/new.json" <<'PYEOF'
import json, os, sys

service_name = os.environ["SERVICE_NAME"]
image_uri = os.environ["IMAGE_URI"]
with open(sys.argv[1]) as f:
    td = json.load(f)
found = False
for c in td["containerDefinitions"]:
    if c["name"] == service_name:
        c["image"] = image_uri
        found = True
if not found:
    raise SystemExit("no container named %r in the active task definition" % service_name)
for key in ["taskDefinitionArn", "revision", "status", "requiresAttributes",
            "compatibilities", "registeredAt", "registeredBy"]:
    td.pop(key, None)
with open(sys.argv[2], "w") as f:
    json.dump(td, f)
PYEOF

echo "==> registering a new task definition revision (only the ${SERVICE_NAME} image changes)"
NEW_TASKDEF_ARN="$(aws ecs register-task-definition --region "$REGION" \
  --cli-input-json "file://${SCRATCH_DIR}/new.json" \
  --query 'taskDefinition.taskDefinitionArn' --output text)"
echo "    -> ${NEW_TASKDEF_ARN}"

echo "==> updating the service"
aws ecs update-service --cluster "$CLUSTER" --service "$ECS_SERVICE" --region "$REGION" \
  --task-definition "$NEW_TASKDEF_ARN" --query 'service.taskDefinition' --output text

echo "==> waiting for the rollout to settle to a single deployment"
started=$SECONDS
while true; do
  count="$(aws ecs describe-services --cluster "$CLUSTER" --services "$ECS_SERVICE" \
    --region "$REGION" --query 'length(services[0].deployments)' --output text)"
  [ "$count" = "1" ] && break
  if timed_out "$started"; then
    echo "==> the rollout did not settle within ${SETTLE_TIMEOUT_SECS}s; the service is still deploying" >&2
    exit 1
  fi
  sleep 10
done

echo "==> done. now running:"
aws ecs describe-task-definition --task-definition "$NEW_TASKDEF_ARN" --region "$REGION" \
  --query "taskDefinition.containerDefinitions[?name=='${SERVICE_NAME}'].image" --output text

echo "==> syncing CloudFormation's ${CFN_PARAM_KEY} so the stack stops drifting from reality"
stack_parameters() {
  aws cloudformation describe-stacks --stack-name "$STACK" --region "$REGION" \
    --query 'Stacks[0].Parameters[].[ParameterKey,ParameterValue]' --output json
}
stack_parameters > "${SCRATCH_DIR}/params-before.json"
ALL_PARAM_KEYS="$(aws cloudformation describe-stacks --stack-name "$STACK" --region "$REGION" \
  --query 'Stacks[0].Parameters[].ParameterKey' --output text)"
read -r -a PARAM_KEYS <<< "$ALL_PARAM_KEYS"
CFN_ARGS=()
found=0
for key in "${PARAM_KEYS[@]}"; do
  if [ "$key" = "$CFN_PARAM_KEY" ]; then
    CFN_ARGS+=("ParameterKey=${key},ParameterValue=${TAG}")
    found=1
  else
    CFN_ARGS+=("ParameterKey=${key},UsePreviousValue=true")
  fi
done
if [ "$found" != "1" ]; then
  echo "stack ${STACK} has no parameter named ${CFN_PARAM_KEY}; the service is deployed but the stack was not updated" >&2
  exit 1
fi
aws cloudformation update-stack --stack-name "$STACK" --region "$REGION" \
  --use-previous-template --capabilities CAPABILITY_IAM --parameters "${CFN_ARGS[@]}" \
  --query 'StackId' --output text

echo "==> waiting for the CloudFormation stack update to settle"
started=$SECONDS
while true; do
  stack_status="$(aws cloudformation describe-stacks --stack-name "$STACK" --region "$REGION" \
    --query 'Stacks[0].StackStatus' --output text)"
  case "$stack_status" in
    UPDATE_COMPLETE) echo "    -> ${stack_status}"; break ;;
    *ROLLBACK*|*FAILED*)
      echo "    -> ${stack_status}: the CloudFormation update failed, investigate before relying on it" >&2
      exit 1 ;;
  esac
  if timed_out "$started"; then
    echo "==> the stack update did not settle within ${SETTLE_TIMEOUT_SECS}s (last: ${stack_status})" >&2
    exit 1
  fi
  sleep 10
done

echo "==> checking that only ${CFN_PARAM_KEY} changed"
stack_parameters > "${SCRATCH_DIR}/params-after.json"
python3 - "${SCRATCH_DIR}/params-before.json" "${SCRATCH_DIR}/params-after.json" "$CFN_PARAM_KEY" "$TAG" <<'PYEOF'
import json, sys

before = dict(json.load(open(sys.argv[1])))
after = dict(json.load(open(sys.argv[2])))
key, tag = sys.argv[3], sys.argv[4]
changed = sorted(k for k in set(before) | set(after) if before.get(k) != after.get(k))
if changed != [key] or after.get(key) != tag:
    raise SystemExit("expected only %s to change to %s, but changed: %s" % (key, tag, changed))
print("    -> %s is now %s; no other parameter changed" % (key, tag))
PYEOF

# The deploy itself is done. Finish with the smoke, whose own exit codes (20-23)
# are distinct from a failed deploy step's. SKIP_POST_DEPLOY_SMOKE=1 skips it.
echo "==> deploy succeeded"
bash "${SCRIPT_DIR}/smoke-after-deploy.sh"
