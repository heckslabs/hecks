# GENERATED by hecks deploy project -- re-run it to refresh this file rather
# than hand-editing. Included by the Makefile beside it; settings come from the
# domain's deployed_to("AwsFargate") block (see
# Hecks::Projections::Deploy::Scripts for each key).
#
# HECKS_ROOT is a checkout of one pinned Hecks release, fetched once into a
# cache directory, so the domain image is built from the same Hecks on every
# machine. It replaces any path to a working copy: ROOT below points the
# Makefile's build and mint-era steps at it. Override HECKS_VERSION to build
# from another release, or HECKS_ROOT to use a checkout you manage yourself.
#
# HECKS_VERSION=edge is the one exception to "pinned": it follows the newest commit on main,
# is fetched afresh on every build, and prints the commit it got.

HECKS_VERSION   ?= @@RELEASE@@
HECKS_SOURCE    ?= @@SOURCE@@
HECKS_CACHE_DIR ?= @@CACHE_DIR@@
HECKS_ROOT      ?= $(HECKS_CACHE_DIR)/hecks-$(HECKS_VERSION)
HECKS_TAG       := $(if $(filter edge,$(HECKS_VERSION)),edge,v$(HECKS_VERSION))
ROOT            := $(HECKS_ROOT)
SERVICE         ?= @@SERVICE@@
URL             ?= @@URL@@

.PHONY: hecks-release deploy-service smoke-after-deploy check-era

build: hecks-release

# Fetches the pinned release's tag into HECKS_ROOT unless it is already there,
# and refuses a checkout that is not exactly that tag. The edge tag moves, so it is
# fetched afresh on every build and its commit is printed, not checked.
hecks-release:
ifeq ($(HECKS_VERSION),edge)
	@mkdir -p "$(HECKS_CACHE_DIR)"; \
		if [ -d "$(HECKS_ROOT)/.git" ]; then \
			git -C "$(HECKS_ROOT)" fetch --quiet --depth 1 origin "+refs/tags/edge:refs/tags/edge" && \
			git -C "$(HECKS_ROOT)" checkout --quiet --detach edge; \
		else \
			git clone --quiet --depth 1 --branch edge "$(HECKS_SOURCE)" "$(HECKS_ROOT)"; \
		fi; \
		echo "hecks edge at $$(git -C "$(HECKS_ROOT)" rev-parse --short HEAD) in $(HECKS_ROOT)"
else
	@if [ -f "$(HECKS_ROOT)/exe/hecks" ]; then \
		echo "hecks v$(HECKS_VERSION) is already at $(HECKS_ROOT)"; \
	else \
		echo "Fetching hecks v$(HECKS_VERSION) from $(HECKS_SOURCE) into $(HECKS_ROOT)..."; \
		mkdir -p "$(HECKS_CACHE_DIR)" && \
		git clone --quiet --depth 1 --branch "$(HECKS_TAG)" "$(HECKS_SOURCE)" "$(HECKS_ROOT)"; \
	fi
	@tag="$$(git -C "$(HECKS_ROOT)" describe --tags --exact-match 2>/dev/null)"; \
		if [ "$$tag" != "$(HECKS_TAG)" ]; then \
			echo "$(HECKS_ROOT) is at '$$tag', not $(HECKS_TAG). Remove it and re-run, or set HECKS_ROOT."; \
			exit 1; \
		fi
endif

# Pushes one container's already-built local image under a fresh tag and rolls
# it out. Build the image first (docker-build); see deploy-service.sh.
deploy-service:
	@echo "Deploying $(SERVICE) with deploy-service.sh (pushes its local image, rolls the ECS service)..."
	bash ./deploy-service.sh $(SERVICE)

# Waits for the last roll to settle, then dispatches and follows the smoke.
# SKIP_POST_DEPLOY_SMOKE=1 opts out, DRY_RUN=1 dispatches nothing.
smoke-after-deploy:
	bash ./smoke-after-deploy.sh

# Compares the era a live host reports at GET /version with expected-era.
check-era:
	@test -n "$(URL)" || { echo "usage: make check-era URL=https://host.example"; exit 1; }
	HECKS_ENVIRONMENT=memory ruby "$(HECKS_ROOT)/exe/hecks" host.check_era host="$(URL)" expected=expected-era --wait
