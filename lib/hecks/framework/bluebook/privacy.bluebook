Hecks.bluebook "Privacy" do
  vision "Which fields of a domain's own aggregates are sensitive is a fact about that domain, declared apart from it — the domain itself never spells out that one of its own attributes is PII or PHI."
  supporting

  # What this bluebook answers for every attaching domain: the boot that seeds `mark_sensitive`
  # facts, the masking of a read and the cryptoshred read these verbs from here rather than
  # recognising "Privacy" by name.
  provides "privacy",
           mark_sensitive: "Marking.Mark",
           markings_for:   "Marking.ForDomain"

  provides "subject_keys",
           key_for: "SubjectKey.ForSubject",
           shred:   "SubjectKey.Shred"

  # A domain never marks itself: `Mark` is a wiring-time command (role "Deployment").
  aggregate "Marking" do
    description "One attribute of one domain's own aggregate, flagged sensitive — and the role required to read it unredacted."

    attribute :domain,         MarkingDomain
    attribute :attribute_path, AttributePath
    attribute :category,       Category
    attribute :readable_by,    RoleName

    identified_by :domain, :attribute_path

    value_object "MarkingDomain" do
      attribute :value, String
      invariant("a marking names the domain it applies to") { !value.to_s.empty? }
    end

    # Dotted, e.g. "attendee.medications", so a marking can reach a nested value object.
    value_object "AttributePath" do
      attribute :value, String
      invariant("a marking names an attribute path") { !value.to_s.empty? }
    end

    # Open-ended on purpose ("pii", "phi", ...): this bluebook does not own the vocabulary.
    value_object "Category" do
      attribute :value, String
      invariant("a marking is categorized") { !value.to_s.empty? }
    end

    value_object "RoleName" do
      attribute :value, String
      invariant("reading a marked field unredacted requires a named role") { !value.to_s.empty? }
    end

    command "Mark" do
      role "Deployment"
      goal "Flag one attribute of a domain's own aggregate as sensitive, gating who may read it unredacted"

      attribute :domain,         MarkingDomain
      attribute :attribute_path, AttributePath
      attribute :category,       Category
      attribute :readable_by,    RoleName

      emits Marked
    end

    command "Unmark" do
      role "Deployment"
      goal "Remove a sensitivity flag from an attribute"

      reference_to Marking

      emits Unmarked
    end

    query "ForDomain" do
      description "Every marking declared for one domain, read by whatever gates or redacts that domain's own records."
      attribute :domain, MarkingDomain
      where(domain: :domain)
    end
  end

  # Cryptoshredding: erasure without rewriting events. `key_reference` is an opaque handle
  # from `Ports::KeyVault.issue`, obtained before `Issue`; key material never appears here.
  aggregate "SubjectKey" do
    description "One data subject's own encryption key, from the moment it exists to the moment it is destroyed."

    attribute :domain,        KeyDomain
    attribute :subject_id,    SubjectId
    attribute :key_reference, KeyReference
    attribute :refusal,       Report, optional: true

    identified_by :domain, :subject_id

    value_object "KeyDomain" do
      attribute :value, String
      invariant("a key names the domain its subject belongs to") { !value.to_s.empty? }
    end

    value_object "SubjectId" do
      attribute :value, String
      invariant("a key names the subject it was issued for") { !value.to_s.empty? }
    end

    value_object "KeyReference" do
      attribute :value, String
      invariant("a key carries the vault's own opaque reference to it") { !value.to_s.empty? }
    end

    value_object "Report" do
      attribute :value, String
    end

    # A shred is asked for, then the vault destroys the key, then it is recorded (ADR 0142). The
    # record reads `shredded` only after the vault said the key is gone. A refused destruction
    # leaves it `shred_failed`, which a privacy officer may ask to shred again.
    lifecycle :status, default: "active" do
      mark :failure, "shred_failed"
      transition "Shred"        => "shredding",   from: ["active", "shred_failed"]
      transition "MarkShredded" => "shredded",    from: "shredding"
      transition "FailShred"    => "shred_failed", from: "shredding"
    end

    command "Issue" do
      role "System"
      goal "Record that a subject's data is now encrypted under a fresh, dedicated key"

      attribute :domain,        KeyDomain
      attribute :subject_id,    SubjectId
      attribute :key_reference, KeyReference

      sets :domain
      sets :subject_id
      sets :key_reference

      emits SubjectKeyIssued
    end

    # Asks for the destruction; it does not claim it. The `DestroyTheKeyWhenAsked` policy asks the
    # key vault, and `MarkShredded` records the answer.
    command "Shred" do
      role "Privacy officer"
      goal "Ask for this subject's key to be destroyed, so its ciphertext becomes permanently unrecoverable"

      reference_to SubjectKey

      emits SubjectKeyShredRequested
    end

    # The vault said the key is gone. System-only, so nothing reaches `shredded` by a caller's say-so.
    command "MarkShredded" do
      role "System"
      goal "Record that the vault destroyed this subject's key, so its ciphertext is recorded as unrecoverable"

      reference_to SubjectKey
      attribute :key_reference, KeyReference

      emits SubjectKeyShredded
    end

    command "FailShred" do
      role "System"
      goal "Record why the vault could not destroy this subject's key, leaving it live and the shred to retry"

      reference_to SubjectKey
      attribute :refusal, Report
      sets :refusal

      emits SubjectKeyShredFailed
    end

    query "ForSubject" do
      description "One subject's key record, checked before any attempt to decrypt their sensitive fields."
      attribute :domain,     KeyDomain
      attribute :subject_id, SubjectId
      where(domain: :domain, subject_id: :subject_id)
    end
  end

  # What a shred does once asked for: the key vault destroys the key, and the answer is recorded.
  # The port is declared in privacy.ports.hecksagon and bound by privacy.key_destroyer.adapter.
  policy "DestroyTheKeyWhenAsked" do
    on  "SubjectKey.SubjectKeyShredRequested"
    ask :destroy
  end

  policy "RecordTheDestruction" do
    on      "SubjectKey.SubjectKeyDestroyed"
    trigger SubjectKey::MarkShredded, with: { key_reference: :key_reference }
  end

  policy "RecordTheRefusal" do
    on      "SubjectKey.SubjectKeyDestructionRefused"
    trigger SubjectKey::FailShred, with: { refusal: :refusal }
  end
end
