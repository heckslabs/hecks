# The framework members bound to Memory so they can boot standing alone with
# `Hecks.boot("lib/hecks/framework")`. `attaches` does not read this file.
Hecks.hecksagon "Compliance" do
  # Every command declares `role "Compliance officer"`; the role check needs Governance.
  attaches "Governance"
  persisted_by "Memory"
end

Hecks.hecksagon "ConsoleSettings" do
  # Same reason as Compliance.
  attaches "Governance"
  persisted_by "Memory"
end

Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end

Hecks.hecksagon "Identity" do
  # `Identity.Register` declares `role "Identity registrar"`; same reason as Compliance.
  attaches "Governance"
  persisted_by "Memory"
end

# Privacy's `Keys` port is declared in privacy.ports.hecksagon, beside its adapter binding.
Hecks.hecksagon "Privacy" do
  # `Marking.Mark` declares `role "Deployment"` and `Shred` a privacy officer; same reason as Compliance.
  attaches "Governance"
  persisted_by "Memory"
end
