Hecks.hecksagon "Change" do
  # `Change.Request` and `Change.Confirm` declare roles; same reason as Compliance.
  attaches "Governance"
  persisted_by "Memory"

  # The change moves through two asks: `Examine` plans it, `Perform` carries it out. What a
  # script does is the adapter's, so the chapter never names one.
  Change::Change.port "Script" do
    asks "Examine", to: Change do
      attribute :run, RunKey
      answers "ChangeExamined"
      refuses "ChangeRefused"
    end

    asks "Perform", to: Change do
      attribute :run, RunKey
      answers "ChangeAnswered"
      refuses "ChangeRefused"
    end
  end
end
