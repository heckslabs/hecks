# Binds the `event_delivery` port to `OutboxDelivery`, the Ruby outbox read as EventDelivery's
# deliveries (ADR 0178). Required by name, not relative, so a copy of this directory shares the one
# implementation loaded.
require "hecks/adapters/driven/outbox_delivery"

Hecks.adapter "OutboxDelivery" do
  port "event_delivery"
end
