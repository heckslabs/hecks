Hecks.bluebook "Identity" do
  vision "Authentication proves an identifier; the organization decides what that identity means."
  # Generic, not `supporting`: an OIDC-shaped external identifier is the textbook generic
  # subdomain. Governance's role/scope RBAC is bespoke to this codebase, so it stays
  # `supporting` (ADR 0025).
  generic

  # What this bluebook answers for every attaching domain, declared rather than named as
  # Governance's `provides "authorization"` is. Field mapping lives on the consuming
  # hecksagon's `translates` ACL; Link's reference is `identity`, not `identity_id` or `to:`.
  provides "identity",
           register: "Identity.Register",
           link:     "ExternalIdentifier.Link",
           resolve:  "ExternalIdentifier.ResolvedBy"

  aggregate "Identity" do
    description "A stable organizational identity, independent of how it was authenticated."

    attribute :identity_id, IdentityId

    identified_by :identity_id

    value_object "IdentityId" do
      attribute :value, String
      invariant("an identity id is present") { !value.to_s.empty? }
    end

    # No natural key exists for a new identity: the caller mints `identity_id` via
    # `Ports::IdentityGeneration.uuid` before dispatching.
    command "Register" do
      role "Identity registrar"
      goal "Recognize an identity"

      attribute :identity_id, IdentityId
      emits IdentityRegistered
    end
  end

  aggregate "ExternalIdentifier" do
    description "One authenticated (issuer, subject) pair, linked to the identity it proves control of."

    reference_to Identity
    attribute :key,     ExternalIdentifierKey
    attribute :issuer,  Issuer
    attribute :subject, Subject

    identified_by :key

    value_object "ExternalIdentifierKey" do
      attribute :value, String
      invariant("a key is present") { !value.to_s.empty? }
    end

    value_object "Issuer" do
      attribute :value, String
      invariant("an issuer is present") { !value.to_s.empty? }
    end

    value_object "Subject" do
      attribute :value, String
      invariant("a subject is present") { !value.to_s.empty? }
    end

    # `key` is not derived here; the caller derives it (e.g. SHA256 of issuer+subject).
    command "Link" do
      role "Identity registrar"
      goal "Associate an external authenticated subject with an identity"

      reference_to Identity
      attribute :key,     ExternalIdentifierKey
      attribute :issuer,  Issuer
      attribute :subject, Subject

      emits ExternalIdentifierLinked
    end

    # The OIDC-shaped lookup: a token hands over `(issuer, subject)`, never `key`. `identity`
    # rides the row from `reference_to Identity`, so no second query is needed.
    query "ResolvedBy" do
      description "The external identifier linked to this exact (issuer, subject) pair, if any."
      attribute :issuer,  Issuer
      attribute :subject, Subject
      where(issuer: :issuer, subject: :subject)
    end
  end

  # What a sign-in host reads from this bluebook, declared rather than hard-coded in the host:
  # how long a session and each token it mints stays valid, and the one rule an email address must
  # meet. The host reads each verb's resolved `default:` from `ir.json`'s `provides` map. The
  # 30-second clock skew and the 60-second maximum token life are protocol constants of the
  # platform sign-in verifier, not settings, and stay in the host.
  provides "sign_in",
           session:      "SignInSettings.session_seconds",
           handoff:      "SignInSettings.handoff_seconds",
           sso_token:    "SignInSettings.sso_token_seconds",
           google_state: "SignInSettings.google_state_seconds",
           email:        "SignInSettings.email_pattern"

  # The settings a sign-in host reads. Each is one declared default, never edited at runtime.
  aggregate "SignInSettings" do
    description "The lifetimes, in whole seconds, and the email rule that sign-in reads from the bluebook that attaches it."

    attribute :settings_key,         SettingsKey
    attribute :session_seconds,      Seconds,      default: { value: 1_209_600 }
    attribute :handoff_seconds,      Seconds,      default: { value: 60 }
    attribute :sso_token_seconds,    Seconds,      default: { value: 60 }
    attribute :google_state_seconds, Seconds,      default: { value: 600 }
    attribute :email_pattern,        EmailPattern, default: { value: '\A[^@[:space:]]+@[^[:space:]]*[.][^[:space:]]*\z' }

    identified_by :settings_key

    value_object "SettingsKey" do
      attribute :value, String
      invariant("a settings key is present") { !value.to_s.empty? }
    end

    value_object "Seconds" do
      attribute :value, Integer
      invariant("a lifetime is a positive number of seconds") { value.to_i.positive? }
    end

    value_object "EmailPattern" do
      attribute :value, String
      invariant("an email pattern is present") { !value.to_s.empty? }
    end
  end
end
