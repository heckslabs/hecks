# The port EventDelivery declares, for every hecksagon that attaches the bluebook (`Framework.load!`
# loads this file with it). `Carry` asks for one pump run over the adapter's domains and answers with
# what it reported; a run that could not be carried out refuses with a reason (ADR 0178). The
# adapter is the deployment's: QualityControl's `PumpTools` binds it for the QA ledger.
Hecks.hecksagon "EventDelivery" do
  EventDelivery::Pump.port "Pumping" do
    asks "Carry", to: Pump do
      attribute :run, PumpRun
      answers "PumpCarried"
      refuses "PumpCarryRefused"
    end
  end
end
