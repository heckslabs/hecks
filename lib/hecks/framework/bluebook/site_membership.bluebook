# The SiteMembership bluebook: who may sign in to a site, with what role, for how long.
#
# This is the rule set a site's host enforces when it admits a person, grants a role, disables,
# deletes or re-roles one. It is the default: a client bluebook that declares its own
# `provides "membership"` keeps its own aggregate and its own verbs, and this one is only used by
# a domain that attaches it. The `provides` row below names the same three verbs the contract asks
# for, so the resolution (the domain's own bluebook, then a member it attaches, then any loaded one)
# needs no special case.
#
# One Membership is one person, keyed by email. The rules about the whole site (it keeps an admin,
# it keeps one with no end date) read the other people, which no single record can see, so the
# adapter that dispatches counts the others and hands the counts to the command as `others_*`
# arguments; the command's givens decide. The clock is an adapter's too: it turns a window of days
# into the instant the window ends, and says whether the person's window has ended, and hands the
# command both.
#
# An admin is a person whose role is Admin or Owner (Owner is a superset of Admin, since a person
# holds one role), active when not disabled and not past the window. "No end date" means no window.
Hecks.bluebook "SiteMembership" do
  vision "A site keeps an admin who cannot lapse, and nobody keeps access by accident."
  supporting

  provides "membership",
           admit:  "Membership.Admit",
           grant:  "Membership.Grant",
           people: "Membership.People"

  aggregate "Membership" do
    description "One person the site admitted: their role, the end of their access window if any, and whether they are disabled or deleted."

    attribute :email,             Email
    attribute :name,              PersonName
    attribute :role,              Held, default: { value: "" }
    attribute :access_expires_at, Ends, default: { value: "" }
    attribute :identity_id,       IdentityRef, optional: true

    identified_by :email

    value_object "Email" do
      attribute :value, String, matches: :present
      invariant("an email is present") { !value.to_s.empty? }
    end

    value_object "PersonName" do
      attribute :value, String, matches: :present
      invariant("a person is named") { !value.to_s.empty? }
    end

    # The roles a grant may assign. Any admin may grant Owner, because the first Owner has to be
    # granted by an Admin.
    value_object "Role" do
      attribute :value, String, one_of: ["Admin", "Owner", "Member"]
    end

    # The role the caller holds right now, empty when the caller is unknown, lapsed or has none.
    value_object "CallerRole" do
      attribute :value, String
    end

    # The caller's own email, to tell a person acting on themselves.
    value_object "Caller" do
      attribute :value, String
    end

    # The end of an access window as a UTC instant; empty means no window. A value that is not an
    # instant is not readable, and the adapter that reads a stored end counts an unreadable one as
    # ended: access fails closed.
    value_object "Ends" do
      attribute :value, String, pattern: '^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$'
    end

    # The role a person holds now; empty means none yet.
    value_object "Held" do
      attribute :value, String, one_of: ["", "Admin", "Owner", "Member"]
    end

    # Days of access a grant asks for; 0 means no window, otherwise 1 to 365 (the givens say so).
    value_object "Days" do
      attribute :value, Integer
    end

    # Whether the person's window has ended at the moment of the command; the clock's answer.
    value_object "Flag" do
      attribute :value, String, one_of: ["yes", "no"]
    end

    # How many of the other people (not the one the command is about) hold the standing it names.
    value_object "Others" do
      attribute :value, Integer

      invariant("a count is not negative") { !value.negative? }
    end

    value_object "IdentityRef" do
      attribute :value, String, matches: :present
    end

    # Disabling keeps the role, so enabling restores exactly what the person held. A deleted person
    # is not listed and has no way back: re-admitting the same email starts a fresh row.
    lifecycle :status, default: "admitted" do
      transition "Disable" => "disabled", from: "admitted"
      transition "Enable"  => "admitted", from: "disabled"
      transition "Delete"  => "deleted",  from: "disabled"
    end

    command "Admit" do
      goal "Recognize a person who may eventually sign in, with no role yet"

      attribute :email, Email, sets: true
      attribute :name,  PersonName, sets: true

      emits "PersonAdmitted"
    end

    # A plain grant sets the role and clears the window; a grant that names a window replaces any
    # earlier one (a regrant renews). A grant with no role grants Admin. A window is 1 to 365 days;
    # the adapter turns the days into `window_ends_at`. A site keeps an admin with no end date: no
    # change may take the last one off that footing, and the site's first admin has no end date.
    command "Grant" do
      goal "Give an admitted person a role, optionally for a window of days"

      reference_to Membership
      attribute :new_role,           Role, default: { value: "Admin" }
      attribute :window_days,        Days, default: { value: 0 }
      attribute :window_ends_at,     Ends, default: { value: "" }
      attribute :others_open_admins, Others
      attribute :others_admins,      Others

      sets :role, to: :new_role
      sets :access_expires_at, to: :window_ends_at

      given("a window is 1 to 365 days") { window_days.value == 0 || (window_days.value >= 1 && window_days.value <= 365) }
      given("a window asked for has an end, and no window has none") do
        (window_days.value == 0 && window_ends_at.value == "") || (window_days.value >= 1 && window_ends_at.value != "")
      end
      given("a site keeps an admin with no end date") do
        others_open_admins.value >= 1 ||
          (["Admin", "Owner"].include?(new_role.value) && status == "admitted" && window_ends_at.value == "") ||
          !(["Admin", "Owner"].include?(role.value) && status == "admitted" && access_expires_at.value == "")
      end
      given("the first admin of a site has no end date") do
        (["Admin", "Owner"].include?(role.value)) || others_admins.value >= 1 ||
          !["Admin", "Owner"].include?(new_role.value) || (status == "admitted" && window_ends_at.value == "")
      end

      emits "AccessGranted"
    end

    command "SetRole" do
      goal "Change a person's role on an active admin's behalf"

      reference_to Membership
      attribute :new_role,             Role
      attribute :caller_role,          CallerRole
      attribute :window_ended,         Flag
      attribute :others_active_admins, Others
      attribute :others_open_admins,   Others
      attribute :others_admins,        Others

      sets :role, to: :new_role

      given("only an active admin sets a role") { ["Admin", "Owner"].include?(caller_role.value) }
      given("a site keeps an active admin") do
        ["Admin", "Owner"].include?(new_role.value) || others_active_admins.value >= 1 ||
          !(["Admin", "Owner"].include?(role.value) && status == "admitted" && window_ended.value == "no")
      end
      given("a site keeps an admin with no end date") do
        others_open_admins.value >= 1 ||
          (["Admin", "Owner"].include?(new_role.value) && status == "admitted" && access_expires_at.value == "") ||
          !(["Admin", "Owner"].include?(role.value) && status == "admitted" && access_expires_at.value == "")
      end
      given("the first admin of a site has no end date") do
        (["Admin", "Owner"].include?(role.value)) || others_admins.value >= 1 ||
          !["Admin", "Owner"].include?(new_role.value) || (status == "admitted" && access_expires_at.value == "")
      end

      emits "RoleSet"
    end

    command "Disable" do
      goal "Take a person's access away without losing their role"

      reference_to Membership
      attribute :caller,               Caller
      attribute :caller_role,          CallerRole
      attribute :window_ended,         Flag
      attribute :others_active_admins, Others
      attribute :others_open_admins,   Others

      given("only an active admin disables a person") { ["Admin", "Owner"].include?(caller_role.value) }
      given("an admin cannot disable themselves") { caller.value != email.value }
      given("a site keeps an active admin") do
        others_active_admins.value >= 1 ||
          !(["Admin", "Owner"].include?(role.value) && status == "admitted" && window_ended.value == "no")
      end
      given("a site keeps an admin with no end date") do
        others_open_admins.value >= 1 ||
          !(["Admin", "Owner"].include?(role.value) && status == "admitted" && access_expires_at.value == "")
      end

      emits "PersonDisabled"
    end

    command "Enable" do
      goal "Give a disabled person back the access their role holds"

      reference_to Membership
      attribute :caller_role, CallerRole

      given("only an active admin enables a person") { ["Admin", "Owner"].include?(caller_role.value) }

      emits "PersonEnabled"
    end

    command "Delete" do
      goal "Soft-delete a person who is already disabled; the row stays, the listing drops it"

      reference_to Membership
      attribute :caller_role, CallerRole

      given("only an active admin deletes a person") { ["Admin", "Owner"].include?(caller_role.value) }

      emits "PersonDeleted"
    end

    query "People" do
      description "Every admitted person, for the admin listing."
    end
  end
end
