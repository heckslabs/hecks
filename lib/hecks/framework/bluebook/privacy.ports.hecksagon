# The port Privacy declares, for every hecksagon that attaches the bluebook (`Framework.load!` loads
# this file with it). `Issue` asks the key vault for a key for a subject and answers with the
# reference to it; `Destroy` asks it to destroy a subject's key and answers once it is gone. Each
# refuses with a reason. privacy.key_keeper.adapter binds both (ADR 0142, ADR 0147).
Hecks.hecksagon "Privacy" do
  Privacy::SubjectKey.port "Keys" do
    # No argument: the ask is handed the subject's held state, which names the subject.
    asks "Issue", to: SubjectKey do
      answers "SubjectKeyIssued"
      refuses "SubjectKeyIssueRefused"
    end

    # No argument: the ask is handed the subject's held state, which names the key.
    asks "Destroy", to: SubjectKey do
      answers "SubjectKeyDestroyed"
      refuses "SubjectKeyDestructionRefused"
    end
  end
end
