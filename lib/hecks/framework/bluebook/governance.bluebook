Hecks.bluebook "Governance" do
  vision "Organizational authority is explicit, reviewable, and historically explainable."
  supporting

  # What this chapter answers for every attaching domain: the role check at dispatch, boot's
  # refusal of an ungoverned `role`, the authorization adapter and the fuzzer's grant
  # steering read these three verbs from here rather than recognising "Governance" by name.
  provides "authorization",
           assignments: "RoleAssignment.AssignmentsForActor",
           grant:       "RoleAssignment.Assign",
           transitions: "RoleTransition.Allowed"

  aggregate "RoleAssignment" do
    description "One actor holding one role, over one scope, from one point in time — revoked by setting when it ended, never deleted."

    # The identity is the event, not the (actor, role) pair: an actor can hold a role again
    # after a prior assignment ended, and that is a second assignment. `starts_at` makes each
    # one unique.
    attribute :actor_id,  IdentityId
    attribute :role_name, RoleName
    attribute :scope,     Scope
    attribute :starts_at, Timestamp
    attribute :ends_at,   Timestamp, optional: true

    identified_by :actor_id, :role_name, :starts_at

    value_object "IdentityId" do
      attribute :value, String
      invariant("an identity id is present") { !value.to_s.empty? }
    end

    value_object "RoleName" do
      attribute :value, String
      invariant("a role is named") { !value.to_s.empty? }
    end

    value_object "Scope" do
      attribute :value, String
      invariant("a scope is named") { !value.to_s.empty? }
    end

    value_object "Timestamp" do
      attribute :value, String
      invariant("a timestamp is present") { !value.to_s.empty? }
    end

    command "Assign" do
      role "Governance administrator"
      goal "Authorize an actor to perform a responsibility"

      attribute :actor_id,  IdentityId
      attribute :role_name, RoleName
      attribute :scope,     Scope
      attribute :starts_at, Timestamp

      emits RoleAssigned
    end

    command "Revoke" do
      role "Governance administrator"
      goal "Remove organizational authority"

      reference_to RoleAssignment
      attribute :ends_at, Timestamp

      sets :ends_at
      emits RoleRevoked
    end

    query "AssignmentsForActor" do
      description "Every role an actor currently or historically holds."
      attribute :actor_id, IdentityId
      where(actor_id: :actor_id)
    end
  end

  # Whether role X may act as role Y, which `act_as` needs before a caller dispatches under a
  # role it does not hold. Same event-log shape as RoleAssignment, and the identity is the
  # grant: without `starts_at`, a revoked pair would occupy its id forever and a repeat
  # `Grant` would be refused as `AlreadyExists`.
  aggregate "RoleTransition" do
    description "Role X is authorized to act as role Y, from one point in time — until revoked, and grantable again afterward, exactly like RoleAssignment."

    attribute :from_role, RoleName
    attribute :to_role,   RoleName
    attribute :starts_at, Timestamp
    attribute :ends_at,   Timestamp, optional: true

    identified_by :from_role, :to_role, :starts_at

    value_object "RoleName" do
      attribute :value, String
      invariant("a role is named") { !value.to_s.empty? }
    end

    value_object "Timestamp" do
      attribute :value, String
      invariant("a timestamp is present") { !value.to_s.empty? }
    end

    command "Grant" do
      role "Governance administrator"
      goal "Authorize one role to act as another"

      attribute :from_role, RoleName
      attribute :to_role,   RoleName
      attribute :starts_at, Timestamp

      emits RoleTransitionGranted
    end

    command "Revoke" do
      role "Governance administrator"
      goal "Remove an authorized role transition"

      reference_to RoleTransition
      attribute :ends_at, Timestamp

      sets :ends_at
      emits RoleTransitionRevoked
    end

    # Every grant of this pair, current or historical: `where` cannot ask "ends_at is absent",
    # so the caller reads `ends_at` to tell a live grant from a revoked one. A pair granted
    # again after a revocation is a second row.
    query "Allowed" do
      description "Every role transition granted for this exact pair, current or historical."
      attribute :from_role, RoleName
      attribute :to_role,   RoleName
      where(from_role: :from_role, to_role: :to_role)
    end
  end
end
