Hecks.bluebook "Governance" do
  vision "Organizational authority is explicit, reviewable, and historically explainable."
  supporting

  # What this bluebook answers for every attaching domain: the role check at dispatch, boot's
  # refusal of an ungoverned `role`, the authorization adapter and the fuzzer's grant
  # steering read these verbs from here rather than recognising "Governance" by name. What counts
  # as live is declared here, as the two `Live` queries, and not decided by the reader.
  provides "authorization",
           assignments:      "RoleAssignment.AssignmentsForActor",
           live_assignments: "RoleAssignment.LiveAssignmentsForActor",
           grant:            "RoleAssignment.Assign",
           transitions:      "RoleTransition.Allowed",
           live_transitions: "RoleTransition.LiveAllowed"

  aggregate "RoleAssignment" do
    description "One actor holding one role, over one scope, from one point in time — revoked by setting when it ended, never deleted."

    # The identity is the event, not the (actor, role) pair: an actor can hold a role again
    # after a prior assignment ended, and that is a second assignment. `starts_at` makes each
    # one unique.
    attribute :actor_id,  IdentityId
    attribute :role_name, RoleName
    attribute :scope,     Scope
    attribute :starts_at, Timestamp
    attribute :ends_at,   Timestamp, optional: true

    identified_by :actor_id, :role_name, :starts_at

    value_object "IdentityId" do
      attribute :value, String
      invariant("an identity id is present") { !value.to_s.empty? }
    end

    value_object "RoleName" do
      attribute :value, String
      invariant("a role is named") { !value.to_s.empty? }
    end

    value_object "Scope" do
      attribute :value, String
      invariant("a scope is named") { !value.to_s.empty? }
    end

    # A UTC instant: a date, or a date and time ending in Z. Both read and sort the same way, so
    # "has it started" and "does it end after it starts" are string comparisons the model can state.
    value_object "Timestamp" do
      attribute :value, String, pattern: '^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$'
      invariant("a timestamp is present") { !value.to_s.empty? }
    end

    command "Assign" do
      role "Governance administrator"
      goal "Authorize an actor to perform a responsibility"

      attribute :actor_id,  IdentityId
      attribute :role_name, RoleName
      attribute :scope,     Scope
      attribute :starts_at, Timestamp

      emits RoleAssigned
    end

    command "Revoke" do
      role "Governance administrator"
      goal "Remove organizational authority"

      reference_to RoleAssignment
      attribute :ends_at, Timestamp, sets: true

      given("a grant ends no earlier than it starts") { ends_at.value >= starts_at.value }

      emits RoleRevoked
    end

    query "AssignmentsForActor" do
      description "Every role an actor currently or historically holds."
      attribute :actor_id, IdentityId
      where(actor_id: :actor_id)
    end

    # Live means not yet revoked: a grant whose `ends_at` was never set. The adapter that checks a
    # role reads this and does not decide liveness itself.
    query "LiveAssignmentsForActor" do
      description "Every role an actor holds right now: assigned and not yet revoked."
      attribute :actor_id, IdentityId
      where(actor_id: :actor_id, ends_at: nil)
    end
  end

  # Whether role X may act as role Y, which `act_as` needs before a caller dispatches under a
  # role it does not hold. Same event-log shape as RoleAssignment, and the identity is the
  # grant: without `starts_at`, a revoked pair would occupy its id forever and a repeat
  # `Grant` would be refused as `AlreadyExists`.
  aggregate "RoleTransition" do
    description "Role X is authorized to act as role Y, from one point in time — until revoked, and grantable again afterward, exactly like RoleAssignment."

    attribute :from_role, RoleName
    attribute :to_role,   RoleName
    attribute :starts_at, Timestamp
    attribute :ends_at,   Timestamp, optional: true

    identified_by :from_role, :to_role, :starts_at

    value_object "RoleName" do
      attribute :value, String
      invariant("a role is named") { !value.to_s.empty? }
    end

    value_object "Timestamp" do
      attribute :value, String, pattern: '^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$'
      invariant("a timestamp is present") { !value.to_s.empty? }
    end

    command "Grant" do
      role "Governance administrator"
      goal "Authorize one role to act as another"

      attribute :from_role, RoleName
      attribute :to_role,   RoleName
      attribute :starts_at, Timestamp

      emits RoleTransitionGranted
    end

    command "Revoke" do
      role "Governance administrator"
      goal "Remove an authorized role transition"

      reference_to RoleTransition
      attribute :ends_at, Timestamp, sets: true

      given("a grant ends no earlier than it starts") { ends_at.value >= starts_at.value }

      emits RoleTransitionRevoked
    end

    # Every grant of this pair, current or historical. A pair granted again after a revocation is
    # a second row.
    query "Allowed" do
      description "Every role transition granted for this exact pair, current or historical."
      attribute :from_role, RoleName
      attribute :to_role,   RoleName
      where(from_role: :from_role, to_role: :to_role)
    end

    # The grants of this pair that were never revoked: the ones that let one role act as another.
    query "LiveAllowed" do
      description "Every role transition granted for this exact pair and not yet revoked."
      attribute :from_role, RoleName
      attribute :to_role,   RoleName
      where(from_role: :from_role, to_role: :to_role, ends_at: nil)
    end
  end

  # What a storehouse call must carry before it reads anything. `Hecks::Storehouse` reads the two
  # closed lists from here and its refusals name them; it holds no copy.
  aggregate "Call" do
    description "One dispatch, query or state call to a storehouse: what it is for, where it came from, and who makes it."

    attribute :summary,    Summary
    attribute :source,     Source, optional: true
    attribute :surface,    Surface, optional: true
    attribute :role_name,  RoleName, optional: true
    attribute :actor_id,   IdentityId, optional: true
    attribute :role_gated, Gated

    identified_by :summary

    # One line that makes an audit row legible later.
    value_object "Summary" do
      attribute :value, String, matches: :present
    end

    # Who is calling, when the caller says.
    value_object "Source" do
      attribute :value, String, one_of: ["process-manager", "operator", "hook", "sidequest-agent", "cascade", "daemon"]
    end

    # What made the call: a person at a shell, an agent over MCP, or the domain itself.
    value_object "Surface" do
      attribute :value, String, one_of: ["cli", "mcp", "policy", "saga", "reaction"]
    end

    value_object "RoleName" do
      attribute :value, String
    end

    value_object "IdentityId" do
      attribute :value, String
    end

    # Whether the command asked for names a role that may run it.
    value_object "Gated" do
      attribute :value, String, one_of: ["yes", "no"]
    end

    command "Admit" do
      role "System"
      goal "Admit a call to a storehouse only when it says what it is for and, where a role is asked, who makes it"

      attribute :summary,    Summary
      attribute :source,     Source, optional: true
      attribute :surface,    Surface, optional: true
      attribute :role_name,  RoleName, optional: true
      attribute :actor_id,   IdentityId, optional: true
      attribute :role_gated, Gated

      given("an actor names the role it holds") { actor_id.nil? || !role_name.nil? }
      given("a role-gated command has a caller bound") { role_gated.value != "yes" || !role_name.nil? }

      emits CallAdmitted
    end
  end

  # What a spawned MCP server may serve and pass on: only reader tools (and `dispatch` in commands
  # mode), and never an argument that names a host, a URL, a binary, a place to write or a switch
  # from preview to change. `Hecks::Adapters::Driving::McpScope` reads these lists from here.
  aggregate "Door" do
    description "The reach of one restricted MCP server: the tools it serves and the argument names it never passes on."

    attribute :door,     DoorKey
    attribute :tool,     ReaderTool
    attribute :dispatch, DispatchTool, optional: true
    attribute :denied,   DeniedArgument, optional: true
    attribute :path,     PathArgument, optional: true
    attribute :ref,      RefArgument, optional: true

    identified_by :door

    # The name of one restricted server's door. A string key, not a closed set: the tool a door
    # serves is an attribute, so the identity of the door does not depend on which tool it serves.
    value_object "DoorKey" do
      attribute :value, String, matches: :present
    end

    # Each reads a domain or the server's own audit log and writes no domain state.
    value_object "ReaderTool" do
      attribute :value, String, one_of: %w[query events state catalog describe validate domains history follow]
    end

    # Served in commands mode only, for a closed list of commands.
    value_object "DispatchTool" do
      attribute :value, String, one_of: ["dispatch"]
    end

    # Names a host or a URL, a binary to run, what a spawned session is told to do, a place to
    # write, a port to open, a store to switch to, or flips a command from a preview to a change.
    value_object "DeniedArgument" do
      attribute :value, String, one_of: %w[
        adapter artifact bluebook brief claimed confirm expected force from gem_only header health_path host live
        no_wait npm_local npm_only output path payload payload_file port prebuilt remote row rust_binary
        scheme stage_dir state_path stdio url write
      ]
    end

    # Values are paths: each must resolve, symlinks followed, inside the boot root.
    value_object "PathArgument" do
      attribute :value, String, one_of: %w[checkout dir directory domain domains file files fixture paths repo root script]
    end

    # Values are git refs: plain names only, so a value cannot read as an option to git.
    value_object "RefArgument" do
      attribute :value, String, one_of: %w[base branch commit onto ref]
    end

    command "Serve" do
      role "System"
      goal "Serve a reader tool on a restricted MCP server"

      attribute :door,     DoorKey, sets: true
      attribute :tool,     ReaderTool
      attribute :dispatch, DispatchTool, optional: true
      attribute :denied,   DeniedArgument, optional: true
      attribute :path,     PathArgument, optional: true
      attribute :ref,      RefArgument, optional: true

      emits ToolServed
    end
  end
end
