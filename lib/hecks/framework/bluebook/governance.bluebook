Hecks.bluebook "Governance" do
  vision "Organizational authority is explicit, reviewable, and historically explainable."
  supporting

  # What this bluebook answers for every attaching domain: the role check at dispatch, boot's
  # refusal of an ungoverned `role`, the authorization adapter and the fuzzer's grant
  # steering read these verbs from here rather than recognising "Governance" by name. What counts
  # as live is declared here, as the two `Live` queries, and not decided by the reader.
  provides "authorization",
           assignments:      "RoleAssignment.AssignmentsForActor",
           live_assignments: "RoleAssignment.LiveAssignmentsForActor",
           grant:            "RoleAssignment.Assign",
           transitions:      "RoleTransition.Allowed",
           live_transitions: "RoleTransition.LiveAllowed"

  aggregate "RoleAssignment" do
    description "One actor holding one role, over one scope, from one point in time — revoked by setting when it ended, never deleted."

    # The identity is the event, not the (actor, role) pair: an actor can hold a role again
    # after a prior assignment ended, and that is a second assignment. `starts_at` makes each
    # one unique.
    attribute :actor_id,  IdentityId
    attribute :role_name, RoleName
    attribute :scope,     Scope
    attribute :starts_at, Timestamp
    attribute :ends_at,   Timestamp, optional: true

    identified_by :actor_id, :role_name, :starts_at

    value_object "IdentityId" do
      attribute :value, String
      invariant("an identity id is present") { !value.to_s.empty? }
    end

    value_object "RoleName" do
      attribute :value, String
      invariant("a role is named") { !value.to_s.empty? }
    end

    value_object "Scope" do
      attribute :value, String
      invariant("a scope is named") { !value.to_s.empty? }
    end

    # A UTC instant: a date, or a date and time ending in Z. Both read and sort the same way, so
    # "has it started" and "does it end after it starts" are string comparisons the model can state.
    value_object "Timestamp" do
      attribute :value, String, pattern: '^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$'
      invariant("a timestamp is present") { !value.to_s.empty? }
    end

    command "Assign" do
      role "Governance administrator"
      goal "Authorize an actor to perform a responsibility"

      attribute :actor_id,  IdentityId
      attribute :role_name, RoleName
      attribute :scope,     Scope
      attribute :starts_at, Timestamp

      emits RoleAssigned
    end

    command "Revoke" do
      role "Governance administrator"
      goal "Remove organizational authority"

      reference_to RoleAssignment
      attribute :ends_at, Timestamp, sets: true

      given("a grant ends no earlier than it starts") { ends_at.value >= starts_at.value }

      emits RoleRevoked
    end

    query "AssignmentsForActor" do
      description "Every role an actor currently or historically holds."
      attribute :actor_id, IdentityId
      where(actor_id: :actor_id)
    end

    # Live means not yet revoked: a grant whose `ends_at` was never set. The adapter that checks a
    # role reads this and does not decide liveness itself.
    query "LiveAssignmentsForActor" do
      description "Every role an actor holds right now: assigned and not yet revoked."
      attribute :actor_id, IdentityId
      where(actor_id: :actor_id, ends_at: nil)
    end
  end

  # Whether role X may act as role Y, which `act_as` needs before a caller dispatches under a
  # role it does not hold. Same event-log shape as RoleAssignment, and the identity is the
  # grant: without `starts_at`, a revoked pair would occupy its id forever and a repeat
  # `Grant` would be refused as `AlreadyExists`.
  aggregate "RoleTransition" do
    description "Role X is authorized to act as role Y, from one point in time — until revoked, and grantable again afterward, exactly like RoleAssignment."

    attribute :from_role, RoleName
    attribute :to_role,   RoleName
    attribute :starts_at, Timestamp
    attribute :ends_at,   Timestamp, optional: true

    identified_by :from_role, :to_role, :starts_at

    value_object "RoleName" do
      attribute :value, String
      invariant("a role is named") { !value.to_s.empty? }
    end

    value_object "Timestamp" do
      attribute :value, String, pattern: '^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$'
      invariant("a timestamp is present") { !value.to_s.empty? }
    end

    command "Grant" do
      role "Governance administrator"
      goal "Authorize one role to act as another"

      attribute :from_role, RoleName
      attribute :to_role,   RoleName
      attribute :starts_at, Timestamp

      emits RoleTransitionGranted
    end

    command "Revoke" do
      role "Governance administrator"
      goal "Remove an authorized role transition"

      reference_to RoleTransition
      attribute :ends_at, Timestamp, sets: true

      given("a grant ends no earlier than it starts") { ends_at.value >= starts_at.value }

      emits RoleTransitionRevoked
    end

    # Every grant of this pair, current or historical. A pair granted again after a revocation is
    # a second row.
    query "Allowed" do
      description "Every role transition granted for this exact pair, current or historical."
      attribute :from_role, RoleName
      attribute :to_role,   RoleName
      where(from_role: :from_role, to_role: :to_role)
    end

    # The grants of this pair that were never revoked: the ones that let one role act as another.
    query "LiveAllowed" do
      description "Every role transition granted for this exact pair and not yet revoked."
      attribute :from_role, RoleName
      attribute :to_role,   RoleName
      where(from_role: :from_role, to_role: :to_role, ends_at: nil)
    end
  end

  # One action seen outside any declared command, kept as it was seen. Nothing here changes or
  # removes an observation: the only command adds one, so the log only grows.
  aggregate "Observation" do
    description "One action seen outside any declared command, recorded as it was seen and never changed."

    attribute :observation_id, ObservationId
    attribute :source,         Source
    attribute :tool,           Tool
    attribute :subject,        Subject
    attribute :succeeded,      Succeeded
    attribute :observed_in,    Session
    attribute :observed_at,    Timestamp

    identified_by :observation_id

    # Minted by the recording adapter, so two identical actions in one second are two observations.
    value_object "ObservationId" do
      attribute :value, String
      invariant("an observation is identified") { !value.to_s.empty? }
    end

    # Where the action was seen, such as `bash`, `git`, `gh`, `make`, an MCP tool or a file edit.
    value_object "Source" do
      attribute :value, String
      invariant("an observation names where it was seen") { !value.to_s.empty? }
    end

    # The program that ran, such as `git`.
    value_object "Tool" do
      attribute :value, String
      invariant("an observation names its tool") { !value.to_s.empty? }
    end

    # The subcommand words of the action, with its arguments blanked: `git status`, never the
    # arguments themselves.
    value_object "Subject" do
      attribute :value, String
      invariant("an observation names its subject") { !value.to_s.empty? }
    end

    value_object "Succeeded" do
      attribute :value, Boolean
    end

    # The session the action was seen in, as its identifier.
    value_object "Session" do
      attribute :value, String
      invariant("an observation names its session") { !value.to_s.empty? }
    end

    # A UTC instant to the second, ending in Z: the moment the action was seen.
    value_object "Timestamp" do
      attribute :value, String, pattern: '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
      invariant("a timestamp is present") { !value.to_s.empty? }
    end

    command "Record" do
      role "System"
      goal "Keep one raw action seen outside any declared command"

      sets :observation_id
      sets :source
      sets :tool
      sets :subject
      sets :succeeded
      sets :observed_in
      sets :observed_at

      emits ObservationRecorded
    end
  end

  # The judgment of a pattern of observations against the declared rules. An adapter counts the
  # recurrence and raises a finding; a person accepts it into corrective action or dismisses it.
  aggregate "Finding" do
    description "One pattern of observed actions, judged against the declared rules: raised, then accepted or dismissed, never deleted."

    attribute :subject,       Subject
    attribute :kind,          FindingKind
    attribute :count,         Count
    attribute :sessions,      Count
    attribute :success_rate,  SuccessRate
    attribute :proposal,      Proposal
    attribute :proposed_kind, ProposedKind
    attribute :raised_at,     Timestamp
    attribute :reason,        Reason, optional: true

    # The subject and the moment it was raised: a pattern raised again after a dismissal is a
    # second finding, the same way a role granted again is a second assignment.
    identified_by :subject, :raised_at

    value_object "Subject" do
      attribute :value, String
      invariant("a finding names the pattern it concerns") { !value.to_s.empty? }
    end

    # nonconformity: an observed action breaks a declared rule. opportunity_for_improvement: a
    # pattern a declared command would serve better. observation_only: seen, not yet judged.
    value_object "FindingKind" do
      attribute :value, String,
                one_of: ["nonconformity", "opportunity_for_improvement", "observation_only"]
    end

    value_object "Count" do
      attribute :value, Integer
      invariant("a count is not negative") { !value.negative? }
    end

    # The share of the pattern's observations that succeeded, from 0.0 to 1.0.
    value_object "SuccessRate" do
      attribute :value, Float
      invariant("a success rate is between 0 and 1") { value >= 0 && value <= 1 }
    end

    # The DSL block that would bring the pattern under a declared command, aggregate, lifecycle or
    # invariant. Text for a person to read and paste; nothing here evaluates it.
    value_object "Proposal" do
      attribute :value, String
    end

    value_object "ProposedKind" do
      attribute :value, String, one_of: ["command", "aggregate", "lifecycle", "invariant"]
    end

    value_object "Timestamp" do
      attribute :value, String, pattern: '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
      invariant("a timestamp is present") { !value.to_s.empty? }
    end

    value_object "Reason" do
      attribute :value, String
      invariant("a dismissal gives its reason") { !value.to_s.empty? }
    end

    lifecycle :status, default: "raised" do
      transition "Accept"  => "accepted",  from: "raised"
      transition "Dismiss" => "dismissed", from: "raised"
      mark :terminal, "accepted", "dismissed"
    end

    command "Raise" do
      role "System"
      goal "Record a pattern of observed actions as a finding, judged against the declared rules"

      sets :subject
      sets :kind
      sets :count
      sets :sessions
      sets :success_rate
      sets :proposal
      sets :proposed_kind
      sets :raised_at

      emits FindingRaised
    end

    command "Accept" do
      role "Governance administrator"
      goal "Take a finding on, so that a corrective action is started for it"

      reference_to Finding

      emits FindingAccepted
    end

    command "Dismiss" do
      role "Governance administrator"
      goal "Decline a finding, and say why"

      reference_to Finding
      attribute :reason, Reason, sets: true

      emits FindingDismissed
    end
  end

  # The action one accepted finding leads to: one corrective action per finding, started by a
  # policy when the finding is accepted.
  aggregate "CorrectiveAction" do
    description "The corrective action one accepted finding leads to, and the Work row that carries it out."

    attribute :finding, FindingKey
    attribute :work,    WorkKey, optional: true
    attribute :state,   ActionState

    identified_by :finding

    # The finding's identity as the Finding record writes it: its subject and raised_at,
    # joined by a colon.
    value_object "FindingKey" do
      attribute :value, String
      invariant("a corrective action names its finding") { !value.to_s.empty? }
    end

    # The identifier of the Work row this action started, when one was started for it.
    value_object "WorkKey" do
      attribute :value, String
    end

    # Started is the only state the model declares for now.
    value_object "ActionState" do
      attribute :value, String
      invariant("an action has a state") { !value.to_s.empty? }
    end

    command "Start" do
      role "System"
      goal "Begin the corrective action an accepted finding leads to"

      sets :finding
      sets :work
      sets :state, to: "started"

      emits CorrectiveActionStarted
    end
  end

  policy "StartWhenAccepted" do
    on      "Finding.FindingAccepted"
    trigger CorrectiveAction::Start, with: { finding: :id }
  end
end
