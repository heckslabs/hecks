# PipelineBoard: the pipeline from coding to release, read live and shown on one local page. The
# read side is queries, each answered by an adapter behind a port: GitHub for the CI runs, Git
# for local main and the train, Tickets for the Work items, Jobs for the sessions, Journal for the
# events the tooling recorded. The bluebook names the questions and never fetches, shells out or
# opens a file.
#
# The commands are `Serve` and `Act`. `Serve` opens the page on 127.0.0.1 and answers `GET /` and
# `GET /api/state` until it is stopped. `Act` is the page's one way to change anything: `POST
# /api/act` runs one of the steps in the `ActionRule` rows (answer a blocked session, reply, check
# in, tidy, discard, board a train, promote), and a step that moves code runs only once confirmed.
# Every other request only reads. A read that fails is a `Stage` or a `Reading` in state `unknown`
# with the reason as its note, and leaves the others alone.
#
# What the board says is decided here, not in its adapters. The `Verdict` rows say which state a
# stage or a tile is in, the `Setting` rows hold the numbers those rules compare with, the
# `Finding` rows name what the fan-out can flag, and the `ActionRule` rows say what each step needs
# and what it runs. The adapters read the rows and fetch, shape and draw; they decide nothing.
#
#   exe/hecks PipelineBoard.serve! port.value=4747 --wait
#
# From the Hecks domain, `Board.serve` asks for the same board through `ServeWhenBoardRequested`. It
# runs in the Hecks registry, so the wiring page shows every bluebook attached to Hecks.
#
#   exe/hecks Board.serve! port.value=4747 --wait

Hecks.bluebook "PipelineBoard" do
  vision "The pipeline from a Work item to a release is read live, stage by stage, and shown with the real events it emitted."

  supporting

  # The board. One run of it is one server opened on a local port, until it is stopped.
  aggregate "PipelineBoard" do
    description "The pipeline's stages, CI runs, work, sessions and events as they stand, and one server that shows them."

    identified_by :run

    attribute :run,  RunKey
    attribute :port, Port, optional: true
    attribute :last, Reason, optional: true

    value_object "RunKey" do
      attribute :value, String, matches: :present
    end

    # A local port the page is served on.
    value_object "Port" do
      attribute :value, Integer, default: 4747

      invariant("a port is 1024 to 65535") { value >= 1024 && value <= 65535 }
    end

    # Why a server ended or was refused.
    value_object "Reason" do
      attribute :value, String, matches: :present
    end

    # A text drawn for a terminal: the panel (`Snapshot`) or one turn's block (`TurnBlock`). Never
    # JSON: every other query answers rows of a value object declared here, and the runtime
    # refuses an adapter's answer that is not that shape.
    value_object "Document" do
      attribute :text, String
    end

    # One number the board shows, under one key, read once. `state` is decided by a `Verdict` row
    # and never by an adapter; a read that failed is a `Reading` in state `unknown` with the
    # reason as its `note`. `source` is the port it came from and `fresh_at` when it was read.
    value_object "Reading" do
      attribute :key,      String, matches: :present
      attribute :label,    String
      attribute :value,    String, default: ""
      attribute :unit,     String, default: ""
      attribute :state,    String
      attribute :note,     String, default: ""
      attribute :since,    String, default: ""
      attribute :link,     String, default: ""
      attribute :source,   String, default: ""
      attribute :fresh_at, String, default: ""

      invariant("a reading's state is ok, attention, failed, working or unknown") do
        state == "ok" || state == "attention" || state == "failed" || state == "working" || state == "unknown"
      end
    end

    # One node of the strip: a `Reading` and where it stands, left to right. The strip is as long
    # as what is read: no number of stages is fixed.
    value_object "Stage" do
      attribute :key,      String, matches: :present
      attribute :label,    String
      attribute :value,    String, default: ""
      attribute :unit,     String, default: ""
      attribute :state,    String
      attribute :note,     String, default: ""
      attribute :since,    String, default: ""
      attribute :link,     String, default: ""
      attribute :source,   String, default: ""
      attribute :fresh_at, String, default: ""
      attribute :order,    Integer

      invariant("a stage's state is ok, attention, failed, working or unknown") do
        state == "ok" || state == "attention" || state == "failed" || state == "working" || state == "unknown"
      end
    end

    # One thing the pipeline is stuck on: `kind` is a `StuckKind`, `group` the group that row
    # gives it, `waits_on` who it waits on where that is known, and `owner_run` the run that owns it.
    value_object "StuckItem" do
      attribute :kind,      String
      attribute :group,     String, default: ""
      attribute :what,      String
      attribute :since,     String, default: ""
      attribute :waits_on,  String, default: ""
      attribute :waits_on_kind, String, default: ""
      attribute :owner_run, String, default: ""
      attribute :link,      String, default: ""
    end

    # The kinds of stuck item and the group the board sorts each into: `waiting on a person` or
    # `standing too long`. `waits_on` is who a kind always waits on; where it is empty the item
    # says it itself (a blocked run's `Session owner` word) or names only its `owner_run`.
    value_object "StuckKind" do
      attribute :kind,          String
      attribute :group,         String
      attribute :waits_on,      String
      attribute :waits_on_kind, String, default: ""
      attribute :mark,          String, default: ""
      attribute :judged_by,     String, default: ""
      attribute :asked_of,      String, default: ""
      attribute :says,          String, default: ""

      member kind: "owner_ask",          group: "waiting on a person", waits_on: "owner",        waits_on_kind: "person", mark: "owner_ask_minutes",         judged_by: "Owner ask age",         asked_of: "AgentRun.Running",    says: "a question put to the owner: %{what}"
      member kind: "blocked_run",        group: "waiting on a person", waits_on: "orchestrator", waits_on_kind: "role",   mark: "session_bound_minutes",     judged_by: "Blocked session age",   asked_of: "AgentRun.Running",    says: "a blocked session awaits a reply: %{what}"
      member kind: "approval_awaited",   group: "waiting on a person", waits_on: "owner",        waits_on_kind: "person", mark: "approval_awaited_minutes",  judged_by: "Approval age",          asked_of: "Finding.Open",        says: "an approval only the owner can give: %{what}"
      member kind: "red_main_given_up",  group: "waiting on a person", waits_on: "owner",        waits_on_kind: "person", mark: "",                          judged_by: "",                      asked_of: "RedEpisode.Standing", says: "red main, and the pipeline has given up on it: %{what}"
      member kind: "red_main",           group: "standing too long",   waits_on: "orchestrator", waits_on_kind: "role",   mark: "red_main_minutes",          judged_by: "Red main age",          asked_of: "RedEpisode.Standing", says: "red main past its mark: %{what}"
      member kind: "stalled_session",    group: "standing too long",   waits_on: "orchestrator", waits_on_kind: "role",   mark: "session_idle_seconds",      judged_by: "Session idle",          asked_of: "AgentRun.Running",    says: "a session with no word: %{what}"
      member kind: "train_blocked",      group: "standing too long",   waits_on: "orchestrator", waits_on_kind: "role",   mark: "train_pr_left_minutes",     judged_by: "Train PR age",          asked_of: "GitHub.TrainPrs",     says: "a train pull request left for a hand: %{what}"
      member kind: "stopped_run",        group: "standing too long",   waits_on: "orchestrator", waits_on_kind: "role",   mark: "stopped_run_overdue_hours", judged_by: "Stopped run age",       asked_of: "Finding.Stopped",     says: "a stopped run nobody picked up: %{what}"
      member kind: "epic_held",          group: "standing too long",   waits_on: "product owner", waits_on_kind: "role",  mark: "epic_hold_minutes",         judged_by: "Epic hold age",         asked_of: "Epic.Held",           says: "an epic past its hold: %{what}"
      member kind: "planned_idle",       group: "standing too long",   waits_on: "orchestrator", waits_on_kind: "role",   mark: "planned_idle_minutes",      judged_by: "Planned idle age",      asked_of: "Roll.Report",         says: "planned work not started: %{what}"
    end

    # What the pipeline would start next: a planned Work item the fill's last report names.
    value_object "NextStart" do
      attribute :slug,  String
      attribute :title, String, default: ""
    end

    # Whether work is flowing: `admission` by the `Admission` rows with its reason, what the fill
    # would start, and the `Train glance` rows' word for the open train pull requests.
    value_object "Flow" do
      attribute :admission,     String
      attribute :admission_why, String, default: ""
      attribute :next_start,    list_of(NextStart)
      attribute :train_state,   String
      attribute :train_why,     String, default: ""
    end

    # The two questions asked first: `entries` is what needs a person (group `waiting on a person`)
    # or stands too long (group `standing too long`), each with who it waits on, and `flowing` is
    # whether work is moving. The `StuckKind` rows say which kinds are members and how each reads.
    value_object "Glance" do
      attribute :entries, list_of(StuckItem)
      attribute :flowing, Flow
    end

    # One run: its role, session and condition, the Work item it holds, the seconds since its
    # session last wrote its state, and its last word (the verdict of its newest finished turn).
    value_object "RunCard" do
      attribute :run,          String
      attribute :role,         String, default: ""
      attribute :session,      String, default: ""
      attribute :condition,    String, default: ""
      attribute :work_item,    String, default: ""
      attribute :idle_seconds, Integer, default: 0
      attribute :last_word,    String, default: ""
      attribute :link,         String, default: ""
    end

    # The open train pull request: its checks counted, its red jobs by name.
    value_object "TrainCard" do
      attribute :pr,         Integer, default: 0
      attribute :head_sha,   String, default: ""
      attribute :commits,    Integer, default: 0
      attribute :green,      Integer, default: 0
      attribute :red,        Integer, default: 0
      attribute :skipped,    Integer, default: 0
      attribute :red_jobs,   String, default: ""
      attribute :auto_merge, String, default: ""
      attribute :age,        String, default: ""
      attribute :state,      String, default: "unknown"
      attribute :superseded, String, default: ""
    end

    # The release as it stands: the latest tag, the version the next one takes and what holds it.
    value_object "ReleaseCard" do
      attribute :latest_tag,                String, default: ""
      attribute :next_version,              String, default: ""
      attribute :changelog_heading,         String, default: ""
      attribute :stable_has_version_commit, String, default: ""
      attribute :holds,                     String, default: ""
    end

    # One recorded event: when, which aggregate and record, and the policies that reacted.
    value_object "EventLine" do
      attribute :at,        String, default: ""
      attribute :aggregate, String, default: ""
      attribute :id,        String, default: ""
      attribute :name,      String
      attribute :source,    String, default: ""
      attribute :reactions, String, default: ""
    end

    # One CI run as the CI records hold it: `event` is `push` for main, `pull_request` for a train.
    value_object "CiRun" do
      attribute :id,           Integer, default: 0
      attribute :sha,          String
      attribute :started,      String, default: ""
      attribute :status,       String, default: ""
      attribute :conclusion,   String, default: ""
      attribute :pushed,       String, default: ""
      attribute :url,          String, default: ""
      attribute :event,        String, default: ""
      attribute :failed_jobs,  Integer, default: 0
      attribute :wall_minutes, Float, default: 0.0
    end

    # One job of a CI run and the minutes it took.
    value_object "JobTime" do
      attribute :name,       String
      attribute :minutes,    Float, default: 0.0
      attribute :conclusion, String, default: ""
    end

    # One flake: a job or spec file an earlier attempt of a run failed and a later one passed,
    # how many runs it flaked in and their branches, and how far back the runs read reach.
    value_object "Flake" do
      attribute :item,         String
      attribute :kind,         String, default: ""
      attribute :count,        Integer
      attribute :branches,     String, default: ""
      attribute :reaches_back, String, default: ""
      attribute :unreadable,   Integer, default: 0
    end

    # One undone Work item as the plan shows it.
    value_object "WorkLine" do
      attribute :slug,           String
      attribute :status,         String, default: ""
      attribute :title,          String, default: ""
      attribute :area,           list_of(String)
      attribute :claimed_by,     String, default: ""
      attribute :claimed_at,     String, default: ""
      attribute :priority,       String, default: ""
      attribute :category,       String, default: ""
      attribute :epic,           String, default: ""
      attribute :budget_minutes, Integer, default: 0
      attribute :yield_count,    Integer, default: 0
      attribute :reason,         String, default: ""
      attribute :step,           String, default: ""
      attribute :decision,       String, default: ""
    end

    # One dispatched session: its status by the `Session status` rows, the job's own state, the
    # run and Work item it holds and the seconds since its job last wrote.
    value_object "SessionLine" do
      attribute :id,            String
      attribute :name,          String, default: ""
      attribute :status,        String, default: ""
      attribute :state,         String, default: ""
      attribute :detail,        String, default: ""
      attribute :started,       String, default: ""
      attribute :ended,         String, default: ""
      attribute :idle_seconds,  Integer, default: 0
      attribute :work_item,     String, default: ""
      attribute :run,           String, default: ""
      attribute :repo,          String, default: ""
      attribute :agent,         String, default: ""
      attribute :works_as,      String, default: ""
      attribute :superseded_by, String, default: ""
      attribute :parent,        String, default: ""
      attribute :question_kind, String, default: ""
    end

    # One Work item's cycle: its seconds so far, each stage's seconds in order as words, and the
    # stage still open while the item is in flight.
    value_object "Cycle" do
      attribute :work,    String
      attribute :started, String, default: ""
      attribute :seconds, Integer, default: 0
      attribute :open,    String, default: ""
      attribute :stages,  String, default: ""
    end

    # Why nothing is starting, one row per state of the `Idle reason` verdict: the words that state
    # says, and the setting or switch that governs it.
    value_object "IdleReason" do
      attribute :state,       String
      attribute :says,        String
      attribute :governed_by, String, default: ""

      member state: "admission closed",   says: "nothing started for %{minutes} min: %{what} held by %{why}", governed_by: "the Admission rows; the load guard limit"
      member state: "every item skipped", says: "nothing started for %{minutes} min: %{what} held by %{why}", governed_by: "the fill's skip reasons; session_cap"
      member state: "nothing planned",    says: "nothing started for %{minutes} min: no planned Work item",     governed_by: "the Work queue"
      member state: "unknown",            says: "nothing started for %{minutes} min: the fill was not read",    governed_by: "fill_stale_minutes"
      member state: "starting",           says: "",                                                              governed_by: ""
    end

    # Landings in one window: how many and the rate per hour; `since` is when the window opens.
    value_object "Throughput" do
      attribute :window,   String
      attribute :since,    String, default: ""
      attribute :landings, Integer, default: 0
      attribute :per_hour, String, default: ""
    end

    # One started Work item: its stage of the cycle, minutes in it, and its session's state.
    value_object "StatusItem" do
      attribute :work,          String
      attribute :title,         String, default: ""
      attribute :epic,          String, default: ""
      attribute :tier,          String, default: ""
      attribute :priority,      String, default: ""
      attribute :stage,         String, default: ""
      attribute :minutes,       Integer, default: 0
      attribute :session_state, String, default: ""
    end

    # One blocked run: minutes blocked, the first line of its question and its kind (`owner`, `choose`, `review`).
    value_object "StatusBlock" do
      attribute :run,        String
      attribute :minutes,    Integer, default: 0
      attribute :first_line, String, default: ""
      attribute :kind,       String, default: ""
    end

    # The pipeline's status as one read: why nothing starts (first line, its reading's source and the
    # governing setting), the throughput windows, each started Work item and each blocked run.
    value_object "Status" do
      attribute :why_idle,    String, default: ""
      attribute :why_source,  String, default: ""
      attribute :governed_by, String, default: ""
      attribute :throughput,  list_of(Throughput)
      attribute :items,       list_of(StatusItem)
      attribute :blocked,     list_of(StatusBlock)
    end

    # One run the MainIntegration saga remembers: `parked` is `yes` for one that waits on a person.
    value_object "IntegrationRun" do
      attribute :landed,  String
      attribute :stage,   String
      attribute :at,      String, default: ""
      attribute :minutes, Integer, default: 0
      attribute :parked,  String, default: ""
    end

    # One edge of the wiring: `kind` is `policy`, `ask` or `adapter`, and `label` the policy.
    value_object "WiringEdge" do
      attribute :from,  String
      attribute :to,    String
      attribute :label, String, default: ""
      attribute :kind,  String
    end

    # The board's whole read model, as the page, the text panel and the MCP door render it.
    # `stale_seconds` is the age of the read it holds. Every number is one `Reading` or `Stage`.
    value_object "Snapshot" do
      attribute :generated_at,  String
      attribute :stale_seconds, Integer, default: 0
      attribute :stages,        list_of(Stage)
      attribute :readings,      list_of(Reading)
      attribute :stuck,         list_of(StuckItem)
      attribute :roles,         list_of(Reading)
      attribute :runs,          list_of(RunCard)
      attribute :train,         list_of(TrainCard)
      attribute :release,       ReleaseCard
      attribute :events,        list_of(EventLine)
      attribute :signal,        Reading
      attribute :deciding,      String, default: ""
      attribute :fill_why,      list_of(FillWhy)
      attribute :red_episodes,  list_of(RedEpisodeLine)
      attribute :measures,      list_of(Reading)
      attribute :epics,         list_of(Reading)
      attribute :holds,         list_of(Reading)
    end

    # The words of Signalbox's one signal, a band each, and the state the strip draws it in. `load`
    # is the 1-minute load, `mark` Signalbox's short mark as a load (never the Tickets
    # dispatch_max_load), `since` when the band was entered.
    value_object "SignalSays" do
      attribute :band,  String
      attribute :says,  String
      attribute :state, String

      member band: "normal", says: "Clear: admitting, load %{load} of %{mark}",                       state: "ok"
      member band: "tight",  says: "Tight: admitting with care, load %{load} of %{mark}",             state: "attention"
      member band: "short",  says: "Danger: not admitting since %{since}, load short (%{load} of %{mark})", state: "failed"
      member band: "dark",   says: "Dark: no signal; the dispatch's own limit holds",                 state: "unknown"
    end

    # The state a measure or an epic's last reading is drawn in.
    value_object "OutcomeState" do
      attribute :outcome, String
      attribute :state,   String

      member outcome: "met",      state: "ok"
      member outcome: "missed",   state: "attention"
      member outcome: "unread",   state: "unknown"
      member outcome: "unstated", state: "unknown"
    end

    # Which side is deciding the fill, in its own words: admission while `admission.signalbox` is on,
    # the old dispatch (cap, load limit, reserve) while it is off. `%{why}` is the skip reason.
    value_object "FillSide" do
      attribute :side,        String
      attribute :says,        String
      attribute :governed_by, String

      member side: "admission", says: "Admission (Signalbox) is deciding: %{why}",        governed_by: "admission.signalbox on; the Admission rows"
      member side: "dispatch",  says: "The dispatch is deciding: %{why}",                 governed_by: "work_limit.cap, dispatch_max_load.limit, the red reserve"
    end

    # One Work item the fill did not start, and why, in the words of the side deciding.
    value_object "FillWhy" do
      attribute :work,   String
      attribute :reason, String
      attribute :side,   String, default: ""
    end

    # One stretch of red main, one line: when it began (UTC), how many minutes it lasted or has
    # stood, the culprit commit, its Work item and how it ended (`standing` while it has not).
    value_object "RedEpisodeLine" do
      attribute :began,    String
      attribute :minutes,  Integer, default: 0
      attribute :culprit,  String, default: ""
      attribute :work,     String, default: ""
      attribute :ending,   String, default: "standing"
      attribute :line,     String, default: ""
    end

    # How many columns a text panel is drawn in.
    value_object "Width" do
      attribute :value, Integer, default: 80
    end

    # Whether a text panel is coloured: `true` or `false`.
    value_object "Colour" do
      attribute :value, String, default: "false"
    end

    # How many results a query answers, at most.
    value_object "Limit" do
      attribute :value, Integer, default: 20
    end

    # One condition of a rule that names a state. Rows of one `stage` that share a `position` are
    # one rule: every condition must hold. The rules of a stage are tried in `position` order and
    # the first that holds names the state; `always` holds for any reading. `measure` names a number
    # the adapter read; `than` is a number or the name of a `Setting` (or a push limit); `scale`
    # multiplies it. `missing` holds when the adapter could not read the measure.
    value_object "Verdict" do
      attribute :stage,    String
      attribute :position, Integer
      attribute :measure,  String
      attribute :op,       String
      attribute :than,     String
      attribute :scale,    Integer, default: 1
      attribute :state,    String

      # ---- the strip: one stage each, left to right ----
      # The open findings of stopped runs that have waited on a person past
      # `stopped_run_overdue_hours`: first in the strip, ahead of the red flag.
      member stage: "Overdue for you", position: 1, measure: "",        op: "always",  than: "",  scale: 1, state: "failed"
      member stage: "Red flag",   position: 1, measure: "",             op: "always",  than: "",  scale: 1, state: "failed"
      # The open findings stopped integration runs and shipments filed; the row is only built
      # while one is open. A log of stops, not a count of runs stopped now.
      member stage: "Stopped runs", position: 1, measure: "",           op: "always",  than: "",  scale: 1, state: "attention"

      member stage: "Work items", position: 1, measure: "started",      op: ">",       than: "0", scale: 1, state: "working"
      member stage: "Work items", position: 2, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      member stage: "Sessions",   position: 1, measure: "blocked",      op: ">",       than: "0", scale: 1, state: "attention"
      member stage: "Sessions",   position: 2, measure: "busy",         op: ">",       than: "0", scale: 1, state: "working"
      member stage: "Sessions",   position: 3, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      # Signalbox's signal: `short` is 1 while it says the machine is short of room, 0 while it
      # says there is room, and unread while the signal does not drive.
      member stage: "Signal",     position: 1, measure: "short",        op: "missing", than: "",  scale: 1, state: "unknown"
      member stage: "Signal",     position: 2, measure: "short",        op: ">",       than: "0", scale: 1, state: "attention"
      member stage: "Signal",     position: 3, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      # The last fill: the seats left under the cap, unread when no fill has reported them.
      member stage: "Fill",       position: 1, measure: "headroom",     op: "missing", than: "",  scale: 1, state: "unknown"
      # A report older than `fill_stale_minutes` says what the queue was, not what it is.
      member stage: "Fill",       position: 2, measure: "age_minutes",  op: ">",       than: "fill_stale_minutes", scale: 1, state: "attention"
      member stage: "Fill",       position: 3, measure: "headroom",     op: "<=",      than: "0", scale: 1, state: "attention"
      member stage: "Fill",       position: 4, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      # Whether the last fill's report is marked stale on the page, by the minutes since it ran.
      # A report that states no time is not marked.
      member stage: "Fill age",   position: 1, measure: "age_minutes",  op: ">",       than: "fill_stale_minutes", scale: 1, state: "stale"
      member stage: "Fill age",   position: 2, measure: "",             op: "always",  than: "",  scale: 1, state: "current"

      member stage: "Local main", position: 1, measure: "ahead",        op: ">",       than: "0", scale: 1, state: "attention"
      member stage: "Local main", position: 2, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      # The runs of the MainIntegration saga. A run parked for a person fails the stage; any
      # other stage a run is stored in is shown as it is and judged by nothing here.
      member stage: "Integration", position: 1, measure: "needs_human", op: "missing", than: "",  scale: 1, state: "unknown"
      member stage: "Integration", position: 2, measure: "needs_human", op: ">",       than: "0", scale: 1, state: "failed"
      member stage: "Integration", position: 3, measure: "",            op: "always",  than: "",  scale: 1, state: "ok"

      member stage: "Train",      position: 1, measure: "not_pushed",   op: ">",       than: "0", scale: 1, state: "attention"
      member stage: "Train",      position: 2, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      member stage: "CI",         position: 1, measure: "running",      op: ">",       than: "0", scale: 1, state: "working"
      member stage: "CI",         position: 2, measure: "unsuccessful", op: ">",       than: "0", scale: 1, state: "failed"
      member stage: "CI",         position: 3, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      member stage: "Promote",    position: 1, measure: "behind",       op: ">",       than: "0", scale: 1, state: "attention"
      member stage: "Promote",    position: 2, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      member stage: "Release",    position: 1, measure: "unpublished",  op: ">",       than: "0", scale: 1, state: "attention"
      member stage: "Release",    position: 2, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      # ---- the metric tiles ----
      # The share of CI runs that succeeded: good from `success_good`, fair from `success_fair`.
      member stage: "CI success", position: 1, measure: "value",        op: "missing", than: "",  scale: 1, state: "unknown"
      member stage: "CI success", position: 2, measure: "value",        op: ">=",      than: "success_good", scale: 1, state: "ok"
      member stage: "CI success", position: 3, measure: "value",        op: ">=",      than: "success_fair", scale: 1, state: "attention"
      member stage: "CI success", position: 4, measure: "",             op: "always",  than: "",  scale: 1, state: "failed"

      # The median wall: within the goal is ok, within twice the goal needs attention.
      member stage: "CI wall",    position: 1, measure: "value",        op: "missing", than: "",  scale: 1, state: "unknown"
      member stage: "CI wall",    position: 2, measure: "value",        op: "<=",      than: "wall_goal_minutes", scale: 1, state: "ok"
      member stage: "CI wall",    position: 3, measure: "value",        op: "<=",      than: "wall_goal_minutes", scale: 2, state: "attention"
      member stage: "CI wall",    position: 4, measure: "",             op: "always",  than: "",  scale: 1, state: "failed"

      # Main is red for as long as the latest run is not green; the tile is only built then.
      member stage: "Main red",   position: 1, measure: "",             op: "always",  than: "",  scale: 1, state: "failed"

      member stage: "Failed jobs on head", position: 1, measure: "failed_jobs", op: ">", than: "0", scale: 1, state: "failed"
      member stage: "Failed jobs on head", position: 2, measure: "",    op: "always",  than: "",  scale: 1, state: "ok"

      # Unpushed commits nudge at the QualityControl world's push limits (`commits`, `hours`).
      member stage: "Commits not pushed", position: 1, measure: "ahead",     op: ">=",     than: "commits", scale: 1, state: "attention"
      member stage: "Commits not pushed", position: 2, measure: "age_hours", op: ">=",     than: "hours",   scale: 1, state: "attention"
      member stage: "Commits not pushed", position: 3, measure: "",          op: "always", than: "",        scale: 1, state: "ok"

      # Dispatched sessions press at the cap, or when any session waits on a person.
      member stage: "Dispatched sessions", position: 1, measure: "dispatched", op: ">=",     than: "session_cap", scale: 1, state: "attention"
      member stage: "Dispatched sessions", position: 2, measure: "blocked",    op: ">",      than: "0",           scale: 1, state: "attention"
      member stage: "Dispatched sessions", position: 3, measure: "",           op: "always", than: "",            scale: 1, state: "ok"

      # Work finished stalls when nothing finished in the window while Work items wait in the plan.
      member stage: "Work finished", position: 1, measure: "finished", op: "<=",     than: "0", scale: 1, state: "attention"
      member stage: "Work finished", position: 1, measure: "planned",  op: ">",      than: "0", scale: 1, state: "attention"
      member stage: "Work finished", position: 2, measure: "",         op: "always", than: "",  scale: 1, state: "ok"

      # Open pull requests need attention once the oldest has waited `open_pr_stale_hours`.
      member stage: "Open PRs", position: 1, measure: "oldest_hours", op: ">=",     than: "open_pr_stale_hours", scale: 1, state: "attention"
      member stage: "Open PRs", position: 2, measure: "",             op: "always", than: "",                    scale: 1, state: "ok"

      # The daily health line's tile counts what only the events show (the `counted` checks):
      # anything found needs attention.
      member stage: "Pipeline health", position: 1, measure: "found", op: "missing", than: "",  scale: 1, state: "unknown"
      member stage: "Pipeline health", position: 2, measure: "found", op: ">",       than: "0", scale: 1, state: "attention"
      member stage: "Pipeline health", position: 3, measure: "",      op: "always",  than: "",  scale: 1, state: "ok"

      # A number with no bound of its own (commit to green CI, landed to pushed, the latest
      # release's age): it is read, or it is not.
      member stage: "Read", position: 1, measure: "value", op: "missing", than: "", scale: 1, state: "unknown"
      member stage: "Read", position: 2, measure: "",      op: "always",  than: "", scale: 1, state: "ok"

      # The room left on the disk, in gigabytes: failed at `disk_failed_gb` or less, attention at
      # `disk_attention_gb` or less. The Hecks world's `disk_health` line overrides both.
      member stage: "Disk free", position: 1, measure: "free_gb", op: "missing", than: "",                  scale: 1, state: "unknown"
      member stage: "Disk free", position: 2, measure: "free_gb", op: "<=",      than: "disk_failed_gb",    scale: 1, state: "failed"
      member stage: "Disk free", position: 3, measure: "free_gb", op: "<=",      than: "disk_attention_gb", scale: 1, state: "attention"
      member stage: "Disk free", position: 4, measure: "",        op: "always",  than: "",                  scale: 1, state: "ok"

      # The launcher's boot hours today as a percent of the day's budget (`share`, unread when no
      # budget is set): failed once the budget is spent, attention from `boot_attention_percent`.
      member stage: "Boot hours", position: 1, measure: "share", op: "missing", than: "",                       scale: 1, state: "ok"
      member stage: "Boot hours", position: 2, measure: "share", op: ">=",      than: "100",                    scale: 1, state: "failed"
      member stage: "Boot hours", position: 3, measure: "share", op: ">=",      than: "boot_attention_percent", scale: 1, state: "attention"
      member stage: "Boot hours", position: 4, measure: "",      op: "always",  than: "",                       scale: 1, state: "ok"

      # A live session whose job has written nothing for `session_idle_seconds` has stalled.
      member stage: "Session idle", position: 1, measure: "idle_seconds", op: "missing", than: "",                     scale: 1, state: "unknown"
      member stage: "Session idle", position: 2, measure: "idle_seconds", op: ">",       than: "session_idle_seconds", scale: 1, state: "attention"
      member stage: "Session idle", position: 3, measure: "",             op: "always",  than: "",                     scale: 1, state: "working"

      # An open train pull request, by its checks: any red fails it, any still going is working.
      member stage: "Train PR", position: 1, measure: "red",     op: ">",      than: "0", scale: 1, state: "failed"
      member stage: "Train PR", position: 2, measure: "pending", op: ">",      than: "0", scale: 1, state: "working"
      member stage: "Train PR", position: 3, measure: "",        op: "always", than: "",  scale: 1, state: "ok"

      # A role, by its live sessions.
      member stage: "Role", position: 1, measure: "live", op: "missing", than: "",  scale: 1, state: "unknown"
      member stage: "Role", position: 2, measure: "live", op: ">",       than: "0", scale: 1, state: "working"
      member stage: "Role", position: 3, measure: "",     op: "always",  than: "",  scale: 1, state: "ok"

      # ---- a session's status, from what its job and `claude agents` say ----
      # `waiting` is 1 when the job says blocked and is listed or recently written; `needs` is 1
      # when the job set `needs`, which is how it says it waits on a person. A session paused on a
      # push or CI is still working, so it is busy, not blocked.
      # One open stopped run's finding, by the hours since it was reported: overdue past the bound,
      # open otherwise and when its report time could not be read.
      member stage: "Stopped run age", position: 1, measure: "hours", op: ">",    than: "stopped_run_overdue_hours", scale: 1, state: "overdue"
      member stage: "Stopped run age", position: 2, measure: "",      op: "always", than: "", scale: 1, state: "open"

      # ---- how long each kind of stuck item may stand: `age_minutes` is the minutes since it began ----
      # A red main has stood too long once no episode has ended it within `red_main_minutes`.
      member stage: "Red main age", position: 1, measure: "age_minutes", op: "missing", than: "", scale: 1, state: "unknown"
      member stage: "Red main age", position: 2, measure: "age_minutes", op: ">",       than: "red_main_minutes", scale: 1, state: "too long"
      member stage: "Red main age", position: 3, measure: "",            op: "always",  than: "", scale: 1, state: "in time"
      # A train pull request left for a hand stands too long past `train_pr_left_minutes`.
      member stage: "Train PR age", position: 1, measure: "age_minutes", op: "missing", than: "", scale: 1, state: "unknown"
      member stage: "Train PR age", position: 2, measure: "age_minutes", op: ">",       than: "train_pr_left_minutes", scale: 1, state: "too long"
      member stage: "Train PR age", position: 3, measure: "",            op: "always",  than: "", scale: 1, state: "in time"
      # A blocked session awaiting a reply stands too long past `session_bound_minutes`.
      member stage: "Blocked session age", position: 1, measure: "age_minutes", op: "missing", than: "", scale: 1, state: "unknown"
      member stage: "Blocked session age", position: 2, measure: "age_minutes", op: ">",       than: "session_bound_minutes", scale: 1, state: "too long"
      member stage: "Blocked session age", position: 3, measure: "",            op: "always",  than: "", scale: 1, state: "in time"
      # A question put to the owner stands too long past `owner_ask_minutes`.
      member stage: "Owner ask age", position: 1, measure: "age_minutes", op: "missing", than: "", scale: 1, state: "unknown"
      member stage: "Owner ask age", position: 2, measure: "age_minutes", op: ">",       than: "owner_ask_minutes", scale: 1, state: "too long"
      member stage: "Owner ask age", position: 3, measure: "",            op: "always",  than: "", scale: 1, state: "in time"
      # An approval awaited stands too long past `approval_awaited_minutes`.
      member stage: "Approval age", position: 1, measure: "age_minutes", op: "missing", than: "", scale: 1, state: "unknown"
      member stage: "Approval age", position: 2, measure: "age_minutes", op: ">",       than: "approval_awaited_minutes", scale: 1, state: "too long"
      member stage: "Approval age", position: 3, measure: "",            op: "always",  than: "", scale: 1, state: "in time"
      # An epic stands too long past its hold after `epic_hold_minutes`; the hold's age is Tickets' to answer.
      member stage: "Epic hold age", position: 1, measure: "age_minutes", op: "missing", than: "", scale: 1, state: "unknown"
      member stage: "Epic hold age", position: 2, measure: "age_minutes", op: ">",       than: "epic_hold_minutes", scale: 1, state: "too long"
      member stage: "Epic hold age", position: 3, measure: "",            op: "always",  than: "", scale: 1, state: "in time"
      # A Work item planned but not started while places are free stands too long past `planned_idle_minutes`.
      member stage: "Planned idle age", position: 1, measure: "age_minutes", op: "missing", than: "", scale: 1, state: "unknown"
      member stage: "Planned idle age", position: 2, measure: "age_minutes", op: ">",       than: "planned_idle_minutes", scale: 1, state: "too long"
      member stage: "Planned idle age", position: 3, measure: "",            op: "always",  than: "", scale: 1, state: "in time"

      # Admission is closed while an Overload stands or the load guard holds, unknown when neither was read.
      member stage: "Admission", position: 1, measure: "standing", op: "missing", than: "",  scale: 1, state: "unknown"
      member stage: "Admission", position: 2, measure: "standing", op: ">",       than: "0", scale: 1, state: "closed"
      member stage: "Admission", position: 3, measure: "",         op: "always",  than: "",  scale: 1, state: "open"

      # The open train pull requests as a whole: any red fails, any pending works, any open is ok, none is idle, unknown when the pull requests were not read.
      member stage: "Train glance", position: 1, measure: "open",    op: "missing", than: "",  scale: 1, state: "unknown"
      member stage: "Train glance", position: 2, measure: "red",     op: ">",      than: "0", scale: 1, state: "failed"
      member stage: "Train glance", position: 3, measure: "pending", op: ">",      than: "0", scale: 1, state: "working"
      member stage: "Train glance", position: 4, measure: "open",    op: ">",      than: "0", scale: 1, state: "ok"
      member stage: "Train glance", position: 5, measure: "",        op: "always", than: "",  scale: 1, state: "idle"

      # Why nothing is starting, by the first rule that holds: admission closed, every planned item skipped,
      # nothing planned, else the fill is starting work. `standing` counts the overloads and the load guard.
      member stage: "Idle reason", position: 1, measure: "standing", op: ">",       than: "0", scale: 1, state: "admission closed"
      member stage: "Idle reason", position: 2, measure: "would",    op: ">",       than: "0", scale: 1, state: "starting"
      member stage: "Idle reason", position: 3, measure: "skipped",  op: ">",       than: "0", scale: 1, state: "every item skipped"
      member stage: "Idle reason", position: 4, measure: "planned",  op: "missing", than: "",  scale: 1, state: "unknown"
      member stage: "Idle reason", position: 5, measure: "",         op: "always",  than: "",  scale: 1, state: "nothing planned"

      member stage: "Session status", position: 1, measure: "waiting", op: ">",      than: "0", scale: 1, state: "blocked"
      member stage: "Session status", position: 1, measure: "needs",   op: ">",      than: "0", scale: 1, state: "blocked"
      member stage: "Session status", position: 2, measure: "waiting", op: ">",      than: "0", scale: 1, state: "busy"
      member stage: "Session status", position: 3, measure: "busy",    op: ">",      than: "0", scale: 1, state: "busy"
      member stage: "Session status", position: 4, measure: "failed",  op: ">",      than: "0", scale: 1, state: "failed"
      member stage: "Session status", position: 5, measure: "",        op: "always", than: "",  scale: 1, state: "done"

      # ---- who a blocked session waits on ----
      # Only a session that asks the owner (`asked`: an open "needs an answer" Work item names its
      # run, or its latest message begins with [owner]) is the owner's to answer. A session of
      # another repository, or whose Work item has finished, is not the pipeline's to list. The
      # rest are shown for what they are, never as waiting on the owner.
      member stage: "Session owner", position: 1, measure: "other_repo", op: ">",      than: "0", scale: 1, state: "other repo"
      member stage: "Session owner", position: 2, measure: "finished",   op: ">",      than: "0", scale: 1, state: "finished leftover"
      member stage: "Session owner", position: 3, measure: "blocked",    op: "<=",     than: "0", scale: 1, state: "running"
      member stage: "Session owner", position: 4, measure: "asked",      op: ">",      than: "0", scale: 1, state: "owner"
      member stage: "Session owner", position: 5, measure: "review",     op: ">",      than: "0", scale: 1, state: "waiting on a review verdict"
      member stage: "Session owner", position: 6, measure: "",           op: "always", than: "",  scale: 1, state: "stranded run"

      # A call for help is the owner's to see at once when its help is the owner's, any other
      # once its block has stood `help_unanswered_minutes`, never when its opening time could
      # not be read. The owner is shown a line, never sent anything.
      member stage: "Help owner", position: 1, measure: "owner_role", op: ">",      than: "0", scale: 1, state: "owner"
      member stage: "Help owner", position: 2, measure: "minutes",    op: ">=",     than: "help_unanswered_minutes", scale: 1, state: "owner"
      member stage: "Help owner", position: 3, measure: "",           op: "always", than: "",  scale: 1, state: "with a helper"
    end

    # A number a rule compares with. A QualityControl world's `ci_health` verb overrides the CI
    # ones; its `push_nudge` verb sets the push limits the unpushed-commits rule reads.
    value_object "Setting" do
      attribute :name,  String
      attribute :value, Integer

      member name: "wall_goal_minutes",       value: 3
      member name: "success_good",            value: 80
      member name: "success_fair",            value: 50
      member name: "session_cap",             value: 10
      member name: "throughput_window_hours", value: 24
      member name: "session_fresh_seconds",   value: 600
      member name: "session_window_hours",    value: 24
      member name: "open_pr_stale_hours",     value: 24
      # Minutes after which the last fill's report is stale. A rolling fill records one every few
      # minutes, so a quarter of an hour without one means the rolls have stopped reporting.
      member name: "fill_stale_minutes",      value: 15
      member name: "cycle_items",             value: 20
      member name: "cycle_percentile",        value: 90
      # Hours a run stopped for a person may wait before the board puts it first. It matches the
      # stable lane's `alert_after` (4) on purpose, unlinked: by then a stop has outlived any CI
      # run, queue and verification (about 25 minutes) many times over, and a person's session.
      member name: "stopped_run_overdue_hours", value: 4
      # Marks, in minutes, past which a stuck item has stood too long: a first choice for the owner to turn.
      # A red main is fixed through the train (about 25 minutes, `verify_bound_minutes`): one fix attempt.
      member name: "red_main_minutes",        value: 30
      # Three verification cycles of 25 minutes: a pull request left that long is not on its way.
      member name: "train_pr_left_minutes",   value: 90
      # A question to the owner waits on a person who works in days: eight hours is one working day.
      member name: "owner_ask_minutes",       value: 480
      # An approval is the owner's alone and waits like a question, half a day longer.
      member name: "approval_awaited_minutes", value: 720
      # An epic's hold is a decision to wait, not a stall: three days before it is asked about.
      member name: "epic_hold_minutes",       value: 4320
      # Two missed fill rolls (`fill_stale_minutes` is 15): a planned item left alone this long
      # while places are free was passed over, not queued.
      member name: "planned_idle_minutes",    value: 30
      # Minutes a call for help that is not the owner's stands before the owner is shown it. Two
      # hours is a choice, not a measurement: time for the Lead to assign a helper and for the
      # helper to try. A shorter limit would show calls a helper may still be working on.
      member name: "help_unanswered_minutes", value: 120
      # The bounds of the daily health line. Its day is the last `health_window_hours`. A
      # verification takes about 16 minutes when nothing hangs (the Tickets world's `spec_bounds`),
      # so one past 25 has waited on something. A session left blocked or stopped for an hour waits
      # on nobody who is watching. A finding open two days is not being worked.
      member name: "health_window_hours",     value: 24
      member name: "verify_bound_minutes",    value: 25
      member name: "session_bound_minutes",   value: 60
      member name: "finding_bound_hours",     value: 48
      # The board's one timer, a named safety net: seconds between a recompute of every pushed tile
      # and a heartbeat when no journal line arrived. The board learns of a change from the journal
      # (`events.jsonl`), never from this clock; it only catches a line the file watch missed and
      # tells a dead connection from a quiet one.
      member name: "safety_net_seconds",      value: 300
      # Seconds the board rests after drawing the pushed tiles before it draws them again. It is
      # a gap, not a timer: nothing is drawn unless a journal line marked a tile. A run of lines
      # then costs one drawing, so a busy pipeline costs the board no more than a quiet one.
      member name: "tile_redraw_seconds",     value: 2
      member name: "board_answer_seconds",    value: 10
      member name: "board_stop_grace_seconds", value: 5
      # Seconds a reader keeps an answer before it asks `git`, `gh` or the event stores again.
      # Each is longer than the read period, so a program starts once in that time, not on every
      # read; the stores are kept longest because the event log already says what happened.
      member name: "git_keep_seconds",        value: 60
      member name: "github_keep_seconds",     value: 120
      member name: "stores_keep_seconds",     value: 300
      # Seconds between two looks at the bluebook files for a change of the wiring. Every stream
      # asks on every journal line and a look stats every declaration file, so looks are shared.
      member name: "wiring_look_seconds",     value: 5
      # How many integration runs the Integration tile lists: the runs the event log's tail holds
      # an event of first, newest first, then those parked for a person.
      member name: "integration_runs_shown",  value: 8
      # Gigabytes free on the checkout's volume at which the disk needs attention, and fails.
      member name: "disk_attention_gb",       value: 20
      member name: "disk_failed_gb",          value: 5
      # The percent of the day's boot budget from which the boot hours need attention.
      member name: "boot_attention_percent",  value: 80
      # Seconds a live session's job may write nothing before the session reads as stalled.
      member name: "session_idle_seconds",    value: 900
      # The status read model's throughput windows: the last hour, and the hour of day (Arizona) "today since" counts from.
      member name: "status_hour_minutes",     value: 60
      member name: "status_day_start_hour",   value: 12
    end

    # A project that keeps a board: its name and its checkout beside Hecks, whose local world
    # names its Tickets store (read, never booted). The row with no checkout is the board's own
    # project, shown at `/plan`; `/plan/<name>` shows another's.
    value_object "ProjectBoard" do
      attribute :name,     String
      attribute :checkout, String

      member name: "Hecks",       checkout: ""
      member name: "Shorts",      checkout: "shorts"
      member name: "MietteTools", checkout: "miette_tools"
      member name: "Miette2",     checkout: "miette2"
      member name: "Aayss",       checkout: "aayss"
      member name: "Library",     checkout: "embryonaut_library"
    end

    # A tile the board pushes as HTML, and the aggregates it reads. A journal line carries the
    # aggregate of its event, so any event of a read aggregate makes the server recompute the tile,
    # and a changed render is pushed. A tile names no event: a new event of a read aggregate needs
    # no change here. `reads` lists aggregates by their journal names, separated by a comma.
    value_object "Tile" do
      attribute :tile,  String
      attribute :reads, String

      member tile: "fill",  reads: "Tickets::Work, Hecks::AgentRun, Hecks::Roll, Hecks::Dispatch"
      member tile: "plan",  reads: "Tickets::Work, Tickets::Epic, Hecks::AgentRun, Agents::PlanReview, Hecks::SendTrain, Hecks::Dispatch"
      member tile: "train", reads: "Hecks::SendTrain, Delivery::LinkedTree, Delivery::Landing, Hecks::BoardingRelease, Hecks::PushOutcome"
      member tile: "integration", reads: "Hecks::Integration, Delivery::Landing"
    end

    # One check of the daily health line: what the pipeline reports of its own day, which a person
    # would otherwise find by watching. A check opens at each of its `opens` events in the day and
    # is answered by one of its `closes` events (several are separated by a space) of the same key,
    # as `joins` says: `id` is the event's id, and `<link> <link>` is the opener's first link and
    # the closer's second, compared by their first seven characters (a link of fewer than seven hex
    # characters names no commit and is reported as unreadable). The `test` says what is found:
    # - `unanswered`: no closer at or before the opener.
    # - `over`: the first closer after the opener came later than the `bound` setting, in minutes,
    #   or none has come and the bound has passed.
    # - `stuck`: the newest closer at or before the opener left stuck rows: the parts of its brief
    #   the run named as not delivered.
    # - `aged`: the key is open in the ledger and its opener is older than the `bound`, in hours,
    #   or the event log does not reach back to it.
    # - `left`: a session whose Jobs reading matches one of the `opens` words (`status:blocked`
    #   is the session's status, `state:stopped` its job's state), for longer than the `bound`,
    #   in minutes.
    # `counted` is `yes` for a check only the events show, which the board's tile counts; the
    # sessions and the findings already have their own stage and row.
    value_object "HealthCheck" do
      attribute :kind,    String
      attribute :opens,   String
      attribute :closes,  String
      attribute :joins,   String
      attribute :test,    String
      attribute :bound,   String
      attribute :counted, String
      attribute :says,    String

      member kind: "boarded_by_hand",    opens: "Hecks::SendTrain.BoardingQueued", closes: "Hecks::Integration.MainBoardingStarted",
             joins: "boarded landed", test: "unanswered", bound: "", counted: "yes", says: "boarded by hand"
      member kind: "boarded_unverified", opens: "Hecks::SendTrain.BoardingQueued", closes: "Hecks::Integration.MainVerified",
             joins: "boarded landed", test: "unanswered", bound: "", counted: "yes", says: "boarded unverified"
      member kind: "slow_verification",  opens: "Hecks::Integration.MainVerificationStarted",
             closes: "Hecks::Integration.MainVerified Hecks::Integration.MainVerificationFailed Hecks::Integration.MainVerificationFailedOnce Hecks::Integration.IntegrationSuperseded",
             joins: "id", test: "over", bound: "verify_bound_minutes", counted: "yes", says: "slow verifications"
      member kind: "half_delivered",     opens: "Tickets::Work.WorkFinished", closes: "Agents::Turn.TurnFinished",
             joins: "id", test: "stuck", bound: "", counted: "yes", says: "finished half-delivered"
      member kind: "left_session",       opens: "status:blocked state:stopped", closes: "", joins: "", test: "left", bound: "session_bound_minutes",
             counted: "no", says: "sessions left blocked or stopped"
      member kind: "stale_finding",
             opens: "Tickets::Finding.FindingReported Tickets::Finding.RunFindingReported Tickets::Finding.StoppedRunReported",
             closes: "", joins: "id", test: "aged", bound: "finding_bound_hours", counted: "no", says: "stale findings"
    end

    # One stage of a Work item's cycle, in `position` order. The first stage starts at its `opens`
    # event; every later one starts where the stage before it ended, at its `opens` event. A stage
    # ends at the first of its `closes` events (several are separated by a space) at or after its
    # start that belongs to the item, as `belongs` says:
    # - `item`: its `work` or `branch` link, or its id, is the Work item's key, or its id is that of
    #   the event that started the stage.
    # - `carried`: its `landed` commit was landed (a `Delivery::Landing.BranchLanded` naming that
    #   commit) at or after the item's own landing. Local main is one line, so that commit holds
    #   the item: a verification of a newer landing carries every landing before it.
    # - `after`: any one. Main only moves forward, so what reads or boards main after the stage
    #   started holds the item.
    # Each event is named with the aggregate that emits it. The train's pull request opens when the
    # boarding is queued (`BoardingQueued`) and merges when `SendTrain.Merge` records it
    # (`BranchPushed`, on the same boarding).
    value_object "CycleStage" do
      attribute :stage,    String
      attribute :position, Integer
      attribute :opens,    String
      attribute :closes,   String
      attribute :belongs,  String

      member stage: "queue",        position: 1, opens: "Tickets::Work.WorkPlanned",              closes: "Tickets::Work.WorkStarted",              belongs: "item"
      member stage: "dispatch",     position: 2, opens: "Tickets::Work.WorkStarted",              closes: "Hecks::AgentRun.AgentStarted",           belongs: "item"
      member stage: "planning",     position: 3, opens: "Hecks::AgentRun.AgentStarted",           closes: "Agents::PlanReview.PlanReviewRequested", belongs: "item"
      member stage: "review",       position: 4, opens: "Agents::PlanReview.PlanReviewRequested", closes: "Agents::PlanReview.PlanReviewed",        belongs: "item"
      member stage: "implementing", position: 5, opens: "Agents::PlanReview.PlanReviewed",        closes: "Delivery::Landing.BranchLanded",            belongs: "item"
      member stage: "verify",       position: 6, opens: "Delivery::Landing.BranchLanded",            closes: "Hecks::Integration.MainVerified Hecks::Integration.MainVerificationFailed", belongs: "carried"
      member stage: "boarding",     position: 7, opens: "Hecks::Integration.MainVerified",        closes: "Hecks::SendTrain.BoardingQueued",        belongs: "after"
      member stage: "ci",           position: 8, opens: "Hecks::SendTrain.BoardingQueued",        closes: "Hecks::SendTrain.BranchPushed",          belongs: "item"
      member stage: "sync",         position: 9, opens: "Hecks::SendTrain.BranchPushed",          closes: "Delivery::LinkedTree.MainPulled",           belongs: "after"
    end

    # What the fan-out can flag on a Work item.
    value_object "Finding" do
      attribute :kind,  String
      attribute :means, String

      member kind: "unclaimed", means: "a session runs on a Work item that has no claimed_by"
      member kind: "duplicate", means: "more than one session runs on one Work item"
      member kind: "overlap",   means: "another session works an area that is a path-prefix of this item's area, or the reverse"
      member kind: "landed",    means: "the item already landed but is still planned or started"
    end

    # The statuses a landed Work item should no longer have.
    value_object "StaleStatus" do
      attribute :status, String

      member status: "planned"
      member status: "started"
    end

    # A step the page may take. `needs` are the fields it must send, `confirm` is `yes` for a step
    # that moves code or deletes, `program` is what runs it and `argv` is the command, with
    # `{field}` filled from the request. A step runs only when every field it needs is present.
    # `before` is a launcher command that runs first when it is not empty: an answer first checks
    # the run, so the run records the state the job is in and the answer's own rule can hold.
    # `ended` is the step taken instead when that first command is refused because the run has
    # ended: an answer to a run that finished while its session still waits on a person goes to that
    # session as a reply, which resumes it in place. With no waiting session the step is refused by
    # name, and the page keeps what the person typed.
    value_object "ActionRule" do
      attribute :action,  String
      attribute :needs,   String
      attribute :confirm, String
      attribute :program, String
      attribute :argv,    String
      attribute :before,  String, default: ""
      attribute :ended,   String, default: ""

      member action: "answer",      needs: "target text",          confirm: "no",  program: "exe/hecks", argv: "AgentRun.answer! to={target} answer.value={text} --wait", before: "AgentRun.check! to={target} --wait", ended: "reply"
      member action: "reply",       needs: "target text",          confirm: "no",  program: "claude",    argv: "attach {attach}"
      member action: "auto_reply",  needs: "target",               confirm: "no",  program: "exe/hecks", argv: ""
      member action: "board_train", needs: "",                     confirm: "yes", program: "exe/hecks", argv: "SendTrain.board! --confirm"
      member action: "promote",     needs: "",                     confirm: "yes", program: "exe/hecks", argv: "PromotionRun.promote! lane=stable --confirm --wait"
      member action: "check_in",    needs: "target session text",  confirm: "no",  program: "exe/hecks", argv: "RedFlag.check_in! run.value={target} session.value={session} taking.value={text}"
      member action: "delete",      needs: "target",               confirm: "yes", program: "exe/hecks", argv: "AgentRun.tidy! to={target}"
      member action: "discard",     needs: "target condition",     confirm: "yes", program: "exe/hecks", argv: "PlainSession.remove! to={target} condition.value={condition}"
      member action: "review",      needs: "target text",          confirm: "no",  program: "exe/hecks", argv: "agents PlanReview.request! work.value={target} hops.value=1 role.value=architect repo.value={repo} plan.value={text} --wait"
      member action: "plan",        needs: "text",                 confirm: "no",  program: "exe/hecks", argv: "agents Planning.request! plan.value={key} goal.value={text} role.value=planner repo.value={repo} --wait"
      member action: "pause_pruning",  needs: "",                 confirm: "no",  program: "exe/hecks", argv: "agents Pruning.pause! to=pruner --wait"
      member action: "hold_pruning",   needs: "",                 confirm: "no",  program: "exe/hecks", argv: "agents Pruning.hold! role.value=pruner --wait"
      member action: "resume_pruning", needs: "",                 confirm: "no",  program: "exe/hecks", argv: "agents Pruning.resume! to=pruner --wait"
      member action: "prioritize", needs: "target text",          confirm: "no",  program: "exe/hecks", argv: "tickets Work.prioritize! to={target} priority.value={text} --wait"
      member action: "assign",     needs: "target text",          confirm: "no",  program: "exe/hecks", argv: "tickets Work.assign! to={target} epic={text} --wait"
      member action: "turn",       needs: "target text",          confirm: "yes", program: "exe/hecks", argv: "Dial.turn! setting.value={target} becomes.value={text} --wait"
      member action: "open_window",  needs: "text",              confirm: "yes", program: "exe/hecks", argv: "MergeWindow.open! reason.value={text} opened_by.value=board --wait"
      member action: "close_window", needs: "target",            confirm: "no",  program: "exe/hecks", argv: "MergeWindow.close! to={target} --wait"
    end

    # A step from `ActionRule`.
    value_object "ActionName" do
      attribute :value, String, matches: :present
    end

    lifecycle :status, default: "requested" do
      mark :failure, "refused"
      mark :terminal, "closed", "refused"
      transition "Close"  => "closed",  from: "requested"
      transition "Refuse" => "refused", from: "requested"
    end

    command "Serve" do
      role "Maintainer"
      goal "Show the pipeline on a page at 127.0.0.1 until stopped; the page reads, and changes something only through Act"

      attribute :run,  RunKey, sets: true
      attribute :port, Port, default: 4747, sets: true

      emits ServeRequested
    end

    command "Act" do
      role "Maintainer"
      goal "Take one step the page offers, from the ActionRule rows: it runs once its fields are sent and, for a step that moves code or deletes, once it is confirmed"

      reference_to PipelineBoard
      attribute :action,  ActionName
      attribute :confirm, Boolean, default: false

      emits ActRequested
    end

    # The read itself writes nothing; the adapter appends this event to the event log when the
    # Glance is read, so the tap holds one line per read and the reads can be counted.
    command "Look" do
      role "System"
      goal "Record that the Glance was read, so the reads can be counted"

      attribute :run, RunKey, sets: true

      emits GlanceRead
    end

    command "Close" do
      role "System"
      goal "Record that the server ended"

      reference_to PipelineBoard
      attribute :last, Reason, sets: true

      emits BoardClosed
    end

    command "Refuse" do
      role "System"
      goal "Record that the server could not open, and why"

      reference_to PipelineBoard
      attribute :last, Reason, sets: true

      emits BoardRefused
    end

    # Named `Board` while the text panel's command holds the name `Snapshot`.
    query "Board" do
      description "The board's whole read model as one Snapshot: the strip's stages, every other reading under its one key, what is stuck, the roles, the runs, the open train pull requests, the release and the newest events. It reads only, and the board need not be running."
      returns Snapshot
    end

    query "Glance" do
      description "The two questions asked first, as one typed Glance: what needs a person or stands too long (each entry with its group, one plain line, since when and who it waits on, a role or a person) and whether work is flowing (admission open or closed and why, what the fill would start next, the train's state). Which kinds are members is the StuckKind rows; each fact is asked of the aggregate that owns it. It reads only."
      returns Glance
    end

    query "Signal" do
      description "Signalbox's one signal for the strip as one Reading in plain words (the SignalSays row of the band): its band, load and the load of Signalbox's short mark. A signal that could not be read is a Reading in state unknown with the reason as its note. It reads only."
      returns Reading
    end

    query "FillWhy" do
      description "Each Work item the fill did not start and why, in the words of the side deciding now (the FillSide rows): admission while admission.signalbox is on, else the old dispatch. It reads only."
      returns list_of(FillWhy)
    end

    query "RedEpisodes" do
      description "The red that stands and the last few episodes of red main, one RedEpisodeLine each, newest first, asked of RedEpisode.Recent. It reads only."
      attribute :limit, Limit, optional: true
      returns list_of(RedEpisodeLine)
    end

    query "Measures" do
      description "The seven outcome measures with their present readings, one Reading each, asked of Epic.Measures; a measure that could not be read is one Reading in state unknown, said once. It reads only."
      returns list_of(Reading)
    end

    query "Epics" do
      description "The ranked epics, one Reading each: the measure, its state (met, missed, unread or unstated) and the members done of all, asked of Epic.Outcomes. It reads only."
      returns list_of(Reading)
    end

    query "Holds" do
      description "What holds boarding: the BoardingHold on local main, as one Reading. Exhausted and reopened train pull requests are one Reading each once TrainPr declares a query that lists them. It reads only."
      returns list_of(Reading)
    end

    query "Now" do
      description "The pipeline's status as one typed Status: why nothing is starting when nothing is (the first line, the reading behind it and the setting that governs it), landings in the last hour, today since noon and since a given time with their rates, each started Work item with its stage and minutes in it, and each blocked run with its question's first line and kind. It reads only."
      attribute :since, String, optional: true
      returns Status
    end

    query "Stages" do
      description "One Stage per node of the strip, left to right: Work items, Sessions, Local main, Integration, Train, CI, Promote, Release, and ahead of them the rows built only while something needs a person. Each has its state, its count as the value and a one-line note."
      returns list_of(Stage)
    end

    query "Readings" do
      description "Every number the board shows that is not on the strip, one Reading per key: CI success, median wall, failed jobs on the head, how long main has been red, commit to green, landed to pushed, commits not pushed, dispatched sessions, work finished, the latest release's age, disk, boot hours, open pull requests and the pipeline's health."
      returns list_of(Reading)
    end

    query "CiRuns" do
      description "The last CI runs on main, oldest first: sha, started, wall minutes, conclusion and how many jobs failed."
      attribute :limit, Limit, optional: true
      returns list_of(CiRun)
    end

    query "SlowestJobs" do
      description "The jobs of the last completed CI run, slowest first, in minutes."
      attribute :limit, Limit, optional: true
      returns list_of(JobTime)
    end

    query "TrainCiRuns" do
      description "The last CI runs on train pull requests, oldest first, first attempts only (a rerun's wall time is not a run's): sha, started, wall minutes, conclusion and how many jobs failed."
      attribute :limit, Limit, optional: true
      returns list_of(CiRun)
    end

    query "TrainSlowestJobs" do
      description "The jobs of the last completed first-attempt CI run on a train pull request, slowest first, in minutes."
      attribute :limit, Limit, optional: true
      returns list_of(JobTime)
    end

    query "TrainFlakes" do
      description "The flakes of the last 14 days on train pull requests, most often first: an item is a flake when an earlier attempt of a run failed it and a later attempt of the same run concluded success, counted once per run. A spec failure is told by its spec file, a failure before the specs by its job and step. A run that was closed, never passed or is still running is not counted. Each row says how far back the runs read reach (reaches_back) and how many runs could not be read."
      attribute :limit, Limit, optional: true
      returns list_of(Flake)
    end

    query "OpenWork" do
      description "The Work items that are not done: slug, status, area and where each stands in the plan."
      returns list_of(WorkLine)
    end

    query "ProjectWork" do
      description "A project's undone Work items, read from its own Tickets store without booting the project: `undone` by the rule of the Tickets bluebook's `Work.Undone`. A name no ProjectBoard row holds, or a store that cannot be found or read, is refused with the reason."
      attribute :project, String
      returns list_of(WorkLine)
    end

    query "Sessions" do
      description "The busy and the recent dispatched sessions, with the job's own state and the seconds since it last wrote."
      returns list_of(SessionLine)
    end

    query "Snapshot" do
      description "The board's state as a fixed-width text panel for a terminal: stage counts, metric tiles, recent main CI, sessions by state, open train PRs, planned Work items and agents. It reads only, and the board need not be running."
      attribute :width,  Width,  optional: true
      attribute :colour, Colour, optional: true
      attribute :limit,  Limit,  optional: true
      returns Document
    end

    query "Cycles" do
      description "One cycle per recent Work item, newest first: its seconds so far, each stage's seconds in order, and the stage still open for an item in flight."
      attribute :limit, Limit, optional: true
      returns list_of(Cycle)
    end

    query "CycleStats" do
      description "One Reading per stage of a Work item's cycle: the median seconds over the last cycle_items items, with the cycle_percentile and how many items closed the stage in its note."
      returns list_of(Reading)
    end

    query "DailyHealth" do
      description "What the pipeline found of its own day, one Reading per HealthCheck row: boardings made by hand or of an unverified commit, verifications over their bound, Work items finished with parts not delivered, sessions left blocked or stopped and findings left open. The value is how many were found and the note names each with its age. It reads only and alerts no one."
      returns list_of(Reading)
    end

    query "IntegrationRuns" do
      description "The runs the MainIntegration saga remembers, the most recently advanced first: the landed commit, the stage it is stored in, the time of its last recorded event and whether it is parked for a person. It reads the saga's checkpoints and the event log, and advances nothing."
      returns list_of(IntegrationRun)
    end

    query "Wiring" do
      description "What the loaded bluebooks wire together, one edge each: a policy from an aggregate to the aggregate it triggers, an ask from an aggregate to a port, and a port to the adapter that answers it."
      returns list_of(WiringEdge)
    end

    query "Events" do
      description "The most recent events the tooling recorded, newest first: time, aggregate, event, and the policies that reacted where the journal holds them."
      attribute :limit, Limit, optional: true
      returns list_of(EventLine)
    end

    query "RunCards" do
      description "One card per run, newest first: the run, its role and session, and its last word, the verdict of the run's newest TurnFinished."
      attribute :limit, Limit, optional: true
      returns list_of(RunCard)
    end

    query "Stuck" do
      description "What the pipeline is stuck on, across runs: the stuck rows of each run's newest TurnFinished, with what, since when, the run that owns it and a link."
      attribute :limit, Limit, optional: true
      returns list_of(StuckItem)
    end

    query "TurnBlock" do
      description "The console block of a run's newest TurnFinished (the newest of any run when none is named): headed turn finished: role @ time, one aligned line per field."
      attribute :run, RunKey, optional: true
      returns Document
    end
  end

  # A look from outside the board's process: its own restart runs inside the loop that wedged.
  aggregate "BoardWatch" do
    description "One look at the serving board through its own port: a board that does not answer GET / within board_answer_seconds, or whose state is stale, is unresponsive and is restarted; the Supervisor adapter only probes and restarts, and every outcome is an event."

    identified_by :run

    attribute :run,  PipelineBoard::RunKey
    attribute :port, PipelineBoard::Port, optional: true
    attribute :last, PipelineBoard::Reason, optional: true

    command "Watch" do
      role "System"
      goal "Look at the board through its own port: it answers, or it is restarted"

      attribute :run,  PipelineBoard::RunKey, sets: true
      attribute :port, PipelineBoard::Port, default: 4747, sets: true

      emits WatchRequested
    end

    command "RecordRestart" do
      role "System"
      goal "Record that the board was restarted"

      reference_to BoardWatch
      attribute :port, PipelineBoard::Port, sets: true

      emits RestartRecorded
    end

    command "RecordRestartRefusal" do
      role "System"
      goal "Record that the restart was refused, and why"

      reference_to BoardWatch
      attribute :last, PipelineBoard::Reason, sets: true

      emits RestartRefusalRecorded
    end
  end

  # The board answered; nothing else happens.
  policy "ProbeWhenWatchRequested" do
    on  "BoardWatch.WatchRequested"
    ask :probe, with: { port: :port }
  end

  # The board did not answer: restart it.
  policy "RestartWhenBoardUnresponsive" do
    on  "BoardWatch.BoardUnresponsive"
    ask :restart, with: { port: :port }
  end

  # The Hecks domain's `Board.Serve` asks for the board. Its registry holds every attached bluebook,
  # so the page this runs shows them all; the Serve command above then does the rest.
  policy "ServeWhenBoardRequested" do
    on      "Board.BoardServeRequested"
    trigger PipelineBoard::Serve, with: { run: :run, port: :port }
  end

  policy "RecordWhenBoardRestarted" do
    on      "BoardWatch.BoardRestarted"
    trigger BoardWatch::RecordRestart, with: { port: :port }
  end

  policy "RecordWhenRestartRefused" do
    on      "BoardWatch.BoardRestartRefused"
    trigger BoardWatch::RecordRestartRefusal, with: { last: :refusal }
  end

  policy "ListenWhenServed" do
    on  "PipelineBoard.ServeRequested"
    ask :listen, with: { port: :port }
  end

  policy "CloseWhenEnded" do
    on      "PipelineBoard.ServerEnded"
    trigger PipelineBoard::Close, with: { last: :last }
  end

  policy "RefuseWhenRefused" do
    on      "PipelineBoard.ServerRefused"
    trigger PipelineBoard::Refuse, with: { last: :refusal }
  end
end
