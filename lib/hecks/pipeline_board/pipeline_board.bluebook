# PipelineBoard: the pipeline from coding to release, read live and shown on one local page. The
# read side is six queries, each answered by an adapter behind a port: GitHub for the CI runs, Git
# for local main and the train, Tickets for the Work items, Jobs for the sessions, Journal for the
# events the tooling recorded. The bluebook names the questions and never fetches, shells out or
# opens a file.
#
# The commands are `Serve` and `Act`. `Serve` opens the page on 127.0.0.1 and answers `GET /` and
# `GET /api/state` until it is stopped. `Act` is the page's one way to change anything: `POST
# /api/act` runs one of the steps in the `ActionRule` rows (answer a blocked session, reply, check
# in, tidy, discard, board a train, promote), and a step that moves code runs only once confirmed.
# Every other request only reads. A read that fails answers `unknown: <reason>` for its stage and
# leaves the others alone.
#
# What the board says is decided here, not in its adapters. The `Verdict` rows say which state a
# stage or a tile is in, the `Setting` rows hold the numbers those rules compare with, the
# `Finding` rows name what the fan-out can flag, and the `ActionRule` rows say what each step needs
# and what it runs. The adapters read the rows and fetch, shape and draw; they decide nothing.
#
#   exe/hecks PipelineBoard.serve! port.value=4747 --wait
#
# From the Hecks domain, `Board.serve` asks for the same board through `ServeWhenBoardRequested`. It
# runs in the Hecks registry, so the wiring page shows every bluebook attached to Hecks.
#
#   exe/hecks Board.serve! port.value=4747 --wait

Hecks.bluebook "PipelineBoard" do
  vision "The pipeline from a Work item to a release is read live, stage by stage, and shown with the real events it emitted."

  supporting

  # The board. One run of it is one server opened on a local port, until it is stopped.
  aggregate "PipelineBoard" do
    description "The pipeline's stages, CI runs, work, sessions and events as they stand, and one server that shows them."

    identified_by :run

    attribute :run,  RunKey
    attribute :port, Port, optional: true
    attribute :last, Reason, optional: true

    value_object "RunKey" do
      attribute :value, String, matches: :present
    end

    # A local port the page is served on.
    value_object "Port" do
      attribute :value, Integer, default: 4747

      invariant("a port is 1024 to 65535") { value >= 1024 && value <= 65535 }
    end

    # Why a server ended or was refused.
    value_object "Reason", String

    # A JSON document: the results of a query, or `unknown: <reason>` for a read that failed.
    value_object "Document" do
      attribute :text, String
    end

    # How many columns a text panel is drawn in.
    value_object "Width" do
      attribute :value, Integer, default: 80
    end

    # Whether a text panel is coloured: `true` or `false`.
    value_object "Colour" do
      attribute :value, String, default: "false"
    end

    # How many results a query answers, at most.
    value_object "Limit" do
      attribute :value, Integer, default: 20
    end

    # One condition of a rule that names a state. Rows of one `stage` that share a `position` are
    # one rule: every condition must hold. The rules of a stage are tried in `position` order and
    # the first that holds names the state; `always` holds for any reading. `measure` names a number
    # the adapter read; `than` is a number or the name of a `Setting` (or a push limit); `scale`
    # multiplies it. `missing` holds when the adapter could not read the measure.
    value_object "Verdict" do
      attribute :stage,    String
      attribute :position, Integer
      attribute :measure,  String
      attribute :op,       String
      attribute :than,     String
      attribute :scale,    Integer, default: 1
      attribute :state,    String

      # ---- the strip: one stage each, left to right ----
      # The open findings of stopped runs that have waited on a person past
      # `stopped_run_overdue_hours`: first in the strip, ahead of the red flag.
      member stage: "Overdue for you", position: 1, measure: "",        op: "always",  than: "",  scale: 1, state: "failed"
      member stage: "Red flag",   position: 1, measure: "",             op: "always",  than: "",  scale: 1, state: "failed"
      # The open findings stopped integration runs and shipments filed; the row is only built
      # while one is open. A log of stops, not a count of runs stopped now.
      member stage: "Stopped runs", position: 1, measure: "",           op: "always",  than: "",  scale: 1, state: "attention"

      member stage: "Work items", position: 1, measure: "started",      op: ">",       than: "0", scale: 1, state: "working"
      member stage: "Work items", position: 2, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      member stage: "Sessions",   position: 1, measure: "blocked",      op: ">",       than: "0", scale: 1, state: "attention"
      member stage: "Sessions",   position: 2, measure: "busy",         op: ">",       than: "0", scale: 1, state: "working"
      member stage: "Sessions",   position: 3, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      member stage: "Local main", position: 1, measure: "ahead",        op: ">",       than: "0", scale: 1, state: "attention"
      member stage: "Local main", position: 2, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      member stage: "Train",      position: 1, measure: "not_pushed",   op: ">",       than: "0", scale: 1, state: "attention"
      member stage: "Train",      position: 2, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      member stage: "CI",         position: 1, measure: "running",      op: ">",       than: "0", scale: 1, state: "working"
      member stage: "CI",         position: 2, measure: "unsuccessful", op: ">",       than: "0", scale: 1, state: "failed"
      member stage: "CI",         position: 3, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      member stage: "Promote",    position: 1, measure: "behind",       op: ">",       than: "0", scale: 1, state: "attention"
      member stage: "Promote",    position: 2, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      member stage: "Release",    position: 1, measure: "unpublished",  op: ">",       than: "0", scale: 1, state: "attention"
      member stage: "Release",    position: 2, measure: "",             op: "always",  than: "",  scale: 1, state: "ok"

      # ---- the metric tiles ----
      # The share of CI runs that succeeded: good from `success_good`, fair from `success_fair`.
      member stage: "CI success", position: 1, measure: "value",        op: "missing", than: "",  scale: 1, state: "unknown"
      member stage: "CI success", position: 2, measure: "value",        op: ">=",      than: "success_good", scale: 1, state: "ok"
      member stage: "CI success", position: 3, measure: "value",        op: ">=",      than: "success_fair", scale: 1, state: "attention"
      member stage: "CI success", position: 4, measure: "",             op: "always",  than: "",  scale: 1, state: "failed"

      # The median wall: within the goal is ok, within twice the goal needs attention.
      member stage: "CI wall",    position: 1, measure: "value",        op: "missing", than: "",  scale: 1, state: "unknown"
      member stage: "CI wall",    position: 2, measure: "value",        op: "<=",      than: "wall_goal_minutes", scale: 1, state: "ok"
      member stage: "CI wall",    position: 3, measure: "value",        op: "<=",      than: "wall_goal_minutes", scale: 2, state: "attention"
      member stage: "CI wall",    position: 4, measure: "",             op: "always",  than: "",  scale: 1, state: "failed"

      # Main is red for as long as the latest run is not green; the tile is only built then.
      member stage: "Main red",   position: 1, measure: "",             op: "always",  than: "",  scale: 1, state: "failed"

      member stage: "Failed jobs on head", position: 1, measure: "failed_jobs", op: ">", than: "0", scale: 1, state: "failed"
      member stage: "Failed jobs on head", position: 2, measure: "",    op: "always",  than: "",  scale: 1, state: "ok"

      # Unpushed commits nudge at the QualityControl world's push limits (`commits`, `hours`).
      member stage: "Commits not pushed", position: 1, measure: "ahead",     op: ">=",     than: "commits", scale: 1, state: "attention"
      member stage: "Commits not pushed", position: 2, measure: "age_hours", op: ">=",     than: "hours",   scale: 1, state: "attention"
      member stage: "Commits not pushed", position: 3, measure: "",          op: "always", than: "",        scale: 1, state: "ok"

      # Dispatched sessions press at the cap, or when any session waits on a person.
      member stage: "Dispatched sessions", position: 1, measure: "dispatched", op: ">=",     than: "session_cap", scale: 1, state: "attention"
      member stage: "Dispatched sessions", position: 2, measure: "blocked",    op: ">",      than: "0",           scale: 1, state: "attention"
      member stage: "Dispatched sessions", position: 3, measure: "",           op: "always", than: "",            scale: 1, state: "ok"

      # Work finished stalls when nothing finished in the window while Work items wait in the plan.
      member stage: "Work finished", position: 1, measure: "finished", op: "<=",     than: "0", scale: 1, state: "attention"
      member stage: "Work finished", position: 1, measure: "planned",  op: ">",      than: "0", scale: 1, state: "attention"
      member stage: "Work finished", position: 2, measure: "",         op: "always", than: "",  scale: 1, state: "ok"

      # Open pull requests need attention once the oldest has waited `open_pr_stale_hours`.
      member stage: "Open PRs", position: 1, measure: "oldest_hours", op: ">=",     than: "open_pr_stale_hours", scale: 1, state: "attention"
      member stage: "Open PRs", position: 2, measure: "",             op: "always", than: "",                    scale: 1, state: "ok"

      # The daily health line's tile counts what only the events show (the `counted` checks):
      # anything found needs attention.
      member stage: "Pipeline health", position: 1, measure: "found", op: "missing", than: "",  scale: 1, state: "unknown"
      member stage: "Pipeline health", position: 2, measure: "found", op: ">",       than: "0", scale: 1, state: "attention"
      member stage: "Pipeline health", position: 3, measure: "",      op: "always",  than: "",  scale: 1, state: "ok"

      # ---- a session's status, from what its job and `claude agents` say ----
      # `waiting` is 1 when the job says blocked and is listed or recently written; `needs` is 1
      # when the job set `needs`, which is how it says it waits on a person. A session paused on a
      # push or CI is still working, so it is busy, not blocked.
      # One open stopped run's finding, by the hours since it was reported: overdue past the bound,
      # open otherwise and when its report time could not be read.
      member stage: "Stopped run age", position: 1, measure: "hours", op: ">",    than: "stopped_run_overdue_hours", scale: 1, state: "overdue"
      member stage: "Stopped run age", position: 2, measure: "",      op: "always", than: "", scale: 1, state: "open"

      member stage: "Session status", position: 1, measure: "waiting", op: ">",      than: "0", scale: 1, state: "blocked"
      member stage: "Session status", position: 1, measure: "needs",   op: ">",      than: "0", scale: 1, state: "blocked"
      member stage: "Session status", position: 2, measure: "waiting", op: ">",      than: "0", scale: 1, state: "busy"
      member stage: "Session status", position: 3, measure: "busy",    op: ">",      than: "0", scale: 1, state: "busy"
      member stage: "Session status", position: 4, measure: "failed",  op: ">",      than: "0", scale: 1, state: "failed"
      member stage: "Session status", position: 5, measure: "",        op: "always", than: "",  scale: 1, state: "done"

      # ---- who a blocked session waits on ----
      # Only a session that asks the owner (`asked`: an open "needs an answer" Work item names its
      # run, or its latest message begins with [owner]) is the owner's to answer. A session of
      # another repository, or whose Work item has finished, is not the pipeline's to list. The
      # rest are shown for what they are, never as waiting on the owner.
      member stage: "Session owner", position: 1, measure: "other_repo", op: ">",      than: "0", scale: 1, state: "other repo"
      member stage: "Session owner", position: 2, measure: "finished",   op: ">",      than: "0", scale: 1, state: "finished leftover"
      member stage: "Session owner", position: 3, measure: "blocked",    op: "<=",     than: "0", scale: 1, state: "running"
      member stage: "Session owner", position: 4, measure: "asked",      op: ">",      than: "0", scale: 1, state: "owner"
      member stage: "Session owner", position: 5, measure: "review",     op: ">",      than: "0", scale: 1, state: "waiting on a review verdict"
      member stage: "Session owner", position: 6, measure: "",           op: "always", than: "",  scale: 1, state: "stranded run"
    end

    # A number a rule compares with. A QualityControl world's `ci_health` verb overrides the CI
    # ones; its `push_nudge` verb sets the push limits the unpushed-commits rule reads.
    value_object "Setting" do
      attribute :name,  String
      attribute :value, Integer

      member name: "wall_goal_minutes",       value: 3
      member name: "success_good",            value: 80
      member name: "success_fair",            value: 50
      member name: "session_cap",             value: 10
      member name: "throughput_window_hours", value: 24
      member name: "session_fresh_seconds",   value: 600
      member name: "session_window_hours",    value: 24
      member name: "open_pr_stale_hours",     value: 24
      member name: "cycle_items",             value: 20
      member name: "cycle_percentile",        value: 90
      # Hours a run stopped for a person may wait before the board puts it first. It matches the
      # stable lane's `alert_after` (4) on purpose, unlinked: by then a stop has outlived any CI
      # run, queue and verification (about 25 minutes) many times over, and a person's session.
      member name: "stopped_run_overdue_hours", value: 4
      # The bounds of the daily health line. Its day is the last `health_window_hours`. A
      # verification takes about 16 minutes when nothing hangs (the Tickets world's `spec_bounds`),
      # so one past 25 has waited on something. A session left blocked or stopped for an hour waits
      # on nobody who is watching. A finding open two days is not being worked.
      member name: "health_window_hours",     value: 24
      member name: "verify_bound_minutes",    value: 25
      member name: "session_bound_minutes",   value: 60
      member name: "finding_bound_hours",     value: 48
      # The board's one timer, a named safety net: seconds between a recompute of every pushed tile
      # and a heartbeat when no journal line arrived. The board learns of a change from the journal
      # (`events.jsonl`), never from this clock; it only catches a line the file watch missed and
      # tells a dead connection from a quiet one.
      member name: "safety_net_seconds",      value: 300
    end

    # A tile the board pushes as HTML, and the aggregates it reads. A journal line carries the
    # aggregate of its event, so any event of a read aggregate makes the server recompute the tile,
    # and a changed render is pushed. A tile names no event: a new event of a read aggregate needs
    # no change here. `reads` lists aggregates by their journal names, separated by a comma.
    value_object "Tile" do
      attribute :tile,  String
      attribute :reads, String

      member tile: "fill",  reads: "Tickets::Work, Hecks::AgentRun, Hecks::Roll, Hecks::Dispatch"
      member tile: "plan",  reads: "Tickets::Work, Tickets::Epic, Hecks::AgentRun, Agents::PlanReview, Hecks::SendTrain, Hecks::Dispatch"
      member tile: "train", reads: "Hecks::SendTrain, Hecks::LinkedTree, Hecks::Landing, Hecks::BoardingRelease, Hecks::PushOutcome"
    end

    # One check of the daily health line: what the pipeline reports of its own day, which a person
    # would otherwise find by watching. A check opens at each of its `opens` events in the day and
    # is answered by one of its `closes` events (several are separated by a space) of the same key,
    # as `joins` says: `id` is the event's id, and `<link> <link>` is the opener's first link and
    # the closer's second, compared by their first seven characters (a link of fewer than seven hex
    # characters names no commit and is reported as unreadable). The `test` says what is found:
    # - `unanswered`: no closer at or before the opener.
    # - `over`: the first closer after the opener came later than the `bound` setting, in minutes,
    #   or none has come and the bound has passed.
    # - `stuck`: the newest closer at or before the opener left stuck rows: the parts of its brief
    #   the run named as not delivered.
    # - `aged`: the key is open in the ledger and its opener is older than the `bound`, in hours,
    #   or the event log does not reach back to it.
    # - `left`: a session whose Jobs reading matches one of the `opens` words (`status:blocked`
    #   is the session's status, `state:stopped` its job's state), for longer than the `bound`,
    #   in minutes.
    # `counted` is `yes` for a check only the events show, which the board's tile counts; the
    # sessions and the findings already have their own stage and row.
    value_object "HealthCheck" do
      attribute :kind,    String
      attribute :opens,   String
      attribute :closes,  String
      attribute :joins,   String
      attribute :test,    String
      attribute :bound,   String
      attribute :counted, String
      attribute :says,    String

      member kind: "boarded_by_hand",    opens: "Hecks::SendTrain.BoardingQueued", closes: "Hecks::Integration.MainBoardingStarted",
             joins: "boarded landed", test: "unanswered", bound: "", counted: "yes", says: "boarded by hand"
      member kind: "boarded_unverified", opens: "Hecks::SendTrain.BoardingQueued", closes: "Hecks::Integration.MainVerified",
             joins: "boarded landed", test: "unanswered", bound: "", counted: "yes", says: "boarded unverified"
      member kind: "slow_verification",  opens: "Hecks::Integration.MainVerificationStarted",
             closes: "Hecks::Integration.MainVerified Hecks::Integration.MainVerificationFailed Hecks::Integration.MainVerificationFailedOnce Hecks::Integration.IntegrationSuperseded",
             joins: "id", test: "over", bound: "verify_bound_minutes", counted: "yes", says: "slow verifications"
      member kind: "half_delivered",     opens: "Tickets::Work.WorkFinished", closes: "Agents::Turn.TurnFinished",
             joins: "id", test: "stuck", bound: "", counted: "yes", says: "finished half-delivered"
      member kind: "left_session",       opens: "status:blocked state:stopped", closes: "", joins: "", test: "left", bound: "session_bound_minutes",
             counted: "no", says: "sessions left blocked or stopped"
      member kind: "stale_finding",
             opens: "Tickets::Finding.FindingReported Tickets::Finding.RunFindingReported Tickets::Finding.StoppedRunReported",
             closes: "", joins: "id", test: "aged", bound: "finding_bound_hours", counted: "no", says: "stale findings"
    end

    # One stage of a Work item's cycle, in `position` order. The first stage starts at its `opens`
    # event; every later one starts where the stage before it ended, at its `opens` event. A stage
    # ends at the first of its `closes` events (several are separated by a space) at or after its
    # start that belongs to the item, as `belongs` says:
    # - `item`: its `work` or `branch` link, or its id, is the Work item's key, or its id is that of
    #   the event that started the stage.
    # - `carried`: its `landed` commit was landed (a `Hecks::Landing.BranchLanded` naming that
    #   commit) at or after the item's own landing. Local main is one line, so that commit holds
    #   the item: a verification of a newer landing carries every landing before it.
    # - `after`: any one. Main only moves forward, so what reads or boards main after the stage
    #   started holds the item.
    # Each event is named with the aggregate that emits it. The train's pull request opens when the
    # boarding is queued (`BoardingQueued`) and merges when `SendTrain.Merge` records it
    # (`BranchPushed`, on the same boarding).
    value_object "CycleStage" do
      attribute :stage,    String
      attribute :position, Integer
      attribute :opens,    String
      attribute :closes,   String
      attribute :belongs,  String

      member stage: "queue",        position: 1, opens: "Tickets::Work.WorkPlanned",              closes: "Tickets::Work.WorkStarted",              belongs: "item"
      member stage: "dispatch",     position: 2, opens: "Tickets::Work.WorkStarted",              closes: "Hecks::AgentRun.AgentStarted",           belongs: "item"
      member stage: "planning",     position: 3, opens: "Hecks::AgentRun.AgentStarted",           closes: "Agents::PlanReview.PlanReviewRequested", belongs: "item"
      member stage: "review",       position: 4, opens: "Agents::PlanReview.PlanReviewRequested", closes: "Agents::PlanReview.PlanReviewed",        belongs: "item"
      member stage: "implementing", position: 5, opens: "Agents::PlanReview.PlanReviewed",        closes: "Hecks::Landing.BranchLanded",            belongs: "item"
      member stage: "verify",       position: 6, opens: "Hecks::Landing.BranchLanded",            closes: "Hecks::Integration.MainVerified Hecks::Integration.MainVerificationFailed", belongs: "carried"
      member stage: "boarding",     position: 7, opens: "Hecks::Integration.MainVerified",        closes: "Hecks::SendTrain.BoardingQueued",        belongs: "after"
      member stage: "ci",           position: 8, opens: "Hecks::SendTrain.BoardingQueued",        closes: "Hecks::SendTrain.BranchPushed",          belongs: "item"
      member stage: "sync",         position: 9, opens: "Hecks::SendTrain.BranchPushed",          closes: "Hecks::LinkedTree.MainPulled",           belongs: "after"
    end

    # What the fan-out can flag on a Work item.
    value_object "Finding" do
      attribute :kind,  String
      attribute :means, String

      member kind: "unclaimed", means: "a session runs on a Work item that has no claimed_by"
      member kind: "duplicate", means: "more than one session runs on one Work item"
      member kind: "overlap",   means: "another session works an area that is a path-prefix of this item's area, or the reverse"
      member kind: "landed",    means: "the item already landed but is still planned or started"
    end

    # The statuses a landed Work item should no longer have.
    value_object "StaleStatus" do
      attribute :status, String

      member status: "planned"
      member status: "started"
    end

    # A step the page may take. `needs` are the fields it must send, `confirm` is `yes` for a step
    # that moves code or deletes, `program` is what runs it and `argv` is the command, with
    # `{field}` filled from the request. A step runs only when every field it needs is present.
    # `before` is a launcher command that runs first when it is not empty: an answer first checks
    # the run, so the run records the state the job is in and the answer's own rule can hold.
    # `ended` is the step taken instead when that first command is refused because the run has
    # ended: an answer to a run that finished while its session still waits on a person goes to that
    # session as a reply, which resumes it in place. With no waiting session the step is refused by
    # name, and the page keeps what the person typed.
    value_object "ActionRule" do
      attribute :action,  String
      attribute :needs,   String
      attribute :confirm, String
      attribute :program, String
      attribute :argv,    String
      attribute :before,  String, default: ""
      attribute :ended,   String, default: ""

      member action: "answer",      needs: "target text",          confirm: "no",  program: "exe/hecks", argv: "AgentRun.answer! to={target} answer.value={text} --wait", before: "AgentRun.check! to={target} --wait", ended: "reply"
      member action: "reply",       needs: "target text",          confirm: "no",  program: "claude",    argv: "attach {attach}"
      member action: "auto_reply",  needs: "target",               confirm: "no",  program: "exe/hecks", argv: ""
      member action: "board_train", needs: "",                     confirm: "yes", program: "exe/hecks", argv: "SendTrain.board! --confirm"
      member action: "promote",     needs: "",                     confirm: "yes", program: "exe/hecks", argv: "PromotionRun.promote! lane=stable --confirm --wait"
      member action: "check_in",    needs: "target session text",  confirm: "no",  program: "exe/hecks", argv: "RedFlag.check_in! run.value={target} session.value={session} taking.value={text}"
      member action: "delete",      needs: "target",               confirm: "yes", program: "exe/hecks", argv: "AgentRun.tidy! to={target}"
      member action: "discard",     needs: "target condition",     confirm: "yes", program: "exe/hecks", argv: "PlainSession.remove! to={target} condition.value={condition}"
      member action: "review",      needs: "target text",          confirm: "no",  program: "exe/hecks", argv: "agents PlanReview.request! work.value={target} hops.value=1 role.value=architect repo.value={repo} plan.value={text} --wait"
      member action: "plan",        needs: "text",                 confirm: "no",  program: "exe/hecks", argv: "agents Planning.request! plan.value={key} goal.value={text} role.value=planner repo.value={repo} --wait"
      member action: "settle",      needs: "target",               confirm: "no",  program: "exe/hecks", argv: "agents PromotionRecommendation.settle! to={target} --wait"
    end

    # A step from `ActionRule`.
    value_object "ActionName" do
      attribute :value, String, matches: :present
    end

    lifecycle :status, default: "requested" do
      mark :failure, "refused"
      mark :terminal, "closed", "refused"
      transition "Close"  => "closed",  from: "requested"
      transition "Refuse" => "refused", from: "requested"
    end

    command "Serve" do
      role "Maintainer"
      goal "Show the pipeline on a page at 127.0.0.1 until stopped; the page reads, and changes something only through Act"

      attribute :run,  RunKey, sets: true
      attribute :port, Port, default: 4747, sets: true

      emits ServeRequested
    end

    command "Act" do
      role "Maintainer"
      goal "Take one step the page offers, from the ActionRule rows: it runs once its fields are sent and, for a step that moves code or deletes, once it is confirmed"

      reference_to PipelineBoard
      attribute :action,  ActionName
      attribute :confirm, Boolean, default: false

      emits ActRequested
    end

    command "Close" do
      role "System"
      goal "Record that the server ended"

      reference_to PipelineBoard
      attribute :last, Reason, sets: true

      emits BoardClosed
    end

    command "Refuse" do
      role "System"
      goal "Record that the server could not open, and why"

      reference_to PipelineBoard
      attribute :last, Reason, sets: true

      emits BoardRefused
    end

    query "Stages" do
      description "One entry per stage, left to right: Work items, Sessions, Local main, Train, CI, Promote, Release, each with its state, count and a one-line detail."
      returns Document
    end

    query "CiRuns" do
      description "The last CI runs on main, oldest first: sha, started, wall minutes, conclusion and how many jobs failed."
      attribute :limit, Limit, optional: true
      returns Document
    end

    query "SlowestJobs" do
      description "The jobs of the last completed CI run, slowest first, in minutes."
      attribute :limit, Limit, optional: true
      returns Document
    end

    query "TrainCiRuns" do
      description "The last CI runs on train pull requests, oldest first, first attempts only (a rerun's wall time is not a run's): sha, started, wall minutes, conclusion and how many jobs failed."
      attribute :limit, Limit, optional: true
      returns Document
    end

    query "TrainSlowestJobs" do
      description "The jobs of the last completed first-attempt CI run on a train pull request, slowest first, in minutes."
      attribute :limit, Limit, optional: true
      returns Document
    end

    query "TrainFlakes" do
      description "The flakes of the last 14 days on train pull requests, most often first: an item is a flake when an earlier attempt of a run failed it and a later attempt of the same run concluded success, counted once per run. A spec failure is told by its spec file, a failure before the specs by its job and step. A run that was closed, never passed or is still running is not counted. The answer says how far back the runs read reach (reaches_back) and how many runs could not be read."
      attribute :limit, Limit, optional: true
      returns Document
    end

    query "OpenWork" do
      description "The Work items that are not done: slug, status and area."
      returns Document
    end

    query "Sessions" do
      description "The busy and the recent dispatched sessions, with the job's own state."
      returns Document
    end

    query "Snapshot" do
      description "The board's state as a fixed-width text panel for a terminal: stage counts, metric tiles, recent main CI, sessions by state, open train PRs, planned Work items and agents. It reads only, and the board need not be running."
      attribute :width,  Width,  optional: true
      attribute :colour, Colour, optional: true
      attribute :limit,  Limit,  optional: true
      returns Document
    end

    query "Cycles" do
      description "One cycle per recent Work item, newest first: each stage's start, end and seconds, the stage still open for an item in flight, and per stage the median and the cycle_percentile over the last cycle_items items."
      attribute :limit, Limit, optional: true
      returns Document
    end

    query "DailyHealth" do
      description "What the pipeline found of its own day by the HealthCheck rows: boardings made by hand or of an unverified commit, verifications over their bound, Work items finished with parts not delivered, sessions left blocked or stopped and findings left open, each with its age, and one line that says it all. It reads only and alerts no one."
      returns Document
    end

    query "Wiring" do
      description "What the loaded bluebooks wire together: aggregates, the policies between them, the ports an ask goes out through and the adapters that answer them."
      returns Document
    end

    query "Events" do
      description "The most recent events the tooling recorded, newest first: time, aggregate, event, and the policy that reacted where the journal holds one."
      attribute :limit, Limit, optional: true
      returns Document
    end

    query "RunCards" do
      description "One card per run, newest first: the run, its role, session and time, and its last word, the verdict of the run's newest TurnFinished."
      attribute :limit, Limit, optional: true
      returns Document
    end

    query "Stuck" do
      description "What the pipeline is stuck on, across runs: the stuck rows of each run's newest TurnFinished, with what, since when, the run that owns it and a link."
      attribute :limit, Limit, optional: true
      returns Document
    end

    query "TurnBlock" do
      description "The console block of a run's newest TurnFinished (the newest of any run when none is named): headed turn finished: role @ time, one aligned line per field."
      attribute :run, RunKey, optional: true
      returns Document
    end
  end

  # The Hecks domain's `Board.Serve` asks for the board. Its registry holds every attached bluebook,
  # so the page this runs shows them all; the Serve command above then does the rest.
  policy "ServeWhenBoardRequested" do
    on      "Board.BoardServeRequested"
    trigger PipelineBoard::Serve, with: { run: :run, port: :port }
  end

  policy "ListenWhenServed" do
    on  "PipelineBoard.ServeRequested"
    ask :listen, with: { port: :port }
  end

  policy "CloseWhenEnded" do
    on      "PipelineBoard.ServerEnded"
    trigger PipelineBoard::Close, with: { last: :last }
  end

  policy "RefuseWhenRefused" do
    on      "PipelineBoard.ServerRefused"
    trigger PipelineBoard::Refuse, with: { last: :refusal }
  end
end
