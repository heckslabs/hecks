# The PipelineBoard bluebook, bound so it boots standing alone (a behaviors or model_check boot of
# this directory). The ports it shares with every attaching hecksagon are in
# pipeline_board.ports.hecksagon.
Hecks.hecksagon "PipelineBoard" do
  attaches "Governance"
  persisted_by "Memory"

  # The Hecks domain's `Board.Serve` emits BoardServeRequested in the Hecks registry, which holds
  # every attached bluebook: ServeWhenBoardRequested reacts by running Serve there.
  subscribe "Hecks.BoardServeRequested"
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
