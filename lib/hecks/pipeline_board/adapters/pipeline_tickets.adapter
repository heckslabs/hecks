# Binds the `Tickets` port to `PipelineTickets`, which answers `OpenWork` with the Work items that are not done,
# and `ProjectWork` with another project's, read from its own Tickets store by `ProjectStore`, a
# helper of this adapter and not a second adapter on the port.
# Required by name, not relative, so a copy of this directory shares the one implementation loaded.
require "hecks/pipeline_board/adapters/pipeline_tickets"

Hecks.adapter "PipelineTickets" do
  port "Tickets"
end
