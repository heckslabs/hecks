# The Composer domain, bound so it boots standing alone (a fuzz or model_check boot of this
# directory). Drafts are working state; the files on disk are the truth, so nothing here outlives
# the process.
Hecks.hecksagon "Composer" do
  attaches "Governance"
  persisted_by "Memory"
  driven_by "Web"
end

# The anti-corruption layer for Governance, which the chapter's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
