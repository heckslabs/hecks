# The Composer domain, bound so it boots standing alone (a fuzz or model_check boot of this
# directory). Drafts are working state; the files on disk are the truth, so nothing here outlives
# the process.
Hecks.hecksagon "Composer" do
  attaches "Governance"
  persisted_by "Memory"
  # The editor reaches this domain through Web, and every tool that boots a corpus domain (fuzz,
  # model_check, the Composer's own Session) through Ruby; the launcher, the forms and MCP do not.
  driven_by "Web"
  driven_by "Ruby"
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
