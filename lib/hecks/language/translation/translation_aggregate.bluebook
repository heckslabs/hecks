Hecks.bluebook "Translation" do
  aggregate "TranslationAggregate" do
    description "One aggregate's own move from one pinned era to the next — a table of rules, or a deliberate acknowledgment that a rule is still unresolved."

    belongs_to Translation, as: :translation_ref

    identified_by TranslationAggregateName, as: :name

    # A dedicated identity type: sharing `TranslationName` with a non-identity field breaks the
    # single-field identity unwrap, storing the id as a stringified Hash instead of a scalar.
    attribute :was,  TranslationName, optional: true

    value_object "TranslationAggregateName" do
      attribute :value, String
      invariant("a translation aggregate names itself") { !value.to_s.empty? }
    end

    # The parent arrives as an ordinary value fact at declaration time. Its
    # fields mirror Translation's compound identity, while `translation_ref`
    # above retains the resulting canonical identity as a structural edge.
    value_object "TranslationIdentity" do
      attribute :domain, TranslationDomainName
      attribute :from,   TranslationEraName
      attribute :to,     TranslationEraName
    end

    attribute :renames,   list_of(TranslationRename)
    attribute :moves,     list_of(TranslationMove)
    attribute :converts,  list_of(TranslationConvert)
    attribute :drops,     list_of(TranslationName)
    attribute :retypes,   list_of(TranslationRetype)
    attribute :computes,  list_of(TranslationCompute)
    attribute :rekeys,    list_of(TranslationRekey)
    attribute :backfills, list_of(TranslationBackfill)

    # Field names mirror the Struct records in lib/hecks/bluebook/translation.rb, not the
    # builder's parameter names (`move(old_path, to:)` stores `old_path` as `from`).
    value_object "TranslationRename" do
      attribute :from, TranslationName
      attribute :to,   TranslationName
    end

    value_object "TranslationMove" do
      attribute :from, TranslationName
      attribute :to,   TranslationName
    end

    value_object "TranslationConvert" do
      attribute :from,   TranslationName
      attribute :to,     TranslationName
      attribute :values, TranslationLiteralText
    end

    value_object "TranslationRetype" do
      attribute :from, TranslationName
      attribute :to,   TranslationName
    end

    value_object "TranslationCompute" do
      attribute :from, TranslationName
      attribute :to,   TranslationName
      attribute :sql,  TranslationLiteralText
    end

    value_object "TranslationRekey" do
      attribute :sql, TranslationLiteralText
    end

    value_object "TranslationBackfill" do
      attribute :name,    TranslationName
      attribute :default, TranslationLiteralText
    end

    command "Declare" do
      role "Deployment"
      goal "Open one aggregate's own move from one pinned era to the next"

      attribute :translation_ref, TranslationIdentity
      attribute :name, TranslationAggregateName
      attribute :was,  TranslationName, optional: true

      sets :translation_ref
      sets :name
      sets :was

      emits "TranslationAggregateDeclared"
    end

    command "AddRename" do
      role "Deployment"
      goal "Move data at an old field name to its new one, unchanged"

      attribute :from, TranslationName
      attribute :to,   TranslationName

      sets :renames, append: { from: :from, to: :to }

      emits "TranslationRenameAdded"
    end

    command "AddMove" do
      role "Deployment"
      goal "Move data at an old path to a new one, unchanged"

      attribute :from, TranslationName
      attribute :to,   TranslationName

      sets :moves, append: { from: :from, to: :to }

      emits "TranslationMoveAdded"
    end

    command "AddConvert" do
      role "Deployment"
      goal "Move data at an old path to a new one, translating its own values through an exhaustive table"

      attribute :from,   TranslationName
      attribute :to,     TranslationName
      attribute :values, TranslationLiteralText

      sets :converts, append: { from: :from, to: :to, values: :values }

      emits "TranslationConvertAdded"
    end

    command "AddDrop" do
      role "Deployment"
      goal "Acknowledge, deliberately, that a field's own data does not survive"

      attribute :value, TranslationName

      sets :drops, append: { value: :value }

      emits "TranslationDropAdded"
    end

    command "AddRetype" do
      role "Deployment"
      goal "Declare that an old type name and a new one mean the same shape"

      attribute :from, TranslationName
      attribute :to,   TranslationName

      sets :retypes, append: { from: :from, to: :to }

      emits "TranslationRetypeAdded"
    end

    command "AddCompute" do
      role "Deployment"
      goal "Move data at an old path to a new one, transformed by a real SQL expression"

      attribute :from, TranslationName
      attribute :to,   TranslationName
      attribute :sql,  TranslationLiteralText

      sets :computes, append: { from: :from, to: :to, sql: :sql }

      emits "TranslationComputeAdded"
    end

    command "AddRekey" do
      role "Deployment"
      goal "Recompute this aggregate's own identity by a real SQL expression"

      attribute :sql, TranslationLiteralText

      sets :rekeys, append: { sql: :sql }

      emits "TranslationRekeyAdded"
    end

    command "AddBackfill" do
      role "Deployment"
      goal "Name a newly required attribute and the value an existing record reads until written for real"

      attribute :name,    TranslationName
      attribute :default, TranslationLiteralText

      sets :backfills, append: { name: :name, default: :default }

      emits "TranslationBackfillAdded"
    end

    # Syntax seed rows for the words this aggregate spells; SyntaxBoot discovers them.
    value_object "KeywordSeed" do
      attribute :word,          String
      attribute :context,       String, admits: "Syntax::Context"
      attribute :body,          String, admits: "Syntax::Body"
      attribute :inner,         String
      attribute :opens,         String
      attribute :fills,         String
      attribute :status,        String, default: "admitted", admits: "Syntax::Status"
      attribute :was,           String
      attribute :resolves_via,  String, default: "", admits: "Syntax::ResolutionScope"
      attribute :disambiguator, String, default: "", admits: "Syntax::Disambiguator"

      member word: "rename",          context: "TranslationAggregate", body: "none", inner: "", opens: "", fills: "renames", calls: "rename_impl"
      member word: "move",            context: "TranslationAggregate", body: "none", inner: "", opens: "", fills: "moves", calls: "move_impl"
      member word: "convert",         context: "TranslationAggregate", body: "none", inner: "", opens: "", fills: "converts", calls: "convert_impl"
      member word: "drop",            context: "TranslationAggregate", body: "none", inner: "", opens: "", fills: "drops"
      member word: "retype",          context: "TranslationAggregate", body: "none", inner: "", opens: "", fills: "retypes", calls: "retype_impl"
      member word: "compute",         context: "TranslationAggregate", body: "none", inner: "", opens: "", fills: "computes", calls: "compute_impl"
      member word: "rekey",           context: "TranslationAggregate", body: "none", inner: "", opens: "", fills: "rekeys", calls: "rekey_impl"
      member word: "backfill",        context: "TranslationAggregate", body: "none", inner: "", opens: "", fills: "backfills", calls: "backfill_impl"
      member word: "unresolved",      context: "TranslationAggregate", body: "none", inner: "", opens: "", fills: "", calls: "unresolved_impl"

    end

    value_object "ArgumentSeed" do
      attribute :keyword,          String
      attribute :context,          String, admits: "Syntax::Context"
      attribute :at,               String
      attribute :named,            String
      attribute :kind,             String, admits: "Syntax::ArgumentKind"
      attribute :required,         String
      attribute :fills,            String
      attribute :selects,          String
      attribute :pair_key_fills,   String
      attribute :pair_value_fills, String
      attribute :pairs_shape,      String, admits: "Syntax::PairsShape"
      attribute :status,           String, default: "admitted", admits: "Syntax::Status"
      attribute :variadic,         String
      attribute :coerce,           String
      attribute :blank_message,    String

      member keyword: "rename",          context: "TranslationAggregate", at: "1", named: "", kind: "symbol", required: "true", fills: "old_name"
      member keyword: "rename",          context: "TranslationAggregate", at: "",  named: "to", kind: "symbol", required: "true", fills: "to"
      member keyword: "move",            context: "TranslationAggregate", at: "1", named: "", kind: "text", required: "true", fills: "old_path"
      member keyword: "move",            context: "TranslationAggregate", at: "",  named: "to", kind: "text", required: "true", fills: "to"
      member keyword: "convert",         context: "TranslationAggregate", at: "1", named: "", kind: "text", required: "true", fills: "old_path"
      member keyword: "convert",         context: "TranslationAggregate", at: "",  named: "to",      kind: "text",    required: "true", fills: "to"
      member keyword: "convert",         context: "TranslationAggregate", at: "",  named: "values",  kind: "literal", required: "true", fills: "values"
      member keyword: "drop",            context: "TranslationAggregate", at: "1", named: "",       kind: "symbol",  required: "true", fills: "name", blank_message: "a drop needs a name"
      member keyword: "retype",          context: "TranslationAggregate", at: "1", named: "",       kind: "text",    required: "true", fills: "old_type"
      member keyword: "retype",          context: "TranslationAggregate", at: "",  named: "to", kind: "text", required: "true", fills: "to"
      member keyword: "compute",         context: "TranslationAggregate", at: "1", named: "", kind: "text", required: "true", fills: "old_path"
      member keyword: "compute",         context: "TranslationAggregate", at: "",  named: "to",      kind: "text",    required: "true", fills: "to"
      member keyword: "compute",         context: "TranslationAggregate", at: "",  named: "sql",     kind: "text",    required: "true", fills: "sql"
      member keyword: "rekey",           context: "TranslationAggregate", at: "",  named: "sql",     kind: "text",    required: "true", fills: "sql"
      member keyword: "backfill",        context: "TranslationAggregate", at: "1", named: "", kind: "symbol", required: "true", fills: "name"
      member keyword: "backfill",        context: "TranslationAggregate", at: "",  named: "default", kind: "literal", required: "true", fills: "default"
      member keyword: "unresolved",      context: "TranslationAggregate", at: "1", named: "", kind: "symbol", required: "true", fills: "name"
      member keyword: "unresolved",      context: "TranslationAggregate", at: "",  named: "candidates", kind: "list", required: "false", fills: "candidates"

    end
  end
end
