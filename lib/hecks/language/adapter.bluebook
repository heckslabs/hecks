Hecks.bluebook "Adapter" do
  vision "The .adapter language, declared in itself. An adapter is a real, swappable implementation of one resource port — Memory, Postgres, Sqlite, and the rest — naming which fields (and which secrets) a world's own wiring for it must supply."
  core

  aggregate "Adapter" do
    description "One .adapter — a real implementation of one resource port, and the config values a world's own wiring must give it."

    identified_by AdapterName, as: :name

    attribute :port,    AdapterPortName
    attribute :fields,  list_of(AdapterField)
    attribute :secrets, list_of(AdapterField)
    attribute :answers, list_of(AnsweredQuery)
    attribute :runs,    PluginModule, optional: true
    # What this adapter can do beyond its port's contract, such as `set_transform`. Absent is
    # not empty: most adapters provide nothing more.
    attribute :provides, list_of(AdapterCapability)

    # **A plugin answers named queries** — one that `runs` a wasm module says which queries it
    # answers, each qualified by chapter and aggregate, and the runtime binds them to it.
    invariant("only a plugin answers queries") do
      answers.unset? || answers.size == 0 || !runs.unset?
    end

    value_object "AdapterName" do
      attribute :value, String
      invariant("an adapter names itself") { !value.to_s.empty? }
    end

    value_object "AdapterPortName" do
      attribute :value, String
      invariant("an adapter's port name says something") { !value.to_s.empty? }
    end

    value_object "AdapterField" do
      attribute :value,   String
      attribute :default, String, optional: true
      invariant("a field names itself") { !value.to_s.empty? }
    end

    # A query a plugin answers, written in full: `Calendar::Event.Occurrences`.
    value_object "AnsweredQuery" do
      attribute :value, String, pattern: '^[A-Z][A-Za-z0-9]*::[A-Z][A-Za-z0-9]*\.[A-Z][A-Za-z0-9]*$'
    end

    # A capability an adapter provides, named in snake case: `set_transform`.
    value_object "AdapterCapability" do
      attribute :value, String, pattern: '^[a-z][a-z0-9_]*$'
    end

    # The wasm module a plugin runs: a file beside its `.adapter`, never a path out of it.
    value_object "PluginModule" do
      attribute :value, String, pattern: '^[a-z0-9_-]+\.wasm$'
    end

    # The text of a field's declared default, such as `"data"` or `true`. A `{name}` in a string
    # is filled from the aggregate the adapter is built for, so it names only what the framework
    # can supply.
    value_object "AdapterFieldDefault" do
      attribute :value, String, pattern: '^(?:[^{}]|\{(?:name|storage_name)\})*$'
    end

    command "Declare" do
      role "Deployment"
      goal "Register a real implementation of one resource port"

      attribute :name, AdapterName
      # Optional: an adapter may declare only fields or secrets and never name a port.
      attribute :port, AdapterPortName, optional: true
      # Optional: only a plugin runs a wasm module.
      attribute :runs, PluginModule, optional: true

      sets :name
      sets :port
      sets :runs

      emits "AdapterDeclared"
    end

    command "AddField" do
      role "Deployment"
      goal "Name a value this adapter's own world-level wiring must supply"

      reference_to Adapter
      attribute :value,   AdapterField
      attribute :default, AdapterFieldDefault, optional: true

      sets :fields, append: { value: :value, default: :default }

      emits "AdapterFieldAdded"
    end

    command "AddSecret" do
      role "Deployment"
      goal "Name a SENSITIVE value this adapter's own world-level wiring must supply, kept apart from plain fields"

      reference_to Adapter
      attribute :value, AdapterField

      sets :secrets, append: { value: :value }

      emits "AdapterSecretAdded"
    end

    command "AnswerQuery" do
      role "Deployment"
      goal "Name a query this plugin answers, so the runtime binds it without a hecksagon line"

      reference_to Adapter
      attribute :value, AnsweredQuery

      sets :answers, append: { value: :value }

      emits "AdapterQueryAnswered"
    end

    command "Provide" do
      role "Deployment"
      goal "Name a capability this adapter provides, so the runtime can ask for it before relying on it"

      reference_to Adapter
      attribute :value, AdapterCapability

      sets :provides, append: { value: :value }

      emits "AdapterCapabilityProvided"
    end

    # Grammar rows for the `adapter` keyword; SyntaxBoot discovers aggregate-local seed tables.
    value_object "KeywordSeed" do
      attribute :word,          String
      attribute :context,       String, admits: "Syntax::Context"
      attribute :body,          String, admits: "Syntax::Body"
      attribute :inner,         String
      attribute :opens,         String
      attribute :fills,         String
      attribute :status,        String, default: "admitted", admits: "Syntax::Status"
      attribute :was,           String
      attribute :resolves_via,  String, default: "", admits: "Syntax::ResolutionScope"
      attribute :disambiguator, String, default: "", admits: "Syntax::Disambiguator"

      member word: "adapter",         context: "File",     body: "keywords", inner: "Adapter",        opens: "Adapter",        fills: ""
      member word: "port",            context: "Adapter",   body: "none", inner: "", opens: "", fills: "port"
      member word: "field",           context: "Adapter",   body: "none", inner: "", opens: "", fills: "fields"
      member word: "secret",          context: "Adapter",   body: "none", inner: "", opens: "", fills: "secrets"
      member word: "answers_query",   context: "Adapter",   body: "none", inner: "", opens: "", fills: "answers"
      member word: "runs",            context: "Adapter",   body: "none", inner: "", opens: "", fills: "runs"


      member word: "provides", context: "Adapter", body: "none", inner: "", opens: "", fills: "provides"
    end

    value_object "ArgumentSeed" do
      attribute :keyword,          String
      attribute :context,          String, admits: "Syntax::Context"
      attribute :at,               String
      attribute :named,            String
      attribute :kind,             String, admits: "Syntax::ArgumentKind"
      attribute :required,         String
      attribute :fills,            String
      attribute :selects,          String
      attribute :pair_key_fills,   String
      attribute :pair_value_fills, String
      attribute :pairs_shape,      String, admits: "Syntax::PairsShape"
      attribute :status,           String, default: "admitted", admits: "Syntax::Status"
      attribute :variadic,         String
      attribute :coerce,           String
      attribute :blank_message,    String

      member keyword: "adapter",         context: "File", at: "1", named: "", kind: "text", required: "true", fills: "name"
      member keyword: "port",            context: "Adapter", at: "1", named: "", kind: "text",   required: "true", fills: "port"
      member keyword: "field",           context: "Adapter", at: "1", named: "", kind: "symbol", required: "true", fills: "fields"
      member keyword: "field",           context: "Adapter", at: "",  named: "default", kind: "literal", required: "false", fills: "default"
      member keyword: "secret",          context: "Adapter", at: "1", named: "", kind: "symbol", required: "true", fills: "secrets"
      member keyword: "answers_query",   context: "Adapter", at: "1", named: "", kind: "text",   required: "true", fills: "answers"
      member keyword: "runs",            context: "Adapter", at: "1", named: "", kind: "text",   required: "true", fills: "runs"


      member keyword: "provides", context: "Adapter", at: "1", named: "", kind: "text", required: "true", fills: "provides"
    end
  end
end
