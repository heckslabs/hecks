Hecks.bluebook "Sentence" do
  vision "The plain sentences a business author writes in a .bluebook, declared as data. Each phrase is one row; the Rust parser's sentence front end is generated from them, so what an author may say is a table, not code."
  core

  aggregate "Phrase" do
    description "One sentence an author may write, with the block it is legal in and the block it opens. A phrase reaches the parser only while it is admitted."

    identified_by PhraseId, as: :name

    attribute :context, PhraseContext
    attribute :pattern, PhrasePattern

    value_object "PhraseId" do
      attribute :value, String
      invariant("a phrase names itself") { !value.to_s.empty? }
    end

    value_object "PhraseContext" do
      attribute :value, String
      invariant("a phrase says where it is legal") { !value.to_s.empty? }
    end

    # Literal words and punctuation, `(a|an)` for alternatives, `{slot:kind}` for what the author fills in. A slot kind
    # is words (a noun phrase), word (one word), text (a quoted string), int, list (nouns joined by `and` or a comma),
    # rest (the remainder of the line), path (a dotted field path) or event (a CamelCase event name).
    value_object "PhrasePattern" do
      attribute :value, String
      invariant("a phrase says something") { !value.to_s.empty? }
    end

    lifecycle :status, default: "admitted" do
      transition "Retire" => "retired", from: "admitted"
      mark :terminal, "retired"
    end

    command "Retire" do
      role "Language"
      goal "Stop accepting a phrase; files that use it are refused with the nearest phrases"

      reference_to Phrase

      emits "PhraseRetired"
    end

    # One row per sentence. `opens` names the block the sentence starts ("" when it is a plain line);
    # `canonical` is the one spelling the formatter writes when several rows say the same thing.
    value_object "PhraseSeed" do
      attribute :id,        String
      attribute :context,   String
      attribute :pattern,   String
      attribute :opens,     String
      attribute :canonical, String, default: "yes"
      attribute :status,    String, default: "admitted"

      member id: "domain",            context: "File",      pattern: "Domain: {name:words}",                                                  opens: "Domain"
      member id: "classification",    context: "Vision",    pattern: "This is a {kind:word} domain",                                          opens: ""
      member id: "namespace",         context: "Vision",    pattern: "Its module is {name:rest}",                                             opens: ""
      member id: "version",           context: "Vision",    pattern: "Its version is {version:word}",                                       opens: ""
      member id: "attaches",          context: "Vision",    pattern: "It attaches to {contexts:list}",                                        opens: ""
      member id: "provides",          context: "Vision",    pattern: "It provides {capability:word}:",                                        opens: "Provides"
      member id: "provision",         context: "Provides",  pattern: "{key:word} is {verb:rest}",                                             opens: ""
      member id: "aggregate",         context: "Domain",    pattern: "Aggregate: {name:words}",                                               opens: "Aggregate"
      member id: "identity",          context: "Aggregate", pattern: "(a|an|the) {owner:words} is identified by (its|their) {fields:list}",  opens: ""
      member id: "has",               context: "Aggregate", pattern: "It has:",                                                              opens: "Has"
      member id: "value_object",      context: "Aggregate", pattern: "(a|an|the) {name:words} has a value: {type:words}",                     opens: "ValueObject"
      member id: "value_object_with", context: "Aggregate", pattern: "(a|an|the) {name:words} has a value: {type:words}, {options:rest}",       opens: "ValueObject"
      member id: "closed_set",        context: "Aggregate", pattern: "(a|an|the) {name:words} is one of: {values:list}",                       opens: "ValueObject"
      member id: "closed_set_named",  context: "Aggregate", pattern: "(a|an|the) {name:words} has (a|an) {attr:words} that is one of: {values:list}", opens: "ValueObject"
      member id: "value_fields",      context: "Aggregate", pattern: "(a|an|the) {name:words} has:",                                           opens: "Fields"
      member id: "field",             context: "Fields",    pattern: "(a|an|the|some) {name:words}: {type:words}",                                 opens: ""
      member id: "field_with",        context: "Fields",    pattern: "(a|an|the|some) {name:words}: {type:words}, {options:rest}",                 opens: ""
      member id: "field_rule",        context: "Fields",    pattern: "Rule {description:text} holds when {condition:rest}",                   opens: ""
      member id: "field_member",      context: "Fields",    pattern: "Member {pairs:rest}",                                                    opens: ""
      member id: "lifecycle",         context: "Aggregate", pattern: "Lifecycle: {field:words}, starting as {state:word}",                    opens: "Lifecycle"
      member id: "command",           context: "Aggregate", pattern: "Command: {name:words}",                                                 opens: "Command"
      member id: "query",             context: "Aggregate", pattern: "Query: {name:words}",                                                   opens: "Query"
      member id: "entity",            context: "Aggregate", pattern: "Entity: {name:words}",                                                   opens: "Aggregate"
      member id: "aggregate_provenance", context: "Aggregate", pattern: "Its provenance is {value:rest}",                                    opens: ""
      member id: "aggregate_rule",    context: "Aggregate", pattern: "Rule {description:text} holds when {condition:rest}",                   opens: ""
      member id: "precondition",      context: "Aggregate", pattern: "Precondition {description:text} holds when {condition:rest}",           opens: ""
      member id: "projected",         context: "Aggregate", pattern: "It shows {name:words} as the {remote:words} of the {reference:words}",  opens: ""
      member id: "attribute",         context: "Has",       pattern: "(a|an|the|some) {name:words}: {type:words}",                                 opens: ""
      member id: "attribute_with",    context: "Has",       pattern: "(a|an|the|some) {name:words}: {type:words}, {options:rest}",                 opens: ""
      member id: "rule",              context: "ValueObject", pattern: "Rule {description:text} holds when {condition:rest}",                 opens: ""
      member id: "transition",        context: "Lifecycle", pattern: "{command:words} moves (a|an|the) {owner:words} from {from:word} to {to:word}", opens: ""
      member id: "marks",             context: "Lifecycle", pattern: "Mark {mark:word}: {states:list}",                                       opens: ""
      member id: "goal",              context: "Command",   pattern: "Goal: {goal:rest}",                                                     opens: ""
      member id: "role",              context: "Command",   pattern: "Who: {role:words}",                                                     opens: ""
      member id: "acts_on",           context: "Command",   pattern: "It acts on (a|an) existing {owner:words}",                              opens: ""
      member id: "arguments",         context: "Command",   pattern: "When {names:list} (is|are) given",                                      opens: ""
      member id: "given",             context: "Command",   pattern: "Given {description:text} holds when {condition:rest}",                  opens: ""
      member id: "sets",              context: "Command",   pattern: "(Then|And) {names:list} (is|are) set",                                  opens: ""
      member id: "set_to",            context: "Command",   pattern: "(Then|And) the {target:words} is set to the {source:words}",             opens: ""
      member id: "set_to_literal",    context: "Command",   pattern: "(Then|And) the {target:words} is set to {value:rest}",                   opens: ""
      member id: "set_to_state",      context: "Command",   pattern: "(Then|And) the {target:words} is set to what the {source:words} was",    opens: ""
      member id: "set_to_result",     context: "Command",   pattern: "(Then|And) the {target:words} is set to the result of {code:rest}",      opens: ""
      member id: "go_up",             context: "Command",   pattern: "(Then|And) the {target:words} goes up by the {source:words}",            opens: ""
      member id: "go_up_by",          context: "Command",   pattern: "(Then|And) the {target:words} goes up by {value:rest}",                  opens: ""
      member id: "go_down",           context: "Command",   pattern: "(Then|And) the {target:words} goes down by the {source:words}",          opens: ""
      member id: "go_down_by",        context: "Command",   pattern: "(Then|And) the {target:words} goes down by {value:rest}",                opens: ""
      member id: "multiply",          context: "Command",   pattern: "(Then|And) the {target:words} is multiplied by the {source:words}",      opens: ""
      member id: "remove",            context: "Command",   pattern: "(Then|And) the {source:words} is removed from the {target:words}",       opens: ""
      member id: "add_row",           context: "Command",   pattern: "(Then|And) a row is added to the {target:words} with {fields:rest}",    opens: ""
      member id: "delegates",         context: "Command",   pattern: "(Then|And) the {entity:words} is told to {command:words} with {fields:rest}", opens: ""
      member id: "corrects",          context: "Command",   pattern: "(Then|And) {event:event} is corrected with {fields:rest}",               opens: ""
      member id: "clamp",             context: "Command",   pattern: "(Then|And) the {target:words} is kept between {low:int} and {high:int}", opens: ""
      member id: "from_states",       context: "Command",   pattern: "It can only happen from {states:list}",                                  opens: ""
      member id: "idempotent",        context: "Command",   pattern: "It is safe to deliver twice",                                           opens: ""
      member id: "command_provenance", context: "Command", pattern: "Its provenance is {value:rest}",                                        opens: ""
      member id: "ensures",           context: "Command",   pattern: "Afterwards {description:text} holds when {condition:rest}",              opens: ""
      member id: "takes",             context: "Command",   pattern: "It takes:",                                                              opens: "Has"
      member id: "announces",         context: "Command",   pattern: "(Then|And) {event:event} is announced",                                 opens: ""
      member id: "where_is",          context: "Query",     pattern: "Where the {field:words} is {value:rest}",                         opens: ""
      member id: "where_is_not",      context: "Query",     pattern: "Where the {field:words} is not {value:rest}",                     opens: ""
      member id: "where_over",        context: "Query",     pattern: "Where the {field:words} is more than {value:rest}",               opens: ""
      member id: "where_at_least",    context: "Query",     pattern: "Where the {field:words} is at least {value:rest}",                opens: ""
      member id: "where_under",       context: "Query",     pattern: "Where the {field:words} is less than {value:rest}",               opens: ""
      member id: "where_at_most",     context: "Query",     pattern: "Where the {field:words} is at most {value:rest}",                 opens: ""
      member id: "where_has",         context: "Query",     pattern: "Where the {field:words} contains {value:rest}",                   opens: ""
      member id: "where_in",          context: "Query",     pattern: "Where the {field:words} is one of {values:list}",                 opens: ""
      member id: "query_takes",       context: "Query",     pattern: "It takes:",                                                       opens: "Has"
      member id: "query_limit",       context: "Query",     pattern: "Limited to {n:int}",                                              opens: ""
      member id: "query_skip",        context: "Query",     pattern: "Skipping the first {n:int}",                                            opens: ""
      member id: "query_cursor",      context: "Query",     pattern: "A caller walks it a page at a time by the {field:words}",              opens: ""
      member id: "query_nulls",       context: "Query",     pattern: "Empty values come {position:word}",                                     opens: ""
      member id: "query_access",      context: "Query",     pattern: "Access is checked by {policy:words}",                                   opens: ""
      member id: "query_access_for",  context: "Query",     pattern: "Access is checked by {policy:words} for each {tenant:words}",           opens: ""
      member id: "query_inspect",     context: "Query",     pattern: "It can be inspected as {mode:word}",                                    opens: ""
      member id: "where_none_in",     context: "Query",     pattern: "Where the {field:words} has no {aggregate:words} in {state:word}",      opens: ""
      member id: "query_returns",     context: "Query",     pattern: "It returns {type:words}",                                         opens: ""
      member id: "query_returns_list", context: "Query",    pattern: "It returns list of {type:words}",                                 opens: ""
      member id: "order",             context: "Query",     pattern: "Ordered by {path:path}, {direction:word}",                              opens: ""
      member id: "not_empty",         context: "Condition", pattern: "the {field:words} is not empty",                                        opens: ""
      member id: "at_least",          context: "Condition", pattern: "the {field:words} is at least {n:int}",                                 opens: ""
      member id: "equals",            context: "Condition", pattern: "the {field:words} is {value:word}",                                     opens: ""
      member id: "expression",        context: "Condition", pattern: "this is true: {code:rest}",                                             opens: ""
      member id: "policy",            context: "Domain",    pattern: "Policy: {name:words}",                                                 opens: "Policy"
      member id: "report",            context: "Domain",    pattern: "Report: {name:words}",                                                   opens: "Report"
      member id: "process",           context: "Domain",    pattern: "Process: {name:words}",                                                  opens: "Process"
      member id: "process_matched",   context: "Process",   pattern: "It is matched up by {path:path}",                                       opens: ""
      member id: "process_starts",    context: "Process",   pattern: "It starts when {event:event} is announced",                             opens: ""
      member id: "process_ends",      context: "Process",   pattern: "It ends when {event:event} is announced",                               opens: ""
      member id: "process_when",      context: "Process",   pattern: "When {event:event} is announced and it is {from:word}, it moves to {to:word}", opens: "Handler"
      member id: "process_when_refused", context: "Process", pattern: "When it is refused and it is {from:word}, it moves to {to:word}",     opens: "Handler"
      member id: "process_tell",      context: "Handler",   pattern: "Then the {owner:words} is told to {command:words}",                      opens: ""
      member id: "process_tell_with", context: "Handler",   pattern: "Then the {owner:words} is told to {command:words} with {fields:rest}",  opens: ""
      member id: "process_undo",      context: "Handler",   pattern: "If that is refused, the {owner:words} is told to {command:words}",       opens: ""
      member id: "process_undo_with", context: "Handler",   pattern: "If that is refused, the {owner:words} is told to {command:words} with {fields:rest}", opens: ""
      member id: "includes",          context: "Report",    pattern: "It includes (a|an|the) {name:words}",                                   opens: ""
      member id: "includes_as",       context: "Report",    pattern: "It includes (a|an|the) {name:words} as (a|an|the) {as:words}",           opens: ""
      member id: "about",             context: "Report",    pattern: "It is about (a|an|the) {target:words}",                                  opens: ""
      member id: "about_as",          context: "Report",    pattern: "It is about (a|an|the) {target:words} as (a|an|the) {as:words}",         opens: ""
      member id: "groups",            context: "Report",    pattern: "It groups by {fields:list}",                                             opens: ""
      member id: "counts",            context: "Report",    pattern: "It counts them",                                                         opens: ""
      member id: "sums",              context: "Report",    pattern: "It adds up the {field:words}",                                           opens: ""
      member id: "averages",          context: "Report",    pattern: "It averages the {field:words}",                                          opens: ""
      member id: "lowest",            context: "Report",    pattern: "It finds the lowest {field:words}",                                      opens: ""
      member id: "highest",           context: "Report",    pattern: "It finds the highest {field:words}",                                     opens: ""
      member id: "median",            context: "Report",    pattern: "It finds the median {field:words}",                                      opens: ""
      member id: "percentile",        context: "Report",    pattern: "It finds the {at:text} percentile of the {field:words}",                 opens: ""
      member id: "any_holds",         context: "Report",    pattern: "It checks if any {field:words} holds",                                   opens: ""
      member id: "all_hold",          context: "Report",    pattern: "It checks if all {field:words} hold",                                    opens: ""
      member id: "report_where",      context: "Report",    pattern: "Where {condition:rest}",                                                 opens: ""
      member id: "report_order",      context: "Report",    pattern: "Ordered by {path:path}, {direction:word}",                               opens: ""
      member id: "report_limit",      context: "Report",    pattern: "Limited to {n:int}",                                                     opens: ""
      member id: "report_skip",       context: "Report",    pattern: "Skipping the first {n:int}",                                            opens: ""
      member id: "report_cursor",     context: "Report",    pattern: "A caller walks it a page at a time by the {field:words}",              opens: ""
      member id: "report_nulls",      context: "Report",    pattern: "Empty values come {position:word}",                                     opens: ""
      member id: "report_access",     context: "Report",    pattern: "Access is checked by {policy:words}",                                   opens: ""
      member id: "report_access_for", context: "Report",    pattern: "Access is checked by {policy:words} for each {tenant:words}",           opens: ""
      member id: "report_inspect",    context: "Report",    pattern: "It can be inspected as {mode:word}",                                    opens: ""
      member id: "whenever",          context: "Policy",    pattern: "Whenever {event:event} is announced",                                   opens: ""
      member id: "whenever_by",       context: "Policy",    pattern: "Whenever {event:event} is announced by (a|an) {owner:words}",           opens: ""
      member id: "whenever_outside",  context: "Policy",    pattern: "Whenever the outside announces {event:event}",                         opens: ""
      member id: "for_each",          context: "Policy",    pattern: "For each {query:words} of the {owner:words}",                          opens: ""
      member id: "only_when",         context: "Policy",    pattern: "Only when {condition:rest}",                                            opens: ""
      member id: "policy_tell",       context: "Policy",    pattern: "Then the {owner:words} is told to {command:words}",                  opens: ""
      member id: "policy_across",     context: "Policy",    pattern: "It crosses into the {domain:words} domain",                            opens: ""
      member id: "policy_undelivered", context: "Policy",   pattern: "It is expected to go undelivered",                                      opens: ""
      member id: "with_same",         context: "Policy",    pattern: "With the {key:words}",                                                  opens: ""
      member id: "with_from",         context: "Policy",    pattern: "With the {key:words} from the {from:words}",                            opens: ""
      member id: "with_as",           context: "Policy",    pattern: "With the {key:words} as {value:rest}",                                  opens: ""
      member id: "runs_with",         context: "Policy",    pattern: "Then {command:words} runs with {fields:list}",                          opens: ""
      member id: "runs",              context: "Policy",    pattern: "Then {command:words} runs",                                             opens: ""
      member id: "asked_with",        context: "Policy",    pattern: "Then {need:words} is asked with {fields:list}",                         opens: ""
      member id: "asked",             context: "Policy",    pattern: "Then {need:words} is asked",                                            opens: ""
      member id: "examples_for",      context: "ExamplesFile", pattern: "Examples for: {name:words}",                                       opens: "Examples"
      member id: "background",        context: "Examples",  pattern: "Background:",                                                           opens: "Background"
      member id: "example",           context: "Examples",  pattern: "Example: {title:rest}",                                                 opens: "Example"
      member id: "person_role",       context: "Background", pattern: "{person:words} is (a|an) {role:words}",                                opens: ""
      member id: "given_step",        context: "Example",   pattern: "Given {step:rest}",                                                     opens: ""
      member id: "when_step",         context: "Example",   pattern: "When {step:rest}",                                                      opens: ""
      member id: "then_outcome",      context: "Example",   pattern: "Then {outcome:rest}",                                                   opens: ""
      member id: "and_line",          context: "Example",   pattern: "And {line:rest}",                                                       opens: ""
      member id: "where_table",       context: "Example",   pattern: "Where:",                                                                opens: "Table"
      member id: "step_creates",      context: "Step",      pattern: "{who:words} {verb:word} (a|an) {noun:words} with {args:rest}",           opens: ""
      member id: "step_creates_bare", context: "Step",      pattern: "{who:words} {verb:word} (a|an) {noun:words}",                            opens: ""
      member id: "step_acts",         context: "Step",      pattern: "{who:words} {verb:word} it with {args:rest}",                            opens: ""
      member id: "step_acts_bare",    context: "Step",      pattern: "{who:words} {verb:word} it",                                             opens: ""
      member id: "step_tries_creates", context: "Step",     pattern: "{who:words} tries to {verb:word} (a|an) {noun:words} with {args:rest}",  opens: ""
      member id: "step_tries_creates_bare", context: "Step", pattern: "{who:words} tries to {verb:word} (a|an) {noun:words}",                  opens: ""
      member id: "step_tries_acts",   context: "Step",      pattern: "{who:words} tries to {verb:word} it with {args:rest}",                   opens: ""
      member id: "step_tries_acts_bare", context: "Step",   pattern: "{who:words} tries to {verb:word} it",                                    opens: ""
      member id: "outcome_state",     context: "Outcome",   pattern: "the {noun:words} is {state:word}",                                      opens: ""
      member id: "outcome_announced", context: "Outcome",   pattern: "{event:event} is announced",                                            opens: ""
      member id: "outcome_refused_role", context: "Outcome", pattern: "it is refused because only (a|an) {role:words} may do it",             opens: ""
      member id: "outcome_refused",   context: "Outcome",   pattern: "it is refused because {reason:rest}",                                   opens: ""
    end
  end
end
