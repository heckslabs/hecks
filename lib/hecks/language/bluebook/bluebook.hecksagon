# The bluebook language as an ordinary domain, so it can be booted, fuzzed and model-checked.
# Memory: this chapter is read, never written to a store.
Hecks.hecksagon "Bluebook" do
  # `role "Language"` is real access control only once Governance can check it (S8).
  uses_framework "Governance"
  persisted_by "Memory"
end

Hecks.hecksagon "Governance" do
  Governance::RoleAssignment.persisted_by("Memory")
  Governance::RoleTransition.persisted_by("Memory")
end
