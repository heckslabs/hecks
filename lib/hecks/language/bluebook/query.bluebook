Hecks.bluebook "Bluebook" do
  aggregate "Query" do
    description "One query declared on an aggregate — what it filters on, how it orders, and how many it returns."

    reference_to Aggregate

    # Which piece declared it — see Command's entity_id.
    reference_to Entity, as: :entity_id, optional: true

    # The immediate owner and its name, derived as Command does: an entity's asks are its own.
    identified_by :owner_id, :name

    attribute :name,        QueryName
    attribute :description, QueryText
    attribute :order_field, QueryText
    attribute :order_way,   QueryText
    attribute :limit,       QueryText
    # The value object that shapes an answer given from outside the domain, spelled as written:
    # `Name` or `list_of(Name)`. Empty when the answer is the aggregate's own row.
    attribute :returns,     QueryText
    attribute :wheres,      list_of(Filter)
    attribute :attributes,  list_of(AskArgument)
    # Outside facts the runtime supplies before the filter reads the arguments (ADR 0081): `needs :now`.
    attribute :needs,       list_of(Need)
    # Every other option a query carries, as an open map: rows of option name, key within it, and
    # value. No value object can hold a map, so options ride as a list on the ask.
    attribute :options,     list_of(AskOption)

    value_object "QueryName" do
      attribute :value, String
      invariant("a query is named") { !value.to_s.empty? }
    end

    value_object "QueryText" do
      attribute :value, String
    end

    value_object "Need" do
      attribute :fact, String
    end

    value_object "FactName" do
      attribute :value, String
    end

    value_object "Filter" do
      attribute :field, String
      # The comparator set is declared by the language (Vocabulary::QueryComparator).
      attribute :op,    String, admits: "Vocabulary::QueryComparator"
      attribute :value, String
    end

    value_object "AskArgument" do
      attribute :name,    String
      attribute :type,    String
      attribute :list,    String
      attribute :optional, String, optional: true
      attribute :pattern,  String, optional: true
      # optional: a declaration with no default has none
      attribute :default, String, optional: true
      # The closed set this value must belong to — see Aggregate::Field.
      attribute :admits, String, optional: true
      attribute :relationship, String, optional: true
    end

    # One entry of one option. `option` names which specification it belongs to
    # (offset, freshness, authorization), `key` the part within it (value, mode,
    # max_age, policy, tenant), and `value` what was declared. A single-valued
    # option is one row ; a compound is one row per part ; a repeated one — an index
    # hint — is one row per occurrence, told apart by `at`.
    value_object "AskOption" do
      attribute :option, String
      attribute :key,    String
      attribute :value,  String
      # optional: only a repeated option (an index hint) carries an `at`
      attribute :at,     String, optional: true
    end

    # Declaration order among siblings. The IR is read index for index, so the language
    # holds it rather than inheriting whatever order a store iterates.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :aggregate, QueryText
      where(aggregate: :aggregate)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open a query on an aggregate"

      reference_to Aggregate
      # Declared on an aggregate or on one of its entities — see Command.Declare.
      reference_to Entity, as: :entity_id, optional: true
      attribute :name,        QueryName
      attribute :description, QueryText, optional: true
      attribute :order_field, QueryText, optional: true
      attribute :order_way,   QueryText, optional: true
      attribute :limit,       QueryText, optional: true
      attribute :returns,     QueryText, optional: true

      attribute :position, Position, optional: true
      sets :aggregate
      sets :entity_id
      sets :name
      sets :description
      sets :order_field
      sets :order_way
      sets :limit
      sets :returns
      sets :position
      emits AskDeclared
    end

    command "Filter" do
      role "Language"
      goal "Attach one where-clause to the query"

      attribute :field, QueryText
      # The same word at the same entry point — see Command.Change.op.
      attribute :op,    QueryText, admits: "Vocabulary::QueryComparator"
      attribute :value, QueryText

      sets :wheres, append: { field: :field, op: :op, value: :value }

      emits FilterAttached
    end

    command "Option" do
      role "Language"
      goal "Attach one part of one specification option to the query"

      attribute :option, QueryText
      attribute :key,    QueryText
      # An option may have no value: `consistency :snapshot` with no timeout is complete, and
      # options are judged one key at a time.
      attribute :value,  QueryText, optional: true
      attribute :at,     QueryText, optional: true

      given("an option is named") { !option.value.to_s.empty? }

      sets :options, append: { option: :option, key: :key, value: :value, at: :at }

      emits OptionAttached
    end

    command "Need" do
      role "Language"
      goal "Name an outside fact the runtime supplies before the query's filter reads its arguments"

      attribute :fact, FactName

      given("a fact is named") { !fact.value.to_s.empty? }

      sets :needs, append: { fact: :fact }

      emits AskNeedNamed
    end

    command "Argument" do
      role "Language"
      goal "Attach one parameter to the query"

      attribute :name,    QueryText
      attribute :type,    QueryText
      attribute :list,    QueryText
      attribute :optional, QueryText, optional: true
      attribute :pattern,  QueryText, optional: true
      attribute :default, QueryText, optional: true
      attribute :admits,  QueryText, optional: true
      # See Command.Argument's :relationship: keeps reference-typed arguments in the round trip.
      attribute :relationship, QueryText, optional: true

      sets :attributes, append: { name: :name, type: :type, list: :list, default: :default, optional: :optional, pattern: :pattern, admits: :admits, relationship: :relationship }

      emits AskArgumentAttached
    end


    # Keyword and argument rows for queries; SyntaxBoot discovers every aggregate-local seed table.
    value_object "KeywordSeed" do
      attribute :word,          String
      attribute :context,       String, admits: "Syntax::Context"
      attribute :body,          String, admits: "Syntax::Body"
      attribute :inner,         String
      attribute :opens,         String
      attribute :fills,         String
      attribute :status,        String, default: "admitted", admits: "Syntax::Status"
      attribute :was,           String
      attribute :resolves_via,  String, default: "", admits: "Syntax::ResolutionScope"
      attribute :disambiguator, String, default: "", admits: "Syntax::Disambiguator"

      member word: "description",     context: "Query", body: "none", inner: "", opens: "", fills: "description"
      member word: "attribute",       context: "Query", body: "none", inner: "", opens: "", fills: "attributes", calls: "attribute_impl"
      member word: "reference_to",    context: "Query", body: "none", inner: "", opens: "", fills: "attributes", calls: "reference_to_impl"
      member word: "where",           context: "Query", body: "none", inner: "", opens: "", fills: "wheres", calls: "where_impl"
      member word: "order_by",        context: "Query", body: "none", inner: "", opens: "", fills: "order_field", calls: "order_by_impl"
      member word: "authorize",       context: "Query", body: "none", inner: "", opens: "", fills: "options", calls: "authorize_impl"
      member word: "inspect_query",   context: "Query", body: "none", inner: "", opens: "", fills: "options"
      member word: "returns",         context: "Query", body: "none", inner: "", opens: "", fills: "returns"
      member word: "needs",           context: "Query", body: "none", inner: "", opens: "", fills: "needs", calls: "needs_impl"

    end

    value_object "ArgumentSeed" do
      attribute :keyword,          String
      attribute :context,          String, admits: "Syntax::Context"
      attribute :at,               String
      attribute :named,            String
      attribute :kind,             String, admits: "Syntax::ArgumentKind"
      attribute :required,         String
      attribute :fills,            String
      attribute :selects,          String
      attribute :pair_key_fills,   String
      attribute :pair_value_fills, String
      attribute :pairs_shape,      String, admits: "Syntax::PairsShape"
      attribute :status,           String, default: "admitted", admits: "Syntax::Status"
      attribute :variadic,         String
      attribute :coerce,           String
      attribute :blank_message,    String

      member keyword: "description",     context: "Query", at: "1", named: "",         kind: "text",     required: "true",  fills: "description", coerce: "false"
      member keyword: "attribute",       context: "Query", at: "1", named: "",         kind: "symbol",   required: "true",  fills: "name"
      member keyword: "attribute",       context: "Query", at: "2", named: "",         kind: "constant", required: "true",  fills: "type"
      member keyword: "attribute",       context: "Query", at: "",  named: "default",  kind: "literal",  required: "false", fills: "default"
      member keyword: "attribute",       context: "Query", at: "",  named: "optional", kind: "flag",     required: "false", fills: "optional"
      member keyword: "attribute",       context: "Query", at: "",  named: "pattern",  kind: "text",     required: "false", fills: "pattern"
      member keyword: "attribute",       context: "Query", at: "",  named: "admits",   kind: "text",     required: "false", fills: "admits"
      member keyword: "attribute",       context: "Query", at: "",  named: "one_of",   kind: "list",     required: "false", fills: "one_of"
      member keyword: "reference_to",    context: "Query", at: "1", named: "",         kind: "constant", required: "true",  fills: "type"
      member keyword: "reference_to",    context: "Query", at: "",  named: "as",       kind: "symbol",   required: "false", fills: "name"
      member keyword: "reference_to",    context: "Query", at: "",  named: "optional", kind: "flag",     required: "false", fills: "optional"
      member keyword: "where",           context: "Query", at: "1", named: "",         kind: "pairs",    required: "true",  fills: "wheres", pair_key_fills: "field", pair_value_fills: "value", pairs_shape: "elements"
      member keyword: "order_by",        context: "Query", at: "1", named: "",         kind: "symbol",   required: "true",  fills: "order_field"
      member keyword: "order_by",        context: "Query", at: "2", named: "",         kind: "symbol",   required: "false", fills: "order_way"
      member keyword: "authorize",       context: "Query", at: "1", named: "",         kind: "symbol",   required: "true",  fills: "policy"
      member keyword: "authorize",       context: "Query", at: "",  named: "tenant",   kind: "symbol",   required: "false", fills: "tenant"
      member keyword: "inspect_query",   context: "Query", at: "1", named: "",         kind: "symbol",   required: "false", fills: "mode"
      member keyword: "returns",         context: "Query", at: "1", named: "",         kind: "constant", required: "true",  fills: "type"
      member keyword: "needs",           context: "Query", at: "1", named: "",         kind: "symbol",   required: "true",  fills: "fact"

    end
  end
end
