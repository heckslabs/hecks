Hecks.bluebook "Bluebook" do
  aggregate "Command" do
    description "One command declared on an aggregate — its arguments, its rules, and what it announces."

    reference_to Aggregate

    # The entity that declared it, when one did; Command.Declare's `entity_id` needs it.
    reference_to Entity, as: :entity_id, optional: true

    # Field names match the IR's so the judge can walk it without a translation table.
    # `owner_id` is the walk's immediate parent (an entity's command belongs to the entity);
    # `aggregate_id` still names the true root for the DeclaredIn walk.
    identified_by :owner_id, :name

    attribute :name,       CommandName
    attribute :role,       Actor
    attribute :goal,       Goal
    attribute :emits,      list_of(Announcement)
    attribute :references, EventName, optional: true
    attribute :attributes, list_of(Argument)
    attribute :givens,     list_of(Rule)
    # Postconditions: same Rule shape as givens, checked after the mutations.
    attribute :ensures,    list_of(Rule)
    # Outside facts the runtime supplies before any given runs (ADR 0081): `needs :now`.
    attribute :needs,      list_of(Need)
    attribute :mutations,  list_of(Change)
    attribute :provenance, CommandText
    # Lifecycle guard as a literal (`from: "open"` or `from: ["open", "frozen"]`); ADR 0025.
    attribute :from,       CommandText, optional: true

    value_object "CommandName" do
      attribute :value, String
      invariant("a command is named") { !value.to_s.empty? }
    end

    value_object "Actor" do
      attribute :value, String
      # Optional: many commands declare no role or goal, and the builder never required one.
    end

    value_object "Goal" do
      attribute :value, String
    end

    value_object "EventName" do
      attribute :value, String
    end

    value_object "Announcement" do
      attribute :name, String
    end

    value_object "Need" do
      attribute :fact, String
    end

    value_object "Argument" do
      attribute :name,    String
      attribute :type,    String
      attribute :list,    String
      attribute :optional, String, optional: true
      attribute :pattern,  String, optional: true
      # A declaration with no default has none.
      attribute :default, String, optional: true
      # The closed set this value must belong to (see Aggregate::Field).
      attribute :admits, String, optional: true
      attribute :relationship, String, optional: true
    end

    value_object "Rule" do
      attribute :description, String
      attribute :canonical,   String
    end

    value_object "Change" do
      attribute :target, String
      attribute :op,     String, admits: "Vocabulary::MutationOp"
      attribute :field,  String
      attribute :kind,   String
      attribute :source, String
    end

    # Plain string holder for an aggregate id; the other text value objects mean something else.
    value_object "CommandText" do
      attribute :value, String
    end
    # Declaration order is a fact about the source, so the language holds it, not the store.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :aggregate, CommandText
      where(aggregate: :aggregate)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open a command on an aggregate"

      reference_to Aggregate
      # Declared on an aggregate or one of its entities; absent for an aggregate's own commands.
      reference_to Entity, as: :entity_id, optional: true
      attribute :name,  CommandName
      attribute :role,  Actor, optional: true
      attribute :goal,  Goal, optional: true
      attribute :provenance, CommandText, optional: true
      attribute :from,       CommandText, optional: true

      attribute :position, Position, optional: true
      sets :aggregate
      sets :entity_id
      sets :name
      sets :role
      sets :goal
      sets :provenance
      sets :from
      sets :position
      emits VerbDeclared
    end

    command "Argument" do
      role "Language"
      goal "Attach one argument to the command"

      attribute :name,    ArgName
      attribute :type,    ArgType
      attribute :list,    ArgType
      attribute :optional, ArgType, optional: true
      attribute :pattern,  ArgType, optional: true
      attribute :default, ArgType, optional: true
      # The closed set this argument's value must belong to (see Aggregate.Attribute).
      attribute :admits,  ArgType, optional: true
      # Marks an argument minted from the owner's reference-typed attribute.
      attribute :relationship, ArgType, optional: true

      sets :attributes, append: { name: :name, type: :type, list: :list, default: :default, optional: :optional, pattern: :pattern, admits: :admits, relationship: :relationship }

      emits ArgumentAttached
    end

    # An argument pointing at another aggregate's head, typed as a reference, not text.
    command "Reference" do
      role "Language"
      goal "Attach an argument that points at another aggregate's head"

      reference_to Aggregate, as: :points_at
      # No `given` on the name: ArgName's invariant fires first, during coercion.
      attribute :name,    ArgName
      attribute :list,    ArgType
      attribute :optional, ArgType, optional: true
      attribute :pattern,  ArgType, optional: true
      attribute :default, ArgType, optional: true
      attribute :admits,  ArgType, optional: true
      attribute :relationship, ArgType, optional: true

      sets :attributes, append: { name: :name, type: :points_at, list: :list, default: :default, optional: :optional, pattern: :pattern, admits: :admits, relationship: :relationship }

      emits ArgumentReferenceAttached
    end

    value_object "ArgName" do
      attribute :value, String
      invariant("an argument is named") { !value.to_s.empty? }
    end

    value_object "ArgType" do
      attribute :value, String
      # list / default reuse this shape and are legitimately empty
    end

    command "Rule" do
      role "Language"
      goal "Attach one given to the command"

      attribute :description, RuleText, optional: true
      attribute :canonical,   RuleText

      given("a rule says what it means")  { !description.value.to_s.empty? }
      given("a rule survives extraction") { !canonical.value.to_s.empty? }

      sets :givens, append: { description: :description, canonical: :canonical }

      emits RuleAttached
    end

    command "Ensure" do
      role "Language"
      goal "Attach one postcondition to the command"

      attribute :description, RuleText, optional: true
      attribute :canonical,   RuleText

      given("a rule says what it means")  { !description.value.to_s.empty? }
      given("a rule survives extraction") { !canonical.value.to_s.empty? }

      sets :ensures, append: { description: :description, canonical: :canonical }

      emits EnsureAttached
    end

    value_object "RuleText" do
      attribute :value, String
    end

    command "Change" do
      role "Language"
      goal "Attach one mutation to the command"

      attribute :target, FieldRef
      # Named on the argument: this is what a caller hands in, so a bad op is refused here.
      attribute :op,     OpName, admits: "Vocabulary::MutationOp"
      attribute :field,  FieldRef
      attribute :kind,   FieldRef
      attribute :source, FieldRef

      given("a mutation names a target")     { !target.value.to_s.empty? }
      given("a mutation does something")     { !op.value.to_s.empty? }

      sets :mutations, append: { target: :target, op: :op, field: :field, kind: :kind, source: :source }

      emits ChangeAttached
    end

    value_object "FieldRef" do
      attribute :value, String
    end

    value_object "OpName" do
      attribute :value, String
    end

    command "ActsOn" do
      role "Language"
      goal "Name the aggregate this command reaches through"

      # Named `root`, not `references`: an argument shadows the aggregate field of that name.
      attribute :root, EventName

      given("a command names what it acts on") { !root.value.to_s.empty? }
      given("a command acts on ONE root")      { references.value.to_s.empty? }

      sets :references, to: :root

      emits ReferenceNamed
    end

    command "Announce" do
      role "Language"
      goal "Name the event this command emits"

      attribute :announces, EventName

      given("an event is named") { !announces.value.to_s.empty? }

      sets :emits, append: { name: :announces }

      emits AnnouncementNamed
    end

    command "Need" do
      role "Language"
      goal "Name an outside fact the runtime supplies before any given runs"

      attribute :fact, FactName

      given("a fact is named") { !fact.value.to_s.empty? }

      sets :needs, append: { fact: :fact }

      emits NeedNamed
    end

    value_object "FactName" do
      attribute :value, String
    end

    # Keyword rows for this chapter; SyntaxBoot discovers aggregate-local seed tables.
    value_object "KeywordSeed" do
      attribute :word,          String
      attribute :context,       String, admits: "Syntax::Context"
      attribute :body,          String, admits: "Syntax::Body"
      attribute :inner,         String
      attribute :opens,         String
      attribute :fills,         String
      attribute :status,        String, default: "admitted", admits: "Syntax::Status"
      attribute :was,           String
      attribute :resolves_via,  String, default: "", admits: "Syntax::ResolutionScope"
      attribute :disambiguator, String, default: "", admits: "Syntax::Disambiguator"

      member word: "role",            context: "Command", body: "none",   inner: "", opens: "", fills: "role", calls: "role_impl"
      member word: "goal",            context: "Command", body: "none",   inner: "", opens: "", fills: "goal"
      member word: "provenance",      context: "Command", body: "none",   inner: "", opens: "", fills: "provenance", calls: "provenance_impl"
      member word: "reference_to",    context: "Command", body: "none",   inner: "", opens: "", fills: "references", calls: "reference_to_impl"
      member word: "given",           context: "Command", body: "source", inner: "", opens: "", fills: "givens", resolves_via: "hash_chain", calls: "given_impl"
      member word: "sets",            context: "Command", body: "none",   inner: "", opens: "", fills: "mutations", calls: "sets_impl"
      # Deprecated spelling of `sets`, still refused live so MetaValidator.shadow_parsing? can
      # read frozen era text that used it.
      member word: "then_set",        context: "Command", body: "none",   inner: "", opens: "", fills: "mutations", status: "deprecated", calls: "then_set_impl"
      # Synchronous handoff into one nested entity command (CommandBuilder#delegates_to_impl).
      member word: "delegates_to",    context: "Command", body: "none",   inner: "", opens: "", fills: "mutations", calls: "delegates_to_impl"
      member word: "emits",           context: "Command", body: "none",   inner: "", opens: "", fills: "emits"
      # A value written inside a `sets` (`to: state(:ply)`); it fills nothing of its own.
      member word: "state",           context: "Command", body: "none",   inner: "", opens: "", fills: "mutations"
      member word: "attribute",       context: "Command", body: "none",   inner: "", opens: "", fills: "attributes", calls: "attribute_impl"
      member word: "ensures", context: "Command", body: "source", inner: "", opens: "", fills: "ensures"
      # An outside fact the runtime supplies before any given runs (ADR 0081; CommandBuilder#needs_impl).
      member word: "needs",           context: "Command", body: "none",   inner: "", opens: "", fills: "needs", calls: "needs_impl"
      # Amends a specific past event. Stored as a mutation so it round-trips with the other
      # mutation words (CommandBuilder#corrects_impl).
      member word: "corrects",        context: "Command", body: "none",   inner: "", opens: "", fills: "mutations", calls: "corrects_impl"

    end

    value_object "ArgumentSeed" do
      attribute :keyword,          String
      attribute :context,          String, admits: "Syntax::Context"
      attribute :at,               String
      attribute :named,            String
      attribute :kind,             String, admits: "Syntax::ArgumentKind"
      attribute :required,         String
      attribute :fills,            String
      attribute :selects,          String
      attribute :pair_key_fills,   String
      attribute :pair_value_fills, String
      attribute :pairs_shape,      String, admits: "Syntax::PairsShape"
      attribute :status,           String, default: "admitted", admits: "Syntax::Status"
      attribute :variadic,         String
      attribute :coerce,           String
      attribute :blank_message,    String

      member keyword: "role",            context: "Command", at: "1", named: "",          kind: "text",     required: "true",  fills: "role"
      member keyword: "goal",            context: "Command", at: "1", named: "",          kind: "text",     required: "true",  fills: "goal", coerce: "false"
      member keyword: "provenance",      context: "Command", at: "",  named: "from",      kind: "literal",  required: "true",  fills: "provenance"
      member keyword: "reference_to",    context: "Command", at: "1", named: "",          kind: "constant", required: "true",  fills: "type"
      member keyword: "reference_to",    context: "Command", at: "",  named: "as",        kind: "symbol",   required: "false", fills: "name"
      member keyword: "reference_to",    context: "Command", at: "",  named: "optional",  kind: "flag",     required: "false", fills: "optional"
      member keyword: "given",           context: "Command", at: "1", named: "",          kind: "text",     required: "true",  fills: "description"
      member keyword: "ensures",         context: "Command", at: "1", named: "",          kind: "text",     required: "true",  fills: "description"
      member keyword: "needs",           context: "Command", at: "1", named: "",          kind: "symbol",   required: "true",  fills: "fact"
      member keyword: "sets",            context: "Command", at: "1", named: "",          kind: "symbol",   required: "true",  fills: "target"
      member keyword: "sets",            context: "Command", at: "",  named: "to",        kind: "literal",  required: "false", fills: "source", selects: "op=set"
      member keyword: "sets",            context: "Command", at: "",  named: "append",    kind: "literal",  required: "false", fills: "source", selects: "op=append"
      member keyword: "sets",            context: "Command", at: "",  named: "increment", kind: "literal",  required: "false", fills: "source", selects: "op=increment"
      member keyword: "sets",            context: "Command", at: "",  named: "decrement", kind: "literal",  required: "false", fills: "source", selects: "op=decrement"
      member keyword: "sets",            context: "Command", at: "",  named: "multiply",  kind: "literal",  required: "false", fills: "source", selects: "op=multiply"
      member keyword: "sets",            context: "Command", at: "",  named: "clamp",     kind: "literal",  required: "false", fills: "source", selects: "op=clamp"
      member keyword: "sets",            context: "Command", at: "",  named: "remove",    kind: "literal",  required: "false", fills: "source", selects: "op=remove"
      member keyword: "then_set",        context: "Command", at: "1", named: "",           kind: "symbol",   required: "true",  fills: "target"
      member keyword: "then_set",        context: "Command", at: "",  named: "to",         kind: "literal",  required: "false", fills: "source", selects: "op=set"
      member keyword: "then_set",        context: "Command", at: "",  named: "from",       kind: "literal",  required: "false", fills: "source", selects: "op=set"
      member keyword: "then_set",        context: "Command", at: "",  named: "append",     kind: "literal",  required: "false", fills: "source", selects: "op=append"
      member keyword: "then_set",        context: "Command", at: "",  named: "increment",  kind: "literal",  required: "false", fills: "source", selects: "op=increment"
      member keyword: "then_set",        context: "Command", at: "",  named: "decrement",  kind: "literal",  required: "false", fills: "source", selects: "op=decrement"
      member keyword: "then_set",        context: "Command", at: "",  named: "multiply",   kind: "literal",  required: "false", fills: "source", selects: "op=multiply"
      member keyword: "then_set",        context: "Command", at: "",  named: "clamp",      kind: "literal",  required: "false", fills: "source", selects: "op=clamp"
      member keyword: "then_set",        context: "Command", at: "",  named: "remove",     kind: "literal",  required: "false", fills: "source", selects: "op=remove"
      member keyword: "delegates_to",    context: "Command", at: "1", named: "",          kind: "text",     required: "true",  fills: "target"
      member keyword: "delegates_to",    context: "Command", at: "",  named: "with",      kind: "literal",  required: "false", fills: "source", selects: "op=delegate"
      # A bare constant (`emits Account::AccountFrozen`) or text; both go through Naming.event_ref.
      member keyword: "emits",           context: "Command", at: "1", named: "",          kind: "constant", required: "true",  fills: "emits"
      member keyword: "emits",           context: "Command", at: "1", named: "",          kind: "text",     required: "true",  fills: "emits"
      member keyword: "state",           context: "Command", at: "1", named: "",          kind: "symbol",   required: "true",  fills: "source"
      member keyword: "attribute",       context: "Command", at: "1", named: "",          kind: "symbol",   required: "true",  fills: "name"
      member keyword: "attribute",       context: "Command", at: "2", named: "",          kind: "constant", required: "true",  fills: "type"
      member keyword: "attribute",       context: "Command", at: "",  named: "default",   kind: "literal",  required: "false", fills: "default"
      member keyword: "attribute",       context: "Command", at: "",  named: "optional",  kind: "flag",     required: "false", fills: "optional"
      member keyword: "attribute",       context: "Command", at: "",  named: "pattern",   kind: "text",     required: "false", fills: "pattern"
      member keyword: "attribute",       context: "Command", at: "",  named: "admits",    kind: "text",     required: "false", fills: "admits"
      member keyword: "attribute",       context: "Command", at: "",  named: "one_of",    kind: "list",     required: "false", fills: "one_of"
      # `reason` is required in practice; CommandBuilder#corrects_impl refuses its absence.
      member keyword: "corrects",        context: "Command", at: "1", named: "",          kind: "text",     required: "true",  fills: "target"
      member keyword: "corrects",        context: "Command", at: "",  named: "as",        kind: "symbol",   required: "false", fills: "source"
      member keyword: "corrects",        context: "Command", at: "",  named: "reason",    kind: "text",     required: "false", fills: "source"
      member keyword: "corrects",        context: "Command", at: "",  named: "reverses",  kind: "flag",     required: "false", fills: "source"

    end
  end
end
