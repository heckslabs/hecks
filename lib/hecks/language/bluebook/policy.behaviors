Hecks.behaviors "Bluebook" do
  vision "A policy hangs off a bluebook and names the event it watches; an unnamed policy is refused."

  loads "bluebook.bluebook", "policy.bluebook", "bluebook.hecksagon"

  test "Declare puts a policy on a chapter" do
    tests "Declare", on: "Policy"
    setup  "Bluebook::Bluebook.Declare", name: "Pizzas", vision: "Pizzas, built and sold.", classification: "core"
    input  bluebook: "Pizzas", name: "NotifyKitchen", on_event: "OrderPlaced"
    expect emits: ["ReactionDeclared"]
  end

  test "Declare refuses a policy with no name" do
    tests "Declare", on: "Policy"
    setup  "Bluebook::Bluebook.Declare", name: "Pizzas", vision: "Pizzas, built and sold.", classification: "core"
    input  bluebook: "Pizzas", name: "", on_event: "OrderPlaced"
    expect refused: "a policy is named"
  end
end
