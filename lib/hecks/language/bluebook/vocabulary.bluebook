      # The rspec shards each hold only the domains they read, so the examples that read the whole
      # generated tree are tagged `generated_all` and left out of them. This job holds every domain.
      member name: "generated_tree", id: "generated_tree",
             title: "whole-tree specs, the examples tagged generated_all against every domain's generated Rust",
             argv: "bundle exec rspec --tag generated_all",
