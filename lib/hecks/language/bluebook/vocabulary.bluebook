    # The stages of the gate: the `checks` a stage runs, as a comma list of `GateCheck` names in
    # the order they are reported. `env` is `NAME=value` words set only where the caller has not set
    # the name: a push check has no use for the Hecks domain's database, so it runs on Memory, as a
    # pull-request run does in CI. `HECKS_PROCESS_SPECS` keeps the examples tagged `process` (they
    # start child processes, so a plain `rspec` leaves them out) in the suite `pre_push` runs.

    # `pre_push` is what a push of a guarded lane runs. `quick` is the checks that finish in seconds
    # and catch the offenses people make most (a storage shape with no edge, a style offense, a comment
    # past the guide): a push runs them first and stops on a red one, so the minutes of spec/fuzzing
    # are not spent on a change that cannot pass. `unguarded_push` is what a push of only unguarded
    # lanes (`main`) runs in place of `pre_push`: the slow suite is skipped, the style checks are not,
    # since an offense that lands on `main` is a red CI run. `rust_io` is the Rust io specs
    # `ci-rust-io.yml` runs in its `rspec_rust_io` job, for a push that wants their answer first; no
    # hook or workflow runs it. `ci` is the checks `ci-checks.yml` runs, each step with
    # `hecks gate_run.gate stage=ci only=<ids> --wait`; several of them write generated files and
    # compare, so the stage is not meant to run whole in one checkout.
    value_object "GateStage" do
      attribute :name, String
      attribute :env, String
      attribute :checks, String

      member name: "pre_push", env: "HECKS_ENVIRONMENT=memory HECKS_PROCESS_SPECS=1", checks: "rspec,fuzzing,query_agreement,engine_agreement,shape_ledger,model_check,doc_coverage,rubocop,codegen_drift,comment_style,comment_blocks,rust_fmt"
      member name: "quick", env: "HECKS_ENVIRONMENT=memory", checks: "shape_ledger,rubocop,comment_style,comment_blocks"
      member name: "unguarded_push", env: "HECKS_ENVIRONMENT=memory", checks: "shape_ledger,rubocop,comment_style,comment_blocks,fuzzing"
      member name: "rust_io", env: "CI=true HECKS_ENVIRONMENT=memory", checks: "rust_io"
      member name: "ci", env: "", checks: "model_check,shape_ledger,engine_agreement,doc_coverage,rubocop,comment_style,comment_blocks,ci_codegen_drift,generated_tree,rust_fmt,rust_clippy,lint_deploy_recipes,fuzz_1_of_2,fuzz_2_of_2,fuzz_sqlite_1_of_2,fuzz_sqlite_2_of_2,fuzz_postgres,fuzz_shards,vocabulary_drift,ci_gates,ci_pipeline,tools_doc,rust_coverage,rust_coverage_codegen,kernel_coverage,rust_vocabulary_drift"
    end

    # The checks a commit must have passed before a `Promotion` moves it onto a guarded lane. Each
    # is the name of a job in .github/workflows that reports to a commit as a check run; a check
    # that a path gate skipped reports `skipped`, which counts as passed. `hecks promote` reads
    # these rows, and hecks project_lanes writes them into the ruleset of any lane that requires
    # them, so the list lives here and nowhere else.
    #
    # `runs` is `always` for a check a release bump still runs (it is not inherited from the base);
    # empty for a check a bump may inherit.
    value_object "RequiredCheck" do
      attribute :name, String
      attribute :runs, String

      member name: "rspec"
      member name: "checks"
      member name: "rspec_postgres_io"
      member name: "rspec_postgres_io_parallel"
      member name: "rspec_rust_io"
      member name: "rspec_rust_parser"
      member name: "rspec_rust_codegen"
      member name: "rspec_rust_host"
      member name: "rspec_fuzzing"
      member name: "release_consistency", runs: "always"
    end

    # The branches a change travels along. `main` takes pushes with no gate; `stable` takes only
    # what a `Promotion` moves onto it once every `CiGate` check is green on that commit.
    # hecks project_lanes writes each row's ruleset into .github/rulesets/<name>.json, and
    # `hecks promote` reads `follows` to know which lane a promotion fast-forwards.
    #
    # `guarded` says whether a ruleset restricts the branch. `pushers` says what it takes: `anyone`
    # (any commit), or `green` (only a commit on which every `RequiredCheck` has already passed,
    # which is how a promotion moves the lane). `feeds` is the tag that moves with the lane, or
    # empty when none does; `follows` is the lane a promotion draws from, or empty. `alert_after`
    # is the whole hours the lane may stand behind the lane it follows before `hecks
    # promotion_run.watch` files a finding, or empty for a lane that is never late.
    # `release_trailer` is the commit-message trailer a commit that sets the version must carry
    # (`Release-Approved-By: <name>`) before a release is cut from this lane, or empty for a lane
    # nothing is released from: the owner decides when a release happens by writing that line in
    # the bump commit, and `release.yml` and `publishing_run.publish` both refuse a bump without it.
    value_object "Lane" do
      attribute :name,        String
      attribute :guarded,     String
      attribute :pushers,     String
      attribute :feeds,       String
      attribute :follows,     String
      attribute :alert_after, String
      attribute :release_trailer, String

      member name: "main",   guarded: "no",  pushers: "anyone", feeds: "",     follows: "",     alert_after: "",
             release_trailer: ""
      member name: "stable", guarded: "yes", pushers: "green",  feeds: "edge", follows: "main", alert_after: "4",
             release_trailer: "Release-Approved-By"
    end

    # A binary hecks builds once per change to its crate and publishes, so a client that needs the
    # same binary downloads it instead of compiling it (ADR 0110). `hecks regeneration_run.project_lanes`
    # writes .github/workflows/publish-<name>.yml from each row; `Hecks::RustBuild::PrebuiltBinary`
    # reads the same rows to name what to download.
    #
    # `crate` is the directory under the checkout that is built and keyed: the key is a hash of every
    # file in it that goes into the build, so the same bytes in the crate are the same release.
    # `executable` is the Cargo binary and `target` the Rust triple it is built for. `runner` is the
    # GitHub-hosted image it is built on, pinned (never `-latest`) because a binary links the
    # runner's glibc and must run on every host that runs that image or a newer one.
    # The release is tagged `<name>-<key>` and carries `<executable>-<target>` and its `.sha256`.
    # A crate can have one row a target; a build takes the row for its crate and target. The arm64
    # host builds on Ubuntu 22.04 (glibc 2.35) so it runs in a Debian bookworm (glibc 2.36) image.
    value_object "PrebuiltBinary" do
      attribute :name,   String
      attribute :crate,  String
      attribute :executable, String
      attribute :target, String
      attribute :runner, String

      member name: "host", crate: "rust/host", executable: "bootstrap", target: "x86_64-unknown-linux-gnu",
             runner: "ubuntu-24.04"
      member name: "host-arm64", crate: "rust/host", executable: "bootstrap", target: "aarch64-unknown-linux-gnu",
             runner: "ubuntu-22.04-arm"
    end

    # The dials of the hecks_qa loop: what each is called, the type of value it takes and what it
    # does. qa/settings.yml holds the values, which are edited and reviewed as a diff; this table
    # holds the rest, so the loader (`Hecks::Fuzzing::QaSettings`) checks the file against it and
    # the QualityControl bluebook reads each value as a constant (`QualityControlDials::PR_CAP_PER_DAY`
    # for `pr_cap_per_day`) without a second list of the names or their types. `type` is Integer,
    # Numeric (an Integer or a Float), Boolean, String, Array or Hash. A dial's nested shape, where it
    # has one, is checked by the loader.
    value_object "QaDial" do
      attribute :name,    String
      attribute :type,    String
      attribute :meaning, String

      member name: "cadence_seconds", type: "Integer",
             meaning: "Minimum gap in seconds between one tick's report and the next dispatch; 0 is immediately. Read by the `/loop hecks_qa` caller, not by any script."
      member name: "pr_cap_per_day", type: "Integer",
             meaning: "Most PRs (Patch plus Improvement) `hecks quality_control patch.open` opens per calendar day; 0 is uncapped."
      member name: "widening_tiers", type: "Array",
             meaning: "Fuzz depth by `Target.clean_streak`, in three discrete tiers, read by `SweepDepth.for_streak`. The last row (`upto: Float::INFINITY`) is the ceiling."
      member name: "sweep_max_parallel", type: "Integer",
             meaning: "How many `hecks quality_control query sweep.run <target>` children `--all` keeps running at once."
      member name: "liveness_fallback_seconds", type: "Integer",
             meaning: "How long the `/loop hecks_qa` caller waits for a tick's report before assuming it stalled."
      member name: "draft_only", type: "Boolean",
             meaning: "Whether `hecks quality_control patch.open` opens its PR as a draft; false opens it ready for review."
      member name: "auto_merge", type: "Boolean",
             meaning: "Whether `hecks quality_control patch.open` queues the PR for auto-merge once it is open."
      member name: "adversarial_fraction", type: "Numeric",
             meaning: "Fraction (0.0..1.0) of generated command steps mutated adversarially; 0 turns the layer off. Higher finds refusal-ordering splits sooner but reaches deep state less often."
      member name: "guided_generation", type: "Boolean",
             meaning: "Coverage-guided generation across one sweep's seeds (`Hecks::Fuzzing::CoverageCampaign`)."
      member name: "corpus_splice_probability", type: "Numeric",
             meaning: "Fraction (0.0..1.0) of seeds that start from a prefix of an earlier seed's new coverage. Off by default: measured, it trades breadth for depth (banking reached 1.41x the deep-state tuples, chess lost 0.12x of all tuples), while favoring rare verbs alone never lost."
      member name: "favor_rare_verbs", type: "Integer",
             meaning: "How many of the least-hit verbs the next seed weights up; 0 turns the lever off."
      member name: "runtime_coverage_feedback", type: "Boolean",
             meaning: "Whether guided generation also admits a seed to the corpus for reaching a new line or branch of the Ruby runtime (`Hecks::Fuzzing::RuntimeCoverage`), not only a new (verb, kind, state, mutation, outcome) tuple. Off by default: tracing every line slows each seed."
      member name: "self_consistency_checks", type: "Boolean",
             meaning: "Whether `hecks quality_control query sweep.run` also runs the self-consistency pass (cold rehydration, replay idempotency, value-object JSON round trip) on the same generated sequence."
      member name: "shrink_budget", type: "Integer",
             meaning: "Candidate replays `hecks quality_control query sweep.run` may spend shrinking one surprised check; 0 turns shrinking off. `concurrency` is never shrunk: a race does not reproduce on demand."
      member name: "yield_weight_seconds", type: "Integer",
             meaning: "Seconds of staleness that one point of yield score is worth in `RotationPriority.pick`. Zero would make yield invisible, so pick a number that lets it matter."
      member name: "yield_decay_percent", type: "Integer",
             meaning: "Percent of the prior yield score kept at each release, so recent findings dominate. Applied by the caller: the mutation language cannot express \"decay, then add\" in `Release`."
      member name: "rotation_stale_floor_seconds", type: "Integer",
             meaning: "Once a waiting target is this stale, `RotationPriority.pick` takes it whatever its yield score, so a quiet target cannot starve."
      member name: "persistence_parity_seed_cap", type: "Integer",
             meaning: "Ceiling on `--seeds` for `--persistence-parity`, which pays for real Postgres per dispatch. `hecks quality_control query sweep.run` clamps down, never up, and prints a note."
      member name: "concurrency_seed_cap", type: "Integer",
             meaning: "Ceiling on `--seeds` for the concurrency mode, which needs two disposable schemas per seed."
      member name: "adapter_parity_pairs", type: "Hash",
             meaning: "The two adapters each adapter-parity mode compares, by mode name; a new pairing is a new entry. `adapter_parity_sqlite` needs no `database:`/`schema:` because sqlite has no disposable database."
      member name: "modes", type: "Hash",
             meaning: "Which comparison modes `hecks quality_control query sweep.run` may run: the enabled ones intersected with what `TargetCapabilities.infer(path)` finds in the target. `--modes a,b,c` overrides for one run. `wasm_front` and `adapter_parity_postgres` are off because nothing runs them; the others are built and off because their I/O cost across the rotation is unmeasured. `hecks quality_control query sweep.run` refuses to start when a mode outside `TargetCapabilities::RUNNABLE_MODES` is enabled."
      member name: "role_draw_probability", type: "Numeric",
             meaning: "How often a generated role-gated command step carries a drawn caller (`role:`/`actor_id:`); 0 turns the draw off."
      member name: "dry_run_fraction", type: "Numeric",
             meaning: "Fraction of generated command steps offered as a dry run instead of a real dispatch; 0 is off. Kept low: a dry run creates no state for later steps to act on."
      member name: "generated_domains_per_tick", type: "Integer",
             meaning: "How many generated domains one `hecks quality_control sweep.tick` checks after the rotation sweep; 0 skips the step."
      member name: "generated_domains_rust", type: "Boolean",
             meaning: "Whether generated domains are also compared against a compiled Rust binary built in a scratch copy."
      member name: "generated_domain_seeds", type: "Integer",
             meaning: "Generated sequences run per generated domain."
      member name: "mutation_files", type: "Array",
             meaning: "Rust files `hecks quality_control target.mutate --from-dials` mutates, and so the files one `hecks quality_control sweep.tick` mutation-tests after the generated domains; empty skips the step."
      member name: "mutation_equivalent", type: "Array",
             meaning: "Mutants that behave the same as the original code, by the name `cargo mutants --list` gives them without the file and line; never run, so they cannot be reported as survivors."
      member name: "structural_refusal_boundary", type: "Array",
             meaning: "Construct families a skipped query verb may belong to. A skip inside the list is logged Held, one outside it Surprised. Shrink-only: spec/fuzzing/rust_gap_manifest_spec.rb fails when a family here is declared by no committed manifest."
    end

    # What each retired `bin/` script became in hecks 3.0.0 (ADR 0080, section 7): one row per
    # command or query that answers it, so a script that became several verbs has several rows.
    # hecks project_tools_doc writes the launcher forms into the marked tables of docs/tools.md,
    # rendering each form from the command's own arguments, so a form can neither keep an argument
    # the command dropped nor miss one it gained; the table specs read the same rows.
    #
    # `section` is the part of docs/tools.md the row is listed under (Custodian, Deploy, Site,
    # Codebase or QualityControl); Custodian and Codebase commands live in the Hecks bluebook, the
    # others in the bluebook of their own name. `script` is `(new)` for a command no `bin/` script
    # preceded. `aggregate` and `verb` name the command (or, in QualityControl, the query) the way
    # the launcher spells it, `aggregate.verb`.
    #
    # The rest is only what the arguments cannot say: `passes` documents the flags a command hands
    # through to the tool it wraps (its `arguments=` word), `note` is a sentence kept beside the
    # form, and `form` replaces the rendered form when a launcher route spells it its own way.
    value_object "RetiredScript" do
      attribute :script,    String
      attribute :section,   String
      attribute :aggregate, String
      attribute :verb,      String
      attribute :passes,    String, optional: true
      attribute :note,      String, optional: true
      attribute :form,      String, optional: true

      member script: "ir", section: "Custodian", aggregate: "Introspection", verb: "ir"
      member script: "shape", section: "Custodian", aggregate: "Introspection", verb: "shape"
      member script: "stores", section: "Custodian", aggregate: "Introspection", verb: "stores"
      member script: "history", section: "Custodian", aggregate: "Introspection", verb: "history"
      member script: "statements", section: "Custodian", aggregate: "Introspection", verb: "statements"
      member script: "narrate", section: "Custodian", aggregate: "Introspection", verb: "narrate"
      member script: "docs", section: "Custodian", aggregate: "Introspection", verb: "docs"
      member script: "project_diagrams", section: "Custodian", aggregate: "Introspection", verb: "project_diagrams"
      member script: "project_glossary", section: "Custodian", aggregate: "Introspection", verb: "glossary"
      member script: "model_check", section: "Custodian", aggregate: "ModelCheckRun", verb: "model_check"
      member script: "run", section: "Custodian", aggregate: "Operation", verb: "run", form: "hecks run [domain] <verb [name=value …] | script.json | - | '{\"steps\":[…]}'>"
      member script: "project", section: "Custodian", aggregate: "Operation", verb: "refresh_projections"
      member script: "behaviors", section: "Custodian", aggregate: "Operation", verb: "run_behaviors"
      member script: "console", section: "Custodian", aggregate: "Operation", verb: "open_console"
      member script: "follow", section: "Custodian", aggregate: "Operation", verb: "follow"
      member script: "smoke_test", section: "Custodian", aggregate: "Operation", verb: "smoke_test"
      member script: "smoke_http", section: "Custodian", aggregate: "Operation", verb: "smoke_http"
      member script: "check_era", section: "Custodian", aggregate: "Host", verb: "check_era"
      member script: "merge_tail", section: "Custodian", aggregate: "Era", verb: "merge_tail"
      member script: "reattest_era", section: "Custodian", aggregate: "Era", verb: "reattest"
      member script: "backfill_era_projections", section: "Custodian", aggregate: "Era", verb: "backfill_projections"
      member script: "scaffold_translation", section: "Custodian", aggregate: "Era", verb: "scaffold_translation"
      member script: "translation_audit", section: "Custodian", aggregate: "Era", verb: "audit_translation"
      member script: "compact", section: "Custodian", aggregate: "Era", verb: "compact"
      member script: "heki_compact", section: "Custodian", aggregate: "Era", verb: "compact_heki"
      member script: "vendor_bluebook", section: "Custodian", aggregate: "Package", verb: "vendor", note: "waits: a refusal exits 1 with its reason on stderr"
      member script: "project_cli", section: "Custodian", aggregate: "Launch", verb: "project_cli"
      member script: "hecks_mcp_door", section: "Custodian", aggregate: "Launch", verb: "serve_mcp"
      member script: "project_rust", section: "Custodian", aggregate: "Build", verb: "project_rust"
      member script: "project_wasm", section: "Custodian", aggregate: "Build", verb: "build_wasm"
      member script: "project_host", section: "Custodian", aggregate: "Build", verb: "build_host"
      member script: "project_wasm_browser", section: "Custodian", aggregate: "Build", verb: "build_browser_wasm"
      member script: "rust_coverage", section: "Custodian", aggregate: "Build", verb: "rust_coverage"
