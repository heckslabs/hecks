    # A leg answers an event (`on "AccountDebited"`) or one of these non-event
    # outcomes — `on :refused` is the compensating leg for a dispatch the
    # procedure declined (SagaInterpreter::REFUSED).
    value_object "Trigger" do
      attribute :name, String, one_of: ["refused"]
    end

    # Regexes `text_field` matches a text attribute's name against
    # (case-insensitively) to guess an HTML input type or textarea kind, when
    # nothing more specific already answered (Hecks::Forms::FieldShape's
    # EMAIL_HINT/URL_HINT/TEL_HINT/TEXTAREA_HINT). `pattern` is the regex
    # source, no delimiters or flags. hecks project_field_hints writes the Rust
    # host's copy from these rows, so neither side is typed by hand.
    #
    # `resolves_to` names which Field attribute a match sets: html_type for
    # email/url/tel (checked in that order, first match wins), kind for
    # textarea (checked once html_type has fallen through to "text").
    value_object "FieldHint" do
      attribute :name,        String
      attribute :pattern,     String
      attribute :resolves_to, String

      member name: "email",    pattern: 'email',                                                 resolves_to: "html_type"
      member name: "url",      pattern: '\b(url|uri|website|link)\b',                             resolves_to: "html_type"
      member name: "tel",      pattern: 'phone|\btel(ephone)?\b',                                 resolves_to: "html_type"
      member name: "textarea", pattern: '\b(text|body|note|notes|description|message|comment)\b', resolves_to: "kind"
    end

    # The path gates the workflows run before an expensive job: one detector job
    # per row, answering `touched` from the diff of the change against its base.
    # hecks project_ci_gates writes each row into the marked region of its
    # `workflow` (.github/workflows/<workflow>), and the job it writes runs
    # `hecks decide_ci_gate gate=<name>`, which makes the decision from the row.
    #
    # `mode` is how `pattern` (an extended regex over changed paths) decides:
    # `touches` runs the job when any changed path matches, `skips_unless` runs it
    # when any changed path does NOT match (the pattern is the safe-to-skip list).
    # `release_only` answers a different question and ignores `pattern`: `touched` is false only
    # when the change edits nothing but the `ReleaseFile` rows' files and lines and the base it is
    # measured against has every inheritable `RequiredCheck` green (ADR 0107), so the run may
    # inherit that certification.
    # `push` is what a push event does: `skip` leaves the gate out of push runs,
    # `before_sha` diffs against the push's `before` commit.
    value_object "CiGate" do
      attribute :name,     String
      attribute :workflow, String
      attribute :mode,     String
      attribute :pattern,  String
      attribute :push,     String
      attribute :label,    String

      member name: "runtime_changed", workflow: "ci.yml", mode: "touches",
             pattern: '^lib/hecks/runtime/', push: "before_sha",
             label: "does this change touch lib/hecks/runtime/**?"
      member name: "release_only", workflow: "ci.yml", mode: "release_only",
             pattern: "", push: "before_sha",
             label: "is this change only a release bump on a certified base?"
      member name: "postgres_io_relevant_changed", workflow: "ci-postgres-io-parallel.yml", mode: "skips_unless",
             pattern: '^(docs/|editors/|release/|deploy/|\.claude/|\.githooks/|rust/(parser|codegen|host|build|lsp|web|tests)/|\.rubocop\.yml$|\.rubocop_todo\.yml$|\.mcp\.json$|\.rspec-local\.example$|README\.md$|CHANGELOG\.md$|CONTRIBUTING\.md$|SECURITY\.md$|LICENSE$|\.gitignore$)',
             push: "skip",
             label: "does this change touch anything rspec_postgres_io_parallel covers?"
    end

    # The files a release bump edits, and the lines of each it may change. A commit whose whole
    # diff against a certified base falls inside these rows inherits the base's certification
    # (`CiGate` `release_only`, ADR 0107): its checks report success without their jobs running,
    # and the `release_consistency` check still runs on it. `path` is the file, exact; `lines` is
    # an extended regex every added or removed line of that file must match, empty for any line.
    value_object "ReleaseFile" do
      attribute :path,  String
      attribute :lines, String

      member path: "lib/hecks/version.rb", lines: "^\\s*VERSION = \"[0-9]+\\.[0-9]+\\.[0-9]+\"\\.freeze$"
      member path: "CHANGELOG.md", lines: ""
      member path: "README.md", lines: "^(\\*\\*Status:\\*\\* )?Current release: `[0-9]+\\.[0-9]+\\.[0-9]+`"
      member path: "Gemfile.lock", lines: "^    hecks \\([0-9]+\\.[0-9]+\\.[0-9]+\\)$"
      member path: "rust/host/HECKS_RELEASE", lines: "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      member path: "packages/hecks-client/package.json", lines: "^\\s*\"version\": \"[0-9]+\\.[0-9]+\\.[0-9]+\",?$"
      member path: "packages/hecks-client/package-lock.json", lines: "^\\s*\"version\": \"[0-9]+\\.[0-9]+\\.[0-9]+\",?$"
    end

    # The checks a stage holds a change against before it is let through. `hecks gate_run.gate`
    # reads these rows, the git pre-push hook calls it, and the `ci` stage's checks are the ones
    # `.github/workflows/ci-checks.yml` runs, so the list of checks lives here and nowhere else.

    # A check is one command run from the repository root, all of a stage's checks at once:
    # `name` is the row's key, which a `GateStage` lists; `id` is the name the check is reported and
    # selected by (`only=a,b`), and the same `id` may name a different command in another stage;
    # `title` is the heading its output is printed under; `argv` is the program and its arguments,
    # separated by single spaces, with `{workers}` standing for half the machine's cores, at least
    # one; `script` is a shell script run as `sh -ec` instead, when `argv` is empty; `blocked` is what
    # a red check means and what to do about it.
    value_object "GateCheck" do
      attribute :name, String
      attribute :id, String
      attribute :title, String
      attribute :argv, String
      attribute :script, String
      attribute :blocked, String

      member name: "rspec", id: "rspec",
             title: "rspec (parallel)",
             argv: "",
             script: "# Workers are grouped by this machine's own last timings, kept under the git directory\n# (shared by every worktree, never committed). CI's committed baseline leaves out the io\n# specs this run includes, so it only seeds the first run; each run then rewrites the log.\nlog=\"$(git rev-parse --git-common-dir)/hecks_rspec_runtime.log\"\n[ -f \"$log\" ] || cp .github/rspec_runtime_baseline.log \"$log\"\nbundle exec parallel_rspec spec -n {workers} --group-by runtime --runtime-log \"$log\" --allowed-missing 100 \\\n  -o \"--format progress --format ParallelTests::RSpec::RuntimeLogger --out $log\"\n",
             blocked: "the suite is red."
      member name: "fuzzing", id: "fuzzing",
             title: "spec/fuzzing, which the parallel run above excludes",
             argv: "bundle exec rspec spec/fuzzing --tag fuzzing",
             script: "",
             blocked: "spec/fuzzing is red."
      member name: "query_agreement", id: "query_agreement",
             title: "adapter agreement, one declared query and every engine giving the same answer",
             argv: "bundle exec rspec spec/adapters/query_agreement_spec.rb --tag io",
             script: "",
             blocked: "the engines disagree about a declared query; one of them is wrong, and a self-consistent adapter spec cannot tell which."
      member name: "engine_agreement", id: "engine_agreement",
             title: "engine agreement, every declared comparator on both engines",
             argv: "bundle exec exe/hecks conformance_run.check_engine_agreement --wait",
             script: "",
             blocked: "a comparator is missing a shared case or a cross-engine spec."
      member name: "shape_ledger", id: "shape_ledger",
             title: "shape ledger, every bluebook's storage shape held by the ledger or reached by a translation edge",
             argv: "bundle exec exe/hecks conformance_run.check_shape_ledger --wait",
             script: "",
             blocked: "a bluebook's storage shape moved with no translation edge from the shape the ledger holds; the failure prints the edge to commit. A change that only adds is settled in one step with `hecks conformance_run.check_shape_ledger --confirm --additive --wait`, which writes the empty edge and moves the ledger; a change that renames or reshapes data needs rules first."
      member name: "model_check", id: "model_check",
             title: "model check, unreachable states, dead transitions and orphaned handlers",
             argv: "bundle exec exe/hecks model_check --wait",
             script: "",
