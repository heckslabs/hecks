      member script: "generate", section: "Custodian", aggregate: "FuzzRun", verb: "generate_sequence"
      member script: "bench", section: "Custodian", aggregate: "FuzzRun", verb: "bench"
      member script: "(new)", section: "Custodian", aggregate: "FuzzRun", verb: "mutate"
      member script: "(new)", section: "Custodian", aggregate: "Era", verb: "hold_first"
      member script: "project_deploy", section: "Deploy", aggregate: "Recipe", verb: "project"
      member script: "lint_deploy_recipes", section: "Deploy", aggregate: "MakefileCheck", verb: "lint"
      member script: "deploy_template_diff", section: "Deploy", aggregate: "TemplateComparison", verb: "diff"
