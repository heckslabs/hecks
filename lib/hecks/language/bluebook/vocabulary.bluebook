Hecks.bluebook "Bluebook" do
  aggregate "Vocabulary" do
    # Closed sets the language admits, projected into matching Ruby and Rust
    # tables (hecks project_vocabulary, hecks project_rust_vocabulary) so both runtimes agree.
    description "The closed sets the language admits — the whole of what any runtime may accept, declared once."

    # Named only by itself; a vocabulary hangs under nothing else.
    identified_by VocabularyName, as: :name


    value_object "VocabularyName" do
      attribute :value, String
      invariant("a vocabulary is named") { !value.to_s.empty? }
    end

    # The six comparison operators. `compare` reduces each to two primitives
    # (less_than, equal) combined by compares_less_than/compares_equal/negated,
    # rather than a six-way case statement (Expression::Evaluator::COMPARISONS).
    value_object "Comparison" do
      attribute :symbol,             String
      attribute :compares_less_than, String
      attribute :compares_equal,     String
      attribute :negated,            String

      member symbol: ">=", compares_less_than: "true",  compares_equal: "false", negated: "true"
      member symbol: "<=", compares_less_than: "true",  compares_equal: "true",  negated: "false"
      member symbol: "<",  compares_less_than: "true",  compares_equal: "false", negated: "false"
      member symbol: ">",  compares_less_than: "true",  compares_equal: "true",  negated: "true"
      member symbol: "==", compares_less_than: "false", compares_equal: "true",  negated: "false"
      member symbol: "!=", compares_less_than: "false", compares_equal: "true",  negated: "true"
    end

    # Each sign test compares against 0 using an operator Comparison already
    # declares (compares_via) — sugar for an existing operator, not a second
    # algebra. positive? = value > 0, negative? = value < 0, zero? = value == 0.
    value_object "SignTest" do
      attribute :name,         String
      attribute :compares_via, String

      member name: "positive?", compares_via: ">"
      member name: "negative?", compares_via: "<"
      member name: "zero?",     compares_via: "=="
    end

    # `.include?`'s haystack type decides its behavior: Array does membership,
    # String does substring match. Every other type is always false and is not
    # declared here — that fallback isn't a case of its own.
    value_object "IncludeHaystack" do
      attribute :type,     String
      attribute :strategy, String

      member type: "Array",  strategy: "membership"
      member type: "String", strategy: "substring"
    end

    # Scalar types `.to_s` admits; every one uses Ruby's own to_s (nil → "",
    # a bool its name, a number its digits) — one rule, not a table per type.
    value_object "ToStringType" do
      attribute :type, String, one_of: ["String", "Integer", "Float", "TrueClass", "FalseClass", "NilClass"]
    end

    # The closed set `.size` and `.empty?` both admit — a list, a string, or
    # an open map — sharing one declaration since both just call Ruby's own
    # method of the same name.
    value_object "SizedType" do
      attribute :type, String, one_of: ["Array", "String", "Hash"]
    end

    # Attribute::PRIMITIVES — the scalars a value object may bottom out in
    value_object "Primitive" do
      attribute :name, String, one_of: ["String", "Integer", "Float", "TrueClass", "FalseClass"]
    end

    # Expression::CanonicalForm::STRATEGIES
    value_object "NormalisationStrategy" do
      attribute :name, String, one_of: ["collapse_whitespace", "replace", "scale_call"]
    end

    # Ops Runtime::CommandInterpreter applies. `sign` is the arithmetic delta
    # increment/decrement share (current + sign * amount); set and append do
    # no arithmetic, so they carry no sign.
    value_object "MutationOp" do
      attribute :name, String
      attribute :sign, String

      member name: "set",       sign: ""
      member name: "append",    sign: ""
      member name: "increment", sign: "1"
      member name: "decrement", sign: "-1"
      # multiply scales (current * amount), clamp bounds
      # (current.clamp(min, max)) — neither is add/subtract, so neither
      # carries a sign.
      member name: "multiply",  sign: ""
      member name: "clamp",     sign: ""
      # remove is append's list-removal counterpart, matching an element
      # by value; no sign, same reading as append.
      member name: "remove",    sign: ""
      # delegate is an aggregate command's synchronous handoff into a nested
      # entity command (see CommandBuilder#delegates_to). Shares append's
      # multi-binding wire shape (`with:` ~ `fields:`), so it carries no sign.
      member name: "delegate",  sign: ""
      # corrects declares a past event it amends rather than a fresh
      # mutation (see CommandBuilder#corrects_impl). Shares append/delegate's
      # multi-binding wire shape (as:/reason:/reverses:), so no sign either.
      member name: "corrects",  sign: ""
    end

    # A where-clause's admitted operators (QuerySpecification::Common::
    # Comparators::COMPARATORS) — flat, not one shared algebra like Comparison,
    # since eq/ne/gt/lt/in/contains differ in kind. Must stay in sync with that constant.
    value_object "QueryComparator" do
      attribute :name, String, one_of: ["eq", "ne", "gt", "gte", "lt", "lte", "in", "contains", "none_in_state"]
    end

    # Adapters::Driven::Folder::DOMAIN_ORDER — declarations load in this order
    value_object "LoadOrder" do
      attribute :glob, String,
                one_of: ["*.port", "*.adapter", "*.bluebook", "translations/*.bluebook", "*.hecksagon", "*.world"]
    end

    # The order CommandInterpreter#call follows, ending at the events it
    # emits — reaction (policies, sagas) is a separate phase that runs after,
    # in a different class. assign_creation_attributes only fires for a
    # creating command; advance_lifecycle only when a transition applies.
    #
    # decode_arguments is a no-op today in both runtimes but is declared here
    # so a future generated decoder has a step to occupy.
    value_object "AggregateDispatchOrder" do
      attribute :step, String,
                one_of: ["decode_arguments", "refuse_unknown_arguments", "refuse_absent_arguments", "normalize_args",
                         "refuse_role_mismatch", "resolve_references", "hydrate", "enforce_givens",
                         "admissible_transition", "assign_creation_attributes", "apply_mutations",
                         "advance_lifecycle", "delegate_to_entity", "enforce_ensures", "enforce_invariants",
                         "save", "emit"]
    end

    # EntityInterpreter#call — the same shape as AggregateDispatchOrder, one
    # level down on an entity. Differs in that an entity is never created
    # through this path (hydrate_parent + locate_element replace hydrate;
    # no assign_creation_attributes). resolve_references stays: an entity
    # command can declare a reference-typed attribute too, shared via
    # CommandRules#resolve_references.
    value_object "EntityDispatchOrder" do
      attribute :step, String,
                one_of: ["decode_arguments", "refuse_unknown_arguments", "refuse_absent_arguments", "normalize_args",
                         "refuse_role_mismatch", "resolve_references", "hydrate_parent",
                         "locate_element", "enforce_givens", "admissible_transition", "apply_mutations",
                         "advance_lifecycle", "enforce_ensures", "enforce_invariants", "save", "emit"]
    end

    # Runtime::Errors::DOMAIN_REFUSALS — what counts as the domain judging,
    # as opposed to the runtime breaking. Anything outside this set that reaches
    # a refusal list is a bug wearing a refusal's clothes.
    value_object "DomainRefusal" do
      attribute :name, String,
                one_of: ["AbsentArgument", "AlreadyExists", "AttributeAbsent", "EnsuresNotMet", "GivenNotMet",
                         "InvariantViolation", "LifecycleRefused", "NothingToCorrect", "NotFound", "ProjectionAbsent",
                         "RemoteRefusal", "TypeMismatch", "Unauthorized", "UnknownArgument", "UnknownVerb"]
    end

    # The wording for every DomainRefusal site not already carried by data
    # (given/ensures/invariant already describe themselves). Language-level
    # and the same for every domain, so it is declared here and projected
    # into Runtime::RefusalWording (Ruby) / kernel::vocab::RefusalSite (Rust)
    # rather than read live off this chapter at every call.
    #
    # `{name}` markers are plain text substitution, not expression syntax —
    # a template is read, never evaluated. Two call sites that raise the
    # same sentence share one `site` row instead of duplicating it.
    value_object "RefusalTemplate" do
      attribute :refusal,  String, admits: "Vocabulary::DomainRefusal"
      attribute :site,     String
      attribute :template, String

      member refusal: "NotFound", site: "creating_no_identity",
             template: "{command} creates a {aggregate} — pass {identity}:"
      member refusal: "AlreadyExists", site: "creating_duplicate",
             template: "{command} creates a {aggregate} that already exists — {identity} {offered}"
      member refusal: "AlreadyExists", site: "entity_duplicate",
             template: "a {entity} already exists on {aggregate} — {identity} {offered}"
      member refusal: "NotFound", site: "acting_no_identity",
             template: "{command} acts on an existing {aggregate} — pass {identity}:"
      member refusal: "NotFound", site: "record_missing",
             template: "no {aggregate} with {identity} {offered}"
      member refusal: "NotFound", site: "entity_parent_no_identity",
             template: "{command} acts on a {aggregate}'s {entity} — pass {identity}:"
      member refusal: "UnknownVerb", site: "entity_unknown",
             template: "{aggregate} has no entity {entity}"
      member refusal: "NotFound", site: "entity_element_no_identity",
             template: "{command} acts on one {entity} — pass {identity}:"
      member refusal: "NotFound", site: "entity_element_missing",
             template: "no {entity} with {identity} {wants} on {aggregate} {parent_id}"
      member refusal: "NotFound", site: "reference_target_missing",
             template: "no {target} with {heads} {key}"
      member refusal: "NotFound", site: "read_model_reference_missing",
             template: "no {aggregate} with reference {offered}"
      member refusal: "TypeMismatch", site: "read_model_object_reference",
             template: "{query} refused — a reference is an id, and {field} arrived as an object"
      member refusal: "UnknownVerb", site: "no_query",
             template: "{aggregate} has no query {query}"
      member refusal: "UnknownVerb", site: "entity_query_missing",
             template: "{entity} has no query {query}"
      member refusal: "UnknownVerb", site: "entity_holds_no_list",
             template: "{aggregate} holds no list of {entity}"
      member refusal: "UnknownVerb", site: "entity_no_command",
             template: "{entity} has no command {command}"
      member refusal: "UnknownVerb", site: "aggregate_no_command",
             template: "{aggregate} has no command {command}"
      member refusal: "UnknownVerb", site: "port_no_operation",
             template: "{port} has no operation {operation}"
      member refusal: "UnknownVerb", site: "no_domain",
             template: "no domain {domain} loaded (verb {verb})"
      member refusal: "UnknownVerb", site: "no_read_model",
             template: "{domain} has no read model {query}"
      member refusal: "UnknownVerb", site: "not_fully_qualified",
             template: "{verb} is not a fully-qualified verb (Domain::Aggregate.Command)"
      member refusal: "UnknownVerb", site: "no_aggregate",
             template: "{domain} has no aggregate {aggregate}"
      member refusal: "LifecycleRefused", site: "transition_blocked",
             template: "{command} refused — {field} is {current}, and {command} moves it only from {allowed}"
      member refusal: "TypeMismatch", site: "value_object_shape",
             template: "{name} is a {type} — pass its fields as an object, not {offered}"
      # A bare Boolean, Array, or null reference argument is a shape error,
      # not a missing record — {offered} names what arrived.
      member refusal: "TypeMismatch", site: "reference_wrong_shape",
             template: "{command} refused — a reference is an id, and {attribute} arrived as {offered}{known_by}"
      member refusal: "TypeMismatch", site: "multi_field_scalar",
             template: "{type} has multiple fields and cannot stand in for a scalar"
      member refusal: "TypeMismatch", site: "composite_identity",
             template: "{type} is a composite identity — an identity must have exactly one field"
      member refusal: "TypeMismatch", site: "numeric_field",
             template: "{type}.{field} expects {expected}, got {offered}"
      member refusal: "TypeMismatch", site: "non_finite_field",
             template: "{type}.{field} must be a finite number, got {offered}"
      member refusal: "TypeMismatch", site: "integer_range",
             template: "{type}.{field} must fit in a 64-bit integer, got {offered}"
      member refusal: "TypeMismatch", site: "pattern_mismatch",
             template: "{type}.{field} must match {pattern}, got {offered}"
      member refusal: "TypeMismatch", site: "arithmetic_amount",
             template: "{op} of {target} needs an Integer, got {offered}"
      member refusal: "TypeMismatch", site: "arithmetic_current",
             template: "{op} of {target} needs an Integer {target}, got {offered}"
      member refusal: "TypeMismatch", site: "arithmetic_shared_field",
             template: "{op} of {target} needs a value object with one shared Integer field"
      member refusal: "UnknownArgument", site: "unknown_args",
             template: "{command} does not declare {unknown} — it takes {declared}"
      member refusal: "AbsentArgument", site: "absent_args",
             template: "{command} was not given {absent} — it takes {declared}"
      member refusal: "InvariantViolation", site: "closed_set_member",
             template: "{type} admits {admitted} — got {offered}"
      member refusal: "InvariantViolation", site: "value_object_invariant",
             template: "{name} invariant violated — {description} (given {offered})"
      member refusal: "InvariantViolation", site: "admits_declared_set",
             template: "{name} admits {admits} — {admitted} — got {offered}"
      member refusal: "InvariantViolation", site: "undeclared_set",
             template: "{name} admits {admits}, which this chapter does not declare — a closed set is named " \
                       "Aggregate::SetName, and it must be one the bluebook actually holds"
      # ADR 0061 decision D1: a group_by leaf holds one row, so two rows
      # reaching the same full key path refuse at dispatch rather than one
      # of them being dropped.
      member refusal: "InvariantViolation", site: "group_by_collision",
             template: "{read_model} groups by {fields}, but rows {ids} share {key} — a group_by " \
                       "leaf holds one row; add a field that tells them apart"
      member refusal: "Unauthorized", site: "tenant_required",
             template: "{query} declares authorize with tenant: {field} — pass {field}: to name which " \
                       "{field} this ask is scoped to"
      member refusal: "Unauthorized", site: "role_mismatch",
             template: "{command} refused — role: {role}, and the caller stated {caller_role}"
      member refusal: "Unauthorized", site: "cross_tenant_reference",
             template: "{aggregate} {field} is {tenant}, but {attribute} names a {target} whose own " \
                       "{target_field} is {other} — a cross-tenant reference"
      member refusal: "AttributeAbsent", site: "absent_read",
             template: "{aggregate} {field} is absent on this record — declared, not optional, and " \
                       "added since it was written. Backfill it in a translation (backfill :{field}, " \
                       "default: ...), or declare it optional: true"
      # S12, ADR 0025 — the same silent-wrong-answer class AttributeAbsent
      # above refuses, one line up: a `projects` field this record predates,
      # or that no rebuild sweep has populated yet, read by a rule as
      # though it were a real value rather than one nobody has copied over.
      member refusal: "ProjectionAbsent", site: "absent_read",
             template: "{aggregate} {field} is not yet projected on this record — declared via " \
                       "projects :{field}, but no rebuild sweep has populated it. Run the sweep, " \
                       "or read {reference}.{remote_field} directly if this rule cannot wait"
    end

    # Which values a RefusalTemplate site takes (in placeholder order) and how
    # each renders, so a caller hands over a raw value rather than a
    # pre-formatted string. Read by Runtime::RefusalWording.render_site and
    # projected into rust/src/kernel/vocab/refusal_template.rs as one typed
    # args struct per site.
    #
    #   shape      — "scalar" or "list"
    #   quoting    — "none" (raw text) or "inspect" (Ruby #inspect / Rust {:?})
    #   separator  — what joins a list's items
    #   sorted     — "true" sorts a list's items before quoting
    #   when_empty — what an empty list renders as
    value_object "RefusalSiteArgument" do
      attribute :refusal,    String, admits: "Vocabulary::DomainRefusal"
      attribute :site,       String
      attribute :argument,   String
      attribute :shape,      String
      attribute :quoting,    String
      attribute :separator,  String
      attribute :sorted,     String
      attribute :when_empty, String

      member refusal: "NotFound", site: "creating_no_identity", argument: "command",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "creating_no_identity", argument: "aggregate",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "creating_no_identity", argument: "identity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "AlreadyExists", site: "creating_duplicate", argument: "command",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "AlreadyExists", site: "creating_duplicate", argument: "aggregate",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "AlreadyExists", site: "creating_duplicate", argument: "identity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "AlreadyExists", site: "creating_duplicate", argument: "offered",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "AlreadyExists", site: "entity_duplicate", argument: "entity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "AlreadyExists", site: "entity_duplicate", argument: "aggregate",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "AlreadyExists", site: "entity_duplicate", argument: "identity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      # One described value per identity head (MutationApplier), or the
      # one offered element identity (EntityListCoercion).
      member refusal: "AlreadyExists", site: "entity_duplicate", argument: "offered",
             shape: "list", quoting: "none", separator: ", ", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "acting_no_identity", argument: "command",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "acting_no_identity", argument: "aggregate",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "acting_no_identity", argument: "identity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "record_missing", argument: "aggregate",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "record_missing", argument: "identity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "record_missing", argument: "offered",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "entity_parent_no_identity", argument: "command",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "entity_parent_no_identity", argument: "aggregate",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "entity_parent_no_identity", argument: "entity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "entity_parent_no_identity", argument: "identity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "entity_unknown", argument: "aggregate",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "entity_unknown", argument: "entity",
             shape: "scalar", quoting: "inspect", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "entity_element_no_identity", argument: "command",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "entity_element_no_identity", argument: "entity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "entity_element_no_identity", argument: "identity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "entity_element_missing", argument: "entity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "entity_element_missing", argument: "identity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "entity_element_missing", argument: "wants",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "entity_element_missing", argument: "aggregate",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "entity_element_missing", argument: "parent_id",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "reference_target_missing", argument: "target",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "reference_target_missing", argument: "heads",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "reference_target_missing", argument: "key",
             shape: "scalar", quoting: "inspect", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "read_model_reference_missing", argument: "aggregate",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "NotFound", site: "read_model_reference_missing", argument: "offered",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "TypeMismatch", site: "read_model_object_reference", argument: "query",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "TypeMismatch", site: "read_model_object_reference", argument: "field",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "no_query", argument: "aggregate",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "no_query", argument: "query",
             shape: "scalar", quoting: "inspect", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "entity_query_missing", argument: "entity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "entity_query_missing", argument: "query",
             shape: "scalar", quoting: "inspect", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "entity_holds_no_list", argument: "aggregate",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "entity_holds_no_list", argument: "entity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "entity_no_command", argument: "entity",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "entity_no_command", argument: "command",
             shape: "scalar", quoting: "inspect", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "aggregate_no_command", argument: "aggregate",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "aggregate_no_command", argument: "command",
             shape: "scalar", quoting: "inspect", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "port_no_operation", argument: "port",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "port_no_operation", argument: "operation",
             shape: "scalar", quoting: "inspect", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "no_domain", argument: "domain",
             shape: "scalar", quoting: "inspect", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "no_domain", argument: "verb",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "no_read_model", argument: "domain",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "no_read_model", argument: "query",
             shape: "scalar", quoting: "inspect", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "not_fully_qualified", argument: "verb",
             shape: "scalar", quoting: "inspect", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "no_aggregate", argument: "domain",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "UnknownVerb", site: "no_aggregate", argument: "aggregate",
             shape: "scalar", quoting: "inspect", separator: "", sorted: "false", when_empty: ""
      member refusal: "LifecycleRefused", site: "transition_blocked", argument: "command",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "LifecycleRefused", site: "transition_blocked", argument: "field",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
