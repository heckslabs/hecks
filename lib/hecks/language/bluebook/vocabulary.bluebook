             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "AttributeAbsent", site: "absent_read", argument: "field",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "ProjectionAbsent", site: "absent_read", argument: "aggregate",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "ProjectionAbsent", site: "absent_read", argument: "field",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "ProjectionAbsent", site: "absent_read", argument: "reference",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "ProjectionAbsent", site: "absent_read", argument: "remote_field",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
    end

    # A leg answers an event (`on "AccountDebited"`) or one of these non-event
    # outcomes — `on :refused` is the compensating leg for a dispatch the
    # procedure declined (SagaInterpreter::REFUSED).
    value_object "Trigger" do
      attribute :name, String, one_of: ["refused"]
    end

    # Regexes `text_field` matches a text attribute's name against
    # (case-insensitively) to guess an HTML input type or textarea kind, when
    # nothing more specific already answered (Hecks::Forms::FieldShape's
    # EMAIL_HINT/URL_HINT/TEL_HINT/TEXTAREA_HINT). `pattern` is the regex
    # source, no delimiters or flags. hecks project_field_hints writes the Rust
    # host's copy from these rows, so neither side is typed by hand.
    #
    # `resolves_to` names which Field attribute a match sets: html_type for
    # email/url/tel (checked in that order, first match wins), kind for
    # textarea (checked once html_type has fallen through to "text").
    value_object "FieldHint" do
      attribute :name,        String
      attribute :pattern,     String
      attribute :resolves_to, String

      member name: "email",    pattern: 'email',                                                 resolves_to: "html_type"
      member name: "url",      pattern: '\b(url|uri|website|link)\b',                             resolves_to: "html_type"
      member name: "tel",      pattern: 'phone|\btel(ephone)?\b',                                 resolves_to: "html_type"
      member name: "textarea", pattern: '\b(text|body|note|notes|description|message|comment)\b', resolves_to: "kind"
    end

    # The path gates the workflows run before an expensive job: one detector job
    # per row, answering `touched` from the diff of the change against its base.
    # hecks project_ci_gates writes each row into the marked region of its
    # `workflow` (.github/workflows/<workflow>); the base-commit logic every gate
    # shares lives once, in .github/actions/changed-paths.
    #
    # `mode` is how `pattern` (an extended regex over changed paths) decides:
    # `touches` runs the job when any changed path matches, `skips_unless` runs it
    # when any changed path does NOT match (the pattern is the safe-to-skip list).
    # `push` is what a push event does: `skip` leaves the gate out of push runs,
    # `before_sha` diffs against the push's `before` commit.
    value_object "CiGate" do
      attribute :name,     String
      attribute :workflow, String
      attribute :mode,     String
      attribute :pattern,  String
      attribute :push,     String
      attribute :label,    String

      member name: "runtime_changed", workflow: "ci.yml", mode: "touches",
             pattern: '^lib/hecks/runtime/', push: "skip",
             label: "does this change touch lib/hecks/runtime/**?"
      member name: "postgres_io_relevant_changed", workflow: "ci-postgres-io-parallel.yml", mode: "skips_unless",
             pattern: '^(docs/|editors/|release/|deploy/|\.claude/|\.githooks/|rust/(parser|codegen|host|build|lsp|web|tests|project)/|rust/project\.rb$|rust/project_rust_pipeline\.rb$|\.rubocop\.yml$|\.rubocop_todo\.yml$|\.mcp\.json$|\.rspec-local\.example$|README\.md$|CHANGELOG\.md$|CONTRIBUTING\.md$|SECURITY\.md$|LICENSE$|\.gitignore$)',
             push: "before_sha",
             label: "does this change touch anything rspec_postgres_io_parallel covers?"
    end

    # Rust keywords (strict + reserved) a generated identifier must not
    # collide with. RustProjection::Projector::RUST_KEYWORDS reads this;
    # hecks project_reserved_names projects it into
    # rust/codegen/src/reserved_names.rs, so Ruby and Rust escape or refuse
    # the same words from one declaration instead of two hand-typed copies.
    value_object "RustReservedWord" do
      attribute :word, String,
                one_of: ["as", "break", "const", "continue", "crate", "dyn", "else", "enum", "extern", "false",
                         "fn", "for", "if", "impl", "in", "let", "loop", "match", "mod", "move", "mut", "pub",
                         "ref", "return", "self", "Self", "static", "struct", "super", "trait", "true", "type",
                         "unsafe", "use", "where", "while", "abstract", "become", "box", "do", "final", "macro",
                         "override", "priv", "typeof", "unsized", "virtual", "yield", "try"]
    end

    # The keys a domain's own name must not take, because that name doubles
    # as a Cargo `[features]` key: every key rust/Cargo.toml already uses
    # outside `[features]` (`[package]`, `[lib]`, `[[bin]]`) plus `default`,
    # which Cargo reserves for the auto-enabled feature set. Read by
    # RustProjection::Projector::CARGO_RESERVED_DOMAIN_NAMES and projected by
    # hecks project_reserved_names, same as RustReservedWord above.
    value_object "CargoReservedName" do
      attribute :name, String,
                one_of: ["name", "version", "edition", "path", "authors", "license", "description", "default",
                         "features", "package", "lib", "bin", "dependencies", "dev-dependencies",
                         "build-dependencies", "workspace"]
    end
  end
end
