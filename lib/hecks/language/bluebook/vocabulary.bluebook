      member refusal: "UnknownArgument", site: "unknown_args", argument: "unknown",
             shape: "list", quoting: "none", separator: ", ", sorted: "true", when_empty: ""
      member refusal: "UnknownArgument", site: "unknown_args", argument: "declared",
             shape: "list", quoting: "none", separator: ", ", sorted: "false", when_empty: "none"
      member refusal: "AbsentArgument", site: "absent_args", argument: "command",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "AbsentArgument", site: "absent_args", argument: "absent",
             shape: "list", quoting: "none", separator: ", ", sorted: "true", when_empty: ""
      member refusal: "AbsentArgument", site: "absent_args", argument: "declared",
             shape: "list", quoting: "none", separator: ", ", sorted: "false", when_empty: "none"
      member refusal: "InvariantViolation", site: "closed_set_member", argument: "type",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "InvariantViolation", site: "closed_set_member", argument: "admitted",
             shape: "list", quoting: "inspect", separator: ", ", sorted: "false", when_empty: ""
      member refusal: "InvariantViolation", site: "closed_set_member", argument: "offered",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "InvariantViolation", site: "value_object_invariant", argument: "name",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "InvariantViolation", site: "value_object_invariant", argument: "description",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "InvariantViolation", site: "value_object_invariant", argument: "offered",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "InvariantViolation", site: "admits_declared_set", argument: "name",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "InvariantViolation", site: "admits_declared_set", argument: "admits",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "InvariantViolation", site: "admits_declared_set", argument: "admitted",
             shape: "list", quoting: "inspect", separator: ", ", sorted: "false", when_empty: ""
      member refusal: "InvariantViolation", site: "admits_declared_set", argument: "offered",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "InvariantViolation", site: "undeclared_set", argument: "name",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "InvariantViolation", site: "undeclared_set", argument: "admits",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "InvariantViolation", site: "group_by_collision", argument: "read_model",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "InvariantViolation", site: "group_by_collision", argument: "fields",
             shape: "list", quoting: "none", separator: ", ", sorted: "false", when_empty: ""
      member refusal: "InvariantViolation", site: "group_by_collision", argument: "ids",
             shape: "list", quoting: "inspect", separator: ", ", sorted: "true", when_empty: ""
      # "field = value" per key-path level, joined with ", " by the caller:
      # each value is its own `to_s`, the same text the nested Hash keys it by.
      member refusal: "InvariantViolation", site: "group_by_collision", argument: "key",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "Unauthorized", site: "tenant_required", argument: "query",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "Unauthorized", site: "tenant_required", argument: "field",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "Unauthorized", site: "role_mismatch", argument: "command",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
      member refusal: "Unauthorized", site: "role_mismatch", argument: "role",
             shape: "scalar", quoting: "none", separator: "", sorted: "false", when_empty: ""
