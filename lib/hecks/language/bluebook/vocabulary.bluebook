      member script: "qa_concurrency_racer", section: "QualityControl", aggregate: "Sweep", verb: "race", note: "not user-facing; ProcessPool starts it"
    end

    # Rust keywords (strict + reserved) a generated identifier must not
    # collide with. ModelCheck reads this; hecks project_reserved_names
    # projects it into rust/codegen/src/reserved_names.rs, so Ruby and Rust
    # escape or refuse the same words from one declaration instead of two
    # hand-typed copies.
    value_object "RustReservedWord" do
      attribute :word, String,
                one_of: ["as", "break", "const", "continue", "crate", "dyn", "else", "enum", "extern", "false",
                         "fn", "for", "if", "impl", "in", "let", "loop", "match", "mod", "move", "mut", "pub",
                         "ref", "return", "self", "Self", "static", "struct", "super", "trait", "true", "type",
                         "unsafe", "use", "where", "while", "abstract", "become", "box", "do", "final", "macro",
                         "override", "priv", "typeof", "unsized", "virtual", "yield", "try"]
    end

    # The keys a domain's own name must not take, because that name doubles
    # as a Cargo `[features]` key: every key rust/Cargo.toml already uses
    # outside `[features]` (`[package]`, `[lib]`, `[[bin]]`) plus `default`,
    # which Cargo reserves for the auto-enabled feature set. Read by
    # Hecks::RustBuild::DomainName and projected by hecks
    # project_reserved_names, same as RustReservedWord above.
    value_object "CargoReservedName" do
      attribute :name, String,
                one_of: ["name", "version", "edition", "path", "authors", "license", "description", "default",
                         "features", "package", "lib", "bin", "dependencies", "dev-dependencies",
                         "build-dependencies", "workspace"]
    end
  end
end
