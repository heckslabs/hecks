      member script: "corpus", section: "Codebase", aggregate: "CorpusRun", verb: "regen_order"
      member script: "corpus", section: "Codebase", aggregate: "CorpusRun", verb: "corpus_rust_coverage"
      member script: "query_ir", section: "Codebase", aggregate: "CorpusRun", verb: "ir_constructs"
      member script: "query_ir", section: "Codebase", aggregate: "CorpusRun", verb: "ir_duplicates"
      member script: "query_ir", section: "Codebase", aggregate: "CorpusRun", verb: "ir_impact"
      member script: "hecks_query_ir_mcp", section: "Codebase", aggregate: "CorpusRun", verb: "serve_query_ir_mcp"
      member script: "present", section: "Codebase", aggregate: "CorpusRun", verb: "present"
      member script: "release", section: "Codebase", aggregate: "PublishingRun", verb: "publish", note: "without --confirm, the old --dry-run"
      member script: "release_gem", section: "Codebase", aggregate: "PublishingRun", verb: "publish_gem"
      member script: "(new)", section: "Codebase", aggregate: "GateRun", verb: "gate"
      member script: "qa_tick", section: "QualityControl", aggregate: "Sweep", verb: "tick"
      member script: "qa_sweep", section: "QualityControl", aggregate: "Sweep", verb: "run", passes: "--all --seeds N --steps N --adversarial F --role-draw F --dry-run F --self-consistency BOOL --modes a,b --persistence-parity --no-parity"
      member script: "qa_sweep", section: "QualityControl", aggregate: "Target", verb: "release"
      member script: "qa_pr_check", section: "QualityControl", aggregate: "Clearance", verb: "check_pull_requests"
      member script: "qa_open_pr", section: "QualityControl", aggregate: "Patch", verb: "open"
      member script: "qa_open_pr", section: "QualityControl", aggregate: "Improvement", verb: "open"
      member script: "qa_log_bug", section: "QualityControl", aggregate: "Bug", verb: "log"
      member script: "qa_seed_angles", section: "QualityControl", aggregate: "Angle", verb: "seed"
      member script: "qa_seed_targets", section: "QualityControl", aggregate: "Target", verb: "seed"
      member script: "qa_generated_domains", section: "QualityControl", aggregate: "Target", verb: "check_generated_domains", passes: "--domains 3 --start N --forms a,b --seeds 5 --steps 25 --adversarial 0.3 --rust --shrink-budget 200 --domain-shrink-budget 40 --promote dir --name N --from-dials --blueprint F --source F"
      member script: "qa_mine_combinations", section: "QualityControl", aggregate: "Target", verb: "mine_combinations", passes: "--candidates 3 --rust --seeds 5 --steps 25 --adversarial 0.3 --repair-rounds 1 --agent CMD --from DIR --against PATH --brief"
      member script: "(new)", section: "QualityControl", aggregate: "Target", verb: "mutate", passes: "--file rust/src/… --from-dials"
      member script: "qa_domain_novelty", section: "QualityControl", aggregate: "Target", verb: "judge_novelty", passes: "--against PATH …"
      member script: "qa_discover_external_domains", section: "QualityControl", aggregate: "Target", verb: "discover_external_domains", passes: "--projects-dir ~/Projects --max-depth 3 --known-path PATH …"
      member script: "qa_postgres_migrate", section: "QualityControl", aggregate: "Sweep", verb: "migrate_ledger_from_heki", passes: "[aggregate …] --force", note: "a dry run without --force"
      member script: "qa_postgres_role", section: "QualityControl", aggregate: "Sweep", verb: "create_ledger_role"
      member script: "qa_concurrency_racer", section: "QualityControl", aggregate: "Sweep", verb: "race", note: "not user-facing; ProcessPool starts it"
    end

    # Rust keywords (strict + reserved) a generated identifier must not
    # collide with. ModelCheck reads this; hecks project_reserved_names
    # projects it into rust/codegen/src/reserved_names.rs, so Ruby and Rust
    # escape or refuse the same words from one declaration instead of two
    # hand-typed copies.
    value_object "RustReservedWord" do
      attribute :word, String,
                one_of: ["as", "async", "await", "break", "const", "continue", "crate", "dyn", "else", "enum",
                         "extern", "false", "fn", "for", "if", "impl", "in", "let", "loop", "match", "mod", "move", "mut", "pub",
                         "ref", "return", "self", "Self", "static", "struct", "super", "trait", "true", "type",
                         "unsafe", "use", "where", "while", "abstract", "become", "box", "do", "final", "macro",
                         "override", "priv", "typeof", "unsized", "virtual", "yield", "try"]
    end

    # The keys a domain's own name must not take, because that name doubles
    # as a Cargo `[features]` key: every key rust/Cargo.toml already uses
    # outside `[features]` (`[package]`, `[lib]`, `[[bin]]`) plus `default`,
    # which Cargo reserves for the auto-enabled feature set. Read by
    # Hecks::RustBuild::DomainName and projected by hecks
    # project_reserved_names, same as RustReservedWord above.
    value_object "CargoReservedName" do
      attribute :name, String,
                one_of: ["name", "version", "edition", "path", "authors", "license", "description", "default",
                         "features", "package", "lib", "bin", "dependencies", "dev-dependencies",
                         "build-dependencies", "workspace"]
    end
  end
end
