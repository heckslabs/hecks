Hecks.bluebook "Bluebook" do
  aggregate "ValueObject" do
    description "One value object declared on an aggregate — its fields and the rules they must satisfy. Its own root because a value object holds nested lists, which no list element can."

    reference_to Aggregate

    # Identity is the owning aggregate plus the name; `Name` recurs across chapters.
    identified_by :aggregate, :name

    attribute :name,       ValueObjectName
    attribute :attributes, list_of(ShapeField)
    attribute :invariants, list_of(Assertion)
    attribute :rows,       RowCount, optional: true
    # Member is nested here as an entity; `list_of(Member)` forward-references it.
    attribute :members,    list_of(Member)

    value_object "RowCount" do
      attribute :value, Integer
    end

    value_object "ValueObjectName" do
      attribute :value, String, pattern: '[^ \t\n\r]'
      invariant("a value object is named") { !value.to_s.empty? }
    end

    value_object "ShapeField" do
      attribute :name,    String, pattern: '[^ \t\n\r]'
      attribute :type,    String, pattern: '[^ \t\n\r]'
      attribute :list,    String, pattern: '[^ \t\n\r]'
      attribute :optional, String, optional: true
      attribute :pattern,  String, optional: true
      # optional: a declaration with no default has none
      attribute :default, String, optional: true
      # The closed set this value must belong to; see Aggregate::Field.
      attribute :admits, String, optional: true
      attribute :relationship, String, optional: true
      invariant("a field is named") { !name.to_s.empty? }
      invariant("a field has a type") { !type.to_s.empty? }
      invariant("a field's list mode is specified") { !list.to_s.empty? }
    end

    value_object "Assertion" do
      attribute :description, String, pattern: '[^ \t\n\r]'
      attribute :canonical,   String, pattern: '[^ \t\n\r]'
      invariant("an assertion description is present") { !description.to_s.empty? }
      invariant("an assertion canonical form is present") { !canonical.to_s.empty? }
    end

    # An entity cannot declare its own value objects, so Member's pieces live here.
    # MemberPosition is distinct from Position: that orders value objects among an
    # aggregate's siblings, this orders admitted rows within one value object.
    value_object "MemberPosition" do
      attribute :value, Integer
    end

    value_object "MemberText" do
      attribute :value, String
      # Free-form text; may be empty or numeric, so unrestricted.
    end

    value_object "Pair" do
      attribute :key,   String, pattern: '[^ \t\n\r]'
      attribute :value, String
      # Keys must be named; values may be empty or numeric.
      invariant("a pair key is present") { !key.to_s.empty? }
    end

    # Declaration order is a fact about the source, so the language holds it rather than
    # inheriting store iteration order; an unordered ask is answered in identity order.
    value_object "Position" do
      attribute :value, Integer
    end

    attribute :position, Position

    query "DeclaredIn" do
      attribute :aggregate, ValueObjectText
      where(aggregate: :aggregate)
      order_by :position
    end
    command "Declare" do
      role "Language"
      goal "Open a value object on an aggregate"

      reference_to Aggregate
      attribute :name, ValueObjectName

      attribute :position, Position, optional: true
      sets :aggregate
      sets :name
      sets :position
      emits ShapeDeclared
    end

    command "Field" do
      role "Language"
      goal "Attach one field to the value object"

      attribute :name,    ValueObjectName
      attribute :type,    ValueObjectName
      attribute :list,    ValueObjectName
      attribute :optional, ValueObjectName, optional: true
      # Free text, like `default`; ValueObjectName's "is named" invariant does not suit a regex.
      attribute :pattern,  ValueObjectText, optional: true
      attribute :default, ValueObjectText, optional: true
      attribute :admits,  ValueObjectText, optional: true
      # Same field as Command.Argument's :relationship (command.bluebook).
      attribute :relationship, ValueObjectText, optional: true

      sets :attributes, append: { name: :name, type: :type, list: :list, default: :default, optional: :optional, pattern: :pattern, admits: :admits, relationship: :relationship }

      emits ShapeFieldAttached
    end

    command "Close" do
      role "Language"
      goal "Declare that this value object admits a closed set of rows"

      # Dispatched only when a one_of was declared, so an empty closed set is visible.
      # Members live in their own list, so the count is passed in.

      given("a closed set admits a member") { rows.value > 0 }

      sets :rows

      emits ShapeClosed
    end

    command "Assert" do
      role "Language"
      goal "Attach one invariant to the value object"

      attribute :description, ValueObjectText, optional: true
      attribute :canonical,   ValueObjectText

      given("a rule says what it means")  { !description.value.to_s.empty? }
      given("a rule survives extraction") { !canonical.value.to_s.empty? }

      sets :invariants, append: { description: :description, canonical: :canonical }

      emits AssertionAttached
    end

    value_object "ValueObjectText" do
      attribute :value, String
      # Free-form text; may be empty or numeric, so unrestricted.
    end

    # An entity is only located by its own dotted verb, never created (see
    # EntityInterpreter#element_of), so Member is created by an append here.
    # Pairs are added afterward through the entity's own `Pair`.
    command "Member" do
      role "Language"
      goal "Open one admitted row on a value object"

      attribute :position, MemberPosition

      sets :members, append: { position: :position }

      emits MemberDeclared
    end

    # One admitted row, nested because its pairs are an open map, which a value
    # object cannot hold. `ValueObject.Member` creates it; `Pair` fills it in.
    entity "Member" do
      description "One admitted row of a value object's one_of — a whole combination of field values, not a per-field choice. Nested under the value object because a row is a list of pairs inside a list of rows."

      # Position is read from the source; `ValueObject.Member` mints it as the walk index.
      identified_by MemberPosition, as: :position

      attribute :pairs, list_of(Pair)

      command "Pair" do
        role "Language"
        goal "Bind one field of the admitted row"

        attribute :key,   MemberText
        attribute :value, MemberText

        given("an admitted row binds a named field") { !key.value.to_s.empty? }

        sets :pairs, append: { key: :key, value: :value }

        emits PairBound
      end
    end

    # Spelling rows for ValueObject, OneOf and Type; SyntaxBoot discovers each seed table.
    value_object "KeywordSeed" do
      attribute :word,          String
      attribute :context,       String, admits: "Syntax::Context"
      attribute :body,          String, admits: "Syntax::Body"
      attribute :inner,         String
      attribute :opens,         String
      attribute :fills,         String
      attribute :status,        String, default: "admitted", admits: "Syntax::Status"
      attribute :was,           String
      attribute :resolves_via,  String, default: "", admits: "Syntax::ResolutionScope"
      attribute :disambiguator, String, default: "", admits: "Syntax::Disambiguator"

      member word: "attribute",       context: "ValueObject", body: "none",   inner: "",      opens: "", fills: "attributes", calls: "attribute_impl"
      member word: "one_of",          context: "ValueObject", body: "rows",   inner: "OneOf", opens: "", fills: "rows", calls: "one_of_impl"
      member word: "invariant",       context: "ValueObject", body: "source", inner: "",      opens: "", fills: "invariants", resolves_via: "sibling_scan", calls: "invariant_impl"
      member word: "member",          context: "ValueObject", body: "none", inner: "", opens: "Member", fills: "", calls: "member_impl"
      member word: "member",          context: "OneOf",     body: "none", inner: "", opens: "Member", fills: "", calls: "member_impl"
      member word: "list_of",         context: "Type", body: "none", inner: "", opens: "", fills: "", calls: "list_of_impl"
      member word: "one_of",          context: "Type", body: "none", inner: "", opens: "", fills: "", calls: "one_of_impl"

    end

    value_object "ArgumentSeed" do
      attribute :keyword,          String
      attribute :context,          String, admits: "Syntax::Context"
      attribute :at,               String
      attribute :named,            String
      attribute :kind,             String, admits: "Syntax::ArgumentKind"
      attribute :required,         String
      attribute :fills,            String
      attribute :selects,          String
      attribute :pair_key_fills,   String
      attribute :pair_value_fills, String
      attribute :pairs_shape,      String, admits: "Syntax::PairsShape"
      attribute :status,           String, default: "admitted", admits: "Syntax::Status"
      attribute :variadic,         String
      attribute :coerce,           String
      attribute :blank_message,    String

      member keyword: "attribute",       context: "ValueObject", at: "1", named: "",         kind: "symbol",   required: "true",  fills: "name"
      member keyword: "attribute",       context: "ValueObject", at: "2", named: "",         kind: "constant", required: "true",  fills: "type"
      member keyword: "attribute",       context: "ValueObject", at: "",  named: "default",  kind: "literal",  required: "false", fills: "default"
      member keyword: "attribute",       context: "ValueObject", at: "",  named: "optional", kind: "flag",     required: "false", fills: "optional"
      member keyword: "attribute",       context: "ValueObject", at: "",  named: "pattern",  kind: "text",     required: "false", fills: "pattern"
      member keyword: "attribute",       context: "ValueObject", at: "",  named: "admits",   kind: "text",     required: "false", fills: "admits"
      member keyword: "attribute",       context: "ValueObject", at: "",  named: "one_of",   kind: "list",     required: "false", fills: "one_of"
      member keyword: "invariant",       context: "ValueObject", at: "1", named: "",         kind: "text",     required: "true",  fills: "description"
      member keyword: "member",          context: "ValueObject", at: "1", named: "", kind: "pairs", required: "true", fills: "members", pairs_shape: "verbatim"
      member keyword: "member",          context: "OneOf",     at: "1", named: "",     kind: "pairs", required: "true",  fills: "members", pairs_shape: "verbatim"
      member keyword: "list_of",         context: "Type", at: "1", named: "", kind: "constant", required: "true", fills: ""
      member keyword: "one_of",          context: "Type", at: "1", named: "", kind: "literal",  required: "true", fills: ""

    end
  end
end
