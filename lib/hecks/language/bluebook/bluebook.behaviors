Hecks.behaviors "Bluebook" do
  vision "A bluebook is opened with a name, a vision and a classification, and refuses a classification the language does not admit."

  loads "bluebook.bluebook", "bluebook.hecksagon"

  test "Declare opens a bluebook" do
    tests "Declare", on: "Bluebook"
    input name: "Pizzas", vision: "Pizzas, built and sold.", classification: "core"
    expect emits: ["BluebookDeclared"]
  end

  test "Declare refuses a classification that is not core, supporting or generic" do
    tests "Declare", on: "Bluebook"
    input name: "Pizzas", vision: "Pizzas, built and sold.", classification: "huge"
    expect refused: "a bluebook is core, supporting, or generic"
  end

  test "Declare refuses a bluebook with no name" do
    tests "Declare", on: "Bluebook"
    input name: "", vision: "Pizzas, built and sold.", classification: "core"
    expect refused: "a bluebook is named"
  end
end
