Hecks.bluebook "Port" do
  vision "The .port language, declared in itself. A port names one resource door a domain's own aggregates call by verb — persisted_by, posted_by, whatever a chapter spells — bound to a real driven adapter at the world level. A sibling artifact to the bluebook, not part of one: the same port name is reused across every domain that needs the same kind of door."
  core

  aggregate "Port" do
    description "One .port — a resource door a domain's own aggregates call by verb, and whether calling it answers with a value (reply) or fires an effect with nothing to hand back (effect)."

    identified_by PortName, as: :name

    attribute :verb,    PortVerb
    attribute :signal,  PortSignal
    attribute :answers, list_of(PortAnswer)

    value_object "PortName" do
      attribute :value, String
      invariant("a port names itself") { !value.to_s.empty? }
    end

    value_object "PortVerb" do
      attribute :value, String
      invariant("a port's verb says something") { !value.to_s.empty? }
    end

    value_object "PortSignal" do
      attribute :value, String, one_of: ["reply", "effect"]
    end

    # The method contract: what an adapter must `respond_to?` for a dispatch through this door.
    # A port that declares none is unchecked beyond `verify!`.
    value_object "PortAnswer" do
      attribute :value, String
      invariant("an answer names a real method") { !value.to_s.empty? }
    end

    command "Declare" do
      role "Deployment"
      goal "Open a resource door a domain's own aggregates may call by verb"

      attribute :name,   PortName
      # Optional: a port may declare only `signal`; `verb` has no default, unlike `signal`.
      attribute :verb,   PortVerb, optional: true
      attribute :signal, PortSignal

      sets :name
      sets :verb
      sets :signal

      emits "PortDeclared"
    end

    command "AddAnswer" do
      role "Deployment"
      goal "Name one method a real adapter for this port must respond to"

      reference_to Port
      attribute :value, PortAnswer

      sets :answers, append: { value: :value }

      emits "PortAnswerAdded"
    end

    # Keyword rows for File and Port; SyntaxBoot discovers every aggregate-local seed table.
    value_object "KeywordSeed" do
      attribute :word,          String
      attribute :context,       String, admits: "Syntax::Context"
      attribute :body,          String, admits: "Syntax::Body"
      attribute :inner,         String
      attribute :opens,         String
      attribute :fills,         String
      attribute :status,        String, default: "admitted", admits: "Syntax::Status"
      attribute :was,           String
      attribute :resolves_via,  String, default: "", admits: "Syntax::ResolutionScope"
      attribute :disambiguator, String, default: "", admits: "Syntax::Disambiguator"

      member word: "port",            context: "File",     body: "keywords", inner: "Port",           opens: "Port",           fills: ""
      member word: "verb",            context: "Port",      body: "none", inner: "", opens: "", fills: "verb"
      member word: "signal",          context: "Port",      body: "none", inner: "", opens: "", fills: "signal"
      member word: "answers",         context: "Port",      body: "none", inner: "", opens: "", fills: "answers"

    end

    value_object "ArgumentSeed" do
      attribute :keyword,          String
      attribute :context,          String, admits: "Syntax::Context"
      attribute :at,               String
      attribute :named,            String
      attribute :kind,             String, admits: "Syntax::ArgumentKind"
      attribute :required,         String
      attribute :fills,            String
      attribute :selects,          String
      attribute :pair_key_fills,   String
      attribute :pair_value_fills, String
      attribute :pairs_shape,      String, admits: "Syntax::PairsShape"
      attribute :status,           String, default: "admitted", admits: "Syntax::Status"
      attribute :variadic,         String
      attribute :coerce,           String
      attribute :blank_message,    String

      member keyword: "port",            context: "File", at: "1", named: "", kind: "text", required: "true", fills: "name"
      member keyword: "verb",            context: "Port", at: "1", named: "", kind: "text",   required: "true", fills: "verb"
      member keyword: "signal",          context: "Port", at: "1", named: "", kind: "symbol", required: "true", fills: "signal"
      member keyword: "answers",         context: "Port", at: "1", named: "", kind: "symbol", required: "true", fills: "answers"

    end
  end
end
