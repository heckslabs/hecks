# The RailsApp bluebook: what a Rails app says of its own pages, beside the domain it drives.
#
# Every page is derived from the domain: a list and a form for each creating command, a record
# page that offers the commands the signed-in person may run. A project declares only what the
# domain cannot say, as `member` rows of a `value_object "App"` or `"Listing"` in its own bluebook;
# the aggregates below name every field a row may carry. A project with no rows has pages that
# work, titled after its Rails application, with a list for each aggregate in the order declared.
#
# `hecks-rails` reads the rows when the app boots. Nothing here names a database, a template or a
# route: the pages are the same code for every domain, and these rows are the only place a project
# changes them. No command declares a role: the bluebook boots standing alone.
Hecks.bluebook "RailsApp" do
  vision "Name a Rails app and shape its lists; every page else is derived from the domain."

  aggregate "App" do
    description "The shape of the one App row: the name the pages carry and the aggregate the app opens on."

    identified_by :title

    attribute :title, Title
    attribute :home,  Home, optional: true

    # Shown in the header and the browser tab; the Rails application's own name when no row names one.
    value_object "Title" do
      attribute :value, String, matches: :present
    end

    # The aggregate the root path lists, by its name in the domain; the first aggregate declared when
    # no row names one.
    value_object "Home" do
      attribute :value, String, matches: :present
    end
  end

  aggregate "Listing" do
    description "The shape of one Listing row: how the list of an aggregate is headed and which of its attributes it shows."

    identified_by :aggregate

    attribute :aggregate, AggregateName
    attribute :label,     Label,   optional: true
    attribute :columns,   Columns, optional: true

    # The aggregate the row shapes, by its name in the domain.
    value_object "AggregateName" do
      attribute :value, String, matches: :present
    end

    # The heading and navigation entry for the aggregate; its plural name in words when absent.
    value_object "Label" do
      attribute :value, String, matches: :present
    end

    # The attributes shown as columns, comma separated and in order; identity, lifecycle state and
    # the first scalar attributes when absent.
    value_object "Columns" do
      attribute :value, String, matches: :present
    end
  end
end
