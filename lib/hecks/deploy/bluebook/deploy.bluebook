# The Deploy chapter: what `deployed_to(...)` may declare, and the commands that generate, check and
# compare a deploy recipe, project the OIDC manifests and provision a tenant.
#
# `hecks deploy recipe.project` and `hecks deploy tenant.provision` boot it directly; the Hecks domain attaches it, so
# each command below is also `hecks deploy <verb>`. The targets validate the `deployed_to` shape
# that `world.bluebook`'s untyped `Setting` map leaves open. Each run below records that it was
# requested before its DeployToolchain port is asked, and what came of it after. No command
# declares a role: the chapter boots standing alone, without Governance to check one against.
Hecks.bluebook "Deploy" do
  vision "Generate, check and compare deploy recipes, project OIDC manifests and provision tenants."

  aggregate "LambdaTarget" do
    description "One domain's validated AWS Lambda deploy target — what deployed_to(\"AwsLambda\") must resolve to before hecks deploy recipe.project generates anything from it."

    identified_by :domain

    attribute :domain,   DomainName
    attribute :region,   Region
    attribute :memory,   Memory
    attribute :timeout,  Timeout
    attribute :database, Database
    attribute :web,      Web
    attribute :dispatch, Dispatch,      optional: true
    attribute :handler_module, HandlerModule, optional: true
    attribute :secret_env, SecretEnv,   optional: true

    value_object "DomainName" do
      attribute :value, String
      invariant("a domain is named") { !value.to_s.empty? }
    end

    value_object "Region" do
      attribute :value, String
      invariant("a region is named") { !value.to_s.empty? }
    end

    # "Postgres" (plain RDS, the default when `deployed_to` names none) or "Aurora"
    # (Serverless v2);
    # only the emitted CloudFormation resource differs, never the runtime adapter. "Shared" borrows
    # another domain's instance under its own Postgres schema and needs an `owner` setting, which
    # `hecks deploy recipe.project` checks, since the owning domain is a deploy-time fact.
    value_object "Database" do
      attribute :value, String, one_of: ["Postgres", "Aurora", "Shared"]
    end

    # "None" (default) or "Rust": the domain's own Lambda (rust/host) also serves a public web UI
    # in-process (rust/host/src/web.rs). "Ruby" is not a member: a Ruby WebFunction comes from a
    # `lambda_handler.rb` file, and `hecks deploy recipe.project` refuses `web "Rust"` alongside one.
    value_object "Web" do
      attribute :value, String, one_of: ["None", "Rust"]
    end

    # "Rust" (default) or "None": a domain with no `.bluebook` command surface to dispatch through
    # (a webhook that dispatches straight into Ruby) skips the rust/host dispatch Lambda, and its
    # WebFunction becomes its only Lambda. That WebFunction's `lambda_handler.rb` defines the module
    # `handler_module` names, so `dispatch "None"` must name one.
    value_object "Dispatch" do
      attribute :value, String, one_of: ["Rust", "None"]
    end

    # The module the domain's `lambda_handler.rb` defines for its WebFunction.
    value_object "HandlerModule" do
      attribute :value, String
      invariant("a handler module is named") { !value.to_s.empty? }
    end

    # The env var the WebFunction's `lambda_handler.rb` finds the fetched secret's plaintext under,
    # once it resolves `<name>_ARN`.
    value_object "SecretEnv" do
      attribute :value, String
      invariant("a secret env var is named") { !value.to_s.empty? }
    end

    # 128-10240 MB, AWS Lambda's own floor and ceiling.
    value_object "Memory" do
      attribute :value, Integer
      invariant("memory is at least 128 MB") { value >= 128 }
      invariant("memory is at most 10240 MB") { value <= 10240 }
    end

    # Lambda's own ceiling of 900s.
    value_object "Timeout" do
      attribute :value, Integer
      invariant("a timeout is positive") { value.positive? }
      invariant("a timeout fits Lambda's own 900s ceiling") { value <= 900 }
    end

    # All required, no `default:`: command-level defaults apply only at the JSON/Rust-codegen
    # boundary, not Ruby's direct dispatch (interpreting.rb `normalize_args`). Defaults are
    # resolved by `hecks deploy recipe.project` before it dispatches.
    command "Declare" do
      goal "Validate one domain's AwsLambda deploy target before anything is generated from it"

      attribute :domain,   DomainName
      attribute :region,   Region
      attribute :memory,   Memory
      attribute :timeout,  Timeout
      attribute :database, Database
      attribute :web,      Web
      attribute :dispatch, Dispatch,      optional: true
      attribute :handler_module, HandlerModule, optional: true
      attribute :secret_env, SecretEnv,   optional: true

      given('dispatch "None" names its handler_module: add handler_module "YourModuleName" for the module lambda_handler.rb defines') do
        dispatch.unset? || dispatch.value != "None" || handler_module.set?
      end

      sets :domain
      sets :region
      sets :memory
      sets :timeout
      sets :database
      sets :web
      sets :dispatch
      sets :handler_module
      sets :secret_env

      emits "LambdaTargetDeclared"
    end
  end

  # A sibling of `LambdaTarget` with its own value objects, since value objects are not
  # shared across aggregates.
  aggregate "FargateTarget" do
    description "One domain's validated AWS Fargate deploy target — what deployed_to(\"AwsFargate\") must resolve to before hecks deploy recipe.project generates anything from it."

    identified_by :domain

    attribute :domain,   DomainName
    attribute :region,   Region
    attribute :cpu,      Cpu
    attribute :memory,   Memory
    attribute :database, Database
    attribute :web,      Web
    attribute :port,     Port

    value_object "DomainName" do
      attribute :value, String
      invariant("a domain is named") { !value.to_s.empty? }
    end

    value_object "Region" do
      attribute :value, String
      invariant("a region is named") { !value.to_s.empty? }
    end

    # Positive only: ECS enforces AWS's cpu/memory pairings at deploy time, so this just
    # catches a typo.
    value_object "Cpu" do
      attribute :value, Integer
      invariant("cpu is positive") { value.positive? }
    end

    # Fargate's own range, not Lambda's 128-10240 MB. A sanity floor and ceiling, not AWS's
    # cpu-paired table (see `Cpu`).
    value_object "Memory" do
      attribute :value, Integer
      invariant("memory is positive") { value.positive? }
      invariant("memory is at most 122880 MB") { value <= 122880 }
    end

    # As `LambdaTarget`'s `Database`.
    value_object "Database" do
      attribute :value, String, one_of: ["Postgres", "Aurora", "Shared"]
    end

    # As `LambdaTarget`'s `Web`; "Rust" serves the web UI in-process on this aggregate's `Port`.
    value_object "Web" do
      attribute :value, String, one_of: ["None", "Rust"]
    end

    # The container port the task listens on and the target group routes to.
    value_object "Port" do
      attribute :value, Integer
      invariant("a port is at least 1") { value >= 1 }
      invariant("a port is at most 65535") { value <= 65535 }
    end

    # All seven required for the same reason as `LambdaTarget.Declare`; this validates a
    # target already resolved by `hecks deploy recipe.project`'s defaults.
    command "Declare" do
      goal "Validate one domain's AwsFargate deploy target before anything is generated from it"

      attribute :domain,   DomainName
      attribute :region,   Region
      attribute :cpu,      Cpu
      attribute :memory,   Memory
      attribute :database, Database
      attribute :web,      Web
      attribute :port,     Port

      sets :domain
      sets :region
      sets :cpu
      sets :memory
      sets :database
      sets :web
      sets :port

      emits "FargateTargetDeclared"
    end
  end

  aggregate "BoxTarget" do
    description "One domain's validated single-box deploy target — what deployed_to(\"AwsBox\") must resolve to before hecks deploy project generates a box and an RDS instance from it"

    identified_by :domain

    attribute :domain,         DomainName
    attribute :region,         Region
    attribute :instance_type,  InstanceType
    attribute :volume_gb,      VolumeGb
    attribute :database_class, DatabaseClass
    attribute :storage_gb,     StorageGb

    value_object "DomainName" do
      attribute :value, String
      invariant("a domain is named") { !value.to_s.empty? }
    end

    value_object "Region" do
      attribute :value, String
      invariant("a region is named") { !value.to_s.empty? }
    end

    # An EC2 instance type such as t4g.medium. The family and size are checked for shape only;
    # EC2 refuses an unknown type at stack creation.
    value_object "InstanceType" do
      attribute :value, String
      invariant("an instance type is family.size, such as t4g.medium") { value.to_s.match?(/\A[a-z][a-z0-9-]*\.[a-z0-9]+\z/) }
    end

    # The box's root disk, which holds images, the compose files and container logs; the
    # database is on RDS.
    value_object "VolumeGb" do
      attribute :value, Integer
      invariant("a volume is at least 8 GB") { value >= 8 }
      invariant("a volume is at most 16384 GB") { value <= 16384 }
    end

    # An RDS instance class such as db.t4g.small.
    value_object "DatabaseClass" do
      attribute :value, String
      invariant("a database class is db.family.size, such as db.t4g.small") { value.to_s.match?(/\Adb\.[a-z][a-z0-9-]*\.[a-z0-9]+\z/) }
    end

    # RDS storage grows with the journal; 20 GB is RDS's gp3 floor.
    value_object "StorageGb" do
      attribute :value, Integer
      invariant("storage is at least 20 GB") { value >= 20 }
      invariant("storage is at most 65536 GB") { value <= 65536 }
    end

    # All six required for the same reason as `FargateTarget.Declare`; this validates a target
    # already resolved by `hecks deploy project`'s defaults.
    command "Declare" do
      goal "Validate one domain's AwsBox deploy target before anything is generated from it"

      attribute :domain,         DomainName
      attribute :region,         Region
      attribute :instance_type,  InstanceType
      attribute :volume_gb,      VolumeGb
      attribute :database_class, DatabaseClass
      attribute :storage_gb,     StorageGb

      sets :domain
      sets :region
      sets :instance_type
      sets :volume_gb
      sets :database_class
      sets :storage_gb

      emits "BoxTargetDeclared"
    end
  end

  # The validated shape of `hecks deploy tenant.provision`, which does the generating and provisioning.
  # Not a saga: each of its steps is idempotent and local, so there is nothing to resume.
  aggregate "Tenant" do
    description "One tenant's validated identity — which realm and Postgres schema `hecks deploy tenant.provision` provisions before booting a domain directory under Runtime.boot's own `environment:` overlay for it."

    identified_by :slug

    attribute :slug,      Slug
    attribute :domain,    DomainName
    attribute :realm,     Realm
    attribute :schema,    Schema
    attribute :database,  DatabaseName,  optional: true
    attribute :adapter,   AdapterName,   optional: true
    attribute :directory, DirectoryPath, optional: true
    attribute :output,    Report,        optional: true
    attribute :refusal,   Report,        optional: true

    # Lowercase, no spaces: a slug becomes the `environments/<slug>.world` filename and, by
    # convention only, the schema name (`schema` is separate so a tenant can differ).
    value_object "Slug" do
      attribute :value, String, pattern: '\A[a-z][a-z0-9_]*\z'
      invariant("a tenant slug is named") { !value.to_s.empty? }
    end

    value_object "DomainName" do
      attribute :value, String
      invariant("a tenant names the domain it is for") { !value.to_s.empty? }
    end

    value_object "Realm" do
      attribute :value, String
      invariant("a tenant realm is named") { !value.to_s.empty? }
    end

    # Lowercase, letters/digits/underscores, starting with a letter. Postgres's 63-byte
    # identifier limit is not checked: the invariant expression grammar has no `bytesize`, and
    # Postgres refuses a too-long identifier itself.
    value_object "Schema" do
      attribute :value, String, pattern: '\A[a-z][a-z0-9_]*\z'
      invariant("a schema is named") { !value.to_s.empty? }
    end

    # A database name or a `postgres://` URL, whichever the overlay's `database` setting takes.
    value_object "DatabaseName" do
      attribute :value, String, pattern: '\A[^\t\n\r]+\z'
    end

    # The persistence adapter the overlay binds; PostgresEra when a request names none.
    value_object "AdapterName" do
      attribute :value, String, pattern: '\A[A-Z][A-Za-z0-9]*\z'
    end

    # The domain's own directory on disk, where `environments/<slug>.world` is written.
    value_object "DirectoryPath" do
      attribute :value, String, pattern: '[^\t\n\r]'
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Reprovision" => "requested",   from: %w[provisioned refused]
      transition "Complete"    => "provisioned", from: "requested"
      transition "Abandon"     => "refused",     from: "requested"
    end

    # `hecks deploy tenant.provision <directory> slug=s domain= realm= schema= database= [adapter=]`.
    # The only command that creates a tenant: its slug, schema and realm are validated by the value
    # objects' patterns and invariants, then the overlay is written through the TenantProvisioning
    # port; the adapter answers PostgresEra when `adapter` is left out. `dry_run?` on this verb
    # validates a declaration without recording it.
    command "Provision" do
      goal "Validate one tenant, write its environment overlay world, and register it"

      attribute :directory, DirectoryPath
      attribute :slug,      Slug
      attribute :domain,    DomainName
      attribute :realm,     Realm
      attribute :schema,    Schema
      attribute :database,  DatabaseName
      attribute :adapter,   AdapterName, optional: true

      sets :directory
      sets :slug
      sets :domain
      sets :realm
      sets :schema
      sets :database
      sets :adapter

      emits "TenantProvisionRequested"
    end

    # A tenant's slug names its record, so provisioning it again is its own command; the overlay
    # is rewritten with the database and adapter given now.
    command "Reprovision" do
      goal "Write a provisioned or refused tenant's environment overlay world again"

      reference_to Tenant
      attribute :directory, DirectoryPath
      attribute :database,  DatabaseName
      attribute :adapter,   AdapterName, optional: true

      sets :directory
      sets :database
      sets :adapter

      emits "TenantReprovisionRequested"
    end

    command "Complete" do
      goal "Record that the tenant's overlay was written, and where"

      reference_to Tenant
      attribute :output, Report

      sets :output

      emits "TenantRecorded"
    end

    command "Abandon" do
      goal "Record that the tenant could not be provisioned, and why"

      reference_to Tenant
      attribute :refusal, Report

      sets :refusal

      emits "ProvisioningAbandoned"
    end

    query "Provisioning" do
      description "What provisioning one tenant did: its status, and the reason when it was refused."
      attribute :slug, Slug
      where(slug: :slug)
      order_by :slug
    end

    query "Unprovisioned" do
      description "Every tenant whose provisioning was refused."
      where(status: "refused")
      order_by :slug
    end
  end

  # `TenantProvisioned` also reaches Tenancy's `RegisterProvisionedTenant` where that chapter is
  # attached, so a provisioned tenant becomes a fact there.
  policy "ProvisionWhenRequested" do
    on      "Tenant.TenantProvisionRequested"
    trigger Tenant::TenantProvisioning::WriteOverlay, with: { database: :database, directory: :directory }
  end

  policy "ReprovisionWhenRequested" do
    on      "Tenant.TenantReprovisionRequested"
    trigger Tenant::TenantProvisioning::WriteOverlay, with: { database: :database, directory: :directory }
  end

  policy "RecordTheTenant" do
    on      "Tenant.TenantProvisioned"
    trigger Tenant::Complete, with: { output: :output }
  end

  policy "RecordTheRefusedTenant" do
    on      "Tenant.ProvisioningRefused"
    trigger Tenant::Abandon, with: { refusal: :refusal }
  end

  aggregate "Recipe" do
    description "One generation of a domain's deploy recipe: the template, scripts and Makefile written from its deployed_to target."

    attribute :domain,      DomainPath
    attribute :run,         RunKey
    attribute :tenant,      TenantSlug,      optional: true
    attribute :schema,      SchemaName,      optional: true
    attribute :out,         Location,        optional: true
    attribute :environment, EnvironmentName, optional: true
    attribute :output,      Report,          optional: true
    attribute :refusal,     Report,          optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    # A domain directory, whose `bluebook/` holds the `.world` that declares `deployed_to`.
    value_object "DomainPath" do
      attribute :value, String, pattern: '[^\t\n\r]'

      invariant("a domain is named by its path") { !value.to_s.empty? }
    end

    # A tenant of a shared-database domain: its stack is the domain's own, suffixed with the slug.
    value_object "TenantSlug" do
      attribute :value, String, pattern: '\A[a-z][a-z0-9_]*\z'
    end

    value_object "SchemaName" do
      attribute :value, String, pattern: '\A[a-z][a-z0-9_]*\z'
    end

    # Where the recipe is written, for a domain that lives in a client's repository.
    value_object "Location" do
      attribute :value, String, pattern: '[^\t\n\r]'
    end

    # An `environments/<name>.world` overlay of the domain, which must exist.
    value_object "EnvironmentName" do
      attribute :value, String, pattern: '\A[A-Za-z][A-Za-z0-9_]*\z'
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Complete" => "projected", from: "requested"
      transition "Fault"    => "faulted",   from: "requested"
    end

    # `hecks deploy recipe.project <domain> [tenant=] [schema=] [out=] [environment=]`. A schema override
    # needs its tenant; the generator says so, and a domain with no `deployed_to` target, or one
    # whose settings conflict, is faulted with the generator's own sentence.
    command "Project" do
      goal "Generate a domain's AWS deploy recipe from its declared deployed_to target"

      attribute :domain,      DomainPath
      attribute :run,         RunKey
      attribute :tenant,      TenantSlug,      optional: true
      attribute :schema,      SchemaName,      optional: true
      attribute :out,         Location,        optional: true
      attribute :environment, EnvironmentName, optional: true

      sets :domain
      sets :run
      sets :tenant
      sets :schema
      sets :out
      sets :environment

      emits "ProjectionRequested"
    end

    command "Complete" do
      goal "Record that the recipe was written, and where"

      reference_to Recipe
      attribute :output, Report

      sets :output

      emits "RecipeProjected"
    end

    command "Fault" do
      goal "Record that the recipe could not be generated, and why"

      reference_to Recipe
      attribute :refusal, Report

      sets :refusal

      emits "RecipeFaulted"
    end

    query "Outcome" do
      description "What one generation did: its status, and the files written or the reason it stopped."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Faulted" do
      description "Every generation that could not write its recipe."
      where(status: "faulted")
      order_by :run
    end
  end

  policy "GenerateWhenRequested" do
    on      "Recipe.ProjectionRequested"
    trigger Recipe::DeployToolchain::Generate, with: { run: :run }
  end

  policy "RecordTheRecipe" do
    on      "Recipe.RecipeAnswered"
    trigger Recipe::Complete, with: { output: :output }
  end

  policy "RecordTheFaultedRecipe" do
    on      "Recipe.RecipeRefused"
    trigger Recipe::Fault, with: { refusal: :refusal }
  end

  aggregate "MakefileCheck" do
    description "One lint of generated deploy Makefiles for prod-touching recipes that hide failure."

    attribute :run,       RunKey
    attribute :makefiles, PathList, optional: true
    attribute :report,    Report,   optional: true
    attribute :refusal,   Report,   optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    # Makefile paths, comma separated; three generated fixture domains when absent.
    value_object "PathList" do
      attribute :value, String, pattern: '[^\t\n\r]'
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Pass" => "clean",   from: "requested"
      transition "Flag" => "flagged", from: "requested"
    end

    # A pattern match over Make and shell text, not a static analyzer: the findings are the
    # linter's own sentences, one per violation, and a run that finds any is flagged.
    command "Lint" do
      goal "Lint generated deploy Makefiles for recipes that hide the failure of a command that touches prod"

      attribute :makefiles, PathList, optional: true
      attribute :run,       RunKey

      sets :makefiles
      sets :run

      emits "LintRequested"
    end

    command "Pass" do
      goal "Record that no recipe hides a failure"

      reference_to MakefileCheck
      attribute :report, Report

      sets :report

      emits "LintPassed"
    end

    command "Flag" do
      goal "Record that a recipe hides a failure, or that the lint could not run, and what it said"

      reference_to MakefileCheck
      attribute :refusal, Report

      sets :refusal

      emits "LintFlagged"
    end

    query "Verdict" do
      description "What one lint found: its status, and the report or the violations."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Flagged" do
      description "Every lint that left a violation or could not run."
      where(status: "flagged")
      order_by :run
    end
  end

  policy "LintWhenRequested" do
    on      "MakefileCheck.LintRequested"
    trigger MakefileCheck::DeployToolchain::Scan, with: { run: :run }
  end

  policy "RecordTheCleanLint" do
    on      "MakefileCheck.LintAnswered"
    trigger MakefileCheck::Pass, with: { report: :report }
  end

  policy "RecordTheFlaggedLint" do
    on      "MakefileCheck.LintRefused"
    trigger MakefileCheck::Flag, with: { refusal: :refusal }
  end

  aggregate "CostCheck" do
    description "One reading of what hosting costs a month, against a budget."

    attribute :run,     RunKey
    attribute :budget,  Budget
    attribute :since,   Since
    attribute :report,  Report, optional: true
    attribute :refusal, Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    # Whole dollars a month.
    value_object "Budget" do
      attribute :value, Integer

      invariant("a budget is positive") { value.positive? }
    end

    # The first day to count, as `YYYY-MM-DD`: the first complete day after the last change to
    # what is running, so a bill that still carries the old setup is not read as the new one.
    value_object "Since" do
      attribute :value, String, pattern: '[0-9]{4}-[0-9]{2}-[0-9]{2}'
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Pass" => "within_budget", from: "requested"
      transition "Flag" => "flagged",       from: "requested"
    end

    # The reading is the billed daily total from the first complete day since `since` up to
    # yesterday, scaled to a month; today is left out because its bill is still partial.
    command "Check" do
      goal "Read what hosting has billed since a day and compare its monthly rate to a budget"

      attribute :run,    RunKey
      attribute :budget, Budget
      attribute :since,  Since

      sets :run
      sets :budget
      sets :since

      emits "CostCheckRequested"
    end

    command "Pass" do
      goal "Record that the monthly rate is within the budget, and what it was"

      reference_to CostCheck
      attribute :report, Report

      sets :report

      emits "CostWithinBudget"
    end

    command "Flag" do
      goal "Record that the monthly rate is over the budget, or that it could not be read, and what was said"

      reference_to CostCheck
      attribute :refusal, Report

      sets :refusal

      emits "CostFlagged"
    end

    query "Verdict" do
      description "What one reading found: its status, and the report or the reason it was flagged."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Flagged" do
      description "Every reading that was over its budget or could not be taken."
      where(status: "flagged")
      order_by :run
    end
  end

  policy "MeasureWhenChecked" do
    on      "CostCheck.CostCheckRequested"
    trigger CostCheck::CostExplorer::Measure, with: { run: :run }
  end

  policy "RecordTheCostWithinBudget" do
    on      "CostCheck.CostAnswered"
    trigger CostCheck::Pass, with: { report: :report }
  end

  policy "RecordTheFlaggedCost" do
    on      "CostCheck.CostRefused"
    trigger CostCheck::Flag, with: { refusal: :refusal }
  end

  aggregate "SmokeRun" do
    description "One post-deploy smoke: the generated smoke-after-deploy script run, and how it ended."

    attribute :script,  Location
    attribute :run,     RunKey
    attribute :taskdef, TaskDefinition, optional: true
    attribute :skip,    Switch, optional: true
    attribute :async,   Switch, optional: true
    attribute :dry_run, Switch, optional: true
    attribute :report,  Report, optional: true
    attribute :refusal, Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Location" do
      attribute :value, String, pattern: '[^\t\n\r]'

      invariant("a script is named by its path") { !value.to_s.empty? }
    end

    # A task definition family, or family:revision, as the generated script takes it in TASKDEF.
    value_object "TaskDefinition" do
      attribute :value, String, pattern: '^[A-Za-z0-9_-]+(:[0-9]+)?$'
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Pass" => "passed", from: "requested"
      transition "Flag" => "flagged", from: "requested"
    end

    # `hecks deploy smoke_run.run <generated smoke-after-deploy.sh> [taskdef=<family[:rev]>] [skip=true]
    # [async=true] [dry_run=true]`. Runs the script a project's AwsBox projection generated, once a
    # roll has settled: the script waits for the box, dispatches the smoke workflow and follows it.
    # It only reads AWS; the smoke itself runs on GitHub. Exit 1 when it did not pass, with the
    # script's own status (20 unsettled, 21 not run, 22 failed, 23 unknown) in the reason.
    command "Run" do
      goal "Run a project's generated post-deploy smoke and record whether the live site passed"

      attribute :script,  Location
      attribute :run,     RunKey
      attribute :taskdef, TaskDefinition, optional: true
      attribute :skip,    Switch, optional: true
      attribute :async,   Switch, optional: true
      attribute :dry_run, Switch, optional: true

      sets :script
      sets :run
      sets :taskdef
      sets :skip
      sets :async
      sets :dry_run

      emits "SmokeRequested"
    end

    command "Pass" do
      goal "Record that the smoke passed, was skipped on purpose, or was left running, and what it said"

      reference_to SmokeRun
      attribute :report, Report

      sets :report

      emits "SmokePassed"
    end

    command "Flag" do
      goal "Record that the smoke failed, did not run or could not be read, and what was said"

      reference_to SmokeRun
      attribute :refusal, Report

      sets :refusal

      emits "SmokeFlagged"
    end

    query "Verdict" do
      description "What one smoke found: its status, and the report or the reason it was flagged."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Flagged" do
      description "Every smoke that failed, did not run or could not be read."
      where(status: "flagged")
      order_by :run
    end
  end

  policy "SmokeWhenRequested" do
    on      "SmokeRun.SmokeRequested"
    trigger SmokeRun::DeployToolchain::Smoke, with: { run: :run }
  end

  policy "RecordThePassedSmoke" do
    on      "SmokeRun.SmokeAnswered"
    trigger SmokeRun::Pass, with: { report: :report }
  end

  policy "RecordTheFlaggedSmoke" do
    on      "SmokeRun.SmokeRefused"
    trigger SmokeRun::Flag, with: { refusal: :refusal }
  end

  aggregate "TemplateComparison" do
    description "One offline comparison of two CloudFormation templates, by logical id."

    attribute :before,  Location
    attribute :after,   Location
    attribute :run,     RunKey
    attribute :json,    Switch, optional: true
    attribute :strict,  Switch, optional: true
    attribute :report,  Report, optional: true
    attribute :refusal, Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Location" do
      attribute :value, String, pattern: '[^\t\n\r]'

      invariant("a template is named by its path") { !value.to_s.empty? }
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Match"  => "matching", from: "requested"
      transition "Drift"  => "drifted",  from: "requested"
      transition "Refuse" => "refused",  from: "requested"
    end

    # `hecks deploy template_comparison.diff <before> after=<template> [--json] [--strict]`. `--strict` also counts
    # cosmetic differences (comments, key order); `--json` writes the report as JSON.
    command "Diff" do
      goal "Compare two CloudFormation templates and report what differs by logical id"

      attribute :before, Location
      attribute :after,  Location
      attribute :run,    RunKey
      attribute :json,   Switch, optional: true
      attribute :strict, Switch, optional: true

      sets :before
      sets :after
      sets :run
      sets :json
      sets :strict

      emits "ComparisonRequested"
    end

    command "Match" do
      goal "Record that the templates agree"

      reference_to TemplateComparison
      attribute :report,    Report
      attribute :different, Switch

      given("the templates agree") { !different.value }

      sets :report

      emits "TemplatesMatched"
    end

    command "Drift" do
      goal "Record that the templates differ, and how"

      reference_to TemplateComparison
      attribute :report,    Report
      attribute :different, Switch

      given("the templates differ") { different.value }

      sets :report

      emits "TemplatesDrifted"
    end

    command "Refuse" do
      goal "Record that a template could not be read, and why"

      reference_to TemplateComparison
      attribute :refusal, Report

      sets :refusal

      emits "ComparisonRefused"
    end

    query "Verdict" do
      description "What one comparison found: its status, and the report or the reason it could not run."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Drifted" do
      description "Every comparison in which the templates differ."
      where(status: "drifted")
      order_by :run
    end
  end

  policy "CompareWhenRequested" do
    on      "TemplateComparison.ComparisonRequested"
    trigger TemplateComparison::DeployToolchain::Compare, with: { run: :run }
  end

  policy "RecordTheMatch" do
    on      "TemplateComparison.ComparisonAnswered"
    trigger TemplateComparison::Match, with: { report: :report, different: :different }
  end

  policy "RecordTheDrift" do
    on      "TemplateComparison.ComparisonAnswered"
    trigger TemplateComparison::Drift, with: { report: :report, different: :different }
  end

  policy "RecordTheRefusedComparison" do
    on      "TemplateComparison.ComparisonUnreadable"
    trigger TemplateComparison::Refuse, with: { refusal: :refusal }
  end

  aggregate "OidcManifest" do
    description "One projection of each domain's OIDC client and scope manifest into its oidc.json."

    attribute :run,     RunKey
    attribute :domains, DomainList, optional: true
    attribute :output,  Report,     optional: true
    attribute :refusal, Report,     optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    # Domain directories, comma separated; every domain of the checkout when absent.
    value_object "DomainList" do
      attribute :value, String, pattern: '[^\t\n\r]'
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Complete" => "projected", from: "requested"
      transition "Fault"    => "faulted",   from: "requested"
    end

    command "ProjectOidc" do
      goal "Write each domain's OIDC client and scope manifest beside it as oidc.json"

      attribute :domains, DomainList, optional: true
      attribute :run,     RunKey

      sets :domains
      sets :run

      emits "OidcProjectionRequested"
    end

    command "Complete" do
      goal "Record which manifests were written"

      reference_to OidcManifest
      attribute :output, Report

      sets :output

      emits "OidcProjected"
    end

    command "Fault" do
      goal "Record that the manifests could not be projected, and why"

      reference_to OidcManifest
      attribute :refusal, Report

      sets :refusal

      emits "OidcFaulted"
    end

    query "Outcome" do
      description "What one projection did: its status, and the manifests written or the reason it stopped."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Faulted" do
      description "Every projection that could not write its manifests."
      where(status: "faulted")
      order_by :run
    end
  end

  policy "ProjectWhenRequested" do
    on      "OidcManifest.OidcProjectionRequested"
    trigger OidcManifest::DeployToolchain::Manifest, with: { run: :run }
  end

  policy "RecordTheManifests" do
    on      "OidcManifest.ManifestAnswered"
    trigger OidcManifest::Complete, with: { output: :output }
  end

  policy "RecordTheFaultedManifests" do
    on      "OidcManifest.ManifestRefused"
    trigger OidcManifest::Fault, with: { refusal: :refusal }
  end
end
