# The Deploy chapter: what `deployed_to(...)` may declare, and the commands that generate, check and
# compare a deploy recipe, project the OIDC manifests and provision a tenant.
#
# `hecks deploy recipe.project` and `hecks deploy tenant.provision` boot it directly; the Hecks domain attaches it, so
# each command below is also `hecks deploy <verb>`. The targets validate the `deployed_to` shape
# that `world.bluebook`'s untyped `Setting` map leaves open. Each run below records that it was
# requested before its DeployToolchain port is asked, and what came of it after. No command
# declares a role: the chapter boots standing alone, without Governance to check one against.
Hecks.bluebook "Deploy" do
  vision "Generate, check and compare deploy recipes, project OIDC manifests and provision tenants."

  aggregate "LambdaTarget" do
    description "One domain's validated AWS Lambda deploy target — what deployed_to(\"AwsLambda\") must resolve to before hecks deploy recipe.project generates anything from it."

    identified_by :domain

    attribute :domain,   DomainName
    attribute :region,   Region
    attribute :memory,   Memory
    attribute :timeout,  Timeout
    attribute :database, Database
    attribute :web,      Web
    attribute :dispatch, Dispatch,      optional: true
    attribute :handler_module, HandlerModule, optional: true
    attribute :secret_env, SecretEnv,   optional: true

    value_object "DomainName" do
      attribute :value, String
      invariant("a domain is named") { !value.to_s.empty? }
    end

    value_object "Region" do
      attribute :value, String
      invariant("a region is named") { !value.to_s.empty? }
    end

    # "Postgres" (plain RDS, the default when `deployed_to` names none) or "Aurora"
    # (Serverless v2);
    # only the emitted CloudFormation resource differs, never the runtime adapter. "Shared" borrows
    # another domain's instance under its own Postgres schema and needs an `owner` setting, which
    # `hecks deploy recipe.project` checks, since the owning domain is a deploy-time fact.
    value_object "Database" do
      attribute :value, String, one_of: ["Postgres", "Aurora", "Shared"]
    end

    # "None" (default) or "Rust": the domain's own Lambda (rust/host) also serves a public web UI
    # in-process (rust/host/src/web.rs). "Ruby" is not a member: a Ruby WebFunction comes from a
    # `lambda_handler.rb` file, and `hecks deploy recipe.project` refuses `web "Rust"` alongside one.
    value_object "Web" do
      attribute :value, String, one_of: ["None", "Rust"]
    end

    # "Rust" (default) or "None": a domain with no `.bluebook` command surface to dispatch through
    # (a webhook that dispatches straight into Ruby) skips the rust/host dispatch Lambda, and its
    # WebFunction becomes its only Lambda. That WebFunction's `lambda_handler.rb` defines the module
    # `handler_module` names, so `dispatch "None"` must name one.
    value_object "Dispatch" do
      attribute :value, String, one_of: ["Rust", "None"]
    end

    # The module the domain's `lambda_handler.rb` defines for its WebFunction.
    value_object "HandlerModule" do
      attribute :value, String
      invariant("a handler module is named") { !value.to_s.empty? }
    end

    # The env var the WebFunction's `lambda_handler.rb` finds the fetched secret's plaintext under,
    # once it resolves `<name>_ARN`.
    value_object "SecretEnv" do
      attribute :value, String
      invariant("a secret env var is named") { !value.to_s.empty? }
    end

    # 128-10240 MB, AWS Lambda's own floor and ceiling.
    value_object "Memory" do
      attribute :value, Integer
      invariant("memory is at least 128 MB") { value >= 128 }
      invariant("memory is at most 10240 MB") { value <= 10240 }
    end

    # Lambda's own ceiling of 900s.
    value_object "Timeout" do
      attribute :value, Integer
      invariant("a timeout is positive") { value.positive? }
      invariant("a timeout fits Lambda's own 900s ceiling") { value <= 900 }
    end

    # All required, no `default:`: command-level defaults apply only at the JSON/Rust-codegen
    # boundary, not Ruby's direct dispatch (interpreting.rb `normalize_args`). Defaults are
    # resolved by `hecks deploy recipe.project` before it dispatches.
    command "Declare" do
      goal "Validate one domain's AwsLambda deploy target before anything is generated from it"

      attribute :domain,   DomainName
      attribute :region,   Region
      attribute :memory,   Memory
      attribute :timeout,  Timeout
      attribute :database, Database
      attribute :web,      Web
      attribute :dispatch, Dispatch,      optional: true
      attribute :handler_module, HandlerModule, optional: true
      attribute :secret_env, SecretEnv,   optional: true

      given('dispatch "None" names its handler_module: add handler_module "YourModuleName" for the module lambda_handler.rb defines') do
        dispatch.unset? || dispatch.value != "None" || handler_module.set?
      end

      sets :domain
      sets :region
      sets :memory
      sets :timeout
      sets :database
      sets :web
      sets :dispatch
      sets :handler_module
      sets :secret_env

      emits "LambdaTargetDeclared"
    end
  end

  # A sibling of `LambdaTarget` with its own value objects, since value objects are not
  # shared across aggregates.
  aggregate "FargateTarget" do
    description "One domain's validated AWS Fargate deploy target — what deployed_to(\"AwsFargate\") must resolve to before hecks deploy recipe.project generates anything from it."

    identified_by :domain

    attribute :domain,   DomainName
    attribute :region,   Region
    attribute :cpu,      Cpu
    attribute :memory,   Memory
    attribute :database, Database
    attribute :web,      Web
    attribute :port,     Port

    value_object "DomainName" do
      attribute :value, String
      invariant("a domain is named") { !value.to_s.empty? }
    end

    value_object "Region" do
      attribute :value, String
      invariant("a region is named") { !value.to_s.empty? }
    end

    # Positive only: ECS enforces AWS's cpu/memory pairings at deploy time, so this just
    # catches a typo.
    value_object "Cpu" do
      attribute :value, Integer
      invariant("cpu is positive") { value.positive? }
    end

    # Fargate's own range, not Lambda's 128-10240 MB. A sanity floor and ceiling, not AWS's
    # cpu-paired table (see `Cpu`).
    value_object "Memory" do
      attribute :value, Integer
      invariant("memory is positive") { value.positive? }
      invariant("memory is at most 122880 MB") { value <= 122880 }
    end

    # As `LambdaTarget`'s `Database`.
    value_object "Database" do
      attribute :value, String, one_of: ["Postgres", "Aurora", "Shared"]
    end

    # As `LambdaTarget`'s `Web`; "Rust" serves the web UI in-process on this aggregate's `Port`.
    value_object "Web" do
      attribute :value, String, one_of: ["None", "Rust"]
    end

    # The container port the task listens on and the target group routes to.
    value_object "Port" do
      attribute :value, Integer
      invariant("a port is at least 1") { value >= 1 }
      invariant("a port is at most 65535") { value <= 65535 }
    end

    # All seven required for the same reason as `LambdaTarget.Declare`; this validates a
    # target already resolved by `hecks deploy recipe.project`'s defaults.
    command "Declare" do
      goal "Validate one domain's AwsFargate deploy target before anything is generated from it"

      attribute :domain,   DomainName
      attribute :region,   Region
      attribute :cpu,      Cpu
      attribute :memory,   Memory
      attribute :database, Database
      attribute :web,      Web
      attribute :port,     Port

      sets :domain
      sets :region
      sets :cpu
      sets :memory
      sets :database
      sets :web
      sets :port

      emits "FargateTargetDeclared"
    end
  end

  aggregate "BoxTarget" do
    description "One domain's validated single-box deploy target — what deployed_to(\"AwsBox\") must resolve to before hecks deploy project generates a box and an RDS instance from it"

    identified_by :domain

    attribute :domain,         DomainName
    attribute :region,         Region
    attribute :instance_type,  InstanceType
    attribute :volume_gb,      VolumeGb
    attribute :database_class, DatabaseClass
    attribute :storage_gb,     StorageGb

    value_object "DomainName" do
      attribute :value, String
      invariant("a domain is named") { !value.to_s.empty? }
    end

    value_object "Region" do
      attribute :value, String
      invariant("a region is named") { !value.to_s.empty? }
    end

    # An EC2 instance type such as t4g.medium. The family and size are checked for shape only;
    # EC2 refuses an unknown type at stack creation.
    value_object "InstanceType" do
      attribute :value, String
      invariant("an instance type is family.size, such as t4g.medium") { value.to_s.match?(/\A[a-z][a-z0-9-]*\.[a-z0-9]+\z/) }
    end

    # The box's root disk, which holds images, the compose files and container logs; the
    # database is on RDS.
    value_object "VolumeGb" do
      attribute :value, Integer
      invariant("a volume is at least 8 GB") { value >= 8 }
      invariant("a volume is at most 16384 GB") { value <= 16384 }
    end

    # An RDS instance class such as db.t4g.small.
    value_object "DatabaseClass" do
      attribute :value, String
      invariant("a database class is db.family.size, such as db.t4g.small") { value.to_s.match?(/\Adb\.[a-z][a-z0-9-]*\.[a-z0-9]+\z/) }
    end

    # RDS storage grows with the journal; 20 GB is RDS's gp3 floor.
    value_object "StorageGb" do
      attribute :value, Integer
      invariant("storage is at least 20 GB") { value >= 20 }
      invariant("storage is at most 65536 GB") { value <= 65536 }
    end

    # All six required for the same reason as `FargateTarget.Declare`; this validates a target
    # already resolved by `hecks deploy project`'s defaults.
    command "Declare" do
      goal "Validate one domain's AwsBox deploy target before anything is generated from it"

      attribute :domain,         DomainName
      attribute :region,         Region
      attribute :instance_type,  InstanceType
      attribute :volume_gb,      VolumeGb
      attribute :database_class, DatabaseClass
      attribute :storage_gb,     StorageGb

      sets :domain
      sets :region
      sets :instance_type
      sets :volume_gb
      sets :database_class
      sets :storage_gb

      emits "BoxTargetDeclared"
    end
  end

  aggregate "VercelTarget" do
    description "One domain's validated Vercel deploy target — what deployed_to(\"Vercel\") must resolve to before hecks deploy project generates a Vercel function's configuration from it"

    identified_by :domain

    attribute :domain,       DomainName
    attribute :region,       Region
    attribute :memory,       Memory
    attribute :max_duration, MaxDuration

    value_object "DomainName" do
      attribute :value, String
      invariant("a domain is named") { !value.to_s.empty? }
    end

    # A Vercel region id such as iad1 or fra1: three letters and a digit. Vercel refuses an
    # unknown id at deploy; this checks the shape only.
    value_object "Region" do
      attribute :value, String
      invariant("a region is a Vercel id such as iad1") { value.to_s.match?(/\A[a-z]{3}[0-9]\z/) }
    end

    # Function memory in MB. Vercel sells 128 MB up to a plan's ceiling; the ceiling is the
    # plan's to enforce.
    value_object "Memory" do
      attribute :value, Integer
      invariant("memory is at least 128 MB") { value >= 128 }
      invariant("memory is at most 10240 MB") { value <= 10_240 }
    end

    # Seconds a single invocation may run. 800 is the longest any plan allows.
    value_object "MaxDuration" do
      attribute :value, Integer
      invariant("a duration is at least 1 second") { value >= 1 }
      invariant("a duration is at most 800 seconds") { value <= 800 }
    end

    # All four required for the same reason as `BoxTarget.Declare`; this validates a target
    # already resolved by `hecks deploy project`'s defaults.
    command "Declare" do
      goal "Validate one domain's Vercel deploy target before anything is generated from it"

      attribute :domain,       DomainName
      attribute :region,       Region
      attribute :memory,       Memory
      attribute :max_duration, MaxDuration

      sets :domain
      sets :region
      sets :memory
      sets :max_duration

      emits "VercelTargetDeclared"
    end
  end

  aggregate "SharedDatabaseTarget" do
    description "One platform's validated shared database instance — what deployed_to(\"AwsSharedDatabase\") must resolve to before hecks deploy project generates the RDS stack that several client sites each keep a database on."

    identified_by :domain

    attribute :domain,         DomainName
    attribute :region,         Region
    attribute :database_class, DatabaseClass
    attribute :storage_gb,     StorageGb

    value_object "DomainName" do
      attribute :value, String
      invariant("a domain is named") { !value.to_s.empty? }
    end

    value_object "Region" do
      attribute :value, String
      invariant("a region is named") { !value.to_s.empty? }
    end

    # An RDS instance class such as db.t4g.small.
    value_object "DatabaseClass" do
      attribute :value, String
      invariant("a database class is db.family.size, such as db.t4g.small") { value.to_s.match?(/\Adb\.[a-z][a-z0-9-]*\.[a-z0-9]+\z/) }
    end

    # Every client's database lives on this disk, so it is sized for all of them; 20 GB is
    # RDS's gp3 floor.
    value_object "StorageGb" do
      attribute :value, Integer
      invariant("storage is at least 20 GB") { value >= 20 }
      invariant("storage is at most 65536 GB") { value <= 65536 }
    end

    # All four required for the same reason as `BoxTarget.Declare`; this validates a target
    # already resolved by `hecks deploy project`'s defaults.
    command "Declare" do
      goal "Validate one platform's shared database target before anything is generated from it"

      attribute :domain,         DomainName
      attribute :region,         Region
      attribute :database_class, DatabaseClass
      attribute :storage_gb,     StorageGb

      sets :domain
      sets :region
      sets :database_class
      sets :storage_gb

      emits "SharedDatabaseTargetDeclared"
    end
  end

  # The validated shape of `hecks deploy tenant.provision`, which does the generating and provisioning.
  # Not a saga: each of its steps is idempotent and local, so there is nothing to resume.
  aggregate "Tenant" do
    description "One tenant's validated identity — which realm and Postgres schema `hecks deploy tenant.provision` provisions before booting a domain directory under Runtime.boot's own `environment:` overlay for it."

    identified_by :slug

    attribute :slug,      Slug
    attribute :domain,    DomainName
    attribute :realm,     Realm
    attribute :schema,    Schema
    attribute :database,  DatabaseName,  optional: true
    attribute :adapter,   AdapterName,   optional: true
    attribute :directory, DirectoryPath, optional: true
    attribute :output,    Report,        optional: true
    attribute :refusal,   Report,        optional: true

    # Lowercase, no spaces: a slug becomes the `environments/<slug>.world` filename and, by
    # convention only, the schema name (`schema` is separate so a tenant can differ).
    value_object "Slug" do
      attribute :value, String, pattern: '\A[a-z][a-z0-9_]*\z'
      invariant("a tenant slug is named") { !value.to_s.empty? }
    end

    value_object "DomainName" do
      attribute :value, String
      invariant("a tenant names the domain it is for") { !value.to_s.empty? }
    end

    value_object "Realm" do
      attribute :value, String
      invariant("a tenant realm is named") { !value.to_s.empty? }
    end

    # Lowercase, letters/digits/underscores, starting with a letter. Postgres's 63-byte
    # identifier limit is not checked: the invariant expression grammar has no `bytesize`, and
    # Postgres refuses a too-long identifier itself.
    value_object "Schema" do
      attribute :value, String, pattern: '\A[a-z][a-z0-9_]*\z'
      invariant("a schema is named") { !value.to_s.empty? }
    end

    # A database name or a `postgres://` URL, whichever the overlay's `database` setting takes.
    value_object "DatabaseName" do
      attribute :value, String, pattern: '\A[^\t\n\r]+\z'
    end

    # The persistence adapter the overlay binds; PostgresEra when a request names none.
    value_object "AdapterName" do
      attribute :value, String, pattern: '\A[A-Z][A-Za-z0-9]*\z'
    end

    # The domain's own directory on disk, where `environments/<slug>.world` is written.
    value_object "DirectoryPath" do
      attribute :value, String, pattern: '[^\t\n\r]'
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Reprovision" => "requested",   from: %w[provisioned refused]
      transition "Complete"    => "provisioned", from: "requested"
      transition "Abandon"     => "refused",     from: "requested"
    end

    # `hecks deploy tenant.provision <directory> slug=s domain= realm= schema= database= [adapter=]`.
    # The only command that creates a tenant: its slug, schema and realm are validated by the value
    # objects' patterns and invariants, then the overlay is written through the TenantProvisioning
    # port; the adapter answers PostgresEra when `adapter` is left out. `dry_run?` on this verb
    # validates a declaration without recording it.
    command "Provision" do
      goal "Validate one tenant, write its environment overlay world, and register it"

      attribute :directory, DirectoryPath
      attribute :slug,      Slug
      attribute :domain,    DomainName
      attribute :realm,     Realm
      attribute :schema,    Schema
      attribute :database,  DatabaseName
      attribute :adapter,   AdapterName, optional: true

      sets :directory
      sets :slug
      sets :domain
      sets :realm
      sets :schema
      sets :database
      sets :adapter

      emits "TenantProvisionRequested"
    end

    # A tenant's slug names its record, so provisioning it again is its own command; the overlay
    # is rewritten with the database and adapter given now.
    command "Reprovision" do
      goal "Write a provisioned or refused tenant's environment overlay world again"

      reference_to Tenant
      attribute :directory, DirectoryPath
      attribute :database,  DatabaseName
      attribute :adapter,   AdapterName, optional: true

      sets :directory
      sets :database
      sets :adapter

      emits "TenantReprovisionRequested"
    end

    command "Complete" do
      goal "Record that the tenant's overlay was written, and where"

      reference_to Tenant
      attribute :output, Report

      sets :output

      emits "TenantRecorded"
    end

    command "Abandon" do
      goal "Record that the tenant could not be provisioned, and why"

      reference_to Tenant
      attribute :refusal, Report

      sets :refusal

      emits "ProvisioningAbandoned"
    end

    query "Provisioning" do
      description "What provisioning one tenant did: its status, and the reason when it was refused."
      attribute :slug, Slug
      where(slug: :slug)
      order_by :slug
    end

    query "Unprovisioned" do
      description "Every tenant whose provisioning was refused."
      where(status: "refused")
      order_by :slug
    end
  end

  # `TenantProvisioned` also reaches Tenancy's `RegisterProvisionedTenant` where that chapter is
  # attached, so a provisioned tenant becomes a fact there.
  policy "ProvisionWhenRequested" do
    on      "Tenant.TenantProvisionRequested"
    trigger Tenant::TenantProvisioning::WriteOverlay, with: { database: :database, directory: :directory }
  end

  policy "ReprovisionWhenRequested" do
    on      "Tenant.TenantReprovisionRequested"
    trigger Tenant::TenantProvisioning::WriteOverlay, with: { database: :database, directory: :directory }
  end

  policy "RecordTheTenant" do
    on      "Tenant.TenantProvisioned"
    trigger Tenant::Complete, with: { output: :output }
  end

  policy "RecordTheRefusedTenant" do
    on      "Tenant.ProvisioningRefused"
    trigger Tenant::Abandon, with: { refusal: :refusal }
  end

  aggregate "Recipe" do
    description "One generation of a domain's deploy recipe: the template, scripts and Makefile written from its deployed_to target."

    attribute :domain,      DomainPath
    attribute :run,         RunKey
    attribute :tenant,      TenantSlug,      optional: true
    attribute :schema,      SchemaName,      optional: true
    attribute :out,         Location,        optional: true
    attribute :environment, EnvironmentName, optional: true
    attribute :output,      Report,          optional: true
    attribute :refusal,     Report,          optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    # A domain directory, whose `bluebook/` holds the `.world` that declares `deployed_to`.
    value_object "DomainPath" do
      attribute :value, String, pattern: '[^\t\n\r]'

      invariant("a domain is named by its path") { !value.to_s.empty? }
    end

    # A tenant of a shared-database domain: its stack is the domain's own, suffixed with the slug.
    value_object "TenantSlug" do
      attribute :value, String, pattern: '\A[a-z][a-z0-9_]*\z'
    end

    value_object "SchemaName" do
      attribute :value, String, pattern: '\A[a-z][a-z0-9_]*\z'
    end

    # Where the recipe is written, for a domain that lives in a client's repository.
    value_object "Location" do
      attribute :value, String, pattern: '[^\t\n\r]'
    end

    # An `environments/<name>.world` overlay of the domain, which must exist.
    value_object "EnvironmentName" do
      attribute :value, String, pattern: '\A[A-Za-z][A-Za-z0-9_]*\z'
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Complete" => "projected", from: "requested"
      transition "Fault"    => "faulted",   from: "requested"
    end

    # `hecks deploy recipe.project <domain> [tenant=] [schema=] [out=] [environment=]`. A schema override
    # needs its tenant; the generator says so, and a domain with no `deployed_to` target, or one
    # whose settings conflict, is faulted with the generator's own sentence.
    command "Project" do
      goal "Generate a domain's AWS deploy recipe from its declared deployed_to target"

      attribute :domain,      DomainPath
      attribute :run,         RunKey
      attribute :tenant,      TenantSlug,      optional: true
      attribute :schema,      SchemaName,      optional: true
      attribute :out,         Location,        optional: true
      attribute :environment, EnvironmentName, optional: true

      sets :domain
      sets :run
      sets :tenant
      sets :schema
      sets :out
      sets :environment

      emits "ProjectionRequested"
    end

    command "Complete" do
      goal "Record that the recipe was written, and where"

      reference_to Recipe
      attribute :output, Report

      sets :output

      emits "RecipeProjected"
    end

    command "Fault" do
      goal "Record that the recipe could not be generated, and why"

      reference_to Recipe
      attribute :refusal, Report

      sets :refusal

      emits "RecipeFaulted"
    end

    query "Outcome" do
      description "What one generation did: its status, and the files written or the reason it stopped."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Faulted" do
      description "Every generation that could not write its recipe."
      where(status: "faulted")
      order_by :run
    end
  end

  policy "GenerateWhenRequested" do
    on      "Recipe.ProjectionRequested"
    trigger Recipe::DeployToolchain::Generate, with: { run: :run }
  end

  policy "RecordTheRecipe" do
    on      "Recipe.RecipeAnswered"
    trigger Recipe::Complete, with: { output: :output }
  end

  policy "RecordTheFaultedRecipe" do
    on      "Recipe.RecipeRefused"
    trigger Recipe::Fault, with: { refusal: :refusal }
  end

  aggregate "MakefileCheck" do
    description "One lint of generated deploy Makefiles for prod-touching recipes that hide failure."

    attribute :run,       RunKey
    attribute :makefiles, PathList, optional: true
    attribute :report,    Report,   optional: true
    attribute :refusal,   Report,   optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    # Makefile paths, comma separated; three generated fixture domains when absent.
    value_object "PathList" do
      attribute :value, String, pattern: '[^\t\n\r]'
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Pass" => "clean",   from: "requested"
      transition "Flag" => "flagged", from: "requested"
    end

    # A pattern match over Make and shell text, not a static analyzer: the findings are the
    # linter's own sentences, one per violation, and a run that finds any is flagged.
    command "Lint" do
      goal "Lint generated deploy Makefiles for recipes that hide the failure of a command that touches prod"

      attribute :makefiles, PathList, optional: true
      attribute :run,       RunKey

      sets :makefiles
      sets :run

      emits "LintRequested"
    end

    command "Pass" do
      goal "Record that no recipe hides a failure"

      reference_to MakefileCheck
      attribute :report, Report

      sets :report

      emits "LintPassed"
    end

    command "Flag" do
      goal "Record that a recipe hides a failure, or that the lint could not run, and what it said"

      reference_to MakefileCheck
      attribute :refusal, Report

      sets :refusal

      emits "LintFlagged"
    end

    query "Verdict" do
      description "What one lint found: its status, and the report or the violations."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Flagged" do
      description "Every lint that left a violation or could not run."
      where(status: "flagged")
      order_by :run
    end
  end

  policy "LintWhenRequested" do
    on      "MakefileCheck.LintRequested"
    trigger MakefileCheck::DeployToolchain::Scan, with: { run: :run }
  end

  policy "RecordTheCleanLint" do
    on      "MakefileCheck.LintAnswered"
    trigger MakefileCheck::Pass, with: { report: :report }
  end

  policy "RecordTheFlaggedLint" do
    on      "MakefileCheck.LintRefused"
    trigger MakefileCheck::Flag, with: { refusal: :refusal }
  end

  aggregate "CostCheck" do
    description "One reading of what hosting costs a month, against a budget."

    attribute :run,     RunKey
    attribute :budget,  Budget
    attribute :since,   Since
    attribute :report,  Report, optional: true
    attribute :refusal, Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    # Whole dollars a month.
    value_object "Budget" do
      attribute :value, Integer

      invariant("a budget is positive") { value.positive? }
    end

    # The first day to count, as `YYYY-MM-DD`: the first complete day after the last change to
    # what is running, so a bill that still carries the old setup is not read as the new one.
    value_object "Since" do
      attribute :value, String, pattern: '[0-9]{4}-[0-9]{2}-[0-9]{2}'
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Pass" => "within_budget", from: "requested"
      transition "Flag" => "flagged",       from: "requested"
    end

    # The reading is the billed daily total from the first complete day since `since` up to
    # yesterday, scaled to a month; today is left out because its bill is still partial.
    command "Check" do
      goal "Read what hosting has billed since a day and compare its monthly rate to a budget"

      attribute :run,    RunKey
      attribute :budget, Budget
      attribute :since,  Since

      sets :run
      sets :budget
      sets :since

      emits "CostCheckRequested"
    end

    command "Pass" do
      goal "Record that the monthly rate is within the budget, and what it was"

      reference_to CostCheck
      attribute :report, Report

      sets :report

      emits "CostWithinBudget"
    end

    command "Flag" do
      goal "Record that the monthly rate is over the budget, or that it could not be read, and what was said"

      reference_to CostCheck
      attribute :refusal, Report

      sets :refusal

      emits "CostFlagged"
    end

    query "Verdict" do
      description "What one reading found: its status, and the report or the reason it was flagged."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Flagged" do
      description "Every reading that was over its budget or could not be taken."
      where(status: "flagged")
      order_by :run
    end
  end

  policy "MeasureWhenChecked" do
    on      "CostCheck.CostCheckRequested"
    trigger CostCheck::CostExplorer::Measure, with: { run: :run }
  end

  policy "RecordTheCostWithinBudget" do
    on      "CostCheck.CostAnswered"
    trigger CostCheck::Pass, with: { report: :report }
  end

  policy "RecordTheFlaggedCost" do
    on      "CostCheck.CostRefused"
    trigger CostCheck::Flag, with: { refusal: :refusal }
  end

  aggregate "SmokeRun" do
    description "One post-deploy smoke: the generated smoke-after-deploy script run, and how it ended."

    attribute :project, Location
    attribute :script,  Location, optional: true
    attribute :run,     RunKey
    attribute :taskdef, TaskDefinition, optional: true
    attribute :skip,    Switch, optional: true
    attribute :async,   Switch, optional: true
    attribute :dry_run, Switch, optional: true
    attribute :after,   Origin, default: { value: "alone" }
    attribute :report,  Report, optional: true
    attribute :refusal, Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Location" do
      attribute :value, String, pattern: '[^\t\n\r]'

      invariant("a project or script is named by its path") { !value.to_s.empty? }
    end

    # A task definition family, or family:revision, as the generated script takes it in TASKDEF.
    value_object "TaskDefinition" do
      attribute :value, String, pattern: '^[A-Za-z0-9_-]+(:[0-9]+)?$'
    end

    # What requested the smoke: `alone` for a person, else the roll whose record takes the outcome.
    value_object "Origin" do
      attribute :value, String, pattern: '^(alone|service_roll|box_roll)$'
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Pass" => "passed", from: "requested"
      transition "Flag" => "flagged", from: "requested"
    end

    # `hecks deploy smoke_run.run <project> [script=<path>] [taskdef=<family[:rev]>] [skip=true]
    # [async=true] [dry_run=true]`. Finds the `smoke-after-deploy.sh` the project's AwsBox projection
    # generated (`script=` names it when the project holds more than one) and runs it once a roll
    # has settled: the script waits for the box, dispatches the smoke workflow and follows it.
    # It only reads AWS; the smoke itself runs on GitHub. Exit 1 when it did not pass, with the
    # script's own status (20 unsettled, 21 not run, 22 failed, 23 unknown) in the reason.
    command "Run" do
      goal "Run a project's generated post-deploy smoke and record whether the live site passed"

      attribute :project, Location
      attribute :script,  Location, optional: true
      attribute :run,     RunKey
      attribute :taskdef, TaskDefinition, optional: true
      attribute :skip,    Switch, optional: true
      attribute :async,   Switch, optional: true
      attribute :dry_run, Switch, optional: true
      attribute :after,   Origin, default: { value: "alone" }

      sets :project
      sets :script
      sets :run
      sets :taskdef
      sets :skip
      sets :async
      sets :dry_run
      sets :after

      emits "SmokeRequested"
    end

    command "Pass" do
      goal "Record that the smoke passed, was skipped on purpose, or was left running, and what it said"

      reference_to SmokeRun
      attribute :report, Report
      attribute :after,  Origin, default: { value: "alone" }

      sets :report
      sets :after

      emits "SmokePassed"
    end

    command "Flag" do
      goal "Record that the smoke failed, did not run or could not be read, and what was said"

      reference_to SmokeRun
      attribute :refusal, Report
      attribute :after,   Origin, default: { value: "alone" }

      sets :refusal
      sets :after

      emits "SmokeFlagged"
    end

    query "Verdict" do
      description "What one smoke found: its status, and the report or the reason it was flagged."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Flagged" do
      description "Every smoke that failed, did not run or could not be read."
      where(status: "flagged")
      order_by :run
    end
  end

  policy "SmokeWhenRequested" do
    on      "SmokeRun.SmokeRequested"
    trigger SmokeRun::DeployToolchain::Smoke, with: { run: :run, after: :after }
  end

  policy "RecordThePassedSmoke" do
    on      "SmokeRun.SmokeAnswered"
    trigger SmokeRun::Pass, with: { report: :report, after: :after }
  end

  policy "RecordTheFlaggedSmoke" do
    on      "SmokeRun.SmokeRefused"
    trigger SmokeRun::Flag, with: { refusal: :refusal, after: :after }
  end

  aggregate "ServiceRoll" do
    description "One roll of a single service onto the app box: the generated deploy-service script run, and how it ended."

    attribute :project,        Location
    attribute :script,         Location, optional: true
    attribute :run,            RunKey
    attribute :service,        ServiceName
    attribute :existing_tag,   ImageTag, optional: true
    attribute :local_image,    ImageName, optional: true
    attribute :skip_smoke,     Switch, optional: true
    attribute :taskdef,        TaskDefinition, optional: true
    attribute :tag,            ImageTag, optional: true
    attribute :report,         Report, optional: true
    attribute :smoke,      Report, optional: true
    attribute :refusal,        Report, optional: true

    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Location" do
      attribute :value, String, pattern: '[^\t\n\r]'

      invariant("a project or script is named by its path") { !value.to_s.empty? }
    end

    # A task definition family, or family:revision, as the generated script takes it in TASKDEF.
    value_object "TaskDefinition" do
      attribute :value, String, pattern: '^[A-Za-z0-9_-]+(:[0-9]+)?$'
    end

    # A container name from the world: lower case words joined by hyphens or underscores.
    value_object "ServiceName" do
      attribute :value, String, pattern: '^[a-z0-9][a-z0-9_-]*$'
    end

    # An ECR image tag, as the script's EXISTING_TAG takes it.
    value_object "ImageTag" do
      attribute :value, String, pattern: '^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$'
    end

    # A local image reference to push, as the script's LOCAL_IMAGE takes it.
    value_object "ImageName" do
      attribute :value, String, pattern: '^[^ \t\n\r]+$'
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Complete" => "rolled", from: "requested"
      transition "Flag" => "flagged", from: "requested"
      transition "Verify" => "verified", from: "rolled"
      transition "FlagSmoke" => "flagged", from: "rolled"
    end

    # `hecks deploy service_roll.run <project> service=<name> [existing_tag=<tag>] [local_image=<ref>]
    # [skip_smoke=true] [script=<path>]`. Runs the project's generated `deploy-service.sh`: push the
    # local image under a fresh tag (or reuse `existing_tag`), set the stack's tag parameter, roll
    # the box. A policy then requests a `SmokeRun`, unless `skip_smoke=true`. Exit 1 when flagged,
    # with the script's status (2 unknown service, 30 to 38 a refused step, 40 to 42 the box roll's).

    command "Run" do
      goal "Roll one service's local image onto the box and record whether it took (exit 1 when flagged: 2 unknown service, 30-38 a refused step, 40-42 the box roll)"

      attribute :project,      Location
      attribute :script,       Location, optional: true
      attribute :run,          RunKey
      attribute :service,      ServiceName
      attribute :existing_tag, ImageTag, optional: true
      attribute :local_image,  ImageName, optional: true
      attribute :skip_smoke,   Switch, optional: true

      sets :project
      sets :script
      sets :run
      sets :service
      sets :existing_tag
      sets :local_image
      sets :skip_smoke

      emits "ServiceRollRequested"
    end

    command "Complete" do
      goal "Record that the service rolled, with the task definition and tag it rolled"

      reference_to ServiceRoll
      attribute :report,     Report
      attribute :taskdef,    TaskDefinition, optional: true
      attribute :tag,        ImageTag, optional: true
      attribute :smoke,      Report, optional: true

      sets :report
      sets :taskdef
      sets :tag
      sets :smoke

      emits "ServiceRollCompleted"
    end

    command "Flag" do
      goal "Record that the roll failed or could not start, with the script's status and what it said"

      reference_to ServiceRoll
      attribute :refusal, Report

      sets :refusal

      emits "ServiceRollFlagged"
    end

    command "Verify" do
      goal "Record that the smoke the roll requested passed"

      reference_to ServiceRoll
      attribute :smoke, Report

      sets :smoke

      emits "ServiceRollVerified"
    end

    command "FlagSmoke" do
      goal "Record that the roll took but the smoke it requested did not pass, and why"

      reference_to ServiceRoll
      attribute :smoke,   Report
      attribute :refusal, Report

      sets :smoke
      sets :refusal

      emits "ServiceRollSmokeFlagged"
    end

    query "Verdict" do
      description "What one roll found: its status, and the report or the reason it was flagged."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Flagged" do
      description "Every roll that failed or could not start."
      where(status: "flagged")
      order_by :run
    end
  end

  policy "RollServiceWhenRequested" do
    on      "ServiceRoll.ServiceRollRequested"
    trigger ServiceRoll::DeployToolchain::RollService, with: { run: :run }
  end

  policy "RecordTheRolledService" do
    on      "ServiceRoll.ServiceRollAnswered"
    trigger ServiceRoll::Complete,
            with: { report: :report, taskdef: :taskdef, tag: :tag, smoke: :smoke }
  end

  policy "RecordTheFlaggedServiceRoll" do
    on      "ServiceRoll.ServiceRollRefused"
    trigger ServiceRoll::Flag, with: { refusal: :refusal }
  end

  # Declared after RecordTheRolledService: the roll is recorded before its smoke is requested, and the
  # smoke is requested from the answer itself because a reaction chain is bounded.
  policy "SmokeAfterServiceRoll" do
    on      "ServiceRoll.ServiceRollAnswered"
    where   { run_smoke.value }
    trigger SmokeRun::Run, with: { project: :project, run: :run, taskdef: :taskdef, after: :kind }
  end

  policy "VerifyServiceRollOnPassedSmoke" do
    on      "SmokeRun.SmokePassed"
    where   { after.value == "service_roll" }
    trigger ServiceRoll::Verify, with: { service_roll: :run, smoke: :report }
  end

  policy "FlagServiceRollOnFlaggedSmoke" do
    on      "SmokeRun.SmokeFlagged"
    where   { after.value == "service_roll" }
    trigger ServiceRoll::FlagSmoke, with: { service_roll: :run, smoke: :refusal, refusal: :refusal }
  end

  aggregate "BoxRoll" do
    description "One roll of the whole app box: the generated deploy-box script run, and how it ended."

    attribute :project,    Location
    attribute :script,     Location, optional: true
    attribute :run,        RunKey
    attribute :taskdef,    TaskDefinition, optional: true
    attribute :tags,       Tags, optional: true
    attribute :skip_smoke, Switch, optional: true
    attribute :report,     Report, optional: true
    attribute :smoke,      Report, optional: true
    attribute :refusal,    Report, optional: true

    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Location" do
      attribute :value, String, pattern: '[^\t\n\r]'

      invariant("a project or script is named by its path") { !value.to_s.empty? }
    end

    # A task definition family, or family:revision, as the generated script takes it in TASKDEF.
    value_object "TaskDefinition" do
      attribute :value, String, pattern: '^[A-Za-z0-9_-]+(:[0-9]+)?$'
    end

    # `name=tag` pairs separated by spaces, as a project without a task definition names its images.
    value_object "Tags" do
      attribute :value, String, pattern: '^[A-Za-z0-9_-]+=[A-Za-z0-9_.-]+( [A-Za-z0-9_-]+=[A-Za-z0-9_.-]+)*$'
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Complete" => "rolled", from: "requested"
      transition "Flag" => "flagged", from: "requested"
      transition "Verify" => "verified", from: "rolled"
      transition "FlagSmoke" => "flagged", from: "rolled"
    end

    # `hecks deploy box_roll.run <project> [taskdef=<family[:rev]> | tags="name=tag ..."]
    # [skip_smoke=true] [script=<path>]`.
    # Runs the project's generated `deploy-box.sh`: render the Compose files, push them to the box over
    # SSM, start the containers and check them. A policy then requests a `SmokeRun`, unless
    # `skip_smoke=true`. Exit 1 when flagged, with the script's status (40 no instance, 41 the roll
    # failed, 42 the box unhealthy).

    command "Run" do
      goal "Roll the app box and record whether it came up healthy (exit 1 when flagged: 40 no instance, 41 roll failed, 42 box unhealthy)"

      attribute :project,    Location
      attribute :script,     Location, optional: true
      attribute :run,        RunKey
      attribute :taskdef,    TaskDefinition, optional: true
      attribute :tags,       Tags, optional: true
      attribute :skip_smoke, Switch, optional: true

      sets :project
      sets :script
      sets :run
      sets :taskdef
      sets :tags
      sets :skip_smoke

      emits "BoxRollRequested"
    end

    command "Complete" do
      goal "Record that the box rolled and answered healthy, and what the script said"

      reference_to BoxRoll
      attribute :report,     Report
      attribute :taskdef,    TaskDefinition, optional: true
      attribute :smoke,      Report, optional: true

      sets :report
      sets :taskdef
      sets :smoke

      emits "BoxRollCompleted"
    end

    command "Flag" do
      goal "Record that the roll failed or could not start, with the script's status and what it said"

      reference_to BoxRoll
      attribute :refusal, Report

      sets :refusal

      emits "BoxRollFlagged"
    end

    command "Verify" do
      goal "Record that the smoke the roll requested passed"

      reference_to BoxRoll
      attribute :smoke, Report

      sets :smoke

      emits "BoxRollVerified"
    end

    command "FlagSmoke" do
      goal "Record that the roll took but the smoke it requested did not pass, and why"

      reference_to BoxRoll
      attribute :smoke,   Report
      attribute :refusal, Report

      sets :smoke
      sets :refusal

      emits "BoxRollSmokeFlagged"
    end

    query "Verdict" do
      description "What one roll found: its status, and the report or the reason it was flagged."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Flagged" do
      description "Every roll that failed or could not start."
      where(status: "flagged")
      order_by :run
    end
  end

  policy "RollBoxWhenRequested" do
    on      "BoxRoll.BoxRollRequested"
    trigger BoxRoll::DeployToolchain::RollBox, with: { run: :run }
  end

  policy "RecordTheRolledBox" do
    on      "BoxRoll.BoxRollAnswered"
    trigger BoxRoll::Complete, with: { report: :report, taskdef: :taskdef, smoke: :smoke }
  end

  policy "RecordTheFlaggedBoxRoll" do
    on      "BoxRoll.BoxRollRefused"
    trigger BoxRoll::Flag, with: { refusal: :refusal }
  end

  policy "SmokeAfterBoxRoll" do
    on      "BoxRoll.BoxRollAnswered"
    where   { run_smoke.value }
    trigger SmokeRun::Run, with: { project: :project, run: :run, taskdef: :taskdef, after: :kind }
  end

  policy "VerifyBoxRollOnPassedSmoke" do
    on      "SmokeRun.SmokePassed"
    where   { after.value == "box_roll" }
    trigger BoxRoll::Verify, with: { box_roll: :run, smoke: :report }
  end

  policy "FlagBoxRollOnFlaggedSmoke" do
    on      "SmokeRun.SmokeFlagged"
    where   { after.value == "box_roll" }
    trigger BoxRoll::FlagSmoke, with: { box_roll: :run, smoke: :refusal, refusal: :refusal }
  end

  aggregate "DataCopy" do
    description "One copy of a project's data from the old database into RDS: the generated restore-to-rds script run, and how it ended."

    attribute :project,       Location
    attribute :script,        Location, optional: true
    attribute :run,           RunKey
    attribute :bastion,       Bastion
    attribute :source,        Host
    attribute :source_secret, Secret
    attribute :target,        Host
    attribute :target_secret, Secret
    attribute :source_db,     DatabaseName, default: { value: "" }
    attribute :target_db,     DatabaseName, default: { value: "" }
    attribute :force,         Switch, optional: true
    attribute :confirm,       Switch, optional: true
    attribute :dry_run,       Switch, optional: true
    attribute :skip_verify,   Switch, optional: true
    attribute :report,        Report, optional: true
    attribute :verification,  Report, optional: true
    attribute :refusal,       Report, optional: true

    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Location" do
      attribute :value, String, pattern: '[^\t\n\r]'

      invariant("a project or script is named by its path") { !value.to_s.empty? }
    end

    # The bastion's EC2 instance id, which both databases are reached through.
    value_object "Bastion" do
      attribute :value, String, pattern: '^i-[0-9a-f]+$'
    end

    value_object "Host" do
      attribute :value, String, pattern: '^[A-Za-z0-9][A-Za-z0-9.-]*$'
    end

    # A Secrets Manager id or ARN; the script reads the password from it, so no value travels here.
    value_object "Secret" do
      attribute :value, String, pattern: '^[^ \t\n\r]+$'
    end

    # A database's name; empty leaves it to the generated script's own default.
    value_object "DatabaseName" do
      attribute :value, String, pattern: '^[A-Za-z0-9_]*$'
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Complete" => "restored", from: "requested"
      transition "Plan" => "planned", from: "requested"
      transition "Flag" => "flagged", from: "requested"
      transition "Confirm" => "verified", from: ["requested", "restored"]
      transition "Drift" => "drifted", from: ["requested", "restored"]
      transition "FlagVerification" => "flagged", from: ["requested", "restored"]
    end

    # `hecks deploy data_copy.restore <project> bastion=<i-...> source=<host> source_secret=<id>
    # target=<host> target_secret=<id> [source_db=] [target_db=] [force=true] [confirm=true]
    # [dry_run=true] [skip_verify=true] [script=<path>]`. Runs the project's generated
    # `restore-to-rds.sh`, which overwrites the target database's schemas, so it refuses unless
    # `confirm=true` (the refusal names what would be overwritten); `dry_run=true` prints the plan
    # and runs nothing. A policy then requests a `CopyVerification` under the same run key unless
    # `skip_verify=true`. Exit 1 when flagged or drifted, with the script's status in the reason.
    command "Restore" do
      goal "Copy a project's schemas into RDS and record whether the copy matches (exit 1 when flagged or drifted: 60 old client, 61 target has the schema, 62 restore errors)"

      attribute :project,       Location
      attribute :script,        Location, optional: true
      attribute :run,           RunKey
      attribute :bastion,       Bastion
      attribute :source,        Host
      attribute :source_secret, Secret
      attribute :target,        Host
      attribute :target_secret, Secret
      attribute :source_db,     DatabaseName, default: { value: "" }
      attribute :target_db,     DatabaseName, default: { value: "" }
      attribute :force,         Switch, optional: true
      attribute :confirm,       Switch, optional: true
      attribute :dry_run,       Switch, optional: true
      attribute :skip_verify,   Switch, optional: true

      sets :project
      sets :script
      sets :run
      sets :bastion
      sets :source
      sets :source_secret
      sets :target
      sets :target_secret
      sets :source_db
      sets :target_db
      sets :force
      sets :confirm
      sets :dry_run
      sets :skip_verify

      emits "DataCopyRequested"
    end

    # `hecks deploy data_copy.verify <project> bastion= source= source_secret= target= target_secret=
    # [source_db=] [target_db=] [script=<path>]`. Compares the two databases with the project's
    # generated `verify-copy.sh` (structure and exact row counts of every table, nothing unpopulated),
    # read-only on both, without a restore. A policy requests the `CopyVerification` and its outcome
    # lands here, the same way it does after a restore. Exit 1 when `drifted` or `flagged`.
    command "Verify" do
      goal "Compare two databases without a restore and record whether they match (exit 1 when drifted: 50, or flagged: could not compare)"

      attribute :project,       Location
      attribute :script,        Location, optional: true
      attribute :run,           RunKey
      attribute :bastion,       Bastion
      attribute :source,        Host
      attribute :source_secret, Secret
      attribute :target,        Host
      attribute :target_secret, Secret
      attribute :source_db,     DatabaseName, default: { value: "" }
      attribute :target_db,     DatabaseName, default: { value: "" }

      sets :project
      sets :script
      sets :run
      sets :bastion
      sets :source
      sets :source_secret
      sets :target
      sets :target_secret
      sets :source_db
      sets :target_db

      emits "DataCopyVerifyRequested"
    end

    command "Complete" do
      goal "Record that the copy ran, and what the script said"

      reference_to DataCopy
      attribute :report, Report

      sets :report

      emits "DataCopyCompleted"
    end

    command "Plan" do
      goal "Record the plan a dry run printed: what would be copied and overwritten, with nothing run"

      reference_to DataCopy
      attribute :report, Report

      sets :report

      emits "DataCopyPlanned"
    end

    command "Flag" do
      goal "Record that the copy was refused or failed, with the script's status and what it said"

      reference_to DataCopy
      attribute :refusal, Report

      sets :refusal

      emits "DataCopyFlagged"
    end

    command "Confirm" do
      goal "Record that the verification the copy requested found both databases identical"

      reference_to DataCopy
      attribute :verification, Report

      sets :verification

      emits "DataCopyVerified"
    end

    command "Drift" do
      goal "Record that the verification the copy requested found the databases differ, and where"

      reference_to DataCopy
      attribute :verification, Report
      attribute :refusal,      Report

      sets :verification
      sets :refusal

      emits "DataCopyDrifted"
    end

    command "FlagVerification" do
      goal "Record that the copy ran but its verification could not be made, and why"

      reference_to DataCopy
      attribute :verification, Report
      attribute :refusal,      Report

      sets :verification
      sets :refusal

      emits "DataCopyVerificationFlagged"
    end

    query "Verdict" do
      description "What one copy found: its status, the report, and the reason it was flagged or drifted."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Flagged" do
      description "Every copy that was refused, failed or could not be verified."
      where(status: "flagged")
      order_by :run
    end

    query "Drifted" do
      description "Every copy whose verification found the two databases differ."
      where(status: "drifted")
      order_by :run
    end
  end

  policy "CopyDataWhenRequested" do
    on      "DataCopy.DataCopyRequested"
    trigger DataCopy::DeployToolchain::CopyData, with: { run: :run }
  end

  policy "RecordTheCopiedData" do
    on      "DataCopy.DataCopyAnswered"
    where   { !planned.value }
    trigger DataCopy::Complete, with: { report: :report }
  end

  policy "RecordTheCopyPlan" do
    on      "DataCopy.DataCopyAnswered"
    where   { planned.value }
    trigger DataCopy::Plan, with: { report: :report }
  end

  policy "RecordTheFlaggedCopy" do
    on      "DataCopy.DataCopyRefused"
    trigger DataCopy::Flag, with: { refusal: :refusal }
  end

  # Declared after RecordTheCopiedData: the copy is recorded before its verification is requested,
  # and the request comes from the answer itself because a reaction chain is bounded.
  policy "VerifyAfterCopy" do
    on      "DataCopy.DataCopyAnswered"
    where   { run_verify.value }
    trigger CopyVerification::Run,
            with: { project: :project, run: :run, bastion: :bastion, source: :source,
                    source_secret: :source_secret, target: :target, target_secret: :target_secret,
                    source_db: :source_db, target_db: :target_db }
  end

  policy "VerifyWhenRequested" do
    on      "DataCopy.DataCopyVerifyRequested"
    trigger CopyVerification::Run,
            with: { project: :project, run: :run, bastion: :bastion, source: :source,
                    source_secret: :source_secret, target: :target, target_secret: :target_secret,
                    source_db: :source_db, target_db: :target_db }
  end

  policy "VerifyDataCopyOnMatch" do
    on      "CopyVerification.CopyMatched"
    trigger DataCopy::Confirm, with: { data_copy: :run, verification: :report }
  end

  policy "DriftDataCopyOnDifference" do
    on      "CopyVerification.CopyDrifted"
    trigger DataCopy::Drift, with: { data_copy: :run, verification: :report, refusal: :report }
  end

  policy "FlagDataCopyOnUnverified" do
    on      "CopyVerification.CopyUnverified"
    trigger DataCopy::FlagVerification, with: { data_copy: :run, verification: :refusal, refusal: :refusal }
  end

  aggregate "CopyVerification" do
    description "One comparison of two databases holding a project's schemas: the generated verify-copy script run, and what it found."

    attribute :project,       Location
    attribute :script,        Location, optional: true
    attribute :run,           RunKey
    attribute :bastion,       Bastion
    attribute :source,        Host
    attribute :source_secret, Secret
    attribute :target,        Host
    attribute :target_secret, Secret
    attribute :source_db,     DatabaseName, default: { value: "" }
    attribute :target_db,     DatabaseName, default: { value: "" }
    attribute :report,        Report, optional: true
    attribute :refusal,       Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Location" do
      attribute :value, String, pattern: '[^\t\n\r]'

      invariant("a project or script is named by its path") { !value.to_s.empty? }
    end

    value_object "Bastion" do
      attribute :value, String, pattern: '^i-[0-9a-f]+$'
    end

    value_object "Host" do
      attribute :value, String, pattern: '^[A-Za-z0-9][A-Za-z0-9.-]*$'
    end

    value_object "Secret" do
      attribute :value, String, pattern: '^[^ \t\n\r]+$'
    end

    # A database's name; empty leaves it to the generated script's own default.
    value_object "DatabaseName" do
      attribute :value, String, pattern: '^[A-Za-z0-9_]*$'
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Match" => "verified", from: "requested"
      transition "Differ" => "drifted", from: "requested"
      transition "Flag" => "flagged", from: "requested"
    end

    # Runs the project's generated `verify-copy.sh`: structure and exact row counts of every table,
    # nothing unpopulated. Read-only on both databases. A `DataCopy` requests it, by `data_copy.verify`
    # or after a restore, and takes its outcome by the shared run key.
    command "Run" do
      goal "Compare two databases and record whether they match (exit 1 when drifted: 50 differ, or flagged: could not compare)"

      attribute :project,       Location
      attribute :script,        Location, optional: true
      attribute :run,           RunKey
      attribute :bastion,       Bastion
      attribute :source,        Host
      attribute :source_secret, Secret
      attribute :target,        Host
      attribute :target_secret, Secret
      attribute :source_db,     DatabaseName, default: { value: "" }
      attribute :target_db,     DatabaseName, default: { value: "" }

      sets :project
      sets :script
      sets :run
      sets :bastion
      sets :source
      sets :source_secret
      sets :target
      sets :target_secret
      sets :source_db
      sets :target_db

      emits "CopyVerificationRequested"
    end

    command "Match" do
      goal "Record that both databases hold the same structure and row counts"

      reference_to CopyVerification
      attribute :report, Report

      sets :report

      emits "CopyMatched"
    end

    command "Differ" do
      goal "Record that the databases differ, with what the script printed"

      reference_to CopyVerification
      attribute :report, Report

      sets :report

      emits "CopyDrifted"
    end

    command "Flag" do
      goal "Record that the comparison could not be made, and why"

      reference_to CopyVerification
      attribute :refusal, Report

      sets :refusal

      emits "CopyUnverified"
    end

    query "Verdict" do
      description "What one comparison found: its status, and the report or the reason it was flagged."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Drifted" do
      description "Every comparison that found the databases differ."
      where(status: "drifted")
      order_by :run
    end

    query "Flagged" do
      description "Every comparison that could not be made."
      where(status: "flagged")
      order_by :run
    end
  end

  policy "CompareCopyWhenRequested" do
    on      "CopyVerification.CopyVerificationRequested"
    trigger CopyVerification::DeployToolchain::CompareCopy, with: { run: :run }
  end

  policy "RecordTheMatchingCopy" do
    on      "CopyVerification.CopyVerificationAnswered"
    where   { !drifted.value }
    trigger CopyVerification::Match, with: { report: :report }
  end

  policy "RecordTheDriftedCopy" do
    on      "CopyVerification.CopyVerificationAnswered"
    where   { drifted.value }
    trigger CopyVerification::Differ, with: { report: :report }
  end

  policy "RecordTheUnverifiedCopy" do
    on      "CopyVerification.CopyVerificationRefused"
    trigger CopyVerification::Flag, with: { refusal: :refusal }
  end

  aggregate "BluebookDiff" do
    description "One report of which bluebook releases a deploy changes: the running image's bluebooks against the ones about to ship."

    attribute :project, Location
    attribute :script,  Location, optional: true
    attribute :run,     RunKey
    attribute :old,     Location, optional: true
    attribute :new,     Location, optional: true
    attribute :report,  Report, optional: true
    attribute :refusal, Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Location" do
      attribute :value, String, pattern: '[^\t\n\r]'

      invariant("a project, script or file is named by its path") { !value.to_s.empty? }
    end

    value_object "Report" do
      attribute :value, String
    end

    # No outcome is a failure: a report that could not be made is `unavailable`, never `flagged`
    # (only a malformed request is), because the era check gates a deploy, not this report.
    lifecycle :status, default: "requested" do
      transition "Match" => "unchanged", from: "requested"
      transition "Differ" => "changed", from: "requested"
      transition "Withhold" => "unavailable", from: "requested"
      transition "Flag" => "flagged", from: "requested"
    end

    # `hecks deploy bluebook_diff.run <project> [old=<json> new=<json>] [script=<path>]`. With
    # `old` and `new` (two `hecks package.verify` outputs) the comparison is made here, offline.
    # With neither, the project's `bluebooks-diff.sh` reads the running image's bluebooks from the
    # registry (read-only) and the local image's, and its report is classified. It never fails:
    # `unchanged`, `changed` or `unavailable` (a lookup failed, or the script is missing). Only
    # giving one of `old` and `new` is refused, as `flagged`.
    command "Run" do
      goal "Report which bluebook releases a deploy changes and record it (never a failure: unchanged, changed or unavailable)"

      attribute :project, Location
      attribute :script,  Location, optional: true
      attribute :run,     RunKey
      attribute :old,     Location, optional: true
      attribute :new,     Location, optional: true

      sets :project
      sets :script
      sets :run
      sets :old
      sets :new

      emits "BluebookDiffRequested"
    end

    command "Match" do
      goal "Record that the deploy changes no bluebook"

      reference_to BluebookDiff
      attribute :report, Report

      sets :report

      emits "BluebooksUnchanged"
    end

    command "Differ" do
      goal "Record the bluebooks the deploy adds, removes, re-versions or changes in content"

      reference_to BluebookDiff
      attribute :report, Report

      sets :report

      emits "BluebooksChanged"
    end

    command "Withhold" do
      goal "Record that the report could not be made, and why; the deploy carries on"

      reference_to BluebookDiff
      attribute :report, Report

      sets :report

      emits "BluebookDiffUnavailable"
    end

    command "Flag" do
      goal "Record that the request was malformed (only one of old and new), and why"

      reference_to BluebookDiff
      attribute :refusal, Report

      sets :refusal

      emits "BluebookDiffFlagged"
    end

    query "Verdict" do
      description "What one report found: its status and the report."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Changed" do
      description "Every report that found a bluebook release changed."
      where(status: "changed")
      order_by :run
    end
  end

  policy "DiffWhenRequested" do
    on      "BluebookDiff.BluebookDiffRequested"
    trigger BluebookDiff::DeployToolchain::CompareBluebooks, with: { run: :run }
  end

  policy "RecordTheUnchangedBluebooks" do
    on      "BluebookDiff.BluebookDiffAnswered"
    where   { outcome.value == "unchanged" }
    trigger BluebookDiff::Match, with: { report: :report }
  end

  policy "RecordTheChangedBluebooks" do
    on      "BluebookDiff.BluebookDiffAnswered"
    where   { outcome.value == "changed" }
    trigger BluebookDiff::Differ, with: { report: :report }
  end

  policy "RecordTheUnavailableDiff" do
    on      "BluebookDiff.BluebookDiffAnswered"
    where   { outcome.value == "unavailable" }
    trigger BluebookDiff::Withhold, with: { report: :report }
  end

  policy "RecordTheFlaggedDiff" do
    on      "BluebookDiff.BluebookDiffRefused"
    trigger BluebookDiff::Flag, with: { refusal: :refusal }
  end

  aggregate "PreviewRun" do
    description "One run of a project's preview script: the per-branch preview stack named, found, listed, deployed, destroyed or signed in to, and how it ended."

    attribute :project, Location
    attribute :script,  Location, optional: true
    attribute :run,     RunKey
    attribute :action,  Action
    attribute :branch,  Branch, optional: true
    attribute :confirm, Switch, optional: true
    attribute :dry_run, Switch, optional: true
    attribute :report,  Report, optional: true
    attribute :refusal, Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Location" do
      attribute :value, String, pattern: '[^\t\n\r]'

      invariant("a project or script is named by its path") { !value.to_s.empty? }
    end

    # What the script is asked to do; each command sets its own.
    value_object "Action" do
      attribute :value, String, pattern: '^(name|url|list|deploy|destroy|login)$'
    end

    # A git branch name. A preview is never of a production branch.
    value_object "Branch" do
      attribute :value, String, pattern: '^[^ \t\n\r]+$'

      invariant("a preview is never of main or master") { value != "main" && value != "master" }
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "RecordName" => "named", from: "requested"
      transition "RecordUrl" => "located", from: "requested"
      transition "RecordList" => "listed", from: "requested"
      transition "RecordDeploy" => "deployed", from: "requested"
      transition "RecordDestroy" => "destroyed", from: "requested"
      transition "RecordLogin" => "signed_in", from: "requested"
      transition "Plan" => "planned", from: "requested"
      transition "Flag" => "flagged", from: "requested"
    end

    # `hecks deploy preview_run.<name|url|list|deploy|destroy|login> <project> [branch=<name>]
    # [confirm=true] [dry_run=true] [script=<path>]`. Runs the project's `preview.sh` with that
    # verb; the script derives every name from the branch (the checked-out one unless `branch=`),
    # refuses `main` and `master`, and only touches stacks under its own prefix. `name`, `url` and
    # `list` read; `deploy`, `destroy` and `login` write to AWS or read its secrets, so they refuse
    # unless `confirm=true`, and `dry_run=true` prints the plan and runs nothing. Exit 1 when
    # flagged, with the script's status (1: it refused or failed) in the reason.
    command "Name" do
      goal "Print the names a branch's preview would have, from the project's preview script (no AWS call)"

      attribute :project, Location
      attribute :script,  Location, optional: true
      attribute :run,     RunKey
      attribute :action,  Action, default: { value: "name" }
      attribute :branch,  Branch, optional: true
      attribute :confirm, Switch, optional: true
      attribute :dry_run, Switch, optional: true

      sets :project
      sets :script
      sets :run
      sets :action
      sets :branch
      sets :confirm
      sets :dry_run

      emits "PreviewNameRequested"
    end

    command "Url" do
      goal "Print a branch's preview URL, read from its stack"

      attribute :project, Location
      attribute :script,  Location, optional: true
      attribute :run,     RunKey
      attribute :action,  Action, default: { value: "url" }
      attribute :branch,  Branch, optional: true
      attribute :confirm, Switch, optional: true
      attribute :dry_run, Switch, optional: true

      sets :project
      sets :script
      sets :run
      sets :action
      sets :branch
      sets :confirm
      sets :dry_run

      emits "PreviewUrlRequested"
    end

    command "List" do
      goal "List every preview stack that exists, read from AWS"

      attribute :project, Location
      attribute :script,  Location, optional: true
      attribute :run,     RunKey
      attribute :action,  Action, default: { value: "list" }
      attribute :branch,  Branch, optional: true
      attribute :confirm, Switch, optional: true
      attribute :dry_run, Switch, optional: true

      sets :project
      sets :script
      sets :run
      sets :action
      sets :branch
      sets :confirm
      sets :dry_run

      emits "PreviewListRequested"
    end

    command "Deploy" do
      goal "Create or update a branch's preview from the images built locally (writes to AWS; refuses unless confirm=true)"

      attribute :project, Location
      attribute :script,  Location, optional: true
      attribute :run,     RunKey
      attribute :action,  Action, default: { value: "deploy" }
      attribute :branch,  Branch, optional: true
      attribute :confirm, Switch, optional: true
      attribute :dry_run, Switch, optional: true

      sets :project
      sets :script
      sets :run
      sets :action
      sets :branch
      sets :confirm
      sets :dry_run

      emits "PreviewDeployRequested"
    end

    command "Destroy" do
      goal "Tear a branch's preview stack down (writes to AWS; refuses unless confirm=true)"

      attribute :project, Location
      attribute :script,  Location, optional: true
      attribute :run,     RunKey
      attribute :action,  Action, default: { value: "destroy" }
      attribute :branch,  Branch, optional: true
      attribute :confirm, Switch, optional: true
      attribute :dry_run, Switch, optional: true

      sets :project
      sets :script
      sets :run
      sets :action
      sets :branch
      sets :confirm
      sets :dry_run

      emits "PreviewDestroyRequested"
    end

    command "Login" do
      goal "Mint a line that signs the deployer in to a preview as its first admin (reads its session secret; refuses unless confirm=true)"

      attribute :project, Location
      attribute :script,  Location, optional: true
      attribute :run,     RunKey
      attribute :action,  Action, default: { value: "login" }
      attribute :branch,  Branch, optional: true
      attribute :confirm, Switch, optional: true
      attribute :dry_run, Switch, optional: true

      sets :project
      sets :script
      sets :run
      sets :action
      sets :branch
      sets :confirm
      sets :dry_run

      emits "PreviewLoginRequested"
    end

    command "RecordName" do
      goal "Record the names the script printed"

      reference_to PreviewRun
      attribute :report, Report

      sets :report

      emits "PreviewNamed"
    end

    command "RecordUrl" do
      goal "Record the preview URL the script printed"

      reference_to PreviewRun
      attribute :report, Report

      sets :report

      emits "PreviewLocated"
    end

    command "RecordList" do
      goal "Record the preview stacks the script listed"

      reference_to PreviewRun
      attribute :report, Report

      sets :report

      emits "PreviewListed"
    end

    command "RecordDeploy" do
      goal "Record that the preview was created or updated, and what the script said"

      reference_to PreviewRun
      attribute :report, Report

      sets :report

      emits "PreviewDeployed"
    end

    command "RecordDestroy" do
      goal "Record that the preview was torn down, and what the script said"

      reference_to PreviewRun
      attribute :report, Report

      sets :report

      emits "PreviewDestroyed"
    end

    command "RecordLogin" do
      goal "Record that the sign-in line was minted, and where the script put it"

      reference_to PreviewRun
      attribute :report, Report

      sets :report

      emits "PreviewSignedIn"
    end

    command "Plan" do
      goal "Record the plan a dry run printed: what would run and where, with nothing run"

      reference_to PreviewRun
      attribute :report, Report

      sets :report

      emits "PreviewPlanned"
    end

    command "Flag" do
      goal "Record that the run was refused or failed, with the script's status and what it said"

      reference_to PreviewRun
      attribute :refusal, Report

      sets :refusal

      emits "PreviewFlagged"
    end

    query "Verdict" do
      description "What one run found: its status, the report, and the reason it was flagged."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Flagged" do
      description "Every preview run that was refused or failed."
      where(status: "flagged")
      order_by :run
    end
  end

  policy "RunPreviewWhenNameRequested" do
    on      "PreviewRun.PreviewNameRequested"
    trigger PreviewRun::DeployToolchain::RunPreview, with: { run: :run }
  end

  policy "RunPreviewWhenUrlRequested" do
    on      "PreviewRun.PreviewUrlRequested"
    trigger PreviewRun::DeployToolchain::RunPreview, with: { run: :run }
  end

  policy "RunPreviewWhenListRequested" do
    on      "PreviewRun.PreviewListRequested"
    trigger PreviewRun::DeployToolchain::RunPreview, with: { run: :run }
  end

  policy "RunPreviewWhenDeployRequested" do
    on      "PreviewRun.PreviewDeployRequested"
    trigger PreviewRun::DeployToolchain::RunPreview, with: { run: :run }
  end

  policy "RunPreviewWhenDestroyRequested" do
    on      "PreviewRun.PreviewDestroyRequested"
    trigger PreviewRun::DeployToolchain::RunPreview, with: { run: :run }
  end

  policy "RunPreviewWhenLoginRequested" do
    on      "PreviewRun.PreviewLoginRequested"
    trigger PreviewRun::DeployToolchain::RunPreview, with: { run: :run }
  end

  policy "RecordThePreviewName" do
    on      "PreviewRun.PreviewRunAnswered"
    where   { outcome.value == "named" }
    trigger PreviewRun::RecordName, with: { report: :report }
  end

  policy "RecordThePreviewUrl" do
    on      "PreviewRun.PreviewRunAnswered"
    where   { outcome.value == "located" }
    trigger PreviewRun::RecordUrl, with: { report: :report }
  end

  policy "RecordThePreviewList" do
    on      "PreviewRun.PreviewRunAnswered"
    where   { outcome.value == "listed" }
    trigger PreviewRun::RecordList, with: { report: :report }
  end

  policy "RecordTheDeployedPreview" do
    on      "PreviewRun.PreviewRunAnswered"
    where   { outcome.value == "deployed" }
    trigger PreviewRun::RecordDeploy, with: { report: :report }
  end

  policy "RecordTheDestroyedPreview" do
    on      "PreviewRun.PreviewRunAnswered"
    where   { outcome.value == "destroyed" }
    trigger PreviewRun::RecordDestroy, with: { report: :report }
  end

  policy "RecordThePreviewLogin" do
    on      "PreviewRun.PreviewRunAnswered"
    where   { outcome.value == "signed_in" }
    trigger PreviewRun::RecordLogin, with: { report: :report }
  end

  policy "RecordThePreviewPlan" do
    on      "PreviewRun.PreviewRunAnswered"
    where   { outcome.value == "planned" }
    trigger PreviewRun::Plan, with: { report: :report }
  end

  policy "RecordTheFlaggedPreview" do
    on      "PreviewRun.PreviewRunRefused"
    trigger PreviewRun::Flag, with: { refusal: :refusal }
  end

  aggregate "CompanionRoll" do
    description "One roll of a companion Compose project (a second project beside the app's) onto the box: the project's deploy script run, and how it ended."

    attribute :project,   Location
    attribute :script,    Location, optional: true
    attribute :run,       RunKey
    attribute :companion, Companion, default: { value: "umami" }
    attribute :taskdef,   TaskDefinition
    attribute :confirm,   Switch, optional: true
    attribute :dry_run,   Switch, optional: true
    attribute :report,    Report, optional: true
    attribute :refusal,   Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Location" do
      attribute :value, String, pattern: '[^\t\n\r]'

      invariant("a project or script is named by its path") { !value.to_s.empty? }
    end

    # The companion's name; its script is `deploy-<companion>.sh`.
    value_object "Companion" do
      attribute :value, String, pattern: '^[a-z0-9][a-z0-9-]*$'
    end

    # A task definition revision (or family) the companion's image and settings are read from.
    value_object "TaskDefinition" do
      attribute :value, String, pattern: '^[A-Za-z0-9_-]+(:[0-9]+)?$'
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Complete" => "rolled", from: "requested"
      transition "Plan" => "planned", from: "requested"
      transition "Flag" => "flagged", from: "requested"
    end

    # `hecks deploy companion_roll.run <project> taskdef=<family:rev> [companion=umami] [confirm=true]
    # [dry_run=true] [script=<path>]`. Runs the project's `deploy-<companion>.sh`, which reads the
    # companion's image and settings from the task definition, sends a Compose project and its secret
    # references to the box over SSM (secret values never travel; the box resolves them), starts it
    # beside the app's project, and checks it on the box. It writes to the box, so it refuses unless
    # `confirm=true`; `dry_run=true` prints the plan and runs nothing. Exit 1 when flagged.
    command "Run" do
      goal "Roll a companion Compose project onto the box and record the check on the box (refuses unless confirm=true)"

      attribute :project,   Location
      attribute :script,    Location, optional: true
      attribute :run,       RunKey
      attribute :companion, Companion, default: { value: "umami" }
      attribute :taskdef,   TaskDefinition
      attribute :confirm,   Switch, optional: true
      attribute :dry_run,   Switch, optional: true

      sets :project
      sets :script
      sets :run
      sets :companion
      sets :taskdef
      sets :confirm
      sets :dry_run

      emits "CompanionRollRequested"
    end

    command "Complete" do
      goal "Record that the companion rolled and passed its check on the box, and what the script printed"

      reference_to CompanionRoll
      attribute :report, Report

      sets :report

      emits "CompanionRolled"
    end

    command "Plan" do
      goal "Record the plan a dry run printed: what would be rolled and where, with nothing run"

      reference_to CompanionRoll
      attribute :report, Report

      sets :report

      emits "CompanionRollPlanned"
    end

    command "Flag" do
      goal "Record that the roll was refused, or the companion did not roll or is not healthy, and why"

      reference_to CompanionRoll
      attribute :refusal, Report

      sets :refusal

      emits "CompanionRollFlagged"
    end

    query "Verdict" do
      description "What one roll found: its status, the report, and the reason it was flagged."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Flagged" do
      description "Every companion roll that was refused, did not roll or was not healthy."
      where(status: "flagged")
      order_by :run
    end
  end

  policy "RollCompanionWhenRequested" do
    on      "CompanionRoll.CompanionRollRequested"
    trigger CompanionRoll::DeployToolchain::RollCompanion, with: { run: :run }
  end

  policy "RecordTheRolledCompanion" do
    on      "CompanionRoll.CompanionRollAnswered"
    where   { !planned.value }
    trigger CompanionRoll::Complete, with: { report: :report }
  end

  policy "RecordTheCompanionPlan" do
    on      "CompanionRoll.CompanionRollAnswered"
    where   { planned.value }
    trigger CompanionRoll::Plan, with: { report: :report }
  end

  policy "RecordTheFlaggedCompanionRoll" do
    on      "CompanionRoll.CompanionRollRefused"
    trigger CompanionRoll::Flag, with: { refusal: :refusal }
  end

  aggregate "TemplateComparison" do
    description "One offline comparison of two CloudFormation templates, by logical id."

    attribute :before,  Location
    attribute :after,   Location
    attribute :run,     RunKey
    attribute :json,    Switch, optional: true
    attribute :strict,  Switch, optional: true
    attribute :report,  Report, optional: true
    attribute :refusal, Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Location" do
      attribute :value, String, pattern: '[^\t\n\r]'

      invariant("a template is named by its path") { !value.to_s.empty? }
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Match"  => "matching", from: "requested"
      transition "Drift"  => "drifted",  from: "requested"
      transition "Refuse" => "refused",  from: "requested"
    end

    # `hecks deploy template_comparison.diff <before> after=<template> [--json] [--strict]`. `--strict` also counts
    # cosmetic differences (comments, key order); `--json` writes the report as JSON.
    command "Diff" do
      goal "Compare two CloudFormation templates and report what differs by logical id"

      attribute :before, Location
      attribute :after,  Location
      attribute :run,    RunKey
      attribute :json,   Switch, optional: true
      attribute :strict, Switch, optional: true

      sets :before
      sets :after
      sets :run
      sets :json
      sets :strict

      emits "ComparisonRequested"
    end

    command "Match" do
      goal "Record that the templates agree"

      reference_to TemplateComparison
      attribute :report,    Report
      attribute :different, Switch

      given("the templates agree") { !different.value }

      sets :report

      emits "TemplatesMatched"
    end

    command "Drift" do
      goal "Record that the templates differ, and how"

      reference_to TemplateComparison
      attribute :report,    Report
      attribute :different, Switch

      given("the templates differ") { different.value }

      sets :report

      emits "TemplatesDrifted"
    end

    command "Refuse" do
      goal "Record that a template could not be read, and why"

      reference_to TemplateComparison
      attribute :refusal, Report

      sets :refusal

      emits "ComparisonRefused"
    end

    query "Verdict" do
      description "What one comparison found: its status, and the report or the reason it could not run."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Drifted" do
      description "Every comparison in which the templates differ."
      where(status: "drifted")
      order_by :run
    end
  end

  policy "CompareWhenRequested" do
    on      "TemplateComparison.ComparisonRequested"
    trigger TemplateComparison::DeployToolchain::Compare, with: { run: :run }
  end

  policy "RecordTheMatch" do
    on      "TemplateComparison.ComparisonAnswered"
    trigger TemplateComparison::Match, with: { report: :report, different: :different }
  end

  policy "RecordTheDrift" do
    on      "TemplateComparison.ComparisonAnswered"
    trigger TemplateComparison::Drift, with: { report: :report, different: :different }
  end

  policy "RecordTheRefusedComparison" do
    on      "TemplateComparison.ComparisonUnreadable"
    trigger TemplateComparison::Refuse, with: { refusal: :refusal }
  end

  aggregate "OidcManifest" do
    description "One projection of each domain's OIDC client and scope manifest into its oidc.json."

    attribute :run,     RunKey
    attribute :domains, DomainList, optional: true
    attribute :output,  Report,     optional: true
    attribute :refusal, Report,     optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    # Domain directories, comma separated; every domain of the checkout when absent.
    value_object "DomainList" do
      attribute :value, String, pattern: '[^\t\n\r]'
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Complete" => "projected", from: "requested"
      transition "Fault"    => "faulted",   from: "requested"
    end

    command "ProjectOidc" do
      goal "Write each domain's OIDC client and scope manifest beside it as oidc.json"

      attribute :domains, DomainList, optional: true
      attribute :run,     RunKey

      sets :domains
      sets :run

      emits "OidcProjectionRequested"
    end

    command "Complete" do
      goal "Record which manifests were written"

      reference_to OidcManifest
      attribute :output, Report

      sets :output

      emits "OidcProjected"
    end

    command "Fault" do
      goal "Record that the manifests could not be projected, and why"

      reference_to OidcManifest
      attribute :refusal, Report

      sets :refusal

      emits "OidcFaulted"
    end

    query "Outcome" do
      description "What one projection did: its status, and the manifests written or the reason it stopped."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Faulted" do
      description "Every projection that could not write its manifests."
      where(status: "faulted")
      order_by :run
    end
  end

  policy "ProjectWhenRequested" do
    on      "OidcManifest.OidcProjectionRequested"
    trigger OidcManifest::DeployToolchain::Manifest, with: { run: :run }
  end

  policy "RecordTheManifests" do
    on      "OidcManifest.ManifestAnswered"
    trigger OidcManifest::Complete, with: { output: :output }
  end

  policy "RecordTheFaultedManifests" do
    on      "OidcManifest.ManifestRefused"
    trigger OidcManifest::Fault, with: { refusal: :refusal }
  end
end
