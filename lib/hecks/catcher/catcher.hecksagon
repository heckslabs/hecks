# The Catcher domain, bound so it boots standing alone (a model_check or behaviors boot of this
# directory). Its records are kept by the store catcher.world names, so a drain's sitting outlives
# the process. Governance checks the role each command names.
Hecks.hecksagon "Catcher" do
  attaches "Governance"

  # The outside a drain reaches: the spool file the hook appends to. `read` answers the lines the
  # spool holds, through `through`, the number of lines consumed so far. The port never writes a
  # line to the spool.
  Catcher::Drain.port "Spool" do
    asks "Read", to: Drain do
      attribute :run, RunKey
      answers "SpoolRead"
      refuses "SpoolRefused"
    end
  end

  # The spool cursor, asked by a sitting once it is kept: `acknowledge` moves the cursor to
  # `through`, so the next read starts after the lines this sitting holds.
  Catcher::Observation.port "SpoolCursor" do
    asks "Acknowledge", to: Observation do
      attribute :sitting, SittingKey
      attribute :through, Count
      answers "SpoolAcknowledged"
      refuses "SpoolAckRefused"
    end
  end

  # The tally of recurring patterns, asked once per detection run. The answer is the best
  # candidate with no audit yet. `audit_id` is one token of letters, digits, dots, underscores,
  # colons and hyphens, such as `git-add-2026-11-03T06:41:25Z`, given as `{ value: }`. Then
  # `calls`, `sessions` and `success_rate`, each `{ value: }`, then `subject`, `proposal`,
  # `proposed_kind` and `aggregate_name` as `{ value: }` strings, and `raised_at`, a UTC instant
  # ending in Z. No candidate answers zero calls and empty strings. A refusal gives its reason
  # as `refusal`, as `{ value: }`.
  Catcher::Detection.port "Tally" do
    asks "Tally", to: Detection do
      attribute :run, RunKey
      answers "Tallied"
      refuses "TallyRefused"
    end
  end
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
# Its records stay in Memory: the Catcher world's store is for Catcher's own aggregates.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
