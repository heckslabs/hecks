# Binds the `Tally` port to `PatternTally`, which answers `Detection`'s ask by counting the kept
# calls by subject, read-only from the Catcher store. Required by name, not relative, so a copy of
# this directory shares the one implementation loaded.
require "hecks/catcher/adapters/pattern_tally"

Hecks.adapter "PatternTally" do
  port "Tally"
end
