# The Catcher bluebook: the actions a session takes outside any declared command. The calls a
# drain of the spool reads are kept as one sitting (Observation), judged as a pattern against the
# declared rules (Audit), and, once a person accepts the audit, led to a corrective action
# (CorrectiveAction). The judgment keeps the ISO vocabulary: nonconformity,
# opportunity_for_improvement, or observation_only.
#
# A drain asks the Spool port to read, keeps the sitting and marks the drain recorded, then asks
# the port to acknowledge the read, so the spool's cursor moves only after the sitting is kept.
#
# Roles are checked by Governance, which the Catcher hecksagon attaches. A role here is a
# name Governance grants through its RoleAssignments, never a list kept in this domain.
# Accept and Dismiss are a person's decisions, so they run as Operator. `decided_by` is the
# actor_id the caller names; the runtime does not fill it.
Hecks.bluebook "Catcher" do
  vision "Raw actions seen outside any declared command are kept, judged, and either brought under a declared command or dismissed."

  # One sitting: the tool calls one drain read from the spool, kept as they were seen. The word
  # Observation names the sitting, which holds many calls.
  aggregate "Observation" do
    description "One sitting: many tool calls drained from the spool at once, kept as seen."

    attribute :sitting, SittingKey
    attribute :calls,   list_of(Call)
    attribute :through, Count
    identified_by :sitting

    # The drain's run key. One drain is one sitting, so a drain read again is a second sitting.
    value_object "SittingKey" do
      attribute :value, String, matches: :present
    end

    # One tool call in a sitting, as the spool line held it. `call_id` is the line's own id,
    # unique to that call. The fields are flat, so a list of calls takes each one as it is.
    value_object "Call" do
      # The line's own id, unique to one call.
      attribute :call_id,     String, matches: :present
      # Where the action was seen: `bash`, `git`, `gh`, `make`, an MCP tool or a file edit.
      attribute :source,      String, matches: :present
      # The program that ran, such as `git`.
      attribute :tool,        String, matches: :present
      # The subcommand words of the action, with its arguments blanked: `git status`, never the
      # arguments themselves.
      attribute :subject,     String, matches: :present
      attribute :succeeded,   Boolean
      # The session the action was seen in, as its identifier.
      attribute :observed_in, String, matches: :present
      # A UTC instant to the second, ending in Z: the moment the action was seen.
      attribute :observed_at, String,
                pattern: '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
    end

    # How far into the spool the drain read when it kept this sitting.
    value_object "Count" do
      attribute :value, Integer
      invariant("a count is not negative") { !value.negative? }
    end

    # One sitting, recorded from one drain's answer. Nothing here changes or removes a sitting:
    # the only command adds one, so the log only grows.
    command "Record" do
      role "System"
      goal "Keep one sitting: the tool calls one drain read from the spool"

      sets :sitting
      sets :calls
      sets :through

      emits ObservationRecorded
    end
  end

  # The judgment of a pattern of observations against the declared rules. An adapter counts the
  # recurrence and raises an audit; a person accepts it into corrective action or dismisses it.
  aggregate "Audit" do
    description "One pattern of observed actions, judged against the declared rules: raised, then accepted or dismissed, never deleted."

    attribute :subject,        Subject
    attribute :kind,           AuditKind
    attribute :count,          Count
    attribute :sessions,       Count
    attribute :success_rate,   SuccessRate
    attribute :proposal,       Proposal
    attribute :proposed_kind,  ProposedKind
    attribute :aggregate_name, AggregateName
    attribute :raised_at,      Timestamp
    attribute :decided_by,     DecidedBy, optional: true
    attribute :reason,         Reason, optional: true

    # The subject and the moment it was raised: a pattern raised again after a dismissal is a
    # second audit, the same way a role granted again is a second assignment.
    identified_by :subject, :raised_at

    value_object "Subject" do
      attribute :value, String
      invariant("an audit names the pattern it concerns") { !value.to_s.empty? }
    end

    # nonconformity: an observed action breaks a declared rule. opportunity_for_improvement: a
    # pattern a declared command would serve better. observation_only: seen, not yet judged.
    value_object "AuditKind" do
      attribute :value, String,
                one_of: ["nonconformity", "opportunity_for_improvement", "observation_only"]
    end

    value_object "Count" do
      attribute :value, Integer
      invariant("a count is not negative") { !value.negative? }
    end

    # The share of the pattern's observations that succeeded, from 0.0 to 1.0.
    value_object "SuccessRate" do
      attribute :value, Float
      invariant("a success rate is between 0 and 1") { value >= 0 && value <= 1 }
    end

    # The DSL block that would bring the pattern under a declared command, aggregate, lifecycle
    # or invariant. For a command, lifecycle or invariant, the text is meant to sit inside the
    # aggregate named by aggregate_name; for an aggregate, the text is that aggregate. Text for a
    # person to read and paste; nothing here evaluates it.
    value_object "Proposal" do
      attribute :value, String
    end

    # command, lifecycle or invariant: the proposal text is meant to sit inside the aggregate
    # named by aggregate_name. aggregate: the proposal text is meant to be that aggregate.
    value_object "ProposedKind" do
      attribute :value, String, one_of: ["command", "aggregate", "lifecycle", "invariant"]
    end

    # The PascalCase name of the aggregate the proposal sits in, or is, such as `Audit`.
    value_object "AggregateName" do
      attribute :value, String, pattern: '^[A-Z][A-Za-z0-9]*$'
      invariant("an aggregate name is present") { !value.to_s.empty? }
    end

    value_object "Timestamp" do
      attribute :value, String, pattern: '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
      invariant("a timestamp is present") { !value.to_s.empty? }
    end

    # The actor_id the caller names for the person who accepted or dismissed the audit. The
    # runtime does not fill it. Governance's own IdentityId is not shared across bluebooks, so
    # this restates it.
    value_object "DecidedBy" do
      attribute :value, String, matches: :present
    end

    value_object "Reason" do
      attribute :value, String
      invariant("a dismissal gives its reason") { !value.to_s.empty? }
    end

    lifecycle :status, default: "raised" do
      transition "Accept"  => "accepted",  from: "raised"
      transition "Dismiss" => "dismissed", from: "raised"
      mark :terminal, "accepted", "dismissed"
    end

    command "Raise" do
      role "System"
      goal "Record a pattern of observed actions as an audit, judged against the declared rules"

      given("a pattern has at least 3 calls") { count.value >= 3 }
      given("a pattern is seen in at least 2 sessions") { sessions.value >= 2 }
      given("a pattern has a success rate of at least 0.8") { success_rate.value >= 0.8 }

      sets :subject
      sets :kind
      sets :count
      sets :sessions
      sets :success_rate
      sets :proposal
      sets :proposed_kind
      sets :aggregate_name
      sets :raised_at

      emits AuditRaised
    end

    command "Accept" do
      role "Operator"
      goal "Take an audit on, so that a corrective action is started for it"

      reference_to Audit
      attribute :decided_by, DecidedBy, sets: true

      emits AuditAccepted
    end

    command "Dismiss" do
      role "Operator"
      goal "Decline an audit, and say why"

      reference_to Audit
      attribute :decided_by, DecidedBy, sets: true
      attribute :reason, Reason, sets: true

      emits AuditDismissed
    end

    # A new raise reads this first, so the same pattern is not raised twice.
    query "RaisedFor" do
      description "Every raised audit of one subject, oldest first."
      attribute :subject, String
      where(status: "raised", subject: :subject)
      order_by :raised_at
    end
  end

  # The action one accepted audit leads to: one corrective action per audit, started by a
  # policy when the audit is accepted.
  aggregate "CorrectiveAction" do
    description "The corrective action one accepted audit leads to, and the Work row that carries it out."

    attribute :audit, AuditKey
    attribute :work,  WorkKey, optional: true
    attribute :state, ActionState

    identified_by :audit

    # The audit's identity as the Audit record writes it: its subject and raised_at, joined by a
    # colon.
    value_object "AuditKey" do
      attribute :value, String
      invariant("a corrective action names its audit") { !value.to_s.empty? }
    end

    # The identifier of the Work row this action started, when one was started for it.
    value_object "WorkKey" do
      attribute :value, String
    end

    # Started is the only state the model declares; more may be added.
    value_object "ActionState" do
      attribute :value, String
      invariant("an action has a state") { !value.to_s.empty? }
    end

    command "Start" do
      role "System"
      goal "Begin the corrective action an accepted audit leads to"

      sets :audit
      sets :work
      sets :state, to: "started"

      emits CorrectiveActionStarted
    end
  end

  # One reading of the spool file the hook appends to. The Spool port answers each ask: a read
  # answers the lines the spool holds, and an acknowledge moves its cursor past them. The port
  # never writes a line; the bluebook says what a drain is and how it ends.
  aggregate "Drain" do
    description "One reading of the spool: read and kept as a sitting, or refused with the reason."

    attribute :run,     DrainKey
    attribute :through, Count,  optional: true
    attribute :refusal, Reason, optional: true
    identified_by :run

    value_object "DrainKey" do
      attribute :value, String, matches: :present
    end

    # How far into the spool a drain read: the spool lines consumed so far, from its first line.
    value_object "Count" do
      attribute :value, Integer
      invariant("a count is not negative") { !value.negative? }
    end

    value_object "Reason" do
      attribute :value, String
      invariant("a refusal gives its reason") { !value.to_s.empty? }
    end

    lifecycle :status, default: "requested" do
      mark :failure, "refused"
      transition "Recorded" => "recorded", from: "requested"
      transition "Complete" => "drained",  from: "recorded"
      transition "Decline"  => "refused",  from: ["requested", "recorded"]
      mark :terminal, "drained", "refused"
    end

    # A person asks for one drain of the spool.
    command "Request" do
      role "Operator"
      goal "Read the spool once, so that the lines it holds are kept as one sitting"

      sets :run

      emits DrainRequested
    end

    # The sitting is kept: the drain records that, and the spool position it read through.
    command "Recorded" do
      role "System"
      goal "Record that the drain's sitting is kept, and the spool position it read through"

      reference_to Drain
      attribute :through, Count, sets: true

      emits DrainRecorded
    end

    # Runs once the spool is acknowledged, so the drain ends after its work.
    command "Complete" do
      role "System"
      goal "Record how far into the spool the drain read, once its sitting is kept"

      reference_to Drain
      attribute :through, Count, sets: true

      emits DrainCompleted
    end

    command "Decline" do
      role "System"
      goal "Record why the spool could not be read"

      reference_to Drain
      attribute :refusal, Reason, sets: true

      emits DrainDeclined
    end
  end

  policy "StartWhenAccepted" do
    on      "Audit.AuditAccepted"
    trigger CorrectiveAction::Start, with: { audit: :id }
  end

  # A requested drain asks the Spool port to read the spool. Each answer moves the drain on.
  policy "ReadWhenRequested" do
    on      "Drain.DrainRequested"
    ask     :read, with: { run: :run }
  end

  # The lines the read answered are kept as one sitting, keyed by the drain's run.
  policy "RecordTheSitting" do
    on      "Drain.SpoolRead"
    trigger Observation::Record, with: { sitting: :run, calls: :lines, through: :through }
  end

  policy "DeclineWhenSpoolRefused" do
    on      "Drain.SpoolRefused"
    trigger Drain::Decline, with: { refusal: :refusal }
  end

  # The sitting is kept, so the drain records that and carries the spool position it read through.
  policy "RecordTheDrainWhenSitting" do
    on      "Observation.ObservationRecorded"
    trigger Drain::Recorded, with: { run: :sitting, through: :through }
  end

  # The cursor moves only once the drain records its sitting: a crash before that reads the lines
  # again.
  policy "AcknowledgeWhenDrainRecorded" do
    on      "Drain.DrainRecorded"
    ask     :acknowledge, with: { run: :run, through: :through }
  end

  policy "CompleteWhenAcknowledged" do
    on      "Drain.SpoolAcknowledged"
    trigger Drain::Complete, with: { through: :through }
  end

  policy "DeclineWhenAckRefused" do
    on      "Drain.SpoolAckRefused"
    trigger Drain::Decline, with: { refusal: :refusal }
  end
end
