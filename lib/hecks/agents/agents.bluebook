Hecks.bluebook "Agents" do
  vision "Each agent role does one judgment step and talks to the others only through events; no role may take an owner decision."

  namespace "Hecks::Agents"

  supporting

  # One role the pipeline may wake on demand. The owner-only commands are never issued by a role.
  aggregate "Role" do
    description "A named agent role: the judgment it owns, and the commands it may issue. A role wakes when a request event arrives and ends after it answers."

    identified_by :name

    attribute :name, RoleName
    attribute :kind, RoleKind, optional: true

    value_object "RoleName" do
      attribute :value, String, matches: :present
      invariant("a role has a name") { !value.to_s.empty? }
    end

    value_object "RoleKind", String

    value_object "CommandName", String

    # Declares a role. Its kind says which judgment it owns: orchestrator, architect, coder,
    # reviewer or release manager.
    command "Declare" do
      role "Maintainer"
      goal "Declare a role and the judgment it owns"

      attribute :name, RoleName, sets: true
      attribute :kind, RoleKind, sets: true

      emits "RoleDeclared"
    end

    # A role asks to issue a command. Owner decisions (promotion, release, push, delete, merge) are
    # refused for every role: those go to a person.
    command "Issue" do
      role "System"
      goal "Issue one command on behalf of a role, unless the command is an owner decision"

      reference_to Role
      attribute :command, CommandName

      given("the command is not an owner decision") do
        command.value != "promote" && command.value != "release" && command.value != "push" &&
          command.value != "delete" && command.value != "merge"
      end

      emits "CommandIssued"
    end
  end

  # The architect's review of a plan, asked by event instead of by prose. Each review has its own
  # run key, which is also the key of the architect's run, so a Work item is reviewed again once a
  # review has ended; the launcher mints the key when a request leaves it out. Each request carries
  # a hop count so a review that asks another review stops.
  aggregate "PlanReview" do
    description "One review of a Work item's plan by the architect role: asked as an event, answered with a verdict, and refused past the hop limit."

    identified_by :run

    acknowledges :key_by_value, "the Work item's slug, which lives in the Tickets store, not in a Routing record, so a reference would refuse every review of a Work item no routing was asked for", of: :work

    attribute :run, RunKey
    attribute :work, WorkKey
    attribute :verdict, Verdict, optional: true
    attribute :findings, FindingsText, optional: true
    attribute :hops, HopCount, optional: true

    # One review's key, and the key of the architect's run that answers it.
    value_object "RunKey" do
      attribute :value, String, matches: :present
    end

    value_object "WorkKey" do
      attribute :value, String, matches: :present
      invariant("a review names its Work item") { !value.to_s.empty? }
    end

    value_object "Verdict", String

    # The architect's closing text: the findings behind the verdict, kept with it.
    value_object "FindingsText", String

    value_object "HopCount", Integer

    value_object "RoleRef", String

    value_object "RepoPath", String

    value_object "PlanText", String

    # A request is refused at the third hop, so a chain of reviews that ask for reviews stops by name.
    command "Request" do
      role "System"
      goal "Ask the architect to review one Work item's plan"

      attribute :run,  RunKey, sets: true
      attribute :work, WorkKey, sets: true
      attribute :hops, HopCount, sets: true
      attribute :role, RoleRef
      attribute :repo, RepoPath
      attribute :plan, PlanText

      given("the request is under the hop limit") { hops.value < 3 }

      emits "PlanReviewRequested"
    end

    # The architect answers with a verdict: sound, changes, or rethink.
    command "Answer" do
      role "System"
      goal "Record the architect's verdict on the plan"

      reference_to PlanReview
      attribute :verdict, Verdict, sets: true
      attribute :findings, FindingsText, optional: true, sets: true

      given("the verdict is one the architect gives") do
        verdict.value == "sound" || verdict.value == "changes" || verdict.value == "rethink"
      end

      emits "PlanReviewed"
    end

    # The verdict of an architect run no request row names, such as one started by hand or whose row
    # was lost: the review is created with its verdict, so the verdict is a fact on the change and
    # not a lookup. A row that exists refuses it, and the `Answer` beside it has recorded the verdict.
    command "Record" do
      role "System"
      goal "Create a review from the architect's closing verdict when no request row exists"

      attribute :run,      RunKey, sets: true
      attribute :work,     WorkKey, sets: true
      attribute :verdict,  Verdict, sets: true
      attribute :findings, FindingsText, optional: true, sets: true

      given("the verdict is one the architect gives") do
        verdict.value == "sound" || verdict.value == "changes" || verdict.value == "rethink"
      end

      emits "PlanReviewRecorded"
    end

    policy "RecordTheVerdictWhenNoReviewWasAsked" do
      on      "AgentRun.JobRead"
      root
      where   { agent == "architect" && verdict != "" && previous != state }
      trigger PlanReview::Record, with: { run: :run, work: :work, verdict: :verdict, findings: :findings }
    end

    query "Reviews" do
      description "Every plan review, by Work item, each with its run key: the verdict once the architect has answered."
      order_by :work
    end
  end

  # The reviewer's judgment of a failing spec: a real bug, or a stale expectation. A real bug is
  # never fixed by an agent on its own; it goes to a person.
  aggregate "SubmissionReview" do
    description "One judgment by the reviewer role of a submission's failing spec: asked as an event, answered with a verdict, and a real bug handed to a person."

    identified_by :submission

    attribute :submission, SubmissionRef
    attribute :work, WorkKey, optional: true
    attribute :judgment, Judgment, optional: true
    attribute :hops, HopCount, optional: true

    # The commit the coder submitted: the review's key, and the key of the reviewer's run.
    value_object "SubmissionRef" do
      attribute :value, String, matches: :present
      invariant("a review names the commit it judges") { !value.to_s.empty? }
    end

    value_object "WorkKey", String

    value_object "Judgment", String

    value_object "HopCount", Integer

    value_object "RoleRef", String

    value_object "RepoPath", String

    value_object "BriefText", String

    command "Request" do
      role "System"
      goal "Ask the reviewer to judge a submission's failing spec"

      attribute :submission, SubmissionRef, sets: true
      attribute :work, WorkKey, sets: true
      attribute :hops, HopCount, sets: true
      attribute :role, RoleRef
      attribute :repo, RepoPath
      attribute :brief, BriefText

      given("the request is under the hop limit") { hops.value < 3 }

      emits "SubmissionReviewRequested"
    end

    command "Judge" do
      role "System"
      goal "Record whether the failing spec is a real bug or a stale expectation"

      reference_to SubmissionReview
      attribute :judgment, Judgment, sets: true

      given("the judgment is one the reviewer gives") do
        judgment.value == "real_bug" || judgment.value == "stale_expectation"
      end

      emits "SpecFailureJudged"
    end

    # A real bug is not fixed by an agent's say-so. A person looks at it.
    command "HandToPerson" do
      role "System"
      goal "Hand a real bug to a person instead of letting an agent fix it"

      reference_to SubmissionReview
      attribute :judgment, Judgment

      emits "HandedToPerson"
    end

    query "Reviews" do
      description "Every submission review, by commit: the judgment once the reviewer has given it."
      order_by :submission
    end

    policy "RealBugGoesToAPerson" do
      on      "SubmissionReview.SpecFailureJudged"
      where   { judgment.value == "real_bug" }
      trigger SubmissionReview::HandToPerson
    end
  end

  # The planner. The owner gives it a goal; its session drafts a plan of Work items and asks which
  # options to take. It creates items only after the owner confirms, so this aggregate only asks.
  aggregate "Planning" do
    description "One request to the planner role: a goal to turn into a plan of Work items, with the checkout it reads."

    identified_by :plan

    attribute :plan, PlanKey
    attribute :goal, GoalText, optional: true

    value_object "PlanKey" do
      attribute :value, String, matches: :present
      invariant("a planning request has a key") { !value.to_s.empty? }
    end

    value_object "GoalText", String

    value_object "RoleRef", String

    value_object "RepoPath", String

    command "Request" do
      role "Maintainer"
      goal "Ask the planner to turn a goal into a plan of Work items"

      attribute :plan, PlanKey, sets: true
      attribute :goal, GoalText, sets: true
      attribute :role, RoleRef
      attribute :repo, RepoPath

      given("the goal says something") { goal.value != "" }

      emits "PlanningRequested"
    end

    query "Requests" do
      description "Every planning request, by key."
      order_by :plan
    end
  end

  # The orchestrator. Routing is a rule first: a Work item with no conflict is routed at once and no
  # agent is asked. Only a conflicting item asks for advice, and that ask carries the hop limit.
  aggregate "Routing" do
    description "One Work item's routing: checked for a conflict, routed by rule when there is none, and sent for advice when there is."

    identified_by :work

    attribute :work, WorkKey
    attribute :conflict, Conflict, optional: true
    attribute :hops, HopCount, optional: true

    value_object "WorkKey" do
      attribute :value, String, matches: :present
      invariant("a routing names its Work item") { !value.to_s.empty? }
    end

    value_object "Conflict", String

    value_object "HopCount", Integer

    # The key of the orchestrator's run, so it never collides with another run for the same Work item.
    value_object "AdviceKey", String

    value_object "RoleRef", String

    value_object "RepoPath", String

    # What the orchestrator is asked: the Work item and the conflict, in words.
    value_object "BriefText", String

    # `conflict` is "yes" when the item spans several areas or overlaps another session's.
    command "Check" do
      role "System"
      goal "Check one Work item for a conflict before routing it"

      attribute :work, WorkKey, sets: true
      attribute :conflict, Conflict, sets: true
      attribute :hops, HopCount, sets: true
      # The key the orchestrator's run takes when the check finds a conflict: without it no session could start.
      attribute :advice, AdviceKey
      attribute :role, RoleRef, optional: true
      attribute :repo, RepoPath, optional: true
      attribute :brief, BriefText, optional: true

      given("the check is under the hop limit") { hops.value < 3 }

      emits "WorkChecked"
    end

    command "Route" do
      role "System"
      goal "Route a Work item that has no conflict, by rule"

      reference_to Routing
      attribute :conflict, Conflict
      attribute :hops, HopCount

      emits "WorkRouted"
    end

    command "AskAdvice" do
      role "System"
      goal "Ask the orchestrator role for advice on a Work item that conflicts"

      reference_to Routing
      attribute :conflict, Conflict
      attribute :hops, HopCount
      attribute :advice, AdviceKey, optional: true
      attribute :role, RoleRef, optional: true
      attribute :repo, RepoPath, optional: true
      attribute :brief, BriefText, optional: true

      emits "DispatchAdviceRequested"
    end

    policy "RouteWhenNoConflict" do
      on      "Routing.WorkChecked"
      where   { conflict.value == "no" }
      trigger Routing::Route, with: { conflict: :conflict, hops: :hops }
    end

    policy "AskAdviceWhenConflict" do
      on      "Routing.WorkChecked"
      where   { conflict.value == "yes" }
      trigger Routing::AskAdvice, with: {}
    end
  end

  # The release manager only recommends. Promotion stays a person's command, confirmed on the board.
  aggregate "PromotionRecommendation" do
    description "A release manager's recommendation to promote one change once main is green on it, with its reasons. It never promotes: the owner confirms."

    identified_by :change

    attribute :change, ChangeRef
    attribute :reasons, Reasons, optional: true
    attribute :role, RoleRef, optional: true
    attribute :repo, RepoPath
    attribute :brief, BriefText, optional: true

    value_object "ChangeRef" do
      attribute :value, String, matches: :present
      invariant("a recommendation names a change") { !value.to_s.empty? }
    end

    value_object "Reasons", String
    value_object "RoleRef", String
    value_object "RepoPath", String
    value_object "BriefText", String

    lifecycle :status, default: "recommended" do
      transition "Settle" => "settled", from: "recommended"
    end

    command "Recommend" do
      role "System"
      goal "Recommend promoting one green change, with the reasons"

      attribute :change, ChangeRef, sets: true
      attribute :reasons, Reasons, sets: true
      attribute :role, RoleRef, optional: true, sets: true
      attribute :repo, RepoPath, sets: true
      attribute :brief, BriefText, optional: true, sets: true

      emits "PromotionRecommended"
    end

    # The owner has dealt with it: promoted the change, or set the recommendation aside.
    command "Settle" do
      role "Maintainer"
      goal "Settle a recommendation once the owner has promoted the change or set it aside"

      reference_to PromotionRecommendation

      emits "PromotionSettled"
    end

    query "Recommendations" do
      description "Every promotion the release manager recommends, by change, settled or not."
      order_by :change
    end

    query "Open" do
      description "The recommendations still waiting on the owner, by change."
      where(status: "recommended")
      order_by :change
    end
  end

  # The pruner removes finished sessions. The bluebook gives: a pruner is woken only from rest, so a
  # second wake while one works is refused by the lifecycle, and the end of its run rests it again.
  # The policies state: any run but the pruner's own ending (a job read that shows done or stopped)
  # wakes it, so its finish never loops. The delegate bluebook starts a woken pruner as a run of the
  # `pruner` agent, since a policy here cannot reach AgentRun; the reaction mints the run key. A
  # role's `starts` field would replace the literals in the first policy.
  aggregate "Pruning" do
    description "The pruner role's standing: resting, or working on one dispatched run, so a second pruner is never started while one works."

    identified_by :role

    attribute :role, PrunerRole
    attribute :repo, PrunerRepo, optional: true
    attribute :brief, PrunerBrief, optional: true

    value_object "PrunerRole" do
      attribute :value, String, matches: :present
    end

    value_object "PrunerRepo", String
    value_object "PrunerBrief", String

    lifecycle :status, default: "resting" do
      transition "Wake" => "working", from: "resting"
      transition "Rest" => "resting", from: "working"
    end

    # The first finished run seats the pruner; a seat that exists is refused, which is its answer.
    command "Seat" do
      role "System"
      goal "Seat the pruner so it can be woken"

      attribute :role, PrunerRole, sets: true

      emits "PrunerSeated"
    end

    command "Wake", from: "resting" do
      role "System"
      goal "Wake the pruner for one run, unless it is already working"

      reference_to Pruning
      attribute :repo, PrunerRepo, sets: true
      attribute :brief, PrunerBrief, sets: true

      emits "PrunerWoken"
    end

    command "Rest", from: "working" do
      role "System"
      goal "Record that the pruner's run ended, so it may be woken again"

      reference_to Pruning

      emits "PrunerRested"
    end

    policy "SeatThePrunerWhenARunFinishes" do
      on      "AgentRun.JobRead"
      root
      where   { (state == "done" || state == "stopped") && previous != state && agent != "pruner" }
      trigger Pruning::Seat, with: { role: "pruner" }
    end

    policy "WakeThePrunerWhenARunFinishes" do
      on      "AgentRun.JobRead"
      root
      where   { (state == "done" || state == "stopped") && previous != state && agent != "pruner" }
      trigger Pruning::Wake,
              with: { pruning: "pruner", repo: ".",
                      brief: "List the sessions and remove the finished ones that are safe to remove. " \
                             "Leave any that is working or blocked, and report what was refused." }
    end

    policy "RestThePrunerWhenItsRunEnds" do
      on      "AgentRun.JobRead"
      root
      where   { (state == "done" || state == "stopped" || state == "failed") && previous != state && agent == "pruner" }
      trigger Pruning::Rest, with: { pruning: "pruner" }
    end
  end
end
