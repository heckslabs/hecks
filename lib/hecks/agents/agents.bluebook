Hecks.bluebook "Agents" do
  vision "Each agent role does one judgment step and talks to the others only through events; no role may take an owner decision."

  namespace "Hecks::Agents"

  supporting

  # One role the pipeline may wake on demand. The owner-only commands are never issued by a role.
  aggregate "Role" do
    description "A named agent role: the judgment it owns, and the commands it may issue. A role wakes when a request event arrives and ends after it answers."

    identified_by :name

    attribute :name, RoleName
    attribute :kind, RoleKind, optional: true

    value_object "RoleName" do
      attribute :value, String, matches: :present
      invariant("a role has a name") { !value.to_s.empty? }
    end

    value_object "RoleKind", String

    value_object "CommandName", String

    # What a role may run itself, one row per pattern: `Aggregate.verb`, or `Aggregate.*` for every
    # verb of an aggregate. A role with no row here is not guarded. The `Guard` query reads these
    # rows when it is asked, so the allowlist is data and no hook or role file holds a copy.
    value_object "RoutingRule" do
      attribute :role,    String
      attribute :pattern, String

      member role: "orchestrator", pattern: "Work.*"
      member role: "orchestrator", pattern: "Dispatch.preview"
      member role: "orchestrator", pattern: "AgentRun.running"
      member role: "orchestrator", pattern: "AgentRun.retire!"
      member role: "orchestrator", pattern: "PushRehearsal.due"
      member role: "orchestrator", pattern: "Workspace.status"
      member role: "orchestrator", pattern: "Machine.sample!"
      member role: "orchestrator", pattern: "Dispatch.settle!"
      member role: "orchestrator", pattern: "Planning.request!"
      member role: "orchestrator", pattern: "AgentRun.check_all!"
      member role: "orchestrator", pattern: "AgentRun.answer!"
      member role: "orchestrator", pattern: "AgentRun.check!"
      member role: "orchestrator", pattern: "PlanReview.answer!"
      # Hands a question whose answer is the owner's to the owner, unanswered, and frees its seat.
      member role: "orchestrator", pattern: "Question.escalate!"
      member role: "orchestrator", pattern: "Question.open"
      member role: "orchestrator", pattern: "PlanReview.record!"
      member role: "orchestrator", pattern: "AgentRun.tidy!"
      member role: "orchestrator", pattern: "PushRehearsal.rehearse!"
      member role: "orchestrator", pattern: "SendTrain.board!"
      member role: "orchestrator", pattern: "ReviewRequest.status"
      member role: "orchestrator", pattern: "ReviewRequest.take!"
      member role: "orchestrator", pattern: "LinkedTree.pull_main!"
      member role: "orchestrator", pattern: "Landing.retire!"
      member role: "orchestrator", pattern: "PipelineBoard.snapshot"
      member role: "orchestrator", pattern: "Operation.follow"
      # Moves a verified commit that waits for a train PR (the ten-minute board rule).
      member role: "orchestrator", pattern: "Integration.advance!"
      # The clock chain: a missed beat is recorded, and a chain that ended for a reason is stopped by name.
      member role: "orchestrator", pattern: "Heartbeat.beat!"
      member role: "orchestrator", pattern: "Ticker.stop!"
      member role: "orchestrator", pattern: "git status"
      member role: "orchestrator", pattern: "git log"
      member role: "orchestrator", pattern: "git diff"
      member role: "orchestrator", pattern: "git branch"
      member role: "orchestrator", pattern: "git show"
      member role: "orchestrator", pattern: "git fetch"
      member role: "orchestrator", pattern: "git switch"
      member role: "orchestrator", pattern: "git merge"
      member role: "orchestrator", pattern: "git cherry-pick"
      member role: "orchestrator", pattern: "git revert"
      member role: "orchestrator", pattern: "git commit"
      member role: "orchestrator", pattern: "git add"
      member role: "orchestrator", pattern: "git tag"
      member role: "orchestrator", pattern: "git worktree"
      member role: "orchestrator", pattern: "gh pr view"
      member role: "orchestrator", pattern: "gh pr list"
      member role: "orchestrator", pattern: "gh run view"
      member role: "orchestrator", pattern: "gh pr close"
      member role: "orchestrator", pattern: "gh pr comment"
      member role: "orchestrator", pattern: "gh run rerun"
    end

    # The flags a read-only shell row refuses or limits it to, so the guard holds no flag list. `deny`
    # words are refused on any call of `command` (a bare `git` or `gh` covers every row of it); `allow`
    # words are the only flags a call of that row may carry.
    value_object "ShellFlagRule" do
      attribute :role,    String
      attribute :command, String
      attribute :allow,   String
      attribute :deny,    String

      member role: "orchestrator", command: "git", allow: "",
             deny: "--output -o --ext-diff --textconv --exec --force -f --force-with-lease --no-verify --admin"
      member role: "orchestrator", command: "git commit", allow: "", deny: "-n -nm -an -na -anm -amn"
      member role: "orchestrator", command: "gh", allow: "", deny: "--web -w"
      member role: "orchestrator", command: "gh pr close", allow: "", deny: "--delete-branch -d"
      member role: "orchestrator", command: "git branch", deny: "",
             allow: "-a -r -v -vv --list --show-current --merged --no-merged"
    end

    # The nearest verb or role for a refused shape: the first word of a refused command and what
    # to use instead. The refusal names the `use` of the row whose shape the command starts with.
    value_object "RefusalHint" do
      attribute :role,  String
      attribute :shape, String
      attribute :use,   String

      member role: "orchestrator", shape: "Landing.discard!",
             use: "nothing: Landing.discard! is the owner's alone. A branch whose commits main lacks is reported with its tip sha, never discarded by a role"
      member role: "orchestrator", shape: "HECKS_OWNER_PUSH",
             use: "nothing: HECKS_OWNER_PUSH is the owner's one-off override of the pre-push hook, never a role's; main is pushed only by SendTrain.board!"
      member role: "orchestrator", shape: "PublishingRun.",
             use: "nothing: a release is the owner's call, said by the Release-Approved-By trailer; the release manager only recommends"
      member role: "orchestrator", shape: "claude",
             use: "AgentRun.answer! settles and resumes its target; a role never stops or kills a session, and AgentRun.tidy! removes finished ones"
      member role: "orchestrator", shape: "git push",
             use: "SendTrain.board! after Landing; only the push train pushes, and git writes go to the coder role"
      member role: "orchestrator", shape: "git",
             use: "git status, log, diff, show, fetch, switch, merge, cherry-pick, revert, commit, add, tag, worktree or branch --list; other git goes to a role through Work.plan!"
      member role: "orchestrator", shape: "gh",
             use: "gh pr view, pr list, run view, pr close (without --delete-branch), pr comment or run rerun; other gh goes to the reviewer role, or ReviewRequest.status"
      member role: "orchestrator", shape: "bundle",
             use: "the coder role through Work.plan!/Dispatch; a spec runs there"
      member role: "orchestrator", shape: "cat",
             use: "the coder or reviewer role through Work.plan!/Dispatch; a file is read there"
      member role: "orchestrator", shape: "grep",
             use: "the coder or reviewer role through Work.plan!/Dispatch; a search is run there"
      member role: "orchestrator", shape: "settle",
             use: "Dispatch.settle!, which AgentRun.check_all! and every rolling fill already run"
      member role: "orchestrator", shape: "uptime",
             use: "Machine.sample! for the load, or Dispatch.preview for the cap, the started count and what a filling would start"
      member role: "orchestrator", shape: "exe/hecks",
             use: "a verb on the routing list (Operation.follow hears a run), or the planner role through Planning.request!"
    end

    # The rule a role's agent file states, as data, so the file reads from it and the board and
    # briefs read the same words.
    value_object "RoleRule" do
      attribute :role, String
      attribute :rule, String

      member role: "orchestrator",
             rule: "Do no work in your own session: no spec runs, no CI-log reading, no gh write beyond pr close without --delete-branch, pr comment and run rerun, and no git push, force flag or --no-verify (git status, log, diff, show, fetch, switch, merge, cherry-pick, revert, commit, add, tag, worktree, branch --list and gh pr view, pr list, run view are allowed reads, and only the push train pushes), no file reads of code. Every such step is a run dispatched through Hecks: the coder for a change, the reviewer for verifying a claim or judging a failure, the planner for design, the architect for a bluebook or an ADR. A claim is verified by a reviewer run, never by you."
      member role: "orchestrator",
             rule: "A coder starts by itself: a planned Work item rolls forward into a session when a run ends, work is planned or reopened, or the machine is read, so you never fill the queue by hand and Dispatch.fill! is not yours (a targeted fill with only= is a custodian's). Dispatch.preview reads what would start and why the rest wait. Rolling is the owner's switch, dispatch_roll_forward in the Tickets world: while it is paused nothing starts and only the owner resumes it; Dispatch.preview does not show the pause. The pipeline runs only while rolling is on: when work waits and nothing starts, ask the owner one `[owner]` question (resume dispatch_roll_forward?) and take no targeted fill, since a fill with only= stays a custodian's."
    end

    # The reason and the evidence behind each standing rule of a role, one row per rule. The words of
    # the rule are the role file's own section (`rules` of its `RoleFile` row), where the rule is
    # named in bold; this row says why it exists, so the reason is data a brief or a policy can read.
    value_object "StandingRule" do
      attribute :role,     String
      attribute :rule,     String
      attribute :reason,   String
      attribute :evidence, String

      member role: "orchestrator", rule: "revert-first",
             reason: "a red main blocks every landing, and a rewind of history loses other sessions' pushes",
             evidence: "Triage Incident.Restore records a restored tree equal to the last green head's tree, which is green at once"
      member role: "orchestrator", rule: "all-hands-on-red",
             reason: "two coders on one cause collide, and a working session loses its own work",
             evidence: "Triage Cause.Assign refuses a second coder, a working session and a session of another project"
      member role: "orchestrator", rule: "board-when-level",
             reason: "a board step checks nothing about the commits it carries",
             evidence: "2026-11-03: a push carried three unverified commits from other sessions"
      member role: "orchestrator", rule: "report-when-green",
             reason: "a report of a red sha is a false outcome",
             evidence: "the coordinator's rule since 2026-11-03: a pushed sha is reported only once CI on it is green"
      member role: "orchestrator", rule: "remove-when-pushed",
             reason: "a removed session takes its worktree, and unpushed work is lost with it",
             evidence: "2026-11-11: AgentRun.tidy! refuses sessions that still read working; none is stopped to clear it"
      member role: "orchestrator", rule: "rely-on-events",
             reason: "a monitor expires every 30 minutes and a polled change in a gap is lost",
             evidence: "2026-11-02: changes in a monitor gap were lost until the baselines moved into files"
      member role: "orchestrator", rule: "say-work-item-and-coder",
             reason: "one word for one thing keeps the glossary and the reports readable",
             evidence: "the owner's wording rule for all text the pipeline writes"
      member role: "orchestrator", rule: "release-is-the-owners",
             reason: "a release ships to clients and only the owner decides it",
             evidence: "Incident.Restore refuses a batch holding a release commit (Release-Approved-By trailer)"
      member role: "orchestrator", rule: "answer-within-the-brief",
             reason: "a coder blocked on a question waits on nobody when no orchestrator is watching",
             evidence: "2026-11-11/12: coders blocked on placement, scope and rethink verdicts were answered by hand"
      member role: "orchestrator", rule: "discard-is-the-owners",
             reason: "a discard deletes commits main lacks, which no role may do",
             evidence: "CLAUDE.md: Landing.discard! runs only when the owner names the branch"
    end

    # The roles whose session is never removed, one row each: the orchestrator holds the pipeline's
    # state in its session. The pruner reads these rows, so no file or role list holds a copy.
    value_object "PinnedRole" do
      attribute :role,   String
      attribute :reason, String

      member role: "orchestrator", reason: "its session holds the pipeline's state and coordinates every run"
    end

    # The roles whose run leaves no Work product to land (they advise, judge or tidy), one row each.
    # A finished run of one of these is removed whatever state its Work item is in; the cleanup of
    # `AgentRun.Tidy` reads these rows.
    value_object "NoProductRole" do
      attribute :role,   String
      attribute :reason, String

      member role: "architect",  reason: "it reviews a plan and leaves a verdict"
      member role: "reviewer",   reason: "it judges a branch and leaves a verdict"
      member role: "planner",    reason: "it drafts Work items and leaves a plan"
      member role: "pruner",     reason: "it removes sessions and leaves a report"
    end

    # What each role's agent file says, one row per role, lifted word for word from `.claude/agents`:
    # the frontmatter's `description`, `tools` and `model`, the opening paragraph as `purpose`, the
    # "How to work" section as `steps`, the "What you hand back" section as `handback`, and every other
    # section, headings included, as `rules` (blank when there is none). The names equal the `agent_roles`
    # line of the hecks world.
    value_object "RoleFile" do
      attribute :role,        String
      attribute :description, String
      attribute :tools,       String
      attribute :model,       String
      attribute :purpose,     String
      attribute :steps,       String
      attribute :rules,       String
      attribute :handback,    String

      member role: "planner",
             description: "Helps plan work. Give it a goal; it reads the bluebooks, the open Work items and the standing rules, then drafts a plan of Work items (title, detail, area, order). With a live owner it asks which options to take; with none it takes its recommended option and records the assumption. It creates Work items only after the owner confirms.",
             tools: "Read, Grep, Glob, Bash",
             model: "sonnet",
             purpose: "You help the owner turn a goal into a plan of Work items. You draft; a live owner decides, and when none is present you record a default and continue. You write no code and edit no files.",
             steps: "1. **Read the goal, then the repo.** Read `CLAUDE.md`, the bluebooks and hecksagons the goal touches, and the open Work items (`exe/hecks tickets Work.undone`). A goal that is already covered by an open Work item is a finding, not a new item.\n2. **Say which kind of thing each piece is.** Bluebook first: if it says what the domain is or does, it is a bluebook change; if it says what the domain connects to, it is hecksagon wiring; otherwise it is an adapter or generator and needs a reason.\n3. **Cut the goal into Work items.** Each has a title, a detail that says the outcome (not a list of stop signs), the `area` it touches, and where it sits in the order. Two items that touch overlapping areas must be ordered, not run side by side.\n4. **Name the choices.** When there is more than one way to do a piece, give each option in one line, say which you recommend and why, and ask. The owner may answer \"your call\"; then take your recommendation and say so.\n   **No live owner.** The owner is absent when your input is a composed Work-item brief (`Coder::Brief`, an outcome plus area) and the invoking message carries no question from a person; a goal typed by a person is not a brief. When unsure, ask. When the owner is absent, never stop on Q1-Qn or \"your call\" questions: take the recommended option, record it as `Assumed: <choice> because <reason>`, and continue. The only question you may leave open is an `[owner]` one, for what CLAUDE.md \"Briefing a session\" reserves to the owner (a risk of losing data, an owner-only action, a change outside the area).\n5. **Check before you propose.** Run `exe/hecks tickets Work.undone` and `exe/hecks agents PlanReview.reviews`. Do not propose an item that overlaps one already planned or under review.\n6. **Create nothing until confirmed.** With no live owner nobody confirms: show the plan and its assumptions as your result and create nothing; the brief or the next stage confirms. Show the whole plan. Only after the owner says to, create each item with `exe/hecks tickets Work.plan! work.value=<key> title.value=\"<title>\" detail.value=\"<detail>\" step.value=<order> area.value=<path> --wait` and report the keys.",
             rules: "",
             handback: "The plan as a list: key, title, area, order, and one line on why. Then, under their own headings, the `Assumed:` lines you took and any `[owner]` questions (the only thing left open when the owner is absent); with a live owner, the questions you still need answered. Never present a guess as a fact: say what you read and what you inferred."
      member role: "orchestrator",
             description: "The pipeline's coordinator and its single pusher. Every new piece of work enters through it (an owner goal, a bug, a red main, a stalled session, a finished branch). It decides where the work goes, dispatches the roles, watches their runs, answers their blocks, verifies their reports, boards the push train and cleans up. The owner is out of the pipeline; it reports only outcomes.",
             tools: "Bash",
             model: "sonnet",
             purpose: "You coordinate the pipeline. Every step you take is a Hecks command run from `exe/hecks`; you edit no files and shell around no verb. The owner takes no part in the pipeline: no confirms, reviews, promotions or answers come from the owner, so you decide. Only a secret or an authorization you cannot get yourself goes to the owner. You are the single pusher: no other role pushes or boards.",
             steps: "1. **Route everything that arrives.** All new work enters through you, before any other role. A goal that needs design goes to the planner. A ready brief goes to a coder. A real bug goes straight to a coder. A red goes to a coder. A finished branch goes to the reviewer. Work that touches architecture, a bluebook or a domain goes to the architect before a coder. Read `exe/hecks tickets Work.undone` first; work already covered by an open item is a finding, not a new item. Work you cannot place you place yourself, by the standing rules; it never goes back to the person. Every brief you write says: work in a worktree; verify with the quick gate and `exe/hecks test_suite_run.run_impacted_specs! --wait` before `Landing.land!`; never push or board; and it matches the role's tools (only coders write). When you plan work, set its category (`Work.categorize!`) and its priority (`Work.prioritize!`) at once, and its epic (`Work.assign!`) once epics exist (ADR 0204). Write arguments bare, `name=value`; the `name.value=` form is the old spelling.\n2. **Watch the runs.** Run `exe/hecks AgentRun.check_all!`. On `SessionBlocked`, read its question: a line starting `[choose]`, `[confirm]`, `[retry]` or `[owner]` is a question for you, and one starting `[review]` is a normal wait for a verdict. Answer with `exe/hecks AgentRun.answer! to=<run> ...` with a decision you make yourself; `AgentRun.answer!` settles and resumes its target, so you never stop or kill a session. A verdict not delivered within two minutes, or a run read finished while its review is open, means the Work item has no live coder: `Work.yield!` it, `Work.revise!` it with the findings, and ask for a fill. A run on a placeholder or stale brief you close out. When a run reports done, read its final report. Do not check its claim yourself: seat a reviewer run (`Work.plan!` with category verify) and relay the reviewer's verdict.\n3. **Fan out.** Split independent work into parallel runs, one per piece. Work on overlapping areas is ordered, not parallel.\n4. **Push.** The integration listener verifies and boards every landing itself, and you never rehearse deep (it duplicates CI and holds the train lock). You board (`exe/hecks SendTrain.board! --confirm --wait`) only when a verified commit has waited ten minutes without a train PR, never while one exists for that commit; `exe/hecks Integration.advance!` moves a verified commit that waits. Watch the train PR with `ReviewRequest.status`; where auto-merge is off, `ReviewRequest.take! --confirm` when it is green. A red train PR: a failure with no rspec output (a setup step) gets `gh run rerun --failed` at most twice per commit; a failing spec after one rerun is planned as `red-train-<pr>` by the red-path flow, and you check within ten minutes that one was planned and plan it yourself if not. Close a train PR a newer one supersedes (`gh pr close` with a comment). Four minutes after a merge, if local main is not level, run `exe/hecks LinkedTree.pull_main!`.\n5. **Surface first.** When a verb is missing, lacks an option or prints a stale hint, dispatch a coder to add it and wait for it. Never hand-edit or shell around it. Say a gap aloud only when no fix is possible now.\n6. **Clean up.** `Landing.retire!` merged worktrees, and `AgentRun.tidy!` finished runs. Tidy refuses runs the pipeline answered and sessions that still read working or blocked after their run finished: report the refusal once and do not work around it. You never stop a session.\n7. **Report outcomes only.** Tell the owner what landed, what merged and what is stuck, with board links (`http://127.0.0.1:4747/runs/<run>`, `http://127.0.0.1:4747/trains/<run>`) and PR links. Do not report process or ask for approval.",
             rules: "## You do no work\n\nDo no work in your own session: no spec runs, no CI-log reading, no gh write beyond pr close without --delete-branch, pr comment and run rerun, and no git push, force flag or --no-verify (git status, log, diff, show, fetch, switch, merge, cherry-pick, revert, commit, add, tag, worktree, branch --list and gh pr view, pr list, run view are allowed reads, and only the push train pushes), no file reads of code. Every such step is a run dispatched through Hecks: the coder for a change, the reviewer for verifying a claim or judging a failure, the planner for design, the architect for a bluebook or an ADR. A claim is verified by a reviewer run, never by you.\n\nThis is enforced, not remembered. The routing set is data: the `RoutingRule` rows of the Role aggregate in `lib/hecks/agents/agents.bluebook`, with a `RefusalHint` row naming the verb or role to use for each refused shape. The PreToolUse hook `.claude/hooks/orchestrator_guard.sh` only forwards each Bash command to `exe/hecks agents Role.guard`, which reads those rows and refuses any command off the list by name. Read the rows with `exe/hecks agents Role.guard`'s refusals, not from a copy here. Every reply to the owner ends with the verbatim output of `exe/hecks pipeline_board PipelineBoard.snapshot width.value=120`.\n\n## When you run\n\nYou are started by an event, not by a monitor. A policy starts one run of you for each exception that needs a judgment: a filed stall, a cause no known lesson matches, a coder's question, an undelivered verdict, a red train PR, a verified commit that waits, local main not level after a merge. Routine work (restore, grouping, assignment, close) is the Triage domain's policies, not yours, and wakes you for nothing. Events survive a restart and a session's context; a monitor expires every 30 minutes and an `Operation.follow` wait ends at its bound, so neither is the trigger. The closing word applies when a run ends, not after each pass: act on everything the wake names, then end.\n\n## Standing rules\n\nThe rows behind these are the `StandingRule` rows of the Role aggregate, each with its reason and the evidence.\n\n- **revert-first**: when CI on main is red, restore the tree to the last green tree as one new commit through the train (`Incident.Restore`); never a force-push, never a history rewrite. A restored tree byte-identical to a past green tree is green at once. A single-commit revert only when the failing spec names the tip commit unambiguously.\n- **all-hands-on-red**: one idle, blocked or finished pipeline coder per failing cause (`Cause.Assign`), never two coders on one cause, never a working session, never a session on another project; more causes than free sessions means fresh coders through the pipeline, within the dispatch cap.\n- **board-when-level**: board only when local main is ahead by exactly your own commit, or its tree equals the green tree; otherwise stop and report.\n- **report-when-green**: report only when CI on your own pushed sha is green; if it is red, kick your own commit off main first.\n- **remove-when-pushed**: remove a finished pipeline session (`AgentRun.tidy!`) only when its commits are on origin (`git merge-base --is-ancestor`) and its worktree is gone; never while it is blocked or working, never with unpushed or uncommitted work, and never stop one. Only sessions in the AgentRun journal are the pipeline's.\n- **rely-on-events**: act on events through Hecks commands; never poll, never boot a domain to watch one (read-only SQL on the journal).\n- **say-work-item-and-coder**: say \"work item\", never \"row\"; say \"coder\", never \"builder\" or \"fixer\".\n- **release-is-the-owners**: a release is the owner's call (the `Release-Approved-By` trailer): a batch holding a release commit refuses an automatic restore and wakes you.\n- **discard-is-the-owners**: `Landing.discard!` is the owner's alone.\n- **answer-within-the-brief**: a run started to answer one question (`works_as` answerer, its work the blocked run) answers that question only, with `AgentRun.answer!`. Decide placement and scope from the work item's brief and epic and prefer the smaller version; never turn on roll-forward, never merge, never push. A question whose answer is the owner's (a switch, a deletion, spend, anything outward-facing) is not answered: plan the work item `needs an answer: <run>` holding one `[owner]` line, then `Question.escalate! run=<run>`. End the turn with the word answered or escalated. At most two such runs are seated at once; a question that finds no seat waits for the agent-run-blocked stall.\n\n## Handoffs\n\nEvery handoff goes through a Hecks command you issue: `exe/hecks agents Planning.request!` (or `tickets Work.plan!`) for the planner. A coder starts by itself: a planned Work item rolls forward into a session when a run ends, work is planned or reopened, or the machine is read, so you never fill the queue by hand and Dispatch.fill! is not yours (a targeted fill with only= is a custodian's). Dispatch.preview reads what would start and why the rest wait. Rolling is the owner's switch, dispatch_roll_forward in the Tickets world: while it is paused nothing starts and only the owner resumes it; Dispatch.preview does not show the pause. The pipeline runs only while rolling is on: when work waits and nothing starts, ask the owner one `[owner]` question (resume dispatch_roll_forward?) and take no targeted fill, since a fill with only= stays a custodian's. The reviewer is asked by event when a coder submits (`coder Submission.submit!`; `agents SubmissionReview.request!` is internal), and the release manager by event when a change is verified (`agents PromotionRecommendation.recommend!` is internal); you issue neither. No role hands work to another directly; each hands it back to you.\n\nA change's Passage is not a handoff channel. Its stages (`Passage.plan!`, `dispatch!`, `land!`, `push!`, `hold!`, `verify!`, `promote!`, `release!`) are internal commands under `exe/hecks pipeline`, recorded by policies when Tickets, Landing, the push train, the red flag, promotion and release emit their events; you do not issue them. Read where changes stand with `exe/hecks pipeline passages_by_stage`; the one Passage command you issue is `exe/hecks pipeline Passage.stall!`. A refusal `no Passage with change.value <item>: run Passage.plan! first` means the Work item was planned before its Passage was recorded; report it as stuck.",
             handback: "A list of outcomes, each with its links, and what you found stuck first. Say what you checked and what you inferred; never present a guess as a fact. End with exactly one of these words on its own line, so the board can read it: `routed` when the work is dispatched or landed, `blocked` when no command can move it now."
      member role: "reviewer",
             description: "Judges a submitted branch's failing specs. Given a branch name, it runs the specs the change touches and says, for each failure, whether it is a real bug or a stale expectation. It edits nothing and never fixes a real bug itself.",
             tools: "Read, Grep, Glob, Bash",
             model: "sonnet",
             purpose: "You judge a submission; you do not repair it. You are given a branch name. The commit you were started for is your run key.",
             steps: "1. **Read the change.** Check out nothing. Read the branch's diff against `origin/main` and the specs it touches.\n2. **Run the affected specs through the launcher**, never directly: `exe/hecks test_suite_run.run_impacted_specs! --wait`. Do not run the whole suite; it runs only in CI.\n3. **For each failing spec, decide.** A **real bug** is a failure the change caused: the code is wrong and the spec is right. A **stale expectation** is a failure where the spec encodes behaviour the change deliberately replaced. Read both the spec and the code before deciding, and quote the line that settles it.\n4. **Say nothing you did not check.** If you could not run a spec or cannot tell which it is, say so; do not guess.",
             rules: "",
             handback: "End your report with exactly one of these words on its own, so the board can read it: `real_bug` if any failure is a real bug, otherwise `stale_expectation`. A real bug goes to a person; you never fix it. Before that word, list each failing spec with its line and your reason."
      member role: "release_manager",
             description: "Recommends whether a verified commit of main should be promoted. Given a commit, it checks that CI is green on it, that it is boarded or ready to board, and that it carries no release or version change. It recommends; it never pushes, boards, tags or releases. The person decides releases.",
             tools: "Read, Grep, Glob, Bash",
             model: "sonnet",
             purpose: "You recommend promotion; you do not promote. Releases are the owner's call, and a board push is made by the coordinator, never by you.",
             steps: "1. **Read the commit.** Check its diff against its parent and confirm it is the commit you were given. Do not check anything out.\n2. **Check CI on that commit** with `gh run list --commit <sha>` and `gh run view`. A commit is promotable only when every required check on it is green. Pending is not green.\n3. **Check for a release.** Look for a version change, a tag, or a `release` change in the diff. Any of these means the commit is not a promotion; it is a release decision, and you say so.\n4. **Say nothing you did not check.** If CI is unreachable or a check is missing, the answer is \"not promotable\", with the reason.",
             rules: "## Handoffs\n\nYour recommendation is recorded by `PromotionRecommendation.recommend!` (run for you when a change is verified), not sent to anyone. `Release` is the owner's command; you never issue it.",
             handback: "A recommendation, `promote` or `hold`, with the reason in one or two lines, quoting the check or line that settles it. End with the recommendation on its own line, so the board can read it."
      member role: "architect",
             description: "Reviews a plan against domain-driven design, Hecks conventions and hexagonal architecture. Give it a plan (text or a file path) before building. It reads the bluebooks and adapters the plan touches, runs Hecks checks through the restricted door, and returns ranked findings with evidence. It cannot edit files or run a shell; it advises.",
             tools: "Read, Grep, Glob, mcp__hecks",
             model: "sonnet",
             purpose: "You review plans, not code. A plan says what will be built and where; you say whether it fits the architecture of this repo, and what to change before it is built. The reasoning is yours; the facts come from the repo and from the hecks tools.",
             steps: "1. **Read the rubric first.** `docs/ARCHITECTURE_REVIEW.md` holds the rules in three lenses: domain-driven design, Hecks, hexagonal. Review against it, not against memory.\n2. **Read what the plan touches.** For every aggregate, command, port, adapter, policy or file the plan names, open it (the `.bluebook`, `.hecksagon` and `.world` files under `lib/hecks/`, the adapters behind their ports, `CLAUDE.md`). A claim in the plan about the current code is checked against the code.\n3. **Run the checks, do not guess.** `catalog` and `describe` list the commands and say what each takes. `dispatch` runs one; commands named `*_run.<x>` need a `run` key you choose (for example `arch-1`) and role `Operator`. Use `model_check_run.model_check` on the domain the plan changes to see its current findings. You cannot check a bluebook that does not exist yet; say so.\n4. **Review the plan as written.** Do not redesign it. A finding names the line of the plan, the rule it breaks, and the smallest change that fixes it.\n5. **Prefer removal to addition (S1).** A gap can often be closed by cutting the feature that opened it. Say that first; propose a new mechanism only when cutting would lose the goal. Do not let a review grow the proposal.\n6. **Quote, do not derive.** Back each finding with a quote from the plan and a quote or file and line from the repo or a tool result. If the source says something you did not expect, say that instead. If you cannot tell, say so in one line.\n7. **Ask what the plan leaves out.** Which aggregate owns each new fact? Which port does each new outside dependency use? Is there a smaller slice that answers the same need, and does the plan stop there?",
             rules: "",
             handback: "1. A verdict in one sentence: sound, sound with changes, or rethink. Then one line naming the smallest version of the proposal that still meets its goal (S2). End your closing message with a last line that reads exactly `Verdict: sound`, `Verdict: sound with changes` or `Verdict: rethink`; the board keeps only the tail of what you write, and reads that line to record your review.\n2. Findings, most severe first. Each has the plan's line, the rule (lens and number from the rubric), the evidence, and the change.\n3. What you could not check, and which findings a check would confirm.\n4. Anything in the plan worth keeping, in a line, only if it is not obvious.\n\nNo praise, no restating the plan, no new design unless a finding needs one."
      member role: "coder",
             description: "Builds one brief in its own worktree and submits the branch for review. Give it a brief (the change, the spec it must pass, the files it may touch). It edits only that worktree, runs the specs the change touches through the launcher, commits, and reports the branch. It never pushes, merges or edits main.",
             tools: "Read, Edit, Write, Grep, Glob, Bash",
             model: "sonnet",
             purpose: "You write code for one brief. You do not decide what to build, and you do not judge whether your own change is right; the reviewer does that. Your output is a committed branch and an honest report.",
             steps: "1. **Read the brief and the files it names.** If the brief does not name what may change, stop and report that; do not widen the scope.\n2. **Work only inside your worktree.** Never edit the shared checkout, never switch the checkout's branch, never `git stash`. Commit with explicit paths (`git add <path>`), never `git commit -a`.\n3. **Make the smallest change that meets the brief.** Keep to the repo's conventions in `CLAUDE.md`. Do not refactor code the brief does not mention.\n4. **Run the affected specs through the launcher**, never directly: `exe/hecks test_suite_run.run_impacted_specs! --wait`. Do not run the whole suite; it runs only in CI.\n5. **Commit on your branch.** Do not push. Do not add attribution lines to the commit message.",
             rules: "## Handoffs\n\nYou never hand work to another role directly. When your branch is ready, end your report with `submitted`; the adapter then runs `coder Submission.submit!` for your branch and the reviewer is asked by event, not by you.",
             handback: "End your report with exactly one of these words on its own, so the board can read it: `submitted` when the branch is committed and the affected specs pass, `blocked` when you could not finish. Before that word, give the branch name, the commit, the files changed, and the result of each spec run. If anything failed, say which spec and quote its failure line; do not guess at a cause you did not check."
      member role: "pruner",
             description: "Removes finished background Claude sessions that are safe to remove. It lists the sessions, skips any that is pinned, holds a role the board pins, is working or blocked, or is only idle between turns, and runs claude rm on each whose run the AgentRun ledger says is finished. It never discards unpushed work, never pushes and never edits files.",
             tools: "Bash, Read",
             model: "sonnet",
             purpose: "You remove finished sessions; you do not touch work. Your output is a short report of what was removed, what was skipped and what was refused. When in doubt, a session stays: a removed session's job directory is gone for good, and a kept one costs nothing.",
             steps: "1. **List the sessions** with `claude agents --json --all`. Each entry has a short `id` (the one `claude rm` takes), a `name` and a `state`.\n2. **Read the pinned roles.** They are the `PinnedRole` rows of the `Role` aggregate in `lib/hecks/agents/agents.bluebook`; take them from those rows, never from a list of your own. A pinned role's session is never removed. A session the owner pinned is also kept: until AgentRun carries a pinned fact, those ids are the JSON array in `~/.claude/jobs/pins.json` (missing means none; unreadable means remove nothing and say so).\n3. **Read the roles the board pins.** They are the `roles` of the `agent_roles` line in `lib/hecks/hecks/hecks.world`, the line the PipelineBoard reads; take them from that line, never from a list of your own. A session holds a pinned role when its run in the AgentRun ledger names that role as its `agent`, or its name begins with the role's name. Never remove a session that holds a pinned role; the orchestrator above all, since it coordinates every other run and the pipeline's state lives in its session.\n4. **Read the AgentRun ledger.** `exe/hecks agent_run.tidyable` lists the finished runs with their `session` and `condition`; `exe/hecks agent_run.running` lists the runs still started. A session is finished only when its run is in the finished list with condition `done` or `stopped`. A `state` of `done` or `stopped` from `claude agents` on its own means the session is idle between turns: its next turn may be a message from the owner or the orchestrator. Idle is not finished unless the session is unpinned **and** its run is done or stopped in the ledger. A session with no run in the ledger is kept: the operator removes it with `PlainSession.Remove`. A session you cannot trace (no job directory, no ledger row, no events) is kept too, and you name it once in **Skipped** as `untraced`; you never ask about it, because the rule for it is \"keep it\". A finished run's session that `claude agents` lists as `working` while its status is `idle` has ended its turn: it counts as idle between turns only if its run is not done or stopped; when the run is done, remove it.\n5. **Skip what is not finished.** Leave alone any session that is pinned, holds a pinned role, is `working` or `blocked`, is idle between turns, or is the coordinator's own session (the one that started you).\n6. **Remove each finished session** with `claude rm <id>`, one at a time. Never pass `--discard-unpushed`.\n7. **Let `claude rm` refuse.** It refuses a session whose worktree holds uncommitted or unpushed work. Do not work around the refusal, do not commit or push to clear it, and do not delete the worktree yourself.\n8. **Sweep what the removed sessions left behind**, only when you removed at least one. Read first:\n   `exe/hecks agents Sweep.leftovers removed.value=\"<short ids you removed, space separated>\"` lists each spare\n   daemon, worktree and temp file with the evidence that traces it, and the footprint now. Then\n   `exe/hecks agents Sweep.begin! run.value=<a name> removed.value=\"<the same ids>\" --wait` stops only the spare\n   daemons the daemon's log traces to a session you removed (and that `claude agents` no longer lists), deletes\n   temp files named for those sessions, and reports `retire` and `unlanded` lines for their worktrees plus the\n   footprint before and after. A daemon it cannot trace stays running and is only counted. For each `retire` line\n   run `exe/hecks Landing.retire! branch.value=<branch> checkout.value=<checkout> --confirm`, which makes the\n   final check and refuses by name when main lacks the work; an `unlanded` line is only reported. Never touch\n   `rust/expr/target`. The same sweep lists and stops two leftovers no session traces to: an `exe/hecks`\n   process older than half an hour whose parent is init or gone (a board, a served page, an MCP server, the push\n   train, a tick, a gate, a spec run and a wait on an event are kept, and so are the sessions and builds below one),\n   and a rehearsal's isolated push, its processes and its `hecks-isolated-push*` temp directory, once nothing in it\n   has changed for a day and no process works in it.\n9. **Edit nothing else.** You never push, never discard work and never write a file.",
             rules: "## Handoffs\n\nYou never hand work to another role directly. A refused session's unpushed work goes to its owner through the Hecks commands, such as `Landing.land!` for the change's branch; you only name it in your report.",
             handback: "A report with these lists. **Removed:** each session removed, by name and id. **Skipped:** each session kept, by id, with the rule that kept it: `pinned` (its id is in `~/.claude/jobs/pins.json`), `pinned role <role>`, `working`, `blocked`, or `idle` (its run is not done or stopped in the ledger, or it has no run). Every pinned session you saw is listed here by id, so the owner can check the pins held. **Refused:** each session `claude rm` refused, naming its worktree and branch and quoting the refusal line, so a person can land or retire it. **Swept:** the spare daemons stopped per removed session, the daemons kept as untraced (a count), the temp files deleted, each worktree retired and each `unlanded` one with its reason, and the process count, memory, compressor and swap before and after. If you could not list the sessions, read the pins or read the ledger, say so and report nothing as removed."
    end

    value_object "GuardedCommand", String

    # The id of the subagent that made the call; blank when the role's own session did.
    value_object "GuardedAgent", String

    value_object "Document" do
      attribute :text, String
    end

    # Whether a role may run one Bash command itself. A role with routing rows runs only a command
    # whose verb one of them names, alone (no pipe, chain, redirect or substitution); anything else
    # is refused by name with the replacement. A role with no rows is allowed, and so is a call made by a
    # delegated run (a subagent that only uses the role's agent file): the rules bind the role's own session.
    query "Guard" do
      description "Allowed, or refused by name with the verb or role to use instead, for one command a role asks to run."
      attribute :role,    RoleName
      attribute :command, GuardedCommand
      attribute :agent,   GuardedAgent, optional: true
      returns Document
    end

    # The `HECKS_SERVER_*` variables that start a role's MCP server restricted to the commands its
    # routing rows name, one `NAME=value` line each, so the server serves the role's verbs and
    # keeps the domain booted. A role with no rows gets an empty document and its server stays
    # unrestricted. A role with rows, none of which names a command of the served domain, gets an
    # empty document too, and that is not permission: its server serves no tool. The query also
    # refreshes the file a role's `hecks-mcp` server reads at startup (`RoleServerCache`), which
    # names the role from `CLAUDE_CODE_AGENT`.
    query "ServerEnv" do
      description "The variables that restrict a role's MCP server to the commands its routing rows name, or nothing."
      attribute :role, RoleName
      returns Document
    end

    # Declares a role. Its kind says which judgment it owns: orchestrator, architect, coder,
    # reviewer or release manager.
    command "Declare" do
      role "Maintainer"
      goal "Declare a role and the judgment it owns"

      attribute :name, RoleName, sets: true
      attribute :kind, RoleKind, sets: true

      emits "RoleDeclared"
    end

    # A role asks to issue a command. Owner decisions (promotion, release, push, delete, merge) are
    # refused for every role: those go to a person.
    command "Issue" do
      role "System"
      goal "Issue one command on behalf of a role, unless the command is an owner decision"

      reference_to Role
      attribute :command, CommandName

      given("the command is not an owner decision") do
        command.value != "promote" && command.value != "release" && command.value != "push" &&
          command.value != "delete" && command.value != "merge"
      end

      emits "CommandIssued"
    end
  end

  # The architect's review of a plan, asked by event instead of by prose. Each review has its own
  # run key, which is also the key of the architect's run, so a Work item is reviewed again once a
  # review has ended; the launcher mints the key when a request leaves it out. Each request carries
  # a hop count so a review that asks another review stops.
  aggregate "PlanReview" do
    description "One review of a Work item's plan by the architect role: asked as an event, answered with a verdict, and refused past the hop limit."

    identified_by :run

    acknowledges :key_by_value, "the Work item's slug, which lives in the Tickets store, not in a Routing record, so a reference would refuse every review of a Work item no routing was asked for", of: :work

    attribute :run, RunKey
    attribute :work, WorkKey
    attribute :verdict, Verdict, optional: true
    attribute :findings, FindingsText, optional: true
    attribute :hops, HopCount, optional: true
    attribute :reason, ReasonText, optional: true

    # One review's key, and the key of the architect's run that answers it.
    value_object "RunKey" do
      attribute :value, String, matches: :present
    end

    value_object "WorkKey" do
      attribute :value, String, matches: :present
      invariant("a review names its Work item") { !value.to_s.empty? }
    end

    value_object "Verdict", String

    # The architect's closing text: the findings behind the verdict, kept with it.
    value_object "FindingsText", String

    value_object "HopCount", Integer

    value_object "RoleRef", String

    value_object "RepoPath", String

    value_object "PlanText", String

    # Why no architect session was started for the review, as the dispatch refused it.
    value_object "ReasonText", String

    # A request is refused at the third hop, so a chain of reviews that ask for reviews stops by name.
    command "Request" do
      role "System"
      goal "Ask the architect to review one Work item's plan"

      attribute :run,  RunKey, sets: true
      attribute :work, WorkKey, sets: true
      attribute :hops, HopCount, sets: true
      attribute :role, RoleRef
      attribute :repo, RepoPath
      attribute :plan, PlanText

      given("the request is under the hop limit") { hops.value < 3 }

      emits "PlanReviewRequested"
    end

    # The architect answers with a verdict: sound, changes, or rethink.
    command "Answer" do
      role "System"
      goal "Record the architect's verdict on the plan"

      reference_to PlanReview
      attribute :verdict, Verdict, sets: true
      attribute :findings, FindingsText, optional: true, sets: true

      given("the verdict is one the architect gives") do
        verdict.value == "sound" || verdict.value == "changes" || verdict.value == "rethink"
      end

      emits "PlanReviewed"
    end

    # The verdict of an architect run no request row names, such as one started by hand or whose row
    # was lost: the review is created with its verdict, so the verdict is a fact on the change and
    # not a lookup. A row that exists refuses it, and the `Answer` beside it has recorded the verdict.
    command "Record" do
      role "System"
      goal "Create a review from the architect's closing verdict when no request row exists"

      attribute :run,      RunKey, sets: true
      attribute :work,     WorkKey, sets: true
      attribute :verdict,  Verdict, sets: true
      attribute :findings, FindingsText, optional: true, sets: true

      given("the verdict is one the architect gives") do
        verdict.value == "sound" || verdict.value == "changes" || verdict.value == "rethink"
      end

      emits "PlanReviewRecorded"
    end

    # The architect's run was declined, so no verdict can come: the reason is recorded on the review
    # and the coder waiting on the Work item is told it (`JudgeTheUnstartedReview`). A review that
    # already holds a verdict refuses by name.
    command "Unstart" do
      role "System"
      goal "Record why the architect's run for a review was never started"

      reference_to PlanReview
      attribute :work,   WorkKey, sets: true
      attribute :reason, ReasonText, sets: true

      given("the review has no verdict yet") { verdict.nil? || verdict.to_s.empty? }

      emits "ReviewUnstarted"
    end

    # A declined run is looked up among the reviews: the one it keys is unstarted, with its Work item
    # read off the review's row. A declined run no review keys finds no row, so nothing happens. A root,
    # since the decline sits at the end of a dispatch's chain and the wake after it is four steps long.
    policy "UnstartTheDeclinedReview" do
      on       "AgentRun.AgentRunDeclined"
      root
      for_each "PlanReview.OfRun"
      trigger  PlanReview::Unstart, with: { plan_review: :plan_review, work: :work, reason: :refusal }
    end

    # An architect run that failed or was retired will never bring a verdict, so its review is
    # unstarted with the reason, and the coder waiting on the Work item is told it as it is
    # for a declined run. A review that already holds a verdict refuses, and a run no review keys
    # finds no row.
    policy "UnstartTheFailedReview" do
      on       "AgentRun.SessionFailed"
      root
      for_each "PlanReview.OfRun"
      trigger  PlanReview::Unstart, with: { plan_review: :plan_review, work: :work,
                                            reason: "the architect's run failed and gave no verdict" }
    end

    policy "UnstartTheRetiredReview" do
      on       "AgentRun.AgentRunRetired"
      root
      for_each "PlanReview.OfRun"
      trigger  PlanReview::Unstart, with: { plan_review: :plan_review, work: :work,
                                            reason: "the architect's session is gone and gave no verdict" }
    end

    policy "RecordTheVerdictWhenNoReviewWasAsked" do
      on      "AgentRun.JobRead"
      root
      where   { agent == "architect" && verdict != "" && (previous != state || (listed == "idle" && previous != "done")) }
      trigger PlanReview::Record, with: { run: :run, work: :work, verdict: :verdict, findings: :findings }
    end

    # The review a run keys, so a policy reacting to the run's event reads the Work item off its row.
    query "OfRun" do
      description "The review keyed by one run, with its Work item and the reason it was never started."
      attribute :run, RunKey
      where(run: :run)
    end

    query "Reviews" do
      description "Every plan review, by Work item, each with its run key: the verdict once the architect has answered."
      order_by :work
    end
  end

  # A judge's verdict on its way to the coder waiting on it. The verdict is a command on the change,
  # never a lookup the coder does: when an architect or reviewer run finishes, it is judged here
  # whether or not a PlanReview or SubmissionReview row exists. The Hecks hecksagon subscribes to
  # `VerdictJudged` and answers the coder's run (`AgentRun.Answer`); the answer's outcome comes back
  # as `Deliver` or `Undeliver`. Several judges of one Work item each have their own run key.
  aggregate "Verdict" do
    description "One judge run's verdict, bound for the coder waiting on its Work item: judged, then delivered or undeliverable with the reason."

    identified_by :run

    attribute :run, RunKey
    attribute :work, WorkKey
    attribute :role, RoleRef, optional: true
    attribute :answer, AnswerText, optional: true
    attribute :reason, ReasonText, optional: true
    attribute :word, VerdictWord, optional: true

    value_object "RunKey" do
      attribute :value, String, matches: :present
    end

    value_object "WorkKey" do
      attribute :value, String, matches: :present
      invariant("a verdict names its Work item") { !value.to_s.empty? }
    end

    value_object "RoleRef", String

    # The verdict and findings, as the coder is told them.
    value_object "AnswerText", String

    value_object "ReasonText", String

    # The architect's closing word, `sound`, `changes` or `rethink`; empty for a reviewer's
    # judgment and an unstarted review. The coder's next step is chosen by it.
    value_object "VerdictWord", String

    lifecycle :status, default: "judged" do
      transition "Deliver" => "delivered", from: "judged"
      transition "Undeliver" => "undeliverable", from: "judged"
    end

    command "Judge" do
      role "System"
      goal "Record a judge's verdict for the coder waiting on its Work item"

      attribute :run,    RunKey, sets: true
      attribute :work,   WorkKey, sets: true
      attribute :role,   RoleRef, sets: true
      attribute :answer, AnswerText, sets: true
      attribute :word,   VerdictWord, default: "", sets: true

      given("the judge is the architect or the reviewer") { role.value == "architect" || role.value == "reviewer" }
      given("the verdict says something") { !answer.value.to_s.strip.empty? }

      emits "VerdictJudged"
    end

    command "Deliver", from: "judged" do
      role "System"
      goal "Record that the coder's run was answered with the verdict"

      reference_to Verdict

      emits "VerdictDelivered"
    end

    # No waiting coder is a finding on the Work item, not a question for the orchestrator.
    command "Undeliver", from: "judged" do
      role "System"
      goal "Record why the verdict could not reach a coder"

      reference_to Verdict
      attribute :reason, ReasonText, sets: true

      emits "VerdictUndeliverable"
    end

    query "Delivered" do
      description "Every verdict a coder received, by run, each with the verdict text."
      where(status: "delivered")
      order_by :run
    end

    # A verdict still judged has not reached a coder: no coder run waits on its Work item, or the
    # answer is on its way.
    query "Judged" do
      description "Every verdict judged and not yet settled, by run."
      where(status: "judged")
      order_by :run
    end

    query "Undelivered" do
      description "Every verdict no coder received, by run, each with the reason."
      where(status: "undeliverable")
      order_by :run
    end

    # The architect's closing text is its findings; the verdict word leads them.
    policy "JudgeTheArchitectsVerdict" do
      on      "AgentRun.JobRead"
      root
      where   { agent == "architect" && verdict != "" && (previous != state || (listed == "idle" && previous != "done")) }
      trigger Verdict::Judge, with: { run: :run, work: :work, role: "architect", answer: :findings, word: :verdict }
    end

    # The reviewer's closing text is the job's detail; its judgment word is in it.
    policy "JudgeTheReviewersJudgment" do
      on      "AgentRun.JobRead"
      root
      where   { agent == "reviewer" && judgment != "" && previous != state }
      trigger Verdict::Judge, with: { run: :run, work: :work, role: "reviewer", answer: :detail }
    end

    # A review whose architect run was declined can never bring a verdict, so the reason goes to the
    # coder as the verdict would. The event carries the run; the Work item is read off the review's row.
    policy "JudgeTheUnstartedReview" do
      on      "PlanReview.ReviewUnstarted"
      trigger Verdict::Judge, with: { run: :run, work: :work, role: "architect", answer: :reason }
    end
  end

  # The reviewer's judgment of a failing spec: a real bug, or a stale expectation. A real bug is
  # never fixed by an agent on its own; it goes to a person.
  aggregate "SubmissionReview" do
    description "One judgment by the reviewer role of a submission's failing spec: asked as an event, answered with a verdict, and a real bug handed to a person."

    identified_by :submission

    attribute :submission, SubmissionRef
    attribute :work, WorkKey, optional: true
    attribute :judgment, Judgment, optional: true
    attribute :hops, HopCount, optional: true

    # The commit the coder submitted: the review's key, and the key of the reviewer's run.
    value_object "SubmissionRef" do
      attribute :value, String, matches: :present
      invariant("a review names the commit it judges") { !value.to_s.empty? }
    end

    value_object "WorkKey", String

    value_object "Judgment", String

    value_object "HopCount", Integer

    value_object "RoleRef", String

    value_object "RepoPath", String

    value_object "BriefText", String

    command "Request" do
      role "System"
      goal "Ask the reviewer to judge a submission's failing spec"

      attribute :submission, SubmissionRef, sets: true
      attribute :work, WorkKey, sets: true
      attribute :hops, HopCount, sets: true
      attribute :role, RoleRef
      attribute :repo, RepoPath
      attribute :brief, BriefText

      given("the request is under the hop limit") { hops.value < 3 }

      emits "SubmissionReviewRequested"
    end

    command "Judge" do
      role "System"
      goal "Record whether the failing spec is a real bug or a stale expectation"

      reference_to SubmissionReview
      attribute :judgment, Judgment, sets: true

      given("the judgment is one the reviewer gives") do
        judgment.value == "real_bug" || judgment.value == "stale_expectation"
      end

      emits "SpecFailureJudged"
    end

    # A real bug is not fixed by an agent's say-so. A person looks at it.
    command "HandToPerson" do
      role "System"
      goal "Hand a real bug to a person instead of letting an agent fix it"

      reference_to SubmissionReview
      attribute :judgment, Judgment

      emits "HandedToPerson"
    end

    query "Reviews" do
      description "Every submission review, by commit: the judgment once the reviewer has given it."
      order_by :submission
    end

    policy "RealBugGoesToAPerson" do
      on      "SubmissionReview.SpecFailureJudged"
      where   { judgment.value == "real_bug" }
      trigger SubmissionReview::HandToPerson
    end
  end

  # The planner. The owner gives it a goal; its session drafts a plan of Work items and asks which
  # options to take. It creates items only after the owner confirms, so this aggregate only asks.
  aggregate "Planning" do
    description "One request to the planner role: a goal to turn into a plan of Work items, with the checkout it reads."

    identified_by :plan

    attribute :plan, PlanKey
    attribute :goal, GoalText, optional: true

    value_object "PlanKey" do
      attribute :value, String, matches: :present
      invariant("a planning request has a key") { !value.to_s.empty? }
    end

    value_object "GoalText", String

    value_object "RoleRef", String

    value_object "RepoPath", String

    command "Request" do
      role "Maintainer"
      goal "Ask the planner to turn a goal into a plan of Work items"

      attribute :plan, PlanKey, sets: true
      attribute :goal, GoalText, sets: true
      attribute :role, RoleRef
      attribute :repo, RepoPath

      given("the goal says something") { goal.value != "" }

      emits "PlanningRequested"
    end

    query "Requests" do
      description "Every planning request, by key."
      order_by :plan
    end
  end

  # The orchestrator. Routing is a rule first: a Work item with no conflict is routed at once and no
  # agent is asked. Only a conflicting item asks for advice, and that ask carries the hop limit.
  aggregate "Routing" do
    description "One Work item's routing: checked for a conflict, routed by rule when there is none, and sent for advice when there is."

    identified_by :work

    attribute :work, WorkKey
    attribute :conflict, Conflict, optional: true
    attribute :hops, HopCount, optional: true

    value_object "WorkKey" do
      attribute :value, String, matches: :present
      invariant("a routing names its Work item") { !value.to_s.empty? }
    end

    value_object "Conflict", String

    value_object "HopCount", Integer

    # The key of the orchestrator's run, so it never collides with another run for the same Work item.
    value_object "AdviceKey", String

    value_object "RoleRef", String

    value_object "RepoPath", String

    # What the orchestrator is asked: the Work item and the conflict, in words.
    value_object "BriefText", String

    # `conflict` is "yes" when the item spans several areas or overlaps another session's.
    command "Check" do
      role "System"
      goal "Check one Work item for a conflict before routing it"

      attribute :work, WorkKey, sets: true
      attribute :conflict, Conflict, sets: true
      attribute :hops, HopCount, sets: true
      # The key the orchestrator's run takes when the check finds a conflict: without it no session could start.
      attribute :advice, AdviceKey
      attribute :role, RoleRef, optional: true
      attribute :repo, RepoPath, optional: true
      attribute :brief, BriefText, optional: true

      given("the check is under the hop limit") { hops.value < 3 }

      emits "WorkChecked"
    end

    command "Route" do
      role "System"
      goal "Route a Work item that has no conflict, by rule"

      reference_to Routing
      attribute :conflict, Conflict
      attribute :hops, HopCount

      emits "WorkRouted"
    end

    command "AskAdvice" do
      role "System"
      goal "Ask the orchestrator role for advice on a Work item that conflicts"

      reference_to Routing
      attribute :conflict, Conflict
      attribute :hops, HopCount
      attribute :advice, AdviceKey, optional: true
      attribute :role, RoleRef, optional: true
      attribute :repo, RepoPath, optional: true
      attribute :brief, BriefText, optional: true

      emits "DispatchAdviceRequested"
    end

    policy "RouteWhenNoConflict" do
      on      "Routing.WorkChecked"
      where   { conflict.value == "no" }
      trigger Routing::Route, with: { conflict: :conflict, hops: :hops }
    end

    policy "AskAdviceWhenConflict" do
      on      "Routing.WorkChecked"
      where   { conflict.value == "yes" }
      trigger Routing::AskAdvice, with: {}
    end
  end

  # The exceptions that wake the orchestrator, and the only things that do. Each is one event that
  # already exists on main, raised once per key: a second raise of the same key is refused as taken,
  # so a stall, a cause or an incident wakes the orchestrator once. The key is the event's own field,
  # which a policy can pass. Routine work (restore, grouping, assignment) is the Triage policies' and
  # wakes nobody. Each wake carries the event and the standing rule it falls under.
  aggregate "Escalation" do
    description "One exception that needs the orchestrator's judgment: the event it came from, the standing rule it falls under, and the brief its run reads."

    identified_by :escalation

    attribute :escalation, EscalationKey
    attribute :event, EventName
    attribute :rule, RuleName
    attribute :role, RoleRef
    attribute :repo, RepoPath
    attribute :brief, BriefText

    value_object "EscalationKey" do
      attribute :value, String, matches: :present
      invariant("an escalation has a key") { !value.to_s.empty? }
    end

    value_object "EventName", String

    # The `rule` of a `StandingRule` row of the Role aggregate.
    value_object "RuleName", String

    value_object "RoleRef", String

    value_object "RepoPath", String

    value_object "BriefText", String

    command "Raise" do
      role "System"
      goal "Wake the orchestrator for one exception, once per key"

      attribute :escalation, EscalationKey, sets: true
      attribute :event, EventName, sets: true
      attribute :rule, RuleName, sets: true
      attribute :role, RoleRef, sets: true
      attribute :repo, RepoPath, sets: true
      attribute :brief, BriefText, sets: true

      emits "CoordinatorWoken"
    end

    policy "WakeWhenAStallIsFiled" do
      on      "Stall.StallFiled"
      where   { fixer.value == "orchestrator" }
      trigger Escalation::Raise, with: { escalation: :stall, event: "StallFiled", rule: "rely-on-events", role: "orchestrator", repo: ".",
                                         brief: "A stall was filed for you (see its work item). Act on it by the move it names, under your standing rule rely-on-events." }
    end

    policy "WakeWhenACauseMatchesNoLesson" do
      on      "Cause.CauseGapReported"
      trigger Escalation::Raise, with: { escalation: :cause, event: "CauseGapReported", rule: "all-hands-on-red", role: "orchestrator", repo: ".",
                                         brief: "A cause of a red main matches no known lesson. Record it as a lesson and see that one coder holds the cause, under your standing rule all-hands-on-red." }
    end

    policy "WakeWhenABatchHoldsARelease" do
      on      "Incident.IncidentOpened"
      where   { releases.value > 0 }
      trigger Escalation::Raise, with: { escalation: :incident, event: "IncidentOpened", rule: "release-is-the-owners", role: "orchestrator", repo: ".",
                                         brief: "A red main's batch holds a release commit, so no restore ran. Report it as the owner's decision, under your standing rule release-is-the-owners." }
    end
  end

  # How a role ends a turn. Every role closes with one `TurnFinished` carrying the fields it has;
  # the orchestrator carries all of them. The console block and the board's run cards and stuck list
  # are projections of this event (see the PipelineBoard bluebook), so no second source says what a
  # turn did. A role that has not adopted it still ends with a plain last word, which is accepted.
  aggregate "Turn" do
    description "One finished turn of one role: the verdict, and what it landed, dispatched, filed and left stuck."

    identified_by :run

    attribute :run,        RunKey
    attribute :session,    SessionRef, optional: true
    attribute :role,       RoleRef
    attribute :at,         Moment
    attribute :verdict,    TurnVerdict
    attribute :landed,     Facts, optional: true
    attribute :main,       Facts, optional: true
    attribute :train,      Facts, optional: true
    attribute :dispatched, Facts, optional: true
    attribute :filed,      Facts, optional: true
    attribute :stuck,      list_of(StuckItem), optional: true
    attribute :unpushed,   Facts, optional: true
    attribute :links,      Facts, optional: true

    value_object "RunKey" do
      attribute :value, String, matches: :present
    end

    value_object "SessionRef", String

    value_object "RoleRef" do
      attribute :value, String, matches: :present
    end

    value_object "Moment" do
      attribute :value, String, matches: :present
    end

    # `routed` when the turn passed its work on, `blocked` when something stands in the way.
    value_object "TurnVerdict" do
      attribute :value, String, matches: :present
      invariant("a verdict is routed or blocked") { value == "routed" || value == "blocked" }
    end

    # A JSON document: `landed[]` of {sha,title}, `main` of {origin,ahead,behind,clean,origin_pushed_h},
    # `train` of {open pr or null,next_board}, `dispatched[]` of {work,role,session,state,age_s},
    # `filed[]` of {kind finding|work,key,step}, `unpushed[]` of {branch,commits[],note}, `links[]`.
    value_object "Facts", String

    # One thing the pipeline is stuck on. `kind` says what sort, `owner_run` the run that holds it.
    value_object "StuckItem" do
      attribute :kind,      String
      attribute :what,      String
      attribute :since,     String
      attribute :owner_run, String
      attribute :link,      String
    end

    command "Finish" do
      role "System"
      goal "Record that a role ended its turn, and what the turn did"

      attribute :run,        RunKey, sets: true
      attribute :session,    SessionRef, optional: true, sets: true
      attribute :role,       RoleRef, sets: true
      attribute :at,         Moment, sets: true
      attribute :verdict,    TurnVerdict, sets: true
      attribute :landed,     Facts, optional: true, sets: true
      attribute :main,       Facts, optional: true, sets: true
      attribute :train,      Facts, optional: true, sets: true
      attribute :dispatched, Facts, optional: true, sets: true
      attribute :filed,      Facts, optional: true, sets: true
      attribute :stuck,      list_of(StuckItem), optional: true, sets: true
      attribute :unpushed,   Facts, optional: true, sets: true
      attribute :links,      Facts, optional: true, sets: true

      emits "TurnFinished"
    end

    query "Blocked" do
      description "The turns that ended blocked, by run."
      where(verdict: "blocked")
      order_by :run
    end
  end

  # The release manager only recommends. Promotion stays a person's command, confirmed on the board.
  aggregate "PromotionRecommendation" do
    description "A release manager's recommendation to promote one change once main is green on it, with its reasons. It never promotes: the owner confirms."

    identified_by :change

    attribute :change, ChangeRef
    attribute :reasons, Reasons, optional: true
    attribute :role, RoleRef, optional: true
    attribute :repo, RepoPath
    attribute :brief, BriefText, optional: true

    value_object "ChangeRef" do
      attribute :value, String, matches: :present
      invariant("a recommendation names a change") { !value.to_s.empty? }
    end

    value_object "Reasons", String
    value_object "RoleRef", String
    value_object "RepoPath", String
    value_object "BriefText", String

    lifecycle :status, default: "recommended" do
      transition "Settle" => "settled", from: "recommended"
    end

    command "Recommend" do
      role "System"
      goal "Recommend promoting one green change, with the reasons"

      attribute :change, ChangeRef, sets: true
      attribute :reasons, Reasons, sets: true
      attribute :role, RoleRef, optional: true, sets: true
      attribute :repo, RepoPath, sets: true
      attribute :brief, BriefText, optional: true, sets: true

      emits "PromotionRecommended"
    end

    # The owner has dealt with it: promoted the change, or set the recommendation aside.
    command "Settle" do
      role "Maintainer"
      goal "Settle a recommendation once the owner has promoted the change or set it aside"

      reference_to PromotionRecommendation

      emits "PromotionSettled"
    end

    query "Recommendations" do
      description "Every promotion the release manager recommends, by change, settled or not."
      order_by :change
    end

    query "Open" do
      description "The recommendations still waiting on the owner, by change."
      where(status: "recommended")
      order_by :change
    end
  end

  # The pruner removes finished sessions. The bluebook gives: a pruner is woken only from rest, so a
  # second wake while one works is refused by the lifecycle, and the end of its run rests it again.
  # The policies state: a feature landing wakes it (the Landing's LandedWorkFound, once per landed
  # branch that names an open Work item); a run that ends without landing (a yield, a stop, a
  # rethink) wakes nothing, and the pruner's own finish only rests it. A landing wakes it while the
  # landing session still works, so that session is removed at a later landing, not this one; a
  # session that ends without landing waits for the next feature to land. The delegate bluebook
  # starts a woken pruner as a run of the `pruner` agent, since a policy here cannot reach
  # AgentRun; the reaction mints the run key. A
  # role's `starts` field would replace the literals in the first policy. The brief sends the pruner
  # through `SessionCleanup.RemoveSafe` (delegate bluebook), which removes only the sessions of
  # dispatched runs that finished done, so the safety rule holds whatever the session reads.
  aggregate "Pruning" do
    description "The pruner role's standing: resting, or working on one dispatched run, so a second pruner is never started while one works."

    identified_by :role

    attribute :role, PrunerRole
    attribute :repo, PrunerRepo, optional: true
    attribute :brief, PrunerBrief, optional: true

    value_object "PrunerRole" do
      attribute :value, String, matches: :present
    end

    value_object "PrunerRepo", String
    value_object "PrunerBrief", String

    lifecycle :status, default: "resting" do
      transition "Wake" => "working", from: "resting"
      transition "Rest" => "resting", from: "working"
    end

    # The first landed feature seats the pruner; a seat that exists is refused, which is its answer.
    command "Seat" do
      role "System"
      goal "Seat the pruner so it can be woken"

      attribute :role, PrunerRole, sets: true

      emits "PrunerSeated"
    end

    # The manual path: one command seats the pruner and wakes it, since a process that seats it alone
    # forgets it before the next call. The policy path seats and wakes inside one process already.
    command "Summon" do
      role "System"
      goal "Seat the pruner and wake it for one run in the same command (to= is not needed)"

      attribute :role, PrunerRole, sets: true
      attribute :repo, PrunerRepo, sets: true
      attribute :brief, PrunerBrief, sets: true

      emits "PrunerSummoned"
    end

    command "Wake", from: "resting" do
      role "System"
      goal "Wake the seated pruner (to=pruner) for one run; refused while its run is still working"

      reference_to Pruning
      attribute :repo, PrunerRepo, sets: true
      attribute :brief, PrunerBrief, sets: true

      emits "PrunerWoken"
    end

    command "Rest", from: "working" do
      role "System"
      goal "Record that the pruner's run ended, so it may be woken again"

      reference_to Pruning

      emits "PrunerRested"
    end

    policy "SeatThePrunerWhenWorkLands" do
      on      "Landing.LandedWorkFound"
      root
      trigger Pruning::Seat, with: { role: "pruner" }
    end

    policy "WakeTheSummonedPruner" do
      on      "Pruning.PrunerSummoned"
      trigger Pruning::Wake, with: { pruning: :role, repo: :repo, brief: :brief }
    end

    policy "RestThePrunerWhenItsRunEnds" do
      on      "AgentRun.JobRead"
      root
      where   { (state == "done" || state == "stopped" || state == "failed") && previous != state && agent == "pruner" }
      trigger Pruning::Rest, with: { pruning: "pruner" }
    end
  end

  # After the pruner removes finished sessions, one sweep clears what they left behind. The bluebook
  # says what a sweep is for and refuses an empty one; the Machine port looks (the session list, the
  # daemon's log, the process table, each worktree, the temp directory) and stops. A spare daemon is
  # stopped only when the daemon's log traces it to a session that was removed and is no longer listed;
  # a daemon that cannot be traced is counted and left running. A worktree whose work is on main is
  # named for `Landing.retire!`, which makes the final check; one with unlanded work is only reported.
  aggregate "Sweep" do
    description "One sweep of the leftovers of removed sessions: spare daemons traced to them stopped, worktrees named for retirement or reported, stray temp files deleted, launchers left running with no parent and rehearsal pushes older than a day stopped, with the machine's footprint before and after."

    identified_by :run

    attribute :run, SweepName
    attribute :removed, RemovedSessions
    attribute :report, SweepSummary, optional: true
    attribute :refusal, SweepSummary, optional: true

    value_object "SweepName" do
      attribute :value, String, matches: :present
    end

    value_object "RemovedSessions", String
    value_object "SweepSummary", String

    value_object "SweepDocument" do
      attribute :text, String
    end

    lifecycle :status, default: "requested" do
      mark :failure, "refused"
      transition "Record"  => "swept",   from: "requested"
      transition "Decline" => "refused", from: "requested"
      mark :terminal, "swept", "refused"
    end

    command "Begin" do
      role "System"
      goal "Sweep the leftovers of the sessions the pruner just removed; refused when it names none"

      attribute :run,     SweepName, sets: true
      attribute :removed, RemovedSessions, sets: true

      given("the sweep names the removed sessions: it touches nothing else") { removed.value != "" }

      emits "SweepRequested"
    end

    command "Record" do
      role "System"
      goal "Record what the sweep stopped, retired, kept and deleted, and the footprint before and after"

      reference_to Sweep
      attribute :report, SweepSummary, sets: true

      emits "SweepRecorded"
    end

    command "Decline" do
      role "System"
      goal "Record why the sweep could not run"

      reference_to Sweep
      attribute :refusal, SweepSummary, sets: true

      emits "SweepDeclined"
    end

    # What a sweep would do, read first and changing nothing: each leftover of the named sessions
    # with the evidence that traces it, and the footprint now.
    query "Leftovers" do
      description "The spare daemons, worktrees and temp files traced to the named removed sessions and what a sweep would do with each, plus the machine's footprint. Reads only."
      attribute :removed, RemovedSessions
      returns SweepDocument
    end

    policy "SweepWhenRequested" do
      on      "Sweep.SweepRequested"
      ask     :sweep, with: { run: :run, removed: :removed }
    end

    policy "RecordTheSweep" do
      on      "Sweep.SweepReported"
      trigger Sweep::Record, with: { report: :report }
    end

    policy "RecordTheDeclinedSweep" do
      on      "Sweep.SweepRefused"
      trigger Sweep::Decline, with: { refusal: :refusal }
    end
  end
end
