# The ports Agents declares, for every hecksagon that attaches the bluebook. Each names the question
# it asks of the outside and never says how it is answered; an adapter binds each.
Hecks.hecksagon "Agents" do
  attaches "Governance"

  # Whether a role may run one command itself, decided from the Role aggregate's routing rows.
  Agents::Role.port "Routing" do
    answers_query "Guard"
    answers_query "ServerEnv"
  end

  # Which scripts the sessions ran twice or more, counted from the `Script` records. Bound by
  # adapters/script_records, which only reads the records.
  Agents::Script.port "ScriptRecords" do
    answers_query "Candidates"
  end

  # What the machine holds after sessions are removed: the process table, the daemon's log, the
  # worktrees and the temp directory. Bound by adapters/sweeping, which stops a spare daemon only when
  # the log traces it to a removed session.
  Agents::Sweep.port "Machine" do
    asks "Sweep", to: Sweep do
      attribute :run,     SweepName
      attribute :removed, RemovedSessions
      answers "SweepReported"
      refuses "SweepRefused"
    end

    answers_query "Leftovers"
  end

  # Whether a message's recipient is a run with a live session. Bound by adapters/recipient_check,
  # which reads the AgentRun ledger and the session listing and refuses, by name, a recipient that
  # is neither.
  Agents::Message.port "Recipients" do
    asks "Recipient", to: Message do
      attribute :message,   MessageKey
      attribute :recipient, RunKey
      answers "RecipientFound"
      refuses "RecipientMissing"
    end

    # Whether the session sending a message is the one registered under the sender it names.
    asks "Sender", to: Message do
      attribute :message, MessageKey
      attribute :sender,  SenderName
      attribute :recipient, RunKey
      attribute :asker_role, AskerRole
      attribute :kind, MessageKind
      answers "SenderChecked"
      refuses "SenderUnchecked"
    end
  end

  # The mail spool a send appends to, read a line at a time: `Read` answers the next line past the
  # cursor (an empty `message` when none), `Acknowledge` moves the cursor. Bound by adapters/mail_spool,
  # which never writes a line.
  Agents::MailSpool.port "MailSpooling" do
    asks "Read", to: MailSpool do
      attribute :pass, PassKey
      answers "MailLineRead"
      refuses "SpoolRefused"
    end

    asks "Acknowledge", to: MailSpool do
      attribute :pass, PassKey
      attribute :line, LineNumber
      answers "LineAcknowledged"
      refuses "SpoolRefused"
    end
  end

  # The sessions `claude agents` lists, as each hand run's session and run key find them (adapters/hand_run_watch).
  Agents::HandRun.port "HandRunWatching" do
    asks "ReadSession", to: HandRun do
      attribute :run,     RunKey
      attribute :session, SessionId
      attribute :role,    RunRole
      attribute :checkout, HandCheckout, optional: true
      answers "HandRunExamined"
      refuses "HandRunUnread"
    end

    asks "ReadRunKey", to: HandRun do
      attribute :run,     RunKey
      attribute :session, SessionId
      attribute :role,    RunRole
      attribute :checkout, HandCheckout, optional: true
      answers "HandRunSought"
      refuses "HandRunUnread"
    end
  end

  # Whether a session holds the role a sent message is addressed to, and the wake of it. Bound by
  # adapters/role_rouser, which resumes an idle holder and leaves a busy one to its inbox hook.
  Agents::Message.port "Rousing" do
    asks "Rouse", to: Message do
      attribute :message, MessageKey
      answers "MessageWoken"
      refuses "WakeUnreachable"
    end

    # The unread fallback: resumes an idle holder through Claude messaging; a working one is refused by name.
    asks "Resume", to: Message do
      attribute :message, MessageKey
      attribute :now, MessageInstant
      answers "MessageResumed"
      refuses "WakeUnreachable"
    end

    # Whether any session holds the role: a role nobody holds is final, a working holder is not.
    asks "Holds", to: Message do
      attribute :message, MessageKey
      attribute :now, MessageInstant
      answers "RoleHeld"
      refuses "RoleUnheld"
    end
  end

  # Which paths a submitted branch changed against main, read in its checkout. Bound by
  # adapters/submitted_paths, which only reads git; the bluebook decides what the paths ask for.
  # The same read answers `Tier`, `Domains` and the architect's `Diff`.
  Agents::ChangeReview.port "SubmittedPaths" do
    asks "SubmittedPaths", to: ChangeReview do
      attribute :review,   ReviewKey
      attribute :checkout, CheckoutPath
      answers "PathsRead"
      refuses "PathsUnread"
    end

    answers_query "Tier"
    answers_query "Domains"
    answers_query "Diff"
  end

  # The same read for `SubmissionReview`: the tier of a submitted commit and the domains and
  # bluebooks it touches, matched to ChangeReview's rows, so the reviewer's evidence is counted
  # against the one rule.
  Agents::SubmissionReview.port "SubmittedPaths" do
    asks "ReadScope", to: SubmissionReview do
      attribute :submission, SubmissionRef
      attribute :checkout,   RepoPath
      answers "ScopeRead"
      refuses "ScopeUnread"
    end
  end

  # How a run the reviewer cites ended, read from its kept record in the Hecks domain's store
  # (`Operation` for behaviors, `ModelCheckRun` for a model check). Bound by adapters/run_records,
  # which only reads; the bluebook judges what the record shows.
  Agents::SubmissionReview.port "RunRecords" do
    asks "Read", to: SubmissionReview do
      attribute :submission, SubmissionRef
      attribute :kind,       EvidenceKind
      attribute :run,        EvidenceRunKey
      answers "RunRead"
      refuses "RunUnkept"
    end

    # How one acceptance reference's scenario ended in the behaviors run cited for it. The same
    # adapter answers it; its refusal of a run whose subject is not the reference's `.behaviors`
    # file is the one place that match is enforced.
    asks "ReadAcceptance", to: SubmissionReview do
      attribute :submission, SubmissionRef
      attribute :ref,        AcceptanceRef
      attribute :run,        EvidenceRunKey
      answers "AcceptanceRead"
      refuses "RunUnkept"
    end
  end

  # A canary's scratch branch, cut through `LinkedTree.add!` and the patch committed in it; bound
  # by adapters/scratch_branches, which never pushes. A refusal that begins "the patch does not
  # apply" is the patch's; any other may pass.
  Agents::Canary.port "ScratchBranches" do
    asks "CutScratch", to: Canary do
      attribute :canary,  CanaryName
      attribute :base,    BaseRef
      attribute :patch,   PatchText
      attribute :finding, FindingWord
      attribute :branch,  BranchName
      attribute :message, CommitMessage
      attribute :round,   Tally
      answers "ScratchCut"
      refuses "ScratchUncut"
    end
  end

  # The sessions claude lists, joined to the AgentRun ledger (adapters/fleet_control). The examines
  # read the facts Fleet's policies judge; the adapter refuses only a session not listed, a boot
  # with no ledger, and a command `claude` refused.
  Agents::Fleet.port "Fleet" do
    # Whether a pinned role holds the session, the run that holds it, and that in words.
    asks "ExamineStop", to: Fleet do
      attribute :session, FleetSession
      answers "StopExamined"
      refuses "SessionHaltRefused"
    end

    # Whether the session is working, the run that holds it, and that in words; the name is kept.
    asks "ExamineResume", to: Fleet do
      attribute :session, FleetSession
      attribute :name,    FleetName
      answers "ResumeExamined"
      refuses "SessionReviveRefused"
    end

    asks "Halt", to: Fleet do
      attribute :session, FleetSession
      answers "SessionHalted"
      refuses "SessionHaltRefused"
    end

    asks "Revive", to: Fleet do
      attribute :session, FleetSession
      attribute :name,    FleetName
      answers "SessionRevived"
      refuses "SessionReviveRefused"
    end

    # Whether the seat that holds the run key is working, and the run, in words; refused by name
    # when no listed session holds the key.
    asks "ExamineWake", to: Fleet do
      attribute :session, FleetSession
      answers "WakeExamined"
      refuses "SessionWakeRefused"
    end

    asks "Awaken", to: Fleet do
      attribute :session, FleetSession
      answers "SessionWoken"
      refuses "SessionWakeRefused"
    end

    answers_query "Sessions"
    answers_query "Topic"
  end
end
