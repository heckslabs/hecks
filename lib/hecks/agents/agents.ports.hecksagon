# The ports Agents declares, for every hecksagon that attaches the bluebook. Each names the question
# it asks of the outside and never says how it is answered; an adapter binds each.
Hecks.hecksagon "Agents" do
  attaches "Governance"

  # Whether a role may run one command itself, decided from the Role aggregate's routing rows.
  Agents::Role.port "Routing" do
    answers_query "Guard"
    answers_query "ServerEnv"
  end

  # What the machine holds after sessions are removed: the process table, the daemon's log, the
  # worktrees and the temp directory. Bound by adapters/sweeping, which stops a spare daemon only when
  # the log traces it to a removed session.
  Agents::Sweep.port "Machine" do
    asks "Sweep", to: Sweep do
      attribute :run,     SweepName
      attribute :removed, RemovedSessions
      answers "SweepReported"
      refuses "SweepRefused"
    end

    answers_query "Leftovers"
  end
end
