Hecks.behaviors "Agents" do
  vision "A reviewer's clean verdict stands on the kept runs it cites, one passing run for every domain and bluebook the commit touches."

  loads "agents.bluebook", "agents.hecksagon", "agents.ports.hecksagon"

  test "Judge refuses a clean verdict with no evidence" do
    tests "Judge", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "abc1" }, hops: { value: 1 },
           work: { value: "w-abc1" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-abc1" }
    setup  "Agents::SubmissionReview.Scope", submission: { value: "abc1" }, tier: { value: "full" },
           domains: { value: "|lib/hecks/agents|" }, bluebooks: { value: "|lib/hecks/agents|" }
    input  submission: { value: "abc1" }, judgment: { value: "clean" }
    expect refused: "a clean verdict has a passing behaviors run for every domain the commit touches"
  end

  test "Judge records a clean verdict with a passing run for every domain and bluebook" do
    tests "Judge", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "abc2" }, hops: { value: 1 },
           work: { value: "w-abc2" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-abc2" }
    setup  "Agents::SubmissionReview.Scope", submission: { value: "abc2" }, tier: { value: "full" },
           domains: { value: "|lib/hecks/agents|" }, bluebooks: { value: "|lib/hecks/agents|" }
    setup  "Agents::SubmissionReview.Count", submission: { value: "abc2" }, kind: { value: "behaviors" },
           run: { value: "abc2-behaviors" }, subject: { value: "lib/hecks/agents" }, status: { value: "succeeded" },
           scenarios: { value: 6 }
    setup  "Agents::SubmissionReview.Count", submission: { value: "abc2" }, kind: { value: "model_check" },
           run: { value: "abc2-model-check" }, subject: { value: "lib/hecks/agents" }, status: { value: "clean" },
           scenarios: { value: 1 }
    input  submission: { value: "abc2" }, judgment: { value: "clean" }
    expect judgment: { value: "clean" }
  end

  test "Judge refuses a clean verdict when a cited run failed" do
    tests "Judge", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "abc3" }, hops: { value: 1 },
           work: { value: "w-abc3" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-abc3" }
    setup  "Agents::SubmissionReview.Scope", submission: { value: "abc3" }, tier: { value: "full" },
           domains: { value: "|lib/hecks/agents|" }, bluebooks: { value: "||" }
    setup  "Agents::SubmissionReview.Count", submission: { value: "abc3" }, kind: { value: "behaviors" },
           run: { value: "abc3-behaviors" }, subject: { value: "lib/hecks/agents" }, status: { value: "failed" },
           scenarios: { value: 6 }
    input  submission: { value: "abc3" }, judgment: { value: "clean" }
    expect refused: "a clean verdict has a passing behaviors run for every domain the commit touches"
  end

  test "Judge refuses a clean verdict on a verify_only commit" do
    tests "Judge", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "abc4" }, hops: { value: 1 },
           work: { value: "w-abc4" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-abc4" }
    setup  "Agents::SubmissionReview.Scope", submission: { value: "abc4" }, tier: { value: "verify_only" },
           domains: { value: "||" }, bluebooks: { value: "||" }
    input  submission: { value: "abc4" }, judgment: { value: "clean" }
    expect refused: "a clean verdict is of a full-tier commit"
  end

  test "Judge refuses a missing behavior that names no scenario" do
    tests "Judge", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "abc5" }, hops: { value: 1 },
           work: { value: "w-abc5" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-abc5" }
    input  submission: { value: "abc5" }, judgment: { value: "missing_behavior" }
    expect refused: "a missing behavior names the scenario that is missing"
  end

  test "Judge records a missing behavior with the scenario to write" do
    tests "Judge", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "abc6" }, hops: { value: 1 },
           work: { value: "w-abc6" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-abc6" }
    input  submission: { value: "abc6" }, judgment: { value: "missing_behavior" },
           findings: { value: "lib/hecks/agents: Judge refuses a clean verdict with no evidence" }
    expect judgment: { value: "missing_behavior" }
  end

  test "Count refuses a behaviors run of a domain the commit does not touch" do
    tests "Count", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "abc7" }, hops: { value: 1 },
           work: { value: "w-abc7" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-abc7" }
    setup  "Agents::SubmissionReview.Scope", submission: { value: "abc7" }, tier: { value: "full" },
           domains: { value: "|lib/hecks/agents|" }, bluebooks: { value: "||" }
    input  submission: { value: "abc7" }, kind: { value: "behaviors" }, run: { value: "abc7-behaviors" },
           subject: { value: "lib/hecks/tickets" }, status: { value: "succeeded" }, scenarios: { value: 3 }
    expect refused: "a behaviors run is of a domain the commit touches"
  end

  test "Cite refuses a run whose key does not name the submitted commit" do
    tests "Cite", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "abc8" }, hops: { value: 1 },
           work: { value: "w-abc8" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-abc8" }
    input  submission: { value: "abc8" }, kind: { value: "behaviors" }, run: { value: "nightly" }
    expect refused: "the run is of the submitted commit: its key names the commit"
  end

  test "Count counts a finding under the hop limit and sends it to a coder" do
    tests "Count", on: "FindingRoute"
    setup  "Agents::FindingRoute.Open", work: { value: "w-route1" }, judgment: { value: "real_bug" },
           submission: { value: "r1" }, repo: { value: "/nonexistent" }
    input  work: { value: "w-route1" }, judgment: { value: "real_bug" }, submission: { value: "r1" },
           repo: { value: "/nonexistent" }
    expect emits: ["RouteCounted", "FindingRouted"]
  end

  test "Exhaust refuses a route under the hop limit" do
    tests "Exhaust", on: "FindingRoute"
    setup  "Agents::FindingRoute.Open", work: { value: "w-route2" }, judgment: { value: "real_bug" },
           submission: { value: "r2" }, repo: { value: "/nonexistent" }
    input  work: { value: "w-route2" }, reason: { value: "review loop" }
    expect refused: "the route reached the hop limit"
  end

  test "Send refuses a clean verdict, which no coder fixes" do
    tests "Send", on: "FindingRoute"
    setup  "Agents::FindingRoute.Open", work: { value: "w-route3" }, judgment: { value: "real_bug" },
           submission: { value: "r3" }, repo: { value: "/nonexistent" }
    input  work: { value: "w-route3" }, judgment: { value: "clean" }, repo: { value: "/nonexistent" },
           brief: { value: "fix it" }
    expect refused: "the finding is one a coder fixes"
  end

  test "Send routes a stale expectation to a coder" do
    tests "Send", on: "FindingRoute"
    setup  "Agents::FindingRoute.Open", work: { value: "w-route4" }, judgment: { value: "stale_expectation" },
           submission: { value: "r4" }, repo: { value: "/nonexistent" }
    input  work: { value: "w-route4" }, judgment: { value: "stale_expectation" }, repo: { value: "/nonexistent" },
           brief: { value: "edit only the stale spec" }
    expect emits: ["FindingRouted"]
  end

  test "Judge refuses a clean verdict on a story work item while a reference is not yet attested" do
    tests "Judge", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "acc1" }, hops: { value: 1 },
           work: { value: "w-acc1" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-acc1" }, acceptance: { value: "|lib/hecks/agents/agents.behaviors#Judge refuses|" }
    setup  "Agents::SubmissionReview.Scope", submission: { value: "acc1" }, tier: { value: "full" },
           domains: { value: "|lib/hecks/agents|" }, bluebooks: { value: "||" }
    setup  "Agents::SubmissionReview.Count", submission: { value: "acc1" }, kind: { value: "behaviors" },
           run: { value: "acc1-behaviors" }, subject: { value: "lib/hecks/agents" }, status: { value: "succeeded" },
           scenarios: { value: 6 }
    input  submission: { value: "acc1" }, judgment: { value: "clean" }
    expect refused: "a clean verdict on a story work item has a passing run of every acceptance reference"
  end

  test "Judge refuses a clean verdict on a story work item whose reference failed" do
    tests "Judge", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "acc2" }, hops: { value: 1 },
           work: { value: "w-acc2" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-acc2" }, acceptance: { value: "|lib/hecks/agents/agents.behaviors#Judge refuses|" }
    setup  "Agents::SubmissionReview.Scope", submission: { value: "acc2" }, tier: { value: "full" },
           domains: { value: "|lib/hecks/agents|" }, bluebooks: { value: "||" }
    setup  "Agents::SubmissionReview.Count", submission: { value: "acc2" }, kind: { value: "behaviors" },
           run: { value: "acc2-behaviors" }, subject: { value: "lib/hecks/agents" }, status: { value: "succeeded" },
           scenarios: { value: 6 }
    setup  "Agents::SubmissionReview.Attest", submission: { value: "acc2" }, ref: { value: "lib/hecks/agents/agents.behaviors#Judge refuses" },
           run: { value: "acc2-acceptance-1" }, result: { value: "failed" }
    input  submission: { value: "acc2" }, judgment: { value: "clean" }
    expect refused: "a clean verdict on a story work item has a passing run of every acceptance reference"
  end

  test "Judge refuses a clean verdict on a story work item whose reference resolves to no scenario" do
    tests "Judge", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "acc3" }, hops: { value: 1 },
           work: { value: "w-acc3" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-acc3" }, acceptance: { value: "|lib/hecks/agents/agents.behaviors#Judge refuses|" }
    setup  "Agents::SubmissionReview.Scope", submission: { value: "acc3" }, tier: { value: "full" },
           domains: { value: "|lib/hecks/agents|" }, bluebooks: { value: "||" }
    setup  "Agents::SubmissionReview.Count", submission: { value: "acc3" }, kind: { value: "behaviors" },
           run: { value: "acc3-behaviors" }, subject: { value: "lib/hecks/agents" }, status: { value: "succeeded" },
           scenarios: { value: 6 }
    setup  "Agents::SubmissionReview.Attest", submission: { value: "acc3" }, ref: { value: "lib/hecks/agents/agents.behaviors#Judge refuses" },
           run: { value: "acc3-acceptance-1" }, result: { value: "unresolved" }
    input  submission: { value: "acc3" }, judgment: { value: "clean" }
    expect refused: "a clean verdict on a story work item has a passing run of every acceptance reference"
  end

  test "Judge records a clean verdict when every acceptance reference passed beside the regression" do
    tests "Judge", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "acc4" }, hops: { value: 1 },
           work: { value: "w-acc4" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-acc4" }, acceptance: { value: "|lib/hecks/agents/agents.behaviors#Judge refuses|" }
    setup  "Agents::SubmissionReview.Scope", submission: { value: "acc4" }, tier: { value: "full" },
           domains: { value: "|lib/hecks/agents|" }, bluebooks: { value: "||" }
    setup  "Agents::SubmissionReview.Count", submission: { value: "acc4" }, kind: { value: "behaviors" },
           run: { value: "acc4-behaviors" }, subject: { value: "lib/hecks/agents" }, status: { value: "succeeded" },
           scenarios: { value: 6 }
    setup  "Agents::SubmissionReview.Attest", submission: { value: "acc4" }, ref: { value: "lib/hecks/agents/agents.behaviors#Judge refuses" },
           run: { value: "acc4-acceptance-1" }, result: { value: "passed" }
    input  submission: { value: "acc4" }, judgment: { value: "clean" }
    expect judgment: { value: "clean" }
  end

  test "CiteAcceptance refuses a reference that is not one of the work item's" do
    tests "CiteAcceptance", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "acc5" }, hops: { value: 1 },
           work: { value: "w-acc5" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-acc5" }, acceptance: { value: "|lib/hecks/agents/agents.behaviors#Judge refuses|" }
    input  submission: { value: "acc5" }, ref: { value: "lib/hecks/agents/agents.behaviors#Some other scenario" },
           run: { value: "acc5-acceptance-1" }
    expect refused: "an acceptance citation names one of the work item's references"
  end

  test "CiteAcceptance takes a run keyed by the commit and reads its kept record, declining one no store keeps" do
    tests "CiteAcceptance", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "acc6" }, hops: { value: 1 },
           work: { value: "w-acc6" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-acc6" }, acceptance: { value: "|lib/hecks/agents/agents.behaviors#Judge refuses|" }
    input  submission: { value: "acc6" }, ref: { value: "lib/hecks/agents/agents.behaviors#Judge refuses" }, run: { value: "acc6-acceptance-1" }
    expect emits: ["AcceptanceCited", "RunUnkept", "EvidenceDeclined"]
  end

  test "Attest refuses a reference that is not one of the work item's" do
    tests "Attest", on: "SubmissionReview"
    setup  "Agents::SubmissionReview.Request", submission: { value: "acc7" }, hops: { value: 1 },
           work: { value: "w-acc7" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-acc7" }, acceptance: { value: "|lib/hecks/agents/agents.behaviors#Judge refuses|" }
    input  submission: { value: "acc7" }, ref: { value: "lib/hecks/agents/agents.behaviors#Some other scenario" },
           run: { value: "acc7-acceptance-1" }, result: { value: "passed" }
    expect refused: "the attested reference is one of the work item's references"
  end

  test "Record keeps a clean verdict's miss with the episode that found it" do
    tests "Record", on: "ReviewMiss"
    setup  "Agents::SubmissionReview.Request", submission: { value: "miss1" }, hops: { value: 1 },
           work: { value: "w-miss1" }, role: { value: "reviewer" }, repo: { value: "/nonexistent" },
           brief: { value: "w-miss1" }
    input  review: "miss1", submission: { value: "miss1" }, work: { value: "w-miss1" }, tier: { value: "full" },
           hops: { value: 1 }, episode: { value: "ep-miss1" }, culprit: { value: "m1" }, spec: { value: "spec/a_spec.rb" }
    expect emits: ["ReviewMissed"]
  end

  test "Add refuses a canary whose finding the reviewer never gives on a bad change" do
    tests "Add", on: "Canary"
    input  canary: { value: "c-clean" }, base: { value: "main" }, patch: { value: "diff" },
           finding: { value: "clean" }, branch: { value: "tidy-parse" }, message: { value: "Tidy the parse" }
    expect refused: "the finding is one the reviewer gives on a bad change"
  end

  test "Catch records a plant the review failed with the expected finding" do
    tests "Catch", on: "CanaryPlant"
    setup  "Agents::CanaryPlant.Open", submission: { value: "cp1" }, canary: { value: "c1" },
           checkout: { value: "/nonexistent" }, branch: { value: "tidy-parse-1" }, expected: { value: "real_bug" }
    input  canary_plant: "cp1", canary: { value: "c1" }, judgment: { value: "real_bug" }
    expect emits: ["CanaryCaught"]
  end

  test "Miss refuses a plant the review did not pass clean" do
    tests "Miss", on: "CanaryPlant"
    setup  "Agents::CanaryPlant.Open", submission: { value: "cp2" }, canary: { value: "c1" },
           checkout: { value: "/nonexistent" }, branch: { value: "tidy-parse-2" }, expected: { value: "real_bug" }
    input  canary_plant: "cp2", canary: { value: "c1" }, judgment: { value: "real_bug" }
    expect refused: "the review passed the planted bug clean"
  end

  test "Mistake refuses a plant given the expected finding" do
    tests "Mistake", on: "CanaryPlant"
    setup  "Agents::CanaryPlant.Open", submission: { value: "cp3" }, canary: { value: "c1" },
           checkout: { value: "/nonexistent" }, branch: { value: "tidy-parse-3" }, expected: { value: "real_bug" }
    input  canary_plant: "cp3", canary: { value: "c1" }, judgment: { value: "real_bug" }
    expect refused: "the review gave neither clean nor the expected finding"
  end

  test "Tick refuses inside the window since the last plant" do
    tests "Tick", on: "CanaryCadence"
    setup  "Agents::CanaryCadence.Open", cadence: { value: "canary" }
    setup  "Agents::CanaryCadence.Tick", canary_cadence: "canary", now: { value: 100_000 }
    input  canary_cadence: "canary", now: { value: 100_100 }
    expect refused: "the window since the last plant has passed"
  end

  test "Attempt holds a session's first script when no hecks command ran" do
    tests "Attempt", on: "Script"
    input  session: { value: "s1" }, role: { value: "coder" }, asked: { value: "ruby -e 1" }
    expect emits: ["ScriptAttempted", "ScriptHeld"]
  end

  test "Attempt runs a script held once when it is asked again" do
    tests "Attempt", on: "Script"
    setup  "Agents::Script.Attempt", session: { value: "s2" }, role: { value: "coder" }, asked: { value: "ruby -e 1" }
    input  session: { value: "s2" }, role: { value: "coder" }, asked: { value: "ruby -e 1" }
    expect emits: ["ScriptAttempted", "ScriptRun"]
  end

  test "Attempt runs a script after a hecks command" do
    tests "Attempt", on: "Script"
    setup  "Agents::Script.NoteHecks", session: { value: "s3" }
    input  session: { value: "s3" }, role: { value: "coder" }, asked: { value: "python3 x.py" }
    expect emits: ["ScriptAttempted", "ScriptRun"]
  end

  test "Hold refuses a script after a hecks command" do
    tests "Hold", on: "Script"
    setup  "Agents::Script.NoteHecks", session: { value: "s4" }
    input  script: "s4", command: { value: "ruby -e 1" }
    expect refused: "no hecks command ran since the last script"
  end

  test "Finish records committed_not_pushed as the turn's landing state" do
    tests "Finish", on: "Turn"
    input  run: { value: "r-cnp" }, role: { value: "coder" }, at: { value: "2026-11-20T10:00:00Z" },
           verdict: { value: "routed" }, landing_state: { value: "committed_not_pushed" }
    expect landing_state: { value: "committed_not_pushed" }
  end

  test "Finish refuses a landing state it does not know" do
    tests "Finish", on: "Turn"
    input  run: { value: "r-bad" }, role: { value: "coder" }, at: { value: "2026-11-20T10:00:00Z" },
           verdict: { value: "routed" }, landing_state: { value: "somewhere" }
    expect refused: "a landing state is landed, pushed_not_landed, committed_not_pushed or uncommitted"
  end

  test "Receive refuses a message that is not sent" do
    tests "Receive", on: "Message"
    setup  "Agents::Message.Send", message: { value: "m2" }, recipient: { value: "run-a" }, sender: { value: "miette" },
           kind: { value: "question" }, body: { value: "how is it going" }
    input  message: { value: "m2" }, reader: { value: "run-a" }
    expect refused: "Receive refused — status is \"refused\", and Receive moves it only from \"sent\""
  end

  test "Record refuses a sound verdict whose findings say nothing was checked" do
    tests "Record", on: "PlanReview"
    input  run: { value: "r-nc1" }, work: { value: "w-nc1" }, verdict: { value: "sound" },
           findings: "Nothing was checked: the diff could not be read."
    expect refused: "a review that checked nothing is not judged sound, changes or rethink"
  end

  test "Record keeps an unverified verdict for a review that checked nothing" do
    tests "Record", on: "PlanReview"
    input  run: { value: "r-nc2" }, work: { value: "w-nc2" }, verdict: { value: "unverified" },
           findings: "Nothing was checked: the diff could not be read."
    expect verdict: { value: "unverified" }
  end
end
