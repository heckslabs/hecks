# The Triage bluebook, bound so it boots standing alone (a behaviors or model_check boot of this
# directory). It persists in Memory like every tooling domain. The ports it shares with every
# attaching hecksagon are in triage.ports.hecksagon.
Hecks.hecksagon "Triage" do
  attaches "Governance"
  persisted_by "Memory"

  # The red flag's own events, as the Hecks domain records them: a raised flag opens an incident
  # and a noted run joins it.
  subscribe "Hecks.RedFlagRaised"
  subscribe "Hecks.RedFlagRunNoted"
  subscribe "Hecks.RedFlagCleared"
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
