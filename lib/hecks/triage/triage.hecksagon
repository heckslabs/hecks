# The Triage bluebook, bound so it boots standing alone (a behaviors or model_check boot of this
# directory). It persists in Memory like every tooling domain.
Hecks.hecksagon "Triage" do
  attaches "Governance"
  persisted_by "Memory"

  # CI's verdicts on a pushed commit, as the Hecks domain's Integration aggregate records them: a
  # red one opens an incident.
  subscribe "Hecks.CiFailed"
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
