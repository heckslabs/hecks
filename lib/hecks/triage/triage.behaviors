Hecks.behaviors "Triage" do
  vision "A red main is one incident: its failing jobs are grouped into causes, each cause is held by one coder at a time, and the incident closes when CI is green on the fix."

  # `triage.hecksagon` binds every aggregate to Memory and attaches Governance. The shapes below are
  # main's own: the head and run are CI run 41562200680 of 364303e81f50, the jobs are its failing jobs
  # as `gh run view --json jobs` lists them (databaseId), and the batch is the commits that followed
  # the last green head d7b6a769e1cf.
  loads "triage.bluebook", "triage.hecksagon"

  test "Open names the head, the CI run, the last green head and the batch since it" do
    tests "Open", on: "Incident"
    input incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" }, ci_run: { value: "41562200680" },
          last_green: { value: "d7b6a769e1cf2ce7bbcd01d63fb1243981bcb728" }, releases: { value: 0 },
          batch: [{ value: "3bc258e9cfa22623d234b02d104a55f9e56be813" }, { value: "90b1d7e097c264b4d84a7a30c9b4eec472679f42" }]
    expect emits: ["IncidentOpened"], status: "open"
  end

  test "a repeat red on the same head joins the open incident and opens no second one" do
    tests "Open", on: "Incident"
    setup "Triage::Incident.Open", incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" }, ci_run: { value: "41562200680" }
    input incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" }, ci_run: { value: "41564381698" }
    expect refused: "already"
  end

  test "Join notes another red run on the open incident" do
    tests "Join", on: "Incident"
    setup "Triage::Incident.Open", incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" }, ci_run: { value: "41562200680" }
    input incident: "364303e81f5008d89914b6defd4b97ffa484e981", ci_run: { value: "41564381698" }
    expect emits: ["IncidentJoined"], status: "open"
  end

  test "Restore returns main to the last green head's tree" do
    tests "Restore", on: "Incident"
    setup "Triage::Incident.Open", incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" }, ci_run: { value: "41562200680" }
    input incident: "364303e81f5008d89914b6defd4b97ffa484e981", restored: { value: "8d47c583b36f23034ef051e6bfa17188de1087d2" },
          tree_match: { value: "yes" }, last_green: { value: "d7b6a769e1cf2ce7bbcd01d63fb1243981bcb728" }, releases: { value: 0 }
    expect emits: ["IncidentRestored"], status: "restored"
  end

  test "Restore refuses a batch that holds a release commit, by name" do
    tests "Restore", on: "Incident"
    setup "Triage::Incident.Open", incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" }, ci_run: { value: "41562200680" }
    input incident: "364303e81f5008d89914b6defd4b97ffa484e981", restored: { value: "f59c83b3e6d2b677f60c19fb9cccc6e7d38ccbac" },
          tree_match: { value: "yes" }, last_green: { value: "d7b6a769e1cf2ce7bbcd01d63fb1243981bcb728" }, releases: { value: 1 }
    expect refused: "a batch holding a release commit is not restored"
  end

  test "Restore refuses when no green head is recorded" do
    tests "Restore", on: "Incident"
    setup "Triage::Incident.Open", incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" }, ci_run: { value: "41562200680" }
    input incident: "364303e81f5008d89914b6defd4b97ffa484e981", restored: { value: "8d47c583b36f23034ef051e6bfa17188de1087d2" },
          tree_match: { value: "yes" }, last_green: { value: "" }, releases: { value: 0 }
    expect refused: "a green head is recorded before the tree is restored"
  end

  # Five failing jobs of run 41562200680, three signatures: the two parity builds, the two parser
  # jobs, and one rspec shard. One cause is named for each signature, with the jobs that carry it.
  test "five failing jobs of three signatures open three causes" do
    tests "Unclaimed", on: "Cause", kind: :query
    setup "Triage::FailedJob.Report", job: { value: "125675178975" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          name: { value: "rspec_rust_io_build (parity banking)" }, signature: { value: "rspec_rust_io_build parity" }
    setup "Triage::FailedJob.Report", job: { value: "125675179094" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          name: { value: "rspec_rust_io_build (parity rest)" }, signature: { value: "rspec_rust_io_build parity" }
    setup "Triage::FailedJob.Report", job: { value: "125675236391" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          name: { value: "rspec_rust_parser_impl / rspec_rust_parser" }, signature: { value: "rspec_rust_parser" }
    setup "Triage::FailedJob.Report", job: { value: "125675524486" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          name: { value: "rspec_rust_parser" }, signature: { value: "rspec_rust_parser" }
    setup "Triage::FailedJob.Report", job: { value: "125675455183" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          name: { value: "rspec_impl / rspec_shard (6)" }, signature: { value: "rspec_shard" }
    setup "Triage::Cause.Name", cause: { value: "parity" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          signature: { value: "rspec_rust_io_build parity" }, jobs: [{ value: "125675178975" }, { value: "125675179094" }],
          project: { value: "hecks" }
    setup "Triage::Cause.Name", cause: { value: "parser" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          signature: { value: "rspec_rust_parser" }, jobs: [{ value: "125675236391" }, { value: "125675524486" }],
          project: { value: "hecks" }
    setup "Triage::Cause.Name", cause: { value: "shard" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          signature: { value: "rspec_shard" }, jobs: [{ value: "125675455183" }], project: { value: "hecks" }
    expect count: 3
  end

  test "Name refuses a cause with no signature" do
    tests "Name", on: "Cause"
    input cause: { value: "blank" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          signature: { value: "" }, jobs: [{ value: "125675455183" }], project: { value: "hecks" }
    expect refused: "a cause has a signature"
  end

  test "a cause with a matching lesson cites it" do
    tests "Name", on: "Cause"
    input cause: { value: "shard" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          signature: { value: "rspec_shard" }, jobs: [{ value: "125675455183" }], project: { value: "hecks" },
          lesson: { value: "lesson-spec-shard-order" }
    expect emits: %w[CauseNamed CauseMatchedLesson]
  end

  test "a cause with no matching lesson is reported as a gap" do
    tests "Name", on: "Cause"
    input cause: { value: "shard" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          signature: { value: "rspec_shard" }, jobs: [{ value: "125675455183" }], project: { value: "hecks" }
    expect emits: %w[CauseNamed CauseGapReported]
  end

  test "Assign gives the cause to one session and the incident starts to be fixed" do
    tests "Assign", on: "Cause"
    setup "Triage::Incident.Open", incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" }, ci_run: { value: "41562200680" }
    setup "Triage::Cause.Name", cause: { value: "shard" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          signature: { value: "rspec_shard" }, jobs: [{ value: "125675455183" }], project: { value: "hecks" }
    input cause: "shard", incident: "364303e81f5008d89914b6defd4b97ffa484e981", coder: { value: "551cebfb" }, work: { value: "red-ci-shard" },
          session_project: { value: "hecks" }, project: { value: "hecks" }, condition: { value: "idle" }
    expect emits: %w[CauseAssigned IncidentMending], status: "assigned"
  end

  test "a second coder is never assigned to a cause that is held" do
    tests "Assign", on: "Cause"
    setup "Triage::Incident.Open", incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" }, ci_run: { value: "41562200680" }
    setup "Triage::Cause.Name", cause: { value: "shard" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          signature: { value: "rspec_shard" }, jobs: [{ value: "125675455183" }], project: { value: "hecks" }
    setup "Triage::Cause.Assign", cause: "shard", incident: "364303e81f5008d89914b6defd4b97ffa484e981", coder: { value: "551cebfb" }, work: { value: "red-ci-shard" },
          session_project: { value: "hecks" }, project: { value: "hecks" }, condition: { value: "idle" }
    input cause: "shard", incident: "364303e81f5008d89914b6defd4b97ffa484e981", coder: { value: "66ab1fee" }, work: { value: "red-ci-shard" },
          session_project: { value: "hecks" }, project: { value: "hecks" }, condition: { value: "idle" }
    expect refused: "assigned"
  end

  test "a working session is never assigned" do
    tests "Assign", on: "Cause"
    setup "Triage::Cause.Name", cause: { value: "shard" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          signature: { value: "rspec_shard" }, jobs: [{ value: "125675455183" }], project: { value: "hecks" }
    input cause: "shard", incident: "364303e81f5008d89914b6defd4b97ffa484e981", coder: { value: "551cebfb" }, work: { value: "red-ci-shard" },
          session_project: { value: "hecks" }, project: { value: "hecks" }, condition: { value: "working" }
    expect refused: "a working session is not assigned"
  end

  test "a session on another project is never assigned" do
    tests "Assign", on: "Cause"
    setup "Triage::Cause.Name", cause: { value: "shard" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          signature: { value: "rspec_shard" }, jobs: [{ value: "125675455183" }], project: { value: "hecks" }
    input cause: "shard", incident: "364303e81f5008d89914b6defd4b97ffa484e981", coder: { value: "e851410a" }, work: { value: "red-ci-shard" },
          session_project: { value: "miette" }, project: { value: "hecks" }, condition: { value: "idle" }
    expect refused: "a session on another project is not assigned"
  end

  test "an unclaimed cause returns to the pool once its window has passed" do
    tests "Return", on: "Cause"
    setup "Triage::Incident.Open", incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" }, ci_run: { value: "41562200680" }
    setup "Triage::Cause.Name", cause: { value: "shard" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          signature: { value: "rspec_shard" }, jobs: [{ value: "125675455183" }], project: { value: "hecks" }
    setup "Triage::Cause.Assign", cause: "shard", incident: "364303e81f5008d89914b6defd4b97ffa484e981", coder: { value: "551cebfb" }, work: { value: "red-ci-shard" },
          session_project: { value: "hecks" }, project: { value: "hecks" }, condition: { value: "idle" }
    input cause: "shard", quiet_for: { value: 1200 }, window: { value: 900 }
    expect emits: ["CauseReturned"], status: "returned"
  end

  test "a claim is not returned before its window has passed" do
    tests "Return", on: "Cause"
    setup "Triage::Incident.Open", incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" }, ci_run: { value: "41562200680" }
    setup "Triage::Cause.Name", cause: { value: "shard" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          signature: { value: "rspec_shard" }, jobs: [{ value: "125675455183" }], project: { value: "hecks" }
    setup "Triage::Cause.Assign", cause: "shard", incident: "364303e81f5008d89914b6defd4b97ffa484e981", coder: { value: "551cebfb" }, work: { value: "red-ci-shard" },
          session_project: { value: "hecks" }, project: { value: "hecks" }, condition: { value: "idle" }
    input cause: "shard", quiet_for: { value: 300 }, window: { value: 900 }
    expect refused: "a claim returns only after its window has passed"
  end

  test "CI green on the last fix closes the incident" do
    tests "Fix", on: "Cause"
    setup "Triage::Incident.Open", incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" }, ci_run: { value: "41562200680" }
    setup "Triage::Cause.Name", cause: { value: "shard" }, incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" },
          signature: { value: "rspec_shard" }, jobs: [{ value: "125675455183" }], project: { value: "hecks" }
    setup "Triage::Cause.Assign", cause: "shard", incident: "364303e81f5008d89914b6defd4b97ffa484e981", coder: { value: "551cebfb" }, work: { value: "red-ci-shard" },
          session_project: { value: "hecks" }, project: { value: "hecks" }, condition: { value: "idle" }
    input cause: "shard", incident: "364303e81f5008d89914b6defd4b97ffa484e981", commit: { value: "8d47c583b36f23034ef051e6bfa17188de1087d2" },
          unfixed: { value: 0 }, conclusion: { value: "success" }
    expect emits: %w[CauseFixed IncidentClosed], status: "fixed"
  end

  test "Close refuses while a cause is still unfixed" do
    tests "Close", on: "Incident"
    setup "Triage::Incident.Open", incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" }, ci_run: { value: "41562200680" }
    input incident: "364303e81f5008d89914b6defd4b97ffa484e981", unfixed: { value: 1 }, conclusion: { value: "success" }
    expect refused: "every cause of the incident is fixed"
  end

  test "Close refuses a fix whose CI run is not green" do
    tests "Close", on: "Incident"
    setup "Triage::Incident.Open", incident: { value: "364303e81f5008d89914b6defd4b97ffa484e981" }, ci_run: { value: "41562200680" }
    input incident: "364303e81f5008d89914b6defd4b97ffa484e981", unfixed: { value: 0 }, conclusion: { value: "failure" }
    expect refused: "CI on the fix is green"
  end
end
