# The expression and translation grammars, bound so they boot standing
# alone. Both are read-only in practice — Hecks::Grammar parses
# against them — but a binding is declared rather than defaulted.
Hecks.hecksagon "Expression" do
  # Every command here declares `role "Language designer"` — only real
  # access control once Governance can check it against something (S8).
  attaches "Governance"
  persisted_by "Memory"
end

Hecks.hecksagon "Translation" do
  # Same reason as Expression, above — S8.
  attaches "Governance"
  persisted_by "Memory"
end

Hecks.hecksagon "Governance" do
  Governance::RoleAssignment.persisted_by("Memory")
  Governance::RoleTransition.persisted_by("Memory")
end
