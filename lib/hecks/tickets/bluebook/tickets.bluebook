# The Tickets bluebook: what a maintainer observed about Hecks that needs a decision or a fix, the
# and the decisions that settle them.
#
# QualityControl has its own Ticket, the issue raised for a Bug in an outside tracker, and the
# Hecks domain has its own Release, the record of a gem version. A Finding sits before both: it is
# any observation, not yet a proven bug, and it needs no sweep or failing test to be recorded.
#
# A Finding is the record. A gap, a parity divergence, a QA finding and an idea are kinds of it, not
# separate aggregates. Hecks owns the finding's state; GitHub is driven from it through the
# GitHubIssues port, which a hecksagon binds (nothing here reads GitHub back). A finding exists whether
# or not GitHub answers: each lifecycle event asks the port, and a refused ask is recorded on the
# finding as a sync failure that a later run retries.
#
# An Adr is a decision record with its own lifecycle, linked to the finding it settles. A Work is a work item:
# one step of the plan a decision carries, and it stays inside Hecks.
Hecks.bluebook "Tickets" do
  vision "Track what Hecks needs, decide it, ship it, and drive GitHub from the record."

  aggregate "Finding" do
    description "One thing observed about Hecks that needs a decision or a fix: reported, triaged, then resolved or dismissed."
    created_by "Finding.report!"

    attribute :finding,         FindingKey
    attribute :title,          Title
    attribute :body,           Body, optional: true
    attribute :kind,           Kind, optional: true
    attribute :severity,       Severity, optional: true
    attribute :source,         Source
    attribute :fingerprint,    Fingerprint, optional: true
    attribute :issue_number,   Number, optional: true
    attribute :fix_pr_number,  Number, optional: true
    attribute :dismissal,      Body, optional: true
    attribute :sync_failure,   Body, optional: true
    attribute :stage,          Stage, optional: true
    attribute :commit,         Commit, optional: true
    identified_by :finding

    # Where a stopped run or shipment stood when it was reported: the state it parked in, or the
    # step that faulted. A finding not about a run has none.
    value_object "Stage" do
      attribute :value, String, matches: :present
    end

    # The commit a stopped integration run was keyed by, as a plain string.
    value_object "Commit" do
      attribute :value, String, matches: :present
    end

    value_object "FindingKey" do
      attribute :value, String, matches: :present

      invariant("a finding is named") { !value.to_s.empty? }
    end

    value_object "Title" do
      attribute :value, String

      invariant("a finding has a title") { !value.to_s.empty? }
    end

    value_object "Body", String

    # What the finding is: a `gap` Hecks cannot yet express, a `parity` divergence between the Ruby
    # and Rust runtimes, a `qa` finding from the QA loop, or an `idea`.
    value_object "Kind" do
      attribute :value, String, one_of: ["gap", "parity", "qa", "idea"]
    end

    value_object "Severity" do
      attribute :value, String, one_of: ["low", "medium", "high"]
    end

    # Where it came from: the QA loop, work for a client, a parity check, a maintainer by hand, or
    # the delivery pipeline, when an integration run or a shipment stopped for a person.
    value_object "Source" do
      attribute :value, String, one_of: ["qa_loop", "client_work", "parity_check", "maintainer", "pipeline"]
    end

    # The same finding refiled by the QA loop carries the same fingerprint, so a report of it while an
    # open finding holds it changes nothing.
    value_object "Fingerprint" do
      attribute :value, String, matches: :present
    end

    value_object "Number" do
      attribute :value, Integer

      invariant("a number is positive") { value.positive? }
    end

    lifecycle :status, default: "reported" do
      transition "Triage"  => "triaged",   from: %w[reported triaged]
      transition "Resolve" => "resolved",  from: "triaged"
      transition "Dismiss" => "dismissed", from: %w[reported triaged]
      transition "Reopen"  => "triaged",   from: %w[resolved dismissed]
    end

    command "Report" do
      goal "Record something observed about Hecks as a finding"

      attribute :finding,      FindingKey, sets: true
      attribute :title,       Title, sets: true
      attribute :body,        Body, optional: true, sets: true
      attribute :source,      Source, sets: true
      attribute :fingerprint, Fingerprint, optional: true, sets: true


      emits "FindingReported"
    end

    # A failed Codebase run reports itself: the run's key names the finding and doubles as its
    # fingerprint, so the same run failing again while its finding is open changes nothing.
    command "ReportFailedRun" do
      goal "Record a failed conformance or gate run as a finding"

      attribute :finding, FindingKey, sets: true
      attribute :body,   Body, sets: true

      sets :fingerprint, to: "run"
      sets :title,  to: "A Codebase run failed"
      sets :source, to: "qa_loop"

      emits "RunFindingReported"
    end

    # An integration run or a shipment that stopped for a person reports itself: the run's key names
    # the finding, so it is filed once per run and names the first stop only. A later stop of the
    # same run (parked again after it was taken up) is refused as already reported and files
    # nothing; the finding keeps the first stage and reason. It opens no GitHub issue: the pipeline
    # board lists the open ones.
    command "ReportStoppedRun" do
      goal "Record that an integration run or a shipment stopped for a person, with the stage and the reason"

      attribute :finding, FindingKey, sets: true
      attribute :body,    Body, sets: true
      attribute :stage,   Stage, sets: true
      attribute :commit,  Commit, optional: true, sets: true

      sets :fingerprint, to: :finding
      sets :title,  to: "A run stopped for a person"
      sets :source, to: "pipeline"

      emits "StoppedRunReported"
    end

    command "Triage" do
      role "Maintainer"
      goal "Give a finding its kind and severity"

      reference_to Finding
      attribute :kind,     Kind, sets: true
      attribute :severity, Severity, sets: true


      emits "FindingTriaged"
    end

    command "LinkFix" do
      role "Maintainer"
      goal "Record the pull request that fixes a triaged finding"

      reference_to Finding
      attribute :fix_pr_number, Number, sets: true


      emits "FixLinked"
    end

    command "Resolve" do
      role "Maintainer"
      goal "Close a triaged finding as resolved"

      reference_to Finding

      emits "FindingResolved"
    end

    command "Dismiss" do
      role "Maintainer"
      goal "Close a finding without a fix, with the reason"

      reference_to Finding
      attribute :dismissal, Body, sets: true


      emits "FindingDismissed"
    end

    command "Reopen" do
      role "Maintainer"
      goal "Take a resolved or dismissed finding back to triaged, as when a fix regresses"

      reference_to Finding

      emits "FindingReopened"
    end

    command "RecordIssue" do
      goal "Record the GitHub issue number once the issue is opened"
      audience :record

      reference_to Finding
      attribute :issue_number, Number, sets: true


      emits "IssueRecorded"
    end

    command "RecordSyncFailure" do
      goal "Record that GitHub could not be driven, so a later run retries"
      audience :record

      reference_to Finding
      attribute :sync_failure, Body, sets: true


      emits "SyncFailed"
    end

    query "Open" do
      description "Every finding not yet resolved or dismissed."
      where(status: { in: "reported,triaged" })
      order_by :finding
    end

    # A log of stops, not a count of runs stopped now: a run taken up again keeps its finding open
    # until a person resolves or dismisses it.
    query "Stopped" do
      description "Every open finding a stopped integration run or shipment filed."
      where(source: "pipeline", status: { in: "reported,triaged" })
      order_by :finding
    end
  end

  # The decision records are their files under docs/decisions, read through the DecisionFiles
  # persistence adapter the Tickets hecksagon binds (tickets.ports.hecksagon). The adapter hands
  # over what a record says: its number, title, path, the first words of its status line, its date,
  # and the decisions it says it supersedes or narrows. The `StatusWord` rows say which lifecycle
  # status a first word means; the adapter only reads them. A record is superseded or narrowed by
  # every record that says it supersedes or narrows it, whether or not its own status line says so:
  # `superseded_by` and `narrowed_by` are that derivation. A store read from files takes no write:
  # Draft, Accept and Supersede are refused by name there until writing the status line back is
  # built, so `LapseWorkWhenSuperseded` fires only in a Memory boot (a store named no directory).
  aggregate "Adr" do
    description "A decision record read from its file under docs/decisions: its status, date, the decisions it supersedes or narrows and those that supersede or narrow it, linked to the finding it settles."
    created_by "Adr.draft!"

    attribute :adr,           AdrNumber
    attribute :title,         AdrTitle
    attribute :path,          RecordPath, optional: true
    attribute :wording,       StatusWording, optional: true
    attribute :date,          DecisionDate, optional: true
    attribute :supersedes,    list_of(AdrNumber), optional: true
    attribute :superseded_by, list_of(AdrNumber), optional: true
    attribute :narrows,       list_of(AdrNumber), optional: true
    attribute :narrowed_by,   list_of(AdrNumber), optional: true
    reference_to Finding, as: :settles, optional: true
    identified_by :adr

    # Four digits; a letter when a record was split (0054a); NNNN/NN for a record under a numbered
    # directory (0064/02).
    value_object "AdrNumber" do
      attribute :value, String, pattern: '\A[0-9]{4}[a-z]?(?:/[0-9]{2})?\z'
    end

    value_object "AdrTitle" do
      attribute :value, String

      invariant("a decision has a title") { !value.to_s.empty? }
    end

    # The record's file, relative to the checkout.
    value_object "RecordPath", String

    # The first words of the status line, as written: "Accepted", "Proposed", "Shipped".
    value_object "StatusWording", String

    # The date the status line gives, YYYY-MM-DD.
    value_object "DecisionDate" do
      attribute :value, String, pattern: '\A[0-9]{4}-[0-9]{2}-[0-9]{2}\z'
    end

    # Which lifecycle status the first word of a status line means, compared without case. A
    # record whose first word no row names is not loaded, and the adapter says so by name.
    value_object "StatusWord" do
      attribute :word,   String
      attribute :status, String

      member word: "Accepted",     status: "accepted"
      member word: "Adopted",      status: "accepted"
      member word: "Built",        status: "accepted"
      member word: "Decided",      status: "accepted"
      member word: "Executed",     status: "accepted"
      member word: "Fixed",        status: "accepted"
      member word: "Investigated", status: "accepted"
      member word: "Partly",       status: "accepted"
      member word: "Resolved",     status: "accepted"
      member word: "Shipped",      status: "accepted"
      member word: "In",           status: "draft"
      member word: "Open",         status: "draft"
      member word: "Proposed",     status: "draft"
      member word: "Scoping",      status: "draft"
      member word: "Superseded",   status: "superseded"
    end

    lifecycle :status, default: "draft" do
      transition "Accept"    => "accepted",   from: "draft"
      transition "Supersede" => "superseded", from: "accepted"
      mark :terminal, "superseded"
    end

    command "Draft" do
      role "Maintainer"
      goal "Open a decision record, optionally for the finding it settles; a store read from docs/decisions refuses it: write the file"

      attribute :adr,       AdrNumber, sets: true
      attribute :title,     AdrTitle, sets: true
      reference_to Finding, as: :settles, optional: true

      sets :settles

      emits "AdrDrafted"
    end

    command "Accept" do
      role "Maintainer"
      goal "Record that the decision was accepted; a store read from docs/decisions refuses it: edit the file's status line"

      reference_to Adr

      emits "AdrAccepted"
    end

    command "Supersede" do
      role "Maintainer"
      goal "Record the later decisions that replace this one; a store read from docs/decisions refuses it: edit the file's status line"

      reference_to Adr
      attribute :superseded_by, list_of(AdrNumber), sets: true

      emits "AdrSuperseded"
    end

    query "Standing" do
      description "Every decision whose own status line says it is accepted (shipped, fixed, resolved) and not superseded."
      where(status: "accepted")
      order_by :adr
    end

    query "Drafted" do
      description "Every decision record still proposed, not yet accepted or superseded."
      where(status: "draft")
      order_by :adr
    end

    query "Superseded" do
      description "Every decision a later one says it supersedes, in whole or in part, with the decisions that did, whether or not its own status line says so."
      where(superseded_by: { ne: [] })
      order_by :adr
    end

    query "Narrowed" do
      description "Every decision a later one says it narrows, with the decisions that did."
      where(narrowed_by: { ne: [] })
      order_by :adr
    end
  end

  # An epic: a body of work with an outcome and an end. Its members are the work items that name it;
  # its status is read from them (the EpicMembers port counts, the policies below move it), so nobody
  # sets it by hand. A Category stays a label beside it.
  aggregate "Epic" do
    description "One body of work with an outcome: open until every member is done or dropped, complete then, open again when one returns."
    created_by "Epic.open!"

    attribute :epic,    EpicKey
    attribute :title,   EpicTitle
    attribute :outcome, EpicOutcome
    attribute :tier,    EpicTier, optional: true
    attribute :measure,  MeasureName, optional: true
    attribute :evidence, Evidence, optional: true
    reference_to Adr, as: :decision, optional: true
    identified_by :epic

    value_object "EpicKey" do
      attribute :value, String, matches: :present
    end

    value_object "EpicTitle" do
      attribute :value, String

      invariant("an epic has a title") { !value.to_s.empty? }
    end

    # One sentence saying what is true when the epic is finished.
    value_object "EpicOutcome" do
      attribute :value, String

      invariant("an epic states its outcome") { !value.to_s.empty? }
    end

    # How soon the epic is wanted, 1 to 9: the lower, the sooner. An epic nobody ranked has none.
    value_object "EpicTier" do
      attribute :value, Integer

      invariant("an epic tier is from 1 to 9") { value >= 1 && value <= 9 }
    end

    # How many work items name the epic, or how many of them are still planned or started.
    value_object "MemberCount" do
      attribute :value, Integer

      invariant("a member count is not negative") { !value.negative? }
    end

    # The `OutcomeMeasure` row an epic's outcome is measured by. An epic that names none never completes.
    value_object "MeasureName" do
      attribute :value, String
    end

    # What the last measurement read, in words: the number, the events counted and the bounds; or why
    # nothing could be read.
    value_object "Evidence" do
      attribute :value, String
    end

    # A number read from the event tap, or a bound on one.
    value_object "Reading" do
      attribute :value, Integer

      invariant("a reading is not negative") { !value.negative? }
    end

    # The work item a missed outcome is planned as: `<epic>-outcome-<n>`.
    value_object "EvidenceKey" do
      attribute :value, String, matches: :present
    end

    # One way to measure an outcome, one row each: a number read from the event tap and the bounds it
    # must lie within. `events` (comma separated) of `aggregate` are counted over the last `minutes`.
    # `per: "id"` reads the most lines one aggregate id records inside any `span` minutes, in place of
    # the count of all. `at_least` is 0 and `at_most` unbounded when the row leaves them out. The
    # OutcomeReadings port reads the number; `Epic.Complete` and `Epic.Miss` compare it with the
    # bounds. A row with only `at_most: 0` is met by an hour in which nothing ran: pair an epic with
    # the row that counts what its outcome produces when one exists.
    value_object "OutcomeMeasure" do
      attribute :measure,   String
      attribute :aggregate, String
      attribute :events,    String
      attribute :minutes,   Integer
      attribute :per,       String
      attribute :span,      Integer
      attribute :at_least,  Integer
      attribute :at_most,   Integer

      # The machine's load never crossed its mark in the hour, whatever number of coders ran.
      member measure: "load-stays-under-its-mark", aggregate: "Hecks::Machine", events: "LoadRoseAbove",
             minutes: 60, at_most: 0
      # No work item was started twice within one minute: the fill did not start what it had started.
      member measure: "no-item-started-twice-a-minute", aggregate: "Tickets::Work", events: "WorkStarted",
             minutes: 60, per: "id", span: 1, at_most: 1
      # Three boarded batches of main were verified in the hour.
      member measure: "main-is-verified-three-times", aggregate: "Hecks::Integration", events: "MainVerified",
             minutes: 60, at_least: 3
      # No train pull request ran out of reruns and was left for a hand.
      member measure: "no-train-pr-is-left-for-a-hand", aggregate: "Hecks::TrainPr", events: "TrainPrExhausted",
             minutes: 60, at_most: 0
      # Two branches landed in the hour.
      member measure: "two-branches-land", aggregate: "Delivery::Landing", events: "BranchLanded",
             minutes: 60, at_least: 2
      # The stall watch filed nothing in the hour: no run sat past its time limit.
      member measure: "no-stall-is-filed", aggregate: "Hecks::Stall", events: "StallFiled",
             minutes: 60, at_most: 0
    end

    lifecycle :status, default: "open" do
      transition "Complete" => "complete", from: "open"
      transition "Reopen"   => "open",     from: "complete"
    end

    command "Open" do
      role "Maintainer"
      goal "Open an epic with its outcome, optionally for the decision it carries out"

      attribute :epic,    EpicKey, sets: true
      attribute :title,   EpicTitle, sets: true
      attribute :outcome, EpicOutcome, sets: true
      reference_to Adr, as: :decision, optional: true

      sets :decision

      emits "EpicOpened"
    end

    # Sent by the CompleteEpicWhenOutcomeRead policy with the counts the EpicMembers port read and the
    # number the OutcomeReadings port read beside its measure's bounds: a `given` sees its own
    # arguments, not the Work items or the tap, so the arguments carry the rules. The rules judge the
    # numbers they are handed; a caller who dispatches it by hand vouches for them.
    command "Complete" do
      goal "Record that every member of the epic is done or dropped and its outcome was measured as met"

      reference_to Epic
      attribute :members,      MemberCount
      attribute :open_members, MemberCount
      attribute :reading,      Reading
      attribute :at_least,     Reading
      attribute :at_most,      Reading
      attribute :evidence,     Evidence, sets: true

      given("an epic with no member does not complete") { members.value.positive? }
      given("an epic with a planned or started member does not complete") { open_members.value.zero? }
      given("an outcome read under its least does not complete") { reading.value >= at_least.value }
      given("an outcome read over its most does not complete") { reading.value <= at_most.value }

      emits "EpicCompleted"
    end

    # The twin of Complete for the same reading: sent by MissEpicWhenOutcomeRead, it passes only a
    # reading outside its bounds. It records the evidence and changes no status; the policies on its
    # event plan the evidence as a member and return a complete epic to open.
    command "Miss" do
      goal "Record that the epic's outcome was measured and not met"

      reference_to Epic
      attribute :reading,  Reading
      attribute :at_least, Reading
      attribute :at_most,  Reading
      attribute :evidence, Evidence, sets: true
      attribute :finding,  EvidenceKey

      given("an outcome read within its bounds is not missed") { reading.value < at_least.value || reading.value > at_most.value }

      emits "EpicOutcomeMissed"
    end

    # Names the row the epic's outcome is measured by. Epics are data, so this is a command and no
    # bluebook edit; a name no row carries is refused when the outcome is read.
    command "MeasureBy" do
      role "Maintainer"
      goal "Say which OutcomeMeasure row measures an epic's outcome"

      reference_to Epic
      attribute :measure, MeasureName, sets: true

      given("an epic names its measure") { !measure.value.to_s.strip.empty? }

      emits "EpicMeasureStated"
    end

    # Nothing could be read (no measure named, a name no row carries, no event tap): the epic stays
    # as it is and keeps the reason. It plans no work, since no work item changes what was unread.
    command "LeaveUnmeasured" do
      goal "Record why the epic's outcome could not be measured"

      reference_to Epic
      attribute :evidence, Evidence, sets: true

      emits "EpicLeftUnmeasured"
    end

    # A member closed: the epic is read again. It changes nothing itself; the EpicMembers port's
    # answer completes the epic.
    command "Review" do
      goal "Ask whether every member of the epic is now done or dropped"

      reference_to Epic
      reference_to Work, as: :closed, optional: true

      emits "EpicReviewed"
    end

    command "Reopen" do
      goal "Return a complete epic to open because a member returned"

      reference_to Epic
      reference_to Work, as: :returned, optional: true

      emits "EpicReopened"
    end

    # Changes the title only (not the Work.Revise counterpart); the key, outcome, decision and status stay,
    # so a work item's epic link keeps working. It is a plain set, not a transition, so any state allows it.
    command "Retitle" do
      role "Maintainer"
      goal "Change an epic's title, in any state, keeping its key"

      reference_to Epic
      attribute :title, EpicTitle, sets: true

      given("an epic has a title") { !title.value.to_s.strip.empty? }

      emits "EpicRetitled"
    end

    # Sets the tier only; the title, outcome, decision and status stay as they were.
    command "Rank" do
      role "Maintainer"
      goal "Say how soon an epic is wanted, from 1 (soonest) to 9"

      reference_to Epic
      attribute :tier, EpicTier, sets: true

      given("an epic tier is from 1 to 9") { tier.value >= 1 && tier.value <= 9 }

      emits "EpicRanked"
    end

    # The board's epic list: every epic, lowest tier first (one sort key, so epics of a tier keep the
    # order the store holds them in).
    query "Ranked" do
      description "Every epic with its tier, lowest tier first."
      order_by :tier
    end
  end

  # A work item: one planned, started or done piece of Work, keyed by its id and held under the
  # decision it carries out. It drives nothing outside: planned work is the maintainer's own list, not
  # an issue.
  aggregate "Work" do
    description "One work item: a planned, started or done piece of Work, keyed by its id, under the decision it carries out."
    created_by "Work.plan!"

    attribute :work,   WorkKey
    attribute :title,  WorkTitle
    attribute :detail, WorkText, optional: true
    attribute :step,   Step, optional: true
    attribute :reason, WorkText, optional: true
    attribute :yield_kind, WorkText, optional: true
    attribute :retry_at, WorkText, optional: true
    attribute :yield_count, YieldCount, optional: true
    attribute :claimed_by, Claimant, optional: true
    attribute :claimed_at, ClaimedAt, optional: true
    attribute :area,   list_of(Word), optional: true
    attribute :budget_minutes, Minutes, optional: true
    attribute :category, Category, optional: true
    reference_to Epic, as: :epic, optional: true
    attribute :priority, Priority, optional: true
    reference_to Adr, as: :decision, optional: true
    identified_by :work

    # A path prefix or glob a claim covers. Two areas overlap by `Hecks::Adapters::AreaOverlap`;
    # a work item with no area claims nothing.
    value_object "Word" do
      attribute :value, String, matches: :present
    end

    # What a query answered from outside the domain returns: its lines.
    value_object "Document" do
      attribute :text, String
    end

    # The session that claimed a started work item, named as the session names itself. One back in
    # the plan holds the empty claimant; `Start` refuses one that names nobody.
    value_object "Claimant" do
      attribute :value, String, default: ""
    end

    # When the claim was taken, as the caller reads the clock: an ISO 8601 instant. Empty while the
    # work item is unclaimed.
    value_object "ClaimedAt" do
      attribute :value, String, default: ""
    end

    # How long a claim may run, in whole minutes. A work item with none, or zero, has no budget; one
    # back in the plan holds zero.
    value_object "Minutes" do
      attribute :value, Integer

      invariant("a time budget is not negative") { !value.negative? }
    end

    # How many lines a report prints.
    value_object "Rows" do
      attribute :value, Integer

      invariant("a report prints at least one line") { value.positive? }
    end

    # How many columns a report fits.
    value_object "Columns" do
      attribute :value, Integer

      invariant("a report is at least forty columns wide") { value >= 40 }
    end

    value_object "WorkKey" do
      attribute :value, String, matches: :present

      invariant("a piece of work is named") { !value.to_s.empty? }
    end

    value_object "WorkTitle" do
      attribute :value, String

      invariant("a piece of work has a title") { !value.to_s.empty? }
    end

    value_object "WorkText", String

    # How many times a work item has been sent back to the plan; its backoff grows with it.
    value_object "YieldCount" do
      attribute :value, Integer

      invariant("a yield count is not negative") { !value.negative? }
    end

    # Where the work stands in its plan: step 0 comes first.
    value_object "Step" do
      attribute :value, Integer

      invariant("a step is not negative") { !value.negative? }
    end

    # What kind of work an item is, or which theme it belongs to (the last eight values), one per item. It never decides whether two items clash: that is the
    # path claim in `area`.
    value_object "Category" do
      attribute :value, String, one_of: %w[bluebook-gap language delivery coder parity host tooling agent-roles-and-handoff autonomous-pipeline pipeline-board landing-review-and-train bluebook-gaps-and-tool-dissolve kernel-parity-and-simulation docs-and-interviews side-projects]
    end

    # How soon an item is wanted. Unset means nobody has said.
    value_object "Priority" do
      attribute :value, String, one_of: %w[now next later]
    end

    lifecycle :status, default: "planned" do
      transition "Start"   => "started", from: "planned"
      transition "Release" => "planned", from: "started"
      transition "Yield"   => "planned", from: "started"
      transition "Finish" => "done",    from: %w[planned started]
      transition "Drop"   => "dropped", from: %w[planned started]
      transition "Lapse"  => "dropped", from: %w[planned started]
      transition "Reopen" => "planned", from: %w[done dropped]
    end

    command "Plan" do
      role "Maintainer"
      goal "Enter a work item into a plan, optionally under the decision it carries out"

      attribute :work,   WorkKey, sets: true
      attribute :title,  WorkTitle, sets: true
      # The detail and area default to none, so the event always carries them and
      # ComposeBriefWhenPlanned in Coder can read them from any plan.
      attribute :detail, WorkText, optional: true, sets: true, default: { value: "" }
      attribute :step,   Step, optional: true, sets: true
      attribute :area,   list_of(Word), optional: true, sets: true, default: []
      reference_to Adr, as: :decision, optional: true
      # A work item may be born a member of an epic, as the evidence of a missed outcome is.
      reference_to Epic, as: :epic, optional: true

      sets :decision
      sets :epic

      emits "WorkPlanned"
    end

    # A work item still open takes what a later look at it found: its title and detail move and
    # nothing else does. The status, claim, priority, step, area and decision stay as they were.
    # Area and decision move through `Rescope`, `ClearArea` and `Decide`, since a `sets` of a field
    # the caller left out would write it empty.
    command "Revise" do
      goal "Replace an open work item's title and detail, and nothing else"

      reference_to Work
      attribute :title,  WorkTitle, sets: true
      attribute :detail, WorkText, sets: true

      given("a done work item is not revised") { status != "done" }
      given("a dropped work item is not revised") { status != "dropped" }

      emits "WorkRevised"
    end

    # An open work item takes a new area: the whole list is replaced.
    command "Rescope" do
      goal "Replace the area an open work item claims with the given list"

      reference_to Work
      attribute :area, list_of(Word), sets: true

      given("a done work item is not rescoped") { status != "done" }
      given("a dropped work item is not rescoped") { status != "dropped" }

      emits "WorkRescoped"
    end

    # An open work item claims nothing again. An item with no area never overlaps another in
    # Dispatch, so emptying it is a command of its own.
    command "ClearArea" do
      goal "Empty the area an open work item claims"

      reference_to Work

      sets :area, to: []

      given("a done work item has no area to clear") { status != "done" }
      given("a dropped work item has no area to clear") { status != "dropped" }

      emits "WorkAreaCleared"
    end

    # An open work item names the decision it carries out (refused by name when no Adr has that id).
    command "Decide" do
      goal "Name the decision an open work item carries out"

      reference_to Work
      reference_to Adr, as: :decision

      sets :decision

      given("a done work item takes no decision") { status != "done" }
      given("a dropped work item takes no decision") { status != "dropped" }

      emits "WorkDecided"
    end

    # An open work item is sorted into one category. The claim, the step and the area stay as they are.
    command "Categorize" do
      role "Maintainer"
      goal "Sort an open work item into a category"

      reference_to Work
      attribute :category, Category, sets: true

      given("a done or dropped work item takes no category") { status != "done" && status != "dropped" }

      emits "WorkCategorized"
    end

    # An open work item joins one epic (one per item); assigning it again moves it to the other epic.
    command "Assign" do
      role "Maintainer"
      goal "Make an open work item a member of an epic"

      reference_to Work
      reference_to Epic, as: :epic

      sets :epic

      given("a done work item joins no epic") { status != "done" }
      given("a dropped work item joins no epic") { status != "dropped" }

      emits "WorkAssigned"
    end

    # An open work item is given how soon it is wanted. The claim, the step and the area stay as they are.
    command "Prioritize" do
      role "Maintainer"
      goal "Say how soon an open work item is wanted: now, next or later"

      reference_to Work
      attribute :priority, Priority, sets: true

      given("a done or dropped work item takes no priority") { status != "done" && status != "dropped" }

      emits "WorkPrioritized"
    end

    # A started work item is claimed: the second Start on it is refused, since only a planned one
    # starts.
    command "Start" do
      role "Maintainer"
      goal "Claim a planned work item for one session, recording who claimed it and when"

      reference_to Work
      attribute :claimed_by, Claimant, sets: true
      attribute :claimed_at, ClaimedAt, sets: true
      attribute :area,       list_of(Word), optional: true, sets: true
      attribute :budget_minutes, Minutes, optional: true, sets: true

      given("a claim names its claimant") { !claimed_by.value.to_s.empty? }
      given("a claim records when it was taken") { !claimed_at.value.to_s.empty? }

      emits "WorkStarted"
    end

    # A started work item that may not go on goes back to the plan with the refusal as its reason:
    # its area overlapped another started work item's, it would start more work items than the cap
    # allows (the WorkAreas or WorkLimits port refuses it by name), or the architect's review of its
    # plan said rethink and the coder session handed it back.
    command "Yield" do
      goal "Return a started work item to the plan, with the refusal that sent it back"

      reference_to Work
      attribute :reason, WorkText, sets: true
      attribute :yield_kind, WorkText, optional: true, sets: true
      attribute :retry_at, WorkText, optional: true, sets: true
      attribute :yield_count, YieldCount, optional: true, sets: true

      sets :claimed_by, to: ""
      sets :claimed_at, to: ""
      sets :area, to: []
      sets :budget_minutes, to: 0

      emits "WorkYielded"
    end

    # A claim gone stale returns its work item to the plan, so the next session can claim it.
    command "Release" do
      goal "Return a started work item to planned, releasing its claim"

      reference_to Work

      sets :claimed_by, to: ""
      sets :claimed_at, to: ""
      sets :area, to: []
      sets :budget_minutes, to: 0

      emits "WorkReleased"
    end

    command "Finish" do
      role "Maintainer"
      goal "Record that a work item is done"

      reference_to Work

      # A finished item starts a later life from a clean backoff: its yields no longer count.
      sets :yield_kind, to: ""
      sets :retry_at, to: ""
      sets :yield_count, to: 0

      emits "WorkFinished"
    end

    command "Drop" do
      role "Maintainer"
      goal "Set a work item aside without doing it, with the reason"

      reference_to Work
      attribute :reason, WorkText, sets: true

      emits "WorkDropped"
    end

    # A work item whose cause came back (a spec red again after it was cleared) is planned again,
    # with the new title and detail.
    command "Reopen" do
      goal "Return a finished or dropped work item to planned because its cause returned"

      reference_to Work
      attribute :title,  WorkTitle, sets: true
      attribute :detail, WorkText, optional: true, sets: true

      emits "WorkReopened"
    end

    # A superseded decision's plan no longer stands, so its undone work items are dropped with it.
    command "Lapse" do
      goal "Drop a work item whose decision was superseded"

      reference_to Work

      sets :reason, to: "its decision was superseded"

      emits "WorkLapsed"
    end

    query "Undone" do
      description "Every work item not yet done or dropped, in plan order."
      where(status: { in: "planned,started" })
      order_by :step
    end

    # The first work item still planned in plan order: the next one a coder session claims.
    query "NextPlanned" do
      description "The oldest work item not yet claimed, in plan order: the brief a coder session reads next."
      where(status: "planned")
      order_by :step
      limit 1
    end

    # The Dispatching ordering made readable: the port's adapter asks the one ordering Dispatch rolls
    # forward with, and the plan that says why a planned item would wait.
    query "PriorityReport" do
      description "Every open work item in the order Dispatch would start it (red first, then now, next, later, none; by step then id), with why each planned one waits."
      attribute :tier,  String, optional: true
      attribute :limit, Rows, optional: true
      attribute :width, Columns, optional: true
      returns Document
    end

    query "Under" do
      description "Every work item of the plan one decision carries, in plan order."
      attribute :adr, String
      where(decision: :adr)
      order_by :step
    end

    query "UndoneUnder" do
      description "The work items of one decision's plan not yet done or dropped: the ones its superseding drops."
      attribute :adr, String
      where(decision: :adr, status: { in: "planned,started" })
      order_by :step
    end

    query "UndoneInTier" do
      description "Every work item not yet done or dropped that is wanted now, next or later, in plan order."
      attribute :tier, String
      where(priority: :tier, status: { in: "planned,started" })
      order_by :step
    end

    query "UndoneInCategory" do
      description "Every work item not yet done or dropped in one category, in plan order."
      attribute :kind, String
      where(category: :kind, status: { in: "planned,started" })
      order_by :step
    end

    query "UndoneInEpic" do
      description "Every work item not yet done or dropped in one epic, in plan order."
      attribute :epic, String
      where(epic: :epic, status: { in: "planned,started" })
      order_by :step
    end

    # The members counted by what became of them, read and never written: the adapter prints the
    # counts and the next planned member in plan order.
    query "EpicProgress" do
      description "One epic's members counted done, dropped and open, with its next planned item in plan order."
      attribute :epic, String
      returns Document
    end

    # The work item itself, so a policy reading an event of it can reach its epic.
    query "EpicOf" do
      description "The one work item, whose epic a policy reads."
      attribute :work, String
      where(work: :work)
    end

    query "InEpic" do
      description "Every work item of one epic, finished or not, in plan order."
      attribute :epic, String
      where(epic: :epic)
      order_by :step
    end
  end

  # A member closing asks the EpicMembers port whether its epic has a member and none open. An item
  # in no epic asks nothing.
  policy "CheckEpicWhenWorkFinished" do
    on       "Work.WorkFinished"
    for_each "Work.EpicOf"
    trigger  Epic::Review, with: { epic: :epic }
  end

  policy "CheckEpicWhenWorkDropped" do
    on       "Work.WorkDropped"
    for_each "Work.EpicOf"
    trigger  Epic::Review, with: { epic: :epic }
  end

  policy "CheckMembersWhenEpicReviewed" do
    on  "Epic.EpicReviewed"
    ask :check_members, with: { epic: :epic }
  end

  # Cleared members do not complete the epic: its outcome is read first. The OutcomeReadings port
  # answers a number and the bounds of the epic's measure, and both commands below are handed them:
  # their rules pass exactly one, so the epic completes or records a miss.
  policy "ReadOutcomeWhenMembersCleared" do
    on  "Epic.MembersCleared"
    ask :read_outcome, with: { epic: :epic, members: :members, open_members: :open_members }
  end

  policy "CompleteEpicWhenOutcomeRead" do
    on      "Epic.OutcomeRead"
    trigger Epic::Complete, with: { epic: :epic, members: :members, open_members: :open_members, reading: :reading,
                                    at_least: :at_least, at_most: :at_most, evidence: :evidence }
  end

  policy "MissEpicWhenOutcomeRead" do
    on      "Epic.OutcomeRead"
    trigger Epic::Miss, with: { epic: :epic, reading: :reading, at_least: :at_least, at_most: :at_most,
                                evidence: :evidence, finding: :finding }
  end

  # A missed outcome is one new member carrying the evidence, so the epic has open work again; an
  # epic that was complete returns to open (an open one refuses the reopen and stays open).
  policy "PlanEvidenceWhenOutcomeMissed" do
    on      "Epic.EpicOutcomeMissed"
    trigger Work::Plan, with: { work: :finding, title: "An epic's outcome was measured and not met",
                                detail: :evidence, epic: :epic }
  end

  policy "ReopenEpicWhenOutcomeMissed" do
    on      "Epic.EpicOutcomeMissed"
    trigger Epic::Reopen, with: { epic: :epic }
  end

  policy "NoteWhenOutcomeUnread" do
    on      "Epic.OutcomeUnread"
    trigger Epic::LeaveUnmeasured, with: { epic: :epic, evidence: :refusal }
  end

  # A member that returns, or a new open member, reopens a complete epic.
  policy "ReopenEpicWhenMemberReturns" do
    on       "Work.WorkReopened"
    for_each "Work.EpicOf"
    trigger  Epic::Reopen, with: { epic: :epic }
  end

  policy "ReopenEpicWhenMemberAssigned" do
    on      "Work.WorkAssigned"
    trigger Epic::Reopen, with: { epic: :epic }
  end

  # Each lifecycle event drives GitHub. A finding's own state never waits on the answer.
  policy "OpenIssueWhenReported" do
    on      "Finding.FindingReported"
    ask     :open_issue, with: { finding: :finding }
  end

  # Switched off by the Tickets world's `github_issues` setting (`enabled: false`): the ask is
  # refused naming the setting before any GitHub call. PlanWorkWhenRunFindingReported is what
  # makes the run finding a work item.
  policy "OpenIssueWhenRunReported" do
    on      "Finding.RunFindingReported"
    ask     :open_issue, with: { finding: :finding }
  end

  # A run finding is one work item under the run's key; its title is the twin of the one
  # `Finding.ReportFailedRun` sets, which does not ride the event. A run's second report is refused,
  # open or closed, so nothing is planned twice and a finished work item is not planned again.
  policy "PlanWorkWhenRunFindingReported" do
    on      "Finding.RunFindingReported"
    trigger Work::Plan, with: { work: :finding, title: "A Codebase run failed", detail: :body }
  end

  policy "LabelIssueWhenTriaged" do
    on      "Finding.FindingTriaged"
    ask     :label_issue, with: { finding: :finding }
  end

  policy "CommentWhenFixLinked" do
    on      "Finding.FixLinked"
    ask     :comment_on_issue, with: { finding: :finding }
  end

  policy "CloseIssueWhenResolved" do
    on      "Finding.FindingResolved"
    ask     :close_issue, with: { finding: :finding }
  end

  policy "CloseIssueWhenDismissed" do
    on      "Finding.FindingDismissed"
    ask     :close_issue, with: { finding: :finding }
  end

  policy "ReopenIssueWhenReopened" do
    on      "Finding.FindingReopened"
    ask     :reopen_issue, with: { finding: :finding }
  end

  # A started work item with an area asks the WorkAreas port whether another started one holds any
  # of it.
  policy "CheckAreaWhenStarted" do
    on      "Work.WorkStarted"
    ask     :check_area, with: { work: :work }
  end

  policy "YieldWhenAreaTaken" do
    on      "Work.AreaRefused"
    trigger Work::Yield, with: { reason: :refusal }
  end

  # A started work item asks the WorkLimits port whether it is one too many for the concurrency cap.
  # It is declared after the area check, so a work item that clashes is already back in the plan when
  # the cap looks, and the cap yields only a work item still started.
  policy "CheckCapWhenStarted" do
    on      "Work.WorkStarted"
    ask     :check_cap, with: { work: :work }
  end

  policy "YieldWhenCapReached" do
    on      "Work.CapRefused"
    trigger Work::Yield, with: { reason: :refusal }
  end

  # A superseded decision takes its undone work items with it.
  policy "LapseWorkWhenSuperseded" do
    on       "Adr.AdrSuperseded"
    for_each "Work.UndoneUnder"
    trigger  Work::Lapse, with: { work: :work }
  end

  # A coder's submitted branch is named for its work item, so the branch is the work item's key and the
  # policy routes it with no parsing (`with:` only routes fields). A branch naming no work item is refused
  # by the Finish command: the refusal names Work.
  policy "FinishWhenWorkSubmitted" do
    on      "Submission.WorkSubmitted"
    trigger Work::Finish, with: { work: :branch }
  end

  # A branch that landed on local main finishes the work item it was cut for. The Landing's LandedWork
  # port found the open work item the branch names (the whole branch name, else the name without a leading
  # `qa/`) and answered its key; a branch with no open work item is refused there and never reaches here.
  policy "FinishWorkWhenBranchLanded" do
    on      "Landing.LandedWorkFound"
    trigger Work::Finish, with: { work: :branch }
  end

  # A landing job refused a submitted branch for a cause a coder can fix: the work item it names is
  # planned again, its detail ending with the refusal, so the next coder reads why. A third refusal
  # of one work item reopens nothing: it stays done and unlanded for a person to look at.
  policy "ReopenWorkWhenLandingRefused" do
    on      "Landing.RefusedWorkFound"
    where   { refusals.value < 2 }
    trigger Work::Reopen, with: { work: :work, title: :title, detail: :detail }
  end

  # A conformance or gate run that faults files its own finding.
  policy "ReportWhenConformanceFaulted" do
    on      "ConformanceRun.ConformanceFaulted"
    root
    trigger Finding::ReportFailedRun, with: { finding: :run, body: :refusal }
  end

  policy "ReportWhenGateFaulted" do
    on      "GateRun.GateFaulted"
    root
    trigger Finding::ReportFailedRun, with: { finding: :run, body: :refusal }
  end

  # An integration run parked in needs_human (MainIntegration), or a shipment parked there
  # (GateAndBoard, whose stop emits ShipmentStopped), files a finding a person sees on the pipeline
  # board. An integration run is keyed by its landed commit, a shipment by its run. A faulted style
  # run or boarding is not here: any caller's run of those commands faults, and only a shipment's
  # waits on a person. A CI run that ends red is not here: it raises the red flag
  # (RaiseTheFlagWhenCiFails). A refused landing is not here either: every refused
  # `landing.finish!` emits it, and its caller reads the refusal.
  policy "ReportWhenVerificationFailed" do
    on      "Integration.MainVerificationFailed"
    root
    trigger Finding::ReportStoppedRun, with: { finding: :landed, commit: :landed, stage: "verifying", body: :refusal }
  end

  policy "ReportWhenMainPushRefused" do
    on      "Integration.MainPushRefused"
    root
    trigger Finding::ReportStoppedRun, with: { finding: :landed, commit: :landed, stage: "boarding", body: :refusal }
  end

  policy "ReportWhenPullRequestClosed" do
    on      "Integration.PullRequestClosed"
    root
    trigger Finding::ReportStoppedRun, with: { finding: :landed, commit: :landed, stage: "ci_running", body: :report }
  end

  policy "ReportWhenShipmentStopped" do
    on      "Shipment.ShipmentStopped"
    root
    trigger Finding::ReportStoppedRun, with: { finding: :run, stage: :stage, body: :refusal }
  end

  # A spec file that went red on main is a work item QA picks up: `Work.undone` lists it. The spec's own key is
  # the work item's key, so a second red run, which only updates the spec, plans nothing twice.
  policy "PlanWorkWhenSpecWentRed" do
    on      "RedSpec.SpecWentRed"
    trigger Work::Plan, with: { work: :spec, title: :title, detail: :detail }
  end

  # A file that fails again after it was cleared plans its finished work item again.
  policy "ReopenWorkWhenSpecWentRedAgain" do
    on      "RedSpec.SpecWentRedAgain"
    trigger Work::Reopen, with: { work: :spec, title: :title, detail: :detail }
  end

  # The run that no longer fails the file closes its work item.
  policy "FinishWorkWhenSpecWentGreen" do
    on      "RedSpec.SpecWentGreen"
    trigger Work::Finish, with: { work: :spec }
  end

  # A filed stall is one work item for its fixer, keyed as the stall is (`stall-<kind>-<subject>`), so a
  # stall filed again after a restart plans nothing twice: the key is already taken.
  policy "PlanWorkWhenStallFiled" do
    on      "Stall.StallFiled"
    trigger Work::Plan, with: { work: :stall, title: :title, detail: :detail }
  end

  # A stall whose run ended can never close, so its work item is set aside with the reason.
  policy "DropWorkWhenStallAbandoned" do
    on      "Stall.StallAbandoned"
    trigger Work::Drop, with: { work: :stall, reason: :reason }
  end

  # A train pull request whose CI failed past its reruns is one red work item, `red-train-<pr>`, for a
  # coder; the fill starts red items over budget. The key is the dedupe: a second exhausted attempt of
  # the same pull request plans nothing twice.
  policy "PlanWorkWhenTrainPrExhausted" do
    on      "TrainPr.TrainPrExhausted"
    where   { cause.value == "spec" }
    trigger Work::Plan, with: { work: :work, title: :title, detail: :detail }
  end

  # A train pull request that kept failing before its specs ran (a runner, apt, the network, a checkout) has no
  # code for a coder to fix: it is one finding naming the step, keyed by the failed attempt.
  policy "ReportWhenTrainPrFailedInSetup" do
    on      "TrainPr.TrainPrExhausted"
    where   { cause.value == "setup" }
    trigger Finding::ReportStoppedRun, with: { finding: :key, stage: :step, body: :detail }
  end

  # The item is red by its key (`red-*`, which the fill starts first and over budget) and wanted now.
  policy "PrioritizeTheRedTrainWork" do
    on      "Work.WorkPlanned"
    where   { work.value.start_with?("red-train-") }
    trigger Work::Prioritize, with: { work: :work, priority: "now" }
  end

  # QA's push check: a push that is due beyond the world's thresholds is one work item, `push-due`. A look
  # that finds it already open revises its detail; a look that finds it no longer due finishes it.
  policy "PlanWorkWhenPushDue" do
    on      "PushNudge.PushDueRead"
    where   { due.value == "yes" && raised.value == "no" }
    trigger Work::Plan, with: { work: :work, title: :title, detail: :detail }
  end

  policy "ReviseWorkWhenPushStillDue" do
    on      "PushNudge.PushDueRead"
    where   { due.value == "yes" && raised.value == "yes" }
    trigger Work::Revise, with: { work: :work, title: :title, detail: :detail }
  end

  policy "FinishWorkWhenPushSettled" do
    on      "PushNudge.PushDueRead"
    where   { due.value == "no" && raised.value == "yes" }
    trigger Work::Finish, with: { work: :work }
  end

  policy "RecordTheIssue" do
    on      "Finding.IssueOpened"
    trigger Finding::RecordIssue, with: { issue_number: :issue_number }
  end

  policy "RecordTheSyncFailure" do
    on      "Finding.GitHubRefused"
    trigger Finding::RecordSyncFailure, with: { sync_failure: :refusal }
  end

  # One kind of red cause the coordinator has triaged. Its signature says how to recognise it in CI
  # output, its check is the one that would have caught it before the push, and its fix is the
  # recipe a coder follows. A lesson marked `always` or whose area overlaps a work item's area is
  # briefed to that coder as a known trap. The count is never set: each run that hits the kind is a
  # `Sighting`, and the count is the sightings of the kind.
  aggregate "Lesson" do
    description "One kind of red cause: how to recognise it, the cause in a sentence, the check that catches it before the push, and the fix recipe."

    identified_by :kind

    attribute :kind,        LessonKind
    attribute :signature,   list_of(LessonSignature)
    attribute :cause,       LessonText
    attribute :check,       LessonText
    attribute :fix,         LessonText
    attribute :always,      LessonFlag
    attribute :area,        list_of(LessonArea), optional: true
    attribute :enforced_by, LessonText, optional: true

    # A short slug, unique per kind of cause, e.g. `generated-output-not-regenerated`.
    value_object "LessonKind" do
      attribute :value, String, pattern: '^[a-z0-9][a-z0-9-]*$'
    end

    # A spec file path, a spec example name or a line of error text, as CI prints it.
    value_object "LessonSignature" do
      attribute :value, String, matches: :present
    end

    value_object "LessonText" do
      attribute :value, String, matches: :present
    end

    # "yes" when every coder is briefed with the lesson, whatever its area.
    value_object "LessonFlag" do
      attribute :value, String, default: "no"
    end

    # A path prefix a coder's area must overlap for the lesson to be briefed to it.
    value_object "LessonArea" do
      attribute :value, String, matches: :present
    end

    query "Always" do
      description "Every lesson briefed to every coder, whatever its area."
      where(always: "yes")
      order_by :kind
    end

    command "Record" do
      role "Maintainer"
      goal "Write down a kind of red cause the coordinator triaged, so every coder who might hit it is told"

      attribute :kind,      LessonKind
      attribute :signature, list_of(LessonSignature)
      attribute :cause,     LessonText
      attribute :check,     LessonText
      attribute :fix,       LessonText
      attribute :always,    LessonFlag, optional: true
      attribute :area,      list_of(LessonArea), optional: true

      emits "LessonRecorded"
    end

    command "Enforce" do
      role "Maintainer"
      goal "Name the check that now catches a kind of red cause before the push"

      reference_to Lesson
      attribute :kind,        LessonKind
      attribute :enforced_by, LessonText, sets: true

      emits "LessonEnforced"
    end

    # A kind of cause was seen again: the Sighted command names the run and the commit, and the
    # policy below writes the sighting that the count is taken from.
    command "Sighted" do
      role "Maintainer"
      goal "Note that a kind of red cause recurred in a run, and where"

      reference_to Lesson
      attribute :kind,     LessonKind
      attribute :sighting, SightingKey
      attribute :run,      LessonRun
      attribute :commit,   LessonRun

      emits "LessonSighted"
    end
  end

  # One run of CI or one coder session that hit a kind of red cause. Keyed `<kind>@<run>`.
  aggregate "Sighting" do
    description "One run that hit a kind of red cause; the number of these for a kind is how often it recurred."

    identified_by :sighting

    attribute :sighting, SightingKey
    attribute :kind,     LessonKind
    attribute :run,      LessonRun
    attribute :commit,   LessonRun, optional: true

    value_object "SightingKey" do
      attribute :value, String, pattern: '^[a-z0-9][a-z0-9-]*@[A-Za-z0-9._-]+$'
    end

    value_object "LessonKind" do
      attribute :value, String, pattern: '^[a-z0-9][a-z0-9-]*$'
    end

    value_object "LessonRun" do
      attribute :value, String, matches: :present
    end

    query "Of" do
      description "Every sighting of one kind of red cause."
      attribute :kind, String
      where(kind: :kind)
      order_by :run
    end

    command "Record" do
      role "Maintainer"
      goal "Keep one sighting of a kind of red cause in one run"

      attribute :sighting, SightingKey
      attribute :kind,     LessonKind
      attribute :run,      LessonRun
      attribute :commit,   LessonRun, optional: true

      emits "SightingRecorded"
    end
  end

  # A sighting of a kind is recorded as its own record, so the count is a query and never a field a
  # caller sets.
  policy "RecordSightingWhenLessonSighted" do
    on      "Lesson.LessonSighted"
    trigger Sighting::Record, with: { sighting: :sighting, kind: :kind, run: :run, commit: :commit }
  end

  read_model "WorkByStatus" do
    description "How many work items stand in each status."
    include Work
    group_by :status
    count
  end

  read_model "FindingsByStatus" do
    description "How many findings stand in each status."
    include Finding
    group_by :status
    count
  end
end
