# The Tickets bluebook: what a maintainer observed about Hecks that needs a decision or a fix, the
# and the decisions that settle them.
#
# QualityControl has its own Ticket, the issue raised for a Bug in an outside tracker, and the
# Hecks domain has its own Release, the record of a gem version. A Finding sits before both: it is
# any observation, not yet a proven bug, and it needs no sweep or failing test to be recorded.
#
# A Finding is the record. A gap, a parity divergence, a QA finding and an idea are kinds of it, not
# separate aggregates. Hecks owns the finding's state; GitHub is driven from it through the
# GitHubIssues port, which a hecksagon binds (nothing here reads GitHub back). A finding exists whether
# or not GitHub answers: each lifecycle event asks the port, and a refused ask is recorded on the
# finding as a sync failure that a later run retries.
#
# An Adr is a decision record with its own lifecycle, linked to the finding it settles. A Work is a
# step of the plan a decision carries, and stays inside Hecks.
Hecks.bluebook "Tickets" do
  vision "Track what Hecks needs, decide it, ship it, and drive GitHub from the record."

  aggregate "Finding" do
    description "One thing observed about Hecks that needs a decision or a fix: reported, triaged, then resolved or dismissed."

    attribute :finding,         FindingKey
    attribute :title,          Title
    attribute :body,           Body, optional: true
    attribute :kind,           Kind, optional: true
    attribute :severity,       Severity, optional: true
    attribute :source,         Source
    attribute :fingerprint,    Fingerprint, optional: true
    attribute :issue_number,   Number, optional: true
    attribute :fix_pr_number,  Number, optional: true
    attribute :dismissal,      Body, optional: true
    attribute :sync_failure,   Body, optional: true
    identified_by :finding

    value_object "FindingKey" do
      attribute :value, String, matches: :present

      invariant("a finding is named") { !value.to_s.empty? }
    end

    value_object "Title" do
      attribute :value, String

      invariant("a finding has a title") { !value.to_s.empty? }
    end

    value_object "Body" do
      attribute :value, String
    end

    # What the finding is: a `gap` Hecks cannot yet express, a `parity` divergence between the Ruby
    # and Rust runtimes, a `qa` finding from the QA loop, or an `idea`.
    value_object "Kind" do
      attribute :value, String, one_of: ["gap", "parity", "qa", "idea"]
    end

    value_object "Severity" do
      attribute :value, String, one_of: ["low", "medium", "high"]
    end

    # Where it came from: the QA loop, work for a client, a parity check, or a maintainer by hand.
    value_object "Source" do
      attribute :value, String, one_of: ["qa_loop", "client_work", "parity_check", "maintainer"]
    end

    # The same finding refiled by the QA loop carries the same fingerprint, so a report of it while an
    # open finding holds it changes nothing.
    value_object "Fingerprint" do
      attribute :value, String, matches: :present
    end

    value_object "Number" do
      attribute :value, Integer

      invariant("a number is positive") { value.positive? }
    end

    lifecycle :status, default: "reported" do
      transition "Triage"  => "triaged",   from: %w[reported triaged]
      transition "Resolve" => "resolved",  from: "triaged"
      transition "Dismiss" => "dismissed", from: %w[reported triaged]
      transition "Reopen"  => "triaged",   from: %w[resolved dismissed]
    end

    command "Report" do
      goal "Record something observed about Hecks as a finding"

      attribute :finding,      FindingKey, sets: true
      attribute :title,       Title, sets: true
      attribute :body,        Body, optional: true, sets: true
      attribute :source,      Source, sets: true
      attribute :fingerprint, Fingerprint, optional: true, sets: true


      emits "FindingReported"
    end

    # A failed Codebase run reports itself: the run's key names the finding and doubles as its
    # fingerprint, so the same run failing again while its finding is open changes nothing.
    command "ReportFailedRun" do
      goal "Record a failed conformance or gate run as a finding"

      attribute :finding, FindingKey, sets: true
      attribute :body,   Body, sets: true

      sets :fingerprint, to: "run"
      sets :title,  to: "A Codebase run failed"
      sets :source, to: "qa_loop"

      emits "RunFindingReported"
    end

    # A lane that stood behind the lane it follows for longer than its Lane row allows reports
    # itself. The alert key names the finding and carries the day, so a lane that stays late files
    # one finding a day: the same key again is the same finding.
    command "ReportLag" do
      goal "Record a lane that has stood behind the lane it follows too long as a finding"

      attribute :finding, FindingKey, sets: true
      attribute :body,    Body, sets: true

      sets :fingerprint, to: "lane-lag"
      sets :title,  to: "A lane is behind the lane it follows"
      sets :source, to: "qa_loop"

      emits "LagFindingReported"
    end

    command "Triage" do
      role "Maintainer"
      goal "Give a finding its kind and severity"

      reference_to Finding
      attribute :kind,     Kind, sets: true
      attribute :severity, Severity, sets: true


      emits "FindingTriaged"
    end

    command "LinkFix" do
      role "Maintainer"
      goal "Record the pull request that fixes a triaged finding"

      reference_to Finding
      attribute :fix_pr_number, Number, sets: true


      emits "FixLinked"
    end

    command "Resolve" do
      role "Maintainer"
      goal "Close a triaged finding as resolved"

      reference_to Finding

      emits "FindingResolved"
    end

    command "Dismiss" do
      role "Maintainer"
      goal "Close a finding without a fix, with the reason"

      reference_to Finding
      attribute :dismissal, Body, sets: true


      emits "FindingDismissed"
    end

    command "Reopen" do
      role "Maintainer"
      goal "Take a resolved or dismissed finding back to triaged, as when a fix regresses"

      reference_to Finding

      emits "FindingReopened"
    end

    command "RecordIssue" do
      goal "Record the GitHub issue number once the issue is opened"
      audience :record

      reference_to Finding
      attribute :issue_number, Number, sets: true


      emits "IssueRecorded"
    end

    command "RecordSyncFailure" do
      goal "Record that GitHub could not be driven, so a later run retries"
      audience :record

      reference_to Finding
      attribute :sync_failure, Body, sets: true


      emits "SyncFailed"
    end

    query "Open" do
      description "Every finding not yet resolved or dismissed."
      where(status: { in: "reported,triaged" })
      order_by :finding
    end
  end

  aggregate "Adr" do
    description "A decision record: drafted, accepted, and possibly superseded, linked to the tickets it settles."

    attribute :adr,       AdrNumber
    attribute :title,     AdrTitle
    attribute :supersedes, AdrNumber, optional: true
    reference_to Finding, as: :settles, optional: true
    identified_by :adr

    value_object "AdrNumber" do
      attribute :value, String, pattern: '\A[0-9]{4}\z'
    end

    value_object "AdrTitle" do
      attribute :value, String

      invariant("a decision has a title") { !value.to_s.empty? }
    end

    lifecycle :status, default: "draft" do
      transition "Accept"    => "accepted",   from: "draft"
      transition "Supersede" => "superseded", from: "accepted"
      mark :terminal, "superseded"
    end

    command "Draft" do
      role "Maintainer"
      goal "Open a decision record, optionally for the finding it settles"

      attribute :adr,       AdrNumber, sets: true
      attribute :title,     AdrTitle, sets: true
      reference_to Finding, as: :settles, optional: true

      sets :settles

      emits "AdrDrafted"
    end

    command "Accept" do
      role "Maintainer"
      goal "Record that the decision was accepted"

      reference_to Adr

      emits "AdrAccepted"
    end

    command "Supersede" do
      role "Maintainer"
      goal "Record that a later decision replaces this one"

      reference_to Adr
      attribute :supersedes, AdrNumber, sets: true


      emits "AdrSuperseded"
    end

    query "Standing" do
      description "Every decision that is accepted and not superseded."
      where(status: "accepted")
      order_by :adr
    end
  end

  # A step of a plan, held under the decision it carries out. It drives nothing outside: planned
  # work is the maintainer's own list, not an issue.
  aggregate "Work" do
    description "One step of a plan: planned, started, then done or dropped, under the decision it carries out."

    attribute :work,   WorkKey
    attribute :title,  WorkTitle
    attribute :detail, WorkText, optional: true
    attribute :step,   Step, optional: true
    attribute :reason, WorkText, optional: true
    reference_to Adr, as: :decision, optional: true
    identified_by :work

    value_object "WorkKey" do
      attribute :value, String, matches: :present

      invariant("a piece of work is named") { !value.to_s.empty? }
    end

    value_object "WorkTitle" do
      attribute :value, String

      invariant("a piece of work has a title") { !value.to_s.empty? }
    end

    value_object "WorkText" do
      attribute :value, String
    end

    # Where the work stands in its plan: step 0 comes first.
    value_object "Step" do
      attribute :value, Integer

      invariant("a step is not negative") { !value.negative? }
    end

    lifecycle :status, default: "planned" do
      transition "Start"  => "started", from: "planned"
      transition "Finish" => "done",    from: %w[planned started]
      transition "Drop"   => "dropped", from: %w[planned started]
      transition "Lapse"  => "dropped", from: %w[planned started]
      mark :terminal, "done", "dropped"
    end

    command "Plan" do
      role "Maintainer"
      goal "Enter a step of a plan, optionally under the decision it carries out"

      attribute :work,   WorkKey, sets: true
      attribute :title,  WorkTitle, sets: true
      attribute :detail, WorkText, optional: true, sets: true
      attribute :step,   Step, optional: true, sets: true
      reference_to Adr, as: :decision, optional: true

      sets :decision

      emits "WorkPlanned"
    end

    command "Start" do
      role "Maintainer"
      goal "Record that work on a planned step began"

      reference_to Work

      emits "WorkStarted"
    end

    command "Finish" do
      role "Maintainer"
      goal "Record that a step is done"

      reference_to Work

      emits "WorkFinished"
    end

    command "Drop" do
      role "Maintainer"
      goal "Set a step aside without doing it, with the reason"

      reference_to Work
      attribute :reason, WorkText, sets: true

      emits "WorkDropped"
    end

    # A superseded decision's plan no longer stands, so its undone steps are dropped with it.
    command "Lapse" do
      goal "Drop a step whose decision was superseded"

      reference_to Work

      sets :reason, to: "its decision was superseded"

      emits "WorkLapsed"
    end

    query "Undone" do
      description "Every step not yet done or dropped, in plan order."
      where(status: { in: "planned,started" })
      order_by :step
    end

    query "Under" do
      description "Every step of the plan one decision carries, in plan order."
      attribute :adr, String
      where(decision: :adr)
      order_by :step
    end

    query "UndoneUnder" do
      description "The steps of one decision's plan not yet done or dropped: the ones its superseding drops."
      attribute :adr, String
      where(decision: :adr, status: { in: "planned,started" })
      order_by :step
    end
  end

  # Each lifecycle event drives GitHub. A finding's own state never waits on the answer.
  policy "OpenIssueWhenReported" do
    on      "Finding.FindingReported"
    ask     :open_issue, with: { finding: :finding }
  end

  policy "OpenIssueWhenRunReported" do
    on      "Finding.RunFindingReported"
    ask     :open_issue, with: { finding: :finding }
  end

  policy "OpenIssueWhenLagReported" do
    on      "Finding.LagFindingReported"
    ask     :open_issue, with: { finding: :finding }
  end

  policy "LabelIssueWhenTriaged" do
    on      "Finding.FindingTriaged"
    ask     :label_issue, with: { finding: :finding }
  end

  policy "CommentWhenFixLinked" do
    on      "Finding.FixLinked"
    ask     :comment_on_issue, with: { finding: :finding }
  end

  policy "CloseIssueWhenResolved" do
    on      "Finding.FindingResolved"
    ask     :close_issue, with: { finding: :finding }
  end

  policy "CloseIssueWhenDismissed" do
    on      "Finding.FindingDismissed"
    ask     :close_issue, with: { finding: :finding }
  end

  policy "ReopenIssueWhenReopened" do
    on      "Finding.FindingReopened"
    ask     :reopen_issue, with: { finding: :finding }
  end

  # A superseded decision takes its undone steps with it.
  policy "LapseWorkWhenSuperseded" do
    on       "Adr.AdrSuperseded"
    for_each "Work.UndoneUnder"
    trigger  Work::Lapse, with: { work: :work }
  end

  # A conformance or gate run that faults files its own finding.
  policy "ReportWhenConformanceFaulted" do
    on      "ConformanceRun.ConformanceFaulted"
    trigger Finding::ReportFailedRun, with: { finding: :run, body: :refusal }
  end

  # A watch that finds a lane late faults it, and the fault files its finding.
  policy "ReportWhenLaneLags" do
    on      "PromotionRun.LaneLagged"
    trigger Finding::ReportLag, with: { finding: :alert_key, body: :refusal }
  end

  policy "ReportWhenGateFaulted" do
    on      "GateRun.GateFaulted"
    trigger Finding::ReportFailedRun, with: { finding: :run, body: :refusal }
  end

  policy "RecordTheIssue" do
    on      "Finding.IssueOpened"
    trigger Finding::RecordIssue, with: { issue_number: :issue_number }
  end

  policy "RecordTheSyncFailure" do
    on      "Finding.GitHubRefused"
    trigger Finding::RecordSyncFailure, with: { sync_failure: :refusal }
  end
end
