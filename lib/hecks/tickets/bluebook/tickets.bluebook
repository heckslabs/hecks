# The Tickets bluebook: what a maintainer observed about Hecks that needs a decision or a fix, the
# and the decisions that settle them.
#
# QualityControl has its own Ticket, the issue raised for a Bug in an outside tracker, and the
# Hecks domain has its own Release, the record of a gem version. A Finding sits before both: it is
# any observation, not yet a proven bug, and it needs no sweep or failing test to be recorded.
#
# A Finding is the record. A gap, a parity divergence, a QA finding and an idea are kinds of it, not
# separate aggregates. Hecks owns the finding's state; GitHub is driven from it through the
# GitHubIssues port, which a hecksagon binds (nothing here reads GitHub back). A finding exists whether
# or not GitHub answers: each lifecycle event asks the port, and a refused ask is recorded on the
# finding as a sync failure that a later run retries.
#
# An Adr is a decision record with its own lifecycle, linked to the finding it settles. A Work is a work item:
# one step of the plan a decision carries, and it stays inside Hecks.
Hecks.bluebook "Tickets" do
  vision "Track what Hecks needs, decide it, ship it, and drive GitHub from the record."

  aggregate "Finding" do
    description "One thing observed about Hecks that needs a decision or a fix: reported, triaged, then resolved or dismissed."
    created_by "Finding.report!"

    attribute :finding,         FindingKey
    attribute :title,          Title
    attribute :body,           Body, optional: true
    attribute :kind,           Kind, optional: true
    attribute :severity,       Severity, optional: true
    attribute :source,         Source
    attribute :fingerprint,    Fingerprint, optional: true
    attribute :issue_number,   Number, optional: true
    attribute :fix_pr_number,  Number, optional: true
    attribute :dismissal,      Body, optional: true
    attribute :sync_failure,   Body, optional: true
    identified_by :finding

    value_object "FindingKey" do
      attribute :value, String, matches: :present

      invariant("a finding is named") { !value.to_s.empty? }
    end

    value_object "Title" do
      attribute :value, String

      invariant("a finding has a title") { !value.to_s.empty? }
    end

    value_object "Body", String

    # What the finding is: a `gap` Hecks cannot yet express, a `parity` divergence between the Ruby
    # and Rust runtimes, a `qa` finding from the QA loop, or an `idea`.
    value_object "Kind" do
      attribute :value, String, one_of: ["gap", "parity", "qa", "idea"]
    end

    value_object "Severity" do
      attribute :value, String, one_of: ["low", "medium", "high"]
    end

    # Where it came from: the QA loop, work for a client, a parity check, or a maintainer by hand.
    value_object "Source" do
      attribute :value, String, one_of: ["qa_loop", "client_work", "parity_check", "maintainer"]
    end

    # The same finding refiled by the QA loop carries the same fingerprint, so a report of it while an
    # open finding holds it changes nothing.
    value_object "Fingerprint" do
      attribute :value, String, matches: :present
    end

    value_object "Number" do
      attribute :value, Integer

      invariant("a number is positive") { value.positive? }
    end

    lifecycle :status, default: "reported" do
      transition "Triage"  => "triaged",   from: %w[reported triaged]
      transition "Resolve" => "resolved",  from: "triaged"
      transition "Dismiss" => "dismissed", from: %w[reported triaged]
      transition "Reopen"  => "triaged",   from: %w[resolved dismissed]
    end

    command "Report" do
      goal "Record something observed about Hecks as a finding"

      attribute :finding,      FindingKey, sets: true
      attribute :title,       Title, sets: true
      attribute :body,        Body, optional: true, sets: true
      attribute :source,      Source, sets: true
      attribute :fingerprint, Fingerprint, optional: true, sets: true


      emits "FindingReported"
    end

    # A failed Codebase run reports itself: the run's key names the finding and doubles as its
    # fingerprint, so the same run failing again while its finding is open changes nothing.
    command "ReportFailedRun" do
      goal "Record a failed conformance or gate run as a finding"

      attribute :finding, FindingKey, sets: true
      attribute :body,   Body, sets: true

      sets :fingerprint, to: "run"
      sets :title,  to: "A Codebase run failed"
      sets :source, to: "qa_loop"

      emits "RunFindingReported"
    end

    command "Triage" do
      role "Maintainer"
      goal "Give a finding its kind and severity"

      reference_to Finding
      attribute :kind,     Kind, sets: true
      attribute :severity, Severity, sets: true


      emits "FindingTriaged"
    end

    command "LinkFix" do
      role "Maintainer"
      goal "Record the pull request that fixes a triaged finding"

      reference_to Finding
      attribute :fix_pr_number, Number, sets: true


      emits "FixLinked"
    end

    command "Resolve" do
      role "Maintainer"
      goal "Close a triaged finding as resolved"

      reference_to Finding

      emits "FindingResolved"
    end

    command "Dismiss" do
      role "Maintainer"
      goal "Close a finding without a fix, with the reason"

      reference_to Finding
      attribute :dismissal, Body, sets: true


      emits "FindingDismissed"
    end

    command "Reopen" do
      role "Maintainer"
      goal "Take a resolved or dismissed finding back to triaged, as when a fix regresses"

      reference_to Finding

      emits "FindingReopened"
    end

    command "RecordIssue" do
      goal "Record the GitHub issue number once the issue is opened"
      audience :record

      reference_to Finding
      attribute :issue_number, Number, sets: true


      emits "IssueRecorded"
    end

    command "RecordSyncFailure" do
      goal "Record that GitHub could not be driven, so a later run retries"
      audience :record

      reference_to Finding
      attribute :sync_failure, Body, sets: true


      emits "SyncFailed"
    end

    query "Open" do
      description "Every finding not yet resolved or dismissed."
      where(status: { in: "reported,triaged" })
      order_by :finding
    end
  end

  aggregate "Adr" do
    description "A decision record: drafted, accepted, and possibly superseded, linked to the tickets it settles."
    created_by "Adr.draft!"

    attribute :adr,       AdrNumber
    attribute :title,     AdrTitle
    attribute :supersedes, AdrNumber, optional: true
    reference_to Finding, as: :settles, optional: true
    identified_by :adr

    value_object "AdrNumber" do
      attribute :value, String, pattern: '\A[0-9]{4}\z'
    end

    value_object "AdrTitle" do
      attribute :value, String

      invariant("a decision has a title") { !value.to_s.empty? }
    end

    lifecycle :status, default: "draft" do
      transition "Accept"    => "accepted",   from: "draft"
      transition "Supersede" => "superseded", from: "accepted"
      mark :terminal, "superseded"
    end

    command "Draft" do
      role "Maintainer"
      goal "Open a decision record, optionally for the finding it settles"

      attribute :adr,       AdrNumber, sets: true
      attribute :title,     AdrTitle, sets: true
      reference_to Finding, as: :settles, optional: true

      sets :settles

      emits "AdrDrafted"
    end

    command "Accept" do
      role "Maintainer"
      goal "Record that the decision was accepted"

      reference_to Adr

      emits "AdrAccepted"
    end

    command "Supersede" do
      role "Maintainer"
      goal "Record that a later decision replaces this one"

      reference_to Adr
      attribute :supersedes, AdrNumber, sets: true


      emits "AdrSuperseded"
    end

    query "Standing" do
      description "Every decision that is accepted and not superseded."
      where(status: "accepted")
      order_by :adr
    end

    query "Drafted" do
      description "Every decision record still in draft, not yet accepted or superseded."
      where(status: "draft")
      order_by :adr
    end
  end

  # A work item: one planned, started or done piece of Work, keyed by its id and held under the
  # decision it carries out. It drives nothing outside: planned work is the maintainer's own list, not
  # an issue.
  aggregate "Work" do
    description "One work item: a planned, started or done piece of Work, keyed by its id, under the decision it carries out."
    created_by "Work.plan!"

    attribute :work,   WorkKey
    attribute :title,  WorkTitle
    attribute :detail, WorkText, optional: true
    attribute :step,   Step, optional: true
    attribute :reason, WorkText, optional: true
    attribute :claimed_by, Claimant, optional: true
    attribute :claimed_at, ClaimedAt, optional: true
    attribute :area,   list_of(Word), optional: true
    attribute :budget_minutes, Minutes, optional: true
    attribute :category, Category, optional: true
    attribute :priority, Priority, optional: true
    reference_to Adr, as: :decision, optional: true
    identified_by :work

    # A path prefix or glob a claim covers. Two areas overlap by `Hecks::Adapters::AreaOverlap`;
    # a work item with no area claims nothing.
    value_object "Word" do
      attribute :value, String, matches: :present
    end

    # The session that claimed a started work item, named as the session names itself. One back in
    # the plan holds the empty claimant; `Start` refuses one that names nobody.
    value_object "Claimant" do
      attribute :value, String, default: ""
    end

    # When the claim was taken, as the caller reads the clock: an ISO 8601 instant. Empty while the
    # work item is unclaimed.
    value_object "ClaimedAt" do
      attribute :value, String, default: ""
    end

    # How long a claim may run, in whole minutes. A work item with none, or zero, has no budget; one
    # back in the plan holds zero.
    value_object "Minutes" do
      attribute :value, Integer

      invariant("a time budget is not negative") { !value.negative? }
    end

    # What a query answered from outside the domain returns: its lines.
    value_object "Document" do
      attribute :text, String
    end

    value_object "WorkKey" do
      attribute :value, String, matches: :present

      invariant("a piece of work is named") { !value.to_s.empty? }
    end

    value_object "WorkTitle" do
      attribute :value, String

      invariant("a piece of work has a title") { !value.to_s.empty? }
    end

    value_object "WorkText", String

    # Where the work stands in its plan: step 0 comes first.
    value_object "Step" do
      attribute :value, Integer

      invariant("a step is not negative") { !value.negative? }
    end

    # What kind of work an item is, one per item. It never decides whether two items clash: that is the
    # path claim in `area`.
    value_object "Category" do
      attribute :value, String, one_of: %w[bluebook-gap language delivery coder parity host tooling]
    end

    # How soon an item is wanted. Unset means nobody has said.
    value_object "Priority" do
      attribute :value, String, one_of: %w[now next later]
    end

    lifecycle :status, default: "planned" do
      transition "Start"   => "started", from: "planned"
      transition "Release" => "planned", from: "started"
      transition "Yield"   => "planned", from: "started"
      transition "Finish" => "done",    from: %w[planned started]
      transition "Drop"   => "dropped", from: %w[planned started]
      transition "Lapse"  => "dropped", from: %w[planned started]
      transition "Reopen" => "planned", from: %w[done dropped]
    end

    command "Plan" do
      role "Maintainer"
      goal "Enter a work item into a plan, optionally under the decision it carries out"

      attribute :work,   WorkKey, sets: true
      attribute :title,  WorkTitle, sets: true
      # The detail and area default to none, so the event always carries them and
      # ComposeBriefWhenPlanned in Coder can read them from any plan.
      attribute :detail, WorkText, optional: true, sets: true, default: { value: "" }
      attribute :step,   Step, optional: true, sets: true
      attribute :area,   list_of(Word), optional: true, sets: true, default: []
      reference_to Adr, as: :decision, optional: true

      sets :decision

      emits "WorkPlanned"
    end

    # A work item still open takes what a later look at it found: its title and detail move and
    # nothing else does. The status, claim, priority, step, area and decision stay as they were.
    # Area and decision move through `Rescope`, `ClearArea` and `Decide`, since a `sets` of a field
    # the caller left out would write it empty.
    command "Revise" do
      goal "Replace an open work item's title and detail, and nothing else"

      reference_to Work
      attribute :title,  WorkTitle, sets: true
      attribute :detail, WorkText, sets: true

      given("a done work item is not revised") { status != "done" }
      given("a dropped work item is not revised") { status != "dropped" }

      emits "WorkRevised"
    end

    # An open work item takes a new area: the whole list is replaced.
    command "Rescope" do
      goal "Replace the area an open work item claims with the given list"

      reference_to Work
      attribute :area, list_of(Word), sets: true

      given("a done work item is not rescoped") { status != "done" }
      given("a dropped work item is not rescoped") { status != "dropped" }

      emits "WorkRescoped"
    end

    # An open work item claims nothing again. An item with no area never overlaps another in
    # Dispatch, so emptying it is a command of its own.
    command "ClearArea" do
      goal "Empty the area an open work item claims"

      reference_to Work

      sets :area, to: []

      given("a done work item has no area to clear") { status != "done" }
      given("a dropped work item has no area to clear") { status != "dropped" }

      emits "WorkAreaCleared"
    end

    # An open work item names the decision it carries out (refused by name when no Adr has that id).
    command "Decide" do
      goal "Name the decision an open work item carries out"

      reference_to Work
      reference_to Adr, as: :decision

      sets :decision

      given("a done work item takes no decision") { status != "done" }
      given("a dropped work item takes no decision") { status != "dropped" }

      emits "WorkDecided"
    end

    # An open work item is sorted into one category. The claim, the step and the area stay as they are.
    command "Categorize" do
      role "Maintainer"
      goal "Sort an open work item into a category"

      reference_to Work
      attribute :category, Category, sets: true

      given("a done or dropped work item takes no category") { status != "done" && status != "dropped" }

      emits "WorkCategorized"
    end

    # An open work item is given how soon it is wanted. The claim, the step and the area stay as they are.
    command "Prioritize" do
      role "Maintainer"
      goal "Say how soon an open work item is wanted: now, next or later"

      reference_to Work
      attribute :priority, Priority, sets: true

      given("a done or dropped work item takes no priority") { status != "done" && status != "dropped" }

      emits "WorkPrioritized"
    end

    # A started work item is claimed: the second Start on it is refused, since only a planned one
    # starts.
    command "Start" do
      role "Maintainer"
      goal "Claim a planned work item for one session, recording who claimed it and when"

      reference_to Work
      attribute :claimed_by, Claimant, sets: true
      attribute :claimed_at, ClaimedAt, sets: true
      attribute :area,       list_of(Word), optional: true, sets: true
      attribute :budget_minutes, Minutes, optional: true, sets: true

      given("a claim names its claimant") { !claimed_by.value.to_s.empty? }
      given("a claim records when it was taken") { !claimed_at.value.to_s.empty? }

      emits "WorkStarted"
    end

    # A started work item that may not go on goes back to the plan with the refusal as its reason:
    # its area overlapped another started work item's, it would start more work items than the cap
    # allows (the WorkAreas or WorkLimits port refuses it by name), or the architect's review of its
    # plan said rethink and the coder session handed it back.
    command "Yield" do
      goal "Return a started work item to the plan, with the refusal that sent it back"

      reference_to Work
      attribute :reason, WorkText, sets: true

      sets :claimed_by, to: ""
      sets :claimed_at, to: ""
      sets :area, to: []
      sets :budget_minutes, to: 0

      emits "WorkYielded"
    end

    # A claim gone stale returns its work item to the plan, so the next session can claim it.
    command "Release" do
      goal "Return a started work item to planned, releasing its claim"

      reference_to Work

      sets :claimed_by, to: ""
      sets :claimed_at, to: ""
      sets :area, to: []
      sets :budget_minutes, to: 0

      emits "WorkReleased"
    end

    command "Finish" do
      role "Maintainer"
      goal "Record that a work item is done"

      reference_to Work

      emits "WorkFinished"
    end

    command "Drop" do
      role "Maintainer"
      goal "Set a work item aside without doing it, with the reason"

      reference_to Work
      attribute :reason, WorkText, sets: true

      emits "WorkDropped"
    end

    # A work item whose cause came back (a spec red again after it was cleared) is planned again,
    # with the new title and detail.
    command "Reopen" do
      goal "Return a finished or dropped work item to planned because its cause returned"

      reference_to Work
      attribute :title,  WorkTitle, sets: true
      attribute :detail, WorkText, optional: true, sets: true

      emits "WorkReopened"
    end

    # A superseded decision's plan no longer stands, so its undone work items are dropped with it.
    command "Lapse" do
      goal "Drop a work item whose decision was superseded"

      reference_to Work

      sets :reason, to: "its decision was superseded"

      emits "WorkLapsed"
    end

    query "Undone" do
      description "Every work item not yet done or dropped, in plan order."
      where(status: { in: "planned,started" })
      order_by :step
    end

    # The first work item still planned in plan order: the next one a coder session claims.
    query "NextPlanned" do
      description "The oldest work item not yet claimed, in plan order: the brief a coder session reads next."
      where(status: "planned")
      order_by :step
      limit 1
    end

    query "Under" do
      description "Every work item of the plan one decision carries, in plan order."
      attribute :adr, String
      where(decision: :adr)
      order_by :step
    end

    query "UndoneUnder" do
      description "The work items of one decision's plan not yet done or dropped: the ones its superseding drops."
      attribute :adr, String
      where(decision: :adr, status: { in: "planned,started" })
      order_by :step
    end

    query "UndoneInTier" do
      description "Every work item not yet done or dropped that is wanted now, next or later, in plan order."
      attribute :tier, String
      where(priority: :tier, status: { in: "planned,started" })
      order_by :step
    end

    query "UndoneInCategory" do
      description "Every work item not yet done or dropped in one category, in plan order."
      attribute :kind, String
      where(category: :kind, status: { in: "planned,started" })
      order_by :step
    end
  end

  # Each lifecycle event drives GitHub. A finding's own state never waits on the answer.
  policy "OpenIssueWhenReported" do
    on      "Finding.FindingReported"
    ask     :open_issue, with: { finding: :finding }
  end

  # Switched off by the Tickets world's `github_issues` setting (`enabled: false`): the ask is
  # refused naming the setting before any GitHub call, and the run finding stays a work item.
  policy "OpenIssueWhenRunReported" do
    on      "Finding.RunFindingReported"
    ask     :open_issue, with: { finding: :finding }
  end

  policy "LabelIssueWhenTriaged" do
    on      "Finding.FindingTriaged"
    ask     :label_issue, with: { finding: :finding }
  end

  policy "CommentWhenFixLinked" do
    on      "Finding.FixLinked"
    ask     :comment_on_issue, with: { finding: :finding }
  end

  policy "CloseIssueWhenResolved" do
    on      "Finding.FindingResolved"
    ask     :close_issue, with: { finding: :finding }
  end

  policy "CloseIssueWhenDismissed" do
    on      "Finding.FindingDismissed"
    ask     :close_issue, with: { finding: :finding }
  end

  policy "ReopenIssueWhenReopened" do
    on      "Finding.FindingReopened"
    ask     :reopen_issue, with: { finding: :finding }
  end

  # A started work item with an area asks the WorkAreas port whether another started one holds any
  # of it.
  policy "CheckAreaWhenStarted" do
    on      "Work.WorkStarted"
    ask     :check_area, with: { work: :work }
  end

  policy "YieldWhenAreaTaken" do
    on      "Work.AreaRefused"
    trigger Work::Yield, with: { reason: :refusal }
  end

  # A started work item asks the WorkLimits port whether it is one too many for the concurrency cap.
  # It is declared after the area check, so a work item that clashes is already back in the plan when
  # the cap looks, and the cap yields only a work item still started.
  policy "CheckCapWhenStarted" do
    on      "Work.WorkStarted"
    ask     :check_cap, with: { work: :work }
  end

  policy "YieldWhenCapReached" do
    on      "Work.CapRefused"
    trigger Work::Yield, with: { reason: :refusal }
  end

  # A superseded decision takes its undone work items with it.
  policy "LapseWorkWhenSuperseded" do
    on       "Adr.AdrSuperseded"
    for_each "Work.UndoneUnder"
    trigger  Work::Lapse, with: { work: :work }
  end

  # A coder's submitted branch is named for its work item, so the branch is the work item's key and the
  # policy routes it with no parsing (`with:` only routes fields). A branch naming no work item is refused
  # by the Finish command: the refusal names Work.
  policy "FinishWhenWorkSubmitted" do
    on      "Submission.WorkSubmitted"
    trigger Work::Finish, with: { work: :branch }
  end

  # A branch that landed on local main finishes the work item it was cut for. The Landing's LandedWork
  # port found the open work item the branch names (the whole branch name, else the name without a leading
  # `qa/`) and answered its key; a branch with no open work item is refused there and never reaches here.
  policy "FinishWorkWhenBranchLanded" do
    on      "Landing.LandedWorkFound"
    trigger Work::Finish, with: { work: :branch }
  end

  # A conformance or gate run that faults files its own finding.
  policy "ReportWhenConformanceFaulted" do
    on      "ConformanceRun.ConformanceFaulted"
    root
    trigger Finding::ReportFailedRun, with: { finding: :run, body: :refusal }
  end

  policy "ReportWhenGateFaulted" do
    on      "GateRun.GateFaulted"
    root
    trigger Finding::ReportFailedRun, with: { finding: :run, body: :refusal }
  end

  # A spec file that went red on main is a work item QA picks up: `Work.undone` lists it. The spec's own key is
  # the work item's key, so a second red run, which only updates the spec, plans nothing twice.
  policy "PlanWorkWhenSpecWentRed" do
    on      "RedSpec.SpecWentRed"
    trigger Work::Plan, with: { work: :spec, title: :title, detail: :detail }
  end

  # A file that fails again after it was cleared plans its finished work item again.
  policy "ReopenWorkWhenSpecWentRedAgain" do
    on      "RedSpec.SpecWentRedAgain"
    trigger Work::Reopen, with: { work: :spec, title: :title, detail: :detail }
  end

  # The run that no longer fails the file closes its work item.
  policy "FinishWorkWhenSpecWentGreen" do
    on      "RedSpec.SpecWentGreen"
    trigger Work::Finish, with: { work: :spec }
  end

  # QA's push check: a push that is due beyond the world's thresholds is one work item, `push-due`. A look
  # that finds it already open revises its detail; a look that finds it no longer due finishes it.
  policy "PlanWorkWhenPushDue" do
    on      "PushNudge.PushDueRead"
    where   { due.value == "yes" && raised.value == "no" }
    trigger Work::Plan, with: { work: :work, title: :title, detail: :detail }
  end

  policy "ReviseWorkWhenPushStillDue" do
    on      "PushNudge.PushDueRead"
    where   { due.value == "yes" && raised.value == "yes" }
    trigger Work::Revise, with: { work: :work, title: :title, detail: :detail }
  end

  policy "FinishWorkWhenPushSettled" do
    on      "PushNudge.PushDueRead"
    where   { due.value == "no" && raised.value == "yes" }
    trigger Work::Finish, with: { work: :work }
  end

  policy "RecordTheIssue" do
    on      "Finding.IssueOpened"
    trigger Finding::RecordIssue, with: { issue_number: :issue_number }
  end

  policy "RecordTheSyncFailure" do
    on      "Finding.GitHubRefused"
    trigger Finding::RecordSyncFailure, with: { sync_failure: :refusal }
  end

  # One kind of red cause the coordinator has triaged. Its signature says how to recognise it in CI
  # output, its check is the one that would have caught it before the push, and its fix is the
  # recipe a coder follows. A lesson marked `always` or whose area overlaps a work item's area is
  # briefed to that coder as a known trap. The count is never set: each run that hits the kind is a
  # `Sighting`, and the count is the sightings of the kind.
  aggregate "Lesson" do
    description "One kind of red cause: how to recognise it, the cause in a sentence, the check that catches it before the push, and the fix recipe."

    identified_by :kind

    attribute :kind,        LessonKind
    attribute :signature,   list_of(LessonSignature)
    attribute :cause,       LessonText
    attribute :check,       LessonText
    attribute :fix,         LessonText
    attribute :always,      LessonFlag
    attribute :area,        list_of(LessonArea), optional: true
    attribute :enforced_by, LessonText, optional: true

    # A short slug, unique per kind of cause, e.g. `generated-output-not-regenerated`.
    value_object "LessonKind" do
      attribute :value, String, pattern: '^[a-z0-9][a-z0-9-]*$'
    end

    # A spec file path, a spec example name or a line of error text, as CI prints it.
    value_object "LessonSignature" do
      attribute :value, String, matches: :present
    end

    value_object "LessonText" do
      attribute :value, String, matches: :present
    end

    # "yes" when every coder is briefed with the lesson, whatever its area.
    value_object "LessonFlag" do
      attribute :value, String, default: "no"
    end

    # A path prefix a coder's area must overlap for the lesson to be briefed to it.
    value_object "LessonArea" do
      attribute :value, String, matches: :present
    end

    query "Always" do
      description "Every lesson briefed to every coder, whatever its area."
      where(always: "yes")
      order_by :kind
    end

    command "Record" do
      role "Maintainer"
      goal "Write down a kind of red cause the coordinator triaged, so every coder who might hit it is told"

      attribute :kind,      LessonKind
      attribute :signature, list_of(LessonSignature)
      attribute :cause,     LessonText
      attribute :check,     LessonText
      attribute :fix,       LessonText
      attribute :always,    LessonFlag, optional: true
      attribute :area,      list_of(LessonArea), optional: true

      emits "LessonRecorded"
    end

    command "Enforce" do
      role "Maintainer"
      goal "Name the check that now catches a kind of red cause before the push"

      reference_to Lesson
      attribute :kind,        LessonKind
      attribute :enforced_by, LessonText, sets: true

      emits "LessonEnforced"
    end

    # A kind of cause was seen again: the Sighted command names the run and the commit, and the
    # policy below writes the sighting that the count is taken from.
    command "Sighted" do
      role "Maintainer"
      goal "Note that a kind of red cause recurred in a run, and where"

      reference_to Lesson
      attribute :kind,     LessonKind
      attribute :sighting, SightingKey
      attribute :run,      LessonRun
      attribute :commit,   LessonRun

      emits "LessonSighted"
    end
  end

  # One run of CI or one coder session that hit a kind of red cause. Keyed `<kind>@<run>`.
  aggregate "Sighting" do
    description "One run that hit a kind of red cause; the number of these for a kind is how often it recurred."

    identified_by :sighting

    attribute :sighting, SightingKey
    attribute :kind,     LessonKind
    attribute :run,      LessonRun
    attribute :commit,   LessonRun, optional: true

    value_object "SightingKey" do
      attribute :value, String, pattern: '^[a-z0-9][a-z0-9-]*@[A-Za-z0-9._-]+$'
    end

    value_object "LessonKind" do
      attribute :value, String, pattern: '^[a-z0-9][a-z0-9-]*$'
    end

    value_object "LessonRun" do
      attribute :value, String, matches: :present
    end

    query "Of" do
      description "Every sighting of one kind of red cause."
      attribute :kind, String
      where(kind: :kind)
      order_by :run
    end

    command "Record" do
      role "Maintainer"
      goal "Keep one sighting of a kind of red cause in one run"

      attribute :sighting, SightingKey
      attribute :kind,     LessonKind
      attribute :run,      LessonRun
      attribute :commit,   LessonRun, optional: true

      emits "SightingRecorded"
    end
  end

  # A sighting of a kind is recorded as its own record, so the count is a query and never a field a
  # caller sets.
  policy "RecordSightingWhenLessonSighted" do
    on      "Lesson.LessonSighted"
    trigger Sighting::Record, with: { sighting: :sighting, kind: :kind, run: :run, commit: :commit }
  end

  read_model "WorkByStatus" do
    description "How many work items stand in each status."
    include Work
    group_by :status
    count
  end

  read_model "FindingsByStatus" do
    description "How many findings stand in each status."
    include Finding
    group_by :status
    count
  end
end
