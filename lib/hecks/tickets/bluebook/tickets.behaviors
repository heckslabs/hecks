Hecks.behaviors "Tickets" do
  vision "A work item moves planned, started, done; or it is dropped with a reason, or lapses with its decision."

  loads "tickets.bluebook", "tickets.hecksagon", "tickets.ports.hecksagon"

  test "Plan enters a work item as planned" do
    tests "Plan", on: "Work"
    input work: { value: "w1" }, title: { value: "Add the everyday list" }, step: { value: 1 }
    expect status: "planned"
  end

  test "Plan refuses a work item with no title" do
    tests "Plan", on: "Work"
    input work: { value: "w2" }, title: { value: "" }
    expect refused: "a piece of work has a title"
  end

  test "Plan refuses a negative step" do
    tests "Plan", on: "Work"
    input work: { value: "w3" }, title: { value: "Too early" }, step: { value: -1 }
    expect refused: "a step is not negative"
  end

  test "Start moves a planned work item to started" do
    tests "Start", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w4" }, title: { value: "Declare for:" }
    input  work: { value: "w4" },
           claimed_by: { value: "session-1" }, claimed_at: { value: "2026-11-01T00:00:00Z" }
    expect status: "started"
  end

  test "Finish closes a started work item as done" do
    tests "Finish", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w5" }, title: { value: "Declare the run kind" }
    setup  "Tickets::Work.Start", work: { value: "w5" },
           claimed_by: { value: "session-1" }, claimed_at: { value: "2026-11-01T00:00:00Z" }
    input  work: { value: "w5" }
    expect status: "done"
  end

  test "Finish closes a planned work item that was never started" do
    tests "Finish", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w6" }, title: { value: "A one-line change" }
    input  work: { value: "w6" }
    expect status: "done"
  end

  test "Drop sets a work item aside with the reason" do
    tests "Drop", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w7" }, title: { value: "The context candidates query" }
    input  work: { value: "w7" }, reason: { value: "modules inside one context need no boundary finder" }
    expect status: "dropped"
  end

  test "Lapse drops a work item whose decision was superseded" do
    tests "Lapse", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w8" }, title: { value: "A step of a replaced plan" }
    input  work: { value: "w8" }
    expect status: "dropped"
  end

  test "Start refuses a work item that is already done" do
    tests "Start", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w9" }, title: { value: "Finished early" }
    setup  "Tickets::Work.Finish", work: { value: "w9" }
    input  work: { value: "w9" },
           claimed_by: { value: "session-1" }, claimed_at: { value: "2026-11-01T00:00:00Z" }
    expect refused: "done"
  end

  test "Revise keeps a started work item started, with its claim, area, priority and step" do
    tests "Revise", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w10" }, title: { value: "Wide" }, step: { value: 2 }
    setup  "Tickets::Work.Start", work: { value: "w10" },
           claimed_by: { value: "session-1" }, claimed_at: { value: "2026-11-01T00:00:00Z" },
           area: [{ value: "lib/hecks/tickets" }]
    setup  "Tickets::Work.Prioritize", work: { value: "w10" }, priority: { value: "now" }
    input  work: { value: "w10" }, title: { value: "Narrow" }, detail: { value: "d" }
    expect status: "started", claimed_by: { value: "session-1" }, claimed_at: { value: "2026-11-01T00:00:00Z" },
           priority: { value: "now" }, step: { value: 2 }
  end

  test "Revise replaces the title of a planned work item" do
    tests "Revise", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w12" }, title: { value: "Old" }
    input  work: { value: "w12" }, title: { value: "New" }, detail: { value: "d" }
    expect status: "planned", title: { value: "New" }
  end

  test "Revise refuses a done work item" do
    tests "Revise", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w13" }, title: { value: "Finished" }
    setup  "Tickets::Work.Finish", work: { value: "w13" }
    input  work: { value: "w13" }, title: { value: "Finished" }, detail: { value: "d" }
    expect refused: "done"
  end

  test "Rescope replaces the whole area and keeps the claim" do
    tests "Rescope", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w14" }, title: { value: "Wide" }
    setup  "Tickets::Work.Start", work: { value: "w14" },
           claimed_by: { value: "session-1" }, claimed_at: { value: "2026-11-01T00:00:00Z" },
           area: [{ value: "lib/hecks/a" }, { value: "lib/hecks/b" }]
    input  work: { value: "w14" }, area: [{ value: "lib/hecks/tickets" }]
    expect status: "started", claimed_by: { value: "session-1" }
  end

  test "ClearArea empties the area and keeps the claim" do
    tests "ClearArea", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w15" }, title: { value: "Scoped" }
    setup  "Tickets::Work.Start", work: { value: "w15" },
           claimed_by: { value: "session-1" }, claimed_at: { value: "2026-11-01T00:00:00Z" },
           area: [{ value: "lib/hecks/tickets" }]
    input  work: { value: "w15" }
    expect status: "started", claimed_by: { value: "session-1" }, area: []
  end

  test "Decide refuses a decision no Adr has" do
    tests "Decide", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w11" }, title: { value: "Unlinked" }
    input  work: { value: "w11" }, decision: "9999"
    expect refused: "Adr"
  end

  test "Open starts an epic open" do
    tests "Open", on: "Epic"
    input epic: { value: "e1" }, title: { value: "Carry out ADR 0204" }, outcome: { value: "Epics are real" }
    expect status: "open"
  end

  test "Assign refuses a finished work item" do
    tests "Assign", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w12" }, title: { value: "Done already" }
    setup  "Tickets::Work.Finish", work: { value: "w12" }
    setup  "Tickets::Epic.Open", epic: { value: "e1" }, title: { value: "An epic" }, outcome: { value: "Something is true" }
    input  work: { value: "w12" }, epic: "e1"
    expect refused: "a done work item joins no epic"
  end
end
