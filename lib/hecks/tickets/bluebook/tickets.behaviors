Hecks.behaviors "Tickets" do
  vision "A work item moves planned, started, done; or it is dropped with a reason, or lapses with its decision."

  loads "tickets.bluebook", "tickets.hecksagon", "tickets.ports.hecksagon"

  test "Plan enters a work item as planned" do
    tests "Plan", on: "Work"
    input work: { value: "w1" }, title: { value: "Add the everyday list" }, step: { value: 1 }
    expect status: "planned"
  end

  test "Plan refuses a work item with no title" do
    tests "Plan", on: "Work"
    input work: { value: "w2" }, title: { value: "" }
    expect refused: "a piece of work has a title"
  end

  test "Plan refuses a negative step" do
    tests "Plan", on: "Work"
    input work: { value: "w3" }, title: { value: "Too early" }, step: { value: -1 }
    expect refused: "a step is not negative"
  end

  test "Start moves a planned work item to started" do
    tests "Start", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w4" }, title: { value: "Declare for:" }
    input  work: { value: "w4" },
           claimed_by: { value: "session-1" }, claimed_at: { value: "2026-11-01T00:00:00Z" }
    expect status: "started"
  end

  test "Close closes a started work item as done with its landing on main" do
    tests "Close", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w5" }, title: { value: "Declare the run kind" }
    setup  "Tickets::Work.Start", work: { value: "w5" },
           claimed_by: { value: "session-1" }, claimed_at: { value: "2026-11-01T00:00:00Z" }
    input  work: { value: "w5" }, landing: { value: "d5211d977" }
    expect status: "done", landing: { value: "d5211d977" }
  end

  test "Close closes a planned work item that lands no change, with the reason" do
    tests "Close", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w6" }, title: { value: "Verify the gate" }
    input  work: { value: "w6" }, no_change: { value: "a verify" }
    expect status: "done", no_change: { value: "a verify" }
  end

  test "Close refuses a work item with neither a landing nor a no-change reason" do
    tests "Close", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w6b" }, title: { value: "A one-line change" }
    input  work: { value: "w6b" }
    expect refused: "a work item is done only with a landing on main or a no-change reason"
  end

  test "Drop sets a work item aside with the reason" do
    tests "Drop", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w7" }, title: { value: "The context candidates query" }
    input  work: { value: "w7" }, reason: { value: "modules inside one context need no boundary finder" }
    expect status: "dropped"
  end

  test "Lapse drops a work item whose decision was superseded" do
    tests "Lapse", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w8" }, title: { value: "A step of a replaced plan" }
    input  work: { value: "w8" }
    expect status: "dropped"
  end

  test "Start refuses a work item that is already done" do
    tests "Start", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w9" }, title: { value: "Finished early" }
    setup  "Tickets::Work.Close", work: { value: "w9" }, no_change: { value: "a verify" }
    input  work: { value: "w9" },
           claimed_by: { value: "session-1" }, claimed_at: { value: "2026-11-01T00:00:00Z" }
    expect refused: "done"
  end

  test "Revise keeps a started work item started, with its claim, area, priority and step" do
    tests "Revise", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w10" }, title: { value: "Wide" }, step: { value: 2 }
    setup  "Tickets::Work.Start", work: { value: "w10" },
           claimed_by: { value: "session-1" }, claimed_at: { value: "2026-11-01T00:00:00Z" },
           area: [{ value: "lib/hecks/tickets" }]
    setup  "Tickets::Work.Prioritize", work: { value: "w10" }, priority: { value: "now" }
    input  work: { value: "w10" }, title: { value: "Narrow" }, detail: { value: "d" }
    expect status: "started", claimed_by: { value: "session-1" }, claimed_at: { value: "2026-11-01T00:00:00Z" },
           priority: { value: "now" }, step: { value: 2 }
  end

  test "Enlist puts a planned sweep item into its batch" do
    tests "Enlist", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w40" }, title: { value: "Wording" }, area: [{ value: "docs/a.md" }]
    setup  "Tickets::Work.Categorize", work: { value: "w40" }, category: { value: "sweep" }
    input  work: { value: "w40" }, batch: { value: "sweep-batch-1" }
    expect status: "batched", batch: { value: "sweep-batch-1" }
  end

  test "Enlist refuses a batch it does not name" do
    tests "Enlist", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w41" }, title: { value: "Code" }
    input  work: { value: "w41" }, batch: { value: "" }
    expect refused: "a batch is named by its work item"
  end

  test "Return hands a batched item back to the plan" do
    tests "Return", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w42" }, title: { value: "Wording" }, area: [{ value: "docs/a.md" }]
    setup  "Tickets::Work.Categorize", work: { value: "w42" }, category: { value: "sweep" }
    setup  "Tickets::Work.Enlist", work: { value: "w42" }, batch: { value: "sweep-batch-1" }
    input  work: { value: "w42" }, reason: { value: "the paragraph moved" }
    expect status: "planned", batch: { value: "" }
  end

  test "Start refuses a sweep item outside its batch" do
    tests "Start", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w43" }, title: { value: "Wording" }, area: [{ value: "docs/a.md" }]
    setup  "Tickets::Work.Categorize", work: { value: "w43" }, category: { value: "sweep" }
    input  work: { value: "w43" }, claimed_by: { value: "s" }, claimed_at: { value: "2026-11-19T00:00:00Z" }
    expect refused: "a sweep item starts only in its batch"
  end

  test "Expedite puts an open work item ahead of the queue" do
    tests "Expedite", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w30" }, title: { value: "Hot" }
    input  work: { value: "w30" }
    expect status: "planned", priority: { value: "expedite" }
  end

  test "Expedite refuses a done work item" do
    tests "Expedite", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w31" }, title: { value: "Over" }
    setup  "Tickets::Work.Close", work: { value: "w31" }, no_change: { value: "a verify" }
    input  work: { value: "w31" }
    expect refused: "a done or dropped work item is not expedited"
  end

  test "Prioritize leaves expedite to Expedite" do
    tests "Prioritize", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w32" }, title: { value: "Hot" }
    input  work: { value: "w32" }, priority: { value: "expedite" }
    expect refused: "expedite is the orchestrator's: Work.expedite!"
  end

  test "Revise replaces the title of a planned work item" do
    tests "Revise", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w12" }, title: { value: "Old" }
    input  work: { value: "w12" }, title: { value: "New" }, detail: { value: "d" }
    expect status: "planned", title: { value: "New" }
  end

  test "Note asks for a dated line to be appended to an open work item's detail" do
    tests "Note", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w12n" }, title: { value: "Old" }
    input  work: { value: "w12n" }, note: { value: "blocked on a review" }, dated: { value: "2026-11-20" }
    expect status: "planned", emits: ["WorkNoteRequested", "NoteComposed", "WorkNoted"]
  end

  test "Note refuses a done work item" do
    tests "Note", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w13n" }, title: { value: "Finished" }
    setup  "Tickets::Work.Close", work: { value: "w13n" }, no_change: { value: "a verify" }
    input  work: { value: "w13n" }, note: { value: "late" }, dated: { value: "2026-11-20" }
    expect refused: "done"
  end

  test "Revise refuses a done work item" do
    tests "Revise", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w13" }, title: { value: "Finished" }
    setup  "Tickets::Work.Close", work: { value: "w13" }, no_change: { value: "a verify" }
    input  work: { value: "w13" }, title: { value: "Finished" }, detail: { value: "d" }
    expect refused: "done"
  end

  test "Rescope replaces the whole area and keeps the claim" do
    tests "Rescope", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w14" }, title: { value: "Wide" }
    setup  "Tickets::Work.Start", work: { value: "w14" },
           claimed_by: { value: "session-1" }, claimed_at: { value: "2026-11-01T00:00:00Z" },
           area: [{ value: "lib/hecks/a" }, { value: "lib/hecks/b" }]
    input  work: { value: "w14" }, area: [{ value: "lib/hecks/tickets" }]
    expect status: "started", claimed_by: { value: "session-1" }
  end

  test "Plan takes the work items a work item waits on" do
    tests "Plan", on: "Work"
    input  work: { value: "w16" }, title: { value: "Later" }, waits_on: [{ value: "w17" }]
    expect status: "planned", emits: ["WorkPlanned", "AreaNamed"]
  end

  test "WaitOn replaces the work items a planned work item waits on" do
    tests "WaitOn", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w18" }, title: { value: "Held" }, waits_on: [{ value: "w19" }]
    input  work: { value: "w18" }, waits_on: [{ value: "w20" }, { value: "w21" }]
    expect status: "planned", emits: ["WorkWaitsOnNamed"]
  end

  test "WaitOn refuses a done work item" do
    tests "WaitOn", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w22" }, title: { value: "Finished" }
    setup  "Tickets::Work.Close", work: { value: "w22" }, no_change: { value: "a verify" }
    input  work: { value: "w22" }, waits_on: [{ value: "w23" }]
    expect refused: "done"
  end

  test "ClearArea empties the area and keeps the claim" do
    tests "ClearArea", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w15" }, title: { value: "Scoped" }
    setup  "Tickets::Work.Start", work: { value: "w15" },
           claimed_by: { value: "session-1" }, claimed_at: { value: "2026-11-01T00:00:00Z" },
           area: [{ value: "lib/hecks/tickets" }]
    input  work: { value: "w15" }
    expect status: "started", claimed_by: { value: "session-1" }, area: []
  end

  test "Decide refuses a decision no Adr has" do
    tests "Decide", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w11" }, title: { value: "Unlinked" }
    input  work: { value: "w11" }, decision: "9999"
    expect refused: "Adr"
  end

  test "Open starts an epic open" do
    tests "Open", on: "Epic"
    input epic: { value: "e1" }, title: { value: "Carry out ADR 0204" }, outcome: { value: "Epics are real" }
    expect status: "open"
  end

  test "Open leaves the epic's measure unread" do
    tests "Open", on: "Epic"
    input epic: { value: "e1" }, title: { value: "An epic" }, outcome: { value: "Something is true" }
    expect measured: { value: "unread" }
  end

  test "Complete keeps that the measure was met" do
    tests "Complete", on: "Epic"
    setup "Tickets::Epic.Open", epic: { value: "e1" }, title: { value: "An epic" }, outcome: { value: "Something is true" }
    input epic: "e1", members: { value: 1 }, open_members: { value: 0 }, reading: { value: 2 },
          at_least: { value: 2 }, at_most: { value: 9 }, evidence: { value: "read 2" }
    expect measured: { value: "met" }, status: "complete"
  end

  test "Miss keeps that the measure was missed" do
    tests "Miss", on: "Epic"
    setup "Tickets::Epic.Open", epic: { value: "e1" }, title: { value: "An epic" }, outcome: { value: "Something is true" }
    input epic: "e1", reading: { value: 1 }, at_least: { value: 2 }, at_most: { value: 9 },
          evidence: { value: "read 1" }, finding: { value: "e1-outcome-1" }
    expect measured: { value: "missed" }, status: "open"
  end

  test "LeaveUnmeasured returns a met measure to unread" do
    tests "LeaveUnmeasured", on: "Epic"
    setup "Tickets::Epic.Open", epic: { value: "e1" }, title: { value: "An epic" }, outcome: { value: "Something is true" }
    setup "Tickets::Epic.Complete", epic: "e1", members: { value: 1 }, open_members: { value: 0 }, reading: { value: 2 },
                                    at_least: { value: 2 }, at_most: { value: 9 }, evidence: { value: "read 2" }
    input epic: "e1", evidence: { value: "no event tap is declared" }
    expect measured: { value: "unread" }, evidence: { value: "no event tap is declared" }
  end

  test "MeasureBy returns a met measure to unread and clears its evidence" do
    tests "MeasureBy", on: "Epic"
    setup "Tickets::Epic.Open", epic: { value: "e1" }, title: { value: "An epic" }, outcome: { value: "Something is true" }
    setup "Tickets::Epic.Complete", epic: "e1", members: { value: 1 }, open_members: { value: 0 }, reading: { value: 2 },
                                    at_least: { value: 2 }, at_most: { value: 9 }, evidence: { value: "read 2" }
    input epic: "e1", measure: { value: "two-branches-land" }
    expect measured: { value: "unread" }, evidence: { value: "" }, status: "complete"
  end

  test "Retitle changes the title and keeps the outcome" do
    tests "Retitle", on: "Epic"
    setup "Tickets::Epic.Open", epic: { value: "e1" }, title: { value: "Old" }, outcome: { value: "Something is true" }
    input epic: "e1", title: { value: "Plain words" }
    expect title: { value: "Plain words" }, outcome: { value: "Something is true" }, status: "open"
  end

  test "Rank sets the tier and keeps the title" do
    tests "Rank", on: "Epic"
    setup "Tickets::Epic.Open", epic: { value: "e1" }, title: { value: "Old" }, outcome: { value: "Something is true" }
    input epic: "e1", tier: { value: 3 }, hold: { value: 60 }, now: { value: 1000 }
    expect tier: { value: 3 }, title: { value: "Old" }, hand_ranked_at: { value: 1000 }, hold: { value: 60 }
  end

  test "Rank refuses a tier above 9" do
    tests "Rank", on: "Epic"
    setup "Tickets::Epic.Open", epic: { value: "e1" }, title: { value: "Old" }, outcome: { value: "Something is true" }
    input epic: "e1", tier: { value: 10 }, hold: { value: 60 }, now: { value: 1000 }
    expect refused: "an epic tier is from 1 to 9"
  end

  test "Rerank refuses while the owner's hand rank is held" do
    tests "Rerank", on: "Epic"
    setup "Tickets::Epic.Open", epic: { value: "e1" }, title: { value: "Old" }, outcome: { value: "Something is true" }
    setup "Tickets::Epic.Rank", epic: "e1", tier: { value: 2 }, hold: { value: 60 }, now: { value: 1000 }
    input epic: "e1", tier: { value: 7 }, now: { value: 1059 }
    expect refused: "a tier the owner set by hand is held"
  end

  test "Rerank sets the tier once the hold has passed" do
    tests "Rerank", on: "Epic"
    setup "Tickets::Epic.Open", epic: { value: "e1" }, title: { value: "Old" }, outcome: { value: "Something is true" }
    setup "Tickets::Epic.Rank", epic: "e1", tier: { value: 2 }, hold: { value: 60 }, now: { value: 1000 }
    input epic: "e1", tier: { value: 7 }, now: { value: 1060 }
    expect tier: { value: 7 }, hand_ranked_at: { value: 1000 }
  end

  test "Retitle refuses an empty title" do
    tests "Retitle", on: "Epic"
    setup "Tickets::Epic.Open", epic: { value: "e1" }, title: { value: "Old" }, outcome: { value: "Something is true" }
    input epic: "e1", title: { value: " " }
    expect refused: "an epic has a title"
  end

  test "Assign refuses a finished work item" do
    tests "Assign", on: "Work"
    setup  "Tickets::Work.Plan", work: { value: "w12" }, title: { value: "Done already" }
    setup  "Tickets::Work.Close", work: { value: "w12" }, no_change: { value: "a verify" }
    setup  "Tickets::Epic.Open", epic: { value: "e1" }, title: { value: "An epic" }, outcome: { value: "Something is true" }
    input  work: { value: "w12" }, epic: "e1"
    expect refused: "a done work item joins no epic"
  end
end
