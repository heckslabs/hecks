# The Tickets domain, bound so it boots standing alone (a fuzz or model_check boot of this
# directory). The GitHubIssues port every attaching hecksagon shares is in tickets.ports.hecksagon.
Hecks.hecksagon "Tickets" do
  attaches "Governance"
  persisted_by "Memory"

  # The coder's submitted branch, which finishes its work step. Declarative: the Coder domain
  # emits it, and the FinishWhenWorkSubmitted policy reacts.
  subscribe "Coder.WorkSubmitted"

  # The Hecks domain's landing found the step a landed branch was cut for: FinishWorkWhenBranchLanded reacts.
  subscribe "Hecks.LandedWorkFound"

  # The Hecks domain's landing job refused a branch a coder can fix: ReopenWorkWhenLandingRefused reacts.
  subscribe "Hecks.RefusedWorkFound"

  # The Hecks domain's stall watch filed a stall: PlanWorkWhenStallFiled plans its work item.
  subscribe "Hecks.StallFiled"

  # The stall watch closed a stall whose run ended: DropWorkWhenStallAbandoned sets its work item aside.
  subscribe "Hecks.StallAbandoned"
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
