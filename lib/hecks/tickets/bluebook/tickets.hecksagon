# The Tickets domain, bound so it boots standing alone (a fuzz or model_check boot of this
# directory). The GitHubIssues port every attaching hecksagon shares is in tickets.ports.hecksagon.
Hecks.hecksagon "Tickets" do
  attaches "Governance"
  persisted_by "Memory"

  # The Hecks domain's landing found the step a landed branch was cut for: CloseWorkWhenBranchLanded reacts.
  subscribe "Delivery.LandedWorkFound"

  # The Hecks domain's landing job refused a branch a coder can fix: RefuseWorkWhenLandingRefused reacts.
  subscribe "Delivery.RefusedWorkFound"
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
