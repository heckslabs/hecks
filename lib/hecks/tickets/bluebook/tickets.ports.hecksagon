# The ports Tickets declares, for every hecksagon that attaches the bluebook (`Bluebooks` loads this
# file with it). A work item's ports read Hecks's own rows: the areas other started work items hold,
# and the cap on started work items. Each ask is answered with the record's own arguments or refused
# with a reason. The ports have to be declared even where no adapter binds them, so the policies have
# a target and model_check's deaf-policy check can see it.
Hecks.hecksagon "Tickets" do
  Tickets::Work.port "WorkAreas" do
    asks "CheckArea", to: Work do
      attribute :work, WorkKey
      answers "AreaCleared"
      refuses "AreaRefused"
    end
  end

  # The cap on started work items, which reads the other work items, as a bluebook rule cannot. The
  # cap is the world's `work_limit` setting.
  Tickets::Work.port "WorkLimits" do
    asks "CheckCap", to: Work do
      attribute :work, WorkKey
      answers "CapCleared"
      refuses "CapRefused"
    end
  end
end
