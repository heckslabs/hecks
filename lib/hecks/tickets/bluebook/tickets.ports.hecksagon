# The port Tickets declares, for every hecksagon that attaches the bluebook (`Bluebooks` loads this
# file with it). Each lifecycle event of a finding asks the GitHubIssues port, which the Hecks domain
# binds (lib/hecks/hecks/adapters/finding_github.rb): the outside a finding reaches. The ask is
# answered with the record's own arguments or refused with a reason, and a refusal is recorded on the
# finding and never blocks it. The port has to be declared even where no adapter binds it, so the
# policies have a target and model_check's deaf-policy check can see it.
#
# Only OpenIssue answers with the issue number, so only its answer is recorded on the finding; the
# other asks answer with a line saying what was done.
Hecks.hecksagon "Tickets" do
  Tickets::Finding.port "GitHubIssues" do
    asks "OpenIssue", to: Finding do
      attribute :finding, FindingKey
      answers "IssueOpened"
      refuses "GitHubRefused"
    end

    %w[LabelIssue CommentOnIssue CloseIssue ReopenIssue].each do |ask|
      asks ask, to: Finding do
        attribute :finding, FindingKey
        answers "GitHubAnswered"
        refuses "GitHubRefused"
      end
    end
  end
  Tickets::Work.port "WorkAreas" do
    asks "CheckArea", to: Work do
      attribute :work, WorkKey
      answers "AreaCleared"
      refuses "AreaRefused"
    end
  end

  # The cap on started rows and the clock behind `Work.overdue`: both read the other rows or the
  # time, which a bluebook rule cannot. The cap is the world's `work_limit` setting.
  Tickets::Work.port "WorkLimits" do
    asks "CheckCap", to: Work do
      attribute :work, WorkKey
      answers "CapCleared"
      refuses "CapRefused"
    end

    answers_query "Overdue"
    answers_query "Bloat"
  end
end
