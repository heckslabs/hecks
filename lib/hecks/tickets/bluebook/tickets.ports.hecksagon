# The port Tickets declares, for every hecksagon that attaches the bluebook (`Bluebooks` loads this
# file with it). Each lifecycle event of a finding asks the GitHubIssues port, which the Hecks domain
# binds (lib/hecks/hecks/adapters/finding_github.rb): the outside a finding reaches. The ask is
# answered with the record's own arguments or refused with a reason, and a refusal is recorded on the
# finding and never blocks it. The port has to be declared even where no adapter binds it, so the
# policies have a target and model_check's deaf-policy check can see it.
#
# Only OpenIssue answers with the issue number, so only its answer is recorded on the finding; the
# other asks answer with a line saying what was done.
Hecks.hecksagon "Tickets" do
  Tickets::Finding.port "GitHubIssues" do
    asks "OpenIssue", to: Finding do
      attribute :finding, FindingKey
      answers "IssueOpened"
      refuses "GitHubRefused"
    end

    %w[LabelIssue CommentOnIssue CloseIssue ReopenIssue].each do |ask|
      asks ask, to: Finding do
        attribute :finding, FindingKey
        answers "GitHubAnswered"
        refuses "GitHubRefused"
      end
    end
  end
  Tickets::Work.port "WorkAreas" do
    asks "CheckArea", to: Work do
      attribute :work, WorkKey
      answers "AreaCleared"
      refuses "AreaRefused"
    end
  end

  # The cap on started work items, which reads the other work items, as a bluebook rule cannot. The
  # cap is the world's `work_limit` setting.
  Tickets::Work.port "WorkLimits" do
    asks "CheckCap", to: Work do
      attribute :work, WorkKey
      answers "CapCleared"
      refuses "CapRefused"
    end
  end

  # Whether an epic has a member and none planned or started, which reads the Work items as a
  # bluebook rule cannot. The answer completes the epic.
  Tickets::Epic.port "EpicMembers" do
    asks "CheckMembers", to: Epic do
      attribute :epic, EpicKey
      answers "MembersCleared"
      refuses "MembersRefused"
    end
  end

  # One epic's members counted, read and never written.
  Tickets::Work.port "EpicProgress" do
    answers_query "EpicProgress"
  end

  # The backlog in the order the Dispatching port starts it, read and never written.
  Tickets::Work.port "PriorityReport" do
    answers_query "PriorityReport"
  end
end

# Where the decision records live: their files under docs/decisions, read through the DecisionFiles
# persistence adapter (adapters/decision_files.rb), so every process that boots Tickets sees the same
# records and a Work item's `decision` resolves against them. The Tickets world names the directory
# (`persisted_by("DecisionFiles") do directory "docs/decisions" end`); a world that names none, or
# `None`, leaves the store a plain Memory one, which a standalone, fuzz or model_check boot and a spec
# get. A store read from files takes no write (Draft, Accept and Supersede are refused by name) until
# writing a status line back is built. The bind is Ruby-only, as Tenancy's LocalStorage is: the Rust
# host runs no Tickets module.
#
# Binding one aggregate makes the wiring explicit, so the rest need a default too. It is not a root
# bind here: a root bind is handed to Governance, which the attaching Hecks domain also hands its own
# to, and the two would conflict where Hecks is PostgresEra. The Tickets world's `default_adapter`
# (Memory, the tooling default) covers them where nothing is inherited, and a local overlay still
# binds Finding and Work to its own store.
Hecks.hecksagon "Tickets" do
  Tickets::Adr.persisted_by("DecisionFiles")
end
