# Required by name, not relative to this file: a fuzz or model check boots a copy of this directory,
# and the implementation must load once, from `lib/`, not from the copy.
require "hecks/tickets/bluebook/adapters/decision_files"

Hecks.adapter "DecisionFiles" do
  port  "persistence"
  # The decision files, relative to the checkout that holds the booted domain, or absolute. `None`,
  # the default, leaves the store a plain Memory one.
  field :directory, default: "None"
end
