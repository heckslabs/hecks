# The settings the five laws need (ADR 0222), started from the 2026-11-18/19 readings of the
# owner's M3 Pro (36 GB, 12 cores). Nothing reads them until phase 2 wires Signalbox in.
Hecks.world "Signalbox" do
  # Law 2. `capacity_mb` is the machine; `reserve_mb` is kept for the system and the person using
  # it, so the pipeline's supply is 28 GB (memory reached 33 of 36 GB used on 2026-11-13).
  # `target_mb` and `floor_mb` are the old free-memory marks (6 GB recovered, 3 GB low).
  pressure "Pressure", capacity_mb: 36_864, reserve_mb: 8_192, target_mb: 6_144, floor_mb: 3_072,
                       gap_mb: 2_048, interval_seconds: 60, stale_after_seconds: 120

  # Law 4. One start a minute staggers boots and quick gates, whose peaks tripped the machine.
  # `share_percent` 100: never more helpers than coders (the storm held 80 helpers to 3 coders).
  ramp "Admission", step: 1, window_seconds: 60
  helper_share "Admission", share_percent: 100

  # Expected draw by role. A helper is about 300 MB (the storm: about 22 GB over 80 sessions);
  # the coder and gate figures are estimates until Roundhouse meters every session.
  draws "Admission", coder_mb: 1_536, helper_mb: 300, gate_mb: 2_560, orchestrator_mb: 400, repair_mb: 400

  # Law 5. Each role's own fuse, about three times its draw, and a time rating that ends phantom
  # load: a helper's purpose fits in half an hour; the one standing seat runs a day.
  fuses "Session", coder_mb: 4_096, coder_minutes: 240, helper_mb: 1_024, helper_minutes: 30,
                   gate_mb: 6_144, gate_minutes: 20, orchestrator_mb: 1_024, orchestrator_minutes: 1_440,
                   repair_mb: 1_024, repair_minutes: 60

  # Law 5. The MCP servers each role starts; a role not named starts none (76 were live for
  # sessions that used none). Only the roles that use the Hecks door name it.
  mcp_servers "Admission", architect: ["hecks"], hecks_helper: ["hecks"], hecks_composer: ["hecks"],
                           hecks_agent: ["hecks"]

  # Protection, smallest first. The machine fuse keeps the boot-hours budget the 24.16 of 24 trip
  # read against; `gap` is how far under its rating a breaker's load falls before it resets.
  breakers "Breaker", helpers_percent: 100, shedding_min_coders: 2, machine_boot_hours: 24, reset_gap_percent: 10

  # One standing orchestrator seat at most; a gone seat is the only one restarted.
  seats "Admission", orchestrator: 1
end
