  # ---- Reaping: ended sessions and landed copies go, from the meter ----

  # Incident: 60 finished helper sessions stayed listed until prune_sessions.sh removed them.
  test "a finished helper past its ended window is reaped" do
    tests "Rule", on: "Reaping"
    input reaping: { value: "reap-1:a1b2" }, subject: { value: "a1b2" }, kind: { value: "finished" },
          state: { value: "done" }, role: { value: "helper" }, live: { value: "no" }, idle: { value: 12 },
          keep: { value: 5 }, unsaved: { value: 0 }, pinned: { value: "no" }, open: { value: "no" }, landed: { value: "no" }
    expect emits: ["ReapingRuled"]
  end

  test "a finished session inside its ended window is kept" do
    tests "Rule", on: "Reaping"
    input reaping: { value: "reap-1:c3d4" }, subject: { value: "c3d4" }, kind: { value: "finished" },
          state: { value: "done" }, role: { value: "helper" }, live: { value: "no" }, idle: { value: 2 },
          keep: { value: 5 }, unsaved: { value: 0 }, pinned: { value: "no" }, open: { value: "no" }, landed: { value: "no" }
    expect refused: "a session is reaped only once it has been idle its keep window"
  end

  test "a working session is not finished" do
    tests "Rule", on: "Reaping"
    input reaping: { value: "reap-1:e5f6" }, subject: { value: "e5f6" }, kind: { value: "finished" },
          state: { value: "working" }, role: { value: "helper" }, live: { value: "yes" }, idle: { value: 40 },
          keep: { value: 5 }, unsaved: { value: 0 }, pinned: { value: "no" }, open: { value: "no" }, landed: { value: "no" }
    expect refused: "a finished session is listed done or stopped"
  end

  test "a session with unsaved work is never reaped" do
    tests "Rule", on: "Reaping"
    input reaping: { value: "reap-1:a7b8" }, subject: { value: "a7b8" }, kind: { value: "finished" },
          state: { value: "done" }, role: { value: "coder" }, live: { value: "no" }, idle: { value: 90 },
          keep: { value: 5 }, unsaved: { value: 3 }, pinned: { value: "no" }, open: { value: "no" }, landed: { value: "no" }
    expect refused: "a session with unsaved work is never reaped"
  end

  test "a pinned session is never reaped" do
    tests "Rule", on: "Reaping"
    input reaping: { value: "reap-1:c9d0" }, subject: { value: "c9d0" }, kind: { value: "finished" },
