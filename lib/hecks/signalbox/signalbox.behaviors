  # Incident: the cap flipped 4, 5, 6, 7. A coder admitted at the floor is shed by the next dip
  # under it, so admission keeps the gap above the floor that shedding trips at: hysteresis.
  test "hysteresis: a lower-tier coder that would leave less than the gap above the floor waits" do
    tests "Admit", on: "Admission"
    input admission: { value: "coder-gap-1" }, role: { value: "coder" }, tier: { value: "normal" },
          owner: { value: "signalbox-admits-by-headroom" }, purpose: { value: "admit by headroom" }, ends_when: { value: "the branch lands" },
          draw: { value: 1536 }, fuse: { value: 4096 }, fuse_minutes: { value: 240 }, asked_by: { value: "delegate" },
