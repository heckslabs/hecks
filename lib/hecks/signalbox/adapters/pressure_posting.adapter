# Binds the `PressurePosting` port to `PressurePosting`, which posts the machine's settled Pressure
# as the one signal every process reads. It writes only that file.
# Required by name, not relative, so a copy of this directory shares the one implementation loaded.
require "hecks/signalbox/adapters/pressure_posting"

Hecks.adapter "PressurePosting" do
  port "PressurePosting"
end
