# Binds the `Looking` port to `Looking`, which answers the pressure beat's look from git, Roundhouse's
# meter, the Signalbox world and Delegate's last fill and shed. It only reads.
# Required by name, not relative, so a copy of this directory shares the one implementation loaded.
require "hecks/signalbox/adapters/looking"

Hecks.adapter "Looking" do
  port "Looking"
end
