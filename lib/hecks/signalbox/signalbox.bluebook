# Signalbox decides how the machine's compute is spent, by the five laws of ADR 0222: one budget,
# one pressure signal, local response, admission by headroom, and every session closing its circuit.
# It decides only; Roundhouse starts, meters, rests and reaps the sessions it names.

Hecks.bluebook "Signalbox" do
  vision "The machine's compute is one budget: every session is admitted by headroom, answers one pressure signal by its own rule, and is protected smallest breaker first."

  supporting

  # Law 2. The one pressure signal: headroom against capacity, in a band. A band eases only once
  # headroom passes the target by the gap, so a reading near the target never flips it.
  aggregate "Pressure" do
    description "A machine's pressure signal: its capacity, the last headroom read against the target, and the band it puts the machine in."
    created_by "Pressure.open!"

    identified_by :pressure

    attribute :pressure, Key
    attribute :capacity, Megabytes
    attribute :headroom, Signed, optional: true
    attribute :target,   Megabytes, optional: true
    attribute :floor,    Megabytes, optional: true
    attribute :gap,      Megabytes, optional: true
    # The second input (decided 2026-11-19): the 1-minute load in hundredths, the performance cores
    # it is read against, and the load marks in percent of those cores.
    attribute :load,       Hundredths, optional: true
    attribute :cores,      Count, optional: true
    attribute :load_tight, Percent, optional: true
    attribute :load_short, Percent, optional: true
    attribute :load_gap,   Percent, optional: true
    # The second memory input (decided 2026-11-20): the OS's memory pressure level, 1 normal, 2 warn,
    # 4 critical, 0 unread. The OS counts what it can compress and reclaim, which no page count says.
    attribute :memory_pressure_level, Count, optional: true
    # The published signal's room (phase 3b): how many coders and how many gates the headroom fits,
    # as the beat reckoned them; none while the band is short.
    attribute :coders_fit, Signed, optional: true
    attribute :gates_fit,  Signed, optional: true

    value_object "Key" do
      attribute :value, String, matches: :present
    end

    value_object "Megabytes" do
      attribute :value, Integer, default: 0
      invariant("an amount of memory is not negative") { !value.negative? }
    end

    # Headroom goes below zero when the draw passes the supply.
    value_object "Signed" do
      attribute :value, Integer, default: 0
    end

    value_object "Seconds" do
      attribute :value, Integer, default: 0
      invariant("a duration is not negative") { !value.negative? }
    end

    value_object "Hundredths" do
      attribute :value, Integer, default: 0
      invariant("a load is not negative") { !value.negative? }
    end

    value_object "Count" do
      attribute :value, Integer, default: 0
      invariant("a count is not negative") { !value.negative? }
    end

    value_object "Percent" do
      attribute :value, Integer, default: 0
      invariant("a mark is not negative") { !value.negative? }
    end

    lifecycle :band, default: "normal" do
      mark :rests, "normal", "tight", "short", "dark"
      transition "Tighten" => "tight",  from: %w[normal tight short dark]
      transition "Trip"    => "short",  from: %w[normal tight short dark]
      transition "Ease"    => "normal", from: %w[normal tight short dark]
      transition "Darken"  => "dark",   from: %w[normal tight short dark]
    end

    command "Open" do
      role "System"
      goal "Start a machine's pressure signal with the capacity its sessions share"

      attribute :pressure, Key, sets: true
      attribute :capacity, Megabytes, sets: true

      emits PressureOpened
    end

    # A reading names the marks it is judged against, so every part reads the same signal. The load
    # and its marks are the second input; a reading that leaves them out is judged on memory alone.
    command "Read" do
      role "System"
      goal "Publish one current reading of headroom and load against their marks"

      reference_to Pressure
      attribute :headroom,    Signed, sets: true
      attribute :target,      Megabytes, sets: true
      attribute :floor,       Megabytes, sets: true
      attribute :gap,         Megabytes, sets: true
      attribute :load,        Hundredths, default: { value: 0 }, sets: true
      attribute :cores,       Count, default: { value: 0 }, sets: true
      attribute :load_tight,  Percent, default: { value: 0 }, sets: true
      attribute :load_short,  Percent, default: { value: 0 }, sets: true
      attribute :load_gap,    Percent, default: { value: 0 }, sets: true
      attribute :memory_pressure_level, Count, default: { value: 0 }, sets: true
      attribute :coders_fit,  Signed, default: { value: 0 }, sets: true
      attribute :gates_fit,   Signed, default: { value: 0 }, sets: true
      attribute :age,         Seconds
      attribute :stale_after, Seconds

      given("a reading is published only while it is current") { age.value <= stale_after.value }

      emits PressureRead
    end

    command "Tighten" do
      role "System"
      goal "Put the machine in the tight band: headroom is under the target"

      reference_to Pressure

      emits PressureTightened
    end

    command "Trip" do
      role "System"
      goal "Put the machine in the short band: headroom is under the floor"

      reference_to Pressure

      sets :coders_fit, to: { value: 0 }
      sets :gates_fit,  to: { value: 0 }

      emits PressureFellShort
    end

    command "Ease" do
      role "System"
      goal "Put the machine back in the normal band: headroom is past the target by the gap"

      reference_to Pressure

      emits PressureEased
    end

    # Anti-islanding: with no current reading the signal goes dark and no part acts on it.
    command "Darken" do
      role "System"
      goal "Put the machine in the dark band: no current reading of it exists"

      reference_to Pressure
      attribute :age,         Seconds
      attribute :stale_after, Seconds

      given("the signal goes dark only when its reading is stale") { age.value > stale_after.value }

      emits PressureDarkened
    end
  end

  # Laws 1, 4 and 5, with merit order. A session starts only on an admission, and every given
  # below is one reason it waits. No cap is set: the sessions that fit are the cap.
  aggregate "Admission" do
    description "One session admitted to draw on the machine: its role, owner, purpose, end condition, expected draw and fuse."
    created_by "Admission.admit!"

    identified_by :admission

    attribute :admission,    Key
    attribute :role,         Role
    attribute :tier,         Tier
    attribute :owner,        Label
    attribute :purpose,      Label
    attribute :ends_when,    Label
    attribute :draw,         Megabytes
    attribute :fuse,         Megabytes
    attribute :fuse_minutes, Minutes

    value_object "Key" do
      attribute :value, String, matches: :present
    end

    # Law 5: no session is unlabeled. Its owner, purpose and end condition say something.
    value_object "Label" do
      attribute :value, String
      invariant("a session names its owner, its purpose and its end condition") { !value.to_s.strip.empty? }
    end

    value_object "Role" do
      attribute :value, String
      invariant("a role is coder, helper, gate, orchestrator or repair") do
        value == "coder" || value == "helper" || value == "gate" || value == "orchestrator" || value == "repair"
      end
    end

    value_object "Tier" do
      attribute :value, String
      invariant("a tier is urgent, normal or low") { value == "urgent" || value == "normal" || value == "low" }
    end

    value_object "Band" do
      attribute :value, String
      invariant("a band is normal, tight, short or dark") do
        value == "normal" || value == "tight" || value == "short" || value == "dark"
      end
    end

    value_object "Word" do
      attribute :value, String, matches: :present
    end

    value_object "Megabytes" do
      attribute :value, Integer, default: 0
      invariant("an amount of memory is not negative") { !value.negative? }
    end

    value_object "Signed" do
      attribute :value, Integer, default: 0
    end

    value_object "Minutes" do
      attribute :value, Integer, default: 0
      invariant("a duration is not negative") { !value.negative? }
    end

    value_object "Seconds" do
      attribute :value, Integer, default: 0
      invariant("a duration is not negative") { !value.negative? }
    end

    value_object "Count" do
      attribute :value, Integer, default: 0
      invariant("a count is not negative") { !value.negative? }
    end

    # An admission rests until Roundhouse reports its session ended; its own fuse bounds it.
    lifecycle :status, default: "admitted" do
      mark :rests, "admitted"
      mark :terminal, "closed"
      transition "Close" => "closed", from: "admitted"
    end

    command "Admit" do
      role "System"
      goal "Admit one session whose expected draw fits the headroom, in merit order, under every law"

      attribute :admission,      Key, sets: true
      attribute :role,           Role, sets: true
      attribute :tier,           Tier, sets: true
      attribute :owner,          Label, sets: true
      attribute :purpose,        Label, sets: true
      attribute :ends_when,      Label, sets: true
      attribute :draw,           Megabytes, sets: true
      attribute :fuse,           Megabytes, sets: true
      attribute :fuse_minutes,   Minutes, sets: true
      attribute :asked_by,       Word
      attribute :switch,         Word
      attribute :met,            Word
      attribute :band,           Band
      attribute :headroom,       Signed
      attribute :age,            Seconds
      attribute :stale_after,    Seconds
      attribute :started,        Count
      attribute :ramp,           Count
      attribute :coders,         Count
      attribute :helpers,        Count
      attribute :share,          Count
      attribute :outranked,      Count
      attribute :seats,          Count
      attribute :unused_servers, Count
      attribute :curtailed,      Count
      # The shedding floor and the gap admission keeps above it (phase 3, admission). Absent, both
      # are nought and the given below is the draw fitting the headroom.
      attribute :floor,          Megabytes, default: { value: 0 }
      attribute :gap,            Megabytes, default: { value: 0 }
      # The kernel's memory pressure level the beat read; nought when unread or not passed on.
      attribute :memory_pressure_level, Count, default: { value: 0 }

      given("nothing is admitted while the owner's switch is off") { switch.value == "on" }
      given("a session is admitted only from a current view") { role.value == "repair" || age.value <= stale_after.value }
      given("only the repair seat is admitted while the signal is dark") { band.value != "dark" || role.value == "repair" }
      given("a helper does not start a helper") { asked_by.value != "helper" }
      given("a session is not started for a purpose already met") { met.value != "yes" }
      given("a session's expected draw fits the headroom") { draw.value <= headroom.value }
      # Hysteresis: a lower-tier session leaves the gap above the floor, so noise does not shed it.
      # At the OS's normal level the floor does not trip, so the gap does not bind: the draw fitting
      # the headroom is the memory bound left, and the ramp paces it.
      given("a lower-tier session leaves the gap above the floor after its draw") do
        tier.value == "urgent" || memory_pressure_level.value == 1 || headroom.value - draw.value >= floor.value + gap.value
      end
      given("only an urgent coder is admitted while pressure is short") do
        band.value != "short" || (role.value == "coder" && tier.value == "urgent")
      end
      # Starts are held before finishing is slowed: tight pressure holds a new lower-tier coder or
      # helper, while a gate, a seat and the work already in flight keep the machine.
      given("no lower-tier coder or helper starts while pressure is tight") do
        band.value != "tight" || tier.value == "urgent" || (role.value != "coder" && role.value != "helper")
      end
      given("at most the ramp step starts in one ramp window") { started.value < ramp.value }
      given("helpers stay within their share of the coders") do
        role.value != "helper" || helpers.value * 100 < coders.value * share.value
      end
      given("the waiting job with the most value per unit of compute goes first") { outranked.value.zero? }
      given("one orchestrator seat at most") { role.value != "orchestrator" || seats.value.zero? }
      given("a session starts only the MCP servers its role uses") { unused_servers.value.zero? }
      given("no coder starts in an area whose finished work is refused at landing") do
        role.value != "coder" || tier.value == "urgent" || curtailed.value.zero?
      end
      given("a session's fuse is rated above its expected draw") { fuse.value > draw.value }
      given("a session's fuse has a time rating") { fuse_minutes.value.positive? }

      emits SessionAdmitted
    end

    command "Close" do
      role "System"
      goal "Close the admission when its session has ended, which returns its draw to the headroom"

      reference_to Admission

      emits AdmissionClosed
    end
  end

  # Law 3, droop control. Each session answers the band by its own rule, with no orchestrator in
  # the loop: the policies below are the whole table, and exactly one answers each ask.
  aggregate "Response" do
    description "One session's answer to the band: keep running, defer its heavy steps, finish and leave, or wait its turn."
    created_by "Response.ask!"

    identified_by :response

    attribute :response, Key
    attribute :session,  SessionKey
    attribute :role,     Role
    attribute :tier,     Tier
    attribute :band,     Band

    value_object "Key" do
      attribute :value, String, matches: :present
    end

    # A Roundhouse session, named by value: the two bluebooks share no store.
    value_object "SessionKey" do
      attribute :value, String, matches: :present
    end

    # `person` is a job a person runs by hand: the person's own use, never the pipeline's load.
    value_object "Role" do
      attribute :value, String
      invariant("a role is coder, helper, gate, orchestrator, repair or person") do
        value == "coder" || value == "helper" || value == "gate" || value == "orchestrator" || value == "repair" ||
          value == "person"
      end
    end

    value_object "Tier" do
      attribute :value, String
      invariant("a tier is urgent, normal or low") { value == "urgent" || value == "normal" || value == "low" }
    end

    value_object "Band" do
      attribute :value, String
      invariant("a band is normal, tight, short or dark") do
        value == "normal" || value == "tight" || value == "short" || value == "dark"
      end
    end

    lifecycle :status, default: "asked" do
      mark :rests, "asked"
      mark :terminal, "running", "deferring", "leaving", "waiting"
      transition "Run"   => "running",   from: "asked"
      transition "Defer" => "deferring", from: "asked"
      transition "Leave" => "leaving",   from: "asked"
      transition "Wait"  => "waiting",   from: "asked"
    end

    command "Ask" do
      role "System"
      goal "Ask how one session answers the band the signal is in"

      attribute :response, Key, sets: true
      attribute :session,  SessionKey, sets: true
      attribute :role,     Role, sets: true
      attribute :tier,     Tier, sets: true
      attribute :band,     Band, sets: true

      emits ResponseAsked
    end

    command "Run" do
      role "System"
      goal "Keep the session running"

      reference_to Response
      attribute :session, SessionKey

      emits ResponseRan
    end

    command "Defer" do
      role "System"
      goal "Have the coder defer its heavy steps (gates, builds, full spec runs) until pressure is short no more"

      reference_to Response
      attribute :session, SessionKey

      emits ResponseDeferred
    end

    command "Leave" do
      role "System"
      goal "Have the helper finish what it holds and leave"

      reference_to Response
      attribute :session, SessionKey

      emits ResponseLeft
    end

    command "Wait" do
      role "System"
      goal "Hold the gate in its turn until pressure is short no more"

      reference_to Response
      attribute :session, SessionKey

      emits ResponseWaited
    end
  end

  # Protection coordination: a session's fuse (rank 1), the helpers' share (2), shedding (3) and the
  # whole-machine fuses (4): the boot budget and the daily model usage budget. A breaker trips past its rating, once no smaller one can act.
  aggregate "Breaker" do
    description "One breaker in the protection order: its level, its rating, whether it has tripped, and the session it shed."
    created_by "Breaker.install!"

    identified_by :breaker

    attribute :breaker, Key
    attribute :level,   Level
    attribute :rating,  Amount
    attribute :shed,    SessionKey, optional: true

    value_object "Key" do
      attribute :value, String, matches: :present
    end

    value_object "SessionKey" do
      attribute :value, String, matches: :present
    end

    value_object "Level" do
      attribute :value, String
      # `model` is the daily model usage fuse (ADR 0220's spend bound), beside the machine fuse.
      invariant("a breaker is a fuse, the helper share, shedding, the machine fuse or the model fuse") do
        value == "fuse" || value == "helpers" || value == "shedding" || value == "machine" || value == "model"
      end
    end

    # The protection order, smallest first, the boot-hours machine fuse last; `holds` says whether
    # a tripped breaker holds every new coder's start or acts on its own load. Delegate's fill reads
    # these rows (phase 3, protection).
    value_object "Order" do
      attribute :level, String
      attribute :rank,  Integer
      attribute :holds, String

      member level: "fuse",     rank: 1, holds: "no"
      member level: "helpers",  rank: 2, holds: "no"
      member level: "shedding", rank: 3, holds: "no"
      member level: "model",    rank: 4, holds: "yes"
      member level: "machine",  rank: 5, holds: "yes"
    end

    # What a breaker is rated in, by its level: megabytes (a session's fuse), live helpers (the
    # helper share: the live coders times the share), live coders (shedding), model usage, or boot
    # minutes (the machine fuse: the Tickets world's `cpu_budget` hours times 60).
    value_object "Amount" do
      attribute :value, Integer, default: 0
      invariant("a rating is not negative") { !value.negative? }
    end

    value_object "Count" do
      attribute :value, Integer, default: 0
      invariant("a count is not negative") { !value.negative? }
    end

    value_object "Word" do
      attribute :value, String, matches: :present
    end

    lifecycle :state, default: "closed" do
      mark :rests, "closed", "open"
      transition "Trip"  => "open",   from: "closed"
      transition "Shed"  => "open",   from: "open"
      transition "Reset" => "closed", from: "open"
    end

    command "Install" do
      role "System"
      goal "Install one breaker at its level with its rating"

      attribute :breaker, Key, sets: true
      attribute :level,   Level, sets: true
      attribute :rating,  Amount, sets: true

      emits BreakerInstalled
    end

    command "Trip" do
      role "System"
      goal "Trip the breaker: its load passed its rating and no smaller breaker can still act"

      reference_to Breaker
      attribute :load,          Amount
      attribute :smaller_ready, Count

      given("a breaker trips only past its rating") { load.value > rating.value }
      given("a larger breaker waits while a smaller one can still act") { smaller_ready.value.zero? }

      emits BreakerTripped
    end

    # The shedding breaker rests one coder at a time, lowest merit first, never an urgent one.
    command "Shed" do
      role "System"
      goal "Name the coder the tripped shedding breaker rests"

      reference_to Breaker
      attribute :shed,         SessionKey, sets: true
      attribute :tier,         Word
      attribute :lower_ranked, Count

      given("only the shedding breaker sheds") { level.value == "shedding" }
      given("an urgent coder is never shed") { tier.value != "urgent" }
      given("the lowest value per unit of compute is shed first") { lower_ranked.value.zero? }

      emits BreakerShed
    end

    command "Reset" do
      role "System"
      goal "Close the breaker again once the load is back under its rating by the gap"

      reference_to Breaker
      attribute :load, Amount
      attribute :gap,  Amount

      given("a breaker resets only once the load is under its rating by the gap") do
        load.value + gap.value <= rating.value
      end

      emits BreakerReset
    end
  end

  # Anti-islanding: a part (a beat, the train copy, an overlay writer) asks before it acts on
  # shared state, and is refused when its view is behind main, missing local files, or stale.
  aggregate "Clearance" do
    description "One clearance for a part to act on shared state from the view it holds."
    created_by "Clearance.grant!"

    identified_by :clearance

    attribute :clearance, Key
    attribute :part,      Word
    attribute :head,      Word

    value_object "Key" do
      attribute :value, String, matches: :present
    end

    value_object "Word" do
      attribute :value, String, matches: :present
    end

    value_object "Seconds" do
      attribute :value, Integer, default: 0
      invariant("a duration is not negative") { !value.negative? }
    end

    value_object "Count" do
      attribute :value, Integer, default: 0
      invariant("a count is not negative") { !value.negative? }
    end

    command "Grant" do
      role "System"
      goal "Clear a part to act on shared state, only from a current view"

      attribute :clearance,   Key, sets: true
      attribute :part,        Word, sets: true
      attribute :head,        Word, sets: true
      attribute :main,        Word
      attribute :missing,     Count
      attribute :age,         Seconds
      attribute :stale_after, Seconds

      given("a part acts on shared state only from the head of main") { head.value == main.value }
      given("a part acts only with every local file the main checkout has") { missing.value.zero? }
      given("a part acts only from a current view") { age.value <= stale_after.value }

      emits ClearanceGranted
    end
  end

  # Reaping (ADR 0222, phase 3): it decides, where `Ruling` only records beside Delegate. A pass is
  # cleared first, so a stale copy reaps nothing. `keep` is the subject's own window: the ended
  # window, or a stale session's fuse time rating.
  aggregate "Reaping" do
    description "Signalbox's ruling that one ended session or one copy of the checkout is reaped, from Roundhouse's meter."
    created_by "Reaping.rule!"

    identified_by :reaping

    attribute :reaping, Key
    attribute :subject, Word
    attribute :kind,    Kind

    value_object "Key" do
      attribute :value, String, matches: :present
    end

    value_object "Word" do
      attribute :value, String, matches: :present
    end

    # A finished session is listed done or stopped; a stale one has lost its process while listed
    # otherwise; a copy is a worktree of the checkout.
    value_object "Kind" do
      attribute :value, String
      invariant("a reap is of a finished session, a stale session or a copy") do
        value == "finished" || value == "stale" || value == "copy"
      end
    end

    value_object "Answer" do
      attribute :value, String
      invariant("an answer is yes or no") { value == "yes" || value == "no" }
    end

    value_object "Minutes" do
      attribute :value, Integer, default: 0
      invariant("a duration is not negative") { !value.negative? }
    end

    value_object "Count" do
      attribute :value, Integer, default: 0
      invariant("a count is not negative") { !value.negative? }
    end

    command "Rule" do
      role "System"
      goal "Rule that one ended session or one landed copy is reaped, only with nothing unsaved and nothing holding it"

      attribute :reaping, Key, sets: true
      attribute :subject, Word, sets: true
      attribute :kind,    Kind, sets: true
      attribute :state,   Word
      attribute :role,    Word
      attribute :live,    Answer
      attribute :idle,    Minutes
      attribute :keep,    Minutes
      attribute :unsaved, Count
      attribute :pinned,  Answer
      attribute :open,    Answer
      attribute :landed,  Answer

      given("a session with unsaved work is never reaped") { unsaved.value.zero? }
      given("a pinned session is never reaped") { pinned.value == "no" }
      given("the standing seat and a person's session are never reaped") do
        role.value != "orchestrator" && role.value != "person"
      end
      given("what a started run or a live session holds is never reaped") { open.value == "no" }
      given("a finished session is listed done or stopped") do
        kind.value != "finished" || state.value == "done" || state.value == "stopped"
      end
      given("a stale session has no live process") { kind.value != "stale" || live.value == "no" }
      given("a copy is reaped only once its branch is on main") { kind.value != "copy" || landed.value == "yes" }
      given("a session is reaped only once it has been idle its keep window") { idle.value >= keep.value }

      emits ReapingRuled
    end
  end

  # The pressure beat (ADR 0222, phase 2, the shadow): the record owns what its one look through
  # the `Looking` port found. It is cleared only from the main checkout's current view.
  aggregate "Beat" do
    description "One pressure beat: what one look found of the copy's view, the machine and Delegate's last fill and shed, held for Signalbox's clearance, pressure and rulings."
    created_by "Beat.begin!"

    identified_by :beat

    attribute :beat,          BeatKey
    attribute :head,          Word, optional: true
    attribute :main,          Word, optional: true
    attribute :missing,       Count, optional: true
    attribute :capacity,      Megabytes, optional: true
    attribute :used,          Megabytes, optional: true
    attribute :reserve,       Megabytes, optional: true
    attribute :headroom,      Signed, optional: true
    attribute :load,          Count, optional: true
    attribute :cores,         Count, optional: true
    attribute :age,           Seconds, optional: true
    attribute :stale_after,   Seconds, optional: true
    attribute :target,        Megabytes, optional: true
    attribute :floor,         Megabytes, optional: true
    attribute :gap,           Megabytes, optional: true
    attribute :load_tight,    Count, optional: true
    attribute :load_short,    Count, optional: true
    attribute :load_gap,      Count, optional: true
    attribute :memory_pressure_level, Count, optional: true
    attribute :metered_draw,  Megabytes, optional: true
    attribute :coder_draw,    Megabytes, optional: true
    attribute :gate_draw,     Megabytes, optional: true
    attribute :coders_fit,    Signed, optional: true
    attribute :gates_fit,     Signed, optional: true
    attribute :fill_ruling,   Word, optional: true
    attribute :fill_subject,  Word, optional: true
    attribute :fill_delegate, Word, optional: true
    attribute :shed_ruling,   Word, optional: true
    attribute :shed_subject,  Word, optional: true
    attribute :shed_delegate, Word, optional: true
    attribute :refusal,       Note, optional: true

    value_object "BeatKey" do
      attribute :value, String, matches: :present
    end

    value_object "Word" do
      attribute :value, String, matches: :present
    end

    value_object "Note" do
      attribute :value, String, matches: :present
    end

    value_object "Megabytes" do
      attribute :value, Integer, default: 0
      invariant("an amount of memory is not negative") { !value.negative? }
    end

    # Headroom goes below zero when what is in use passes the capacity less the reserve.
    value_object "Signed" do
      attribute :value, Integer, default: 0
    end

    value_object "Count" do
      attribute :value, Integer, default: 0
      invariant("a count is not negative") { !value.negative? }
    end

    value_object "Seconds" do
      attribute :value, Integer, default: 0
      invariant("a duration is not negative") { !value.negative? }
    end

    # A clearance for the pressure beat is keyed by the beat it clears.
    query "ClearedBy" do
      description "The beat a granted clearance names, whose looked facts are published once it is cleared."
      attribute :clearance, BeatKey
      where(beat: :clearance)
    end

    lifecycle :status, default: "begun" do
      mark :rests, "looked"
      mark :terminal, "published", "unlooked"
      mark :failure, "unlooked"
      transition "Record"  => "looked",    from: "begun"
      transition "Fault"   => "unlooked",  from: "begun"
      transition "Publish" => "published", from: "looked"
    end

    command "Begin" do
      role "System"
      goal "Begin one pressure beat, which looks at the outside once"

      attribute :beat, BeatKey, sets: true

      emits BeatBegun
    end

    # The headroom is the capacity less what is in use less the person's reserve: what the
    # pipeline may still draw. It is reckoned here, never by the port that looked.
    command "Record" do
      role "System"
      goal "Record what the beat's look found"

      reference_to Beat
      attribute :head,          Word, sets: true
      attribute :main,          Word, sets: true
      attribute :missing,       Count, sets: true
      attribute :capacity,      Megabytes, sets: true
      attribute :used,          Megabytes, sets: true
      attribute :reserve,       Megabytes, sets: true
      attribute :load,          Count, sets: true
      attribute :cores,         Count, sets: true
      attribute :age,           Seconds, sets: true
      attribute :stale_after,   Seconds, sets: true
      attribute :target,        Megabytes, sets: true
      attribute :floor,         Megabytes, sets: true
      attribute :gap,           Megabytes, sets: true
      attribute :load_tight,    Count, sets: true
      attribute :load_short,    Count, sets: true
      attribute :load_gap,      Count, sets: true
      attribute :memory_pressure_level, Count, default: { value: 0 }, sets: true
      attribute :metered_draw,  Megabytes, default: { value: 0 }, sets: true
      attribute :coder_draw,    Megabytes, sets: true
      attribute :gate_draw,     Megabytes, sets: true
      attribute :fill_ruling,   Word, sets: true
      attribute :fill_subject,  Word, sets: true
      attribute :fill_delegate, Word, sets: true
      attribute :shed_ruling,   Word, sets: true
      attribute :shed_subject,  Word, sets: true
      attribute :shed_delegate, Word, sets: true
      given("a beat names a coder's and a gate's expected draw") { coder_draw.value.positive? && gate_draw.value.positive? }

      sets :headroom,   to: capacity - used - reserve
      sets :coders_fit, to: (capacity.value - used.value - reserve.value) / coder_draw.value
      sets :gates_fit,  to: (capacity.value - used.value - reserve.value) / gate_draw.value

      emits BeatRecorded
    end

    command "Fault" do
      role "System"
      goal "Record why the beat could not look"

      reference_to Beat
      attribute :refusal, Note, sets: true

      emits BeatFaulted
    end

    # A cleared beat publishes what it looked, so every part that reads the beat reads one fact.
    command "Publish" do
      role "System"
      goal "Publish the facts of a beat Signalbox cleared"

      reference_to Beat
      attribute :head,          Word
      attribute :main,          Word
      attribute :missing,       Count
      attribute :capacity,      Megabytes
      attribute :used,          Megabytes
      attribute :reserve,       Megabytes
      attribute :headroom,      Signed
      attribute :load,          Count
      attribute :cores,         Count
      attribute :age,           Seconds
      attribute :stale_after,   Seconds
      attribute :target,        Megabytes
      attribute :floor,         Megabytes
      attribute :gap,           Megabytes
      attribute :load_tight,    Count
      attribute :load_short,    Count
      attribute :load_gap,      Count
      attribute :memory_pressure_level, Count
      attribute :coder_draw,    Megabytes
      attribute :gate_draw,     Megabytes
      attribute :coders_fit,    Signed
      attribute :gates_fit,     Signed
      attribute :fill_ruling,   Word
      attribute :fill_subject,  Word
      attribute :fill_delegate, Word
      attribute :shed_ruling,   Word
      attribute :shed_subject,  Word
      attribute :shed_delegate, Word

      emits BeatPublished
    end
  end

  # Shadow (ADR 0222, phase 2). Each beat's ruling has its own key (`<beat>:fill`, `<beat>:shed`),
  # so a ruling is never revised in place: the newest one stands. Nothing acts on a ruling.
  aggregate "Ruling" do
    description "Signalbox's ruling on one subject of a Delegate fill, shed or reap, beside Delegate's own decision."
    created_by "Ruling.record!"

    identified_by :ruling

    attribute :ruling,   Key
    attribute :function, Function
    attribute :subject,  Word
    attribute :delegate, Note
    attribute :decision, Word
    attribute :law,      Note
    attribute :load,     Hundredths
    attribute :headroom, Signed
    attribute :agrees,   Answer
    attribute :also,     Note, optional: true

    value_object "Key" do
      attribute :value, String, matches: :present
    end

    value_object "Word" do
      attribute :value, String, matches: :present
    end

    value_object "Note" do
      attribute :value, String, matches: :present
    end

    value_object "Function" do
      attribute :value, String
      invariant("a ruling is on a fill, a shed or a reap") { value == "fill" || value == "shed" || value == "reap" }
    end

    value_object "Hundredths" do
      attribute :value, Integer, default: 0
      invariant("a load is not negative") { !value.negative? }
    end

    value_object "Signed" do
      attribute :value, Integer, default: 0
    end

    value_object "Answer" do
      attribute :value, String
      invariant("a ruling agrees with Delegate or it does not") { value == "yes" || value == "no" }
    end

    query "Shadowed" do
      description "Every ruling, Delegate's decision beside Signalbox's, by function and subject."
      order_by :ruling
    end

    query "Disagreements" do
      description "The rulings where Signalbox would have decided otherwise than Delegate did."
      where(agrees: "no")
      order_by :ruling
    end

    # `also` names the next law that would refuse, when the deciding law is one a start's settings
    # fix rather than the machine's state (the MCP servers a session starts).
    command "Record" do
      role "System"
      goal "Record what Signalbox would have decided on one subject of a Delegate fill, shed or reap"

      attribute :ruling,   Key, sets: true
      attribute :function, Function, sets: true
      attribute :subject,  Word, sets: true
      attribute :delegate, Note, sets: true
      attribute :decision, Word, sets: true
      attribute :law,      Note, sets: true
      attribute :load,     Hundredths, sets: true
      attribute :headroom, Signed, sets: true
      attribute :agrees,   Answer, sets: true
      attribute :also,     Note, optional: true, sets: true

      emits RulingRecorded
    end
  end

  # What one pressure beat heard of Delegate: the subject of its last fill and whether it started or
  # left it waiting, and the subject of its last shed and whether it shed. The beat carries the
  # reading the rulings are judged on; the policies below rule, and a ruling is recorded per function.
  aggregate "Shadow" do
    description "What one pressure beat heard of Delegate's last fill and shed, with the reading Signalbox rules them on."
    created_by "Shadow.hear!"

    identified_by :shadow

    attribute :shadow,        Key
    attribute :headroom,      Signed
    attribute :floor,         Megabytes
    attribute :load,          Hundredths
    attribute :cores,         Count
    attribute :load_short,    Percent
    attribute :target,        Megabytes
    attribute :load_tight,    Percent
    attribute :memory_pressure_level, Count, optional: true
    attribute :draw,          Megabytes
    attribute :fill_ruling,   RulingKey
    attribute :fill_subject,  Word
    attribute :fill_delegate, FillWord
    attribute :shed_ruling,   RulingKey
    attribute :shed_subject,  Word
    attribute :shed_delegate, ShedWord

    value_object "Key" do
      attribute :value, String, matches: :present
    end

    # The key the beat's ruling on one function takes: `<beat>:fill` or `<beat>:shed`.
    value_object "RulingKey" do
      attribute :value, String, matches: :present
    end

    value_object "Word" do
      attribute :value, String, matches: :present
    end

    # Delegate's last fill: it started its subject, left it waiting, or had nothing planned.
    value_object "FillWord" do
      attribute :value, String
      invariant("a fill started, waited or had nothing") { value == "start" || value == "wait" || value == "none" }
    end

    # Delegate's last shed: it asked its subject to yield, or it spared every one.
    value_object "ShedWord" do
      attribute :value, String
      invariant("a shed asked one to yield or spared every one") { value == "shed" || value == "none" }
    end

    value_object "Signed" do
      attribute :value, Integer, default: 0
    end

    value_object "Megabytes" do
      attribute :value, Integer, default: 0
      invariant("an amount of memory is not negative") { !value.negative? }
    end

    value_object "Hundredths" do
      attribute :value, Integer, default: 0
      invariant("a load is not negative") { !value.negative? }
    end

    value_object "Count" do
      attribute :value, Integer, default: 0
      invariant("a count is not negative") { !value.negative? }
    end

    value_object "Percent" do
      attribute :value, Integer, default: 0
      invariant("a mark is not negative") { !value.negative? }
    end

    command "Hear" do
      role "System"
      goal "Hear Delegate's last fill and shed on one pressure beat, with the reading to rule them on"

      attribute :shadow,        Key, sets: true
      attribute :headroom,      Signed, sets: true
      attribute :floor,         Megabytes, sets: true
      attribute :load,          Hundredths, sets: true
      attribute :cores,         Count, sets: true
      attribute :load_short,    Percent, sets: true
      attribute :target,        Megabytes, sets: true
      attribute :load_tight,    Percent, sets: true
      attribute :memory_pressure_level, Count, default: { value: 0 }, sets: true
      attribute :draw,          Megabytes, sets: true
      attribute :fill_ruling,   RulingKey, sets: true
      attribute :fill_subject,  Word, sets: true
      attribute :fill_delegate, FillWord, sets: true
      attribute :shed_ruling,   RulingKey, sets: true
      attribute :shed_subject,  Word, sets: true
      attribute :shed_delegate, ShedWord, sets: true

      emits DelegateHeard
    end
  end

  # The pressure beat's chain. Clearance's givens stop a beat from a worktree or a stale copy; a
  # cleared beat publishes its facts, which open and read its own Pressure and let Signalbox hear Delegate.
  policy "LookWhenTheBeatBegins" do
    on  "Beat.BeatBegun"
    ask :look, with: { beat: :beat }
  end

  # A coder's expected draw is the median Roundhouse metered of the live coders; the world's draw
  # stands in only while no coder is metered. Exactly one of the two records each look.
  policy "RecordTheLookWithTheMeteredDraw" do
    on      "Beat.BeatLooked"
    where   { metered_draw.value.positive? }
    trigger Beat::Record, with: {
      beat: :beat, head: :head, main: :main, missing: :missing, capacity: :capacity, used: :used,
      reserve: :reserve, load: :load, cores: :cores, age: :age, stale_after: :stale_after, target: :target,
      floor: :floor, gap: :gap, load_tight: :load_tight, load_short: :load_short, load_gap: :load_gap,
      memory_pressure_level: :memory_pressure_level, metered_draw: :metered_draw,
      coder_draw: :metered_draw, gate_draw: :gate_draw, fill_ruling: :fill_ruling, fill_subject: :fill_subject,
      fill_delegate: :fill_delegate, shed_ruling: :shed_ruling, shed_subject: :shed_subject,
      shed_delegate: :shed_delegate
    }
  end

  policy "RecordTheLookWithTheWorldsDraw" do
    on      "Beat.BeatLooked"
    where   { metered_draw.value.zero? }
    trigger Beat::Record, with: {
      beat: :beat, head: :head, main: :main, missing: :missing, capacity: :capacity, used: :used,
      reserve: :reserve, load: :load, cores: :cores, age: :age, stale_after: :stale_after, target: :target,
      floor: :floor, gap: :gap, load_tight: :load_tight, load_short: :load_short, load_gap: :load_gap,
      memory_pressure_level: :memory_pressure_level, metered_draw: :metered_draw,
      coder_draw: :coder_draw, gate_draw: :gate_draw, fill_ruling: :fill_ruling, fill_subject: :fill_subject,
      fill_delegate: :fill_delegate, shed_ruling: :shed_ruling, shed_subject: :shed_subject,
      shed_delegate: :shed_delegate
    }
  end

  policy "FaultTheLook" do
    on      "Beat.BeatUnlooked"
    trigger Beat::Fault, with: { beat: :beat, refusal: :refusal }
  end

  policy "AskClearanceForTheBeat" do
    on      "Beat.BeatLooked"
    trigger Clearance::Grant, with: {
      clearance: :beat, part: { value: "pressure-beat" }, head: :head, main: :main, missing: :missing,
      age: :age, stale_after: :stale_after
    }
  end

  # A root: a cleared beat's publication begins its own chain, as Delegate's fill after a reading
  # does, so the band and the rulings it sets off are not cut off by the look before it.
  policy "PublishTheClearedBeat" do
    on       "Clearance.ClearanceGranted"
    root
    where    { part.value == "pressure-beat" }
    for_each "Beat.ClearedBy"
    trigger  Beat::Publish, with: {
      beat: :beat, head: :head, main: :main, missing: :missing, capacity: :capacity, used: :used,
      reserve: :reserve, headroom: :headroom, load: :load, cores: :cores, age: :age,
      stale_after: :stale_after, target: :target, floor: :floor, gap: :gap, load_tight: :load_tight,
      load_short: :load_short, load_gap: :load_gap, memory_pressure_level: :memory_pressure_level,
      coder_draw: :coder_draw, gate_draw: :gate_draw, coders_fit: :coders_fit, gates_fit: :gates_fit,
      fill_ruling: :fill_ruling, fill_subject: :fill_subject, fill_delegate: :fill_delegate, shed_ruling: :shed_ruling,
      shed_subject: :shed_subject, shed_delegate: :shed_delegate
    }
  end

  policy "OpenTheClearedBeatsPressure" do
    on      "Beat.BeatPublished"
    trigger Pressure::Open, with: { pressure: :beat, capacity: :capacity }
  end

  policy "PublishTheClearedBeatsPressure" do
    on      "Beat.BeatPublished"
    trigger Pressure::Read, with: {
      pressure: :beat, headroom: :headroom, target: :target, floor: :floor, gap: :gap, load: :load,
      cores: :cores, load_tight: :load_tight, load_short: :load_short, load_gap: :load_gap,
      memory_pressure_level: :memory_pressure_level, coders_fit: :coders_fit, gates_fit: :gates_fit, age: :age,
      stale_after: :stale_after
    }
  end

  policy "HearDelegateOnTheClearedBeat" do
    on      "Beat.BeatPublished"
    trigger Shadow::Hear, with: {
      shadow: :beat, headroom: :headroom, floor: :floor, load: :load, cores: :cores,
      load_short: :load_short, target: :target, load_tight: :load_tight,
      memory_pressure_level: :memory_pressure_level, draw: :coder_draw,
      fill_ruling: :fill_ruling, fill_subject: :fill_subject,
      fill_delegate: :fill_delegate, shed_ruling: :shed_ruling, shed_subject: :shed_subject,
      shed_delegate: :shed_delegate
    }
  end

  # The band is the worse of the memory and load bands; `cores * mark` is in hundredths. The OS's
  # memory level 4 is short and 2 tight whatever the headroom, and 1 is never short or tight on
  # memory; an unread level (0) leaves the headroom marks to judge, as before.
  policy "TripWhenHeadroomFallsUnderTheFloor" do
    on      "Pressure.PressureRead"
    where   do
      (headroom.value < floor.value && memory_pressure_level.value != 1) || memory_pressure_level.value >= 4 ||
        load.value > cores.value * load_short.value
    end
    trigger Pressure::Trip, with: { pressure: :pressure }
  end

  policy "TightenWhenHeadroomFallsUnderTheTarget" do
    on      "Pressure.PressureRead"
    where   do
      !((headroom.value < floor.value && memory_pressure_level.value != 1) || memory_pressure_level.value >= 4) &&
        load.value <= cores.value * load_short.value &&
        ((headroom.value < target.value && memory_pressure_level.value != 1) || memory_pressure_level.value == 2 ||
          load.value > cores.value * load_tight.value)
    end
    trigger Pressure::Tighten, with: { pressure: :pressure }
  end

  # Between a mark and the mark past it by the gap no policy answers, so the band holds: hysteresis.
  # Memory and load must both be past their marks by their gaps for the band to ease; memory is past
  # its mark while the OS reads its pressure normal.
  policy "EaseOnlyPastTheTargetByTheGap" do
    on      "Pressure.PressureRead"
    where   do
      (memory_pressure_level.value == 1 ||
        (memory_pressure_level.value != 2 && memory_pressure_level.value < 4 && headroom.value >= target.value + gap.value)) &&
        load.value <= cores.value * (load_tight.value - load_gap.value)
    end
    trigger Pressure::Ease, with: { pressure: :pressure }
  end

  # Law 2, published (phase 3b): once the band policies above have settled the reading, it is
  # posted as the machine's one signal. Declared after them, so it runs last of the reading's policies.
  policy "PostTheSettledPressure" do
    on  "Pressure.PressureRead"
    ask :post, with: { pressure: :pressure }
  end

  policy "EverySessionRunsInNormalPressure" do
    on      "Response.ResponseAsked"
    where   { band.value == "normal" }
    trigger Response::Run, with: { response: :response, session: :session }
  end

  # An urgent gate (a red fix's landing, the push train) runs as an urgent coder does, and a
  # person's own job is the person's use, which the reserve already keeps out of the headroom.
  policy "UrgentCodersAndSeatsKeepRunning" do
    on      "Response.ResponseAsked"
    where   do
      band.value != "normal" &&
        (((role.value == "coder" || role.value == "gate") && tier.value == "urgent") ||
          role.value == "orchestrator" || role.value == "repair" || role.value == "person")
    end
    trigger Response::Run, with: { response: :response, session: :session }
  end

  # Tight pressure holds starts (`Admission`), never the heavy jobs of work in flight: a coder at
  # its last spec run and a landing's gate run, and the heavy-job places are the only line they
  # wait in. The holds below are for the short band and a dark signal.
  policy "WorkInFlightKeepsRunningInTightPressure" do
    on      "Response.ResponseAsked"
    where   { band.value == "tight" && (role.value == "coder" || role.value == "gate") && tier.value != "urgent" }
    trigger Response::Run, with: { response: :response, session: :session }
  end

  policy "LowerTierCodersDeferHeavySteps" do
    on      "Response.ResponseAsked"
    where   { band.value != "normal" && band.value != "tight" && role.value == "coder" && tier.value != "urgent" }
    trigger Response::Defer, with: { response: :response, session: :session }
  end

  policy "HelpersFinishAndLeave" do
    on      "Response.ResponseAsked"
    where   { band.value != "normal" && role.value == "helper" }
    trigger Response::Leave, with: { response: :response, session: :session }
  end

  policy "GatesWaitTheirTurn" do
    on      "Response.ResponseAsked"
    where   { band.value != "normal" && band.value != "tight" && role.value == "gate" && tier.value != "urgent" }
    trigger Response::Wait, with: { response: :response, session: :session }
  end

  # The shadow's rulings, by the band's own marks: start a normal-tier coder whose draw fits while
  # pressure is neither tight nor short (law 4, as `Admission` does), shed only while it is short.
  # Exactly one policy answers each function of a beat; a fill with nothing planned is not ruled on.
  policy "RuleWithDelegatesStart" do
    on      "Shadow.DelegateHeard"
    where   do
      fill_delegate.value == "start" &&
        (draw.value <= headroom.value &&
          !((headroom.value < floor.value && memory_pressure_level.value != 1) || memory_pressure_level.value >= 4) &&
          !((headroom.value < target.value && memory_pressure_level.value != 1) || memory_pressure_level.value == 2) &&
          load.value <= cores.value * load_tight.value)
    end
    trigger Ruling::Record, with: {
      ruling: :fill_ruling, function: { value: "fill" }, subject: :fill_subject, delegate: :fill_delegate,
      decision: { value: "start" }, load: :load, headroom: :headroom,
      law: { value: "a coder's expected draw fits the headroom and pressure is neither tight nor short" },
      agrees: { value: "yes" }
    }
  end

  policy "RuleAgainstDelegatesStart" do
    on      "Shadow.DelegateHeard"
    where   do
      fill_delegate.value == "start" &&
        !(draw.value <= headroom.value &&
          !((headroom.value < floor.value && memory_pressure_level.value != 1) || memory_pressure_level.value >= 4) &&
          !((headroom.value < target.value && memory_pressure_level.value != 1) || memory_pressure_level.value == 2) &&
          load.value <= cores.value * load_tight.value)
    end
    trigger Ruling::Record, with: {
      ruling: :fill_ruling, function: { value: "fill" }, subject: :fill_subject, delegate: :fill_delegate,
      decision: { value: "wait" }, load: :load, headroom: :headroom,
      law: { value: "a coder waits: its expected draw does not fit the headroom, or pressure is tight or short" },
      agrees: { value: "no" }
    }
  end

  policy "RuleWithDelegatesWait" do
    on      "Shadow.DelegateHeard"
    where   do
      fill_delegate.value == "wait" &&
        !(draw.value <= headroom.value &&
          !((headroom.value < floor.value && memory_pressure_level.value != 1) || memory_pressure_level.value >= 4) &&
          !((headroom.value < target.value && memory_pressure_level.value != 1) || memory_pressure_level.value == 2) &&
          load.value <= cores.value * load_tight.value)
    end
    trigger Ruling::Record, with: {
      ruling: :fill_ruling, function: { value: "fill" }, subject: :fill_subject, delegate: :fill_delegate,
      decision: { value: "wait" }, load: :load, headroom: :headroom,
      law: { value: "a coder waits: its expected draw does not fit the headroom, or pressure is tight or short" },
      agrees: { value: "yes" }
    }
  end

  policy "RuleAgainstDelegatesWait" do
    on      "Shadow.DelegateHeard"
    where   do
      fill_delegate.value == "wait" &&
        (draw.value <= headroom.value &&
          !((headroom.value < floor.value && memory_pressure_level.value != 1) || memory_pressure_level.value >= 4) &&
          !((headroom.value < target.value && memory_pressure_level.value != 1) || memory_pressure_level.value == 2) &&
          load.value <= cores.value * load_tight.value)
    end
    trigger Ruling::Record, with: {
      ruling: :fill_ruling, function: { value: "fill" }, subject: :fill_subject, delegate: :fill_delegate,
      decision: { value: "start" }, load: :load, headroom: :headroom,
      law: { value: "a coder's expected draw fits the headroom and pressure is neither tight nor short" },
      agrees: { value: "no" }
    }
  end

  policy "RuleWithDelegatesShed" do
    on      "Shadow.DelegateHeard"
    where   do
      shed_delegate.value == "shed" &&
        (((headroom.value < floor.value && memory_pressure_level.value != 1) || memory_pressure_level.value >= 4) ||
          load.value > cores.value * load_short.value)
    end
    trigger Ruling::Record, with: {
      ruling: :shed_ruling, function: { value: "shed" }, subject: :shed_subject, delegate: :shed_delegate,
      decision: { value: "shed" }, load: :load, headroom: :headroom,
      law: { value: "shedding rests the lowest-merit coder while pressure is short" },
      agrees: { value: "yes" }
    }
  end

  policy "RuleAgainstDelegatesShed" do
    on      "Shadow.DelegateHeard"
    where   do
      shed_delegate.value == "shed" &&
        !(((headroom.value < floor.value && memory_pressure_level.value != 1) || memory_pressure_level.value >= 4) ||
          load.value > cores.value * load_short.value)
    end
    trigger Ruling::Record, with: {
      ruling: :shed_ruling, function: { value: "shed" }, subject: :shed_subject, delegate: :shed_delegate,
      decision: { value: "none" }, load: :load, headroom: :headroom,
      law: { value: "nothing is shed while pressure is not short" },
      agrees: { value: "no" }
    }
  end

  policy "RuleWithDelegatesSparing" do
    on      "Shadow.DelegateHeard"
    where   do
      shed_delegate.value == "none" &&
        !(((headroom.value < floor.value && memory_pressure_level.value != 1) || memory_pressure_level.value >= 4) ||
          load.value > cores.value * load_short.value)
    end
    trigger Ruling::Record, with: {
      ruling: :shed_ruling, function: { value: "shed" }, subject: :shed_subject, delegate: :shed_delegate,
      decision: { value: "none" }, load: :load, headroom: :headroom,
      law: { value: "nothing is shed while pressure is not short" },
      agrees: { value: "yes" }
    }
  end

  policy "RuleAgainstDelegatesSparing" do
    on      "Shadow.DelegateHeard"
    where   do
      shed_delegate.value == "none" &&
        (((headroom.value < floor.value && memory_pressure_level.value != 1) || memory_pressure_level.value >= 4) ||
          load.value > cores.value * load_short.value)
    end
    trigger Ruling::Record, with: {
      ruling: :shed_ruling, function: { value: "shed" }, subject: :shed_subject, delegate: :shed_delegate,
      decision: { value: "shed" }, load: :load, headroom: :headroom,
      law: { value: "shedding rests the lowest-merit coder while pressure is short" },
      agrees: { value: "no" }
    }
  end
end
