# The Signalbox bluebook, bound so it boots standing alone; its ports are in signalbox.ports.hecksagon.
# It persists in Memory: the shadow counts only once the main checkout that beats keeps its
# rulings with a machine-local signalbox.local.hecksagon (ADR 0136).
Hecks.hecksagon "Signalbox" do
  attaches "Governance"
  persisted_by "Memory"
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
