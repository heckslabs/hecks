# The ports Signalbox declares, for every hecksagon that attaches the bluebook. Each names the
# question it asks of the outside and never says how it is answered; an adapter binds each.
Hecks.hecksagon "Signalbox" do
  attaches "Governance"

  # One look for the pressure beat: the copy's view against main, the machine's memory and load, the
  # world's marks and draws, and Delegate's last fill and shed. It reads only and compares nothing;
  # it is refused when the machine cannot be read.
  Signalbox::Beat.port "Looking" do
    asks "Look", to: Beat do
      attribute :beat, BeatKey
      answers "BeatLooked"
      refuses "BeatUnlooked"
    end
  end

  # The one pressure signal, published (ADR 0222 law 2, phase 3b): the machine's settled Pressure is
  # posted where every process can read it. It writes only; the readers judge nothing but its age.
  Signalbox::Pressure.port "PressurePosting" do
    asks "Post", to: Pressure do
      attribute :pressure, Key
      answers "PressurePosted"
      refuses "PressureUnposted"
    end
  end
end
