Hecks.hecksagon "Tenancy" do
  Tenancy::Tenant.persisted_by("LocalStorage")

  # The one seam where Deploy's "Tenant" (a validated request) becomes Tenancy's "Tenant" (a fact).
  # `on` omits the "Deploy::" prefix: PolicyInterpreter matches event and aggregate name only.
  # `with:` is required: the event payload also carries the port's dispatch-time args, which
  # `Register` does not declare and would refuse.
  #
  # Check with `bin/model_check lib/hecks/deploy lib/hecks/tenancy` in one run; alone, the
  # reaction to a foreign event reads as a deaf policy.
  translates "RegisterProvisionedTenant" do
    on Tenant::TenantProvisioned
    trigger Tenant::Register, with: { slug: :slug, domain: :domain, realm: :realm, schema: :schema }
  end
end
