# The Pipeline bluebook, bound so it boots standing alone (a behaviors or model_check boot of this
# directory). It persists in Memory like every tooling domain and declares no port: every stage is
# advanced by an event another domain already emits.
Hecks.hecksagon "Pipeline" do
  attaches "Governance"
  persisted_by "Memory"

  # The events that move a passage, as the Tickets and Hecks domains emit them.
  %w[Tickets.WorkPlanned Tickets.WorkReopened Tickets.WorkStarted Hecks.LandedWorkFound Hecks.MainPushed
     Hecks.RedFlagRaised Hecks.RedFlagCleared Hecks.PromotionCompleted Hecks.Published]
    .each { |event| subscribe event }
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
