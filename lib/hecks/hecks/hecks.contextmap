# The Hecks domain's context map (ADR 0135): the contexts the gem carries and how they relate, written
# before the wiring and held against it by `model_check`. Each relationship runs from the upstream
# context that supplies to the downstream one that consumes. Every `attaches` is a conformist
# relationship already (ADR 0155), so only what an attach cannot say is written here.
Hecks.context_map "Hecks" do
  context "Hecks"
  context "Governance"
  context "Bluebook"
  context "Hecksagon"
  context "World"
  context "Adapter"
  context "Port"
  context "Translation"
  context "Expression"
  context "Tenancy"
  context "Deploy"
  context "Site"
  context "Tickets"
  context "Composer"
  context "QualityControl"
  context "Coder"
  context "Fixer"
  context "PipelineBoard"
  context "Pipeline"
  context "Agents"
  context "Triage"

  # Deploy's `Tenant` is a validated request; Tenancy's `Tenant` is a fact. Tenancy's hecksagon
  # translates Deploy's `TenantProvisioned` into its own `Register`, so Deploy's model never reaches it.
  relate "Deploy" => "Tenancy", as: :anti_corruption_layer

  # QualityControl's hecksagon translates the migrate bluebook's `RehearsalAudited` into its own
  # `RecordRehearsalVerdict`, so the audit's model stays out of QualityControl's Maintenance.
  relate "Hecks" => "QualityControl", as: :anti_corruption_layer
  # Hecks attaches QualityControl as well, so the pair also shares a kernel, which has no direction.
  relate "QualityControl" => "Hecks", as: :shared_kernel

  # Agents' hecksagon translates the events it hears (a session's job read, a submitted change, a
  # verified passage) into its own commands, so Hecks, Coder and Pipeline models stay out of it.
  relate "Hecks"    => "Agents", as: :anti_corruption_layer
  # Hecks attaches Agents as well, so that pair also shares a kernel, which has no direction.
  relate "Agents"   => "Hecks", as: :shared_kernel
  relate "Coder"    => "Agents", as: :anti_corruption_layer
  relate "Pipeline" => "Agents", as: :anti_corruption_layer

  # Coder's hecksagon translates the Hecks domain's `JobRead` of a finished coder run into its own
  # `Submission.Submit`, so Hecks' AgentRun model stays out of Coder's. Hecks attaches Coder as well,
  # so the pair also shares a kernel, which has no direction.
  relate "Hecks"    => "Coder", as: :anti_corruption_layer
  relate "Coder"    => "Hecks", as: :shared_kernel
end
