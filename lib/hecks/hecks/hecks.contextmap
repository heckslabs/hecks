# The Hecks domain's context map (ADR 0135): the contexts the gem carries and how they relate, written
# before the wiring and held against it by `model_check`. Each relationship runs from the upstream
# context that supplies to the downstream one that consumes. Every `attaches` is a conformist
# relationship already (ADR 0155), so only what an attach cannot say is written here.
Hecks.context_map "Hecks" do
  context "Hecks"
  context "Governance"
  context "Bluebook"
  context "Hecksagon"
  context "World"
  context "Adapter"
  context "Port"
  context "Translation"
  context "Expression"
  context "Tenancy"
  context "Deploy"
  context "Site"
  context "Tickets"
  context "Protocols"
  context "Clients"

  # Client material never enters the public repo: Clients (its own bluebook, each client's record
  # kept as a link to its private repository) is separate ways from every other context, Hecks
  # included. Any attach, subscription, translation or `across` policy either way is refused by
  # `model_check` as `separate_ways_violated`, whatever its kind. The list is every context above;
  # spec/context_map_clients_spec.rb fails when a context is added without joining it.
  separate_ways "Hecks", "Clients"
  separate_ways "Governance", "Clients"
  separate_ways "Bluebook", "Clients"
  separate_ways "Hecksagon", "Clients"
  separate_ways "World", "Clients"
  separate_ways "Adapter", "Clients"
  separate_ways "Port", "Clients"
  separate_ways "Translation", "Clients"
  separate_ways "Expression", "Clients"
  separate_ways "Tenancy", "Clients"
  separate_ways "Deploy", "Clients"
  separate_ways "Site", "Clients"
  separate_ways "Tickets", "Clients"
  separate_ways "Protocols", "Clients"

  # Deploy's `Tenant` is a validated request; Tenancy's `Tenant` is a fact. Tenancy's hecksagon
  # translates Deploy's `TenantProvisioned` into its own `Register`, so Deploy's model never reaches it.
  relate "Deploy" => "Tenancy", as: :anti_corruption_layer
end
