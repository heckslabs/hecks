# The one seam where Deploy's "Tenant" (a validated request) becomes Tenancy's "Tenant" (a fact),
# as tenancy.hecksagon declares it for the bluebooks booted on their own: `hecks deploy tenant.provision`
# registers the tenant it provisioned. It sits here, after `attaches` has loaded both bluebooks.
Hecks.hecksagon "Tenancy" do
  translates "RegisterProvisionedTenant" do
    on Tenant::TenantProvisioned
    trigger Tenant::Register, with: { slug: :slug, domain: :domain, realm: :realm, schema: :schema }
  end
end

# A rehearsal that would mint is the record a mint reads: QualityControl's Maintenance keeps the verdict and
# the watermark the copy held, so Maintenance.MintEra finds it by this run (the mint plan's watermark guard).
# QualityControl is attached here, so the seam is its translation of the migrate bluebook's audit, not an
# `across` dispatch. It listens beside Judge, on the same audit and the same condition, because the rehearsal
# is already five reactions deep at Judge and a reaction to RehearsalJudged would pass the dispatcher's depth bound.
Hecks.hecksagon "QualityControl" do
  subscribe "Hecks.RehearsalAudited"

  translates "RecordVerdictWhenNothingWouldStopTheMint" do
    on RehearsalRun::RehearsalAudited
    where do
      (minting.value != "next" || edge_present.value) && refusal_total.value == 0
    end
    trigger Maintenance::RecordRehearsalVerdict, with: { run: :run, domain: :rehearsed_domain,
                                                          watermark: :watermark, rehearsal_verdict: "would_mint" }
  end
end

# The architect's session closes with a verdict, which the adapter reads off the job: JobRead carries
# it, and the plan review records it. The run's key is the Work item, so it names the review.
Hecks.hecksagon "Agents" do
  subscribe "Hecks.JobRead"
  # Each sweep of the sessions sends a verdict the coder's session refused again (Agents
  # RedeliverTheUnresumedVerdict), or gives it up once its tries are spent.
  subscribe "Hecks.SweepRequested"
  subscribe "Coder.WorkSubmitted"
  subscribe "Pipeline.PassageVerified"

  # The coder hands in a branch: the reviewer is asked to judge it. The branch is named for the Work item,
  # the review is keyed by the commit, and the session works in the coder's checkout, which the event names.
  translates "AskTheReviewerWhenWorkIsSubmitted" do
    on Submission::WorkSubmitted
    trigger SubmissionReview::Request, with: { submission: :sha, work: :branch, brief: :branch, hops: 1,
                                               role: "reviewer", repo: :checkout }
  end

  # The reviewer's session closes with its judgment, which the adapter reads off the job; the run's key
  # is the submitted commit, so it names the review.
  translates "RecordTheReviewersJudgment" do
    on AgentRun::JobRead
    where { judgment != "" && previous != state }
    trigger SubmissionReview::Judge, with: { submission: :run, judgment: :judgment }
  end

  # Main is green on a change: the release manager recommends promoting it. A person confirms.
  translates "RecommendPromotionWhenVerified" do
    on Passage::PassageVerified
    trigger PromotionRecommendation::Recommend,
            with: { change: :change, reasons: "main is green on this change", role: "release_manager", repo: ".",
                    brief: "Main is green on this change. Recommend promote, revert or fix forward, with reasons. " \
                           "Only recommend: the owner confirms any promotion on the board." }
  end

  # The architect's session closes with its verdict, or says it and goes idle; the run's key is the
  # review's, so it names the review it answers. It reads the job as `RecordTheVerdictWhenNoReviewWasAsked`
  # and `JudgeTheArchitectsVerdict` in the Agents bluebook do, so a review that exists is answered
  # on the read that judges its verdict, and one no request made is recorded by `Record`.
  translates "RecordTheArchitectsVerdict" do
    on AgentRun::JobRead
    where { verdict != "" && (previous != state || (listed == "idle" && previous != "done")) }
    trigger PlanReview::Answer, with: { run: :run, verdict: :verdict, findings: :findings }
  end

  # The coder's session was resumed with the verdict.
  translates "RecordTheVerdictDelivered" do
    on AgentRun::AgentRunAnswered
    where { verdict != "" }
    trigger Verdict::Deliver, with: { run: :verdict }
  end

  # The waiting coder's session refused the verdict's resume: the verdict is kept to be sent again
  # (Agents `RedeliverTheUnresumedVerdict`), with the reason, not settled as undeliverable.
  translates "RecordTheVerdictUnresumed" do
    on AgentRun::AgentRunUnresumed
    trigger Verdict::Unresume, with: { run: :verdict, reason: :refusal }
  end

  # The verdict came after the coder's run had finished: the reason is the same kind of finding.
  translates "RecordTheVerdictOfAFinishedRun" do
    on AgentRun::AgentRunUnreached
    trigger Verdict::Undeliver, with: { run: :verdict, reason: :refusal }
  end
end

# A coder's session closes with its report, and the adapter reads the branch, commit and cleanliness of
# the run's checkout off the job once a coder's job is done. A report whose last word is `submitted` hands
# the branch in; Submit refuses main, stable and a dirty tree by name. Submitting also finishes the Work
# item the branch is named for (Tickets) and starts maintenance (QualityControl), as a hand submit does.
# A root, as the JobRead policies of the delegate bluebook are: the reviewer's start that a submission
# asks for sits past the reaction depth limit when counted from the check that read the job.
Hecks.hecksagon "Coder" do
  subscribe "Hecks.JobRead"

  translates "SubmitWhenTheCoderSaysSubmitted" do
    on AgentRun::JobRead
    root
    where { state == "done" && previous != state && agent == "coder" && report.rstrip.end_with?("submitted") }
    trigger Submission::Submit, with: { branch: :branch, sha: :sha, checkout: :checkout, clean: :clean }
  end
end
