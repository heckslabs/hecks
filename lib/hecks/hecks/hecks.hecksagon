  # Queries answered from outside the domain. The bluebook declares the question and the value
  # object its answer takes (`returns`) and never says who answers it; each `answers_query` here
  # binds it to the port's adapter. The queries on the ports above (Follow, the SchemaRevision readings,
  # WordStatus and the rest) are bound the same way.
  Hecks::Introspection.port "DomainRuntime" do
    answers_query "Ir"
    answers_query "Shape"
    answers_query "Stores"
    answers_query "History"
    answers_query "Statements"
    answers_query "Undo"
    answers_query "Narrate"
    answers_query "Relationships"
    answers_query "ContextMap"
    answers_query "WorldSkeleton"
    answers_query "Docs"
