Hecks.hecksagon "Hecks" do
  attaches "Governance"

  # The bluebooks the gem carries: the language declared in itself (Paging comes with Bluebook),
  # Expression, Tenancy, Deploy, Site, Tickets, Composer and QualityControl (the last three bring
  # their own ports), and Coder and Fixer, whose events Tickets and QualityControl react to.
  %w[Bluebook Hecksagon World Adapter Port Translation Expression Tenancy Deploy Site Tickets Composer QualityControl
     Coder Fixer PipelineBoard Pipeline Agents Triage]
    .each { |declaration| attaches declaration }
  # An architect review asked for by event starts a session through AgentRun, keyed by the review
  # (see StartTheRoleOnReviewRequest in the delegate bluebook).
  subscribe "Agents.PlanReviewRequested"
  subscribe "Agents.PlanningRequested"
  subscribe "Agents.SubmissionReviewRequested"
  subscribe "Agents.DispatchAdviceRequested"
  # An exception that wakes the orchestrator starts its session (StartTheCoordinatorWhenWoken).
  subscribe "Agents.CoordinatorWoken"
  # A woken pruner starts a session through AgentRun (see StartThePrunerWhenWoken in the delegate bluebook).
  subscribe "Agents.PrunerWoken"
  # A judged verdict answers the coder waiting on its Work item (AnswerTheWaitingCoder in the delegate
  # bluebook); the outcome comes back as a delivered or an undeliverable verdict.
  subscribe "Agents.VerdictJudged"
  # A verdict the coder's session refused on every try finishes the coder's run `unanswered`
  # (FinishTheCoderWhoseVerdictWasAbandoned in the delegate bluebook).
  subscribe "Agents.VerdictAbandoned"
  # A verdict sent again answers the waiting coder as a judged one does (AnswerTheWaitingCoderAgain).
  subscribe "Agents.VerdictRedelivered"
  # Persistence is not bound here, so the domain is in Memory. A copy opts in with a
  # hecks.local.hecksagon whose `persisted_by` the attached bluebooks inherit (ADR 0136).

  # The outside a journaled Custodian command reaches: each port names what its adapter does,
  # and every ask is answered with the record's own arguments or refused with a reason.
  Hecks::ModelCheckRun.port "DomainRuntime" do
    asks "Check", to: ModelCheckRun do
      attribute :run, RunKey
      answers "ModelCheckAnswered"
      refuses "ModelCheckRefused"
    end
  end

  Hecks::Operation.port "DomainRuntime" do
    asks "Execute", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Refresh", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Redrive", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Abandon", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Verify", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Smoke", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Bootstrap", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    answers_query "Follow"
    answers_query "Feed"
  end

  Hecks::Operation.port "Terminal" do
    asks "Open", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end
  end

  Hecks::Host.port "HostHttp" do
    asks "Fetch", to: Host do
      attribute :host, Address
      answers "EraReported"
      refuses "HostRefused"
    end
  end

  Hecks::SendTrain.port "Train" do
    asks "Carry", to: SendTrain do
      attribute :run, RunKey
      answers "TrainAnswered"
      refuses "TrainRefused"
    end

    asks "Tally", to: SendTrain do
      attribute :run, RunKey
      answers "SurveyAnswered"
      refuses "SurveyRefused"
    end

    asks "Observe", to: SendTrain do
      attribute :run, RunKey
      answers "ObserveAnswered"
      refuses "ObserveRefused"
    end
  end

  # Where a boarding's outcome is recorded: the boarded checkout's own launcher records it in that
  # checkout's store. The train's own store stays Memory.
  Hecks::SendTrain.port "PushRecords" do
    asks "RecordOutcome", to: SendTrain do
      attribute :run, RunKey
      answers "OutcomeRecorded"
      refuses "OutcomeUnrecorded"
    end
  end

  Hecks::PushRehearsal.port "Rehearsing" do
    asks "Trial", to: PushRehearsal do
      attribute :run, RunKey
      answers "PushRehearsalAnswered"
      refuses "PushRehearsalRefused"
    end

    answers_query "Due"
  end

  Hecks::RedFlag.port "Flagging" do
    %w[Hoist SignIn Lower Survey].each do |step|
      asks step, to: RedFlag do
        attribute :run, RunKey
        answers "FlagAnswered"
        refuses "FlagRefused"
      end
    end

    answers_query "Status"
  end


  Hecks::BoardingHold.port "Holding" do
    asks "Mark", to: BoardingHold do
      attribute :run, RunKey
      answers "HoldAnswered"
      refuses "HoldRefused"
    end

    answers_query "Status"
  end

  Hecks::BoardingRelease.port "Releasing" do
    asks "Clear", to: BoardingRelease do
      attribute :run, RunKey
      answers "ReleaseAnswered"
      refuses "ReleaseRefused"
    end
  end

  Hecks::QaQuiesce.port "Quiescing" do
    asks "Mark", to: QaQuiesce do
      attribute :run, RunKey
      answers "QuiesceAnswered"
      refuses "QuiesceRefused"
    end

    asks "Clear", to: QaQuiesce do
      attribute :run, RunKey
      answers "QuiesceAnswered"
      refuses "QuiesceRefused"
    end

    answers_query "Status"
  end

  # Read-only: the event tap's opening lines still waiting for their closing lines, priced by the
  # clock. The adapter reads the log as the `Feed` query does and boots no domain.
  Hecks::StallWatch.port "Watching" do
    answers_query "Unclosed"
    answers_query "Abandoned"
  end

  Hecks::SendTrain.port "Alerts" do
    asks "Announce", to: SendTrain do
      attribute :run, RunKey
      attribute :pushed, Word
      answers "DeployReadyAnnounced"
      refuses "AnnouncementRefused"
    end
  end

  Hecks::SendTrain.port "Leftovers" do
    asks "Leftovers", to: SendTrain do
      attribute :run, RunKey
      attribute :pushed, Word
      answers "LeftoversListed"
      refuses "LeftoversRefused"
    end
  end

  Hecks::Workspace.port "Reading" do
    answers_query "Status"
    answers_query "Strays"
    answers_query "Changes"
    answers_query "History"
    answers_query "Stashes"
    answers_query "DanglingCommits"
  end

  Hecks::Workspace.port "Settings" do
    answers_query "Settings"
  end

  Hecks::Workspace.port "Doctor" do
    answers_query "Doctor"
  end

  Hecks::Workspace.port "Where" do
    answers_query "Where"
  end

  Hecks::Revision.port "Committing" do
    asks "Commit", to: Revision do
      attribute :run, RunKey
      answers "CommitAnswered"
      refuses "CommitRefused"
    end
  end

  Hecks::Restoration.port "Restoring" do
    asks "Restore", to: Restoration do
      attribute :run, RunKey
      answers "RestoreAnswered"
      refuses "RestoreRefused"
    end
  end

  Hecks::ShallowCheck.port "ShallowChecks" do
    asks "ShallowCheck", to: ShallowCheck do
      attribute :run, RunKey
      answers "ShallowCheckAnswered"
      refuses "ShallowCheckRefused"
    end

    asks "ShallowSwitch", to: ShallowCheck do
      attribute :run, RunKey
      answers "ShallowSwitchAnswered"
      refuses "ShallowSwitchRefused"
    end
  end

  Hecks::LinkedTree.port "WorktreeAdding" do
    asks "Create", to: LinkedTree do
      attribute :run, RunKey
      answers "CreateAnswered"
      refuses "CreateRefused"
    end

    asks "Pull", to: LinkedTree do
      attribute :run, RunKey
      answers "PullAnswered"
      refuses "PullRefused"
    end
  end

  Hecks::LinkedTree.port "Publishing" do
    asks "Push", to: LinkedTree do
      attribute :run, RunKey
      answers "BranchPublishAnswered"
      refuses "BranchPublishRefused"
    end
  end

  # Rebasing a worktree's branch onto a base: the git port runs the rebase and answers the sha, or refuses
  # with the conflicted files and the sides they came from.
  Hecks::LinkedTree.port "Rebasing" do
    asks "Replay", to: LinkedTree do
      attribute :run, RunKey
      answers "RebaseAnswered"
      refuses "RebaseRefused"
    end
  end

  # Applying one commit onto a worktree's branch: the git port cherry-picks it and answers the sha, or refuses
  # with the conflicted files and aborts, so nothing is left half-applied.
  Hecks::LinkedTree.port "Picking" do
    asks "Apply", to: LinkedTree do
      attribute :run, RunKey
      answers "PickAnswered"
      refuses "PickRefused"
    end
  end

  Hecks::Landing.port "Worktrees" do
    asks "Merge", to: Landing do
      attribute :run, RunKey
      answers "MergeAnswered"
      refuses "MergeRefused"
    end

    asks "FinishBranch", to: Landing do
      attribute :run, RunKey
      answers "MergeAnswered"
      refuses "MergeRefused"
    end

    asks "Convene", to: Landing do
      attribute :run, RunKey
      answers "ConveneAnswered"
      refuses "ConveneRefused"
    end

    asks "Remove", to: Landing do
      attribute :run, RunKey
      answers "RemovalAnswered"
      refuses "RemovalRefused"
    end

    asks "DropBranch", to: Landing do
      attribute :run, RunKey
      answers "DiscardAnswered"
      refuses "DiscardRefused"
    end

    asks "MoveAside", to: Landing do
      attribute :run, RunKey
      answers "SetAsideAnswered"
      refuses "SetAsideRefused"
    end

    answers_query "Unlanded"
  end

  # The Work item a landed branch was cut for: the port reads the Work items and answers the open
  # one the branch names, refusing when there is none.
  Hecks::Landing.port "LandedWork" do
    asks "FindLandedWork", to: Landing do
      attribute :branch, Word
      answers "LandedWorkFound"
      refuses "NoLandedWork"
    end
  end

  # The gate of the checkout a shipment names: the port is asked to judge that checkout and answers
  # that it passed, or refuses with the end of what the gate printed. The checkout decides what its
  # gate holds; delivery names no check (ADR 0205).
  Hecks::Shipment.port "Gate" do
    asks "Judge", to: Shipment do
      attribute :run, RunKey
      answers "JudgementAnswered"
      refuses "JudgementRefused"
    end
  end

  # The outside an integration of main reaches: the open runs an advance steps, a clean copy of
  # main for a verification, the push train's own copy for a boarding, and GitHub's CI runs.
  Hecks::Integration.port "Integrating" do
    asks "Step", to: Integration do
      attribute :run, RunKey
      answers "AdvanceAnswered"
      refuses "AdvanceRefused"
    end

    # A beat of the clock reads the CI run of each pushed or watched run and verifies or boards
    # nothing; a beat with no such run is refused as quiet.
    asks "Tend", to: Integration do
      attribute :run, RunKey
      answers "TendAnswered"
      refuses "TendRefused"
    end

    # The launchd job that beats the clock once a minute from outside the domain: written and
    # loaded, or unloaded and removed. Unconfirmed, each answers what it would do.
    asks "Arrange", to: Integration do
      attribute :run,     RunKey
      attribute :confirm, Switch
      answers "ArrangeAnswered"
      refuses "ArrangeRefused"
    end

    asks "Withdraw", to: Integration do
      attribute :run,     RunKey
      attribute :confirm, Switch
      answers "WithdrawAnswered"
      refuses "WithdrawRefused"
    end
  end

  Hecks::Integration.port "MainVerifying" do
    asks "Check", to: Integration do
      attribute :run, RunKey
      attribute :landed, Word
      # Carried onto the answer, so the rule that records a refusal knows a retry from a first try.
      attribute :retried, Switch
      answers "VerifyAnswered"
      refuses "VerifyRefused"
    end
  end

  Hecks::Integration.port "MainBoarding" do
    asks "Embark", to: Integration do
      attribute :run, RunKey
      attribute :landed, Word
      answers "BoardAnswered"
      refuses "BoardRefused"
    end
  end

  Hecks::Integration.port "CiRuns" do
    asks "Watch", to: Integration do
      attribute :run, RunKey
      attribute :landed, Word
      answers "ObserveAnswered"
      refuses "ObserveRefused"
    end
  end

  # Reruns the failed jobs of a train pull request's CI run, once the bluebook has decided to.
  Hecks::TrainPr.port "CiRuns" do
    asks "Restart", to: TrainPr do
      attribute :key, Key
      attribute :ci_run, Word
      attribute :pr, Word
      attribute :work, Word
      attribute :title, Word
      attribute :failure, Report
      attribute :cause, Word
      attribute :step, Report
      answers "RestartAnswered"
      refuses "RestartRefused"
    end
  end

  Hecks::ReviewRequest.port "GitHubPullRequests" do
    asks "Tidy", to: ReviewRequest do
      attribute :run, RunKey
      answers "TidyAnswered"
      refuses "TidyRefused"
    end

    asks "Create", to: ReviewRequest do
      attribute :run, RunKey
      answers "OpenAnswered"
      refuses "OpenRefused"
    end

    asks "Squash", to: ReviewRequest do
      attribute :run, RunKey
      answers "SquashAnswered"
      refuses "SquashRefused"
    end

    asks "Amend", to: ReviewRequest do
      attribute :run, RunKey
      answers "AmendAnswered"
      refuses "AmendRefused"
    end

    answers_query "Status"
    answers_query "Timeline"
  end

  # The outside a filling of the queue reaches: the Work items, the machine's load and the freeze.
  Hecks::Dispatch.port "Dispatching" do
    asks "Choose", to: Dispatch do
      attribute :run, DispatchKey
      attribute :only, Prefix, optional: true
      answers "DispatchReported"
      refuses "DispatchRefused"
    end

    asks "Conclude", to: Dispatch do
      attribute :run, DispatchKey
      answers "DispatchReported"
      refuses "DispatchRefused"
    end

    answers_query "Preview"
  end

  # The outside a rolling fill reaches: the same queue, machine and freeze as a filling, and the owner's
  # `dispatch_roll_forward` switch; a paused or repeated roll refuses.
  Hecks::Roll.port "Rolling" do
    asks "Roll", to: Roll do
      attribute :run, RollKey
      answers "RollReported"
      refuses "RollRefused"
    end
  end

  # The outside a queued train pull request reaches to have the clock beaten for it: it starts one
  # detached chain of ticks that sleeps the Tickets world's `ticks` period (`seconds`) and dispatches
  # `Ticker.Tick` each time, and answers how many beats the world's `minutes` allow. It is refused
  # when the launcher is not there to dispatch from.
  Hecks::Ticker.port "Ticking" do
    asks "Open", to: Ticker do
      attribute :run, TickerKey
      answers "TickerOpened"
      refuses "TickerUnopened"
    end
  end

  # The outside a beat of the clock reaches to learn whether the clock alone made something eligible:
  # a retry time that passed, a boot budget no longer spent, or a roll refused while a filling ran.
  # A beat with none of these is refused as quiet.
  Hecks::Wake.port "Waking" do
    asks "Notice", to: Wake do
      attribute :run, WakeKey
      answers "WakeDue"
      refuses "WakeQuiet"
    end
  end

  # The outside a reading of the machine reaches: the CPU idle percentage, swap used, the compressor's
  # size, the load average and the test lane's queue, judged against the Tickets world's `machine_marks`.
  # It answers each gauge's state and the state it stood in before; a reading within a minute of the last
  # one is refused. `Busiest` reads the process table: each class, its CPU and the session above it.
  Hecks::Machine.port "Sampling" do
    asks "Read", to: Machine do
      attribute :run, MachineKey
      answers "MachineSampled"
      refuses "MachineUnreadable"
    end

    answers_query "Busiest"
  end

  # The outside an agent run reaches: it finds the directory and the agents, starts the background
  # session, and reports the state its job is in. The state is judged in the bluebook, not here.
  # The Sessions port removes a plain session with `claude rm`, once the bluebook has allowed it.
  Hecks::PlainSession.port "Sessions" do
    asks "Discard", to: PlainSession do
      attribute :session, SessionId
      answers "PlainSessionRemoved"
      refuses "PlainSessionRefused"
    end

    # Reads the run that holds the session and whether a pinned role names it; changes nothing.
    asks "Examine", to: PlainSession do
      attribute :session, SessionId
      answers "SessionExamined"
      refuses "PlainSessionRefused"
    end

    # `claude rm`, then `claude stop` only if rm alone left the session listed; answers SessionRetired.
    asks "Withdraw", to: PlainSession do
      attribute :session, SessionId
      answers "SessionRetired"
      refuses "PlainSessionRefused"
    end
  end

  # The Cleaning port lists the Claude sessions, looks in each one's own worktree, and removes the
  # safe ones with `claude rm`; whether a cleanup may run is the bluebook's.
  Hecks::SessionCleanup.port "Cleaning" do
    asks "Clean", to: SessionCleanup do
      attribute :run, CleanupName
      answers "CleanupReported"
      refuses "CleanupRefused"
    end

    # The moment a reap began, which its report counts from.
    asks "Mark", to: SessionCleanup do
      attribute :run, CleanupName
      answers "ReapMarked"
      refuses "CleanupRefused"
    end

    # Removes the sessions no run holds (done or stopped, older than `session_keep`, no worktree)
    # and reports the whole reap.
    asks "SweepPlain", to: SessionCleanup do
      attribute :run, CleanupName
      attribute :since, Summary
      answers "CleanupReported"
      refuses "CleanupRefused"
    end

    answers_query "Removable"
  end

  Hecks::AgentRun.port "Agents" do
    asks "Locate", to: AgentRun do
      attribute :run, RunKey
      answers "RepoLocated"
      refuses "RepoMissing"
    end

    asks "Start", to: AgentRun do
      attribute :run, RunKey
      answers "AgentStarted"
      refuses "StartRefused"
    end

    # The state a session's job is in, with the state the run last recorded beside it. A sweep's
    # reading that finds no job is a different refusal from the one right after a start, where a
    # job not yet written is expected: only the sweep's reads a session that may be gone.
    asks "ReadJob", to: AgentRun do
      attribute :run, RunKey
      answers "JobRead"
      refuses "JobUnreadable"
    end

    # The same reading, taken once a just-started session has had a few seconds to fail.
    asks "AwaitJob", to: AgentRun do
      attribute :run, RunKey
      answers "JobRead"
      refuses "JobUnread"
    end

    # Whether a person took the session over is a fact about its transcript; the bluebook judges it.
    asks "Review", to: AgentRun do
      attribute :run, RunKey
      answers "SessionReviewed"
      refuses "ReviewRefused"
    end

    asks "Remove", to: AgentRun do
      attribute :run, RunKey
      answers "SessionRemoved"
      refuses "RemoveRefused"
    end

    # Clears the scratch the world's `reaping` line lists in the run's worktree: only paths git
    # ignores, never a tracked or untracked file.
    asks "ClearScratch", to: AgentRun do
      attribute :run, RunKey
      answers "ScratchCleared"
      refuses "ClearRefused"
    end

    # Removes the run's worktree and its branch once the branch is on main, with the guard
    # `Landing.retire!` makes.
    asks "RetireWorktree", to: AgentRun do
      attribute :run, RunKey
      answers "WorktreeRetired"
      refuses "RetireRefused"
    end

    # `claude stop` on a kept session the bluebook says holds its process for nothing; never a kill
    # by pid. The session stays listed.
    asks "StopSession", to: AgentRun do
      attribute :run, RunKey
      answers "SessionStopped"
      refuses "StopRefused"
    end

    # Whether `claude agents` still lists the session, before a run is retired; the bluebook judges it.
    asks "LookFor", to: AgentRun do
      attribute :run, RunKey
      answers "SessionLookedFor"
      refuses "LookForRefused"
    end

    # The operator's answer goes to the blocked session as the prompt of a resumed background session.
    asks "Resume", to: AgentRun do
      attribute :run, RunKey
      attribute :answer, Brief
      attribute :step, Brief
      attribute :verdict, VerdictKey
      answers "AgentResumed"
      refuses "ResumeRefused"
    end
  end

  Hecks::SendTrain.port "Launcher" do
    asks "Refresh", to: SendTrain do
      attribute :run, RunKey
      attribute :pushed, Word
      answers "LauncherRefreshed"
      refuses "LauncherRefreshRefused"
    end
  end

  Hecks::SchemaRevision.port "JournalStore" do
    asks "Examine", to: SchemaRevision do
      attribute :run, RunKey
      answers "SchemaRevisionExamined"
      refuses "SchemaRevisionRefused"
    end

    asks "Apply", to: SchemaRevision do
      attribute :run, RunKey
      answers "SchemaRevisionChanged"
      refuses "SchemaRevisionRefused"
    end

    asks "Mint", to: SchemaRevision do
      attribute :run, RunKey
      answers "Minted"
      refuses "MintRefused"
    end

    answers_query "ScaffoldTranslation"
    answers_query "AuditTranslation"
    answers_query "ComposeTranslation"
    answers_query "ReconcilePlan"
    answers_query "Attestation"
    answers_query "Compaction"
    answers_query "BootStatus"
    answers_query "SqliteStatus"
    answers_query "EventTrace"
    answers_query "MintPlan"
    answers_query "BootResolution"
    answers_query "ProjectionAudit"
  end

  Hecks::SchemaRevision.port "Ledger" do
    asks "Capture", to: SchemaRevision do
      attribute :run, RunKey
      answers "HeadCaptured"
      refuses "CaptureRefused"
    end
  end

  Hecks::Audit.port "Ledger" do
    asks "Walk", to: Audit do
      attribute :run, AuditKey
      answers "ChainWalked"
      refuses "WalkRefused"
    end
  end

  Hecks::Package.port "Git" do
    asks "Pin", to: Package do
      attribute :package, PackageRef
      answers "PackagePinned"
      refuses "PinRefused"
    end

    answers_query "Verify"
  end

  Hecks::Registry.port "Git" do
    asks "Tag", to: Registry do
      attribute :run, RegistryKey
      answers "ReleaseTagged"
      refuses "ReleaseRefused"
    end

    answers_query "Check"
    answers_query "Digest"
  end

  Hecks::Launch.port "Workspace" do
    asks "Write", to: Launch do
      attribute :run, LaunchKey
      answers "LaunchAnswered"
      refuses "LaunchRefused"
    end

    asks "Scaffold", to: Launch do
      attribute :run, LaunchKey
      answers "LaunchAnswered"
      refuses "LaunchRefused"
    end

    asks "WriteRails", to: Launch do
      attribute :run, LaunchKey
      answers "LaunchAnswered"
      refuses "LaunchRefused"
    end
  end

  Hecks::Server.port "Terminal" do
    asks "Serve", to: Server do
      attribute :run, RunKey
      answers "ServerAnswered"
      refuses "ServerRefused"
    end
  end

  Hecks::Launch.port "Terminal" do
    asks "Converse", to: Launch do
      attribute :run, LaunchKey
      answers "LaunchAnswered"
      refuses "LaunchRefused"
    end
  end

  Hecks::Build.port "RustToolchain" do
    asks "Generate", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Wasm", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Host", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "BrowserWasm", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Prune", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Parser", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Conform", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Replay", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Audit", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    answers_query "RustCoverage"
  end

  Hecks::FuzzRun.port "ProcessPool" do
