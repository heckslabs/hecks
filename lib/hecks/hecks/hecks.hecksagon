Hecks.hecksagon "Hecks" do
  attaches "Governance"

  # The bluebooks the gem carries: the language declared in itself (Paging comes with Bluebook),
  # Expression, Tenancy, Deploy, Site, Tickets, Composer and QualityControl (the last three bring
  # their own ports), and Coder and Fixer, whose events Tickets and QualityControl react to.
  %w[Bluebook Hecksagon World Adapter Port Translation Expression Tenancy Deploy Site Tickets Composer QualityControl
     Coder Fixer PipelineBoard Pipeline]
    .each { |declaration| attaches declaration }
  # Persistence is not bound here, so the domain is in Memory. A copy opts in with a
  # hecks.local.hecksagon whose `persisted_by` the attached bluebooks inherit (ADR 0136).

  # The outside a journaled Custodian command reaches: each port names what its adapter does,
  # and every ask is answered with the record's own arguments or refused with a reason.
  Hecks::ModelCheckRun.port "DomainRuntime" do
    asks "Check", to: ModelCheckRun do
      attribute :run, RunKey
      answers "ModelCheckAnswered"
      refuses "ModelCheckRefused"
    end
  end

  Hecks::Operation.port "DomainRuntime" do
    asks "Execute", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Refresh", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Redrive", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Abandon", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Verify", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Smoke", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Bootstrap", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    answers_query "Follow"
  end

  Hecks::Operation.port "Terminal" do
    asks "Open", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end
  end

  Hecks::Host.port "HostHttp" do
    asks "Fetch", to: Host do
      attribute :host, Address
      answers "EraReported"
      refuses "HostRefused"
    end
  end

  Hecks::SendTrain.port "Train" do
    asks "Carry", to: SendTrain do
      attribute :run, RunKey
      answers "TrainAnswered"
      refuses "TrainRefused"
    end

    asks "Tally", to: SendTrain do
      attribute :run, RunKey
      answers "SurveyAnswered"
      refuses "SurveyRefused"
    end
  end

  # Where a boarding's outcome is recorded: the boarded checkout's own launcher records it in that
  # checkout's store. The train's own store stays Memory.
  Hecks::SendTrain.port "PushRecords" do
    asks "RecordOutcome", to: SendTrain do
      attribute :run, RunKey
      answers "OutcomeRecorded"
      refuses "OutcomeUnrecorded"
    end
  end

  Hecks::PushRehearsal.port "Rehearsing" do
    asks "Trial", to: PushRehearsal do
      attribute :run, RunKey
      answers "PushRehearsalAnswered"
      refuses "PushRehearsalRefused"
    end

    answers_query "Due"
  end

  Hecks::RedFlag.port "Flagging" do
    %w[Hoist SignIn Lower Survey Evict].each do |step|
      asks step, to: RedFlag do
        attribute :run, RunKey
        answers "FlagAnswered"
        refuses "FlagRefused"
      end
    end

    answers_query "Status"
  end

  # Who may board the push train: the assignment is a marker in the repository's git directory, and
  # the waiting read lists what landed on local main and is not on the remote.
  Hecks::Pusher.port "Pushing" do
    asks "Mark", to: Pusher do
      attribute :run, RunKey
      answers "PusherAnswered"
      refuses "PusherRefused"
    end

    answers_query "Current"
    answers_query "Waiting"
  end

  # The owner's desktop hears the flag go up and come down; the ask carries the flag's facts, so
  # it needs nothing the record has not been handed yet.
  Hecks::RedFlag.port "Alerts" do
    asks "Flag", to: RedFlag do
      attribute :run,     RunKey
      attribute :outcome, Word
      attribute :flag,    Word
      attribute :commit,  Word
      attribute :ci_run,  Report, optional: true
      attribute :jobs,    Report, optional: true
      answers "AlertShown"
      refuses "AlertRefused"
    end
  end

  Hecks::QaQuiesce.port "Quiescing" do
    asks "Mark", to: QaQuiesce do
      attribute :run, RunKey
      answers "QuiesceAnswered"
      refuses "QuiesceRefused"
    end

    asks "Clear", to: QaQuiesce do
      attribute :run, RunKey
      answers "QuiesceAnswered"
      refuses "QuiesceRefused"
    end

    answers_query "Status"
  end

  Hecks::SendTrain.port "Alerts" do
    asks "Announce", to: SendTrain do
      attribute :run, RunKey
      attribute :pushed, Word
      answers "DeployReadyAnnounced"
      refuses "AnnouncementRefused"
    end
  end

  Hecks::SendTrain.port "Leftovers" do
    asks "Leftovers", to: SendTrain do
      attribute :run, RunKey
      attribute :pushed, Word
      answers "LeftoversListed"
      refuses "LeftoversRefused"
    end
  end

  Hecks::Workspace.port "Reading" do
    answers_query "Status"
    answers_query "Changes"
    answers_query "History"
  end

  Hecks::Workspace.port "Settings" do
    answers_query "Settings"
  end

  Hecks::Workspace.port "Doctor" do
    answers_query "Doctor"
  end

  Hecks::Workspace.port "Where" do
    answers_query "Where"
  end

  Hecks::Revision.port "Committing" do
    asks "Commit", to: Revision do
      attribute :run, RunKey
      answers "CommitAnswered"
      refuses "CommitRefused"
    end
  end

  Hecks::LinkedTree.port "WorktreeAdding" do
    asks "Create", to: LinkedTree do
      attribute :run, RunKey
      answers "CreateAnswered"
      refuses "CreateRefused"
    end

    asks "Pull", to: LinkedTree do
      attribute :run, RunKey
      answers "PullAnswered"
      refuses "PullRefused"
    end
  end

  Hecks::Landing.port "Worktrees" do
    asks "Merge", to: Landing do
      attribute :run, RunKey
      answers "MergeAnswered"
      refuses "MergeRefused"
    end

    asks "FinishBranch", to: Landing do
      attribute :run, RunKey
      answers "MergeAnswered"
      refuses "MergeRefused"
    end

    asks "Convene", to: Landing do
      attribute :run, RunKey
      answers "ConveneAnswered"
      refuses "ConveneRefused"
    end

    asks "Remove", to: Landing do
      attribute :run, RunKey
      answers "RemovalAnswered"
      refuses "RemovalRefused"
    end

    asks "DropBranch", to: Landing do
      attribute :run, RunKey
      answers "DiscardAnswered"
      refuses "DiscardRefused"
    end

    answers_query "Unlanded"
  end

  # The Work item a landed branch was cut for: the port reads the Work items and answers the open
  # one the branch names, refusing when there is none.
  Hecks::Landing.port "LandedWork" do
    asks "FindLandedWork", to: Landing do
      attribute :branch, Word
      answers "LandedWorkFound"
      refuses "NoLandedWork"
    end
  end

  # The outside an integration of main reaches: the open runs an advance steps, a clean copy of
  # main for a verification, the push train's own copy for a boarding, and GitHub's CI runs.
  Hecks::Integration.port "Integrating" do
    asks "Step", to: Integration do
      attribute :run, RunKey
      answers "AdvanceAnswered"
      refuses "AdvanceRefused"
    end
  end

  Hecks::Integration.port "MainVerifying" do
    asks "Check", to: Integration do
      attribute :run, RunKey
      attribute :landed, Word
      answers "VerifyAnswered"
      refuses "VerifyRefused"
    end
  end

  Hecks::Integration.port "MainBoarding" do
    asks "Embark", to: Integration do
      attribute :run, RunKey
      attribute :landed, Word
      answers "BoardAnswered"
      refuses "BoardRefused"
    end
  end

  Hecks::Integration.port "CiRuns" do
    asks "Watch", to: Integration do
      attribute :run, RunKey
      attribute :landed, Word
      answers "ObserveAnswered"
      refuses "ObserveRefused"
    end
  end

  Hecks::ReviewRequest.port "GitHubPullRequests" do
    asks "Create", to: ReviewRequest do
      attribute :run, RunKey
      answers "OpenAnswered"
      refuses "OpenRefused"
    end

    asks "Squash", to: ReviewRequest do
      attribute :run, RunKey
      answers "SquashAnswered"
      refuses "SquashRefused"
    end

    answers_query "Status"
  end

  # The outside a filling of the queue reaches: the Work items, the machine's load and the freeze.
  Hecks::Dispatch.port "Dispatching" do
    asks "Choose", to: Dispatch do
      attribute :run, DispatchKey
      answers "DispatchReported"
      refuses "DispatchRefused"
    end

    asks "Conclude", to: Dispatch do
      attribute :run, DispatchKey
      answers "DispatchReported"
      refuses "DispatchRefused"
    end
  end

  # The outside an agent run reaches: it finds the directory and the agents, starts the background
  # session, and reports the state its job is in. The state is judged in the bluebook, not here.
  Hecks::AgentRun.port "Agents" do
    asks "Locate", to: AgentRun do
      attribute :run, RunKey
      answers "RepoLocated"
      refuses "RepoMissing"
    end

    asks "Start", to: AgentRun do
      attribute :run, RunKey
      answers "AgentStarted"
      refuses "StartRefused"
    end

    # The state a session's job is in, with the state the run last recorded beside it.
    asks "ReadJob", to: AgentRun do
      attribute :run, RunKey
      answers "JobRead"
      refuses "JobUnread"
    end

    # The same reading, taken once a just-started session has had a few seconds to fail.
    asks "AwaitJob", to: AgentRun do
      attribute :run, RunKey
      answers "JobRead"
      refuses "JobUnread"
    end

    # Whether a person took the session over is a fact about its transcript; the bluebook judges it.
    asks "Review", to: AgentRun do
      attribute :run, RunKey
      answers "SessionReviewed"
      refuses "ReviewRefused"
    end

    asks "Remove", to: AgentRun do
      attribute :run, RunKey
      answers "SessionRemoved"
      refuses "RemoveRefused"
    end
  end

  Hecks::SendTrain.port "Launcher" do
    asks "Refresh", to: SendTrain do
      attribute :run, RunKey
      attribute :pushed, Word
      answers "LauncherRefreshed"
      refuses "LauncherRefreshRefused"
    end
  end

  Hecks::Era.port "JournalStore" do
    asks "Examine", to: Era do
      attribute :run, RunKey
      answers "EraExamined"
      refuses "EraRefused"
    end

    asks "Apply", to: Era do
      attribute :run, RunKey
      answers "EraChanged"
      refuses "EraRefused"
    end

    asks "Mint", to: Era do
      attribute :run, RunKey
      answers "Minted"
      refuses "MintRefused"
    end

    answers_query "ScaffoldTranslation"
    answers_query "AuditTranslation"
    answers_query "ComposeTranslation"
    answers_query "ReconcilePlan"
    answers_query "Attestation"
    answers_query "Compaction"
    answers_query "BootStatus"
    answers_query "SqliteStatus"
    answers_query "EventTrace"
    answers_query "MintPlan"
    answers_query "BootResolution"
    answers_query "ProjectionAudit"
  end

  Hecks::Era.port "Ledger" do
    asks "Capture", to: Era do
      attribute :run, RunKey
      answers "HeadCaptured"
      refuses "CaptureRefused"
    end
  end

  Hecks::Audit.port "Ledger" do
    asks "Walk", to: Audit do
      attribute :run, AuditKey
      answers "ChainWalked"
      refuses "WalkRefused"
    end
  end

  Hecks::Package.port "Git" do
    asks "Pin", to: Package do
      attribute :package, PackageRef
      answers "PackagePinned"
      refuses "PinRefused"
    end

    answers_query "Verify"
  end

  Hecks::Registry.port "Git" do
    asks "Tag", to: Registry do
      attribute :run, RegistryKey
      answers "ReleaseTagged"
      refuses "ReleaseRefused"
    end

    answers_query "Check"
    answers_query "Digest"
  end

  Hecks::Launch.port "Workspace" do
    asks "Write", to: Launch do
      attribute :run, LaunchKey
      answers "LaunchAnswered"
      refuses "LaunchRefused"
    end

    asks "Scaffold", to: Launch do
      attribute :run, LaunchKey
      answers "LaunchAnswered"
      refuses "LaunchRefused"
    end

    asks "WriteRails", to: Launch do
      attribute :run, LaunchKey
      answers "LaunchAnswered"
      refuses "LaunchRefused"
    end
  end

  Hecks::Server.port "Terminal" do
    asks "Serve", to: Server do
      attribute :run, RunKey
      answers "ServerAnswered"
      refuses "ServerRefused"
    end
  end

  Hecks::Launch.port "Terminal" do
    asks "Converse", to: Launch do
      attribute :run, LaunchKey
      answers "LaunchAnswered"
      refuses "LaunchRefused"
    end
  end

  Hecks::Build.port "RustToolchain" do
    asks "Generate", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Wasm", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Host", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "BrowserWasm", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Parser", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Conform", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Replay", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Audit", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    answers_query "RustCoverage"
  end

  Hecks::FuzzRun.port "ProcessPool" do
    asks "Sweep", to: FuzzRun do
      attribute :run, FuzzKey
      answers "FuzzAnswered"
      refuses "FuzzRefused"
    end

    asks "Probe", to: FuzzRun do
      attribute :run, FuzzKey
      answers "FuzzAnswered"
      refuses "FuzzRefused"
    end
  end

  Hecks::FuzzRun.port "RustToolchain" do
    asks "Measure", to: FuzzRun do
      attribute :run, FuzzKey
      answers "FuzzAnswered"
      refuses "FuzzRefused"
    end
  end

  Hecks::Operation.port "HostHttp" do
    asks "Probe", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end
  end

  # Codebase: every ask goes to the SourceTree port, which examines the working tree before it
  # carries a request out.
  Hecks::ScriptRun.port "SourceTree" do
    asks "Examine", to: ScriptRun do
      attribute :run, RunKey
      answers "ScriptExamined"
      refuses "ScriptRefused"
    end

    asks "Perform", to: ScriptRun do
      attribute :run, RunKey
      answers "ScriptAnswered"
      refuses "ScriptRefused"
    end
  end

  Hecks::LanguageRun.port "SourceTree" do
    asks "Examine", to: LanguageRun do
      attribute :run, RunKey
      answers "LanguageExamined"
      refuses "LanguageRefused"
    end

    asks "Perform", to: LanguageRun do
      attribute :run, RunKey
      answers "LanguageAnswered"
      refuses "LanguageRefused"
    end

    answers_query "WordStatus"
  end

  Hecks::KernelRun.port "SourceTree" do
    asks "Examine", to: KernelRun do
      attribute :run, RunKey
      answers "KernelExamined"
      refuses "KernelRefused"
    end

    asks "Perform", to: KernelRun do
      attribute :run, RunKey
      answers "KernelAnswered"
      refuses "KernelRefused"
    end
  end

  Hecks::ConformanceRun.port "SourceTree" do
    asks "Examine", to: ConformanceRun do
      attribute :run, RunKey
      answers "ConformanceExamined"
      refuses "ConformanceRefused"
    end

    asks "Perform", to: ConformanceRun do
      attribute :run, RunKey
      answers "ConformanceAnswered"
      refuses "ConformanceRefused"
    end
  end

  Hecks::RegenerationRun.port "SourceTree" do
    asks "Examine", to: RegenerationRun do
      attribute :run, RunKey
      answers "RegenerationExamined"
      refuses "RegenerationRefused"
    end

    asks "Perform", to: RegenerationRun do
      attribute :run, RunKey
      answers "RegenerationAnswered"
      refuses "RegenerationRefused"
    end
  end

  Hecks::GateRun.port "SourceTree" do
    asks "Examine", to: GateRun do
      attribute :run, RunKey
      answers "GateExamined"
      refuses "GateRefused"
    end

    asks "Perform", to: GateRun do
      attribute :run, RunKey
      answers "GateAnswered"
      refuses "GateRefused"
    end
  end

  Hecks::StyleRun.port "SourceTree" do
    asks "Examine", to: StyleRun do
      attribute :run, RunKey
      answers "StyleExamined"
      refuses "StyleRefused"
    end

    asks "Perform", to: StyleRun do
      attribute :run, RunKey
      answers "StyleAnswered"
      refuses "StyleRefused"
    end

    answers_query "ReportComments"
    answers_query "ReportRustComments"
  end

  Hecks::InspectionRun.port "SourceTree" do
    asks "Examine", to: InspectionRun do
      attribute :run, RunKey
      answers "InspectionExamined"
      refuses "InspectionRefused"
    end

    asks "Perform", to: InspectionRun do
      attribute :run, RunKey
      answers "InspectionAnswered"
      refuses "InspectionRefused"
    end

  end

  Hecks::Codebase.port "SourceTree" do
    answers_query "Search"
    answers_query "ReadSource"
    answers_query "Outline"
    answers_query "Declaration"
  end

  Hecks::CodemodRun.port "SourceTree" do
    asks "Examine", to: CodemodRun do
      attribute :run, RunKey
      answers "CodemodExamined"
      refuses "CodemodRefused"
    end

    asks "Perform", to: CodemodRun do
      attribute :run, RunKey
      answers "CodemodAnswered"
      refuses "CodemodRefused"
    end
  end

  Hecks::TestSuiteRun.port "SourceTree" do
    asks "Examine", to: TestSuiteRun do
      attribute :run, RunKey
      answers "TestSuiteExamined"
      refuses "TestSuiteRefused"
    end

    asks "Perform", to: TestSuiteRun do
      attribute :run, RunKey
      answers "TestSuiteAnswered"
      refuses "TestSuiteRefused"
    end

    answers_query "ShardSpecs"
    answers_query "ListIoParallelSpecs"
    answers_query "RecordPatternCases"
  end

  Hecks::CorpusRun.port "SourceTree" do
    answers_query "RustDomains"
    answers_query "RegenOrder"
    answers_query "CorpusRustCoverage"
    answers_query "GeneratedKey"
    answers_query "IrConstructs"
    answers_query "IrDuplicates"
    answers_query "IrImpact"
  end

  Hecks::Server.port "SourceTree" do
    asks "Examine", to: Server do
      attribute :run, RunKey
      answers "ServerExamined"
      refuses "ServerRefused"
    end

    asks "Perform", to: Server do
      attribute :run, RunKey
      answers "ServerAnswered"
      refuses "ServerRefused"
    end
  end

  Hecks::PublishingRun.port "SourceTree" do
    asks "Examine", to: PublishingRun do
      attribute :run, RunKey
      answers "PublishingExamined"
      refuses "PublishingRefused"
    end

    asks "Perform", to: PublishingRun do
      attribute :run, RunKey
      answers "PublishingAnswered"
      refuses "PublishingRefused"
    end
  end

  # Promotion: the SourceTree adapter reads the lane's head and where each required check stands
  # against the commit, and carries out the move only after Accept.
  Hecks::PromotionRun.port "SourceTree" do
    asks "Examine", to: PromotionRun do
      attribute :run, RunKey
      answers "PromotionExamined"
      refuses "PromotionRefused"
    end

    asks "Perform", to: PromotionRun do
      attribute :run, RunKey
      answers "PromotionAnswered"
      refuses "PromotionRefused"
    end
  end

  # Rehearsal: what a client's domain does against a copy of its data. A rehearsal keeps nothing,
  # so the aggregate is bound to Memory whatever the world's default adapter is, and its report is
  # what the caller is handed. The RehearsalStore port is the copy the subject's own `.world`
  # names (`rehearsed_by`): asking it to survey prepares the copy and loads the domain against
  # it, asking it to examine runs the mint's audit over it and drops it. No era is written.
  Hecks::RehearsalRun.persisted_by("Memory")

  Hecks::RehearsalRun.port "RehearsalStore" do
    asks "Survey", to: RehearsalRun do
      attribute :run, RunKey
      answers "StoreSurveyed"
      refuses "StoreRefused"
    end

    asks "Examine", to: RehearsalRun do
      attribute :run, RunKey
      answers "StoreExamined"
      refuses "ExamineRefused"
    end
  end

  # Deploy, attached above: its bluebook loads without deploy.hecksagon, so the outside its
  # commands reach is named here as well. TenantProvisioning writes a tenant's overlay world;
  # DeployToolchain generates and checks a recipe and projects the OIDC manifests.
  Deploy::Tenant.port "TenantProvisioning" do
    asks "WriteOverlay", to: Tenant do
      attribute :database,  DatabaseName
      attribute :adapter,   AdapterName, optional: true
      attribute :directory, DirectoryPath
      answers "TenantProvisioned"
      refuses "ProvisioningRefused"
    end
  end

  Deploy::Recipe.port "DeployToolchain" do
    asks "Generate", to: Recipe do
      attribute :run, RunKey
      answers "RecipeAnswered"
      refuses "RecipeRefused"
    end
  end

  Deploy::Handover.port "DeployToolchain" do
    asks "ClearDeployment", to: Handover do
      attribute :run, RunKey
      answers "HandoverAnswered"
      refuses "HandoverRefused"
    end
  end

  Deploy::MakefileCheck.port "DeployToolchain" do
    asks "Scan", to: MakefileCheck do
      attribute :run, RunKey
      answers "LintAnswered"
      refuses "LintRefused"
    end
  end

  Deploy::CostCheck.port "CostExplorer" do
    asks "Measure", to: CostCheck do
      attribute :run, RunKey
      answers "CostAnswered"
      refuses "CostRefused"
    end
  end

  Deploy::SmokeRun.port "DeployToolchain" do
    asks "Smoke", to: SmokeRun do
      attribute :run, RunKey
      attribute :after, Origin, default: { value: "alone" }
      answers "SmokeAnswered"
      refuses "SmokeRefused"
    end
  end

  Deploy::ServiceRoll.port "DeployToolchain" do
    asks "RollService", to: ServiceRoll do
      attribute :run, RunKey
      answers "ServiceRollAnswered"
      refuses "ServiceRollRefused"
    end
  end

  Deploy::BoxRoll.port "DeployToolchain" do
    asks "RollBox", to: BoxRoll do
      attribute :run, RunKey
      answers "BoxRollAnswered"
      refuses "BoxRollRefused"
    end
  end

  Deploy::DataCopy.port "DeployToolchain" do
    asks "CopyData", to: DataCopy do
      attribute :run, RunKey
      answers "DataCopyAnswered"
      refuses "DataCopyRefused"
    end
  end

  Deploy::CopyVerification.port "DeployToolchain" do
    asks "CompareCopy", to: CopyVerification do
      attribute :run, RunKey
      answers "CopyVerificationAnswered"
      refuses "CopyVerificationRefused"
    end
  end

  Deploy::BluebookDiff.port "DeployToolchain" do
    asks "CompareBluebooks", to: BluebookDiff do
      attribute :run, RunKey
      answers "BluebookDiffAnswered"
      refuses "BluebookDiffRefused"
    end
  end

  Deploy::PreviewRun.port "DeployToolchain" do
    asks "RunPreview", to: PreviewRun do
      attribute :run, RunKey
      answers "PreviewRunAnswered"
      refuses "PreviewRunRefused"
    end
  end

  Deploy::CompanionRoll.port "DeployToolchain" do
    asks "RollCompanion", to: CompanionRoll do
      attribute :run, RunKey
      answers "CompanionRollAnswered"
      refuses "CompanionRollRefused"
    end
  end

  Deploy::TemplateComparison.port "DeployToolchain" do
    asks "Compare", to: TemplateComparison do
      attribute :run, RunKey
      answers "ComparisonAnswered"
      refuses "ComparisonUnreadable"
    end
  end

  Deploy::OidcManifest.port "DeployToolchain" do
    asks "Manifest", to: OidcManifest do
      attribute :run, RunKey
      answers "ManifestAnswered"
      refuses "ManifestRefused"
    end
  end

  # Queries answered from outside the domain. The bluebook declares the question and the value
  # object its answer takes (`returns`) and never says who answers it; each `answers_query` here
  # binds it to the port's adapter. The queries on the ports above (Follow, the Era readings,
  # WordStatus and the rest) are bound the same way.
  Hecks::Introspection.port "DomainRuntime" do
    answers_query "Ir"
    answers_query "Shape"
    answers_query "Stores"
    answers_query "History"
    answers_query "Statements"
    answers_query "Undo"
    answers_query "Narrate"
    answers_query "Relationships"
    answers_query "ContextMap"
    answers_query "WorldSkeleton"
    answers_query "Docs"
    answers_query "ProjectDiagrams"
    answers_query "Glossary"
  end

  Hecks::FuzzRun.port "DomainRuntime" do
    answers_query "GenerateSequence"
  end
end

# The one seam where Deploy's "Tenant" (a validated request) becomes Tenancy's "Tenant" (a fact),
# as tenancy.hecksagon declares it for the bluebooks booted on their own: `hecks deploy tenant.provision`
# registers the tenant it provisioned. It sits here, after `attaches` has loaded both bluebooks.
Hecks.hecksagon "Tenancy" do
  translates "RegisterProvisionedTenant" do
    on Tenant::TenantProvisioned
    trigger Tenant::Register, with: { slug: :slug, domain: :domain, realm: :realm, schema: :schema }
  end
end

# A rehearsal that would mint is the record a mint reads: QualityControl's Maintenance keeps the verdict and
# the watermark the copy held, so Maintenance.MintEra finds it by this run (the mint plan's watermark guard).
# QualityControl is attached here, so the seam is its translation of the migrate bluebook's audit, not an
# `across` dispatch. It listens beside Judge, on the same audit and the same condition, because the rehearsal
# is already five reactions deep at Judge and a reaction to RehearsalJudged would pass the dispatcher's depth bound.
Hecks.hecksagon "QualityControl" do
  subscribe "Hecks.RehearsalAudited"

  translates "RecordVerdictWhenNothingWouldStopTheMint" do
    on RehearsalRun::RehearsalAudited
    where do
      (minting.value != "next" || edge_present.value) && refusal_total.value == 0
    end
    trigger Maintenance::RecordRehearsalVerdict, with: { run: :run, domain: :rehearsed_domain,
                                                          watermark: :watermark, rehearsal_verdict: "would_mint" }
  end
end
