Hecks.hecksagon "Hecks" do
  uses_framework "Governance"

  # The chapters that describe the framework itself (ADR 0080, section 4). Each keeps its own
  # name, namespace and store; context_map.hecksagon holds the sibling hecksagon of each.
  # Paging extends Bluebook (`attaches_to`) and so comes with it. Translation is the language's
  # chapter (lib/hecks/language/translation), never the grammar's.
  attaches "Bluebook"
  attaches "Paging"
  attaches "Hecksagon"
  attaches "World"
  attaches "Adapter"
  attaches "Port"
  attaches "Translation"
  attaches "Expression"
  attaches "Tenancy"
  attaches "Deploy"

  # Persistence is not bound here: hecks.world's `default_adapter` binds every aggregate, so
  # environments/memory.world can swap the whole domain without a double bind.

  # The outside a journaled Custodian command reaches: each port names what its adapter does,
  # and every ask is answered with the record's own arguments or refused with a reason.
  Hecks::ModelCheckRun.port "DomainRuntime" do
    asks "Check", to: ModelCheckRun do
      attribute :run, RunKey
      answers "ModelCheckAnswered"
      refuses "ModelCheckRefused"
    end
  end

  Hecks::Operation.port "DomainRuntime" do
    asks "Execute", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Refresh", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Verify", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end

    asks "Smoke", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end
  end

  Hecks::Operation.port "Terminal" do
    asks "Open", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end
  end

  Hecks::Host.port "HostHttp" do
    asks "Fetch", to: Host do
      attribute :host, Address
      answers "EraReported"
      refuses "HostRefused"
    end
  end

  Hecks::Era.port "JournalStore" do
    asks "Examine", to: Era do
      attribute :run, RunKey
      answers "EraExamined"
      refuses "EraRefused"
    end

    asks "Apply", to: Era do
      attribute :run, RunKey
      answers "EraChanged"
      refuses "EraRefused"
    end
  end

  Hecks::Package.port "Git" do
    asks "Pin", to: Package do
      attribute :package, PackageRef
      answers "PackagePinned"
      refuses "PinRefused"
    end
  end

  Hecks::Door.port "Workspace" do
    asks "Write", to: Door do
      attribute :run, DoorKey
      answers "DoorAnswered"
      refuses "DoorRefused"
    end
  end

  Hecks::Door.port "Terminal" do
    asks "Serve", to: Door do
      attribute :run, DoorKey
      answers "DoorAnswered"
      refuses "DoorRefused"
    end
  end

  Hecks::Build.port "RustToolchain" do
    asks "Generate", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Wasm", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "BrowserWasm", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Conform", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Replay", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end

    asks "Audit", to: Build do
      attribute :run, BuildKey
      answers "BuildAnswered"
      refuses "BuildRefused"
    end
  end

  Hecks::FuzzRun.port "ProcessPool" do
    asks "Sweep", to: FuzzRun do
      attribute :run, FuzzKey
      answers "FuzzAnswered"
      refuses "FuzzRefused"
    end
  end

  Hecks::FuzzRun.port "RustToolchain" do
    asks "Measure", to: FuzzRun do
      attribute :run, FuzzKey
      answers "FuzzAnswered"
      refuses "FuzzRefused"
    end
  end

  Hecks::Operation.port "HostHttp" do
    asks "Probe", to: Operation do
      attribute :run, OperationKey
      answers "OperationAnswered"
      refuses "OperationRefused"
    end
  end

  # Codebase: every ask goes to the SourceTree port, which examines the working tree before it
  # carries a request out.
  Hecks::LanguageRun.port "SourceTree" do
    asks "Examine", to: LanguageRun do
      attribute :run, RunKey
      answers "LanguageExamined"
      refuses "LanguageRefused"
    end

    asks "Perform", to: LanguageRun do
      attribute :run, RunKey
      answers "LanguageAnswered"
      refuses "LanguageRefused"
    end
  end

  Hecks::KernelRun.port "SourceTree" do
    asks "Examine", to: KernelRun do
      attribute :run, RunKey
      answers "KernelExamined"
      refuses "KernelRefused"
    end

    asks "Perform", to: KernelRun do
      attribute :run, RunKey
      answers "KernelAnswered"
      refuses "KernelRefused"
    end
  end

  Hecks::ConformanceRun.port "SourceTree" do
    asks "Examine", to: ConformanceRun do
      attribute :run, RunKey
      answers "ConformanceExamined"
      refuses "ConformanceRefused"
    end

    asks "Perform", to: ConformanceRun do
      attribute :run, RunKey
      answers "ConformanceAnswered"
      refuses "ConformanceRefused"
    end
  end

  Hecks::RegenerationRun.port "SourceTree" do
    asks "Examine", to: RegenerationRun do
      attribute :run, RunKey
      answers "RegenerationExamined"
      refuses "RegenerationRefused"
    end

    asks "Perform", to: RegenerationRun do
      attribute :run, RunKey
      answers "RegenerationAnswered"
      refuses "RegenerationRefused"
    end
  end

  Hecks::StyleRun.port "SourceTree" do
    asks "Examine", to: StyleRun do
      attribute :run, RunKey
      answers "StyleExamined"
      refuses "StyleRefused"
    end

    asks "Perform", to: StyleRun do
      attribute :run, RunKey
      answers "StyleAnswered"
      refuses "StyleRefused"
    end
  end

  Hecks::CodemodRun.port "SourceTree" do
    asks "Examine", to: CodemodRun do
      attribute :run, RunKey
      answers "CodemodExamined"
      refuses "CodemodRefused"
    end

    asks "Perform", to: CodemodRun do
      attribute :run, RunKey
      answers "CodemodAnswered"
      refuses "CodemodRefused"
    end
  end

  Hecks::TestSuiteRun.port "SourceTree" do
    asks "Examine", to: TestSuiteRun do
      attribute :run, RunKey
      answers "TestSuiteExamined"
      refuses "TestSuiteRefused"
    end

    asks "Perform", to: TestSuiteRun do
      attribute :run, RunKey
      answers "TestSuiteAnswered"
      refuses "TestSuiteRefused"
    end
  end

  Hecks::CorpusRun.port "SourceTree" do
    asks "Examine", to: CorpusRun do
      attribute :run, RunKey
      answers "CorpusExamined"
      refuses "CorpusRefused"
    end

    asks "Perform", to: CorpusRun do
      attribute :run, RunKey
      answers "CorpusAnswered"
      refuses "CorpusRefused"
    end
  end

  Hecks::PublishingRun.port "SourceTree" do
    asks "Examine", to: PublishingRun do
      attribute :run, RunKey
      answers "PublishingExamined"
      refuses "PublishingRefused"
    end

    asks "Perform", to: PublishingRun do
      attribute :run, RunKey
      answers "PublishingAnswered"
      refuses "PublishingRefused"
    end
  end
end

# The two attached chapters that name constants of their own (an event to react to, an aggregate
# to ask through) are wired here, after `attaches` has loaded them; context_map.hecksagon
# is read first.

# Tenancy takes its store from hecks.world like the rest. The one seam where Deploy's "Tenant" (a
# validated request) becomes Tenancy's "Tenant" (a fact): `on` omits the "Deploy::" prefix, since
# PolicyInterpreter matches event and aggregate name only, and `with:` is required because the
# event payload also carries the port's dispatch-time args, which `Register` does not declare.
Hecks.hecksagon "Tenancy" do
  translates "RegisterProvisionedTenant" do
    on Tenant::TenantProvisioned
    trigger Tenant::Register, with: { slug: :slug, domain: :domain, realm: :realm, schema: :schema }
  end
end

# Deploy's ports are shared with the chapter's own boot; loading the file here binds them to this
# domain's adapters.
Kernel.load(File.expand_path("../deploy/bluebook/deploy_ports.hecksagon", __dir__))
