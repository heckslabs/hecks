Hecks.behaviors "Watchdog" do
  vision "The watchdog is armed or disarmed by a request the outside answers; it claims nothing it has not been told."

  loads "hecks.bluebook", "context_map.hecksagon", "hecks.hecksagon", "red_wake.hecksagon", "stable_roll.hecksagon", "environments/memory.world", modules: :all

  test "Arm records the request to guard the pinned sessions" do
    tests "Arm", on: "Watchdog"
    input run: { value: "watch-1" }
    expect emits: ["ArmRequested"]
  end

  test "Disarm records the request to release the pinned sessions" do
    tests "Disarm", on: "Watchdog"
    input run: { value: "watch-2" }
    expect emits: ["DisarmRequested"]
  end
end
