Hecks.bluebook "Hecks" do
  domain_module "Delegate" do
    vision "Hand work to a background session."

    # Agents: handing one brief to a background Claude session (ADR 0141). A dispatch is a run like
    # the Custodian `*Run`s: it is requested, the outside is asked, and what came back is judged by
    # the givens and reactions below.
    #
    # The bluebook decides everything: a brief must say something, an agent name cannot be mistaken
    # for a flag, the directory must be one the `Agents` port finds and the agent one it lists, and a
    # job that reports `done`, `stopped` or `failed` has ended while `working` and `blocked` have
    # not. The port only looks and starts: it finds the directory and the agents, starts the
    # session, and reports the state its job is in.

    aggregate "AgentRun" do
      description "One brief handed to a background Claude session: started and tracked, or refused with the reason."

      attribute :run,       RunKey
      attribute :repo,      Path
      attribute :brief,     Brief
      attribute :agent,     AgentName, optional: true
      attribute :works_as,  Part,      optional: true
      attribute :session,   SessionId, optional: true
      # The session the run last moved off: the one a fork superseded (`Fork`) or a rebind left
      # (`Rebound`); empty while the run has kept its first session.
      attribute :forked_from, SessionId, optional: true
      attribute :started_at, Moment,   optional: true
      attribute :condition, Condition, optional: true
      attribute :refusal,   Report,    optional: true
      attribute :tidied_at, Moment,    optional: true
      attribute :answered_at, Moment,  optional: true
      attribute :detail,    Report,    optional: true
      attribute :work,      WorkSlug,  optional: true
      attribute :trial,     Trial,     optional: true
      attribute :resuming,  Resuming,  optional: true
      attribute :reviewing, Reviewing, optional: true
      attribute :shedding,  Shedding,  optional: true
      attribute :kept_at,   Instant,   optional: true
      attribute :review_wait, Wait,    optional: true
      # The run whose reaction dispatched this one, so a fan-out's depth can be read; empty when no
      # run dispatched it (a Work item's coder, a hand dispatch, a planner). It is a run key, never
      # a Work item: `work` stays the Work item a run serves.
      attribute :parent,    RunKey,    optional: true
      identified_by :run
      acknowledges :key_by_value, "the key of the run that dispatched this one, which a hand-started session has none of, so a reference would refuse every review a hand-started coder asks for", of: :parent

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      # The Work item a run serves when its key is not the Work item's own, as a review's is not.
      value_object "WorkSlug" do
        attribute :value, String, matches: :present
      end

      # The run of the judge whose verdict an answer carries, so the outcome names the verdict it delivers.
      value_object "VerdictKey", String

      # Whether the run is a test run, one whose key starts `live-` or `resume-`. It is set when the
      # run retires itself, so a trial run is told from a real one in the ledger.
      value_object "Trial", Boolean

      # Whether the look kept the run: its session is still listed, or could not be looked for. Only
      # the reaction to `AgentRunUnretired` sets it, so `Retired` refuses a kept run by name.
      value_object "Kept", Boolean

      # Whether an answer is on its way to the session. Delivering one stops the session and wakes
      # it again, so a job that reads `stopped` meanwhile is the answer's own stop, not the
      # session's end. `Answer` sets it; `Answered` and `Unanswered` clear it.
      value_object "Resuming", Boolean

      # Whether a plan review the run asked for is open. A coder that asked for one ended its turn to
      # be resumed with the verdict, so while it is set no reading of the job ends the run: the
      # verdict can always reach it. `Await` sets it when the review is requested; `Answered` and
      # `Unanswered` clear it. Every end of a review reaches one of them: a verdict, an unstarted
      # review, and an architect run that failed or was retired (`Agents` unstarts its review).
      # A verdict whose resume the session refused leaves it set (`Unresumed`): the verdict is sent
      # again each sweep, and once its tries are spent the run is finished `unanswered`
      # (`FinishTheCoderWhoseVerdictWasAbandoned`), so a waiting run always ends.
      value_object "Reviewing", Boolean

      # Whether the run's session was asked to yield its work item because the load rose (`Shed`).
      # The run owns the fact: it stands until the run ends, which the yield brings about, so a run
      # is asked once and a look at the started runs counts the ones still shedding.
      value_object "Shedding", Boolean

      # The directory the session works in.
      value_object "Path" do
        attribute :value, String, matches: :not_empty
      end

      # What the session is asked to do. It may span lines; the dispatch refuses one that is blank.
      value_object "Brief", String

      # A custom agent's name. It starts with a letter or digit, so it cannot be taken for a flag.
      value_object "AgentName" do
        attribute :value, String, pattern: '\A[A-Za-z0-9][A-Za-z0-9._-]*\z'
      end

      # The part a run plays, recorded for display only. It is never passed as `--agent`: a pinned
      # definition would change the session's model and tools, and a resume would start a copy.
      value_object "Part" do
        attribute :value, String, pattern: '\A[A-Za-z0-9][A-Za-z0-9._-]*\z'
      end

      value_object "SessionId" do
        attribute :value, String, matches: :present
      end

      # What a session reported about itself the last time it was asked, or `gone` once the run
      # was retired because its session is gone. The standing queries below say how to read it.
      value_object "Condition", String

      value_object "Report", String

      # The pinned role a run plays (Agents `PinnedRole`), empty when no row names its role.
      value_object "RoleName", String

      # When the outside removed a session, as the port reports it.
      value_object "Moment", String

      # When the tidy review kept the run, in epoch seconds. A released run reads zero.
      value_object "Instant" do
        attribute :value, Integer, default: 0
        invariant("an instant is not before the epoch") { !value.negative? }
      end

      # The seconds a kept run waits before the tidy review looks at it again.
      value_object "Wait" do
        attribute :value, Integer, default: 3600
        invariant("a wait is positive") { value.positive? }
      end

      # The directory a session works in, written with its trailing slash, so a watch that filters
      # on a checkout's directory matches the checkout and every worktree under it.
      value_object "Checkout", String

      lifecycle :status, default: "requested" do
        mark :failure, "refused"
        transition "Begin"   => "started",  from: "requested"
        transition "Decline" => "refused",  from: "requested"
        transition "Finish"  => "finished", from: "started"
        transition "Fail"    => "finished", from: "started"
        transition "Tidied"  => "tidied",   from: "finished"
        transition "Retired" => "retired",  from: ["started", "finished"]
        transition "RetireTrial" => "retired", from: "started"
        mark :terminal, "tidied", "refused", "retired"
        # A run that has ended frees its key: a dispatch under it starts a new run, and the ended
        # one stays readable as `<run>~<n>`, its attempt number. A run in no state declared here
        # frees its key too. A requested or started run, working or blocked, keeps its key, and a
        # second dispatch is refused by name.
        mark :reusable, "finished", "tidied", "refused", "retired"
      end

      command "Dispatch" do
        role "Operator"
        goal "Hand one brief to a background Claude session working in a directory"

        attribute :run,   RunKey, sets: true
        attribute :repo,  Path, optional: true, sets: true
        attribute :brief, Brief, sets: true
        attribute :agent, AgentName, optional: true, sets: true
        attribute :works_as, Part, optional: true, sets: true
        attribute :work,  WorkSlug, optional: true, sets: true
        attribute :parent, RunKey, optional: true, sets: true

        given("a brief says something") { !brief.value.to_s.strip.empty? }


        emits AgentRunRequested
      end

      command "Begin" do
        role "System"
        goal "Record the session the directory's agent started"

        reference_to AgentRun
        attribute :session, SessionId, sets: true
        attribute :started_at, Moment, optional: true, sets: true


        emits AgentRunStarted
      end

      command "Decline" do
        role "System"
        goal "Record why no session was started"

        reference_to AgentRun
        attribute :refusal, Report, sets: true


        emits AgentRunDeclined
      end

      # A check reads the job's own state and records a change as one of the four session events
      # below; a state that did not change records nothing.
      command "Check", from: "started" do
        role "Operator"
        goal "Read the state a started session's job is in, and record it when it changed"

        reference_to AgentRun

        emits AgentCheckRequested
      end

      command "Work", from: "started" do
        role "System"
        goal "Record that the session is working"

        reference_to AgentRun
        attribute :condition, Condition, sets: true
        attribute :checkout,  Checkout

        emits SessionWorking
      end

      command "Block", from: "started" do
        role "System"
        goal "Record that the session waits on a person, and the question it waits on"

        reference_to AgentRun
        attribute :condition, Condition, sets: true
        attribute :detail,    Report, sets: true
        attribute :checkout,  Checkout

        emits SessionBlocked
      end

      # `done` and `stopped` are a session's two ways of ending well; `failed` is `Fail`.
      command "Finish" do
        role "System"
        goal "Record that the session has ended, and how it ended"

        reference_to AgentRun
        attribute :condition, Condition, sets: true
        attribute :detail,    Report, sets: true
        attribute :checkout,  Checkout

        emits SessionFinished
      end

      command "Fail" do
        role "System"
        goal "Record that the session failed, and what it said"

        reference_to AgentRun
        attribute :condition, Condition, sets: true
        attribute :detail,    Report, sets: true
        attribute :checkout,  Checkout

        emits SessionFailed
      end

      # A finished run's session is removed when it ended `done` or `stopped`; a session
      # ended `abandoned` (a helper nobody answered) goes too; one still `working` or `blocked` on a
      # person is kept, and so is one a person has taken over (the port says so).
      #
      # A run the review kept (`Retain`) stays finished, and every reap sends `Tidy` for it. It is
      # refused here until its wait has passed, so a kept run is reviewed once per wait. `Release`
      # ends the wait early. `+` because a rule has no `-`: `now - kept_at >= review_wait`. A run
      # never kept holds neither and is reviewed at once; `nil?` is false in a rule: use `== nil`.
      command "Tidy", from: "finished" do
        role "Operator"
        goal "Remove the finished session of one run, unless it is still working, a coder waiting on a person, or taken over"

        reference_to AgentRun
        # `now:` is filled from the clock port; an explicit value wins.
        attribute :now, Instant
        needs :now

        given("the session ended done, stopped or abandoned: a working or blocked session is kept") do
          condition.value == "done" || condition.value == "stopped" || condition.value == "abandoned"
        end
        given("a kept run is reviewed again once its wait has passed") do
          kept_at.value == nil || review_wait.value == nil || kept_at.value + review_wait.value <= now.value
        end

        emits TidyRequested
      end

      command "Tidied" do
        role "System"
        goal "Record that the session was removed, and when"

        reference_to AgentRun
        attribute :tidied_at, Moment, sets: true


        emits AgentRunTidied
      end

      # Why the session was kept, when, and the seconds before `Tidy` reviews the run again.
      command "Retain" do
        role "System"
        goal "Record why a finished session was kept, when, and how long before it is reviewed again"

        reference_to AgentRun
        attribute :refusal, Report, sets: true
        attribute :review_wait, Wait, sets: true
        attribute :now, Instant
        needs :now

        sets :kept_at, to: :now

        emits AgentRunRetained
      end

      # Ends a kept run's wait, so the next reap reviews it. The landing of the run's branch does
      # it (`ReleaseTheRunWhoseWorkLanded`): its worktree and its Work have changed. A change the
      # ledger does not hear of, such as a person resuming the session or committing in the
      # worktree, is seen when the wait ends, or at once when a person runs this.
      command "Release", from: "finished" do
        role "Operator"
        goal "Review a kept run at the next reap, without waiting for its retry time"

        reference_to AgentRun

        sets :kept_at, to: { value: 0 }

        emits AgentRunReleased
      end

      command "Detach" do
        role "System"
        goal "Record that the run's worktree was retired, before its session is removed"

        reference_to AgentRun
        attribute :detail, Report, sets: true

        emits WorktreeDetached
      end

      # Answers a session that has not ended, working or blocked on a person. The session is looked
      # at first (`AnswerTheSessionWhereItIs` below): one in the middle of a turn takes the answer
      # through its inbox hook and keeps running, and one that is idle or gone is resumed with the
      # answer as its prompt, so it carries on under the same ID. A running session is never stopped
      # to be answered. A `step`, when one is given, leads the answer: what the session does next.
      command "Answer", from: "started" do
        role "Operator"
        goal "Answer a session that has not ended: deliver to a working one, resume an idle one"

        reference_to AgentRun
        attribute :answer, Brief
        attribute :step, Brief, default: ""
        attribute :verdict, VerdictKey, default: ""
        attribute :resuming, Resuming, default: true, sets: true

        given("the answer says something") { !answer.value.to_s.strip.empty? }

        emits AnswerRequested
      end

      # Shedding load is cooperative: the session is asked, through `Answer`, to commit, run nothing
      # heavy and yield its work item (`AskTheShedRunToYield` below). Nothing is stopped or paused.
      command "Shed", from: "started" do
        role "System"
        goal "Ask a started run's session to yield its work item because the load rose"

        reference_to AgentRun

        given("a run asked to yield is not asked again") { shedding != true }

        sets :shedding, to: true

        emits LoadYieldAsked
      end

      command "Await", from: "started" do
        role "System"
        goal "Record that a plan review the run asked for is open, so no reading of the job ends the run"

        reference_to AgentRun
        attribute :reviewing, Reviewing, default: true, sets: true

        emits ReviewAwaited
      end

      command "Answered" do
        role "System"
        goal "Record when the answer reached the session: queued for a working one, or resumed into an idle one"

        reference_to AgentRun
        attribute :answered_at, Moment, sets: true
        attribute :session,     SessionId, sets: true
        attribute :verdict,     VerdictKey, default: ""
        attribute :resuming,    Resuming, default: false, sets: true
        attribute :reviewing,   Reviewing, default: false, sets: true

        emits AgentRunAnswered
      end

      # An answer's resume started a copy of the session, so the run now follows the copy
      # (`Answered` re-points it). The session it held is kept as `forked_from`, and
      # `ResumedAsFork` names both.
      command "Fork" do
        role "System"
        goal "Record that an answer's resume started a copy, naming the session the run held and the copy"

        reference_to AgentRun
        attribute :forked_from, SessionId, sets: true
        attribute :session,     SessionId
        attribute :pinned_role, RoleName, default: ""

        emits ResumedAsFork
      end

      # The session is looked at first (`BindTheRunToTheLiveSession` below). The session the run
      # held is kept as `forked_from`, so the board's role chip reads the run's current session.
      command "Rebind", from: "started" do
        role "Operator"
        goal "Move a started run to a named live session that no other started run holds"

        reference_to AgentRun
        attribute :session, SessionId

        emits RebindRequested
      end

      command "Rebound" do
        role "System"
        goal "Record the live session a rebind moved the run to, keeping the one it held"

        reference_to AgentRun
        attribute :session,     SessionId, sets: true
        attribute :forked_from, SessionId, sets: true

        emits AgentRunRebound
      end

      # A refused rebind leaves the run where it was, started on the session it held.
      command "RefuseRebind" do
        role "System"
        goal "Record why the run was not moved to the named session"

        reference_to AgentRun
        attribute :refusal, Report, sets: true

        emits RebindDeclined
      end

      # An answer's resume woke the session the run held, under its own id.
      command "ResumeInPlace" do
        role "System"
        goal "Record that an answer's resume woke the run's own session in place"

        reference_to AgentRun
        attribute :session, SessionId

        emits ResumedInPlace
      end

      command "Unanswered" do
        role "System"
        goal "Record why the answer did not reach the session"

        reference_to AgentRun
        attribute :refusal, Report, sets: true
        attribute :verdict, VerdictKey, default: ""
        attribute :resuming, Resuming, default: false, sets: true
        attribute :reviewing, Reviewing, default: false, sets: true

        emits AgentRunUnanswered
      end

      # A verdict's resume was refused while the run waits on it. The run keeps waiting (`reviewing`
      # stays as it was), so no reading of its idle job ends it; the verdict is sent again
      # (`Agents` `Verdict.Redeliver`) until the session takes it or the tries are spent.
      command "Unresumed" do
        role "System"
        goal "Record that the session refused a verdict's resume, and keep the run waiting on it"

        reference_to AgentRun
        attribute :refusal, Report, sets: true
        attribute :verdict, VerdictKey
        attribute :resuming, Resuming, default: false, sets: true

        emits AgentRunUnresumed
      end

      # A verdict came for a run that has finished. Only the run that holds the key takes it: a run
      # an earlier attempt left as `<run>~<n>` is not addressed by the key, so a restarted Work item
      # whose new run is answered records no refusal for its earlier attempt.
      command "Unreached", from: "finished" do
        role "System"
        goal "Record that a verdict came for a coder run that had already finished"

        reference_to AgentRun
        attribute :verdict, VerdictKey
        attribute :refusal, Report

        emits AgentRunUnreached
      end

      # A verdict came for a coder run tidied, retired or never started, which neither `Answer`
      # (started) nor `Unreached` (finished) takes. A requested run is left alone: it starts next.
      command "RefuseAnswer", from: ["tidied", "retired", "refused"] do
        role "System"
        goal "Record that a verdict came for a coder run whose session is gone or was never started"

        reference_to AgentRun
        attribute :verdict, VerdictKey
        attribute :refusal, Report

        emits AnswerRefused
      end

      # Closes a run still recorded started whose session is gone: `claude agents` no longer lists
      # it, so no check can read it and the ledger would list it as started for ever. A session
      # still listed is kept: a finished one is tidied, a live one answered, and a plain session is
      # removed with `PlainSession.Remove`.
      command "Retire", from: "started" do
        role "Operator"
        goal "Close a started run whose session is gone, so the ledger stops listing it as started"

        reference_to AgentRun

        emits AgentRunRetireRequested
      end

      # A run the look kept (`Unretired`) is sent here once more, marked `kept`, and refused: the
      # refusal is the reaction's own, so `retire! --wait` exits refused with the sentence below and
      # the run keeps the listing's words as its `refusal`.
      command "Retired" do
        role "System"
        goal "Record that the run was closed because its session is gone, and what the listing said"

        reference_to AgentRun
        attribute :detail, Report, sets: true
        attribute :condition, Condition, default: "gone", sets: true
        attribute :kept, Kept, default: false

        given("a run whose session is still listed, or could not be looked for, is not retired: answer it, stop it, or let its check end a helper blocked past the window") do
          kept != true
        end

        emits AgentRunRetired
      end

      # A trial run has no person to answer it and no work to finish, so it is closed once its
      # session is seen working or blocked, whether or not the session is still listed.
      command "RetireTrial" do
        role "System"
        goal "Close a trial run whose session is working or blocked, and flag the run as a trial"

        reference_to AgentRun
        attribute :trial,  Trial, default: true, sets: true
        attribute :detail, Report, sets: true
        attribute :condition, Condition, default: "gone", sets: true

        emits AgentTrialRunRetired
      end

      command "Unretired" do
        role "System"
        goal "Record why a run was not retired: its session is still listed, or could not be looked for"

        reference_to AgentRun
        attribute :refusal, Report, sets: true

        emits AgentRunUnretired
      end

      query "Tidyable" do
        description "Every finished run, oldest key first; `Tidy` keeps those that did not end done, stopped or abandoned, and refuses one the review kept until its wait has passed."
        where(status: "finished")
        order_by :run
      end

      query "Running" do
        description "Every run whose session was started and is not known to have ended, oldest key first, each with the run that dispatched it (`parent`) when one did."
        where(status: "started")
        order_by :run
      end

      # The one run under a key while it is started, so a reaction that ends it fires nothing for a
      # run that has already ended or was never dispatched.
      query "StartedOfRun" do
        description "The run under one key, when it is started."
        attribute :run, RunKey
        where(status: "started", run: :run)
      end

      # A run's standing (working, blocked, ended, gone) is read from these four, never from
      # `condition` alone: an ended run keeps the condition it ended with.
      query "Working" do
        description "Every started run whose session is not waiting on a person, oldest key first; its standing is working."
        where(status: "started", condition: { ne: "blocked" })
        order_by :run
      end

      query "Blocked" do
        description "Every started run whose session waits on a person, oldest key first."
        where(status: "started", condition: "blocked")
        order_by :run
      end

      # The started runs that answer a question: at most two, as the answer desk seats two, so an
      # answerer reads its own run, newest first, and the blocked run its work names, in one small read.
      query "Answering" do
        description "Every started run that answers a blocked run's question, its work the run that asks."
        where(status: "started", works_as: "answerer")
        order_by :started_at, :desc
      end

      query "Ended" do
        description "Every run whose session ended, finished or tidied, oldest key first."
        where(status: { in: "finished,tidied" })
        order_by :run
      end

      query "Gone" do
        description "Every run retired because its session is gone, oldest key first."
        where(status: "retired")
        order_by :run
      end

      query "Declined" do
        description "Every run that no session was started for, with the reason."
        where(status: "refused")
        order_by :run
      end
    end

    # One check of every run still started, for a driver that watches sessions. The launcher also
    # answers it as `agent_run.check_all!`.
    aggregate "SessionSweep" do
      description "One check of every started run's session: each change of state is recorded on its run."

      attribute :run, SweepKey
      attribute :finding, SweepFinding, optional: true
      identified_by :run

      value_object "SweepKey" do
        attribute :value, String, matches: :present
      end

      # What a sweep found wrong beyond any one run, as a pinned role with two live sessions.
      value_object "SweepFinding", String

      command "CheckAll" do
        role "Operator"
        goal "Check every run whose session was started and is not known to have ended"

        attribute :run, SweepKey, sets: true

        emits SweepRequested
      end

      command "Find" do
        role "System"
        goal "Record that a pinned role has more than one live session"

        reference_to SessionSweep
        attribute :finding, SweepFinding, sets: true

        emits PinnedRoleDoubled
      end
    end

    # Filling the Work queue is one run too: the Work items that may start a session now are chosen
    # from the queue, the machine's load and the freeze, and without `confirm` that is all it does.
    # The choosing and the starting are the port's; whether a start is allowed stays with `Work`.
    aggregate "Dispatch" do
      description "One filling of the Work queue: the planned Work items that start a session now, and why each other waits."

      attribute :run,            DispatchKey
      attribute :repo,           Directory
      attribute :confirm,        Switch, optional: true
      attribute :budget_minutes, Minutes, optional: true
      attribute :only,           Prefix, optional: true
      attribute :report,         Outcome, optional: true
      attribute :refusal,        Outcome, optional: true
      identified_by :run

      value_object "DispatchKey" do
        attribute :value, String, matches: :present
      end

      value_object "Directory" do
        attribute :value, String, matches: :not_empty
      end

      value_object "Switch", Boolean

      value_object "Minutes" do
        attribute :value, Integer
        invariant("a time budget is positive") { value.positive? }
      end

      # The start of a work item's key that a filling is held to.
      value_object "Prefix" do
        attribute :value, String, matches: :present
      end

      value_object "Outcome", String

      lifecycle :status, default: "requested" do
        mark :failure, "refused"
        transition "Record"  => "answered", from: "requested"
        transition "Decline" => "refused",  from: "requested"
        mark :terminal, "answered", "refused"
      end

      command "Fill" do
        role "Operator"
        goal "Choose the planned Work items that start a session now and, with confirm, start them; without it, say what would start"

        attribute :run,            DispatchKey, sets: true
        attribute :repo,           Directory, sets: true
        attribute :budget_minutes, Minutes, optional: true, sets: true
        attribute :confirm,        Switch, optional: true, sets: true
        # Only the planned work items whose key starts with this are chosen, so one item, or one
        # family of them, can be started on its own. It is set on the record, and the ask reads it
        # from the record it is handed, so the policy does not carry it in its `with:`.
        attribute :only,           Prefix, optional: true, sets: true

        emits FillRequested
      end

      command "Settle" do
        role "Operator"
        goal "Check the started sessions and finish the Work item of each that is done, or yield the Work item of one that stopped"

        attribute :run,  DispatchKey, sets: true
        attribute :repo, Directory, sets: true

        emits SettleRequested
      end

      command "Record" do
        role "System"
        goal "Record what the filling or settling did"

        reference_to Dispatch
        attribute :report, Outcome, sets: true

        emits DispatchAnswered
      end

      command "Decline" do
        role "System"
        goal "Record why the queue could not be read"

        reference_to Dispatch
        attribute :refusal, Outcome, sets: true

        emits DispatchDeclined
      end

      query "Preview" do
        description "What a filling would start now and why each other waits, read without filling: the same report as `Fill`, with no record and no start."
        attribute :repo,           Directory, optional: true
        attribute :budget_minutes, Minutes, optional: true
        attribute :only,           Prefix, optional: true
        returns Document
      end
    end

    policy "ChooseWhenFilling" do
      on      "Dispatch.FillRequested"
      ask     :choose, with: { run: :run }
    end

    policy "ConcludeWhenSettling" do
      on      "Dispatch.SettleRequested"
      ask     :conclude, with: { run: :run }
    end

    policy "RecordTheDispatch" do
      on      "Dispatch.DispatchReported"
      trigger Dispatch::Record, with: { report: :report }
    end

    policy "RecordTheDeclinedDispatch" do
      on      "Dispatch.DispatchRefused"
      trigger Dispatch::Decline, with: { refusal: :refusal }
    end

    # Tickets' `sweep` items (wording, renames, comments, docs) are done by one coder as one batch.
    # A reading brings facts only; the givens and policies below compose or hold.
    aggregate "SweepBatch" do
      description "One reading of the waiting sweep items: composed into one batch work item once enough wait or the oldest has waited long enough, held otherwise."
      created_by "SweepBatch.Read"

      attribute :batch,    BatchKey
      attribute :waiting,  SweepCount
      attribute :size,     SweepCount
      attribute :waited,   SweepHours
      attribute :patience, SweepHours
      attribute :title,    BatchText, optional: true
      attribute :brief,    BatchText, optional: true
      attribute :area,     list_of(BatchPath), optional: true
      identified_by :batch

      # The key the batch work item is planned under.
      value_object "BatchKey" do
        attribute :value, String, matches: :present
      end

      value_object "SweepCount", Integer
      value_object "SweepHours", Integer
      value_object "BatchText", String

      # A path a member says it edits, which the batch work item claims.
      value_object "BatchPath" do
        attribute :value, String, matches: :present
      end

      lifecycle :status, default: "read" do
        transition "Compose" => "composed", from: "read"
        transition "Hold"    => "held",     from: "read"
        mark :terminal, "composed", "held"
        # A reading is decided by the policies below as it is recorded: nothing waits there.
        mark :rests, "read"
      end

      command "Read" do
        role "System"
        goal "Record what the waiting sweep items are: how many, how long the oldest has waited, and the batch they would make"

        attribute :batch,    BatchKey, sets: true
        attribute :waiting,  SweepCount, sets: true
        attribute :size,     SweepCount, sets: true
        attribute :waited,   SweepHours, sets: true
        attribute :patience, SweepHours, sets: true
        attribute :title,    BatchText, optional: true, sets: true
        attribute :brief,    BatchText, optional: true, sets: true
        attribute :area,     list_of(BatchPath), optional: true, sets: true, default: []

        emits "SweepRead"
      end

      command "Compose" do
        role "System"
        goal "Make the waiting sweep items one batch, for one coder"

        reference_to SweepBatch
        attribute :title, BatchText, sets: true
        attribute :brief, BatchText, sets: true
        attribute :area,  list_of(BatchPath), optional: true, sets: true, default: []

        given("a batch has a member") { waiting >= 1 }
        given("a batch is full or its oldest member has waited long enough") { waiting >= size || waited >= patience }

        emits "SweepBatchComposed"
      end

      command "Hold" do
        role "System"
        goal "Leave the waiting sweep items waiting: too few, and none has waited long enough"

        reference_to SweepBatch

        emits "SweepBatchHeld"
      end
    end

    policy "ComposeWhenTheSweepIsFull" do
      on      "SweepBatch.SweepRead"
      where   { waiting >= 1 && (waiting >= size || waited >= patience) }
      trigger SweepBatch::Compose, with: { batch: :batch, title: :title, brief: :brief, area: :area }
    end

    policy "HoldWhenTheSweepIsShort" do
      on      "SweepBatch.SweepRead"
      where   { waiting < 1 || (waiting < size && waited < patience) }
      trigger SweepBatch::Hold, with: { batch: :batch }
    end

    # Planned Work items start by themselves: a reaction to an event that frees capacity or adds work
    # runs one filling (`Dispatch.Fill`'s choice, confirmed), so nobody calls Fill. The choice, its
    # guards and its priority order are the `Dispatching` port's; the owner's switch is read by
    # `RollSwitch` before a roll is requested, and an unchanged roll is recorded as a refusal.
    aggregate "Roll" do
      description "One rolling fill of the Work queue, started by an event rather than a person."

      attribute :run,     RollKey
      attribute :report,    RollOutcome, optional: true
      attribute :refusal,   RollOutcome, optional: true
      attribute :held_back, HeldBack, optional: true
      identified_by :run

      value_object "RollKey" do
        attribute :value, String, matches: :present
      end

      value_object "RollOutcome", String

      # One when the fill left planned work waiting on the boot budget, the load or a pause, else zero.
      value_object "HeldBack", Integer

      lifecycle :status, default: "requested" do
        mark :failure, "refused"
        transition "Record"  => "answered", from: "requested"
        transition "Decline" => "refused",  from: "requested"
        mark :terminal, "answered", "refused"
      end

      command "Start" do
        role "System"
        goal "Fill the queue now because capacity freed or work arrived"

        attribute :run, RollKey, sets: true

        emits RollRequested
      end

      command "Record" do
        role "System"
        goal "Record what the rolling fill started"

        reference_to Roll
        attribute :report,    RollOutcome, sets: true
        attribute :held_back, HeldBack, sets: true

        emits RollAnswered
      end

      command "Decline" do
        role "System"
        goal "Record why the rolling fill started nothing"

        reference_to Roll
        attribute :refusal, RollOutcome, sets: true

        emits RollDeclined
      end
    end

    # The `Rolling` port answers what the Tickets world's `dispatch_roll_forward` says now and the
    # pause the record holds; the policies decide. The world is read at every consult, so the first
    # event after the owner turns the switch on rolls, with no restart.
    aggregate "RollSwitch" do
      description "The owner's roll-forward switch as the pipeline last read it, one record per store. Each event that would roll the queue consults it: on, a roll starts; off, no roll is requested, and the first consult of a pause records RollPaused once, the first after it RollResumed."

      attribute :switch, SwitchKey
      attribute :paused, Standing
      attribute :reason, PauseReason, optional: true
      identified_by :switch

      value_object "SwitchKey" do
        attribute :value, String, matches: :present
      end

      # One while the pause is recorded, zero while rolls run.
      value_object "Standing" do
        attribute :value, Integer, default: 0
        invariant("a pause stands or it does not") { [0, 1].include?(value) }
      end

      value_object "PauseReason", String

      command "Open" do
        role "System"
        goal "Open the one switch record of a store, with no pause recorded"

        attribute :switch, SwitchKey, sets: true

        emits RollSwitchOpened
      end

      command "Consult" do
        role "System"
        goal "Ask whether the owner lets the queue roll, for the event that would roll it"

        reference_to RollSwitch
        attribute :run, SwitchKey

        emits RollSwitchConsulted
      end

      command "Pause" do
        role "System"
        goal "Record once that the owner has paused rolling, and why nothing starts"

        reference_to RollSwitch
        attribute :reason, PauseReason, sets: true

        given("the pause is not recorded yet") { paused.value == 0 }

        sets :paused, to: { value: 1 }

        emits RollPaused
      end

      command "Resume" do
        role "System"
        goal "Record that the owner turned rolling back on"

        reference_to RollSwitch

        given("a pause is recorded") { paused.value == 1 }

        sets :paused, to: { value: 0 }

        emits RollResumed
      end
    end

    # A merge window quiets the pipeline so a train merges without competing work: opened, it pauses the
    # fill by its own record (the owner's switch is never edited) and the `Quieting` port stops what runs.
    # One record for each window, kept as the history of when the pipeline was held and why.
    aggregate "MergeWindow" do
      description "One merge window: opened to let a train merge without competing work, closed when it has merged or by hand."

      attribute :run,       WindowKey
      attribute :reason,    WindowText, optional: true
      attribute :opened_by, WindowText, optional: true
      attribute :quieted,   WindowText, optional: true
      attribute :refusal,   WindowText, optional: true
      identified_by :run

      value_object "WindowKey" do
        attribute :value, String, matches: :present
      end

      value_object "WindowText", String

      lifecycle :status, default: "open" do
        transition "Close" => "closed", from: "open"
        mark :terminal, "closed"
      end

      command "Open" do
        role "Operator"
        goal "Open a merge window: pause the fill and quiet the pipeline until the window closes"

        attribute :run,       WindowKey, sets: true
        attribute :reason,    WindowText, sets: true
        attribute :opened_by, WindowText, sets: true

        emits WindowOpened
      end

      command "Record" do
        role "System"
        goal "Record what quieting the pipeline stopped, ended and left running"

        reference_to MergeWindow
        attribute :quieted, WindowText, sets: true

        emits WindowQuieted
      end

      command "Decline" do
        role "System"
        goal "Record why the pipeline could not be quieted"

        reference_to MergeWindow
        attribute :refusal, WindowText, sets: true

        emits WindowQuietDeclined
      end

      command "Close" do
        role "Operator"
        goal "Close the merge window so the fill runs again"

        reference_to MergeWindow

        given("the window is open") { status == "open" }

        emits WindowClosed
      end
    end

    # The slow backstop: a clock adapter on the `clock` port beats, and a beat rolls the queue forward.
    aggregate "Heartbeat" do
      description "One beat of the clock, which the bluebook reads as an event and never as a time."

      attribute :beat, BeatKey
      attribute :refusal, BeatNote, optional: true
      identified_by :beat

      value_object "BeatKey" do
        attribute :value, String, matches: :present
      end

      value_object "BeatNote", String

      lifecycle :status, default: "requested" do
        mark :failure, "declined"
        transition "Record"  => "beaten",   from: "requested"
        transition "Decline" => "declined", from: "requested"
        mark :terminal, "beaten", "declined"
      end

      command "Beat" do
        role "System"
        goal "Ask for one beat of the clock, which is taken only when no other beat is running"

        attribute :beat, BeatKey, sets: true

        emits BeatRequested
      end

      command "Record" do
        role "System"
        goal "Record that the clock beat, the one beat running"

        reference_to Heartbeat

        emits Beaten
      end

      command "Decline" do
        role "System"
        goal "Record why the clock did not beat: another beat was still running"

        reference_to Heartbeat
        attribute :refusal, BeatNote, sets: true

        emits BeatDeclined
      end
    end

    # One beat runs at a time. The `Beating` port holds the place and answers it taken, or refuses
    # it naming the beat that holds it; only a taken beat is recorded as `Beaten`, so no policy
    # that hears `Beaten` runs for a beat that was refused.
    policy "TakeTheBeat" do
      on      "Heartbeat.BeatRequested"
      ask     :take, with: { beat: :beat }
    end

    policy "RecordTheBeatTaken" do
      on      "Heartbeat.BeatTaken"
      trigger Heartbeat::Record
    end

    policy "DeclineTheBeatUntaken" do
      on      "Heartbeat.BeatUntaken"
      trigger Heartbeat::Decline, with: { refusal: :refusal }
    end

    # Each clock beat begins Signalbox's pressure beat, which publishes the one pressure signal
    # (ADR 0222, phase 3b). A root, so the pressure beat's chain is its own and a fault in it never
    # holds the clock's other beats.
    policy "SignalThePressureOnTheBeat" do
      on   "Heartbeat.Beaten"
      root
      ask  :signal, with: { beat: :beat }
    end

    # A queued train pull request needs the clock beaten until it merges, and nothing else beats it.
    # One chain of ticks starts per boarded commit (a second start under the key is refused), and
    # each tick is a short dispatch of its own that beats `Heartbeat`, so no dispatch is held open.
    # The domain ends the chain: the pull request merged, the beats ran past the limit the port
    # reported, or the port declined to start. The `Ticking` port only starts a detached process
    # that sleeps the reported period and dispatches `Ticker.Tick`; it holds no stage rule.
    aggregate "Ticker" do
      description "One chain of ticks that beats the clock for a queued train pull request until it ends."

      attribute :run,    TickerKey
      attribute :tick,   TickerKey, optional: true
      attribute :beats,  Beats, optional: true
      attribute :limit,  Beats, optional: true
      attribute :ending, TickerNote, optional: true
      identified_by :run

      value_object "TickerKey" do
        attribute :value, String, matches: :present
      end

      value_object "Beats", Integer

      value_object "TickerNote", String

      lifecycle :status, default: "requested" do
        mark :failure, "refused"
        transition "Begin"   => "ticking", from: "requested"
        transition "Decline" => "refused", from: "requested"
        transition "Stop"    => "ended", from: %w[requested ticking]
        mark :terminal, "refused", "ended"
      end

      command "Start" do
        role "System"
        goal "Record that a queued train pull request wants the clock beaten until it ends"

        attribute :run, TickerKey, sets: true

        emits TickerRequested
      end

      command "Begin" do
        role "System"
        goal "Record that the chain of ticks started, and how many beats it is allowed"

        reference_to Ticker
        attribute :limit, Beats, sets: true

        emits TickerBegun
      end

      command "Decline" do
        role "System"
        goal "Record why no chain of ticks started"

        reference_to Ticker
        attribute :ending, TickerNote, sets: true

        emits TickerDeclined
      end

      command "Tick", from: "ticking" do
        role "System"
        goal "Record one tick of the chain, refused once the chain is over or its beats are spent"

        reference_to Ticker
        attribute :tick,  TickerKey, sets: true
        attribute :beats, Beats, sets: true

        given("the beats are within the limit") { beats.value <= limit.value }

        emits Ticked
      end

      command "Stop" do
        role "System"
        goal "Record that the chain of ticks is over, and why"

        reference_to Ticker
        attribute :ending, TickerNote, sets: true

        emits TickerStopped
      end
    end

    policy "TickWhenQueued" do
      on      "SendTrain.BoardingQueued"
      root
      trigger Ticker::Start, with: { run: :boarded }
    end

    policy "OpenTickerWhenRequested" do
      on      "Ticker.TickerRequested"
      ask     :open, with: { run: :run }
    end

    policy "BeginWhenOpened" do
      on      "Ticker.TickerOpened"
      trigger Ticker::Begin, with: { limit: :limit }
    end

    policy "DeclineWhenUnopened" do
      on      "Ticker.TickerUnopened"
      trigger Ticker::Decline, with: { ending: :refusal }
    end

    # The chain ends on any verdict of the pull request: merged, its checks failed, or closed.
    policy "StopTickingWhenMerged" do
      on      "Integration.TrainMergeSeen"
      root
      trigger Ticker::Stop, with: { run: :landed, ending: :report }
    end

    policy "StopTickingWhenChecksFail" do
      on      "Integration.CiFailed"
      root
      trigger Ticker::Stop, with: { run: :landed, ending: :report }
    end

    # A train pull request whose checks failed past the reruns is given to a coder as a red-train
    # Work item; nothing more is watched for it, so the chain ends (`Integration.CiFailed` is the
    # verdict of CI on main, which a pull request that never merged does not reach).
    policy "StopTickingWhenTrainPrExhausted" do
      on      "TrainPr.TrainPrExhausted"
      root
      trigger Ticker::Stop, with: { run: :landed, ending: :detail }
    end

    policy "StopTickingWhenClosed" do
      on      "Integration.PullRequestClosed"
      root
      trigger Ticker::Stop, with: { run: :landed, ending: :report }
    end

    policy "BeatOnTick" do
      on      "Ticker.Ticked"
      root
      trigger Heartbeat::Beat, with: { beat: :tick }
    end

    # The idle backstop for work a roll held back; a tick rolls itself, with no `Wake` beat to ask.
    aggregate "Idler" do
      description "The one chain of idle ticks of a store, started by a roll that held planned work back (boot budget, load, a pause) when no pull request's chain beats. Start is refused while a chain stands; each tick rolls through the owner's switch, and the world's idles minutes end the chain."

      attribute :idler,    IdlerKey
      attribute :standing, IdleStanding
      attribute :tick,     IdlerKey, optional: true
      attribute :beats,    IdleBeats, optional: true
      attribute :limit,    IdleBeats, optional: true
      attribute :ending,   IdlerNote, optional: true
      identified_by :idler

      value_object "IdlerKey" do
        attribute :value, String, matches: :present
      end

      # One while a chain stands, zero while none does.
      value_object "IdleStanding" do
        attribute :value, Integer, default: 0
        invariant("a chain stands or it does not") { [0, 1].include?(value) }
      end

      value_object "IdleBeats", Integer

      value_object "IdlerNote", String

      command "Keep" do
        role "System"
        goal "Open the one idler record of a store, with no chain standing"

        attribute :idler, IdlerKey, sets: true

        emits IdlerKept
      end

      command "Start" do
        role "System"
        goal "Record that planned work is held back and an idle chain of ticks is wanted"

        reference_to Idler

        given("no chain stands") { standing.value == 0 }

        sets :standing, to: { value: 1 }

        emits IdlerRequested
      end

      command "Begin" do
        role "System"
        goal "Record that the chain of ticks started, and how many beats it is allowed"

        reference_to Idler
        attribute :limit, IdleBeats, sets: true

        sets :beats, to: { value: 0 }

        emits IdlerBegun
      end

      command "Decline" do
        role "System"
        goal "Record why no chain of ticks started"

        reference_to Idler
        attribute :ending, IdlerNote, sets: true

        given("a chain stands") { standing.value == 1 }

        sets :standing, to: { value: 0 }

        emits IdlerDeclined
      end

      command "Tick" do
        role "System"
        goal "Record one idle tick, refused once the chain is over or its beats are spent"

        reference_to Idler
        attribute :tick,  IdlerKey, sets: true
        attribute :beats, IdleBeats, sets: true

        given("a chain stands") { standing.value == 1 }
        given("the beats are within the limit") { beats.value <= limit.value }

        emits IdleTicked
      end

      command "Stop" do
        role "System"
        goal "Record that the chain of idle ticks is over, and why"

        reference_to Idler
        attribute :ending, IdlerNote, sets: true

        given("a chain stands") { standing.value == 1 }

        sets :standing, to: { value: 0 }

        emits IdlerStopped
      end
    end

    policy "KeepTheIdlerWhenWorkIsHeldBack" do
      on      "Roll.RollAnswered"
      where   { held_back == 1 }
      trigger Idler::Keep, with: { idler: "idle" }
    end

    policy "IdleWhenWorkIsHeldBack" do
      on      "Roll.RollAnswered"
      where   { held_back == 1 }
      trigger Idler::Start, with: { idler: "idle" }
    end

    policy "OpenIdlerWhenRequested" do
      on      "Idler.IdlerRequested"
      ask     :open, with: { idler: :idler }
    end

    policy "BeginIdlerWhenOpened" do
      on      "Idler.IdlerOpened"
      trigger Idler::Begin, with: { limit: :limit }
    end

    policy "DeclineIdlerWhenUnopened" do
      on      "Idler.IdlerUnopened"
      trigger Idler::Decline, with: { ending: :refusal }
    end

    policy "OpenTheRollSwitchWhenTheIdlerTicks" do
      on      "Idler.IdleTicked"
      trigger RollSwitch::Open, with: { switch: "rolls" }
    end

    policy "RollWhenTheIdlerTicks" do
      on      "Idler.IdleTicked"
      root
      trigger RollSwitch::Consult, with: { roll_switch: "rolls", run: :tick }
    end

    # The clock's other question: what became eligible with no event (a retry time passed, the boot
    # budget freed, a roll was refused mid-fill, or a slot is free that a filling would use). A roll
    # follows only when one did, so a quiet beat starts nothing; the `Waking` port reads the clock.
    aggregate "Wake" do
      description "One look, on a beat of the clock, at whether the clock alone made something eligible."

      attribute :run,     WakeKey
      attribute :reason,  WakeNote, optional: true
      attribute :refusal, WakeNote, optional: true
      identified_by :run

      value_object "WakeKey" do
        attribute :value, String, matches: :present
      end

      value_object "WakeNote", String

      lifecycle :status, default: "requested" do
        mark :failure, "quiet"
        transition "Hear"    => "due",   from: "requested"
        transition "Decline" => "quiet", from: "requested"
        mark :terminal, "due", "quiet"
      end

      command "Look" do
        role "System"
        goal "Ask whether the clock alone made something eligible to start"

        attribute :run, WakeKey, sets: true

        emits WakeRequested
      end

      command "Hear" do
        role "System"
        goal "Record why the queue should roll now"

        reference_to Wake
        attribute :reason, WakeNote, sets: true

        emits WakeHeard
      end

      command "Decline" do
        role "System"
        goal "Record that nothing became eligible by the clock"

        reference_to Wake
        attribute :refusal, WakeNote, sets: true

        emits WakeQuieted
      end
    end

    # A root, like the sampling and the sweep, so each beat's question begins its own chain.
    policy "WakeOnHeartbeat" do
      on      "Heartbeat.Beaten"
      root
      trigger Wake::Look, with: { run: :beat }
    end

    policy "NoticeWhenWaking" do
      on      "Wake.WakeRequested"
      ask     :notice, with: { run: :run }
    end

    policy "RecordWhatIsDue" do
      on      "Wake.WakeDue"
      trigger Wake::Hear, with: { reason: :reason }
    end

    policy "RecordTheQuietBeat" do
      on      "Wake.WakeQuiet"
      trigger Wake::Decline, with: { refusal: :refusal }
    end

    # The roll has its own key, made by the port, so a beat that is both due and moved does not ask
    # for two rolls under one key.
    policy "RollWhenSomethingIsDue" do
      on      "Wake.WakeDue"
      trigger Roll::Start, with: { run: :roll }
    end

    # The machine's load, heard instead of asked. Each beat of the clock takes one reading through the
    # `Sampling` port: the CPU idle percentage, swap used as a percentage of swap total, the compressor's
    # size in gigabytes and the load average (a third reading, which counts processes waiting on swap and
    # disk and so overstates CPU use), and the test lane's waiting count once that lane exists. The adapter
    # judges each against the marks in the Tickets world's `machine_marks` line and answers the state each
    # leaves and the state it stood in before. The policies below say what a crossing is: a state that
    # differs from the one before, so a reading inside the gap says nothing and a crossing is heard once.
    # The bluebook reads neither the clock nor the machine.
    aggregate "Machine" do
      description "One reading of the machine, and the crossings of a mark that it heard."

      attribute :run,           MachineKey
      attribute :cpu_idle,      Gauge, optional: true
      attribute :swap_used,     Gauge, optional: true
      attribute :compressor_gb, Gauge, optional: true
      attribute :load,          Gauge, optional: true
      attribute :lane_waiting,  Gauge, optional: true
      attribute :load_state,    Standing, optional: true
      attribute :memory_state,  Standing, optional: true
      attribute :lane_state,    Standing, optional: true
      # Where `load` was read (`uptime`, or `roundhouse` with the Tickets world's
      # `metering.roundhouse` switch on), and Roundhouse's metered load beside it either way, so the
      # two meters are read side by side before the switch turns (ADR 0222, phase 3, metering).
      attribute :source,        MachineNote, optional: true
      attribute :metered_load,  Gauge, optional: true
      # When the reading was taken (ISO-8601 UTC), stamped by the Sampling port's adapter: the
      # reading taken latest is the one whose states the next reading stands on.
      attribute :taken_at,      MachineNote, optional: true
      attribute :refusal,       MachineNote, optional: true
      identified_by :run

      value_object "MachineKey" do
        attribute :value, String, matches: :present
      end

      value_object "Gauge", Float

      # Where the last crossing left the machine: below or above, ok or low, idle or busy.
      value_object "Standing", String

      value_object "MachineNote", String

      # One class of process (the program's name) under one owner: how many run, their summed CPU
      # percentage, and the background session whose shell they run under (empty for none).
      value_object "ProcessClass" do
        attribute :name,    String
        attribute :count,   Integer
        attribute :cpu,     Float
        attribute :session, String
      end

      # Read-only: which process classes use the CPU and whose child they are, busiest first. It
      # stops nothing; the load stall's move reads it to find the session to ask.
      query "Busiest" do
        description "Which process classes use the CPU and whose child they are: each class's count, summed CPU percentage and the background session whose shell owns it, busiest first. Read-only: it stops no process and no session."
        returns list_of(ProcessClass)
      end

      lifecycle :status, default: "requested" do
        mark :failure, "unread"
        transition "Record"  => "read",   from: "requested"
        transition "Decline" => "unread", from: "requested"
        mark :terminal, "read", "unread"
      end

      command "Sample" do
        role "System"
        goal "Take one reading of the machine, at most once a minute"

        attribute :run, MachineKey, sets: true

        emits MachineSampleRequested
      end

      command "Record" do
        role "System"
        goal "Record the readings and the states they leave"

        reference_to Machine
        attribute :cpu_idle,      Gauge, optional: true, sets: true
        attribute :swap_used,     Gauge, optional: true, sets: true
        attribute :compressor_gb, Gauge, optional: true, sets: true
        attribute :load,          Gauge, optional: true, sets: true
        attribute :lane_waiting,  Gauge, optional: true, sets: true
        attribute :load_state,    Standing, sets: true
        attribute :memory_state,  Standing, sets: true
        attribute :lane_state,    Standing, sets: true
        attribute :source,        MachineNote, optional: true, sets: true
        attribute :metered_load,  Gauge, optional: true, sets: true
        attribute :taken_at,      MachineNote, optional: true, sets: true

        emits MachineRead
      end

      command "Decline" do
        role "System"
        goal "Record why the machine was not read"

        reference_to Machine
        attribute :refusal, MachineNote, sets: true

        emits MachineUnread
      end

      command "FallBelow" do
        role "System"
        goal "Hear the load fall under its low mark"

        reference_to Machine

        emits LoadFellBelow
      end

      command "RiseAbove" do
        role "System"
        goal "Hear the load rise over its high mark"

        reference_to Machine

        emits LoadRoseAbove
      end

      command "RunLow" do
        role "System"
        goal "Hear memory run low: swap used or the compressor passed its mark"

        reference_to Machine

        emits MemoryLow
      end

      command "Recover" do
        role "System"
        goal "Hear memory recover: swap used fell under its recovery mark"

        reference_to Machine

        emits MemoryRecovered
      end

      command "GoBusy" do
        role "System"
        goal "Hear the test lane's queue pass its busy mark"

        reference_to Machine

        emits TestLaneBusy
      end

      command "GoIdle" do
        role "System"
        goal "Hear the test lane's queue fall to its idle mark"

        reference_to Machine

        emits TestLaneIdle
      end
    end

    policy "SampleOnHeartbeat" do
      on      "Heartbeat.Beaten"
      root
      trigger Machine::Sample, with: { run: :beat }
    end

    # The clock's beat is the timer that drives a sweep: every started run's session is checked once
    # per beat, so a session that ended or blocked is recorded without anyone asking. The beat's own key
    # keys the sweep, so one beat sweeps once. A root, so the sweep starts its own chain.
    policy "SweepOnHeartbeat" do
      on      "Heartbeat.Beaten"
      root
      trigger SessionSweep::CheckAll, with: { run: :beat }
    end

    policy "ReadTheMachine" do
      on      "Machine.MachineSampleRequested"
      ask     :read, with: { run: :run }
    end

    policy "RecordTheMachine" do
      on      "Machine.MachineSampled"
      trigger Machine::Record, with: { cpu_idle: :cpu_idle, swap_used: :swap_used, compressor_gb: :compressor_gb,
                                       load: :load, lane_waiting: :lane_waiting, load_state: :load_state,
                                       memory_state: :memory_state, lane_state: :lane_state, source: :source,
                                       metered_load: :metered_load, taken_at: :taken_at }
    end

    policy "RecordTheUnreadMachine" do
      on      "Machine.MachineUnreadable"
      trigger Machine::Decline, with: { refusal: :refusal }
    end

    policy "HearTheLoadFall" do
      on      "Machine.MachineSampled"
      root
      where   { load_state == "below" && load_before == "above" }
      trigger Machine::FallBelow, with: { machine: :id }
    end

    policy "HearTheLoadRise" do
      on      "Machine.MachineSampled"
      root
      where   { load_state == "above" && load_before != "above" }
      trigger Machine::RiseAbove, with: { machine: :id }
    end

    policy "HearMemoryRunLow" do
      on      "Machine.MachineSampled"
      root
      where   { memory_state == "low" && memory_before != "low" }
      trigger Machine::RunLow, with: { machine: :id }
    end

    policy "HearMemoryRecover" do
      on      "Machine.MachineSampled"
      root
      where   { memory_state == "ok" && memory_before == "low" }
      trigger Machine::Recover, with: { machine: :id }
    end

    policy "HearTheLaneBusy" do
      on      "Machine.MachineSampled"
      root
      where   { lane_state == "busy" && lane_before != "busy" }
      trigger Machine::GoBusy, with: { machine: :id }
    end

    policy "HearTheLaneIdle" do
      on      "Machine.MachineSampled"
      root
      where   { lane_state == "idle" && lane_before == "busy" }
      trigger Machine::GoIdle, with: { machine: :id }
    end

    # The fill that follows a reading. It runs after the reading is recorded, so it sees the state the
    # reading left: a fill that follows LoadFellBelow, MemoryRecovered or TestLaneIdle starts work, and
    # one that follows LoadRoseAbove or MemoryLow finds every item waiting "paused by load" or "memory
    # low". The reading's own key keys the roll, so one reading rolls once. Only a reading that moved a
    # state frees capacity rolls (the load fell, the memory recovered or the test lane went idle): a rise
    # or a beat that leaves the machine as it stood changes nothing a fill could act on, and the events
    # that free capacity or add work roll on their own. One policy keyed by the reading, so a reading
    # that crosses two marks rolls once.
    policy "RollWhenTheMachineMoves" do
      on      "Machine.MachineSampled"
      root
      where   {
        (load_state == "below" && load_before == "above") ||
          (memory_state == "ok" && memory_before == "low") ||
          (lane_state == "idle" && lane_before == "busy")
      }
      trigger RollSwitch::Consult, with: { roll_switch: "rolls", run: :id }
    end

    policy "OpenTheRollSwitchWhenTheMachineMoves" do
      on      "Machine.MachineSampled"
      trigger RollSwitch::Open, with: { switch: "rolls" }
    end

    aggregate "Overload" do
      description "The pipeline's own overload verdict, said by the readings alone. Each reading counts into " \
                  "three runs (over the load mark 20, under the load limit, memory low); the verdict stands " \
                  "after 5 over the mark or 3 low, and is lifted after 10 under the limit with memory ok. " \
                  "A record, not a switch: whatever fills the queue reads `standing`, and the owner's " \
                  "`RollSwitch` is never touched."

      attribute :overload,  OverloadKey
      attribute :standing,  Verdict
      attribute :heavy_run, Streak
      attribute :calm_run,  Streak
      attribute :low_run,   Streak
      attribute :reason,    OverloadReason, optional: true
      attribute :reading,   OverloadReason, optional: true
      identified_by :overload

      value_object "OverloadKey" do
        attribute :value, String, matches: :present
      end

      # One while the overload stands, zero while the pipeline adds work.
      value_object "Verdict" do
        attribute :value, Integer, default: 0
        invariant("an overload stands or it does not") { [0, 1].include?(value) }
      end

      # Consecutive readings of one kind.
      value_object "Streak" do
        attribute :value, Integer, default: 0
      end

      value_object "OverloadReason", String

      command "Open" do
        role "System"
        goal "Open the one overload record of a store, with no overload standing"

        attribute :overload, OverloadKey, sets: true

        emits OverloadOpened
      end

      command "Strain" do
        role "System"
        goal "Count a reading with the load over the overload mark: one more in the run"

        reference_to Overload

        sets :heavy_run, increment: { value: 1 }
        sets :calm_run,  to: { value: 0 }

        emits LoadStrained
      end

      command "Settle" do
        role "System"
        goal "Count a reading with the load under its limit: one more in the calm run"

        reference_to Overload

        sets :calm_run,  increment: { value: 1 }
        sets :heavy_run, to: { value: 0 }

        emits LoadSettled
      end

      command "Waver" do
        role "System"
        goal "Count a reading between the load limit and the overload mark: it breaks both runs"

        reference_to Overload

        sets :heavy_run, to: { value: 0 }
        sets :calm_run,  to: { value: 0 }

        emits LoadWavered
      end

      command "Starve" do
        role "System"
        goal "Count a reading with memory low: one more in the run"

        reference_to Overload

        sets :low_run, increment: { value: 1 }

        emits MemoryStarved
      end

      command "Replenish" do
        role "System"
        goal "Count a reading with memory ok: it breaks the low run"

        reference_to Overload

        sets :low_run, to: { value: 0 }

        emits MemoryReplenished
      end

      command "DeclareForLoad" do
        role "System"
        goal "Declare the overload: the load stayed over the overload mark for five readings"

        reference_to Overload
        attribute :reading, OverloadReason, sets: true

        given("no overload stands yet") { standing.value == 0 }
        given("the load stayed over the mark for five readings") { heavy_run.value >= 5 }

        sets :standing, to: { value: 1 }
        sets :reason,   to: "load over 20 for 5 readings"

        emits OverloadDeclared
      end

      command "DeclareForMemory" do
        role "System"
        goal "Declare the overload: memory stayed low for three readings"

        reference_to Overload
        attribute :reading, OverloadReason, sets: true

        given("no overload stands yet") { standing.value == 0 }
        given("memory stayed low for three readings") { low_run.value >= 3 }

        sets :standing, to: { value: 1 }
        sets :reason,   to: "memory low for 3 readings"

        emits OverloadDeclared
      end

      command "Lift" do
        role "System"
        goal "Lift the overload: ten readings under the load limit, with memory ok"

        reference_to Overload
        attribute :reading, OverloadReason, sets: true

        given("an overload stands") { standing.value == 1 }
        given("the load stayed under its limit for ten readings") { calm_run.value >= 10 }
        given("memory is not low") { low_run.value == 0 }

        sets :standing, to: { value: 0 }

        emits OverloadLifted
      end
    end

    policy "OpenTheOverloadWhenTheMachineIsRead" do
      on      "Machine.MachineSampled"
      trigger Overload::Open, with: { overload: "pipeline" }
    end

    policy "StrainWhenTheLoadIsOver" do
      on      "Machine.MachineSampled"
      where   { load > 20 }
      trigger Overload::Strain, with: { overload: "pipeline" }
    end

    policy "SettleWhenTheLoadIsUnderItsLimit" do
      on      "Machine.MachineSampled"
      where   { load_state == "below" }
      trigger Overload::Settle, with: { overload: "pipeline" }
    end

    policy "WaverWhenTheLoadIsBetween" do
      on      "Machine.MachineSampled"
      where   { load <= 20 && load_state != "below" }
      trigger Overload::Waver, with: { overload: "pipeline" }
    end

    policy "StarveWhenMemoryIsLow" do
      on      "Machine.MachineSampled"
      where   { memory_state == "low" }
      trigger Overload::Starve, with: { overload: "pipeline" }
    end

    policy "ReplenishWhenMemoryIsOk" do
      on      "Machine.MachineSampled"
      where   { memory_state != "low" }
      trigger Overload::Replenish, with: { overload: "pipeline" }
    end

    policy "DeclareWhenTheLoadIsStrained" do
      on      "Overload.LoadStrained"
      trigger Overload::DeclareForLoad, with: { overload: "pipeline", reading: "load" }
    end

    policy "DeclareWhenMemoryIsStarved" do
      on      "Overload.MemoryStarved"
      trigger Overload::DeclareForMemory, with: { overload: "pipeline", reading: "memory" }
    end

    policy "LiftWhenTheLoadIsSettled" do
      on      "Overload.LoadSettled"
      trigger Overload::Lift, with: { overload: "pipeline", reading: "load" }
    end

    policy "LiftWhenMemoryIsReplenished" do
      on      "Overload.MemoryReplenished"
      trigger Overload::Lift, with: { overload: "pipeline", reading: "memory" }
    end

    # One rise sheds once: the look is keyed by the reading that rose. The port answers facts, the
    # policies below decide, and the fill after `LoadFellBelow` restarts the item (`YieldKind`).
    # The StallWatch `load` row is the slow second step, for what five minutes left over the mark.
    aggregate "Shed" do
      description "One look, when the load rose, at which started work item is asked to yield: " \
                  "at most one, the lowest priority and newest started, and none that a ShedHold row keeps."

      attribute :reading, ShedKey
      attribute :work,    ShedNote, optional: true
      attribute :refusal, ShedNote, optional: true
      identified_by :reading

      value_object "ShedKey" do
        attribute :value, String, matches: :present
      end

      value_object "ShedNote", String

      # The priorities a started work item may be shed at, lowest rank first; among equals the
      # newest start goes first. A priority with no row is never shed, which is how `now` is kept.
      value_object "ShedTier" do
        attribute :priority, String
        attribute :rank,     Integer

        member priority: "later", rank: 1
        member priority: "",      rank: 1
        member priority: "next",  rank: 2
      end

      # What keeps a started work item from being shed whatever its priority, one row each. The
      # port reports which of these hold for an item; a row is what makes one count.
      value_object "ShedHold" do
        attribute :hold,   String
        attribute :reason, String

        member hold: "red",     reason: "the fix of a red main is never asked to wait"
        member hold: "review",  reason: "a run waiting on its plan review is resumed by the verdict, not by an ask"
        member hold: "landing", reason: "a branch being landed or boarded holds the line's lock"
      end

      lifecycle :status, default: "requested" do
        mark :failure, "spared"
        transition "Record"  => "asked",  from: "requested"
        transition "Decline" => "spared", from: "requested"
        mark :terminal, "asked", "spared"
      end

      command "Look" do
        role "System"
        goal "Look, because the load rose, for the started work item to ask to yield"

        attribute :reading, ShedKey, sets: true

        emits ShedRequested
      end

      command "Record" do
        role "System"
        goal "Record the work item whose session was asked to yield"

        reference_to Shed
        attribute :work, ShedNote, sets: true

        emits ShedAsked
      end

      command "Decline" do
        role "System"
        goal "Record why no work item was asked to yield"

        reference_to Shed
        attribute :refusal, ShedNote, sets: true

        emits ShedSpared
      end
    end

    # A root: the look begins its own chain, as the fill that follows a reading does.
    policy "ShedWhenTheLoadRises" do
      on      "Machine.LoadRoseAbove"
      root
      trigger Shed::Look, with: { reading: :id }
    end

    policy "SurveyWhenShedding" do
      on      "Shed.ShedRequested"
      ask     :survey, with: { reading: :reading }
    end

    # A root: asking the run starts the answer's own long chain (the look at the session, the
    # delivery, the record of it).
    policy "AskTheLowestItemToYield" do
      on      "Shed.ShedSurveyed"
      root
      where   { coders >= min_coders && shedding < at_once && candidate != "" }
      trigger AgentRun::Shed, with: { run: :candidate }
    end

    policy "RecordTheShed" do
      on      "Shed.ShedSurveyed"
      where   { coders >= min_coders && shedding < at_once && candidate != "" }
      trigger Shed::Record, with: { work: :candidate }
    end

    policy "SpareTheLastCoders" do
      on      "Shed.ShedSurveyed"
      where   { coders < min_coders }
      trigger Shed::Decline, with: { refusal: "fewer coders run than load_shed min_coders" }
    end

    policy "SpareWhileOneIsShedding" do
      on      "Shed.ShedSurveyed"
      where   { coders >= min_coders && shedding >= at_once }
      trigger Shed::Decline, with: { refusal: "a run asked to yield has not ended yet (load_shed at_once)" }
    end

    policy "SpareWhenNoneMayYield" do
      on      "Shed.ShedSurveyed"
      where   { coders >= min_coders && shedding < at_once && candidate == "" }
      trigger Shed::Decline, with: { refusal: "no started work item may be shed" }
    end

    policy "RecordTheUnsurveyedShed" do
      on      "Shed.ShedUnsurveyed"
      trigger Shed::Decline, with: { refusal: :refusal }
    end

    # The ask itself. The run's key is its Work item's key, and the yield names the kind `load`, so
    # the item waits out no backoff and is restarted first when the load falls.
    policy "AskTheShedRunToYield" do
      on      "AgentRun.LoadYieldAsked"
      root
      trigger AgentRun::Answer,
              with: { run: :run,
                      answer: "The machine's load is over the owner's limit, and your Work item is the lowest " \
                              "priority one running. Commit what you have now, start nothing heavy (no gate, " \
                              "spec batch or build), and end your turn with: exe/hecks tickets Work.yield! " \
                              "to=<your Work item's key> reason.value=\"load: yielded at the owner's load limit, " \
                              "restart when load falls\" yield_kind.value=load --wait. Your worktree and commits " \
                              "are kept, and the item is started again first when the load falls." }
    end

    policy "RollWhenRequested" do
      on      "Roll.RollRequested"
      ask     :roll, with: { run: :run }
    end

    policy "RecordTheRoll" do
      on      "Roll.RollReported"
      trigger Roll::Record, with: { report: :report, held_back: :held_back }
    end

    policy "RecordTheDeclinedRoll" do
      on      "Roll.RollRefused"
      trigger Roll::Decline, with: { refusal: :refusal }
    end

    # Opening a window quiets the pipeline through the port, which answers what it did as facts.
    policy "QuietWhenAWindowOpens" do
      on      "MergeWindow.WindowOpened"
      ask     :quiet, with: { run: :run }
    end

    policy "RecordTheQuieting" do
      on      "MergeWindow.WindowQuietReported"
      trigger MergeWindow::Record, with: { quieted: :quieted }
    end

    policy "RecordTheDeclinedQuieting" do
      on      "MergeWindow.WindowQuietRefused"
      trigger MergeWindow::Decline, with: { refusal: :refusal }
    end

    # Each event that frees capacity or adds work opens the switch record (refused, and benign, once
    # it is there) and consults it. Eight openings are the price of one record per store: any of
    # these events may be the first a store hears.
    policy "OpenTheRollSwitchWhenARunEnds" do
      on      "AgentRun.SessionFinished"
      trigger RollSwitch::Open, with: { switch: "rolls" }
    end

    policy "RollWhenARunEnds" do
      on      "AgentRun.SessionFinished"
      trigger RollSwitch::Consult, with: { roll_switch: "rolls", run: :run }
    end

    policy "OpenTheRollSwitchWhenARunFails" do
      on      "AgentRun.SessionFailed"
      trigger RollSwitch::Open, with: { switch: "rolls" }
    end

    policy "RollWhenARunFails" do
      on      "AgentRun.SessionFailed"
      trigger RollSwitch::Consult, with: { roll_switch: "rolls", run: :run }
    end

    policy "OpenTheRollSwitchWhenARunIsRetired" do
      on      "AgentRun.AgentRunRetired"
      trigger RollSwitch::Open, with: { switch: "rolls" }
    end

    policy "RollWhenARunIsRetired" do
      on      "AgentRun.AgentRunRetired"
      trigger RollSwitch::Consult, with: { roll_switch: "rolls", run: :run }
    end

    policy "OpenTheRollSwitchWhenWorkIsPlanned" do
      on      "Work.WorkPlanned"
      trigger RollSwitch::Open, with: { switch: "rolls" }
    end

    policy "RollWhenWorkIsPlanned" do
      on      "Work.WorkPlanned"
      trigger RollSwitch::Consult, with: { roll_switch: "rolls", run: :work }
    end

    policy "OpenTheRollSwitchWhenWorkIsReopened" do
      on      "Work.WorkReopened"
      trigger RollSwitch::Open, with: { switch: "rolls" }
    end

    # A reopened item is planned again, so a coder is wanted for it at once.
    policy "RollWhenWorkIsReopened" do
      on      "Work.WorkReopened"
      trigger RollSwitch::Consult, with: { roll_switch: "rolls", run: :work }
    end

    # A finished item frees the ground it held. Its coder's session ended at the submit, while the
    # item was still started, so the roll that end made skipped every item waiting on its area; the
    # landing closes it later, and that close rolls, so a waiting item starts with no hand fill.
    policy "OpenTheRollSwitchWhenWorkIsFinished" do
      on      "Work.WorkFinished"
      trigger RollSwitch::Open, with: { switch: "rolls" }
    end

    policy "RollWhenWorkIsFinished" do
      on      "Work.WorkFinished"
      trigger RollSwitch::Consult, with: { roll_switch: "rolls", run: :work }
    end

    # A yielded item frees its ground and its place under the cap. A yield made inside a running
    # fill asks for a roll the fill refuses and defers, so that fill fills once more and no more.
    policy "OpenTheRollSwitchWhenWorkIsYielded" do
      on      "Work.WorkYielded"
      trigger RollSwitch::Open, with: { switch: "rolls" }
    end

    policy "RollWhenWorkIsYielded" do
      on      "Work.WorkYielded"
      trigger RollSwitch::Consult, with: { roll_switch: "rolls", run: :work }
    end

    # A refused landing plans its item again, so a fresh coder is wanted at once, as for a reopened one.
    policy "OpenTheRollSwitchWhenWorkIsRefused" do
      on      "Work.WorkRefused"
      trigger RollSwitch::Open, with: { switch: "rolls" }
    end

    policy "RollWhenWorkIsRefused" do
      on      "Work.WorkRefused"
      trigger RollSwitch::Consult, with: { roll_switch: "rolls", run: :work }
    end

    policy "ReadTheSwitchWhenConsulted" do
      on      "RollSwitch.RollSwitchConsulted"
      ask     :read, with: { run: :run }
    end

    # A root: the consult and the read are behind it, so the roll's own chain (the fill and its
    # record) begins at the depth it has when an event starts it directly. The roll is keyed by the
    # read's own `roll`, so two events about one work item (planned, then finished) each roll.
    policy "StartTheRollWhenTheSwitchIsOn" do
      on      "RollSwitch.RollSwitchRead"
      root
      where   { state == "on" }
      trigger Roll::Start, with: { run: :roll }
    end

    policy "RecordThePause" do
      on      "RollSwitch.RollSwitchRead"
      where   { state == "off" && standing == 0 }
      trigger RollSwitch::Pause, with: { reason: "paused: dispatch_roll_forward is false" }
    end

    policy "RecordTheResume" do
      on      "RollSwitch.RollSwitchRead"
      where   { state == "on" && standing == 1 }
      trigger RollSwitch::Resume, with: { roll_switch: "rolls" }
    end

    # The directory is looked for first, so a brief is never handed to a session that has nowhere to work.
    policy "LocateTheRepo" do
      on      "AgentRun.AgentRunRequested"
      ask     :locate, with: { run: :run }
    end

    # Locating the directory also says whether its `claude` lists the named agent, so a name it
    # does not know is refused before a session is started; with no agent named, the session runs
    # `claude`'s default. One look, not two: the reactions after a start stay within the depth limit.
    policy "StartWhenTheAgentIsListed" do
      on      "AgentRun.RepoLocated"
      where   { listed != false && (holder == "" || holder_status != "started" || holder_agent != "" || requester_agent != "") && role_holder == "" }
      ask     :start, with: { run: :run }
    end

    # A pinned role (Agents `PinnedRole`) has one live session: a run of it is declined while another
    # holds it, naming that session for the owner to stop. `Begin` is not guarded, so two dispatches
    # located at once can both start: the rule is checked per dispatch and answer, not under a lock.
    policy "RecordTheHeldRole" do
      on      "AgentRun.RepoLocated"
      where   { listed != false && role_holder != "" && (holder == "" || holder_status != "started" || holder_agent != "" || requester_agent != "") }
      trigger AgentRun::Decline, with: { refusal: :role_note }
    end

    # A Work item has one live session: a run with no agent on work another started run with no
    # agent serves is declined before a session starts. A review's run is never held against its coder.
    policy "RecordTheHeldWork" do
      on      "AgentRun.RepoLocated"
      where   { listed != false && holder != "" && holder_status == "started" && holder_agent == "" && requester_agent == "" }
      trigger AgentRun::Decline, with: { refusal: "its work is already held by a started run" }
    end

    policy "RecordTheUnlistedAgent" do
      on      "AgentRun.RepoLocated"
      where   { listed == false }
      trigger AgentRun::Decline, with: { refusal: :note }
    end

    # A root: a run asked for from a filed stall sits five reactions deep when its session starts, and
    # a refused `Begin` would leave a live session no run records started or declined.
    policy "RecordTheSession" do
      on      "AgentRun.AgentStarted"
      root
      trigger AgentRun::Begin, with: { session: :session, started_at: :started_at }
    end

    # A session can die within seconds of its start (an agent that fails to load). Its job is read
    # once the port has let it settle, so a dead session is recorded failed, never left started.
    # A root: a start sits five reactions deep already, and reading the new session begins its own
    # chain, so recording a session that is working, or that died at once, is not refused at the cap.
    policy "ReadTheNewSession" do
      on      "AgentRun.AgentRunStarted"
      root
      ask     :await_job, with: { run: :run }
    end

    policy "RecordTheMissingRepo" do
      on      "AgentRun.RepoMissing"
      trigger AgentRun::Decline, with: { refusal: :refusal }
    end

    policy "RecordTheRefusedStart" do
      on      "AgentRun.StartRefused"
      trigger AgentRun::Decline, with: { refusal: :refusal }
    end

    policy "ReadTheJob" do
      on      "AgentRun.AgentCheckRequested"
      ask     :read_job, with: { run: :run }
    end

    # A sweep does not roll the queue itself. Each check below records the session it finds ended or
    # failed as `SessionFinished` or `SessionFailed`, and a session whose job cannot be read at all
    # (its state file is gone, as after `claude rm`) is looked for by `LookForTheUnreadSession` and
    # recorded `AgentRunRetired` when `claude agents` no longer lists it. Each of those rolls on its
    # own (`RollWhenARunEnds`, `RollWhenARunFails`, `RollWhenARunIsRetired`), settling the started
    # Work items before it counts the cap. A beat that finds nothing changed starts no fill; what
    # becomes eligible by the clock alone is the `Wake` aggregate's question.
    #
    # Each check is addressed by the Work item's key alone: the sweep's own `run` is not passed on.
    policy "CheckEveryStartedRun" do
      on       "SessionSweep.SweepRequested"
      for_each "AgentRun.Running"
      trigger  AgentRun::Check, with: { agent_run: :agent_run }
    end

    # A pinned role (Agents `PinnedRole`) has at most one live session: each sweep reads every
    # pinned role's live ids (`live_ids`) and the most any role holds (`most`), and a role with two
    # is a finding, named in `check_all!`'s events.
    policy "CountThePinnedRolesSessions" do
      on      "SessionSweep.SweepRequested"
      ask     :check_roles, with: { run: :run }
    end

    policy "ReportTheDoubledRole" do
      on      "SessionSweep.RolesChecked"
      where   { most > 1 }
      trigger SessionSweep::Find, with: { finding: :live_ids }
    end

    # A job's state becomes an event only when it differs from the state the run last recorded
    # (`previous`), so a check that finds nothing new records nothing. Each is a root: a job read
    # right after a start sits past the reaction cap, and recording what the session is doing begins
    # its own chain, so a session that is working, or died at once, is never refused at the cap.
    policy "RecordTheWorkingSession" do
      on      "AgentRun.JobRead"
      root
      where   { state == "working" && previous != state }
      trigger AgentRun::Work, with: { condition: :state, checkout: :checkout }
    end

    policy "RecordTheBlockedSession" do
      on      "AgentRun.JobRead"
      root
      where   { state == "blocked" && previous != state }
      trigger AgentRun::Block, with: { condition: :state, detail: :detail, checkout: :checkout }
    end

    # Resuming an idle session with an answer stops it and wakes it again, and the stop runs the
    # session's own check. A job read `stopped` while the run's answer is on its way (`resuming`, which the
    # reading carries beside `previous`) is that stop, so it ends nothing; the next check reads the
    # woken session, or the stopped one once the answer was refused.
    policy "RecordTheEndedSession" do
      on      "AgentRun.JobRead"
      root
      where   do
        ((state == "done" && run != "orchestrator-seat") || (state == "stopped" && resuming != true)) &&
          reviewing != true && previous != state
      end
      trigger AgentRun::Finish, with: { condition: :state, detail: :detail, checkout: :checkout }
    end

    # A session that finished its turn is listed `idle` while its job still reads `working`, and it
    # stays listed so until a person or an answer wakes it. A role that works one turn at a time (every
    # role but the orchestrator, which idles between beats) has ended when it is idle and said its
    # closing words: an architect's verdict, another role's report. A session waiting on a person
    # reads `blocked`, not `working`, so this never ends one. The run then reads `done`, so the
    # architect's verdict is recorded and a coder's session stops being listed as working.
    #
    # A coder whose plan review is open (`reviewing`) is waiting, not reporting: it ended its turn to
    # be resumed with the verdict, so its run stays started until the review is answered.
    policy "RecordTheIdleSession" do
      on      "AgentRun.JobRead"
      root
      where   do
        state == "working" && listed == "idle" && resuming != true && reviewing != true && previous != "done" &&
          agent != "orchestrator" && (verdict != "" || (agent != "architect" && report != ""))
      end
      trigger AgentRun::Finish, with: { condition: "done", detail: :report, checkout: :checkout }
    end

    # Listed `stopped` (`live`) while the job reads `working`, with nothing to lose (`dirty`, `unmerged`
    # read true for an unreadable tree): the coder has ended, as `RecordTheEndedSession` ends one the
    # job reads stopped. Unsaved work matches nothing, so `stopped_session_after` and the stall report keep it.
    policy "RecordTheStoppedListedSession" do
      on      "AgentRun.JobRead"
      root
      where   do
        state == "working" && live == "stopped" && agent == "coder" && dirty == false && unmerged == false &&
          resuming != true && reviewing != true && previous != "stopped"
      end
      trigger AgentRun::Finish, with: { condition: "stopped", detail: :report, checkout: :checkout }
    end

    # A helper blocked past `abandon_after_minutes` ends `abandoned`, its question kept as the
    # detail, and is reaped. A helper is every run but a coder's and the standing seat's
    # (`orchestrator-seat`): a reviewer, an architect, a planner, a pruner, and an orchestrator run
    # that is not the seat, so a stall fixer's (`stall-`), an advice run and one started by hand,
    # which is spared only when its session is pinned. A coder, a pinned session or one being
    # answered is left. It fires once: `Check` reads only a started run's job.
    policy "AbandonTheUnansweredHelper" do
      on      "AgentRun.JobRead"
      root
      where   do
        state == "blocked" && agent != "coder" && (agent != "orchestrator" || run != "orchestrator-seat") && agent != "" &&
          abandon_after > 0 && blocked_minutes >= abandon_after && pin_listed == false && resuming != true &&
          reviewing != true && !run.start_with?("live-") && !run.start_with?("resume-")
      end
      trigger AgentRun::Finish, with: { condition: "abandoned", detail: :detail, checkout: :checkout }
    end

    policy "RecordTheFailedSession" do
      on      "AgentRun.JobRead"
      root
      where   { state == "failed" && previous != state }
      trigger AgentRun::Fail, with: { condition: :state, detail: :detail, checkout: :checkout }
    end

    # The session is looked at before it is removed; the port says whether a person took it over.
    policy "ReviewBeforeTidy" do
      on      "AgentRun.TidyRequested"
      ask     :review, with: { run: :run }
    end

    # A finished run whose session was pruned (by the pruner, a plain sweep or `claude rm`) cannot
    # be reviewed: the port refuses that no session is listed, and the run would stay finished and
    # be reviewed again at every reap. It is looked for instead, and retired when the listing does
    # not hold it (`RetireWhenTheSessionIsGone`); retiring it rolls its Work and unstarts a plan
    # review it left without a verdict, as for a started run. A review refused for any other reason
    # is left as it was, so its own refusal is not replaced. Retiring is the trade for ending the
    # loop: the reap never reaches the run again, so a worktree its session left stays on disk until
    # it is retired by hand (`Landing.retire!`). A root: the look, the retire and the roll are long.
    policy "LookForTheUnreviewedSession" do
      on      "AgentRun.ReviewRefused"
      root
      where   { refusal && refusal.value.include?("no session ") }
      ask     :look_for, with: { run: :run }
    end

    # A review the port refused for another reason (the sessions could not be listed, a console
    # capture failed) is kept with that refusal and a short wait, so a failing listing is asked
    # again after five minutes and not at every reap.
    policy "KeepWhenTheReviewFailed" do
      on      "AgentRun.ReviewRefused"
      where   { !(refusal && refusal.value.include?("no session ")) }
      trigger AgentRun::Retain, with: { refusal: :refusal, review_wait: 300 }
    end

    # A run the review keeps is recorded kept with its reason, the time and a wait (`Retain`), and
    # `Tidy` refuses it until the wait has passed, so a kept run is reviewed once per wait.
    #
    # A finished run's session goes in this order: kept when a person replied, or its Work is still
    # open and the run left a product (`no_product` is true for the architect, reviewer, planner
    # and pruner); kept when the worktree holds uncommitted files or commits `origin` lacks; then
    # the world's scratch is cleared, the worktree retired and the session removed. A refusal at
    # any step keeps the session with that step's reason, so none is removed ahead of its worktree.
    # A session kept for its Work or its worktree that reads done is stopped, not removed.
    #
    # A session `claude agents` does not list (`listed` false) was removed elsewhere: there is no
    # session left to keep or remove, so the run is recorded tidied and leaves `Tidyable`, and no
    # later beat reviews it again. Its worktree, if one stands, is not looked for here: the run
    # names no worktree once its session is gone, and `Landing.retire!` or a person removes it.
    policy "RecordTheSessionAlreadyGone" do
      on      "AgentRun.SessionReviewed"
      where   { listed == false }
      trigger AgentRun::Tidied, with: { tidied_at: :gone_at }
    end

    policy "KeepWhenAPersonTookOver" do
      on      "AgentRun.SessionReviewed"
      where   { listed != false && taken_over != false }
      trigger AgentRun::Retain, with: { refusal: :note, review_wait: 3600 }
    end

    policy "KeepWhenTheWorkIsStillQueued" do
      on      "AgentRun.SessionReviewed"
      where   { listed != false && taken_over == false && work_open == true && no_product != true && ended_as != "abandoned" }
      trigger AgentRun::Retain, with: { refusal: "Work still queued", review_wait: 3600 }
    end

    policy "KeepWhenTheWorktreeHasUnmergedCommits" do
      on      "AgentRun.SessionReviewed"
      where   { listed != false && taken_over == false && (work_open != true || no_product == true || ended_as == "abandoned") && unmerged == true }
      trigger AgentRun::Retain, with: { refusal: "worktree has unmerged commits", review_wait: 3600 }
    end

    policy "KeepWhenTheWorktreeHasUncommittedFiles" do
      on      "AgentRun.SessionReviewed"
      where   { listed != false && taken_over == false && (work_open != true || no_product == true || ended_as == "abandoned") && unmerged != true && dirty == true }
      trigger AgentRun::Retain, with: { refusal: "worktree has uncommitted files", review_wait: 3600 }
    end

    # A session kept for its Work or its worktree that the listing shows `done` (`live`) still
    # holds its process and the MCP servers that process started, though nobody is in it: the
    # board starts a new session for the Work, never this one. It is stopped, so its process ends
    # and the session stays listed for a person to resume or remove. A session a person took over
    # may be attached right now and is never stopped, nor one working, nor one blocked whose run
    # has not ended abandoned (`StopTheKeptAbandonedSession` below); a stopped one reads `stopped`
    # at the next reap, so it is asked once. A refused stop is asked again at the next reap, and
    # the refusal is in the journal as `StopRefused`.
    policy "StopTheKeptDoneSession" do
      on      "AgentRun.SessionReviewed"
      where   { listed != false && taken_over == false && live == "done" && ((work_open == true && no_product != true && ended_as != "abandoned") || unmerged == true || dirty == true) }
      ask     :stop_session, with: { run: :run }
    end

    # A run ended `abandoned` waits on a question nobody will answer. The reap removes its session,
    # which stops it; one kept for its worktree's uncommitted files or unmerged commits would hold
    # its process, blocked, for as long as it is kept, so it is stopped (`claude stop`, never a
    # kill) and stays listed with its work. One a person took over is never stopped. A stopped one
    # no longer reads `blocked` (`live`) at the next reap, so it is asked once.
    policy "StopTheKeptAbandonedSession" do
      on      "AgentRun.SessionReviewed"
      where   do
        listed != false && taken_over == false && ended_as == "abandoned" && live == "blocked" &&
          (unmerged == true || dirty == true)
      end
      ask     :stop_session, with: { run: :run }
    end

    policy "ClearTheScratchOfAFinishedRun" do
      on      "AgentRun.SessionReviewed"
      where   { listed != false && taken_over == false && (work_open != true || no_product == true || ended_as == "abandoned") && unmerged != true && dirty != true && worktree != "" }
      ask     :clear_scratch, with: { run: :run }
    end

    policy "RemoveTheSessionWithNoWorktree" do
      on      "AgentRun.SessionReviewed"
      where   { listed != false && taken_over == false && (work_open != true || no_product == true || ended_as == "abandoned") && unmerged != true && dirty != true && worktree == "" }
      ask     :remove, with: { run: :run }
    end

    policy "RetireTheWorktreeOnceItsScratchIsClear" do
      on      "AgentRun.ScratchCleared"
      ask     :retire_worktree, with: { run: :run }
    end

    policy "KeepWhenTheScratchCannotBeCleared" do
      on      "AgentRun.ClearRefused"
      trigger AgentRun::Retain, with: { refusal: :refusal, review_wait: 3600 }
    end

    policy "NoteTheRetiredWorktree" do
      on      "AgentRun.WorktreeRetired"
      trigger AgentRun::Detach, with: { detail: :note }
    end

    policy "RemoveTheSessionOnceItsWorktreeIsRetired" do
      on      "AgentRun.WorktreeRetired"
      ask     :remove, with: { run: :run }
    end

    policy "KeepWhenTheWorktreeCannotBeRetired" do
      on      "AgentRun.RetireRefused"
      trigger AgentRun::Retain, with: { refusal: :refusal, review_wait: 3600 }
    end

    # How an answer reaches a session is decided here, from what `claude agents` lists of it, never
    # in the adapter:
    #
    #   listed busy (mid-turn)  -> deliver: the answer waits in the session's inbox, and its next
    #                              tool call or the end of its turn hands it to the model; it is
    #                              not stopped, so it keeps its process and context
    #   listed idle, or gone    -> resume with the answer as the prompt
    #
    # The listed status decides, not the job's state: a session that ended its turn is listed
    # `idle` while its job still reads `working`, and an idle session runs no hook to read an inbox.
    # A busy session started without the inbox hook refuses the delivery by name and is not stopped.
    # Every refusal on the way is `ResumeRefused`, so an answer is recorded `Unanswered` and a
    # verdict `Unresumed` (kept waiting and sent again) by the two policies below.
    policy "AnswerTheSessionWhereItIs" do
      on      "AgentRun.AnswerRequested"
      ask     :present, with: { run: :run, answer: :answer, step: :step, verdict: :verdict }
    end

    # Each path is a root: a verdict sent again reaches the look four reactions deep, and what was
    # seen of the session begins its own chain, so recording the verdict delivered is not refused
    # at the cap.
    policy "DeliverToTheWorkingSession" do
      on      "AgentRun.SessionPresent"
      root
      where   { listed == true && status == "busy" && role_holder == "" }
      ask     :deliver, with: { run: :run, answer: :answer, step: :step, verdict: :verdict }
    end

    policy "ResumeTheIdleSession" do
      on      "AgentRun.SessionPresent"
      root
      where   { (listed != true || status != "busy") && role_holder == "" }
      ask     :resume, with: { run: :run, answer: :answer, step: :step, verdict: :verdict }
    end

    # A pinned role's run is not answered while another live session holds the role. A fork
    # (`ResumedAsFork`) leaves the old session live, so answers are refused until the owner stops
    # one; a verdict is kept waiting and sent again (`Unresumed`).
    policy "RefuseTheAnswerOfAHeldRole" do
      on      "AgentRun.SessionPresent"
      where   { role_holder != "" && verdict == "" }
      trigger AgentRun::Unanswered, with: { refusal: :role_note, verdict: :verdict }
    end

    policy "RefuseTheVerdictOfAHeldRole" do
      on      "AgentRun.SessionPresent"
      where   { role_holder != "" && verdict != "" }
      trigger AgentRun::Unresumed, with: { refusal: :role_note, verdict: :verdict }
    end

    # Queued is answered: the inbox is read at the session's next tool call or turn end. A session
    # that ends before then leaves the answer unread in its inbox; that window is accepted.
    policy "RecordTheQueuedAnswer" do
      on      "AgentRun.AnswerQueued"
      trigger AgentRun::Answered, with: { answered_at: :queued_at, session: :session, verdict: :verdict }
    end

    policy "RecordTheAnswer" do
      on      "AgentRun.AgentResumed"
      trigger AgentRun::Answered, with: { answered_at: :resumed_at, session: :session, verdict: :verdict }
    end

    # The resume answers the id the run `held` and the id the session now runs under; whether
    # they differ is the fork, judged here, never in the adapter.
    policy "RecordTheForkedResume" do
      on      "AgentRun.AgentResumed"
      where   { held != session }
      trigger AgentRun::Fork, with: { forked_from: :held, session: :session, pinned_role: :pinned_role }
    end

    # A fork of a pinned role's run stops the session it superseded (`claude stop`, never a kill).
    # A root, since a fork sits deep in an answer's chain. A refused stop leaves the old session
    # live, and the held-role guards refuse the run's answers by name until it ends.
    policy "StopTheSupersededSession" do
      on      "AgentRun.ResumedAsFork"
      root
      where   { pinned_role != "" }
      ask     :stop_forked_from, with: { run: :run }
    end

    # A rebind looks at the named session first; the bluebook judges what the port reports.
    policy "LookAtTheSessionToRebind" do
      on      "AgentRun.RebindRequested"
      ask     :inspect_session, with: { run: :run, target: :session }
    end

    policy "BindTheRunToTheLiveSession" do
      on      "AgentRun.SessionInspected"
      where   { alive == true && bound == "" }
      trigger AgentRun::Rebound, with: { session: :target, forked_from: :held }
    end

    policy "RefuseTheRebindOfADeadOrHeldSession" do
      on      "AgentRun.SessionInspected"
      where   { alive != true || bound != "" }
      trigger AgentRun::RefuseRebind, with: { refusal: :note }
    end

    policy "RecordTheUninspectedRebind" do
      on      "AgentRun.InspectRefused"
      trigger AgentRun::RefuseRebind, with: { refusal: :refusal }
    end

    policy "RecordTheResumeInPlace" do
      on      "AgentRun.AgentResumed"
      where   { held == session }
      trigger AgentRun::ResumeInPlace, with: { session: :session }
    end

    policy "RecordTheRefusedAnswer" do
      on      "AgentRun.ResumeRefused"
      where   { verdict == "" }
      trigger AgentRun::Unanswered, with: { refusal: :refusal, verdict: :verdict }
    end

    # A refused verdict is not the end of the wait: the run keeps waiting and the verdict is retried.
    policy "RecordTheRefusedVerdict" do
      on      "AgentRun.ResumeRefused"
      where   { verdict != "" }
      trigger AgentRun::Unresumed, with: { refusal: :refusal, verdict: :verdict }
    end

    # A verdict sent again after its resume was refused answers the waiting coder in place, as the
    # judged verdict did. An architect's verdict leads with the step: whatever its word, the brief
    # says what the coder does with it, so the read of the review is a step, not the end of the turn.
    policy "AnswerTheWaitingCoderAgain" do
      on      "Verdict.VerdictRedelivered"
      where   { word != "" }
      trigger AgentRun::Answer,
              with: { run: :work, answer: :answer, verdict: :run,
                      step: "Your plan review's verdict is in, sent again after your session could not be " \
                            "resumed. Read your review with PlanReview.reviews and act on its verdict as your " \
                            "brief says, in this session: the read is a step, not the end of your turn." }
    end

    policy "AnswerTheWaitingCoderAgainWithTheJudgment" do
      on      "Verdict.VerdictRedelivered"
      where   { word == "" }
      trigger AgentRun::Answer, with: { run: :work, answer: :answer, verdict: :run }
    end

    # A verdict the coder's session refused on every try ends the coder's run as `unanswered`, so
    # the settle yields its Work item saying so, not as a coder that finished. A coder run that has
    # already ended refuses it (`Finish` takes a started run) and nothing changes.
    policy "FinishTheCoderWhoseVerdictWasAbandoned" do
      on      "Verdict.VerdictAbandoned"
      trigger AgentRun::Finish, with: { run: :work, condition: "unanswered", detail: :reason, checkout: "" }
    end

    # A sweep's check that cannot read the job at all (`JobUnreadable`) finds no event to record, so a
    # run whose session vanished would stay started and keep counting against the cap. It is looked
    # for in the listing instead; a session still listed is kept, and the run is retired only when
    # it is gone. The reading right after a start refuses as `JobUnread`, which is expected there
    # (the job is not written yet) and is not looked for. A root: the chain that follows (the look,
    # the retire, the roll) is long.
    policy "LookForTheUnreadSession" do
      on      "AgentRun.JobUnreadable"
      root
      ask     :look_for, with: { run: :run }
    end

    # The session is looked for before the run is retired; only one `claude agents` no longer
    # lists is gone.
    policy "LookForTheSessionBeforeRetiring" do
      on      "AgentRun.AgentRunRetireRequested"
      ask     :look_for, with: { run: :run }
    end

    policy "RetireWhenTheSessionIsGone" do
      on      "AgentRun.SessionLookedFor"
      where   { listed == false }
      trigger AgentRun::Retired, with: { detail: :note }
    end

    policy "KeepWhenTheSessionIsListed" do
      on      "AgentRun.SessionLookedFor"
      where   { listed != false }
      trigger AgentRun::Unretired, with: { refusal: :note }
    end

    policy "RecordTheRefusedLookFor" do
      on      "AgentRun.LookForRefused"
      trigger AgentRun::Unretired, with: { refusal: :refusal }
    end

    # A kept run is not retired, and the command that asked says so: `Retired` refuses the run the
    # look kept, by name. A sweep's own look (`LookForTheUnreadSession`) that keeps a run is refused
    # the same way, so a check of a run whose job cannot be read while its session is listed says so.
    policy "RefuseTheRetireOfAKeptRun" do
      on      "AgentRun.AgentRunUnretired"
      trigger AgentRun::Retired, with: { detail: :refusal, kept: true }
    end

    # A run keyed `live-*` or `resume-*` is a test run: left alone it stays blocked or working for
    # ever, so the first reading that finds it working or blocked retires it.
    policy "RetireTheTrialRun" do
      on      "AgentRun.JobRead"
      root
      where   { (run.start_with?("live-") || run.start_with?("resume-")) && (state == "working" || state == "blocked") }
      trigger AgentRun::RetireTrial, with: { detail: :detail }
    end

    # A job reading `working` over a session that is not listed records nothing, so its run stays
    # started. The reading only filters: `Retire` looks again and keeps a young, listed or unreadable
    # one. A blocked one is left (`AbandonTheUnansweredHelper` ends a helper's, a stall fixer's too); a
    # trial run has its own.
    policy "RetireTheRunWhoseSessionIsNotListed" do
      on      "AgentRun.JobRead"
      root
      where do
        state == "working" && listed == "" && live == "" && resuming != true &&
          !run.start_with?("live-") && !run.start_with?("resume-")
      end
      trigger AgentRun::Retire, with: { run: :run }
    end

    policy "RecordTheRemoval" do
      on      "AgentRun.SessionRemoved"
      trigger AgentRun::Tidied, with: { tidied_at: :removed_at }
    end

    policy "RecordTheKeptSession" do
      on      "AgentRun.RemoveRefused"
      trigger AgentRun::Retain, with: { refusal: :refusal, review_wait: 3600 }
    end

    # A plan review asked for by event starts the named role's session as a run keyed by the review,
    # so it never collides with the Work item's own run or an earlier review of it. The run names the Work item it reviews, and the plan is its brief.
    # Its parent is the coder run, which is keyed by the Work item, so `:work` is a run key here.
    policy "StartTheRoleOnReviewRequest" do
      on      "PlanReview.PlanReviewRequested"
      trigger AgentRun::Dispatch, with: { run: :run, work: :work, parent: :work, repo: :repo, brief: :plan, agent: :role }
    end

    # A verdict judged for a coder run that already finished cannot be delivered (`Answer` takes a
    # started run). It is not lost: the run keyed by the Work item is recorded unreached, which
    # records the verdict undeliverable with this reason, a finding that names the judge's run and
    # the Work item. `Unreached` takes only a finished run, so a started run (answered by
    # AnswerTheWaitingCoder) or a Work item with no run refuses it and records nothing.
    policy "RefuseTheVerdictOfAFinishedCoder" do
      on      "Verdict.VerdictJudged"
      trigger AgentRun::Unreached, with: { run: :work, verdict: :run,
                                           refusal: "the coder run already finished: restart the item with the review in its brief" }
    end

    # A verdict sent again finds the coder run as a judged one does: one finished since is recorded
    # unreached, so a redelivery is not refused without a record.
    policy "RefuseTheRedeliveredVerdictOfAFinishedCoder" do
      on      "Verdict.VerdictRedelivered"
      trigger AgentRun::Unreached, with: { run: :work, verdict: :run,
                                           refusal: "the coder run already finished: restart the item with the review in its brief" }
    end

    # A verdict for a tidied, retired or declined coder run records `AnswerRefused`, which settles it
    # undeliverable (`RecordTheVerdictOfAnEndedRun`) and opens the `agent-run-answer-refused` stall.
    # A started run refuses it by lifecycle while `Answer` delivers.
    policy "RefuseTheVerdictOfAnEndedCoder" do
      on      "Verdict.VerdictJudged"
      trigger AgentRun::RefuseAnswer, with: { run: :work, verdict: :run,
                                              refusal: "the coder run is not started: restart the item with the review in its brief" }
    end

    policy "RefuseTheRedeliveredVerdictOfAnEndedCoder" do
      on      "Verdict.VerdictRedelivered"
      trigger AgentRun::RefuseAnswer, with: { run: :work, verdict: :run,
                                              refusal: "the coder run is not started: restart the item with the review in its brief" }
    end

    # A judged verdict ends its judge's run: one left started is read at every sweep, judged afresh
    # and sent to the coder again. A judge already ended, or a verdict with no run, fires nothing.
    policy "FinishTheJudgeWhoseVerdictIsJudged" do
      on       "Verdict.VerdictJudged"
      for_each "AgentRun.StartedOfRun"
      trigger  AgentRun::Finish, with: { agent_run: :agent_run, condition: "done", detail: :answer, checkout: "" }
    end

    # The Work item's coder run is marked as waiting on a review the moment it is requested, before any
    # reading of the job can end it. A review of a Work item with no started coder run finds none.
    policy "AwaitTheReview" do
      on      "PlanReview.PlanReviewRequested"
      trigger AgentRun::Await, with: { run: :work }
    end

    # A judge's verdict answers the coder waiting on the Work item, a run keyed by the Work item, in
    # place. The judge's run names the verdict, so the outcome settles it (Agents translations
    # RecordTheVerdictDelivered and RecordTheVerdictUndeliverable). A verdict to build leads with
    # the coder's next step, so the read of its review is not taken for the end of its turn; a
    # rethink, a reviewer's judgment and an unstarted review go as written, for the brief decides
    # what the coder does with them.
    policy "AnswerTheWaitingCoder" do
      on      "Verdict.VerdictJudged"
      where   { word != "sound" && word != "changes" }
      trigger AgentRun::Answer, with: { run: :work, answer: :answer, verdict: :run }
    end

    policy "AnswerTheWaitingCoderToBuild" do
      on      "Verdict.VerdictJudged"
      where   { word == "sound" }
      trigger AgentRun::Answer,
              with: { run: :work, answer: :answer, verdict: :run,
                      step: "Your plan review's verdict is sound. Read your review with PlanReview.reviews as " \
                            "your brief says, then continue in this session and build the Work item now: the " \
                            "read is a step, not the end of your turn." }
    end

    policy "AnswerTheWaitingCoderToReviseAndBuild" do
      on      "Verdict.VerdictJudged"
      where   { word == "changes" }
      trigger AgentRun::Answer,
              with: { run: :work, answer: :answer, verdict: :run,
                      step: "Your plan review's verdict is sound with changes. Read your review with " \
                            "PlanReview.reviews as your brief says, then continue in this session: revise the " \
                            "plan as its findings say and build the Work item now. The read is a step, not the " \
                            "end of your turn." }
    end

    # A submission review starts the reviewer's run keyed by its commit, which
    # RecordTheReviewersJudgment reads. Its parent is the coder run, keyed by the Work item;
    # a review naming none starts with no parent, since an empty key would refuse the start.
    policy "StartTheReviewerOnReviewRequest" do
      on      "SubmissionReview.SubmissionReviewRequested"
      where   { work != "" }
      trigger AgentRun::Dispatch, with: { run: :submission, parent: :work, repo: :repo, brief: :brief, agent: :role }
    end

    policy "StartTheReviewerOfAnUnnamedWorkItem" do
      on      "SubmissionReview.SubmissionReviewRequested"
      where   { work == "" }
      trigger AgentRun::Dispatch, with: { run: :submission, repo: :repo, brief: :brief, agent: :role }
    end

    # A planning request starts the planner's session under a minted key, with the goal as its brief.
    # The planner drafts a plan and asks; it creates Work items only once the owner says so.
    policy "StartThePlannerOnPlanningRequest" do
      on      "Planning.PlanningRequested"
      trigger AgentRun::Dispatch, with: { repo: :repo, brief: :goal, agent: :role }
    end

    # A woken pruner starts its session as a run of the `pruner` agent, under a minted key.
    policy "StartThePrunerWhenWoken" do
      on      "Pruning.PrunerWoken"
      trigger AgentRun::Dispatch, with: { repo: :repo, brief: :brief, agent: :role }
    end

    # A conflicting Work item asks the orchestrator for advice: its session starts under a minted key,
    # with a brief that names the Work item and the conflict.
    policy "StartTheOrchestratorOnAdviceRequest" do
      on      "Routing.DispatchAdviceRequested"
      trigger AgentRun::Dispatch, with: { repo: :repo, brief: :brief, agent: :role }
    end

    # An exception the orchestrator must judge starts its session as a run keyed by the escalation:
    # a stall's key is its Work item, which the stall fixer's run is keyed by. A wake under the
    # standing rule all-hands-on-red is weighed against main's red flag first (`RedWake`).
    policy "StartTheCoordinatorWhenWoken" do
      on      "Escalation.CoordinatorWoken"
      where   { rule != "all-hands-on-red" && event != "StandingCoordinatorStarted" }
      trigger AgentRun::Dispatch, with: { run: :escalation, repo: :repo, brief: :brief, agent: :role }
    end

    # The seat is one run under its own key, its sweep the parent: a started run keeps its key, so
    # a second start is refused from any process until it ends (`RecordTheEndedSession` keeps an
    # idle seat read `done`, which a message resumes). A root, past a sweep's reaction cap.
    policy "StartTheStandingSeatWhenWoken" do
      on      "Escalation.CoordinatorWoken"
      root
      where   { rule != "all-hands-on-red" && event == "StandingCoordinatorStarted" }
      trigger AgentRun::Dispatch,
              with: { run: "orchestrator-seat", parent: :escalation, repo: :repo, brief: :brief, agent: :role,
                      works_as: "orchestrator-seat" }
    end

    # A linked worktree keeps its runs in Memory, so a session it started would be reaped by
    # nothing; declined there, the shared flag is the one signal left. One run stands per flag.
    aggregate "RedWake" do
      description "One wake of the orchestrator for a red main, which starts a session only while main's red flag stands and only from the main checkout, under the run red-wake-<flag>, playing red-wake for its episode."

      attribute :escalation, WakeKey
      attribute :kind,       WakeWord
      attribute :repo,       WakeWord
      attribute :flag,       WakeWord, optional: true
      attribute :run,        WakeWord, optional: true
      identified_by :escalation

      value_object "WakeKey" do
        attribute :value, String, matches: :present
      end

      value_object "WakeWord" do
        attribute :value, String, matches: :present
      end

      lifecycle :status, default: "requested" do
        mark :failure, "declined"
        transition "Start"   => "started",  from: "requested"
        transition "Decline" => "declined", from: "requested"
        mark :terminal, "started", "declined"
        # Weighed in the same dispatch it is heard in: the ask answers or refuses at once.
        mark :rests, "requested"
      end

      command "Hear" do
        role "System"
        goal "Hear a wake of the orchestrator for a red main, to weigh it against the red flag"

        attribute :escalation, WakeKey, sets: true
        attribute :kind,       WakeWord, sets: true
        attribute :repo,       WakeWord, sets: true

        emits RedWakeHeard
      end

      command "Start" do
        role "System"
        goal "Record that main's red flag stands and the wake's session starts under the flag's run"

        reference_to RedWake
        attribute :flag,    WakeWord, sets: true
        attribute :run,     WakeWord, sets: true
        attribute :kind,    WakeWord
        attribute :repo,    WakeWord
        attribute :episode, WakeWord

        emits RedWakeStarted
      end

      command "Decline" do
        role "System"
        goal "Record why no session starts for the wake: main is green, or this is not the main checkout"

        reference_to RedWake
        attribute :refusal, WakeWord

        emits RedWakeDeclined
      end
    end

    policy "HearTheRedWake" do
      on      "Escalation.CoordinatorWoken"
      where   { rule == "all-hands-on-red" }
      trigger RedWake::Hear, with: { escalation: :escalation, kind: :event, repo: :repo }
    end

    policy "WeighTheRedWake" do
      on      "RedWake.RedWakeHeard"
      ask     :weigh, with: { escalation: :escalation, kind: :kind, repo: :repo }
    end

    policy "StartTheRedWakeWhileMainIsRed" do
      on      "RedWake.RedWakeWeighed"
      where   { standing == true && main_checkout == true }
      trigger RedWake::Start, with: { flag: :flag, run: :run, kind: :kind, repo: :repo, episode: :escalation }
    end

    policy "DeclineTheRedWakeWhileMainIsGreen" do
      on      "RedWake.RedWakeWeighed"
      where   { standing != true && main_checkout == true }
      trigger RedWake::Decline, with: { refusal: "main is not flagged: no red-main session starts" }
    end

    policy "DeclineTheRedWakeOutsideTheMainCheckout" do
      on      "RedWake.RedWakeWeighed"
      where   { main_checkout != true }
      trigger RedWake::Decline, with: { refusal: "not the main checkout: a red-main session starts only where its run is recorded" }
    end

    policy "DeclineTheUnweighedRedWake" do
      on      "RedWake.RedWakeUnweighed"
      trigger RedWake::Decline, with: { refusal: :refusal }
    end

    # Each brief asks for a report and an end: the session never waits blocked on an answer. Each
    # is a root: the session starts deeper than the reaction cap counts from the wake.
    policy "StartTheParkedEpisodeReport" do
      on      "RedWake.RedWakeStarted"
      root
      where   { kind == "EpisodeParked" }
      trigger AgentRun::Dispatch,
              with: { run: :run, repo: :repo, agent: "orchestrator", works_as: "red-wake", work: :episode,
                      brief: "A red main's episode parked: its range already holds a revert, so nothing was " \
                             "reverted and the red flag stands (RedFlag.status). Report the culprit and spec " \
                             "on the episode to the owner, under your standing rule all-hands-on-red, then end " \
                             "your turn. Never wait for an answer: a question for the owner goes in the report." }
    end

    policy "StartTheRefusedRevertReport" do
      on      "RedWake.RedWakeStarted"
      root
      where   { kind == "RevertRefused" }
      trigger AgentRun::Dispatch,
              with: { run: :run, repo: :repo, agent: "orchestrator", works_as: "red-wake", work: :episode,
                      brief: "A red main's revert was refused (a dirty or off-main checkout, or a failed git " \
                             "revert), so the red flag stands with no revert (RedFlag.status). Report the " \
                             "refusal to the owner, under your standing rule all-hands-on-red, then end your " \
                             "turn. Never wait for an answer: a question for the owner goes in the report." }
    end

    policy "StartTheUnmatchedCauseReport" do
      on      "RedWake.RedWakeStarted"
      root
      where   { kind != "EpisodeParked" && kind != "RevertRefused" }
      trigger AgentRun::Dispatch,
              with: { run: :run, repo: :repo, agent: "orchestrator", works_as: "red-wake", work: :episode,
                      brief: "A cause of a red main matches no known lesson while the red flag stands " \
                             "(RedFlag.status). Record it as a lesson and see that one coder holds the cause, " \
                             "under your standing rule all-hands-on-red, then end your turn. Never wait for an " \
                             "answer: a question for the owner goes in the report." }
    end

    # A red-main session reports and ends; one read blocked is ended at once, its question kept as
    # the detail, so the reap of a finished helper removes it. A pinned one or one being answered stays.
    policy "FinishTheBlockedRedWake" do
      on      "AgentRun.JobRead"
      root
      where   do
        state == "blocked" && run.start_with?("red-wake-") && pin_listed == false && resuming != true
      end
      trigger AgentRun::Finish, with: { condition: "abandoned", detail: :detail, checkout: :checkout }
    end

    # A session the board started by hand has no run to tidy, so it is removed on its own. The
    # rule is the same as Tidy's: only a finished session that waits on nobody goes.
    aggregate "PlainSession" do
      description "A Claude session started outside a dispatched run, which the operator may remove once it is finished. The Sessions port removes it."

      identified_by :session

      attribute :session, SessionId

      value_object "SessionId" do
        attribute :value, String, matches: :present
        invariant("a session has an id") { !value.to_s.empty? }
      end

      value_object "SessionCondition", String

      command "Remove" do
        role "Operator"
        goal "Remove a finished session that waits on nobody"

        attribute :condition, SessionCondition

        given("the session ended done or stopped: a working or blocked session is kept") do
          condition.value == "done" || condition.value == "stopped"
        end

        emits "RemoveRequested"
      end

      policy "RemoveWhenAsked" do
        on      "PlainSession.RemoveRequested"
        ask     :discard, with: { session: :session }
      end

      # Retires a session that no run holds, or whose run has ended. The port reads the facts first
      # (the run that holds it, whether that run is started, whether a pinned role names it, whether
      # it is working); the policies below judge them and either ask the port to retire or refuse by name.
      command "Retire" do
        role "Operator"
        goal "Retire a session bound to no run, so the fleet does not settle and re-claim it"

        attribute :session, SessionId
        attribute :reason, SessionReason, optional: true

        emits "SessionRetireRequested"
      end

      value_object "SessionReason", String

      command "RefuseRetirement" do
        role "System"
        goal "Record why a session was not retired"

        attribute :session, SessionId
        attribute :refusal, SessionReason

        emits "SessionRetirementRefused"
      end

      policy "ExamineBeforeRetiring" do
        on      "PlainSession.SessionRetireRequested"
        ask     :examine, with: { session: :session }
      end

      policy "RefuseTheSessionOfAPinnedRole" do
        on      "PlainSession.SessionExamined"
        where   { pinned == true }
        trigger PlainSession::RefuseRetirement, with: { session: :session, refusal: :note }
      end

      policy "RefuseTheSessionWorkingOnARun" do
        on      "PlainSession.SessionExamined"
        where   { bound == true && pinned != true && working == true }
        trigger PlainSession::RefuseRetirement, with: { session: :session, refusal: :note }
      end

      policy "RetireTheFreeSession" do
        on      "PlainSession.SessionExamined"
        where   { pinned != true && (bound != true || working != true) }
        ask     :withdraw, with: { session: :session }
      end
    end

    # Clearing away finished sessions in one cleanup. Only the session of a dispatched run is a
    # candidate: the AgentRun ledger binds a run to it, that run is `finished` with condition
    # `done`, the listing says `done` and no person spoke in it. A session with no run, a working
    # or blocked one, one a person stopped and the pruner's own (its run is still started) are kept
    # by name, whatever `claude agents` lists. A candidate is safe when its own worktree holds
    # nothing `claude rm` would lose; the port looks (the session list, the ledger, each
    # transcript, each worktree's files and commits) and removes with a plain `claude rm`, never
    # `--discard-unpushed`. The `Removable` query is the same reading with no removal, so what a
    # cleanup would do is seen first. Removing one session on its own stays with `AgentRun.Tidy`
    # and `PlainSession.Remove`.
    aggregate "SessionCleanup" do
      description "One cleanup of the Claude sessions: only the session of a dispatched run that finished done, with no person in it and nothing unsaved in its worktree, is removed; every other session is kept with the reason."

      attribute :run,   CleanupName
      attribute :confirm, Confirmation, optional: true
      attribute :report,  Summary, optional: true
      attribute :refusal, Summary, optional: true
      identified_by :run

      value_object "CleanupName" do
        attribute :value, String, matches: :present
      end

      value_object "Confirmation", Boolean

      value_object "Summary", String

      lifecycle :status, default: "requested" do
        mark :failure, "refused"
        transition "Record"  => "cleaned",   from: "requested"
        transition "Decline" => "refused", from: "requested"
        mark :terminal, "cleaned", "refused"
        # A finished cleanup frees its key, so a beat or landing that reuses a name starts a new one.
        mark :reusable, "cleaned", "refused"
      end

      command "RemoveSafe" do
        role "Operator"
        goal "Remove the sessions of dispatched runs that finished done and are safe to remove, and report each one kept with the reason; refused without confirm"

        attribute :run,   CleanupName, sets: true
        attribute :confirm, Confirmation, optional: true, sets: true

        given("the cleanup was confirmed: it removes sessions") { confirm.value == true }

        emits CleanupRequested
      end

      command "Record" do
        role "System"
        goal "Record which sessions the cleanup removed and which it kept"

        reference_to SessionCleanup
        attribute :report, Summary, sets: true

        emits CleanupRecorded
      end

      command "Decline" do
        role "System"
        goal "Record why the sessions could not be cleaned"

        reference_to SessionCleanup
        attribute :refusal, Summary, sets: true

        emits CleanupDeclined
      end

      # The mechanical cleanup. Every finished run is tidied in its own order (`AgentRun.Tidy`: kept
      # by name or its scratch cleared, its worktree retired, its session removed), then the unpinned
      # sessions no run holds, done or stopped with no worktree, once past the reaping window. The
      # report names what was removed and each session kept, with the reason. `ReapTurn` starts it,
      # one at a time; nobody removes a session by hand.
      command "Reap" do
        role "System"
        goal "Tidy every finished run's session and worktree in order, remove the old sessions no run holds, and report what was removed and kept"

        attribute :run, CleanupName, sets: true

        emits ReapRequested
      end

      query "Removable" do
        description "Every Claude session with whether it is safe to remove and, when not, why: no dispatched run holds it, its run is not finished done, it is not listed done, a person spoke in it, or its own worktree has uncommitted files or commits origin lacks. Reads only."
        returns Document
      end
    end

    # Two rules hold across every reap, so one record owns them (ADR 0081). A refused take costs
    # one rule and no port. The record is opened once per store: each cause opens it ahead of its
    # take, and an opening that finds it there is refused and benign.
    aggregate "ReapTurn" do
      description "The one turn to reap the finished sessions. A reap begins only when none is running, and a cause that names a spacing (the clock's beat: half an hour) begins one only when the last began that long ago; a session's end and a landing name none. The reap that ends frees the turn, and a turn held past the taker's lease, by a reap whose process died, is taken over."

      attribute :turn,     TurnKey
      attribute :run,      TurnKey, optional: true
      attribute :held,     Hold
      attribute :taken_at, TakenAt
      identified_by :turn

      value_object "TurnKey" do
        attribute :value, String, matches: :present
      end

      # One while a reap holds the turn, zero once it is freed.
      value_object "Hold" do
        attribute :value, Integer, default: 0
        invariant("a turn is held or free") { [0, 1].include?(value) }
      end

      # When the turn was last taken, in epoch seconds; zero before the first reap.
      value_object "TakenAt" do
        attribute :value, Integer, default: 0
        invariant("a time is not before the epoch") { !value.negative? }
      end

      # Seconds: the spacing a cause asks for since the last reap began, or the lease after which
      # a held turn is taken over.
      value_object "Span" do
        attribute :value, Integer, default: 0
        invariant("a span is not negative") { !value.negative? }
      end

      command "Open" do
        role "System"
        goal "Open the one turn of a store, free and never taken"

        attribute :turn, TurnKey, sets: true

        emits ReapTurnOpened
      end

      # `+` because a rule has no `-`: the sums stand for `now - taken_at >= lease` and
      # `now - taken_at >= spacing`.
      command "Take" do
        role "System"
        goal "Take the turn to reap for one cleanup, refused while another reap holds it or inside the spacing the cause names"

        reference_to ReapTurn
        attribute :run,     TurnKey, sets: true
        attribute :spacing, Span
        attribute :lease,   Span
        # `now:` is filled from the clock port; an explicit value wins.
        attribute :now, TakenAt
        needs :now

        given("no reap is running: the turn is free, or the reap that holds it has outlived its lease") do
          held.value == 0 || taken_at.value + lease.value <= now.value
        end
        given("the last reap began at least the spacing ago") do
          taken_at.value + spacing.value <= now.value
        end

        sets :held, to: { value: 1 }
        sets :taken_at, to: :now

        emits ReapTurnTaken
      end

      # A reap that outlived its lease and lost the turn, or one a person started by hand, ends
      # without freeing the turn of the reap that holds it now.
      command "Free" do
        role "System"
        goal "Free the turn when the reap that holds it has ended, so the next cause may reap"

        reference_to ReapTurn
        attribute :ended, TurnKey

        given("the reap that ended is the one that holds the turn") { !run.nil? && ended.value == run.value }

        sets :held, to: { value: 0 }

        emits ReapTurnFreed
      end
    end

    policy "MarkTheStartOfTheReap" do
      on      "SessionCleanup.ReapRequested"
      ask     :mark, with: { run: :run }
    end

    # A root: each run's tidy is a long chain (review, scratch, worktree, session) of its own.
    # `Tidyable` is read once, at `ReapMarked`: a run another reap tidied or retired since is still
    # sent `Tidy`, which moves a run only from `finished` and refuses it by name, as wanted.
    policy "TidyEveryFinishedRun" do
      on       "SessionCleanup.ReapMarked"
      root
      for_each "AgentRun.Tidyable"
      trigger  AgentRun::Tidy, with: { agent_run: :agent_run }
    end

    policy "RemoveTheOldSessionsNoRunHolds" do
      on      "SessionCleanup.ReapMarked"
      ask     :sweep_plain, with: { run: :run, since: :since }
    end

    # The landed branch's run has a worktree and a Work that just changed, so its wait ends and
    # the reap this landing starts reviews it. Declared ahead of that reap; a branch no finished
    # run is keyed by refuses, and nothing follows.
    policy "ReleaseTheRunWhoseWorkLanded" do
      on      "Landing.LandedWorkFound"
      trigger AgentRun::Release, with: { agent_run: :branch }
    end

    # Each cause of a reap opens the turn (refused, and benign, once it is there) and then asks
    # for it. The lease is an hour: a reap is over in minutes, and one that died frees nothing.
    policy "OpenTheReapTurnWhenWorkLands" do
      on      "Landing.LandedWorkFound"
      trigger ReapTurn::Open, with: { turn: "sessions" }
    end

    policy "ReapWhenWorkLands" do
      on      "Landing.LandedWorkFound"
      root
      trigger ReapTurn::Take, with: { reap_turn: "sessions", run: :branch, spacing: 0, lease: 3600 }
    end

    # The session of a run that ended is reviewed at once, not at the next beat. A run that
    # failed is left out: `Tidy` keeps a session that did not end done or stopped.
    policy "OpenTheReapTurnWhenASessionEnds" do
      on      "AgentRun.SessionFinished"
      trigger ReapTurn::Open, with: { turn: "sessions" }
    end

    policy "ReapWhenASessionEnds" do
      on      "AgentRun.SessionFinished"
      root
      trigger ReapTurn::Take, with: { reap_turn: "sessions", run: :run, spacing: 0, lease: 3600 }
    end

    # The backstop: a kept run whose wait passed, a session a person left, a cause refused while
    # a reap ran. The beat asks every minute and the turn answers once in half an hour.
    policy "OpenTheReapTurnOnHeartbeat" do
      on      "Heartbeat.Beaten"
      trigger ReapTurn::Open, with: { turn: "sessions" }
    end

    policy "ReapOnHeartbeat" do
      on      "Heartbeat.Beaten"
      root
      trigger ReapTurn::Take, with: { reap_turn: "sessions", run: :beat, spacing: 1800, lease: 3600 }
    end

    policy "ReapWhenTheTurnIsTaken" do
      on      "ReapTurn.ReapTurnTaken"
      trigger SessionCleanup::Reap, with: { run: :run }
    end

    # A reap ends reported or refused by the port, under events of its own, so its end is told
    # from that of a cleanup a person confirmed (`RemoveSafe`), which took no turn and frees none.
    # Either end is recorded on the cleanup and then frees the turn.
    policy "RecordTheReap" do
      on      "SessionCleanup.ReapReported"
      trigger SessionCleanup::Record, with: { report: :report }
    end

    policy "RecordTheRefusedReap" do
      on      "SessionCleanup.ReapRefused"
      trigger SessionCleanup::Decline, with: { refusal: :refusal }
    end

    policy "FreeTheTurnWhenTheReapIsReported" do
      on      "SessionCleanup.ReapReported"
      trigger ReapTurn::Free, with: { reap_turn: "sessions", ended: :run }
    end

    policy "FreeTheTurnWhenTheReapIsRefused" do
      on      "SessionCleanup.ReapRefused"
      trigger ReapTurn::Free, with: { reap_turn: "sessions", ended: :run }
    end

    policy "CleanWhenAsked" do
      on      "SessionCleanup.CleanupRequested"
      ask     :clean, with: { run: :run }
    end

    policy "RecordTheCleanup" do
      on      "SessionCleanup.CleanupReported"
      trigger SessionCleanup::Record, with: { report: :report }
    end

    policy "RecordTheDeclinedCleanup" do
      on      "SessionCleanup.CleanupRefused"
      trigger SessionCleanup::Decline, with: { refusal: :refusal }
    end

    # Marked or not, a stall fixer's (`stall-`) too, which agent-run-blocked never times. No other
    # orchestrator run asks: an answerer's minted key never starts `stall-`. [owner] and [review]
    # waits are not asked.
    aggregate "Question" do
      description "One question a blocked run asks the orchestrator: asked, seated with an orchestrator run that answers it, then closed when the run is answered or escalated as the owner's."

      identified_by :run

      attribute :run,  QuestionRun
      attribute :text, QuestionText

      value_object "QuestionRun" do
        attribute :value, String, matches: :present
        invariant("a question names the run that asks it") { !value.to_s.empty? }
      end

      value_object "QuestionText", String

      # `asked` waits for a seat; `seated` has an orchestrator run answering it. A question that
      # found no seat waits for the agent-run-blocked stall, which wakes the orchestrator; a
      # stall fixer's, which that stall never times, waits for the next seat to free.
      lifecycle :status, default: "asked" do
        transition "Seat"     => "seated",    from: "asked"
        transition "Close"    => "closed",    from: "seated"
        transition "Drop"     => "dropped",   from: "asked"
        transition "Escalate" => "escalated", from: "seated"
        # `released`: the answerer seated for it ended or failed to start without answering, so
        # the run still waits on its question and the seat is free; it is neither closed nor the
        # owner's, and the agent-run-blocked stall times the run as before.
        transition "Release"  => "released",  from: "seated"
        mark :terminal, "closed", "dropped", "escalated", "released"
        mark :reusable, "closed", "dropped", "escalated", "released"
      end

      command "Ask" do
        role "System"
        goal "Record the question a blocked run asks the orchestrator"

        attribute :run,  QuestionRun, sets: true
        attribute :text, QuestionText, sets: true

        emits "QuestionAsked"
      end

      command "Seat" do
        role "System"
        goal "Record that an orchestrator run was seated to answer the question"

        reference_to Question

        emits "QuestionSeated"
      end

      command "Close" do
        role "System"
        goal "Close a seated question once its run was answered or moved on"

        reference_to Question

        emits "QuestionClosed"
      end

      command "Drop" do
        role "System"
        goal "Drop a question no run was seated for once its run was answered or moved on"

        reference_to Question

        emits "QuestionDropped"
      end

      # The orchestrator's verb for a question whose answer is the owner's: it plans the work item
      # `needs an answer: <run>` with one [owner] line, which the Waiting-on-you panel lists, and
      # escalates the question, which frees its seat. Nobody answers the run in its place.
      command "Escalate" do
        role "Operator"
        goal "Hand a seated question to the owner, unanswered, and free its seat"

        reference_to Question

        emits "QuestionEscalated"
      end

      command "Release" do
        role "System"
        goal "Free the seat of a question whose answerer ended or failed without answering it"

        reference_to Question

        emits "QuestionReleased"
      end

      query "Open" do
        description "Every question still waiting on an answer, asked or seated."
        where(status: { in: "asked,seated" })
        order_by :run
      end

      # The seated question one run asks, so a reaction to any run's end or answer closes it when
      # there is one and fires nothing when the run asked none.
      query "SeatedOfRun" do
        description "The seated question one run asks, when it asks one."
        attribute :run, QuestionRun
        where(status: "seated", run: :run)
      end

      # The seated question an answerer serves, found by the answerer's `work`, the run that asks.
      query "SeatedOfWork" do
        description "The seated question of the run an answerer works for, when it is still seated."
        attribute :work, QuestionRun
        where(status: "seated", run: :work)
      end

      # The question one run asks, in any state, so an answerer reads the one question it serves.
      query "OfRun" do
        description "The question one run asks, whatever its state."
        attribute :run, QuestionRun
        where(run: :run)
      end

      # The question one run asks that has found no seat yet, which the run's end or answer drops.
      query "AskedOfRun" do
        description "The question one run asks that waits for a seat, when it asks one."
        attribute :run, QuestionRun
        where(status: "asked", run: :run)
      end

      policy "AskTheOrchestratorWhenBlocked" do
        on      "AgentRun.JobRead"
        root
        where   do
          state == "blocked" && previous != state && (agent != "orchestrator" || run.start_with?("stall-")) &&
            !detail.start_with?("[owner]") && !detail.start_with?("[review]")
        end
        trigger Question::Ask, with: { run: :run, text: :detail }
      end

      policy "OpenTheAnswerDesk" do
        on      "Question.QuestionAsked"
        trigger AnswerDesk::Open, with: { desk: "orchestrator", run: :run }
      end

      policy "TakeAnAnswerSeat" do
        on      "Question.QuestionAsked"
        trigger AnswerDesk::Take, with: { desk: "orchestrator", run: :run }
      end

      policy "SeatTheQuestion" do
        on      "AnswerDesk.AnswerSeatTaken"
        trigger Question::Seat, with: { run: :run }
      end

      policy "SeatTheFirstQuestion" do
        on      "AnswerDesk.AnswerDeskOpened"
        trigger Question::Seat, with: { run: :run }
      end

      # The answerer is an orchestrator run, its key minted, its `work` and its parent the run it answers. It is a
      # root: its start sits deeper than the reaction cap counts from the job reading.
      policy "StartTheAnswererWhenSeated" do
        on      "Question.QuestionSeated"
        root
        trigger AgentRun::Dispatch,
                with: { repo: ".", agent: "orchestrator", works_as: "answerer", work: :run, parent: :run,
                        brief: "A run is blocked on a question for you. Your own run is listed by " \
                               "AgentRun.answering (at most two rows, newest first: the first is yours) and its work is the " \
                               "blocked run; Question.of_run run=<that run> reads its question. Answer it with AgentRun.answer! under your standing rule " \
                               "answer-within-the-brief, or escalate it when the answer is the owner's. " \
                               "Never answer for the owner a push, promote, release, plan confirmation, " \
                               "secret, account or login: escalate those. " \
                               "When the ledger, the code and the standing rules do not answer it, never wait " \
                               "and never ask: Work.plan! one work item titled 'needs an answer: <run>' with the " \
                               "question as its detail, Question.escalate! it, and end at once with " \
                               "'cannot answer: <why>. escalated'. " \
                               "End your turn with the word answered or escalated." }
      end

      # A blocked answerer cannot answer, and a clear no is an answer: it ends `abandoned` at its
      # first blocked read after its start was read, its question kept as the detail, so it never
      # holds a session or a seat while it waits.
      policy "EndTheAnswererThatCannotAnswer" do
        on      "AgentRun.JobRead"
        root
        where   { state == "blocked" && previous != "" && works_as == "answerer" && resuming != true }
        trigger AgentRun::Finish, with: { condition: "abandoned", detail: :detail, checkout: :checkout }
      end

      # The question a blocked answerer served goes to the owner once: escalated, which frees its
      # seat. A question already closed or escalated refuses, and nothing else changes.
      policy "EscalateTheQuestionOfABlockedAnswerer" do
        on      "AgentRun.JobRead"
        root
        where   { state == "blocked" && previous != "" && works_as == "answerer" && resuming != true }
        trigger Question::Escalate, with: { run: :work }
      end

      # An answerer working past the reaping line's `answer_after_minutes` is out of time: it ends
      # `abandoned`, and its question goes to the owner once, as a blocked answerer's does.
      policy "EndTheOverdueAnswerer" do
        on      "AgentRun.JobRead"
        root
        where   do
          state == "working" && works_as == "answerer" && answer_after > 0 && running_minutes >= answer_after &&
            resuming != true
        end
        trigger AgentRun::Finish, with: { condition: "abandoned", detail: "cannot answer: out of time", checkout: :checkout }
      end

      policy "EscalateTheQuestionOfAnOverdueAnswerer" do
        on      "AgentRun.JobRead"
        root
        where   do
          state == "working" && works_as == "answerer" && answer_after > 0 && running_minutes >= answer_after &&
            resuming != true
        end
        trigger Question::Escalate, with: { run: :work }
      end

      # An answerer that ended, failed (or could not start) or closed with its word releases a question
      # still seated: an answer closed it, a block escalated it. `JobRead` is the one read of a run's
      # end that carries its `works_as` and `work`.
      policy "ReleaseTheQuestionOfAnAnswererThatEnded" do
        on       "AgentRun.JobRead"
        root
        where    { works_as == "answerer" && resuming != true && (state == "failed" || state == "done" || state == "stopped") }
        for_each "Question.SeatedOfWork"
        trigger  Question::Release, with: { run: :work }
      end

      policy "ReleaseTheQuestionOfAnAnswererThatClosed" do
        on       "AgentRun.JobRead"
        root
        where    do
          state == "working" && listed == "idle" && resuming != true && works_as == "answerer" &&
            (report.rstrip.end_with?("answered") || report.rstrip.end_with?("escalated"))
        end
        for_each "Question.SeatedOfWork"
        trigger  Question::Release, with: { run: :work }
      end

      policy "FreeTheSeatOfAReleasedQuestion" do
        on      "Question.QuestionReleased"
        trigger AnswerDesk::Free, with: { desk: "orchestrator" }
      end

      # Every run's answer, end and failure looks its question up: a run that asked none finds no
      # row, so nothing fires and nothing is refused; a seated question is closed, an asked one dropped.
      policy "CloseTheAnsweredQuestion" do
        on       "AgentRun.AgentRunAnswered"
        for_each "Question.SeatedOfRun"
        trigger  Question::Close, with: { run: :run }
      end

      policy "DropTheAnsweredQuestion" do
        on       "AgentRun.AgentRunAnswered"
        for_each "Question.AskedOfRun"
        trigger  Question::Drop, with: { run: :run }
      end

      policy "CloseTheQuestionOfAnEndedRun" do
        on       "AgentRun.SessionFinished"
        for_each "Question.SeatedOfRun"
        trigger  Question::Close, with: { run: :run }
      end

      policy "DropTheQuestionOfAnEndedRun" do
        on       "AgentRun.SessionFinished"
        for_each "Question.AskedOfRun"
        trigger  Question::Drop, with: { run: :run }
      end

      policy "CloseTheQuestionOfAFailedRun" do
        on       "AgentRun.SessionFailed"
        for_each "Question.SeatedOfRun"
        trigger  Question::Close, with: { run: :run }
      end

      policy "DropTheQuestionOfAFailedRun" do
        on       "AgentRun.SessionFailed"
        for_each "Question.AskedOfRun"
        trigger  Question::Drop, with: { run: :run }
      end

      policy "FreeTheSeatOfAClosedQuestion" do
        on      "Question.QuestionClosed"
        trigger AnswerDesk::Free, with: { desk: "orchestrator" }
      end

      policy "FreeTheSeatOfAnEscalatedQuestion" do
        on      "Question.QuestionEscalated"
        trigger AnswerDesk::Free, with: { desk: "orchestrator" }
      end

      # The answerer closes with its word, as a coder closes with `submitted`: an orchestrator run
      # otherwise idles between beats and is never read finished.
      policy "RecordTheAnswerersEnd" do
        on      "AgentRun.JobRead"
        root
        where   do
          state == "working" && listed == "idle" && resuming != true && previous != "done" && agent == "orchestrator" &&
            (report.rstrip.end_with?("answered") || report.rstrip.end_with?("escalated"))
        end
        trigger AgentRun::Finish, with: { condition: "done", detail: :report, checkout: :checkout }
      end
    end

    # The seats of the orchestrator runs that answer questions: at most two at once, so a burst of
    # blocked runs cannot start a crowd of orchestrators. A question that finds no seat waits for the
    # agent-run-blocked stall, a stall fixer's for the next seat to free. The one desk is created by the first question; `last` names the
    # question that took the latest seat, so the first question, seated by `Open`, is not seated again
    # by `Take` whichever of the two reacts first.
    aggregate "AnswerDesk" do
      description "The seats of the orchestrator runs that answer questions, at most two taken at once."

      identified_by :desk

      attribute :desk,   DeskName
      attribute :seated, Seats
      attribute :last,   SeatedRun

      value_object "DeskName" do
        attribute :value, String, matches: :present
        invariant("a desk has a name") { !value.to_s.empty? }
      end

      value_object "Seats" do
        attribute :value, Integer, default: 0
        invariant("seats taken are not negative") { !value.negative? }
      end

      value_object "SeatedRun" do
        attribute :value, String, default: ""
      end

      command "Open" do
        role "System"
        goal "Open the desk with its first seat taken by the question that found it missing"

        attribute :desk, DeskName, sets: true
        attribute :run,  SeatedRun

        sets :seated, to: { value: 1 }
        sets :last, to: :run

        emits "AnswerDeskOpened"
      end

      command "Take" do
        role "System"
        goal "Take a seat for a question, refused while two are taken"

        reference_to AnswerDesk
        attribute :run, SeatedRun

        given("at most two answerers run at once") { seated.value < 2 }
        given("the question does not hold the latest seat already") { last.value != run.value }

        sets :seated, increment: { value: 1 }
        sets :last, to: :run

        emits "AnswerSeatTaken"
      end

      command "Free" do
        role "System"
        goal "Free the seat of a question that was answered or escalated"

        reference_to AnswerDesk

        given("a seat is taken") { seated.value.positive? }

        sets :seated, decrement: { value: 1 }
        sets :last, to: { value: "" }

        emits "AnswerSeatFreed"
      end

      query "Desks" do
        description "The desk and how many of its seats are taken."
        order_by :desk
      end
    end
  end
end
