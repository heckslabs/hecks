Hecks.bluebook "Hecks" do
  domain_module "Deliver" do
    vision "Take finished work into the shared line."

    # How this copy of Hecks is set up, read and never written. What a checkout holds in git (its
    # branch, changes and history) is the delivery package's `Workspace`, attached from `vendor/`;
    # these three questions are about Hecks itself and stay here.
    aggregate "Workspace" do
      description "A look at how this copy of Hecks is set up: its settings, its stores and whether it can run here."
      acknowledges :no_command_surface, "a look at a copy: it answers how the copy is set up and changes nothing"

      attribute :checkout, Place
      identified_by :checkout

      # A directory inside the repository; the current directory when a query names none.
      value_object "Place" do
        attribute :value, String, matches: :present
      end

      value_object "Document" do
        attribute :text, String
      end

      query "Settings" do
        description "What this copy resolves for each setting that can come from a variable, its own world or a default, and which one supplied it."
        attribute :domain, Place, optional: true
        returns Document
      end

      query "Doctor" do
        description "Whether this checkout can run Hecks here: overlay files parse, the stores answer, the toolchain pin matches, and what this worktree cannot see."
        attribute :domain, Place, optional: true
        returns Document
      end

      query "Where" do
        description "Where this checkout's domain resolves: the store each bluebook uses and why, the audience and environment with their reasons, and any overlay file this worktree lacks."
        attribute :domain, Place, optional: true
        returns Document
      end
    end

    # The changed files of a checkout that already match `origin/main`, put back so the checkout can take a pull:
    # asked of the git port, then recorded or declined. A file that differs from `origin/main` is never touched.
    aggregate "Restoration" do
      description "The changed files of a checkout that already match origin/main, restored, or declined with the reason."

      attribute :run,      RunKey
      attribute :checkout, Word,   optional: true
      attribute :report,   Report, optional: true
      attribute :refusal,  Report, optional: true
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      # A directory inside the repository.
      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Report", String

      lifecycle :status, default: "requested" do
        mark :failure, "declined"
        transition "Record"  => "restored", from: "requested"
        transition "Decline" => "declined", from: "requested"
        mark :terminal, "restored", "declined"
      end

      command "Make" do
        role "Operator"
        goal "Restore each changed file of a checkout that already matches origin/main, and leave every other file alone"

        attribute :run,      RunKey, sets: true
        attribute :checkout, Word, optional: true, sets: true

        emits RestoreRequested
      end

      command "Record" do
        role "System"
        goal "Record which changed files a checkout restored"

        reference_to Restoration
        attribute :report, Report, sets: true

        emits RestoreRecorded
      end

      command "Decline" do
        role "System"
        goal "Record why nothing could be restored"

        reference_to Restoration
        attribute :refusal, Report, sets: true

        emits RestoreDeclined
      end
    end

    # CI's failing checks, run at landing in a fresh `--depth 1` clone of the branch tip, so a red that only a
    # shallow history, a load order or a missing git identity shows is caught before it reaches main. `Landing.finish!`
    # asks the same port after the quick gate; `ShallowCheck.run!` is the rehearsal. A branch that changes nothing
    # the checks read (docs only) is skipped without a clone. It is on from the first landing; `ShallowCheck.switch!`
    # with `state.value=off` turns it off for the repository and `state.value=on` back on.
    aggregate "ShallowCheck" do
      description "CI's failing checks run in a depth-1 clone of a branch: passed or skipped, or refused with the spec and its first failure line."

      attribute :run,      RunKey
      attribute :checkout, Word,   optional: true
      attribute :branch,   Word,   optional: true
      attribute :onto,     Word,   optional: true
      attribute :state,    Word,   optional: true
      attribute :report,   Report, optional: true
      attribute :refusal,  Report, optional: true
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      # A branch, a directory, or `on` or `off`.
      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Report", String

      lifecycle :status, default: "requested" do
        mark :failure, "refused"
        transition "Pass"   => "passed",  from: "requested"
        transition "Refuse" => "refused", from: "requested"
        mark :terminal, "passed", "refused"
      end

      command "Run" do
        role "Operator"
        goal "Run CI's failing checks in a depth-1 clone of a branch when it changes something they read, refusing with the spec and its first failure line"

        attribute :run,      RunKey, sets: true
        attribute :checkout, Word, optional: true, sets: true
        attribute :branch,   Word, optional: true, sets: true
        attribute :onto,     Word, default: "main", sets: true

        emits ShallowCheckRequested
      end

      command "Switch" do
        role "Operator"
        goal "Turn the shallow check on or off for the whole repository"

        attribute :run,      RunKey, sets: true
        attribute :checkout, Word, optional: true, sets: true
        attribute :state,    Word, sets: true

        given("the switch is on or off") { state.value == "on" || state.value == "off" }

        emits ShallowSwitchRequested
      end

      command "Pass" do
        role "System"
        goal "Record that the checks passed, or why none ran"

        reference_to ShallowCheck
        attribute :report, Report, sets: true

        emits ShallowCheckPassed
      end

      command "Refuse" do
        role "System"
        goal "Record which spec was red in the clone and its first failure line"

        reference_to ShallowCheck
        attribute :refusal, Report, sets: true

        emits ShallowCheckDeclined
      end
    end

    # Lands a branch on main once its checkout's gate passes: the Gate port judges the checkout, then
    # the branch lands and boards the push train. What the gate holds is the checkout's own business
    # (ADR 0205): this bluebook names no check, and nothing here edits the branch, so an offense a
    # fix command would mend still stops the gate. A refusal parks the instance in needs_human; a
    # person mends the branch and asks for the gate again (`Shipment.Rejudge`).
    # A saga cannot dispatch when it starts, so a policy asks the gate. It hears ShipStarted, emitted
    # after ShipRequested is handled, because policies run before sagas for one event: on ShipRequested
    # the gate would answer before the saga exists to hear it.
    policy "JudgeWhenShipStarted" do
      on      "Shipment.ShipStarted"
      ask     :judge, with: { run: :run }
    end

    policy "JudgeWhenRejudging" do
      on      "Shipment.JudgementRequested"
      ask     :judge, with: { run: :run }
    end

    process_manager "GateAndBoard" do
      correlates_by :"run.value"
      starts_on Shipment::ShipRequested

      # The command a caller dispatches to resume each stage of a faulted run (`hecks resume`).
      resumes "judging=Shipment.Rejudge"
      resumes "landing=Landing.Land"
      resumes "boarding=SendTrain.Board"

      # Each step records itself and waits. The caller dispatches the next command at top level:
      # Landing.Land once the gate answered, then SendTrain.Board. A stage dispatched from inside
      # this saga would run past the reaction depth bound, so the saga dispatches only
      # Shipment.Stop, a record with no reaction in this domain.
      transition Shipment::JudgementAnswered => "landing", from: %w[judging needs_human]
      transition Landing::BranchLanded => "boarding", from: "landing"

      transition SendTrain::BranchPushed => "boarded", from: "boarding"
      transition SendTrain::CarriedByEarlierPush => "boarded", from: "boarding"
      transition SendTrain::BoardingQueued => "boarded", from: "boarding"

      # A faulted boarding of this shipment records the park as Shipment.Stop, which Tickets files
      # as a stopped run; a boarding that faults outside a shipment takes no leg here. The caller
      # dispatches SendTrain.Board at top level, so Stop and the finding stay inside the reaction
      # depth bound. A refused gate carries its reason in the refusal the caller reads, as a refused
      # landing does, and records nothing more.
      transition Shipment::JudgementRefused => "needs_human", from: "judging"
      transition Landing::LandingRefused => "needs_human", from: "landing"
      transition SendTrain::PushFaulted => "needs_human", from: "boarding" do
        dispatch Shipment::Stop, with: { shipment: :run, stage: "boarding", refusal: :refusal }
      end
    end

    # CI starts early: a landed coder branch is pushed as `ci/<branch>` with a draft pull request that is
    # never merged, so CI runs while the next piece starts. The record holds the branch, the draft's number,
    # and what CI said (passed or failed with the failing specs and the first error line). The push, the
    # draft and the CI read are the ports' work (never main, never forced, never --no-verify); this
    # aggregate only keeps their outcome and answers the coder that cut the branch.
    aggregate "EarlyCi" do
      description "One landed branch pushed as ci/<branch> with a draft pull request, and what CI said of it."

      attribute :run,       RunKey
      attribute :branch,    Word
      attribute :early_ci,  Switch, default: { value: true }
      attribute :agent_run, Word,   optional: true
      attribute :work,      Word,   optional: true
      attribute :number,    Word,   optional: true
      attribute :outcome,   Verdict, optional: true
      attribute :report,    Report, optional: true
      attribute :refusal,   Report, optional: true
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      # A branch, a Work item key, an agent run key or a pull request number.
      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Switch", Boolean

      value_object "Verdict" do
        attribute :value, String, pattern: '\A(passed|failed)\z'
      end

      value_object "Report", String

      lifecycle :status, default: "requested" do
        mark :failure, "declined"
        transition "Open"    => "opened",   from: "requested"
        transition "Observe" => "observed", from: "opened"
        transition "Close"   => "closed",   from: %w[requested opened observed]
        transition "Decline" => "declined", from: %w[requested opened]
        mark :terminal, "closed", "declined"
      end

      command "Start" do
        role "System"
        goal "Record that a landed branch is to be pushed as ci/<branch> for an early CI run; off, nothing starts"

        attribute :run,       RunKey, sets: true
        attribute :branch,    Word, sets: true
        attribute :early_ci,  Switch, default: { value: true }, sets: true
        attribute :agent_run, Word, optional: true, sets: true
        attribute :work,      Word, optional: true, sets: true

        given("the world switch delivery early_ci is on") { early_ci.value == true }
        given("a branch other than main is pushed") { branch.value != "main" }

        emits EarlyCiStarted
      end

      command "Open" do
        role "System"
        goal "Record the draft pull request opened from ci/<branch>; it is never merged"

        reference_to EarlyCi
        attribute :number, Word, sets: true

        emits EarlyCiOpened
      end

      command "Observe" do
        role "System"
        goal "Record what CI said of ci/<branch>: passed, or failed with the failing specs and the first error line"

        reference_to EarlyCi
        attribute :outcome, Verdict, sets: true
        attribute :report,  Report, sets: true

        emits EarlyCiObserved
      end

      command "Close" do
        role "System"
        goal "Record that the push train carried the commits, so the draft is closed and ci/<branch> deleted"

        reference_to EarlyCi

        emits EarlyCiClosed
      end

      command "Decline" do
        role "System"
        goal "Record why the early CI push or draft could not be made"

        reference_to EarlyCi
        attribute :refusal, Report, sets: true

        emits EarlyCiDeclined
      end
    end

    # Main itself is not a branch to push as ci/<branch>: a tip no run covers, which the integration
    # adopts (`Landing.Adopt`, from `Integration::Adoption`), is recorded as landed on main and
    # starts no early CI.
    policy "StartEarlyCiWhenBranchLanded" do
      on      "Landing.BranchLanded"
      where   { branch.value != "main" }
      trigger EarlyCi::Start, with: { run: :run, branch: :branch }
    end

    # The failing specs go back to the coder run that cut the branch, resuming it under the same session.
    policy "TellTheCoderWhenCiFailed" do
      on      "EarlyCi.EarlyCiObserved"
      where   { outcome.value == "failed" }
      trigger AgentRun::Answer, with: { run: :agent_run, answer: :report }
    end

    # A coder's submitted branch is landed without the coder: the run is keyed by the submitted
    # commit. A root, as `SubmitWhenTheCoderSaysSubmitted` in the Hecks hecksagon is: counted from the
    # check that read the coder's job, the job's start sits past the reaction depth limit. The same
    # event starts QualityControl's maintenance of main (StartOnSubmission), which gates and
    # reconciles main as it stands and takes no place in the landing line: the two do not contend.
    # A second submission of one commit is refused by the run key, so one commit has one job.
    policy "LandWhenWorkIsSubmitted" do
      on      "Submission.WorkSubmitted"
      root
      trigger Landing::Submit, with: { run: :sha, checkout: :checkout, branch: :branch, confirm: true }
    end

    # A job's landing that was refused for a cause a coder can fix, a conflict or a quick gate red
    # on the branch, goes back to a coder: the LandedWork port finds the finished Work item the
    # landing's branch names, and the Tickets bluebook plans it again with the reason
    # (ReopenWorkWhenLandingRefused). A busy queue and a red main are no coder's to fix: the job
    # tries those again and no Work item moves. A finish a person ran is theirs to read and fix.
    policy "FindWorkWhenTheJobsLandingIsRefused" do
      on      "Landing.CarryRefused"
      where   { refusal.value.include?("conflict: ") || refusal.value.include?("gate red: ") }
      ask     :find_refused_work, with: { run: :run, refusal: :refusal }
    end

    # A landed branch finishes the Work item it was cut for. The LandedWork port finds the open Work item the
    # branch names (the whole branch name, else the name without a leading `qa/`) and answers its key;
    # a branch with no open Work item is refused by the port and nothing follows. The Tickets bluebook finishes
    # the Work item that was found (FinishWorkWhenBranchLanded).
    policy "FindWorkWhenBranchLanded" do
      on      "Landing.BranchLanded"
      ask     :find_landed_work, with: { branch: :branch }
    end

    # A restore that was asked for is made by the git port, which answers with what it restored or refuses with why.
    policy "RestoreWhenMade" do
      on      "Restoration.RestoreRequested"
      ask     :restore, with: { run: :run }
    end

    policy "RecordTheRestoration" do
      on      "Restoration.RestoreAnswered"
      trigger Restoration::Record, with: { report: :report }
    end

    policy "DeclineTheRestoration" do
      on      "Restoration.RestoreRefused"
      trigger Restoration::Decline, with: { refusal: :refusal }
    end

    policy "CheckShallowWhenRequested" do
      on      "ShallowCheck.ShallowCheckRequested"
      ask     :shallow_check, with: { run: :run }
    end

    policy "SwitchShallowWhenRequested" do
      on      "ShallowCheck.ShallowSwitchRequested"
      ask     :shallow_switch, with: { run: :run }
    end

    policy "RecordTheShallowPass" do
      on      "ShallowCheck.ShallowCheckAnswered"
      trigger ShallowCheck::Pass, with: { report: :report }
    end

    policy "RecordTheShallowSwitch" do
      on      "ShallowCheck.ShallowSwitchAnswered"
      trigger ShallowCheck::Pass, with: { report: :report }
    end

    policy "RecordTheShallowRefusal" do
      on      "ShallowCheck.ShallowCheckRefused"
      trigger ShallowCheck::Refuse, with: { refusal: :refusal }
    end

    policy "RecordTheRefusedShallowSwitch" do
      on      "ShallowCheck.ShallowSwitchRefused"
      trigger ShallowCheck::Refuse, with: { refusal: :refusal }
    end

    # The copy of Hecks that runs the train follows what it pushed, so the next boarding and the
    # records it keeps run the code that landed, not the code that was there when it was set up.
    # It reacts to the recorded push and takes the pushed commit from it.
    policy "KeepTheLauncherCurrent" do
      on      "SendTrain.BranchPushed"
      ask     :refresh, with: { run: :run, pushed: :pushed }
    end

    # Many agents finish together and each would push, running every pre-push check at once. A
    # boarding waits its turn behind the push in flight from the same repository, then pushes the
    # local branch with whatever else has landed on it, or finds an earlier push already carried it.
    aggregate "SendTrain" do
      description "One push of a checkout's branch, taken in turn: carried by an earlier push, pushed, or refused."

      attribute :run,      RunKey
      attribute :confirm, Switch, optional: true
      attribute :branch,   Word,   optional: true
      attribute :remote,   Word,   optional: true
      attribute :checkout, Word,   optional: true
      attribute :commit,   Word,   optional: true
      attribute :full_gate, Switch, optional: true
      attribute :boarded,  Word,   optional: true
      attribute :pushed,   Word,   optional: true
      attribute :commits,  Count,  optional: true
      attribute :report,   Report, optional: true
      attribute :refusal,  Report, optional: true
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      # A branch, a remote, a directory or a commit.
      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Report", String

      value_object "Switch", Boolean

      # How many commits the branch held that the remote did not, as the boarding began.
      value_object "Count" do
        attribute :value, Integer
        invariant("a count is not negative") { !value.negative? }
      end

      lifecycle :status, default: "requested" do
        mark :failure, "faulted", "red"
        transition "Send"  => "pushed",  from: "requested"
        transition "Ride"  => "carried", from: "requested"
        transition "Queue" => "queued",  from: "requested"
        transition "Fault" => "faulted", from: "requested"
        transition "Summarize" => "surveyed", from: "requested"
        transition "Fail"  => "red",     from: "queued"
        transition "Merge" => "pushed", from: %w[queued red]
        mark :terminal, "carried", "faulted", "pushed", "surveyed"
      end

      command "Board" do
        role "Operator"
        goal "Push this checkout's branch once the push ahead of it lands, unless that push already carried it"

        attribute :run,       RunKey, sets: true
        attribute :branch,    Word, default: "main", sets: true
        attribute :remote,    Word, default: "origin", sets: true
        attribute :checkout,  Word, optional: true, sets: true
        # The commit to board when it is not the branch's head: an older commit already on the
        # branch, the commits above it staying local. Absent, the head is boarded.
        attribute :commit,    Word, optional: true, sets: true
        # Run the whole `pre_push` stage, the suite included, which also writes the CI attestation
        # note; without it the push runs only the `quick` stage.
        attribute :full_gate, Switch, optional: true, sets: true
        attribute :confirm,   Switch, optional: true, sets: true

        given("pushes the branch to the remote needs --confirm; without it this only reports") { confirm.value == true }

        emits BoardingRequested
      end

      # A survey pushes nothing: it lists every checkout under a directory (`checkout`) whose branch
      # has commits its remote does not, so what waits to board is known before anything boards.
      command "Survey" do
        role "Operator"
        goal "List every checkout under a directory whose branch has commits its remote does not"

        attribute :run,      RunKey, sets: true
        attribute :remote,   Word, default: "origin", sets: true
        attribute :checkout, Word, optional: true, sets: true

        emits SurveyRequested
      end

      command "Summarize" do
        role "System"
        goal "Record what a survey found waiting to push"

        reference_to SendTrain
        attribute :report, Report, sets: true

        emits CheckoutsSurveyed
      end

      # The branch was pushed: every commit on it reached the remote, what this boarding carried and
      # whatever landed on it while it waited.
      command "Send" do
        role "System"
        goal "Record the commit a boarding pushed"

        reference_to SendTrain
        attribute :checkout, Word, sets: true
        attribute :boarded,  Word, sets: true
        attribute :pushed,   Word, sets: true
        attribute :commits,  Count, optional: true, sets: true
        attribute :report,   Report, sets: true

        emits BranchPushed
      end

      # An earlier push already took the boarded commit to the remote, so this one pushed nothing.
      command "Ride" do
        role "System"
        goal "Record that an earlier push already carried the boarded commit"

        reference_to SendTrain
        attribute :checkout, Word, sets: true
        attribute :boarded,  Word, sets: true
        attribute :report,   Report, sets: true

        emits CarriedByEarlierPush
      end

      # The boarded commit is a pull request into main, which GitHub merges once its checks pass.
      command "Queue" do
        role "System"
        goal "Record that a boarding was queued as a pull request, for CI to judge before main moves"

        reference_to SendTrain
        attribute :checkout, Word, sets: true
        attribute :boarded,  Word, sets: true
        attribute :commits,  Count, optional: true, sets: true
        attribute :report,   Report, sets: true

        emits BoardingQueued
      end

      # A queued boarding's pull request merged: the merge commit is what reached main, so the push
      # is recorded from it, and the launcher refresh and the deploy announcement follow.
      command "Merge" do
        role "System"
        goal "Record that a queued boarding's pull request merged, and the commit that reached main"

        reference_to SendTrain
        attribute :checkout, Word, sets: true
        attribute :boarded,  Word, sets: true
        attribute :pushed,   Word, sets: true
        attribute :commits,  Count, optional: true, sets: true
        attribute :report,   Report, sets: true

        emits BranchPushed
      end

      # Asks the train whether a queued boarding's pull request has merged. Nothing changes while it is open.
      command "Watch" do
        role "Operator"
        goal "Look at each queued boarding's pull request, and record any that merged or ended with failed checks"

        reference_to SendTrain

        emits ObserveRequested
      end

      # A queued boarding's required checks ended red: its pull request stays open, and a later
      # watch still records the merge if the checks come right. It moves to `red` so a tick names it once.
      command "Fail" do
        role "System"
        goal "Record that a queued boarding's pull request ended with failed checks, naming the failed jobs"

        reference_to SendTrain
        attribute :report, Report, sets: true

        emits TrainChecksFailed
      end

      command "Fault" do
        role "System"
        goal "Record why a boarding could not push"

        reference_to SendTrain
        attribute :refusal, Report, sets: true

        emits PushFaulted
      end

      query "Outcome" do
        description "How one boarding ended: pushed, carried by an earlier push, or why it failed."
        attribute :run, RunKey
        where(run: :run)
        order_by :run
      end

      # The boardings whose pull request has not merged yet: what `Watch` checks on each QA tick.
      query "Queued" do
        description "Every boarding queued as a pull request, red ones too, oldest key first; `Watch` records any that merged or ended red."
        where(status: { in: "queued,red" })
        order_by :run
      end
    end

    # A boarding is carried by the train, which runs its steps in order while it holds the line: the
    # Hecks domain's mint, then the settlement and the push. A shape that did not move passes straight
    # through; a refused mint is the train's refusal, named, and nothing is pushed.
    policy "CarryWhenBoarded" do
      on      "SendTrain.BoardingRequested"
      ask     :carry, with: { run: :run }
    end

    policy "RecordThePush" do
      on      "SendTrain.TrainAnswered"
      where   { outcome.value == "pushed" }
      trigger SendTrain::Send, with: { checkout: :checkout, boarded: :boarded, pushed: :pushed, commits: :commits,
                                       report: :report }
    end

    policy "RecordTheRide" do
      on      "SendTrain.TrainAnswered"
      where   { outcome.value == "carried" }
      trigger SendTrain::Ride, with: { checkout: :checkout, boarded: :boarded, report: :report }
    end

    policy "RecordTheQueuedBoarding" do
      on      "SendTrain.TrainAnswered"
      where   { outcome.value == "queued" }
      trigger SendTrain::Queue, with: { checkout: :checkout, boarded: :boarded, commits: :commits, report: :report }
    end

    # A repository that disallows auto-merge has the train wait for the PR's required checks and
    # squash-merge it when green (an answer of `pushed`, recorded above). A required check that
    # failed is a fault whose refusal names the failed checks; the PR stays open and no admin
    # override is used.
    policy "RecordTheFailedChecks" do
      on      "SendTrain.TrainAnswered"
      where   { outcome.value == "checks_failed" }
      trigger SendTrain::Fault, with: { refusal: :report }
    end

    policy "RecordTheRefusedPush" do
      on      "SendTrain.TrainRefused"
      trigger SendTrain::Fault, with: { refusal: :refusal }
    end

    policy "SurveyWhenAsked" do
      on      "SendTrain.SurveyRequested"
      ask     :tally, with: { run: :run }
    end

    policy "RecordTheSurvey" do
      on      "SendTrain.SurveyAnswered"
      trigger SendTrain::Summarize, with: { report: :report }
    end

    policy "RecordTheRefusedSurvey" do
      on      "SendTrain.SurveyRefused"
      trigger SendTrain::Fault, with: { refusal: :refusal }
    end

    policy "ObserveWhenAsked" do
      on      "SendTrain.ObserveRequested"
      ask     :observe, with: { run: :run }
    end

    policy "RecordTheMerge" do
      on      "SendTrain.ObserveAnswered"
      where   { outcome.value == "merged" }
      trigger SendTrain::Merge, with: { checkout: :checkout, boarded: :boarded, pushed: :pushed, report: :report }
    end

    # A queued boarding whose required checks failed: the answer's report names the failed jobs.
    policy "RecordTheFailedChecksOfAQueuedBoarding" do
      on      "SendTrain.ObserveAnswered"
      where   { outcome.value == "checks_failed" }
      trigger SendTrain::Fail, with: { report: :report }
    end

    # Deploys stay by hand: a push that reached the remote says a deploy is ready, and nothing more.
    # Like KeepTheLauncherCurrent, it reacts to the recorded push and takes the pushed commit from it.
    policy "AnnounceWhenPushed" do
      on      "SendTrain.BranchPushed"
      ask     :announce, with: { run: :run, pushed: :pushed }
    end

    # What landings left behind is listed after a push, and nothing is removed: a session may still
    # be working in a worktree whose branch landed, and a clean tree looks the same as a finished one.
    policy "ListLeftoversWhenPushed" do
      on      "SendTrain.BranchPushed"
      ask     :leftovers, with: { run: :run, pushed: :pushed }
    end

    # The train runs in Memory, in a checkout of its own, so its outcome is recorded where the
    # boarded checkout keeps its records: the `PushRecords` port runs that checkout's own
    # `PushOutcome.Record`. A recording that fails is answered `OutcomeUnrecorded` and changes
    # nothing about the push.
    policy "RecordThePushedOutcome" do
      on      "SendTrain.BranchPushed"
      ask     :record_outcome, with: { run: :run }
    end

    policy "RecordTheCarriedOutcome" do
      on      "SendTrain.CarriedByEarlierPush"
      ask     :record_outcome, with: { run: :run }
    end

    policy "RecordTheFaultedOutcome" do
      on      "SendTrain.PushFaulted"
      ask     :record_outcome, with: { run: :run }
    end

    policy "RecordTheQueuedOutcome" do
      on      "SendTrain.BoardingQueued"
      ask     :record_outcome, with: { run: :run }
    end

    # How one boarding of the train ended, recorded by the checkout that boarded it. It is its own
    # aggregate, not SendTrain, so recording a push in the checkout fires none of the reactions a
    # push itself has (the launcher refresh, the deploy announcement, the GateAndBoard saga).
    aggregate "PushOutcome" do
      description "How one boarding of the push train ended, as the boarded checkout records it: pushed, carried or faulted."

      attribute :run,      OutcomeKey
      attribute :checkout, Locator
      attribute :branch,   Locator, optional: true
      attribute :outcome,  Ending
      attribute :pushed,   Locator, optional: true
      attribute :commits,  Tally,  optional: true
      attribute :report,   Line,   optional: true
      identified_by :run

      # The boarding's run and how it ended, so a boarding run again is recorded beside the first.
      value_object "OutcomeKey" do
        attribute :value, String, matches: :present
      end

      # A checkout (written with its trailing slash), a branch or a commit.
      value_object "Locator" do
        attribute :value, String, matches: :present
      end

      value_object "Ending" do
        attribute :value, String, pattern: '\A(pushed|carried|queued|faulted)\z'
      end

      value_object "Tally" do
        attribute :value, Integer
        invariant("a count is not negative") { !value.negative? }
      end

      value_object "Line", String

      command "Record" do
        role "Operator"
        goal "Record how one boarding of the push train ended, in the checkout that boarded it"

        attribute :run,      OutcomeKey, sets: true
        attribute :checkout, Locator, sets: true
        attribute :branch,   Locator, optional: true, sets: true
        attribute :outcome,  Ending, sets: true
        attribute :pushed,   Locator, optional: true, sets: true
        attribute :commits,  Tally, optional: true, sets: true
        attribute :report,   Line, optional: true, sets: true

        emits PushRecorded
      end
    end

    # The request that starts GateAndBoard, under its own identity so the Landing record it leads to
    # is a separate one: Land creates a Landing under the same run key, and that would collide.
    aggregate "Shipment" do
      description "One request to gate, land and board a branch: the gate-and-board saga starts on it."

      attribute :run,    RunKey
      attribute :confirm, Switch, optional: true
      attribute :branch, Word
      attribute :checkout, Word, optional: true
      attribute :stage,   Word, optional: true
      attribute :refusal, Word, optional: true
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      # A branch, a directory or a commit.
      value_object "Word" do
        attribute :value, String, matches: :present
      end

      command "Ship" do
        role "Operator"
        goal "Start the gate-and-board saga for a branch: ask its checkout's gate, land on main, board the push train"

        attribute :run,      RunKey, sets: true
        attribute :branch,   Word, sets: true
        attribute :checkout, Word, sets: true
        attribute :confirm,  Switch, optional: true, sets: true

        given("lands the branch and pushes it to the remote needs --confirm; without it this only reports") { confirm.value == true }

        emits ShipRequested
        emits ShipStarted
      end

      # A shipment parked at its gate is judged again once the branch is mended: the Gate port is
      # asked for the checkout the shipment recorded.
      command "Rejudge" do
        role "Operator"
        goal "Ask the checkout's gate to judge a shipment again, after a gate that refused it"

        reference_to Shipment

        emits JudgementRequested
      end

      # The GateAndBoard saga records its own park: a shipment that stopped for a person names the
      # stage it stopped at and the step's reason. It refuses nothing, since a refusal would unwind
      # the saga's leg and leave the shipment out of needs_human.
      command "Stop" do
        role "System"
        goal "Record that a shipment parked for a person, with the stage and the reason"

        reference_to Shipment
        attribute :stage,   Word, sets: true
        attribute :refusal, Word, sets: true

        emits ShipmentStopped
      end
    end

    # Main is integrated by a process: every landing onto local main starts a run keyed by the
    # landed commit, and each run is verified in a clean copy, boarded on the push train and
    # watched on CI, ending green or red, or parked in needs_human with the reason. The clock's
    # beat reads a pushed run's CI on its own (`ObserveOnHeartbeat`); the coordinator drives the
    # rest with `Integration.advance!`, which dispatches each open run's next step at top level; a step records itself and waits, so no dispatch runs inside the saga and the
    # reaction depth stays bounded. Shipment's path joins it: its landing starts a run too, and a
    # boarding the train already carried is recorded as pushed. A run is checkpointed with the
    # Landing records that start it, so a copy that keeps those keeps its runs across a restart.
    # A run in needs_human is taken up again by verifying it again (`Integration.verify!`).
    #
    # A verification that fails is retried once, since a check can fail on load and pass when run
    # again. The run's state is the marker: a first failure moves it to retrying, the next advance
    # verifies it again as a retry (reverifying), and a retry that fails parks it in needs_human.
    # Reverifying has no retrying leg, so no run is retried twice. A step that raised is recorded
    # by Fail and parks the run at once: a check that could not run is not retried.
    process_manager "MainIntegration" do
      correlates_by :"landed.value"
      starts_on Landing::BranchLanded

      transition Integration::MainVerificationStarted => "verifying", from: %w[landed needs_human]
      transition Integration::MainVerificationFailedOnce => "retrying", from: "verifying"
      transition Integration::MainVerificationStarted => "reverifying", from: "retrying"
      transition Integration::MainVerified => "verified", from: %w[verifying reverifying]
      transition Integration::MainBoardingStarted => "boarding", from: "verified"
      transition Integration::MainPushed => "pushed", from: "boarding"
      transition Integration::CiObservationStarted => "ci_running", from: %w[pushed ci_running]
      # The pull request merged while CI on the merge commit still runs: main is pulled at once, and
      # the run stays watched in `merged` (a read of it stays there) until that CI has a verdict.
      transition Integration::TrainMergeSeen => "merged", from: "ci_running"
      transition Integration::CiObservationStarted => "merged", from: "merged"
      transition Integration::CiPassed => "green", from: %w[ci_running merged]
      transition Integration::CiFailed => "red", from: %w[ci_running merged]
      # A train pull request closed without merging: main never moved, so CI did not fail. The run
      # parks for a person and frees the line; verifying it again takes it up.
      transition Integration::PullRequestClosed => "needs_human", from: "ci_running"

      # A newer landing on main carries this one: the run stops, and the newer run integrates both.
      transition Integration::IntegrationSuperseded => "superseded", from: %w[verifying reverifying boarding]

      transition Integration::MainVerificationFailed => "needs_human", from: %w[verifying reverifying]
      transition Integration::MainPushRefused => "needs_human", from: "boarding"
    end

    # One step of integrating main, or one advance of every open run: what was asked, and how it
    # ended. A step names the landed commit its run is keyed by, and every event it emits carries
    # it, so the MainIntegration saga hears each one. Each step emits the event that moves the saga
    # before the one its adapter answers, because policies hear an event before sagas do. The port
    # adapters do the work: a clean detached copy for a verification, the push train's own copy for
    # a boarding, and GitHub for the CI run. A boarding refuses by name a range that carries an
    # agent's trailer, a version change or a release approval, and boards only while no other run is
    # being pushed or watched.
    aggregate "Integration" do
      description "One step of integrating main (verify, board, observe CI) or one advance of the open runs, and how it ended."

      attribute :run,      RunKey
      attribute :landed,   Word,   optional: true
      attribute :checkout, Word,   optional: true
      attribute :confirm,  Switch, optional: true
      attribute :pushed,   Word,   optional: true
      attribute :report,   Report, optional: true
      attribute :refusal,  Report, optional: true
      # Whether a verification is the one retry of a run whose first verification failed.
      attribute :retried,  Switch, optional: true
      # Whether a read of a run is of one already seen merged, whose main was pulled at the merge.
      attribute :pulled,   Switch, optional: true
      # What a read of a train pull request's red checks reports, as facts: the pull request, its CI
      # run, the attempt that failed, the spec files it names, one key for that attempt
      # (`<commit>-<run>-<attempt>`) and the Work item key and title a red fix would carry.
      attribute :pr,          Report, optional: true
      attribute :ci_run,      Report, optional: true
      attribute :attempt,     Tries, optional: true
      attribute :specs,       Report, optional: true
      attribute :failure_key, Report, optional: true
      attribute :work_key,    Report, optional: true
      attribute :title,       Report, optional: true
      attribute :cause,       Report, optional: true
      attribute :step,        Report, optional: true
      # What a read of an open train pull request reports about its CI having started: how many
      # checks GitHub lists, the minutes since the pull request opened, the status of the newest CI
      # run of its tip (`none` when there is no run), and whether the pipeline already closed and
      # reopened it to start CI. The policies on `ObserveAnswered` compare them with the bounds.
      attribute :checks,      Count, optional: true
      attribute :waited,      Count, optional: true
      attribute :ci_status,   Report, optional: true
      attribute :reopened,    Switch, optional: true
      identified_by :run

      # A count of checks or of minutes.
      value_object "Count", Integer

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      # A commit or a directory.
      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Report", String

      value_object "Switch", Boolean

      # Which attempt of a CI run failed: 1 is the first.
      value_object "Tries", Integer

      lifecycle :status, default: "requested" do
        mark :failure, "failed", "refused", "red"
        transition "Summarize" => "advanced",   from: "requested"
        transition "Pass"      => "verified",   from: "requested"
        transition "Fail"      => "failed",     from: "requested"
        transition "FailOnce"  => "retrying",   from: "requested"
        transition "Send"      => "pushed",     from: "requested"
        transition "Reject"    => "refused",    from: "requested"
        transition "Green"     => "passed",     from: "requested"
        transition "Red"       => "red",        from: "requested"
        transition "Close"     => "closed",     from: "requested"
        transition "Merge"     => "merged",     from: "requested"
        transition "Supersede" => "superseded", from: "requested"
        mark :terminal, "advanced", "verified", "failed", "retrying", "pushed", "refused", "passed", "red", "closed",
             "merged", "superseded"
      end

      command "Advance" do
        role "Operator"
        goal "Dispatch the next step of every open integration run, once: verify a landed run, board a verified one, observe a pushed one"

        attribute :run,     RunKey, sets: true
        # Boarding pushes main, so an advance boards only when confirmed; unconfirmed, it says
        # which boarding it would make.
        attribute :confirm, Switch, optional: true, sets: true

        emits AdvanceRequested
      end

      command "Poll" do
        role "System"
        goal "Read the CI run of every pushed or watched run, once, on a beat of the clock; it verifies and boards nothing"

        attribute :run, RunKey, sets: true

        emits PollRequested
      end

      # The outside source of the beat: a launchd job that dispatches `Heartbeat.Beat` once a minute,
      # so a train pull request is observed after its per-boarding chain of ticks has ended. The
      # request records nothing about the job; the port answers or refuses it.
      command "Schedule" do
        role "Operator"
        goal "Ask for the launchd job that beats the clock once a minute to be written and loaded; unconfirmed, it says what it would write"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        emits ScheduleRequested
      end

      command "Unschedule" do
        role "Operator"
        goal "Ask for the launchd job that beats the clock to be unloaded and removed; unconfirmed, it says what it would remove"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        emits UnscheduleRequested
      end

      command "Summarize" do
        role "System"
        goal "Record what one advance dispatched for each open run"

        reference_to Integration
        attribute :report, Report, sets: true

        emits IntegrationAdvanced
      end

      command "Verify" do
        role "Operator"
        goal "Verify a landed commit in a clean detached copy of local main: the quick gate, the specs its changes touch, the command names, the CI pipeline and the generated corpus"

        attribute :run,      RunKey, sets: true
        attribute :landed,   Word, sets: true
        attribute :checkout, Word, optional: true, sets: true
        # An advance sets it on the one retry of a run whose first verification failed.
        attribute :retried,  Switch, default: false, sets: true

        emits MainVerificationStarted
        emits MainVerificationRequested
      end

      command "Pass" do
        role "System"
        goal "Record that a landed commit passed its verification"

        reference_to Integration
        attribute :landed, Word,   sets: true
        attribute :report, Report, sets: true

        emits MainVerified
      end

      command "Fail" do
        role "System"
        goal "Record why a landed commit failed its verification, naming the failing checks and files"

        reference_to Integration
        attribute :landed,  Word,   sets: true
        attribute :refusal, Report, sets: true

        emits MainVerificationFailed
      end

      command "FailOnce" do
        role "System"
        goal "Record why a landed commit failed its first verification, so its run is verified once more before it waits for a person"

        reference_to Integration
        attribute :landed,  Word,   sets: true
        attribute :refusal, Report, sets: true

        emits MainVerificationFailedOnce
      end

      command "Board" do
        role "Operator"
        goal "Push a verified commit of main by boarding the push train in its own copy, refusing an agent's trailer, a version change or a release approval"

        attribute :run,      RunKey, sets: true
        attribute :landed,   Word, sets: true
        attribute :checkout, Word, optional: true, sets: true
        attribute :confirm,  Switch, optional: true, sets: true

        given("pushes main to the remote needs --confirm; without it this only reports") { confirm.value == true }

        emits MainBoardingStarted
        emits MainBoardingRequested
      end

      command "Send" do
        role "System"
        goal "Record the commit the push train pushed, or found already carried"

        reference_to Integration
        attribute :landed, Word,   sets: true
        attribute :pushed, Word,   sets: true
        attribute :report, Report, sets: true

        emits MainPushed
      end

      command "Reject" do
        role "System"
        goal "Record why a verified commit was not pushed"

        reference_to Integration
        attribute :landed,  Word,   sets: true
        attribute :refusal, Report, sets: true

        emits MainPushRefused
      end

      command "Observe" do
        role "Operator"
        goal "Read the CI run of a pushed commit on GitHub: passed, failed with the failed jobs, or still running"

        attribute :run,      RunKey, sets: true
        attribute :landed,   Word, sets: true
        attribute :checkout, Word, optional: true, sets: true
        # Set when the run was already seen merged, so its verdict is not a reason to pull again.
        attribute :pulled,   Switch, default: false, sets: true

        emits CiObservationStarted
        emits CiObservationRequested
      end

      command "Green" do
        role "System"
        goal "Record that CI passed on a pushed commit"

        reference_to Integration
        attribute :landed, Word,   sets: true
        attribute :report, Report, sets: true

        emits CiPassed
      end

      command "Red" do
        role "System"
        goal "Record that CI failed on a pushed commit, naming the failed jobs"

        reference_to Integration
        attribute :landed, Word,   sets: true
        attribute :report, Report, sets: true

        emits CiFailed
      end

      command "Close" do
        role "System"
        goal "Record that the train's pull request for a boarded commit was closed without merging, so its run waits for a person"

        reference_to Integration
        attribute :landed, Word,   sets: true
        attribute :report, Report, sets: true

        emits PullRequestClosed
      end

      command "Merge" do
        role "System"
        goal "Record that the train's pull request for a boarded commit merged while CI on the merge commit is still running"

        reference_to Integration
        attribute :landed,   Word,   sets: true
        attribute :checkout, Word,   optional: true, sets: true
        attribute :report,   Report, sets: true

        emits TrainMergeSeen
      end

      command "Supersede" do
        role "System"
        goal "Record that a newer commit on main carries a landed one, so its run stops"

        reference_to Integration
        attribute :landed, Word,   sets: true
        attribute :report, Report, sets: true

        emits IntegrationSuperseded
      end

      query "Outcome" do
        description "How one integration step or advance ended: its report, or why it was refused."
        attribute :run, RunKey
        where(run: :run)
        order_by :run
      end
    end

    policy "AdvanceWhenAsked" do
      on      "Integration.AdvanceRequested"
      ask     :step, with: { run: :run }
    end

    # The clock's beat is the timer that notices a train pull request's verdict: each beat reads the
    # CI run of every pushed or watched run (never verifying or boarding), so a merge or a failed
    # check is recorded and the checkout pulls main with nobody advancing. A root, so each beat
    # starts its own chain. `Heartbeat` (delegate.bluebook) owns the beat's period.
    policy "ObserveOnHeartbeat" do
      on      "Heartbeat.Beaten"
      root
      trigger Integration::Poll, with: { run: :beat }
    end

    # A quiet beat (no pushed or watched run) is refused by the port and records nothing.
    policy "PollWhenAsked" do
      on      "Integration.PollRequested"
      ask     :tend, with: { run: :run }
    end

    policy "ScheduleWhenAsked" do
      on      "Integration.ScheduleRequested"
      ask     :arrange, with: { run: :run, confirm: :confirm }
    end

    policy "UnscheduleWhenAsked" do
      on      "Integration.UnscheduleRequested"
      ask     :withdraw, with: { run: :run, confirm: :confirm }
    end

    policy "RecordTheAdvance" do
      on      "Integration.AdvanceAnswered"
      trigger Integration::Summarize, with: { report: :report }
    end

    # A train pull request's verdict frees the line, so the tip held verified behind it boards at
    # once, with no landing to start the advance. The verdicts are CI on the merge commit (passed
    # or failed) and the pull request closed unmerged; the merge itself is not one, since the run
    # stays watched in `merged` until its CI has a verdict. Each is a root reaction, once per
    # event, and the advance it asks is confirmed because the held tip is boarded by design. The
    # order rule is the port's: an advance boards nothing while another run is pushed or watched.
    policy "AdvanceWhenCiPasses" do
      on      "Integration.CiPassed"
      root
      trigger Integration::Advance, with: { run: :landed, confirm: true }
    end

    policy "AdvanceWhenCiFails" do
      on      "Integration.CiFailed"
      root
      trigger Integration::Advance, with: { run: :landed, confirm: true }
    end

    policy "AdvanceWhenTrainPrClosed" do
      on      "Integration.PullRequestClosed"
      root
      trigger Integration::Advance, with: { run: :landed, confirm: true }
    end

    policy "RecordTheRefusedAdvance" do
      on      "Integration.AdvanceRefused"
      trigger Integration::Summarize, with: { report: :refusal }
    end

    policy "VerifyMainWhenRequested" do
      on      "Integration.MainVerificationRequested"
      ask     :check, with: { run: :run, landed: :landed, retried: :retried }
    end

    policy "RecordTheVerification" do
      on      "Integration.VerifyAnswered"
      where   { outcome.value == "verified" }
      trigger Integration::Pass, with: { landed: :landed, report: :report }
    end

    policy "RecordTheSupersededVerification" do
      on      "Integration.VerifyAnswered"
      where   { outcome.value == "superseded" }
      trigger Integration::Supersede, with: { landed: :landed, report: :report }
    end

    # A first verification that fails is held for one more try; the retry's failure is the one a
    # person is asked about. Both refusals stay in the log: MainVerificationFailedOnce carries the
    # first, MainVerificationFailed the second.
    policy "RetryTheFailedVerification" do
      on      "Integration.VerifyRefused"
      where   { retried.value == false }
      trigger Integration::FailOnce, with: { landed: :landed, refusal: :refusal }
    end

    policy "RecordTheFailedVerification" do
      on      "Integration.VerifyRefused"
      where   { retried.value == true }
      trigger Integration::Fail, with: { landed: :landed, refusal: :refusal }
    end

    policy "BoardWhenRequested" do
      on      "Integration.MainBoardingRequested"
      ask     :embark, with: { run: :run, landed: :landed }
    end

    policy "RecordTheBoarding" do
      on      "Integration.BoardAnswered"
      where   { outcome.value == "pushed" }
      trigger Integration::Send, with: { landed: :landed, pushed: :pushed, report: :report }
    end

    policy "RecordTheSupersededBoarding" do
      on      "Integration.BoardAnswered"
      where   { outcome.value == "superseded" }
      trigger Integration::Supersede, with: { landed: :landed, report: :report }
    end

    policy "RecordTheRefusedBoarding" do
      on      "Integration.BoardRefused"
      trigger Integration::Reject, with: { landed: :landed, refusal: :refusal }
    end

    policy "ObserveWhenRequested" do
      on      "Integration.CiObservationRequested"
      ask     :watch, with: { run: :run, landed: :landed }
    end

    policy "RecordTheTrainMergeSeen" do
      on      "Integration.ObserveAnswered"
      where   { outcome.value == "merged" && pulled.value == false }
      trigger Integration::Merge, with: { landed: :landed, checkout: :checkout, report: :report }
    end

    # A CI run still in progress answers `running` and nothing is recorded: the next advance reads
    # it again.
    policy "RecordThePassedCi" do
      on      "Integration.ObserveAnswered"
      where   { outcome.value == "passed" }
      trigger Integration::Green, with: { landed: :landed, report: :report }
    end

    policy "RecordTheFailedCi" do
      on      "Integration.ObserveAnswered"
      where   { outcome.value == "failed" }
      trigger Integration::Red, with: { landed: :landed, report: :report }
    end

    policy "RecordTheClosedPullRequest" do
      on      "Integration.ObserveAnswered"
      where   { outcome.value == "closed" }
      trigger Integration::Close, with: { landed: :landed, report: :report }
    end

    # The train's pull request merging means origin/main holds the commit: GitHub merged it as a
    # squash that local main does not share. The checkout that boarded brings its main level
    # (LinkedTree.PullMain), keeping its unpushed commits, once per landed commit. A merge seen
    # while CI on the merge commit still runs is recorded (`TrainMergeSeen`) and pulls then; a
    # merge seen with that CI already finished is pulled on its verdict (`PullMainWhenCiPasses`,
    # `PullMainWhenCiFails`), and a run already seen merged (`pulled`) is not pulled again. An open
    # pull request, a red check on it included, answers `running`, so its run stays watched. A
    # refusal (a dirty or mid-rebase checkout, a conflict) is recorded as PullDeclinedRecorded and
    # nothing retries it. Each pull is a root reaction: it starts at depth zero, past the bound the
    # Observe chain has reached.
    policy "PullMainWhenMerged" do
      on      "Integration.TrainMergeSeen"
      root
      trigger LinkedTree::PullMain, with: { run: :landed, checkout: :checkout }
    end

    policy "PullMainWhenCiPasses" do
      on      "Integration.ObserveAnswered"
      root
      where   { outcome.value == "passed" && pulled.value == false }
      trigger LinkedTree::PullMain, with: { run: :landed, checkout: :checkout }
    end

    policy "PullMainWhenCiFails" do
      on      "Integration.ObserveAnswered"
      root
      where   { outcome.value == "failed" && pulled.value == false }
      trigger LinkedTree::PullMain, with: { run: :landed, checkout: :checkout }
    end

    # A train pull request whose checks all concluded and some failed answers `pr_failed`; the run
    # stays watched (`ci_running`), since the pull request is still open and a rerun may clear it.
    policy "RecordTheFailedTrainPr" do
      on      "Integration.ObserveAnswered"
      where   { outcome.value == "pr_failed" }
      trigger TrainPr::Record, with: { key: :failure_key, landed: :landed, pr: :pr, ci_run: :ci_run, attempt: :attempt,
                                       specs: :specs, work: :work_key, title: :title, cause: :cause, step: :step, failure: :report }
    end

    # One failed attempt of a train pull request's CI, recorded once under its key
    # (`<commit>-<run>-<attempt>`), so a second wake for the same failure is refused as already
    # recorded. The adapter reports facts (attempt, spec files, failed jobs and their first lines);
    # the policies below decide: a first failure is rerun once, a failure naming a known-flaky spec
    # is rerun twice, a later one is exhausted and planned as the red-train Work item
    # (tickets.bluebook).
    aggregate "TrainPr" do
      description "One failed attempt of a train pull request's CI: what failed, and whether it was rerun or given to a coder."

      attribute :key,     Key
      attribute :landed,  Word,   optional: true
      attribute :pr,      Word,   optional: true
      attribute :ci_run,  Word,   optional: true
      attribute :attempt, Tries,  optional: true
      attribute :specs,   Report, optional: true
      attribute :work,    Word,   optional: true
      attribute :title,   Word,   optional: true
      attribute :cause,   Word,   optional: true
      attribute :step,    Report, optional: true
      attribute :failure, Report, optional: true
      attribute :report,  Report, optional: true
      attribute :detail,  Report, optional: true
      attribute :refusal, Report, optional: true
      identified_by :key

      value_object "Key" do
        attribute :value, String, matches: :present
      end

      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Report", String

      # Which attempt of a CI run failed: 1 is the first.
      value_object "Tries", Integer

      # The spec files known to fail on load and pass when run again; a failure naming one is rerun
      # twice, not once. The policies `RerunTheKnownFlakySpec` and `ExhaustTheFailedTrainPr` name the same files.
      value_object "KnownFlakySpec" do
        attribute :spec,   String
        attribute :reruns, Integer

        member spec: "spec/bounded_capture_spec.rb", reruns: 2
      end

      lifecycle :status, default: "requested" do
        mark :failure, "exhausted"
        transition "Rerun"   => "rerun",     from: "requested"
        transition "Exhaust" => "exhausted", from: "requested"
        mark :terminal, "rerun", "exhausted"
      end

      command "Record" do
        role "System"
        goal "Record one failed attempt of a train pull request's CI: the failed jobs, the spec files or step, and the commits it carries"

        attribute :key,     Key, sets: true
        attribute :landed,  Word, sets: true
        attribute :pr,      Word, sets: true
        attribute :ci_run,  Word, sets: true
        attribute :attempt, Tries, sets: true
        attribute :specs,   Report, optional: true, sets: true
        attribute :work,    Word, sets: true
        attribute :title,   Word, sets: true
        attribute :cause,   Word, sets: true
        attribute :step,    Report, optional: true, sets: true
        attribute :failure, Report, sets: true

        emits TrainPrFailed
      end

      command "Rerun" do
        role "System"
        goal "Record that the failed jobs of a train pull request's CI were rerun"

        reference_to TrainPr
        attribute :report, Report, sets: true

        emits TrainPrRerun
      end

      command "Exhaust" do
        role "System"
        goal "Record that a train pull request's CI failed past the reruns allowed, so a coder is given the fix"

        reference_to TrainPr
        attribute :landed, Word, optional: true, sets: true
        attribute :work,   Word, sets: true
        attribute :title,  Word, sets: true
        attribute :cause,  Word, sets: true
        attribute :step,   Report, optional: true, sets: true
        attribute :detail, Report, sets: true

        emits TrainPrExhausted
      end
    end

    policy "RerunTheFailedTrainPr" do
      on      "TrainPr.TrainPrFailed"
      where   { (cause.value == "spec" && attempt.value < 2) || (cause.value == "setup" && attempt.value < 3) }
      ask     :restart, with: { key: :key, ci_run: :ci_run, pr: :pr, work: :work, title: :title, cause: :cause, step: :step, failure: :failure }
    end

    policy "RerunTheKnownFlakySpec" do
      on      "TrainPr.TrainPrFailed"
      where   { cause.value == "spec" && attempt.value == 2 && specs.value.include?("spec/bounded_capture_spec.rb") }
      ask     :restart, with: { key: :key, ci_run: :ci_run, pr: :pr, work: :work, title: :title, cause: :cause, step: :step, failure: :failure }
    end

    policy "ExhaustTheFailedTrainPr" do
      on      "TrainPr.TrainPrFailed"
      where   { attempt.value >= 3 || (cause.value == "spec" && attempt.value == 2 && !specs.value.include?("spec/bounded_capture_spec.rb")) }
      trigger TrainPr::Exhaust, with: { landed: :landed, detail: :failure, work: :work, title: :title, cause: :cause, step: :step }
    end

    policy "RecordTheRerun" do
      on      "TrainPr.RestartAnswered"
      trigger TrainPr::Rerun, with: { report: :report }
    end

    policy "ExhaustTheRefusedRerun" do
      on      "TrainPr.RestartRefused"
      trigger TrainPr::Exhaust, with: { detail: :failure, work: :work, title: :title, cause: :cause, step: :step }
    end

    # Every open train pull request is looked at on a beat: one whose tip main already holds, or
    # whose red checks a newer train pull request supersedes, is closed with a comment saying why.
    policy "SweepTrainPullRequestsOnHeartbeat" do
      on      "Heartbeat.Beaten"
      root
      trigger ReviewRequest::Sweep, with: { run: :beat }
    end

    policy "SweepWhenAsked" do
      on      "ReviewRequest.PullRequestSweepRequested"
      ask     :tidy, with: { run: :run }
    end

    policy "RecordTheTrainPullRequestSweep" do
      on      "ReviewRequest.TidyAnswered"
      trigger ReviewRequest::Swept, with: { report: :report }
    end

    policy "RecordTheRefusedSweep" do
      on      "ReviewRequest.TidyRefused"
      trigger ReviewRequest::Refuse, with: { refusal: :refusal }
    end

    # A train pull request whose CI never started: GitHub lists no check on it and the newest CI run
    # of its tip is absent or still queued (`awaiting_ci`), as when GitHub Actions is down. It is
    # recorded once the pull request has waited past the bound below, ten minutes, and that record
    # opens the `ci-not-started` stall (StallWatch), filed once for the orchestrator under the pull
    # request's number. A later read that finds checks on a pull request past the bound records
    # that its CI started, which closes the stall if it was not filed yet.
    aggregate "TrainPrCi" do
      description "One train pull request whose CI had not started past its bound, and whether it started after."

      attribute :pr,        PrNumber
      attribute :landed,    Word,   optional: true
      attribute :waited,    Count,  optional: true
      attribute :ci_status, Report, optional: true
      attribute :report,    Report, optional: true
      identified_by :pr

      # A pull request number.
      value_object "PrNumber" do
        attribute :value, String, pattern: '\A[0-9]+\z'
      end

      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Report", String

      # Minutes.
      value_object "Count", Integer

      command "Await" do
        role "System"
        goal "Record that a train pull request has no checks and no started CI run past its bound"

        attribute :pr,        PrNumber, sets: true
        attribute :landed,    Word, sets: true
        attribute :waited,    Count, sets: true
        attribute :ci_status, Report, sets: true
        attribute :report,    Report, sets: true

        emits TrainPrCiAwaited
      end

      command "Start" do
        role "System"
        goal "Record that GitHub lists checks on a train pull request that waited past its bound"

        attribute :pr,     PrNumber, sets: true
        attribute :report, Report, sets: true

        emits TrainPrCiStarted
      end
    end

    policy "AwaitTheUnstartedTrainPrCi" do
      on      "Integration.ObserveAnswered"
      where   { outcome.value == "awaiting_ci" && waited.value >= 10 }
      trigger TrainPrCi::Await, with: { pr: :pr, landed: :landed, waited: :waited, ci_status: :ci_status, report: :report }
    end

    policy "StartTheAwaitedTrainPrCi" do
      on      "Integration.ObserveAnswered"
      where   { outcome.value == "checking" && waited.value >= 10 }
      trigger TrainPrCi::Start, with: { pr: :pr, report: :report }
    end

    # A train pull request whose CI still has not started past the second bound, twenty minutes, is
    # closed and reopened once, which makes GitHub start its CI run again. Once is held by GitHub,
    # the only store that outlives a beat's process: the reopening leaves a marker comment on the
    # pull request, the read reports it (`reopened`), and a request for a marked one is refused. A
    # pull request with checks is never touched. While the reopening runs the read answers a closed
    # pull request carrying the marker as still running, so a beat between the close and the reopen
    # does not record it closed and free the line.
    aggregate "TrainPrReopen" do
      description "One close and reopen of a train pull request whose CI never started, to start it again."

      attribute :pr,       PrNumber
      attribute :landed,   Word,   optional: true
      attribute :checks,   Count,  optional: true
      attribute :reopened, Switch, optional: true
      attribute :report,   Report, optional: true
      attribute :refusal,  Report, optional: true
      identified_by :pr

      # A pull request number.
      value_object "PrNumber" do
        attribute :value, String, pattern: '\A[0-9]+\z'
      end

      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Report", String

      value_object "Switch", Boolean

      value_object "Count", Integer

      lifecycle :status, default: "requested" do
        mark :failure, "declined"
        transition "Reopen"  => "reopened", from: "requested"
        transition "Decline" => "declined", from: "requested"
        mark :terminal, "reopened", "declined"
      end

      command "Request" do
        role "System"
        goal "Ask for a train pull request whose CI never started to be closed and reopened, once, refusing one with checks"

        attribute :pr,       PrNumber, sets: true
        attribute :landed,   Word, optional: true, sets: true
        attribute :checks,   Count, sets: true
        attribute :reopened, Switch, sets: true

        given("a pull request with checks is not reopened") { checks.value == 0 }
        given("a pull request is reopened once") { reopened.value == false }

        emits TrainPrReopenRequested
      end

      command "Reopen" do
        role "System"
        goal "Record that a train pull request was closed and reopened to start its CI"

        reference_to TrainPrReopen
        attribute :report, Report, sets: true

        emits TrainPrReopened
      end

      command "Decline" do
        role "System"
        goal "Record why a train pull request was not closed and reopened"

        reference_to TrainPrReopen
        attribute :refusal, Report, sets: true

        emits TrainPrReopenDeclined
      end
    end

    policy "ReopenTheUnstartedTrainPr" do
      on      "Integration.ObserveAnswered"
      where   { outcome.value == "awaiting_ci" && waited.value >= 20 && reopened.value == false }
      trigger TrainPrReopen::Request, with: { pr: :pr, landed: :landed, checks: :checks, reopened: :reopened }
    end

    policy "ReopenWhenRequested" do
      on      "TrainPrReopen.TrainPrReopenRequested"
      ask     :cycle, with: { pr: :pr }
    end

    policy "RecordTheReopen" do
      on      "TrainPrReopen.CycleAnswered"
      trigger TrainPrReopen::Reopen, with: { report: :report }
    end

    policy "RecordTheDeclinedReopen" do
      on      "TrainPrReopen.CycleRefused"
      trigger TrainPrReopen::Decline, with: { refusal: :refusal }
    end

    aggregate "ReviewRequest" do
      description "One pull request opened or squash-merged on GitHub, and what GitHub answered."

      attribute :run,     RunKey
      attribute :confirm, Switch, optional: true
      attribute :branch,  Word,   optional: true
      attribute :base,    Word,   optional: true
      attribute :number,  Word,   optional: true
      attribute :url,     Word,   optional: true
      attribute :title,   Title,  optional: true
      attribute :body,    Body,   optional: true
      attribute :report,  Report, optional: true
      attribute :refusal, Report, optional: true
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      # A branch, a number or a URL.
      value_object "Word" do
        attribute :value, String, matches: :present
      end

      # A pull request's title: one line of text.
      value_object "Title" do
        attribute :value, String, matches: :present
      end

      # A pull request's body: Markdown, possibly many lines.
      value_object "Body" do
        attribute :value, String, matches: :present
      end

      value_object "Report", String

      value_object "Document" do
        attribute :text, String
      end

      lifecycle :status, default: "requested" do
        mark :failure, "refused"
        transition "Record"  => "opened", from: "requested"
        transition "Confirm" => "merged", from: "requested"
        transition "Queue"   => "queued", from: "requested"
        transition "Revise"  => "edited", from: "requested"
        transition "Refuse"  => "refused", from: "requested"
        transition "Swept"   => "swept",   from: "requested"
        mark :terminal, "opened", "merged", "queued", "edited", "refused", "swept"
      end

      command "Sweep" do
        role "System"
        goal "Close the open train pull requests that main already holds or that a newer one supersedes, with a comment saying why"

        attribute :run, RunKey, sets: true

        emits PullRequestSweepRequested
      end

      command "Swept" do
        role "System"
        goal "Record which train pull requests a sweep closed"

        reference_to ReviewRequest
        attribute :report, Report, sets: true

        emits PullRequestsSwept
      end

      command "Open" do
        role "Operator"
        goal "Open a pull request from a branch onto a base, and keep the number and URL GitHub gives it"

        attribute :run,    RunKey, sets: true
        attribute :branch, Word, sets: true
        attribute :base,   Word, default: "main", sets: true
        attribute :confirm, Switch, optional: true, sets: true

        given("opens a pull request on GitHub needs --confirm; without it this only reports") { confirm.value == true }

        emits "PullRequestRequested"
      end

      command "Take" do
        role "Operator"
        goal "Squash-merge an open pull request by its number; never with an admin override"

        attribute :run,    RunKey, sets: true
        attribute :number, Word, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        given("squash-merges the pull request on GitHub needs --confirm; without it this only reports") { confirm.value == true }

        emits "PullRequestMergeRequested"
      end

      command "Edit" do
        role "Operator"
        goal "Edit the title or body of an open pull request by its number; never its branch, merge or state"

        attribute :run,     RunKey, sets: true
        attribute :number,  Word, sets: true
        attribute :title,   Title, optional: true, sets: true
        attribute :body,    Body, optional: true, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        given("edits the pull request on GitHub needs --confirm; without it this only reports") { confirm.value == true }

        emits "PullRequestEditRequested"
      end

      command "Record" do
        role "System"
        goal "Record the number and URL GitHub gave an opened pull request"

        reference_to ReviewRequest
        attribute :number, Word, sets: true
        attribute :url,    Word, sets: true
        attribute :report, Report, sets: true

        emits "PullRequestOpened"
      end

      command "Confirm" do
        role "System"
        goal "Record that GitHub squash-merged a pull request"

        reference_to ReviewRequest
        attribute :number, Word, sets: true
        attribute :report, Report, sets: true

        emits "PullRequestMerged"
      end

      command "Queue" do
        role "System"
        goal "Record that GitHub accepted a pull request into its merge queue or auto-merge, not yet merged"

        reference_to ReviewRequest
        attribute :number, Word, sets: true
        attribute :report, Report, sets: true

        emits "PullRequestQueued"
      end

      command "Revise" do
        role "System"
        goal "Record that GitHub edited the title or body of a pull request"

        reference_to ReviewRequest
        attribute :number, Word, sets: true
        attribute :report, Report, sets: true

        emits "PullRequestEdited"
      end

      command "Refuse" do
        role "System"
        goal "Record why GitHub refused a pull request"

        reference_to ReviewRequest
        attribute :refusal, Report, sets: true

        emits "PullRequestRefused"
      end

      query "Status" do
        description "The state of one pull request on GitHub: its number, state, URL and checks, as text."
        attribute :number, Word
        returns Document
      end

      # One event on a pull request's timeline: its kind, the login that caused it, and when GitHub recorded it.
      value_object "TimelineEvent" do
        attribute :kind,  String
        attribute :actor, String
        attribute :at,    String
      end

      # Read-only. The kinds reported are merged, auto-merge enabled, auto-merge disabled, closed,
      # reopened and review requested; any other timeline entry is left out. A number that is not a
      # pull request is refused.
      query "Timeline" do
        description "Who merged a pull request, who turned auto-merge on or off, who closed, reopened or was asked to review it, and when: read from its timeline on GitHub, oldest first. Nothing is changed."
        attribute :number, Word
        where(kind: { in: "merged,auto_merge_enabled,auto_merge_disabled,closed,reopened,review_requested" })
        returns list_of(TimelineEvent)
      end
    end

    policy "CreatePullRequestWhenRequested" do
      on      "ReviewRequest.PullRequestRequested"
      ask     :create, with: { run: :run }
    end

    policy "RecordTheOpenedPullRequest" do
      on      "ReviewRequest.OpenAnswered"
      trigger ReviewRequest::Record, with: { number: :number, url: :url, report: :report }
    end

    policy "RecordTheRefusedOpen" do
      on      "ReviewRequest.OpenRefused"
      trigger ReviewRequest::Refuse, with: { refusal: :refusal }
    end

    policy "SquashWhenMergeRequested" do
      on      "ReviewRequest.PullRequestMergeRequested"
      ask     :squash, with: { run: :run }
    end

    policy "RecordTheMergedPullRequest" do
      on      "ReviewRequest.SquashAnswered"
      where   { outcome.value == "merged" }
      trigger ReviewRequest::Confirm, with: { number: :number, report: :report }
    end

    # GitHub accepted the merge into its queue or auto-merge without making it; the aggregate says
    # so and does not claim `merged`. `ReviewRequest.status` reads the actual merge later.
    policy "RecordTheQueuedPullRequest" do
      on      "ReviewRequest.SquashAnswered"
      where   { outcome.value == "queued" }
      trigger ReviewRequest::Queue, with: { number: :number, report: :report }
    end

    policy "RecordTheRefusedMerge" do
      on      "ReviewRequest.SquashRefused"
      trigger ReviewRequest::Refuse, with: { refusal: :refusal }
    end

    policy "AmendWhenEditRequested" do
      on      "ReviewRequest.PullRequestEditRequested"
      ask     :amend, with: { run: :run }
    end

    policy "RecordTheEditedPullRequest" do
      on      "ReviewRequest.AmendAnswered"
      trigger ReviewRequest::Revise, with: { number: :number, report: :report }
    end

    policy "RecordTheRefusedEdit" do
      on      "ReviewRequest.AmendRefused"
      trigger ReviewRequest::Refuse, with: { refusal: :refusal }
    end

    # The failure it prevents: a deep rehearsal takes minutes, another session lands on local main in
    # between, and `SendTrain.board!` then boards a head the rehearsal never judged, so the
    # rehearsal repeats. A boarding itself needs no hold: a landing that arrives while its checks run
    # stays on local main for the next boarding, and the pull request opens for the commit boarded.
    # A hold is named for the commit rehearsed. While it stands a landing onto main
    # is refused by name, except the fix of a red-* Work item. The rehearsal takes it; a boarding, a
    # refused boarding or a red rehearsal lifts it; and one nobody lifted expires at the
    # `boarding_hold` window of the world (20 minutes), so main is never held for longer than that.
    # The marker file is the `Holding` and `Releasing` ports' adapter; nothing here reads a clock or a
    # file. A release is its own aggregate, keyed by the run that caused it, so lifting a hold never
    # collides with the record of the hold itself.
    aggregate "BoardingHold" do
      description "One hold of local main for a boarding: held, or refused."
      created_by "BoardingHold.hold!"

      attribute :run,      RunKey
      attribute :checkout, Word,   optional: true
      attribute :owner,    Word,   optional: true
      attribute :reason,   Word,   optional: true
      attribute :output,   Report, optional: true
      attribute :refusal,  Report, optional: true
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Report", String

      value_object "Document" do
        attribute :text, String
      end

      lifecycle :status, default: "requested" do
        mark :failure, "refused"
        transition "Settle"  => "settled", from: "requested"
        transition "Decline" => "refused", from: "requested"
        mark :terminal, "settled", "refused"
      end

      command "Hold" do
        role "Operator"
        goal "Hold local main for the boarding of the commit it names now: landings onto main are refused until a release or the window ends"

        attribute :run,      RunKey, sets: true
        attribute :checkout, Word, optional: true, sets: true
        attribute :owner,    Word, optional: true, sets: true
        attribute :reason,   Word, optional: true, sets: true

        emits BoardingHoldRequested
      end

      command "Settle" do
        role "System"
        goal "Record what the hold did"

        reference_to BoardingHold
        attribute :output, Report, sets: true

        emits BoardingHoldSettled
      end

      command "Decline" do
        role "System"
        goal "Record why a hold was refused"

        reference_to BoardingHold
        attribute :refusal, Report, sets: true

        emits BoardingHoldDeclined
      end

      query "Status" do
        description "Whether local main is held for a boarding: the commit, owner, reason and age, or that the hold expired or is absent."
        attribute :checkout, Word, optional: true
        returns Document
      end
    end

    aggregate "BoardingRelease" do
      description "One lifting of the hold on local main: released, or refused."
      created_by "BoardingRelease.release!"

      attribute :run,      RunKey
      attribute :checkout, Word,   optional: true
      attribute :output,   Report, optional: true
      attribute :refusal,  Report, optional: true
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Report", String

      lifecycle :status, default: "requested" do
        mark :failure, "refused"
        transition "Settle"  => "released", from: "requested"
        transition "Decline" => "refused",  from: "requested"
        mark :terminal, "released", "refused"
      end

      command "Release" do
        role "Operator"
        goal "Lift the hold on local main, whoever took it; a lift with nothing held is a no-op"

        attribute :run,      RunKey, sets: true
        attribute :checkout, Word, optional: true, sets: true

        emits BoardingReleaseRequested
      end

      command "Settle" do
        role "System"
        goal "Record what the release did"

        reference_to BoardingRelease
        attribute :output, Report, sets: true

        emits BoardingReleaseSettled
      end

      command "Decline" do
        role "System"
        goal "Record why a release was refused"

        reference_to BoardingRelease
        attribute :refusal, Report, sets: true

        emits BoardingReleaseDeclined
      end
    end

    policy "HoldWhenRehearsingDeep" do
      on      "PushRehearsal.PushRehearsalRequested"
      where   { scope.value == "deep" }
      trigger BoardingHold::Hold, with: { run: :run, reason: { value: "deep rehearsal, then the train" } }
    end

    policy "ReleaseWhenRehearsalRed" do
      on      "PushRehearsal.PushRehearsalFailed"
      trigger BoardingRelease::Release, with: { run: :run }
    end

    policy "ReleaseWhenRehearsalRefused" do
      on      "PushRehearsal.PushRehearsalDeclined"
      trigger BoardingRelease::Release, with: { run: :run }
    end

    policy "ReleaseWhenBoarded" do
      on      "SendTrain.TrainAnswered"
      trigger BoardingRelease::Release, with: { run: :run, checkout: :checkout }
    end

    policy "ReleaseWhenBoardingRefused" do
      on      "SendTrain.TrainRefused"
      trigger BoardingRelease::Release, with: { run: :run }
    end

    policy "MarkTheHoldWhenRequested" do
      on      "BoardingHold.BoardingHoldRequested"
      ask     :mark, with: { run: :run }
    end

    policy "ClearTheHoldWhenRequested" do
      on      "BoardingRelease.BoardingReleaseRequested"
      ask     :clear, with: { run: :run }
    end

    policy "RecordTheHold" do
      on      "BoardingHold.HoldAnswered"
      trigger BoardingHold::Settle, with: { output: :output }
    end

    policy "RecordTheRefusedHold" do
      on      "BoardingHold.HoldRefused"
      trigger BoardingHold::Decline, with: { refusal: :refusal }
    end

    policy "RecordTheRelease" do
      on      "BoardingRelease.ReleaseAnswered"
      trigger BoardingRelease::Settle, with: { output: :output }
    end

    policy "RecordTheRefusedRelease" do
      on      "BoardingRelease.ReleaseRefused"
      trigger BoardingRelease::Decline, with: { refusal: :refusal }
    end
  end
end
