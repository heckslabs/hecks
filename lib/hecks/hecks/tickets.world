# The Tickets domain's settings. `work_limit` caps how many Work items may be started at once:
# a start that would make one more is sent back to the plan, naming the cap, the count and the
# holders. Without this line the cap is `Hecks::Adapters::WorkLimits::DEFAULT_CAP`, 8.
#
# `frozen_shapes` (not `freeze`, which every Ruby object already answers) names the areas and aggregates whose persisted shape may not move: a brief tells its session
# to commit and hold a change that moves one, and `Dispatch.Fill` starts no Work item in a frozen area.
# The Machine's load marks and `dispatch_max_load` are one number, below the CPU count (12 on the owner's
# machine), so the Machine pausing the plan and the plan's own load check agree.
# `cpu_budget` is a ceiling on the hours of launcher boots in a rolling 24 hours (the usage record's
# `boot_ms`, from each run's start time; a run with no boot time adds nothing): once they have spent it,
# `Dispatch.Fill` starts no session except a red-* fix ("boot budget spent") and the board's Boot hours
# tile fails, so a loop that boots the launcher over and over stops itself. 6.0 is a ceiling, not a
# target: the first 45 minutes of measured runs held 0.42 hours (2026-11-09), so a full day of the
# same work sits well under it; tighten it once the boot-time work has landed and a day is measured.
# `dispatch_max_load` is the 1-minute load above which `Dispatch.Fill` starts no session (the CPU count
# when absent). `dispatch_roll_forward` is the owner's switch: while `roll_forward` is true the Delegate
# policies run `Dispatch.Fill` on events that free capacity, and false pauses them. `session_environment` is what every dispatched session starts with: a shared cargo
# target directory and a `nice` increment. `session_grace` is how many seconds a started session is
# given to appear in `claude agents` before a run whose session is not listed is retired as gone.
#
# `rust_build` is how hard any Rust build hecks starts may work, in every checkout, the owner's too: `jobs` caps the
# Cargo jobs at once (a third of the cores when absent) and `nice` is the increment. Builds also queue behind one
# lock, so two never run at once (`HECKS_NO_BUILD_LOCK=1` skips it).
#
# `github_issues` is the switch on GitHub issues for run findings (`OpenIssueWhenRunReported`). It is
# off: a run finding stays a work item and no GitHub call is made. `enabled: true` turns it back on.
#
# `machine_marks` are the marks the Machine's readings are judged against (Delegate `Machine`, read through
# the `Sampling` port). Each state has two marks with a gap between them, so a gauge near one does not flap:
# the load has risen at CPU idle `cpu_idle_low` percent or under (or at a load average over `load_high` with
# the CPU under `cpu_idle_high` idle) and fallen at `cpu_idle_high` idle or over (or under `load_low` with the
# CPU over `cpu_idle_low`); memory is low over `swap_low` percent of swap used or a compressor over
# `compressor_gb` gigabytes, and recovered under `swap_recovered` percent; the test lane is busy at
# `lane_busy` waiting and idle at `lane_idle` or fewer; a reading is taken at most every `interval` seconds.
Hecks.world "Tickets" do
  machine_marks "Machine", load_low: 6.0, load_high: 8.0, cpu_idle_low: 25.0, cpu_idle_high: 40.0,
                           swap_low: 70.0, swap_recovered: 50.0, compressor_gb: 12.0, lane_busy: 4.0, lane_idle: 1.0,
                           interval: 60.0
  github_issues "GitHubIssues", enabled: false
  work_limit "WorkLimits", cap: 6
  dispatch_max_load "Dispatch", limit: 8.0
  cpu_budget "Dispatch", boot_hours_per_day: 6.0
  dispatch_roll_forward "Dispatch", roll_forward: false
  frozen_shapes "PersistedShapes", areas: []
  session_environment "Sessions", cargo_target_dir: "~/.cache/hecks/cargo-target", nice: 15
  session_grace "Sessions", seconds: 120
  rust_build "RustBuild", jobs: 4, nice: 15
  # `live_services` names the spec tags whose examples reach a live service (cloudfront: a real
  # AWS account). They run only when `HECKS_LIVE_SERVICES` names the tag, under every filter
  # (spec/support/live_services.rb), and a verification never hands that variable to its checks.
  live_services "Specs", tags: ["cloudfront"]
  # `spec_bounds` is the wall clock a spec run may take before it is ended with every process it
  # started, naming the file and example it was in. `file_seconds` bounds one spec file's process:
  # the slowest files build a Rust crate cold, a few minutes, so 600 leaves room and still ends a
  # hang in ten minutes, not the thirty a silent `aws` call held one. `check_seconds` bounds one
  # check of a verification (a batch of 25 files, the quick gate): a whole verification takes about
  # 16 minutes when nothing hangs, so 2400 holds any one check with room and ends a hang in 40.
  spec_bounds "Specs", file_seconds: 600, check_seconds: 2400
  # The decision records' files (Tickets::Adr), relative to the checkout; `None` leaves the Adr
  # store a plain Memory one, as the memory overlay does for specs. Binding Adr makes the wiring
  # explicit, so the other aggregates take this default where no attaching domain hands one down.
  default_adapter "Memory"
  persisted_by("DecisionFiles") do
    directory "docs/decisions"
  end
end
