Hecks.bluebook "Hecks" do
  domain_module "Quiesce" do
    vision "Keep QA quiet for a mint window, so the QA ledger's watermark holds still between the rehearsal and the mint."

    # A hold writes the marker file every step of `hecks quality_control sweep.tick` checks before it starts;
    # a release removes it. The marker names its owner, reason and time, and a marker older than two hours is
    # ignored. The mint itself never requires it.
    aggregate "QaQuiesce" do
      description "One hold or release of the QA quiet marker: held, released, or refused."
      created_by "QaQuiesce.hold!"

      attribute :run,     RunKey
      attribute :owner,   Word,   optional: true
      attribute :reason,  Word,   optional: true
      attribute :force,   Switch, optional: true
      attribute :output,  Report, optional: true
      attribute :refusal, Report, optional: true
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Switch", Boolean

      value_object "Report", String

      value_object "Document" do
        attribute :text, String
      end

      lifecycle :status, default: "requested" do
        mark :failure, "refused"
        transition "Settle"  => "settled", from: "requested"
        transition "Decline" => "refused", from: "requested"
        mark :terminal, "settled", "refused"
      end

      command "Hold" do
        role "Operator"
        goal "Quiet QA for a mint window: every tick step refuses to start while the marker is fresh"

        attribute :run,    RunKey, sets: true
        attribute :owner,  Word, optional: true, sets: true
        attribute :reason, Word, sets: true
        attribute :force,  Switch, optional: true, sets: true

        emits QuiesceHoldRequested
      end

      command "Release" do
        role "Operator"
        goal "End a mint window: remove the QA quiet marker, which another owner's marker survives without force"

        attribute :run,   RunKey, sets: true
        attribute :owner, Word, optional: true, sets: true
        attribute :force, Switch, optional: true, sets: true

        emits QuiesceReleaseRequested
      end

      command "Settle" do
        role "System"
        goal "Record what the hold or release did"

        reference_to QaQuiesce
        attribute :output, Report, sets: true

        emits QuiesceSettled
      end

      command "Decline" do
        role "System"
        goal "Record why a hold or release was refused"

        reference_to QaQuiesce
        attribute :refusal, Report, sets: true

        emits QuiesceDeclined
      end

      query "Status" do
        description "Whether QA is quiesced: the marker's owner, reason and age, or that it is stale or absent."
        attribute :run, RunKey, optional: true
        returns Document
      end
    end

    policy "HoldWhenRequested" do
      on      "QaQuiesce.QuiesceHoldRequested"
      ask     :mark, with: { run: :run }
    end

    policy "ReleaseWhenRequested" do
      on      "QaQuiesce.QuiesceReleaseRequested"
      ask     :clear, with: { run: :run }
    end

    policy "RecordTheQuiet" do
      on      "QaQuiesce.QuiesceAnswered"
      trigger QaQuiesce::Settle, with: { output: :output }
    end

    policy "RecordTheRefusedQuiet" do
      on      "QaQuiesce.QuiesceRefused"
      trigger QaQuiesce::Decline, with: { refusal: :refusal }
    end
  end
end
