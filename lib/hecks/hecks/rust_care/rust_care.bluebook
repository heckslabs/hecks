Hecks.bluebook "Hecks" do
  domain_module "RustCare" do
    vision "The disk Rust builds hold is pruned on the clock's beat: under pressure, or when a build dir's worktree is gone."

    # A beat looks once: the `Gauging` port reads free disk against the `disk_space` line and finds
    # gone worktrees' dirs, deferring while a build runs; the `Trimming` port then deletes, whole
    # under pressure (`pressure`) or only the gone dirs (`gone`).
    aggregate "RustCare" do
      description "One look, on a beat of the clock, at whether the Rust build dirs are due a prune."

      attribute :run,     CareKey
      attribute :reason,  CareNote, optional: true
      attribute :mode,    CareNote, optional: true
      attribute :refusal, CareNote, optional: true
      attribute :outcome, CareNote, optional: true
      identified_by :run

      value_object "CareKey" do
        attribute :value, String, matches: :present
      end

      value_object "CareNote" do
        attribute :value, String, matches: :present
      end

      lifecycle :status, default: "requested" do
        mark :failure, "deferred", "refused"
        transition "Hear"    => "due",      from: "requested"
        transition "Decline" => "deferred", from: "requested"
        transition "Settle"  => "pruned",   from: "due"
        transition "Refuse"  => "refused",  from: "due"
        mark :terminal, "deferred", "pruned", "refused"
      end

      command "Look" do
        role "System"
        goal "Ask whether the Rust build dirs are under disk pressure or hold a gone worktree's output"

        attribute :run, CareKey, sets: true

        emits RustCareRequested
      end

      command "Hear" do
        role "System"
        goal "Record why the build dirs are pruned now, and whether the whole prune or only gone dirs"

        reference_to RustCare
        attribute :reason, CareNote, sets: true
        attribute :mode,   CareNote, sets: true

        emits RustCareHeard
      end

      command "Decline" do
        role "System"
        goal "Record why the build dirs are left for the next beat: room enough, nothing gone, or a build running"

        reference_to RustCare
        attribute :refusal, CareNote, sets: true

        emits RustCareDeclined
      end

      command "Settle" do
        role "System"
        goal "Record how much the prune freed"

        reference_to RustCare
        attribute :outcome, CareNote, sets: true

        emits RustCareSettled
      end

      command "Refuse" do
        role "System"
        goal "Record why the prune could not be done"

        reference_to RustCare
        attribute :refusal, CareNote, sets: true

        emits RustCareRefused
      end
    end

    # A root, like the ledger's look, so each beat's look begins its own chain.
    policy "LookAfterTheRustBuildsOnHeartbeat" do
      on      "Heartbeat.Beaten"
      root
      trigger RustCare::Look, with: { run: :beat }
    end

    policy "WeighTheRustBuildsWhenLooking" do
      on      "RustCare.RustCareRequested"
      ask     :weigh, with: { run: :run }
    end

    policy "RecordWhyTheRustBuildsAreDue" do
      on      "RustCare.RustCareDue"
      trigger RustCare::Hear, with: { reason: :reason, mode: :mode }
    end

    policy "RecordWhyTheRustBuildsWait" do
      on      "RustCare.RustCareDeferred"
      trigger RustCare::Decline, with: { refusal: :refusal }
    end

    policy "PruneTheRustBuildsWhenHeard" do
      on      "RustCare.RustCareHeard"
      ask     :trim, with: { run: :run, mode: :mode }
    end

    policy "RecordThePrunedRustBuilds" do
      on      "RustCare.RustPruned"
      trigger RustCare::Settle, with: { outcome: :outcome }
    end

    policy "RecordWhyTheRustBuildsWereNotPruned" do
      on      "RustCare.RustPruneRefused"
      trigger RustCare::Refuse, with: { refusal: :refusal }
    end
  end
end
