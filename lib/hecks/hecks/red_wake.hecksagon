# RedWake's port, beside hecks.hecksagon: same-name blocks merge, and every bluebook loads first.
# A plain name, not `.ports.hecksagon`: the Hecks directory reads every `*.hecksagon`.
Hecks.hecksagon "Hecks" do
  # RedFlag's port too, so one adapter answers both: a port's asks reach only its own aggregate.
  Hecks::RedWake.port "Flagging" do
    asks "Weigh", to: RedWake do
      attribute :escalation, WakeKey
      attribute :kind, WakeWord
      attribute :repo, WakeWord
      answers "RedWakeWeighed"
      refuses "RedWakeUnweighed"
    end
  end
end
