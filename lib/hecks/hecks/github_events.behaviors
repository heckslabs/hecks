Hecks.behaviors "GithubEvents" do
  vision "A GitHub REST read of a pull request, a check run or a refused call becomes the event the webhook's delivery would have been."

  loads "hecks.bluebook", "context_map.hecksagon", "hecks.hecksagon", "red_wake.hecksagon", "stable_roll.hecksagon",
        "github_events/github_events.hecksagon", "environments/memory.world", modules: :all

  test "A pull request read opens a train pull request as a recorded event" do
    tests "ReadPull", on: "GithubRest"
    input key: { value: "pr-12-open" }, observed: { value: 1_000_000 }, number: { value: 12 },
          head_sha: { value: "abc123" }, head_ref: { value: "train-abc123" }, state: { value: "open" }
    expect emits: ["PullRead", "GithubEventRecorded"]
  end

  test "A merged pull request read records the merge" do
    tests "ReadPull", on: "GithubRest"
    input key: { value: "pr-12-merged" }, observed: { value: 1_000_001 }, number: { value: 12 },
          head_sha: { value: "abc123" }, head_ref: { value: "train-abc123" }, state: { value: "closed" },
          merged_at: { value: "2026-11-20T10:00:00Z" }
    expect emits: ["PullRead", "GithubEventRecorded"]
  end

  test "A green check run read records its conclusion" do
    tests "ReadCheckRun", on: "GithubRest"
    input key: { value: "run-7-completed-success" }, observed: { value: 1_000_002 }, name: { value: "specs" },
          head_sha: { value: "abc123" }, status: { value: "completed" }, conclusion: { value: "success" }
    expect emits: ["CheckRunRead", "GithubEventRecorded"]
  end

  test "A red check run read records its conclusion" do
    tests "ReadCheckRun", on: "GithubRest"
    input key: { value: "run-8-completed-failure" }, observed: { value: 1_000_003 }, name: { value: "specs" },
          head_sha: { value: "abc123" }, status: { value: "completed" }, conclusion: { value: "failure" }
    expect emits: ["CheckRunRead", "GithubEventRecorded"]
  end

  test "A check run read again after it completed is a new record, not a replay" do
    tests "ReadCheckRun", on: "GithubRest"
    setup  "Hecks::GithubRest.ReadCheckRun", key: { value: "run-9-in-progress" }, observed: { value: 1_000_004 },
           name: { value: "specs" }, head_sha: { value: "abc123" }, status: { value: "in_progress" }
    input key: { value: "run-9-completed-success" }, observed: { value: 1_000_005 }, name: { value: "specs" },
          head_sha: { value: "abc123" }, status: { value: "completed" }, conclusion: { value: "success" }
    expect emits: ["CheckRunRead", "GithubEventRecorded"]
  end

  test "The same read twice is refused as a replay" do
    tests "ReadCheckRun", on: "GithubRest"
    setup  "Hecks::GithubRest.ReadCheckRun", key: { value: "run-10-completed-success" }, observed: { value: 1_000_006 },
           name: { value: "specs" }, head_sha: { value: "abc123" }, status: { value: "completed" },
           conclusion: { value: "success" }
    input key: { value: "run-10-completed-success" }, observed: { value: 1_000_007 }, name: { value: "specs" },
          head_sha: { value: "abc123" }, status: { value: "completed" }, conclusion: { value: "success" }
    expect refused: "already exists"
  end

  test "A 403 with no budget left records the rate limit as exhausted" do
    tests "ReadRateLimit", on: "GithubRest"
    input key: { value: "limit-1000008" }, observed: { value: 1_000_008 }, http_status: { value: 403 },
          remaining: { value: 0 }, reset: { value: 1_000_900 }
    expect emits: ["RateLimitRead", "GithubEventRecorded"]
  end
end
