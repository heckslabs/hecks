Hecks.bluebook "Hecks" do
  domain_module "Tune" do
    vision "Turn one of this machine's operating settings from a command, so the owner changes a cap without editing a file."

    # A `Turnable` row: `setting` is `verb.key` as the world file writes it, `kind` is `integer`, `number`,
    # `switch` or `choice`, `least` and `most` bound it (empty for a switch; for a choice `least` lists
    # the words it takes, joined by `|`, and `means` says in one sentence each what they mean, joined by `|`), `context` is where the board shows it.
    aggregate "Dial" do
      description "One turn of a machine-local setting, turned or refused. A turn writes the value to this checkout's gitignored turned.local.world, which loads after every other local world, so the next process reads it. The Turnable rows are the whole list: a setting with no row cannot be turned, and a value outside its row's bounds is refused by name."
      created_by "Dial.turn!"

      attribute :run,     RunKey
      attribute :setting, Word
      attribute :becomes, Word
      attribute :output,  Report, optional: true
      attribute :refusal, Report, optional: true
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Report", String

      value_object "Turnable" do
        attribute :world,   String
        attribute :setting, String
        attribute :kind,    String
        attribute :least,   String
        attribute :most,    String
        attribute :context, String
        attribute :says,    String
        attribute :means,   String, optional: true

        member world: "Tickets", setting: "work_limit.cap", kind: "integer", least: "1", most: "20",
               context: "Hecks / Delegate", says: "Work items that may be started at once"
        member world: "Tickets", setting: "work_cap.moves", kind: "switch", least: "", most: "",
               context: "Hecks / Delegate", says: "Whether the work cap moves with the machine, inside the least and the most"
        member world: "Tickets", setting: "work_cap.least", kind: "integer", least: "1", most: "20",
               context: "Hecks / Delegate", says: "The fewest Work items the moving cap may stand at"
        member world: "Tickets", setting: "work_cap.most", kind: "integer", least: "1", most: "20",
               context: "Hecks / Delegate", says: "The most Work items the moving cap may stand at"
        member world: "Tickets", setting: "work_limit.urgent_reserve", kind: "integer", least: "0", most: "5",
               context: "Hecks / Delegate", says: "Red Work items that may start past a full cap"
        member world: "Tickets", setting: "epic_wip_limit.limit", kind: "integer", least: "1", most: "20",
               context: "Hecks / Delegate", says: "Work items of one epic that may be started at once"
        member world: "Tickets", setting: "dispatch_roll_forward.roll_forward", kind: "switch", least: "", most: "",
               context: "Hecks / Delegate", says: "Whether the fill starts work by itself when a place frees"
        member world: "Tickets", setting: "dispatch_max_load.limit", kind: "number", least: "2", most: "40",
               context: "Hecks / Delegate", says: "The load above which the fill starts no session"
        member world: "Tickets", setting: "machine_marks.load_high", kind: "number", least: "2", most: "40",
               context: "Hecks / Delegate", says: "The load the machine counts as loaded above, which asks a session to yield"
        member world: "Tickets", setting: "machine_marks.load_low", kind: "number", least: "1", most: "40",
               context: "Hecks / Delegate", says: "The load the machine counts as recovered under, which runs the fill again"
        member world: "Tickets", setting: "load_shed.at_once", kind: "integer", least: "1", most: "5",
               context: "Hecks / Delegate", says: "Started items asked to yield at once when the load rises"
        member world: "Tickets", setting: "load_shed.min_coders", kind: "integer", least: "1", most: "10",
               context: "Hecks / Delegate", says: "Coders that must be running before one is asked to yield"
        member world: "Tickets", setting: "cpu_budget.boot_hours_per_day", kind: "number", least: "1", most: "48",
               context: "Hecks / Delegate", says: "Hours of launcher boots a day before the fill stops"
        member world: "Tickets", setting: "heavy_jobs.cap", kind: "integer", least: "1", most: "8",
               context: "Hecks / Test", says: "Heavy jobs (a gate run, a run of several spec files) at once on the machine"
        member world: "Tickets", setting: "spec_workers.max", kind: "integer", least: "1", most: "16",
               context: "Hecks / Test", says: "Workers one parallel spec run may start"
        member world: "Tickets", setting: "rust_build.jobs", kind: "integer", least: "1", most: "16",
               context: "Hecks / Build", says: "Jobs one Rust build may run"
        member world: "Tickets", setting: "main_verification.workers", kind: "integer", least: "1", most: "8",
               context: "Hecks / Test", says: "Processes one check of a landed run's verification may start at once"
        member world: "Tickets", setting: "main_verification.nice", kind: "integer", least: "0", most: "19",
               context: "Hecks / Test", says: "The nice increment a landed run's verification commands run under"
        member world: "Tickets", setting: "main_verification.verifies", kind: "choice", least: "impacted|quick|off", most: "",
               context: "Hecks / Test", says: "What a landed commit is verified with on this machine after the merge",
               means: "impacted: the quick gate and the specs the landings touch, and a failure is searched for its first bad merge.|" \
                      "quick: the quick gate only, with no impacted specs, no search and no red episode.|" \
                      "off: nothing is run here, no last-verified marker is written, and CI is the only check."
      end

      lifecycle :status, default: "requested" do
        mark :failure, "refused"
        transition "Settle"  => "settled", from: "requested"
        transition "Decline" => "refused", from: "requested"
        mark :terminal, "settled", "refused"
      end

      command "Turn" do
        role "Operator"
        goal "Set one turnable setting of this machine to a value inside its bounds"

        attribute :run,     RunKey, sets: true
        attribute :setting, Word, sets: true
        attribute :becomes, Word, sets: true

        emits DialTurnRequested
      end

      command "Settle" do
        role "System"
        goal "Record what the turn set, and what it was before"

        reference_to Dial
        attribute :output, Report, sets: true

        emits DialSettled
      end

      command "Decline" do
        role "System"
        goal "Record why the turn was refused"

        reference_to Dial
        attribute :refusal, Report, sets: true

        emits DialDeclined
      end
    end

    policy "SetTheDialWhenTurned" do
      on      "Dial.DialTurnRequested"
      ask     :set, with: { run: :run }
    end

    policy "RecordTheTurn" do
      on      "Dial.DialSet"
      trigger Dial::Settle, with: { output: :output }
    end

    policy "RecordTheRefusedTurn" do
      on      "Dial.DialRefused"
      trigger Dial::Decline, with: { refusal: :refusal }
    end

    # Rises slowly and is cut quickly, as congestion control does. A reading counts by the states the
    # `machine_marks` judged (their gap is the hysteresis); the bounds come with it from `work_cap`.
    aggregate "WorkCap" do
      description "The pipeline's one moving work cap: where it stands between the owner's bounds, and the runs of readings it moves on. It rises by one after five calm readings (about ten minutes at a reading every two) while no more than one train in three since the last move went red, is halved (not below the least) on memory low twice in a row or the load over its mark for five readings, and holds between. The fill reads `current` only while the Tickets world's `work_cap` line says `moves: true`; a lower cap stops new starts and never ends a running coder."

      attribute :cap,          CapKey
      attribute :current,      Level
      attribute :least,        Level
      attribute :most,         Level
      attribute :calm_run,     Run
      attribute :pressed_run,  Run
      attribute :strained_run, Run
      attribute :trains,       Run
      attribute :red_trains,   Run
      attribute :reason,       CapReason, optional: true
      identified_by :cap

      value_object "CapKey" do
        attribute :value, String, matches: :present
      end

      # A number of work items that may be started at once.
      value_object "Level" do
        attribute :value, Integer, default: 4
        invariant("a cap is not negative") { value >= 0 }
      end

      # Consecutive readings of one kind, or trains counted since the last move.
      value_object "Run" do
        attribute :value, Integer, default: 0
      end

      value_object "CapReason", String

      command "Open" do
        role "System"
        goal "Open the one work cap of a store, standing at its default"

        attribute :cap, CapKey, sets: true

        emits WorkCapOpened
      end

      command "CountCalm" do
        role "System"
        goal "Count a reading with memory ok and the load below its mark: one more in the calm run"

        reference_to WorkCap
        attribute :least, Level, sets: true
        attribute :most,  Level, sets: true

        sets :calm_run,     increment: { value: 1 }
        sets :pressed_run,  to: { value: 0 }
        sets :strained_run, to: { value: 0 }

        emits CalmReadingCounted
      end

      command "CountPressed" do
        role "System"
        goal "Count a reading with memory low: one more in the pressed run"

        reference_to WorkCap
        attribute :least, Level, sets: true
        attribute :most,  Level, sets: true

        sets :pressed_run,  increment: { value: 1 }
        sets :calm_run,     to: { value: 0 }
        sets :strained_run, to: { value: 0 }

        emits PressedReadingCounted
      end

      command "CountStrained" do
        role "System"
        goal "Count a reading with memory ok and the load above its mark: one more in the strained run"

        reference_to WorkCap
        attribute :least, Level, sets: true
        attribute :most,  Level, sets: true

        sets :strained_run, increment: { value: 1 }
        sets :calm_run,     to: { value: 0 }
        sets :pressed_run,  to: { value: 0 }

        emits StrainedReadingCounted
      end

      command "CountGreenTrain" do
        role "System"
        goal "Count a train whose pull request merged"

        reference_to WorkCap

        sets :trains, increment: { value: 1 }

        emits GreenTrainCounted
      end

      command "CountRedTrain" do
        role "System"
        goal "Count a train whose pull request's CI failed on its first attempt"

        reference_to WorkCap

        sets :trains,     increment: { value: 1 }
        sets :red_trains, increment: { value: 1 }

        emits RedTrainCounted
      end

      command "Widen" do
        role "System"
        goal "Raise the cap by one: five calm readings in a row, under the most, with no more than one train in three red"

        reference_to WorkCap

        given("the machine stayed calm for five readings") { calm_run.value >= 5 }
        given("the cap is under the most") { current.value < most.value }
        given("no more than one train in three went red since the last move") { red_trains.value * 3 <= trains.value }

        sets :current,    to: current.value + 1
        sets :calm_run,   to: { value: 0 }
        sets :trains,     to: { value: 0 }
        sets :red_trains, to: { value: 0 }
        sets :reason,     to: "raised: five calm readings"

        emits WorkCapWidened
      end

      command "HalveForMemory" do
        role "System"
        goal "Cut the cap to half: memory low on two readings in a row"

        reference_to WorkCap

        given("memory was low on two readings in a row") { pressed_run.value >= 2 }
        given("the cap is over the least") { current.value > least.value }

        sets :current,     to: current.value / 2
        sets :pressed_run, to: { value: 0 }
        sets :trains,      to: { value: 0 }
        sets :red_trains,  to: { value: 0 }
        sets :reason,      to: "cut: memory low twice in a row"

        emits WorkCapNarrowed
      end

      command "HalveForLoad" do
        role "System"
        goal "Cut the cap to half: the load over its mark for five readings"

        reference_to WorkCap

        given("the load stayed over its mark for five readings") { strained_run.value >= 5 }
        given("the cap is over the least") { current.value > least.value }

        sets :current,      to: current.value / 2
        sets :strained_run, to: { value: 0 }
        sets :trains,       to: { value: 0 }
        sets :red_trains,   to: { value: 0 }
        sets :reason,       to: "cut: load over its mark for five readings"

        emits WorkCapNarrowed
      end

      command "Floor" do
        role "System"
        goal "Bring the cap up to the least: a cut or a new bound left it under"

        reference_to WorkCap

        given("the cap is under the least") { current.value < least.value }

        sets :current, to: least.value

        emits WorkCapFloored
      end

      command "Ceil" do
        role "System"
        goal "Bring the cap down to the most: a new bound left it over"

        reference_to WorkCap

        given("the cap is over the most") { current.value > most.value }

        sets :current, to: most.value
        sets :reason,  to: "held at the most"

        emits WorkCapCeiled
      end
    end

    policy "OpenTheWorkCapWhenTheMachineIsRead" do
      on      "Machine.MachineSampled"
      trigger WorkCap::Open, with: { cap: "pipeline" }
    end

    policy "CountTheCalmReading" do
      on      "Machine.MachineSampled"
      where   { memory_state == "ok" && load_state == "below" }
      trigger WorkCap::CountCalm, with: { work_cap: "pipeline", least: :cap_least, most: :cap_most }
    end

    policy "CountThePressedReading" do
      on      "Machine.MachineSampled"
      where   { memory_state == "low" }
      trigger WorkCap::CountPressed, with: { work_cap: "pipeline", least: :cap_least, most: :cap_most }
    end

    policy "CountTheStrainedReading" do
      on      "Machine.MachineSampled"
      where   { memory_state == "ok" && load_state == "above" }
      trigger WorkCap::CountStrained, with: { work_cap: "pipeline", least: :cap_least, most: :cap_most }
    end

    policy "CountTheGreenTrain" do
      on      "Integration.TrainMergeSeen"
      trigger WorkCap::CountGreenTrain, with: { work_cap: "pipeline" }
    end

    policy "CountTheRedTrain" do
      on      "TrainPr.TrainPrFailed"
      where   { attempt == 1 }
      trigger WorkCap::CountRedTrain, with: { work_cap: "pipeline" }
    end

    policy "WidenAfterCalm" do
      on      "WorkCap.CalmReadingCounted"
      trigger WorkCap::Widen, with: { work_cap: "pipeline" }
    end

    policy "HalveWhenPressed" do
      on      "WorkCap.PressedReadingCounted"
      trigger WorkCap::HalveForMemory, with: { work_cap: "pipeline" }
    end

    policy "HalveWhenStrained" do
      on      "WorkCap.StrainedReadingCounted"
      trigger WorkCap::HalveForLoad, with: { work_cap: "pipeline" }
    end

    policy "FloorAfterTheCut" do
      on      "WorkCap.WorkCapNarrowed"
      trigger WorkCap::Floor, with: { work_cap: "pipeline" }
    end

    policy "FloorOnTheBounds" do
      on      "WorkCap.CalmReadingCounted"
      trigger WorkCap::Floor, with: { work_cap: "pipeline" }
    end

    policy "CeilOnTheBounds" do
      on      "WorkCap.CalmReadingCounted"
      trigger WorkCap::Ceil, with: { work_cap: "pipeline" }
    end
  end
end
