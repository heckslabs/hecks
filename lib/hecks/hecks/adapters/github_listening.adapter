# Binds the `Listening` port to `GithubListening`, which serves GitHub's webhook deliveries on
# 127.0.0.1 until it is stopped. Required by name, not relative to this file: a fuzz or model check
# boots a copy of this directory, and the implementation must load once, from `lib/`.
require "hecks/hecks/adapters/github_listening"

Hecks.adapter "GithubListening" do
  port "Listening"
end
