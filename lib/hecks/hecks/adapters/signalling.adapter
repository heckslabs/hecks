# Binds the `Signalling` port to `Signalling`, which begins Signalbox's pressure beat on the clock's
# beat. Required by name, not relative to this file: a fuzz or model check boots a copy of this
# directory, and the implementation must load once, from `lib/`, not from the copy.
require "hecks/signalbox/adapters/signalling"

Hecks.adapter "Signalling" do
  port "Signalling"
end
