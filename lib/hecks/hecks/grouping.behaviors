Hecks.behaviors "ChangeGroup" do
  vision "Changes that go together are one group, by evidence and never by title: a shared file, a derived output with its source, a wait, or one item's tasks."

  loads "hecks.bluebook", "context_map.hecksagon", "hecks.hecksagon", "red_wake.hecksagon", "stable_roll.hecksagon", "environments/memory.world", modules: :all

  test "Form groups two branches that change the same file" do
    tests "Form", on: "ChangeGroup"
    input group: { value: "a+b" }, branch: { value: "a" }, with: { value: "b" }, kind: { value: "shares_files" }, proof: { value: "lib/x.rb" }, files: ["lib/x.rb"], other_files: ["lib/x.rb"]
    expect status: { value: "formed" }
  end

  test "Form groups a source with the branch that changes its derived output" do
    tests "Form", on: "ChangeGroup"
    input group: { value: "a+b" }, branch: { value: "a" }, with: { value: "b" }, kind: { value: "derives" }, proof: { value: "lib/x.bluebook" }, output: "docs/x.md",
          sources: ["lib/x.bluebook"], files: ["lib/x.bluebook"], other_files: ["docs/x.md"]
    expect status: { value: "formed" }
  end

  test "Form groups a work item with the item it waits on" do
    tests "Form", on: "ChangeGroup"
    input group: { value: "a+b" }, branch: { value: "a" }, with: { value: "b" }, kind: { value: "waits_on" }, proof: { value: "b" }, waits_on: ["b"]
    expect status: { value: "formed" }
  end

  test "Form groups the tasks of one item" do
    tests "Form", on: "ChangeGroup"
    input group: { value: "a+b" }, branch: { value: "a" }, with: { value: "b" }, kind: { value: "same_item" }, proof: { value: "item-1" }, work_item: "item-1", other_work_item: "item-1"
    expect status: { value: "formed" }
  end

  test "Form refuses two branches whose files do not meet" do
    tests "Form", on: "ChangeGroup"
    input group: { value: "a+b" }, branch: { value: "a" }, with: { value: "b" }, kind: { value: "shares_files" }, proof: { value: "lib/x.rb" }, files: ["lib/x.rb"], other_files: ["lib/y.rb"]
    expect refused: "a shared file is changed by both branches"
  end

  test "Form refuses a derived output with no source in the other branch" do
    tests "Form", on: "ChangeGroup"
    input group: { value: "a+b" }, branch: { value: "a" }, with: { value: "b" }, kind: { value: "derives" }, proof: { value: "lib/x.bluebook" }, output: "docs/x.md",
          sources: ["lib/x.bluebook"], files: ["lib/x.bluebook"], other_files: ["docs/y.md"]
    expect refused: "a derived output is changed beside its source"
  end

  test "Form refuses a wait the branch does not hold" do
    tests "Form", on: "ChangeGroup"
    input group: { value: "a+b" }, branch: { value: "a" }, with: { value: "b" }, kind: { value: "waits_on" }, proof: { value: "b" }, waits_on: ["c"]
    expect refused: "a wait names the work item the branch waits on"
  end

  test "Form refuses tasks of different items" do
    tests "Form", on: "ChangeGroup"
    input group: { value: "a+b" }, branch: { value: "a" }, with: { value: "b" }, kind: { value: "same_item" }, proof: { value: "item-1" }, work_item: "item-1", other_work_item: "item-2"
    expect refused: "one item holds both tasks"
  end

  test "Form refuses a kind of evidence the group does not know" do
    tests "Form", on: "ChangeGroup"
    input group: { value: "a+b" }, branch: { value: "a" }, with: { value: "b" }, kind: { value: "similar_titles" }, proof: { value: "x" }
    expect refused: "the evidence is one of derives, shares_files, waits_on, same_item"
  end

  test "Form refuses evidence that names no proof" do
    tests "Form", on: "ChangeGroup"
    input group: { value: "a+b" }, branch: { value: "a" }, with: { value: "b" }, kind: { value: "same_item" }, proof: { value: "" }
    expect refused: "the evidence names its proof"
  end

  test "Form refuses a branch grouped with itself" do
    tests "Form", on: "ChangeGroup"
    input group: { value: "a+a" }, branch: { value: "a" }, with: { value: "a" }, kind: { value: "same_item" }, proof: { value: "i" },
          work_item: "i", other_work_item: "i"
    expect refused: "a group joins two different branches"
  end
end
