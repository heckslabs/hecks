Hecks.bluebook "Hecks" do
  domain_module "Evolve" do
    vision "Change the language and rewrite to match."

    # Codebase: working on this repository. Each aggregate here is a concern only a maintainer of
    # Hecks runs, and every one of them needs a hecks checkout (ADR 0080, section 2). A request
    # follows the journaled-command shape of Custodian: it is recorded, the SourceTree port is asked
    # to examine the tree, `Accept` holds the one rule every Codebase change shares (the working tree
    # is a hecks checkout, hecks.gemspec beside lib/), and only an accepted request is carried out.
    # A command that rewrites tracked files reports drift and writes only when it is confirmed.
    #
    # The records are named for the run, as ModelCheckRun is, because several of the table's
    # concerns share a name with a module the gem already owns.

    # The language: the tables the Bluebook bluebook declares and everything projected from them. A
    # projection reports drift from the committed files and writes only when it is confirmed; an
    # evolution edits the syntax tables, regenerates the golden and holds the gates, and only when
    # confirmed (without it, the edit is rehearsed in memory and nothing is written).
    aggregate "LanguageRun", kind: "Run" do
      description "One change to the language's own tables, or one reading of where its words stand."

      attribute :confirm,     Switch, optional: true
      attribute :stdout,      Switch, optional: true
      attribute :word,        Word, optional: true
      attribute :context,     Context, optional: true
      attribute :body,        Body, optional: true
      attribute :inner,       Fill, optional: true
      attribute :opens,       Fill, optional: true
      attribute :fills,       Fill, optional: true
      attribute :new_name,    Word, optional: true
      attribute :kind,        Kind, optional: true
      attribute :required,    Flag, optional: true
      attribute :at,          Position, optional: true
      attribute :named,       Fill, optional: true
      attribute :pairs_shape, Shape, optional: true

      # A keyword of the language, or the keyword an argument belongs to.
      value_object "Word" do
        attribute :value, String, matches: :present

        invariant("a word is named") { !value.to_s.empty? }
      end

      # The part of the language a word is a word in.
      value_object "Context" do
        attribute :value, String, matches: :identifier
      end

      # What a word's block holds.
      value_object "Body" do
        attribute :value, String, pattern: '^(none|keywords|source|rows)$'
      end

      # A cell of a table row; empty when the row leaves it blank.
      value_object "Fill" do
        attribute :value, String, pattern: '^[^\t\n\r]*$'
      end

      # What an argument is.
      value_object "Kind" do
        attribute :value, String, pattern: '^(text|symbol|number|flag|literal|constant|pairs|list)$'
      end

      # Whether an argument is required.
      value_object "Flag" do
        attribute :value, String, pattern: '^(true|false)$'
      end

      # An argument's place, counted from zero.
      value_object "Position" do
        attribute :value, String, pattern: '^[0-9]*$'
      end

      # How a pairs argument is read, such as verbatim.
      value_object "Shape" do
        attribute :value, String, matches: :present
      end

      command "ProjectModel" do
        role "Maintainer"
        goal "Project the model's holding half from the language that declares it"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "project_model"

        emits ProjectModelRequested
      end

      command "ProjectVocabulary" do
        role "Maintainer"
        goal "Project the language's closed sets into the vocabulary"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "project_vocabulary"

        emits ProjectVocabularyRequested
      end

      command "ProjectRustVocabulary" do
        role "Maintainer"
        goal "Project the vocabulary tables into the Rust kernel, one enum a table"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "project_rust_vocabulary"

        emits ProjectRustVocabularyRequested
      end

      command "ProjectRefusalWording" do
        role "Maintainer"
        goal "Project the refusal template table, a second name of ProjectRustVocabulary"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "project_rust_vocabulary"

        emits ProjectRefusalWordingRequested
      end

      command "ProjectReservedNames" do
        role "Maintainer"
        goal "Project the Rust and Cargo reserved words into the codegen and build crates"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "project_reserved_names"

        emits ProjectReservedNamesRequested
      end

      command "ProjectParserTable" do
        role "Maintainer"
        goal "Project the Rust parser's keyword table"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "project_parser_table"

        emits ProjectParserTableRequested
      end

      command "ProjectPhraseTable" do
        role "Maintainer"
        goal "Project the Rust parser's sentence table from the Sentence bluebook's phrase rows"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "project_phrase_table"

        emits ProjectPhraseTableRequested
      end

      command "ProjectBootstrapTable" do
        role "Maintainer"
        goal "Project the DSL's bootstrap-window fallbacks from the keyword rows"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "project_bootstrap_table"

        emits ProjectBootstrapTableRequested
      end

      command "ProjectFieldHints" do
        role "Maintainer"
        goal "Project the host's form-field hints"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "project_field_hints"

        emits ProjectFieldHintsRequested
      end

      command "ProjectExpressionTables" do
        role "Maintainer"
        goal "Project the expression machinery's operator and normalisation tables"

        attribute :stdout,  Switch, optional: true, sets: true
        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "project_expression_tables"

        emits ProjectExpressionTablesRequested
      end

      command "ProjectReference" do
        role "Maintainer"
        goal "Regenerate the DSL reference from the Syntax bluebook, keeping the committed prose"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "project_reference"

        emits ProjectReferenceRequested
      end

      command "Propose" do
        role "Maintainer"
        goal "Enter a keyword row, proposed: it reaches no projection until admitted"

        attribute :word,    Word, sets: true
        attribute :context, Context, sets: true
        attribute :body,    Body, optional: true, sets: true
        attribute :inner,   Fill, optional: true, sets: true
        attribute :opens,   Fill, optional: true, sets: true
        attribute :fills,   Fill, optional: true, sets: true
        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "propose"

        emits ProposeRequested
      end

      command "Admit" do
        role "Maintainer"
        goal "Move a proposed keyword row to admitted"

        attribute :word,    Word, sets: true
        attribute :context, Context, sets: true
        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "admit"

        emits AdmitRequested
      end

      command "Deprecate" do
        role "Maintainer"
        goal "Move an admitted keyword row to deprecated"

        attribute :word,    Word, sets: true
        attribute :context, Context, sets: true
        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "deprecate"

        emits DeprecateRequested
      end

      command "Retire" do
        role "Maintainer"
        goal "Move a deprecated or admitted keyword row to retired"

        attribute :word,    Word, sets: true
        attribute :context, Context, sets: true
        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "retire"

        emits RetireRequested
      end

      command "Rename" do
        role "Maintainer"
        goal "Respell a keyword row; the old spelling keeps parsing"

        attribute :word,     Word, sets: true
        attribute :context,  Context, sets: true
        attribute :new_name, Word, sets: true
        attribute :run,      RunKey, sets: true
        attribute :confirm,  Switch, optional: true, sets: true

        sets :operation, to: "rename"

        emits RenameRequested
      end

      command "ProposeArgument" do
        role "Maintainer"
        goal "Enter an argument row of a keyword, proposed"

        attribute :word,        Word, sets: true
        attribute :context,     Context, sets: true
        attribute :kind,        Kind, sets: true
        attribute :required,    Flag, optional: true, sets: true
        attribute :at,          Position, optional: true, sets: true
        attribute :named,       Fill, optional: true, sets: true
        attribute :fills,       Fill, optional: true, sets: true
        attribute :pairs_shape, Shape, optional: true, sets: true
        attribute :run,         RunKey, sets: true
        attribute :confirm,     Switch, optional: true, sets: true

        sets :operation, to: "propose_argument"

        emits ProposeArgumentRequested
      end

      command "AdmitArgument" do
        role "Maintainer"
        goal "Move a proposed argument row to admitted"

        attribute :word,    Word, sets: true
        attribute :context, Context, sets: true
        attribute :at,      Position, optional: true, sets: true
        attribute :named,   Fill, optional: true, sets: true
        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "admit_argument"

        emits AdmitArgumentRequested
      end

      command "DeprecateArgument" do
        role "Maintainer"
        goal "Move an admitted argument row to deprecated"

        attribute :word,    Word, sets: true
        attribute :context, Context, sets: true
        attribute :at,      Position, optional: true, sets: true
        attribute :named,   Fill, optional: true, sets: true
        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "deprecate_argument"

        emits DeprecateArgumentRequested
      end

      command "RetireArgument" do
        role "Maintainer"
        goal "Move a deprecated or admitted argument row to retired"

        attribute :word,    Word, sets: true
        attribute :context, Context, sets: true
        attribute :at,      Position, optional: true, sets: true
        attribute :named,   Fill, optional: true, sets: true
        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "retire_argument"

        emits RetireArgumentRequested
      end

      # An answer that is one document of text, exactly as the tool that produced it wrote it.
      value_object "Document" do
        attribute :text, String
      end

      query "WordStatus" do
        description "Where every word of the language stands: the ones not simply admitted, and the renamed."
        returns Document
      end
    end

    policy "ExamineWhenProjectModelRequested" do
      on      "LanguageRun.ProjectModelRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenProjectVocabularyRequested" do
      on      "LanguageRun.ProjectVocabularyRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenProjectRustVocabularyRequested" do
      on      "LanguageRun.ProjectRustVocabularyRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenProjectRefusalWordingRequested" do
      on      "LanguageRun.ProjectRefusalWordingRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenProjectReservedNamesRequested" do
      on      "LanguageRun.ProjectReservedNamesRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenProjectParserTableRequested" do
      on      "LanguageRun.ProjectParserTableRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenProjectPhraseTableRequested" do
      on      "LanguageRun.ProjectPhraseTableRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenProjectBootstrapTableRequested" do
      on      "LanguageRun.ProjectBootstrapTableRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenProjectFieldHintsRequested" do
      on      "LanguageRun.ProjectFieldHintsRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenProjectExpressionTablesRequested" do
      on      "LanguageRun.ProjectExpressionTablesRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenProjectReferenceRequested" do
      on      "LanguageRun.ProjectReferenceRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenProposeRequested" do
      on      "LanguageRun.ProposeRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenAdmitRequested" do
      on      "LanguageRun.AdmitRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenDeprecateRequested" do
      on      "LanguageRun.DeprecateRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenRetireRequested" do
      on      "LanguageRun.RetireRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenRenameRequested" do
      on      "LanguageRun.RenameRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenProposeArgumentRequested" do
      on      "LanguageRun.ProposeArgumentRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenAdmitArgumentRequested" do
      on      "LanguageRun.AdmitArgumentRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenDeprecateArgumentRequested" do
      on      "LanguageRun.DeprecateArgumentRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenRetireArgumentRequested" do
      on      "LanguageRun.RetireArgumentRequested"
      ask     :examine, with: { run: :run }
    end

    aggregate "SyntaxBootCache" do
      description "The grammar bluebooks' on-disk boot cache, keyed by a digest of the bluebooks it was built from."

      attribute :digest, Digest

      identified_by :digest

      value_object "Digest" do
        attribute :value, String, matches: :present

        invariant("a digest is present") { !value.to_s.empty? }
      end

      lifecycle :state, default: "fresh" do
        transition "Invalidate" => "stale", from: "fresh"
        transition "Rebuild"    => "fresh", from: "stale"
      end

      command "Record" do
        role "Maintainer"
        goal "Record a boot cache as built from the grammar bluebooks that hash to this digest"
        audience :record

        attribute :digest, Digest, sets: true


        emits CacheRecorded
      end

      command "Invalidate", from: "fresh" do
        role "Maintainer"
        goal "Record that the grammar changed under the cache"
        audience :record

        reference_to SyntaxBootCache

        emits CacheInvalidated
      end

      command "Rebuild", from: "stale" do
        role "Maintainer"
        goal "Record that the cache was rebuilt from the current grammar"
        audience :record

        reference_to SyntaxBootCache

        emits CacheRebuilt
      end

      query "Stale" do
        description "Every cache whose grammar changed under it and is not yet rebuilt."
        where(state: "stale")
        order_by :digest
      end
    end

    # Codemod: the mechanical rewrites of the example bluebooks. Each one edits tracked files, so
    # unconfirmed it rehearses the edit (the script reboots every bluebook and puts the files back)
    # and reports what it would change; the files stay changed only when it is confirmed.
    aggregate "CodemodRun", kind: "Run" do
      description "One rewrite of the example bluebooks by a codemod, or the rehearsal of it."

      attribute :confirm,   Switch, optional: true

      command "HoistLocalGivens" do
        role "Maintainer"
        goal "Hoist a given that several commands of one owner repeat into one owner-level given"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "hoist_local_givens"

        emits HoistLocalGivensRequested
      end

      command "DropImplicitAppendFields" do
        role "Maintainer"
        goal "Drop an attribute line that only repeats what an append target element declares"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "drop_implicit_append_fields"

        emits DropImplicitAppendFieldsRequested
      end

      command "MoveFormerName" do
        role "Maintainer"
        goal "Move an aggregate's formerly_known_as out of the bluebook into the world's stored_as"

        attribute :run,     RunKey, sets: true
        attribute :confirm, Switch, optional: true, sets: true

        sets :operation, to: "move_former_name"

        emits MoveFormerNameRequested
      end
    end

    policy "ExamineWhenHoistLocalGivensRequested" do
      on      "CodemodRun.HoistLocalGivensRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenDropImplicitAppendFieldsRequested" do
      on      "CodemodRun.DropImplicitAppendFieldsRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenMoveFormerNameRequested" do
      on      "CodemodRun.MoveFormerNameRequested"
      ask     :examine, with: { run: :run }
    end

    # One named one-off script the checkout runs: planned, or applied once confirmed. Its body is a
    # tool under lib/hecks/tools, named by `script`, so a migration is a record, not a shell session.
    aggregate "ScriptRun" do
      description "One named one-off script the checkout runs, planned or applied; the body is a tool."

      attribute :run,       RunKey
      attribute :operation, Operation, optional: true
      attribute :script,    ScriptName, optional: true
      attribute :confirm,   Switch, optional: true
      attribute :checkout,  Switch, optional: true
      attribute :report,    Report, optional: true
      attribute :refusal,   Report, optional: true
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present

        invariant("a run is named") { !value.to_s.empty? }
      end

      value_object "Operation" do
        attribute :value, String, matches: :present
      end

      value_object "Switch" do
        attribute :value, Boolean
      end

      value_object "Report" do
        attribute :value, String
      end

      # The name of a tool under lib/hecks/tools, such as move_disables.
      value_object "ScriptName" do
        attribute :value, String, pattern: '^[a-z_]+$'

        invariant("a script is named") { !value.to_s.empty? }
      end

      lifecycle :status, default: "requested" do
        mark :failure, "faulted"
        transition "Accept"   => "accepted",  from: "requested"
        transition "Complete" => "completed", from: "accepted"
        transition "Fault"    => "faulted",   from: %w[requested accepted]
        mark :terminal, "completed", "faulted"
      end

      command "PlanScript" do
        role "Maintainer"
        goal "Show what a named one-off script would change, writing nothing"

        attribute :run,    RunKey, sets: true
        attribute :script, ScriptName, sets: true

        sets :operation, to: "plan_script"

        emits PlanScriptRequested
      end

      command "ApplyScript" do
        role "Maintainer"
        goal "Carry out a named one-off script's changes, only when confirmed"

        attribute :run,     RunKey, sets: true
        attribute :script,  ScriptName, sets: true
        attribute :confirm, Switch, sets: true

        given("the apply is confirmed") { confirm.value }

        sets :operation, to: "apply_script"

        emits ApplyScriptRequested
      end

      # What the tree reported about itself, held against every request: nothing here runs
      # outside a hecks checkout (hecks.gemspec beside lib/).
      command "Accept" do
        role "System"
        goal "Let a request through only when the working tree is a hecks checkout"

        reference_to ScriptRun
        attribute :checkout, Switch, sets: true

        given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }

        emits ScriptAccepted
      end

      command "Complete" do
        role "System"
        goal "Record that the request was carried out, and what it reported"

        reference_to ScriptRun
        attribute :report, Report, sets: true

        emits ScriptCompleted
      end

      command "Fault" do
        role "System"
        goal "Record that the request was refused or could not be carried out, and why"

        reference_to ScriptRun
        attribute :refusal, Report, sets: true

        emits ScriptFaulted
      end
    end

    policy "ExamineWhenPlanScriptRequested" do
      on      "ScriptRun.PlanScriptRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenApplyScriptRequested" do
      on      "ScriptRun.ApplyScriptRequested"
      ask     :examine, with: { run: :run }
    end

    policy "AcceptScriptWhenExamined" do
      on      "ScriptRun.ScriptExamined"
      trigger ScriptRun::Accept, with: { checkout: :checkout }
    end

    policy "FaultScriptWhenNotAccepted" do
      on      "ScriptRun.ScriptExamined"
      where   { !checkout.value }
      trigger ScriptRun::Fault, with: { refusal: "needs a hecks checkout: hecks.gemspec stands beside lib/" }
    end

    policy "PerformScriptWhenAccepted" do
      on      "ScriptRun.ScriptAccepted"
      ask     :perform, with: { run: :run }
    end

    policy "RecordScriptOutcome" do
      on      "ScriptRun.ScriptAnswered"
      trigger ScriptRun::Complete, with: { report: :report }
    end

    policy "RecordScriptFault" do
      on      "ScriptRun.ScriptRefused"
      trigger ScriptRun::Fault, with: { refusal: :refusal }
    end

    policy "ExamineWhenCheckCommentsRequested" do
      on      "StyleRun.CheckCommentsRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenFixCommentsRequested" do
      on      "StyleRun.FixCommentsRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenWriteCommentBaselineRequested" do
      on      "StyleRun.WriteCommentBaselineRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenCheckCommentsUnchangedRequested" do
      on      "StyleRun.CheckCommentsUnchangedRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenCheckRustCommentsRequested" do
      on      "StyleRun.CheckRustCommentsRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenFixRustCommentsRequested" do
      on      "StyleRun.FixRustCommentsRequested"
      ask     :examine, with: { run: :run }
    end

    policy "ExamineWhenCanonicaliseRequested" do
      on      "StyleRun.CanonicaliseRequested"
      ask     :examine, with: { run: :run }
    end

    policy "AcceptStyleWhenExamined" do
      on      "StyleRun.StyleExamined"
      trigger StyleRun::Accept, with: { checkout: :checkout }
    end

    policy "FaultStyleWhenNotAccepted" do
      on      "StyleRun.StyleExamined"
      where   { !checkout.value }
      trigger StyleRun::Fault, with: { refusal: "needs a hecks checkout: hecks.gemspec stands beside lib/" }
    end

    policy "PerformStyleWhenAccepted" do
      on      "StyleRun.StyleAccepted"
      ask     :perform, with: { run: :run }
    end

    policy "RecordStyleOutcome" do
      on      "StyleRun.StyleAnswered"
      trigger StyleRun::Complete, with: { run: :run, report: :report }
    end

    policy "RecordStyleFault" do
      on      "StyleRun.StyleRefused"
      trigger StyleRun::Fault, with: { refusal: :refusal }
    end
  end
end
