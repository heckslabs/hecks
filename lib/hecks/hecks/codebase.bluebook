Hecks.bluebook "Hecks" do
  # Codebase: working on this repository. Each aggregate here is a concern only a maintainer of
  # Hecks runs, and every one of them needs a hecks checkout (ADR 0080, section 2). A request
  # follows the journaled-command shape of Custodian: it is recorded, the SourceTree port is asked
  # to examine the tree, `Accept` holds the one rule every Codebase change shares (the working tree
  # is a hecks checkout, hecks.gemspec beside lib/), and only an accepted request is carried out.
  # A command that rewrites tracked files reports drift and writes only when it is confirmed.
  #
  # The records are named for the run, as ModelCheckRun is, because several of the table's
  # concerns share a name with a module the gem already owns.

  # The language: the tables the Bluebook bluebook declares and everything projected from them. A
  # projection reports drift from the committed files and writes only when it is confirmed; an
  # evolution edits the syntax tables, regenerates the golden and holds the gates, and only when
  # confirmed (without it, the edit is rehearsed in memory and nothing is written).
  aggregate "LanguageRun" do
    description "One change to the language's own tables, or one reading of where its words stand."

    attribute :run,         RunKey
    attribute :operation,   Operation, optional: true
    attribute :confirm,     Switch, optional: true
    attribute :stdout,      Switch, optional: true
    attribute :word,        Word, optional: true
    attribute :context,     Context, optional: true
    attribute :body,        Body, optional: true
    attribute :inner,       Fill, optional: true
    attribute :opens,       Fill, optional: true
    attribute :fills,       Fill, optional: true
    attribute :new_name,    Word, optional: true
    attribute :kind,        Kind, optional: true
    attribute :required,    Flag, optional: true
    attribute :at,          Position, optional: true
    attribute :named,       Fill, optional: true
    attribute :pairs_shape, Shape, optional: true
    attribute :checkout,    Switch, optional: true
    attribute :report,      Report, optional: true
    attribute :refusal,     Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, matches: :present

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Operation" do
      attribute :value, String, matches: :present
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    # A keyword of the language, or the keyword an argument belongs to.
    value_object "Word" do
      attribute :value, String, matches: :present

      invariant("a word is named") { !value.to_s.empty? }
    end

    # The part of the language a word is a word in.
    value_object "Context" do
      attribute :value, String, matches: :identifier
    end

    # What a word's block holds.
    value_object "Body" do
      attribute :value, String, pattern: '^(none|keywords|source|rows)$'
    end

    # A cell of a table row; empty when the row leaves it blank.
    value_object "Fill" do
      attribute :value, String, pattern: '^[^\t\n\r]*$'
    end

    # What an argument is.
    value_object "Kind" do
      attribute :value, String, pattern: '^(text|symbol|number|flag|literal|constant|pairs|list)$'
    end

    # Whether an argument is required.
    value_object "Flag" do
      attribute :value, String, pattern: '^(true|false)$'
    end

    # An argument's place, counted from zero.
    value_object "Position" do
      attribute :value, String, pattern: '^[0-9]*$'
    end

    # How a pairs argument is read, such as verbatim.
    value_object "Shape" do
      attribute :value, String, matches: :present
    end

    lifecycle :status, default: "requested" do
      mark :failure, "faulted"
      transition "Accept"   => "accepted",  from: "requested"
      transition "Complete" => "completed", from: "accepted"
      transition "Fault"    => "faulted",   from: %w[requested accepted]
      mark :terminal, "completed", "faulted"
    end

    command "ProjectModel" do
      role "Maintainer"
      goal "Project the model's holding half from the language that declares it"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_model"

      emits ProjectModelRequested
    end

    command "ProjectVocabulary" do
      role "Maintainer"
      goal "Project the language's closed sets into the vocabulary"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_vocabulary"

      emits ProjectVocabularyRequested
    end

    command "ProjectRustVocabulary" do
      role "Maintainer"
      goal "Project the vocabulary tables into the Rust kernel, one enum a table"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_rust_vocabulary"

      emits ProjectRustVocabularyRequested
    end

    command "ProjectRefusalWording" do
      role "Maintainer"
      goal "Project the refusal template table, a second name of ProjectRustVocabulary"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_rust_vocabulary"

      emits ProjectRefusalWordingRequested
    end

    command "ProjectReservedNames" do
      role "Maintainer"
      goal "Project the Rust and Cargo reserved words into the codegen and build crates"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_reserved_names"

      emits ProjectReservedNamesRequested
    end

    command "ProjectParserTable" do
      role "Maintainer"
      goal "Project the Rust parser's keyword table"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_parser_table"

      emits ProjectParserTableRequested
    end

    command "ProjectPhraseTable" do
      role "Maintainer"
      goal "Project the Rust parser's sentence table from the Sentence bluebook's phrase rows"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_phrase_table"

      emits ProjectPhraseTableRequested
    end

    command "ProjectBootstrapTable" do
      role "Maintainer"
      goal "Project the DSL's bootstrap-window fallbacks from the keyword rows"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_bootstrap_table"

      emits ProjectBootstrapTableRequested
    end

    command "ProjectFieldHints" do
      role "Maintainer"
      goal "Project the host's form-field hints"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_field_hints"

      emits ProjectFieldHintsRequested
    end

    command "ProjectExpressionTables" do
      role "Maintainer"
      goal "Project the expression machinery's operator and normalisation tables"

      attribute :stdout,  Switch, optional: true, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_expression_tables"

      emits ProjectExpressionTablesRequested
    end

    command "ProjectReference" do
      role "Maintainer"
      goal "Regenerate the DSL reference from the Syntax bluebook, keeping the committed prose"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_reference"

      emits ProjectReferenceRequested
    end

    command "Propose" do
      role "Maintainer"
      goal "Enter a keyword row, proposed: it reaches no projection until admitted"

      attribute :word,    Word, sets: true
      attribute :context, Context, sets: true
      attribute :body,    Body, optional: true, sets: true
      attribute :inner,   Fill, optional: true, sets: true
      attribute :opens,   Fill, optional: true, sets: true
      attribute :fills,   Fill, optional: true, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "propose"

      emits ProposeRequested
    end

    command "Admit" do
      role "Maintainer"
      goal "Move a proposed keyword row to admitted"

      attribute :word,    Word, sets: true
      attribute :context, Context, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "admit"

      emits AdmitRequested
    end

    command "Deprecate" do
      role "Maintainer"
      goal "Move an admitted keyword row to deprecated"

      attribute :word,    Word, sets: true
      attribute :context, Context, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "deprecate"

      emits DeprecateRequested
    end

    command "Retire" do
      role "Maintainer"
      goal "Move a deprecated or admitted keyword row to retired"

      attribute :word,    Word, sets: true
      attribute :context, Context, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "retire"

      emits RetireRequested
    end

    command "Rename" do
      role "Maintainer"
      goal "Respell a keyword row; the old spelling keeps parsing"

      attribute :word,     Word, sets: true
      attribute :context,  Context, sets: true
      attribute :new_name, Word, sets: true
      attribute :run,      RunKey, sets: true
      attribute :confirm,  Switch, optional: true, sets: true

      sets :operation, to: "rename"

      emits RenameRequested
    end

    command "ProposeArgument" do
      role "Maintainer"
      goal "Enter an argument row of a keyword, proposed"

      attribute :word,        Word, sets: true
      attribute :context,     Context, sets: true
      attribute :kind,        Kind, sets: true
      attribute :required,    Flag, optional: true, sets: true
      attribute :at,          Position, optional: true, sets: true
      attribute :named,       Fill, optional: true, sets: true
      attribute :fills,       Fill, optional: true, sets: true
      attribute :pairs_shape, Shape, optional: true, sets: true
      attribute :run,         RunKey, sets: true
      attribute :confirm,     Switch, optional: true, sets: true

      sets :operation, to: "propose_argument"

      emits ProposeArgumentRequested
    end

    command "AdmitArgument" do
      role "Maintainer"
      goal "Move a proposed argument row to admitted"

      attribute :word,    Word, sets: true
      attribute :context, Context, sets: true
      attribute :at,      Position, optional: true, sets: true
      attribute :named,   Fill, optional: true, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "admit_argument"

      emits AdmitArgumentRequested
    end

    command "DeprecateArgument" do
      role "Maintainer"
      goal "Move an admitted argument row to deprecated"

      attribute :word,    Word, sets: true
      attribute :context, Context, sets: true
      attribute :at,      Position, optional: true, sets: true
      attribute :named,   Fill, optional: true, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "deprecate_argument"

      emits DeprecateArgumentRequested
    end

    command "RetireArgument" do
      role "Maintainer"
      goal "Move a deprecated or admitted argument row to retired"

      attribute :word,    Word, sets: true
      attribute :context, Context, sets: true
      attribute :at,      Position, optional: true, sets: true
      attribute :named,   Fill, optional: true, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "retire_argument"

      emits RetireArgumentRequested
    end

    # What the tree reported about itself, held against every request: nothing here runs
    # outside a hecks checkout (hecks.gemspec beside lib/).
    command "Accept" do
      role "System"
      goal "Let a request through only when the working tree is a hecks checkout"

      reference_to LanguageRun
      attribute :checkout, Switch, sets: true

      given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }


      emits LanguageAccepted
    end

    command "Complete" do
      role "System"
      goal "Record that the request was carried out, and what it reported"

      reference_to LanguageRun
      attribute :report, Report, sets: true


      emits LanguageCompleted
    end

    command "Fault" do
      role "System"
      goal "Record that the request was refused or could not be carried out, and why"

      reference_to LanguageRun
      attribute :refusal, Report, sets: true


      emits LanguageFaulted
    end

    query "LanguageOutcome" do
      description "How one request ended: its status, and what it reported or why it failed."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "LanguageFaulted" do
      description "Every request that was refused or could not be carried out."
      where(status: "faulted")
      order_by :run
    end

    # An answer that is one document of text, exactly as the tool that produced it wrote it.
    value_object "Document" do
      attribute :text, String
    end

    query "WordStatus" do
      description "Where every word of the language stands: the ones not simply admitted, and the renamed."
      returns Document
    end
  end

  policy "ExamineWhenProjectModelRequested" do
    on      "LanguageRun.ProjectModelRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProjectVocabularyRequested" do
    on      "LanguageRun.ProjectVocabularyRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProjectRustVocabularyRequested" do
    on      "LanguageRun.ProjectRustVocabularyRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProjectRefusalWordingRequested" do
    on      "LanguageRun.ProjectRefusalWordingRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProjectReservedNamesRequested" do
    on      "LanguageRun.ProjectReservedNamesRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProjectParserTableRequested" do
    on      "LanguageRun.ProjectParserTableRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProjectPhraseTableRequested" do
    on      "LanguageRun.ProjectPhraseTableRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProjectBootstrapTableRequested" do
    on      "LanguageRun.ProjectBootstrapTableRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProjectFieldHintsRequested" do
    on      "LanguageRun.ProjectFieldHintsRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProjectExpressionTablesRequested" do
    on      "LanguageRun.ProjectExpressionTablesRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProjectReferenceRequested" do
    on      "LanguageRun.ProjectReferenceRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProposeRequested" do
    on      "LanguageRun.ProposeRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenAdmitRequested" do
    on      "LanguageRun.AdmitRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenDeprecateRequested" do
    on      "LanguageRun.DeprecateRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenRetireRequested" do
    on      "LanguageRun.RetireRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenRenameRequested" do
    on      "LanguageRun.RenameRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProposeArgumentRequested" do
    on      "LanguageRun.ProposeArgumentRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenAdmitArgumentRequested" do
    on      "LanguageRun.AdmitArgumentRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenDeprecateArgumentRequested" do
    on      "LanguageRun.DeprecateArgumentRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenRetireArgumentRequested" do
    on      "LanguageRun.RetireArgumentRequested"
    ask     :examine, with: { run: :run }
  end

  policy "AcceptLanguageWhenExamined" do
    on      "LanguageRun.LanguageExamined"
    trigger LanguageRun::Accept, with: { checkout: :checkout }
  end

  policy "FaultLanguageWhenNotAccepted" do
    on      "LanguageRun.LanguageExamined"
    where   { !checkout.value }
    trigger LanguageRun::Fault, with: { refusal: "needs a hecks checkout: hecks.gemspec stands beside lib/" }
  end

  policy "PerformLanguageWhenAccepted" do
    on      "LanguageRun.LanguageAccepted"
    ask     :perform, with: { run: :run }
  end

  policy "RecordLanguageOutcome" do
    on      "LanguageRun.LanguageAnswered"
    trigger LanguageRun::Complete, with: { report: :report }
  end

  policy "RecordLanguageFault" do
    on      "LanguageRun.LanguageRefused"
    trigger LanguageRun::Fault, with: { refusal: :refusal }
  end

  # The Rust kernel: the capability enums the hand-written kernel is matched against, and the check
  # that every attribute shape and expression-operator category the grammar admits has its file.
  aggregate "KernelRun" do
    description "One projection of the Rust kernel's capability enums, or one measure of their coverage."

    attribute :run,       RunKey
    attribute :operation, Operation, optional: true
    attribute :confirm,   Switch, optional: true
    attribute :checkout,  Switch, optional: true
    attribute :report,    Report, optional: true
    attribute :refusal,   Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, matches: :present

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Operation" do
      attribute :value, String, matches: :present
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      mark :failure, "faulted"
      transition "Accept"   => "accepted",  from: "requested"
      transition "Complete" => "completed", from: "accepted"
      transition "Fault"    => "faulted",   from: %w[requested accepted]
      mark :terminal, "completed", "faulted"
    end

    command "ProjectKernelCapabilities" do
      role "Maintainer"
      goal "Project the capability enums the hand-written Rust kernel is matched against"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_kernel_capabilities"

      emits ProjectKernelCapabilitiesRequested
    end

    command "MeasureKernelCoverage" do
      role "Maintainer"
      goal "Check that every capability the grammar admits has its hand-written kernel file"

      attribute :run, RunKey, sets: true

      sets :operation, to: "measure_kernel_coverage"

      emits MeasureKernelCoverageRequested
    end

    # What the tree reported about itself, held against every request: nothing here runs
    # outside a hecks checkout (hecks.gemspec beside lib/).
    command "Accept" do
      role "System"
      goal "Let a request through only when the working tree is a hecks checkout"

      reference_to KernelRun
      attribute :checkout, Switch, sets: true

      given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }


      emits KernelAccepted
    end

    command "Complete" do
      role "System"
      goal "Record that the request was carried out, and what it reported"

      reference_to KernelRun
      attribute :report, Report, sets: true


      emits KernelCompleted
    end

    command "Fault" do
      role "System"
      goal "Record that the request was refused or could not be carried out, and why"

      reference_to KernelRun
      attribute :refusal, Report, sets: true


      emits KernelFaulted
    end

    query "KernelOutcome" do
      description "How one request ended: its status, and what it reported or why it failed."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "KernelFaulted" do
      description "Every request that was refused or could not be carried out."
      where(status: "faulted")
      order_by :run
    end
  end

  policy "ExamineWhenProjectKernelCapabilitiesRequested" do
    on      "KernelRun.ProjectKernelCapabilitiesRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenMeasureKernelCoverageRequested" do
    on      "KernelRun.MeasureKernelCoverageRequested"
    ask     :examine, with: { run: :run }
  end

  policy "AcceptKernelWhenExamined" do
    on      "KernelRun.KernelExamined"
    trigger KernelRun::Accept, with: { checkout: :checkout }
  end

  policy "FaultKernelWhenNotAccepted" do
    on      "KernelRun.KernelExamined"
    where   { !checkout.value }
    trigger KernelRun::Fault, with: { refusal: "needs a hecks checkout: hecks.gemspec stands beside lib/" }
  end

  policy "PerformKernelWhenAccepted" do
    on      "KernelRun.KernelAccepted"
    ask     :perform, with: { run: :run }
  end

  policy "RecordKernelOutcome" do
    on      "KernelRun.KernelAnswered"
    trigger KernelRun::Complete, with: { report: :report }
  end

  policy "RecordKernelFault" do
    on      "KernelRun.KernelRefused"
    trigger KernelRun::Fault, with: { refusal: :refusal }
  end

  # Conformance: the checks on the language itself. Each finds every disagreement and refuses with
  # them all, so a check that fails is recorded as faulted with what it found. The argument-gate
  # matrix rewrites a committed matrix and its fixtures, so it only reports unless it is confirmed.
  aggregate "ConformanceRun" do
    description "One check that the engines, the reference docs and the argument gates agree with the language."

    attribute :run,       RunKey
    attribute :operation, Operation, optional: true
    attribute :confirm,   Switch, optional: true
    attribute :additive,  Switch, optional: true
    attribute :checkout,  Switch, optional: true
    attribute :report,    Report, optional: true
    attribute :refusal,   Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, matches: :present

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Operation" do
      attribute :value, String, matches: :present
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      mark :failure, "faulted"
      transition "Accept"   => "accepted",  from: "requested"
      transition "Complete" => "completed", from: "accepted"
      transition "Fault"    => "faulted",   from: %w[requested accepted]
      mark :terminal, "completed", "faulted"
    end

    command "CheckEngineAgreement" do
      role "Maintainer"
      goal "Check that the query engines route every comparator through the one shared implementation"

      attribute :run, RunKey, sets: true

      sets :operation, to: "check_engine_agreement"

      emits CheckEngineAgreementRequested
    end

    command "MeasureDocCoverage" do
      role "Maintainer"
      goal "Check that every live word of the language has prose and a running example in the reference"

      attribute :run, RunKey, sets: true

      sets :operation, to: "measure_doc_coverage"

      emits MeasureDocCoverageRequested
    end

    command "CheckShapeLedger" do
      role "Maintainer"
      goal "Check that no bluebook's storage shape moved without a translation edge, and rewrite the ledger when confirmed"

      attribute :run,      RunKey, sets: true
      attribute :confirm,  Switch, optional: true, sets: true
      # With `confirm`: write the empty edge for a shape that moved with none, for a change that only adds.
      attribute :additive, Switch, optional: true, sets: true

      sets :operation, to: "check_shape_ledger"

      emits CheckShapeLedgerRequested
    end

    command "ArgumentGateMatrix" do
      role "Maintainer"
      goal "Generate the argument-gate ordering matrix; rewrite it and its fixtures only when confirmed"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "argument_gate_matrix"

      emits ArgumentGateMatrixRequested
    end

    # What the tree reported about itself, held against every request: nothing here runs
    # outside a hecks checkout (hecks.gemspec beside lib/).
    command "Accept" do
      role "System"
      goal "Let a request through only when the working tree is a hecks checkout"

      reference_to ConformanceRun
      attribute :checkout, Switch, sets: true

      given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }


      emits ConformanceAccepted
    end

    command "Complete" do
      role "System"
      goal "Record that the request was carried out, and what it reported"

      reference_to ConformanceRun
      attribute :report, Report, sets: true


      emits ConformanceCompleted
    end

    command "Fault" do
      role "System"
      goal "Record that the request was refused or could not be carried out, and why"

      reference_to ConformanceRun
      attribute :refusal, Report, sets: true


      emits ConformanceFaulted
    end

    query "ConformanceOutcome" do
      description "How one request ended: its status, and what it reported or why it failed."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "ConformanceFaulted" do
      description "Every request that was refused or could not be carried out."
      where(status: "faulted")
      order_by :run
    end
  end

  policy "ExamineWhenCheckEngineAgreementRequested" do
    on      "ConformanceRun.CheckEngineAgreementRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenMeasureDocCoverageRequested" do
    on      "ConformanceRun.MeasureDocCoverageRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenCheckShapeLedgerRequested" do
    on      "ConformanceRun.CheckShapeLedgerRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenArgumentGateMatrixRequested" do
    on      "ConformanceRun.ArgumentGateMatrixRequested"
    ask     :examine, with: { run: :run }
  end

  policy "AcceptConformanceWhenExamined" do
    on      "ConformanceRun.ConformanceExamined"
    trigger ConformanceRun::Accept, with: { checkout: :checkout }
  end

  policy "FaultConformanceWhenNotAccepted" do
    on      "ConformanceRun.ConformanceExamined"
    where   { !checkout.value }
    trigger ConformanceRun::Fault, with: { refusal: "needs a hecks checkout: hecks.gemspec stands beside lib/" }
  end

  policy "PerformConformanceWhenAccepted" do
    on      "ConformanceRun.ConformanceAccepted"
    ask     :perform, with: { run: :run }
  end

  policy "RecordConformanceOutcome" do
    on      "ConformanceRun.ConformanceAnswered"
    trigger ConformanceRun::Complete, with: { report: :report }
  end

  policy "RecordConformanceFault" do
    on      "ConformanceRun.ConformanceRefused"
    trigger ConformanceRun::Fault, with: { refusal: :refusal }
  end

  # Regeneration: rebuilding every corpus domain's committed output, which only this repository has.
  # A check projects into a scratch crate and never writes the tree; without --confirm the run is
  # that check, so the tracked generated files change only when the regeneration is confirmed.
  aggregate "RegenerationRun" do
    description "One regeneration of every corpus domain's committed Rust output, or the check that it is current."

    attribute :run,       RunKey
    attribute :operation, Operation, optional: true
    attribute :confirm,   Switch, optional: true
    attribute :check,     Switch, optional: true
    attribute :live,      Switch, optional: true
    attribute :gate,      GateName, optional: true
    attribute :domains,   DomainList, optional: true
    attribute :workers,   Count, optional: true
    attribute :checkout,  Switch, optional: true
    attribute :report,    Report, optional: true
    attribute :refusal,   Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, matches: :present

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Operation" do
      attribute :value, String, matches: :present
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    # A `CiGate` row of the Vocabulary bluebook, by name.
    value_object "GateName" do
      attribute :value, String, matches: :present
    end

    # The features of corpus domains, comma separated, such as `lease_clock,nested_pieces`.
    value_object "DomainList" do
      attribute :value, String, pattern: '^[a-z][a-z0-9_]*(,[a-z][a-z0-9_]*)*$'
    end

    # How many domains are generated at once, always at least one.
    value_object "Count" do
      attribute :value, Integer

      invariant("a count is positive") { value > 0 }
    end

    lifecycle :status, default: "requested" do
      mark :failure, "faulted"
      transition "Accept"   => "accepted",  from: "requested"
      transition "Complete" => "completed", from: "accepted"
      transition "Fault"    => "faulted",   from: %w[requested accepted]
      mark :terminal, "completed", "faulted"
    end

    command "RegenerateCorpus" do
      role "Maintainer"
      goal "Regenerate the Rust output of every corpus domain or the ones named, or with check only compare it"

      attribute :check,   Switch, optional: true, sets: true
      attribute :domains, DomainList, optional: true, sets: true
      attribute :workers, Count, optional: true, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "regenerate_corpus"

      emits RegenerateCorpusRequested
    end

    command "ProjectCiGates" do
      role "Maintainer"
      goal "Project the CiGate rows into the workflows' marked detector jobs, or with check only compare them"

      attribute :check,   Switch, optional: true, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_ci_gates"

      emits ProjectCiGatesRequested
    end

    command "ProjectCiPipeline" do
      role "Maintainer"
      goal "Project the CiWorkflows rows into their workflow files, or with check only compare them"

      attribute :check,   Switch, optional: true
      attribute :run,     RunKey
      attribute :confirm, Switch, optional: true

      sets :check
      sets :run
      sets :confirm
      sets :operation, to: "project_ci_pipeline"

      emits ProjectCiPipelineRequested
    end

    command "ProjectLanes" do
      role "Maintainer"
      goal "Project the Lane rows into the rulesets and the promotion workflow, or with live compare GitHub's rulesets"

      attribute :check,   Switch, optional: true, sets: true
      attribute :live,    Switch, optional: true, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_lanes"

      emits ProjectLanesRequested
    end

    command "ProjectToolsDoc" do
      role "Maintainer"
      goal "Write the launcher forms of docs/tools.md from the RetiredScript rows, or with check only compare them"

      attribute :check,   Switch, optional: true, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "project_tools_doc"

      emits ProjectToolsDocRequested
    end

    command "DecideCiGate" do
      role "Maintainer"
      goal "Say whether this run's change touches what a CiGate row guards, as the gated job's detector"

      attribute :gate, GateName, sets: true
      attribute :run,  RunKey, sets: true

      sets :operation, to: "decide_ci_gate"

      emits DecideCiGateRequested
    end

    # What the tree reported about itself, held against every request: nothing here runs
    # outside a hecks checkout (hecks.gemspec beside lib/).
    command "Accept" do
      role "System"
      goal "Let a request through only when the working tree is a hecks checkout"

      reference_to RegenerationRun
      attribute :checkout, Switch, sets: true

      given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }


      emits RegenerationAccepted
    end

    command "Complete" do
      role "System"
      goal "Record that the request was carried out, and what it reported"

      reference_to RegenerationRun
      attribute :report, Report, sets: true


      emits RegenerationCompleted
    end

    command "Fault" do
      role "System"
      goal "Record that the request was refused or could not be carried out, and why"

      reference_to RegenerationRun
      attribute :refusal, Report, sets: true


      emits RegenerationFaulted
    end

    query "RegenerationOutcome" do
      description "How one request ended: its status, and what it reported or why it failed."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "RegenerationFaulted" do
      description "Every request that was refused or could not be carried out."
      where(status: "faulted")
      order_by :run
    end
  end

  policy "ExamineWhenRegenerateCorpusRequested" do
    on      "RegenerationRun.RegenerateCorpusRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProjectCiGatesRequested" do
    on      "RegenerationRun.ProjectCiGatesRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProjectCiPipelineRequested" do
    on      "RegenerationRun.ProjectCiPipelineRequested"
    trigger RegenerationRun::SourceTree::Examine, with: { run: :run }
  end

  policy "ExamineWhenProjectLanesRequested" do
    on      "RegenerationRun.ProjectLanesRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenProjectToolsDocRequested" do
    on      "RegenerationRun.ProjectToolsDocRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenDecideCiGateRequested" do
    on      "RegenerationRun.DecideCiGateRequested"
    ask     :examine, with: { run: :run }
  end

  policy "AcceptRegenerationWhenExamined" do
    on      "RegenerationRun.RegenerationExamined"
    trigger RegenerationRun::Accept, with: { checkout: :checkout }
  end

  policy "FaultRegenerationWhenNotAccepted" do
    on      "RegenerationRun.RegenerationExamined"
    where   { !checkout.value }
    trigger RegenerationRun::Fault, with: { refusal: "needs a hecks checkout: hecks.gemspec stands beside lib/" }
  end

  policy "PerformRegenerationWhenAccepted" do
    on      "RegenerationRun.RegenerationAccepted"
    ask     :perform, with: { run: :run }
  end

  policy "RecordRegenerationOutcome" do
    on      "RegenerationRun.RegenerationAnswered"
    trigger RegenerationRun::Complete, with: { report: :report }
  end

  policy "RecordRegenerationFault" do
    on      "RegenerationRun.RegenerationRefused"
    trigger RegenerationRun::Fault, with: { refusal: :refusal }
  end

  # Gate: the checks a stage holds a change against before it is let through. The checks are data
  # (the Vocabulary gate rows), run together, and a red one faults the run, so `--wait` fails the
  # push or the build that asked, and the journal keeps when the gate went red.
  aggregate "GateRun" do
    description "One run of a stage's checks: every check of the stage, or the ones named."

    attribute :run,       RunKey
    attribute :operation, Operation, optional: true
    attribute :stage,     Stage
    attribute :only,      CheckList, optional: true
    attribute :checkout,  Switch, optional: true
    attribute :report,    Report, optional: true
    attribute :refusal,   Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, matches: :present

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Operation" do
      attribute :value, String, matches: :present
    end

    value_object "Stage" do
      attribute :value, String, matches: :snake_name

      invariant("a stage is named") { !value.to_s.empty? }
    end

    value_object "CheckList" do
      attribute :value, String, pattern: '^[a-z][a-z0-9_]*(,[a-z][a-z0-9_]*)*$'
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      mark :failure, "faulted"
      transition "Accept"   => "accepted",  from: "requested"
      transition "Complete" => "completed", from: "accepted"
      transition "Fault"    => "faulted",   from: %w[requested accepted]
      mark :terminal, "completed", "faulted"
    end

    command "Gate" do
      role "Maintainer"
      goal "Run every check of a stage, or the ones named, and keep whether the gate is green"

      attribute :stage, Stage, sets: true
      attribute :only,  CheckList, optional: true, sets: true
      attribute :run,   RunKey, sets: true

      sets :operation, to: "gate"

      emits GateRequested
    end

    command "Accept" do
      role "System"
      goal "Let a request through only when the working tree is a hecks checkout"

      reference_to GateRun
      attribute :checkout, Switch, sets: true

      given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }


      emits GateAccepted
    end

    command "Complete" do
      role "System"
      goal "Record that every check passed, and which"

      reference_to GateRun
      attribute :report, Report, sets: true


      emits GateCompleted
    end

    command "Fault" do
      role "System"
      goal "Record that a check was red or the run could not be made, and why"

      reference_to GateRun
      attribute :refusal, Report, sets: true


      emits GateFaulted
    end

    query "GateOutcome" do
      description "How one run ended: its status, and what it reported or why it failed."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "GateFaulted" do
      description "Every run that went red or could not be made."
      where(status: "faulted")
      order_by :run
    end
  end

  policy "ExamineWhenGateRequested" do
    on      "GateRun.GateRequested"
    ask     :examine, with: { run: :run }
  end

  policy "AcceptGateWhenExamined" do
    on      "GateRun.GateExamined"
    trigger GateRun::Accept, with: { checkout: :checkout }
  end

  policy "FaultGateWhenNotAccepted" do
    on      "GateRun.GateExamined"
    where   { !checkout.value }
    trigger GateRun::Fault, with: { refusal: "needs a hecks checkout: hecks.gemspec stands beside lib/" }
  end

  policy "PerformGateWhenAccepted" do
    on      "GateRun.GateAccepted"
    ask     :perform, with: { run: :run }
  end

  policy "RecordGateOutcome" do
    on      "GateRun.GateAnswered"
    trigger GateRun::Complete, with: { report: :report }
  end

  policy "RecordGateFault" do
    on      "GateRun.GateRefused"
    trigger GateRun::Fault, with: { refusal: :refusal }
  end

  # Style: the comment style guides (Ruby and Rust) and the canonical form of a JSON document. A
  # check finds every violation; a fix rewrites files, so it lists what it would rewrite unless
  # it is confirmed. The baseline of tolerated long blocks is written only when confirmed.
  aggregate "StyleRun" do
    description "One check or fix of comment style, or one document written with its keys in order."

    attribute :run,       RunKey
    attribute :operation, Operation, optional: true
    attribute :confirm,   Switch, optional: true
    attribute :paths,     PathList, optional: true
    attribute :only,      CategoryList, optional: true
    attribute :json,      Switch, optional: true
    attribute :top,       Top, optional: true
    attribute :ref,       Ref, optional: true
    attribute :file,      FilePath, optional: true
    attribute :checkout,  Switch, optional: true
    attribute :report,    Report, optional: true
    attribute :refusal,   Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, matches: :present

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Operation" do
      attribute :value, String, matches: :present
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    # Files or directories, comma separated.
    value_object "PathList" do
      attribute :value, String, matches: :csv_list
    end

    # Violation categories, comma separated.
    value_object "CategoryList" do
      attribute :value, String, pattern: '^[a-z_]+(,[a-z_]+)*$'
    end

    # How many rows a report lists.
    value_object "Top" do
      attribute :value, Integer

      invariant("a count is positive") { value > 0 }
    end

    # A revision a code comparison is made against.
    value_object "Ref" do
      attribute :value, String, matches: :no_whitespace
    end

    # A JSON file.
    value_object "FilePath" do
      attribute :value, String, matches: :not_empty

      invariant("a file is named") { !value.to_s.empty? }
    end

    lifecycle :status, default: "requested" do
      mark :failure, "faulted"
      transition "Accept"   => "accepted",  from: "requested"
      transition "Complete" => "completed", from: "accepted"
      transition "Fault"    => "faulted",   from: %w[requested accepted]
      mark :terminal, "completed", "faulted"
    end

    command "CheckComments" do
      role "Maintainer"
      goal "List every comment that breaks the Ruby style guide"

      attribute :paths, PathList, sets: true
      attribute :only,  CategoryList, optional: true, sets: true
      attribute :run,   RunKey, sets: true

      sets :operation, to: "check_comments"

      emits CheckCommentsRequested
    end

    command "FixComments" do
      role "Maintainer"
      goal "Rewrite the mechanical Ruby comment violations"

      attribute :paths,   PathList, sets: true
      attribute :only,    CategoryList, optional: true, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "fix_comments"

      emits FixCommentsRequested
    end

    command "WriteCommentBaseline" do
      role "Maintainer"
      goal "Record every long comment block as tolerated, for lib/hecks unless paths are named"

      attribute :paths,   PathList, optional: true, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "write_comment_baseline"

      emits WriteCommentBaselineRequested
    end

    command "CheckCommentsUnchanged" do
      role "Maintainer"
      goal "Prove an edit was comment-only: no file's code differs from the ref"

      attribute :ref,   Ref, sets: true
      attribute :paths, PathList, optional: true, sets: true
      attribute :run,   RunKey, sets: true

      sets :operation, to: "check_comments_unchanged"

      emits CheckCommentsUnchangedRequested
    end

    command "CheckRustComments" do
      role "Maintainer"
      goal "List every comment that breaks the Rust style guide"

      attribute :paths, PathList, sets: true
      attribute :only,  CategoryList, optional: true, sets: true
      attribute :run,   RunKey, sets: true

      sets :operation, to: "check_rust_comments"

      emits CheckRustCommentsRequested
    end

    command "FixRustComments" do
      role "Maintainer"
      goal "Rewrite the mechanical Rust comment violations"

      attribute :paths,   PathList, sets: true
      attribute :only,    CategoryList, optional: true, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "fix_rust_comments"

      emits FixRustCommentsRequested
    end

    command "Canonicalise" do
      role "Maintainer"
      goal "Write a JSON document with every object's keys sorted"

      attribute :file, FilePath, sets: true
      attribute :run,  RunKey, sets: true

      sets :operation, to: "canonicalise"

      emits CanonicaliseRequested
    end

    # What the tree reported about itself, held against every request: nothing here runs
    # outside a hecks checkout (hecks.gemspec beside lib/).
    command "Accept" do
      role "System"
      goal "Let a request through only when the working tree is a hecks checkout"

      reference_to StyleRun
      attribute :checkout, Switch, sets: true

      given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }


      emits StyleAccepted
    end

    command "Complete" do
      role "System"
      goal "Record that the request was carried out, and what it reported"

      reference_to StyleRun
      attribute :report, Report, sets: true


      emits StyleCompleted
    end

    command "Fault" do
      role "System"
      goal "Record that the request was refused or could not be carried out, and why"

      reference_to StyleRun
      attribute :refusal, Report, sets: true


      emits StyleFaulted
    end

    query "StyleOutcome" do
      description "How one request ended: its status, and what it reported or why it failed."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "StyleFaulted" do
      description "Every request that was refused or could not be carried out."
      where(status: "faulted")
      order_by :run
    end

    # An answer that is one document of text, exactly as the tool that produced it wrote it.
    value_object "Document" do
      attribute :text, String
    end

    query "ReportComments" do
      description "The Ruby comment violations, as summary tables, a list or JSON."
      attribute :paths, PathList
      attribute :only, CategoryList, optional: true
      attribute :json, Switch, optional: true
      attribute :top, Top, optional: true
      returns Document
    end

    query "ReportRustComments" do
      description "The Rust comment violations, as summary tables, a list or JSON."
      attribute :paths, PathList
      attribute :only, CategoryList, optional: true
      attribute :json, Switch, optional: true
      attribute :top, Top, optional: true
      returns Document
    end
  end

  policy "ExamineWhenCheckCommentsRequested" do
    on      "StyleRun.CheckCommentsRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenFixCommentsRequested" do
    on      "StyleRun.FixCommentsRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenWriteCommentBaselineRequested" do
    on      "StyleRun.WriteCommentBaselineRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenCheckCommentsUnchangedRequested" do
    on      "StyleRun.CheckCommentsUnchangedRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenCheckRustCommentsRequested" do
    on      "StyleRun.CheckRustCommentsRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenFixRustCommentsRequested" do
    on      "StyleRun.FixRustCommentsRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenCanonicaliseRequested" do
    on      "StyleRun.CanonicaliseRequested"
    ask     :examine, with: { run: :run }
  end

  policy "AcceptStyleWhenExamined" do
    on      "StyleRun.StyleExamined"
    trigger StyleRun::Accept, with: { checkout: :checkout }
  end

  policy "FaultStyleWhenNotAccepted" do
    on      "StyleRun.StyleExamined"
    where   { !checkout.value }
    trigger StyleRun::Fault, with: { refusal: "needs a hecks checkout: hecks.gemspec stands beside lib/" }
  end

  policy "PerformStyleWhenAccepted" do
    on      "StyleRun.StyleAccepted"
    ask     :perform, with: { run: :run }
  end

  policy "RecordStyleOutcome" do
    on      "StyleRun.StyleAnswered"
    trigger StyleRun::Complete, with: { report: :report }
  end

  policy "RecordStyleFault" do
    on      "StyleRun.StyleRefused"
    trigger StyleRun::Fault, with: { refusal: :refusal }
  end

  # Inspection: ranking the Ruby by complexity, finding copied code, listing design smells and
  # writing the combined report. A read of the tree: nothing is rewritten. The files the style
  # config excludes (generated output, vendored code) are left out of every tool.
  aggregate "InspectionRun" do
    description "One inspection of the Ruby by flog, flay, reek or rubycritic."

    attribute :run,       RunKey
    attribute :operation, Operation, optional: true
    attribute :paths,     PathList, optional: true
    attribute :top,       Top, optional: true
    attribute :checkout,  Switch, optional: true
    attribute :report,    Report, optional: true
    attribute :refusal,   Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, matches: :present

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Operation" do
      attribute :value, String, matches: :present
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    # Files or directories, comma separated; lib when none is named.
    value_object "PathList" do
      attribute :value, String, matches: :csv_list
    end

    # How many lines of the report are kept.
    value_object "Top" do
      attribute :value, Integer

      invariant("a count is positive") { value > 0 }
    end

    lifecycle :status, default: "requested" do
      mark :failure, "faulted"
      transition "Accept"   => "accepted",  from: "requested"
      transition "Complete" => "completed", from: "accepted"
      transition "Fault"    => "faulted",   from: %w[requested accepted]
      mark :terminal, "completed", "faulted"
    end

    command "Flog" do
      role "Maintainer"
      goal "Rank the Ruby methods by complexity, worst first"

      attribute :paths, PathList, optional: true, sets: true
      attribute :top,   Top, optional: true, sets: true
      attribute :run,   RunKey, sets: true

      sets :operation, to: "flog"

      emits FlogRequested
    end

    command "Flay" do
      role "Maintainer"
      goal "Find Ruby code that is copied or nearly copied"

      attribute :paths, PathList, optional: true, sets: true
      attribute :top,   Top, optional: true, sets: true
      attribute :run,   RunKey, sets: true

      sets :operation, to: "flay"

      emits FlayRequested
    end

    command "Reek" do
      role "Maintainer"
      goal "List the design smells in the Ruby"

      attribute :paths, PathList, optional: true, sets: true
      attribute :top,   Top, optional: true, sets: true
      attribute :run,   RunKey, sets: true

      sets :operation, to: "reek"

      emits ReekRequested
    end

    command "Rubycritic" do
      role "Maintainer"
      goal "Write the combined quality report, with git churn"

      attribute :paths, PathList, optional: true, sets: true
      attribute :top,   Top, optional: true, sets: true
      attribute :run,   RunKey, sets: true

      sets :operation, to: "rubycritic"

      emits RubycriticRequested
    end

    # What the tree reported about itself, held against every request: nothing here runs
    # outside a hecks checkout (hecks.gemspec beside lib/).
    command "Accept" do
      role "System"
      goal "Let a request through only when the working tree is a hecks checkout"

      reference_to InspectionRun
      attribute :checkout, Switch, sets: true

      given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }


      emits InspectionAccepted
    end

    command "Complete" do
      role "System"
      goal "Record that the inspection was carried out, and what it reported"

      reference_to InspectionRun
      attribute :report, Report, sets: true


      emits InspectionCompleted
    end

    command "Fault" do
      role "System"
      goal "Record that the inspection was refused or could not be carried out, and why"

      reference_to InspectionRun
      attribute :refusal, Report, sets: true


      emits InspectionFaulted
    end

    query "InspectionOutcome" do
      description "How one inspection ended: its status, and what it reported or why it failed."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "InspectionsFaulted" do
      description "Every inspection that was refused or could not be carried out."
      where(status: "faulted")
      order_by :run
    end

    # A regular expression, matched against one line of text at a time.
    value_object "Pattern" do
      attribute :value, String, matches: :present
    end

    # An answer that is one document of text, one `path:line: text` row to a match.
    value_object "Document" do
      attribute :text, String
    end

    query "Search" do
      description "The lines of the checkout's text files that match a pattern, as path:line: text."
      attribute :pattern, Pattern
      attribute :paths, PathList, optional: true
      attribute :top, Top, optional: true
      returns Document
    end

    # A file of the checkout, named from its root.
    value_object "SourcePath" do
      attribute :value, String, matches: :present
    end

    # A line of a file, counted from 1.
    value_object "LineNumber" do
      attribute :value, Integer

      invariant("a line is counted from 1") { value > 0 }
    end

    # The name a construct is declared under, as it stands between the quotes.
    value_object "DeclaredName" do
      attribute :value, String, matches: :present
    end

    # What a declaration is: aggregate, command, query, policy and the rest.
    value_object "DeclaredKind" do
      attribute :value, String, pattern: '^[a-z_]+$'
    end

    query "ReadSource" do
      description "The numbered lines of one file of the checkout, whole or from one line to another."
      attribute :path, SourcePath
      attribute :from, LineNumber, optional: true
      attribute :to,   LineNumber, optional: true
      attribute :top,  Top, optional: true
      returns Document
    end

    query "Outline" do
      description "What a file declares, by line: each construct of a bluebook, each definition of Ruby."
      attribute :path, SourcePath
      returns Document
    end

    query "Declaration" do
      description "Where a named construct is declared across the corpus, as path:from-to, with its text on request."
      attribute :name,  DeclaredName
      attribute :kind,  DeclaredKind, optional: true
      attribute :paths, PathList, optional: true
      attribute :show,  Switch, optional: true
      returns Document
    end
  end

  policy "ExamineWhenFlogRequested" do
    on      "InspectionRun.FlogRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenFlayRequested" do
    on      "InspectionRun.FlayRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenReekRequested" do
    on      "InspectionRun.ReekRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenRubycriticRequested" do
    on      "InspectionRun.RubycriticRequested"
    ask     :examine, with: { run: :run }
  end

  policy "AcceptInspectionWhenExamined" do
    on      "InspectionRun.InspectionExamined"
    trigger InspectionRun::Accept, with: { checkout: :checkout }
  end

  policy "FaultInspectionWhenNotAccepted" do
    on      "InspectionRun.InspectionExamined"
    where   { !checkout.value }
    trigger InspectionRun::Fault, with: { refusal: "needs a hecks checkout: hecks.gemspec stands beside lib/" }
  end

  policy "PerformInspectionWhenAccepted" do
    on      "InspectionRun.InspectionAccepted"
    ask     :perform, with: { run: :run }
  end

  policy "RecordInspectionOutcome" do
    on      "InspectionRun.InspectionAnswered"
    trigger InspectionRun::Complete, with: { report: :report }
  end

  policy "RecordInspectionFault" do
    on      "InspectionRun.InspectionRefused"
    trigger InspectionRun::Fault, with: { refusal: :refusal }
  end

  # Codemod: the mechanical rewrites of the example bluebooks. Each one edits tracked files, so
  # unconfirmed it rehearses the edit (the script reboots every bluebook and puts the files back)
  # and reports what it would change; the files stay changed only when it is confirmed.
  aggregate "CodemodRun" do
    description "One rewrite of the example bluebooks by a codemod, or the rehearsal of it."

    attribute :run,       RunKey
    attribute :operation, Operation, optional: true
    attribute :confirm,   Switch, optional: true
    attribute :checkout,  Switch, optional: true
    attribute :report,    Report, optional: true
    attribute :refusal,   Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, matches: :present

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Operation" do
      attribute :value, String, matches: :present
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      mark :failure, "faulted"
      transition "Accept"   => "accepted",  from: "requested"
      transition "Complete" => "completed", from: "accepted"
      transition "Fault"    => "faulted",   from: %w[requested accepted]
      mark :terminal, "completed", "faulted"
    end

    command "HoistLocalGivens" do
      role "Maintainer"
      goal "Hoist a given that several commands of one owner repeat into one owner-level given"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "hoist_local_givens"

      emits HoistLocalGivensRequested
    end

    command "DropImplicitAppendFields" do
      role "Maintainer"
      goal "Drop an attribute line that only repeats what an append target element declares"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "drop_implicit_append_fields"

      emits DropImplicitAppendFieldsRequested
    end

    # What the tree reported about itself, held against every request: nothing here runs
    # outside a hecks checkout (hecks.gemspec beside lib/).
    command "Accept" do
      role "System"
      goal "Let a request through only when the working tree is a hecks checkout"

      reference_to CodemodRun
      attribute :checkout, Switch, sets: true

      given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }


      emits CodemodAccepted
    end

    command "Complete" do
      role "System"
      goal "Record that the request was carried out, and what it reported"

      reference_to CodemodRun
      attribute :report, Report, sets: true


      emits CodemodCompleted
    end

    command "Fault" do
      role "System"
      goal "Record that the request was refused or could not be carried out, and why"

      reference_to CodemodRun
      attribute :refusal, Report, sets: true


      emits CodemodFaulted
    end

    query "CodemodOutcome" do
      description "How one request ended: its status, and what it reported or why it failed."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "CodemodFaulted" do
      description "Every request that was refused or could not be carried out."
      where(status: "faulted")
      order_by :run
    end
  end

  policy "ExamineWhenHoistLocalGivensRequested" do
    on      "CodemodRun.HoistLocalGivensRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenDropImplicitAppendFieldsRequested" do
    on      "CodemodRun.DropImplicitAppendFieldsRequested"
    ask     :examine, with: { run: :run }
  end

  policy "AcceptCodemodWhenExamined" do
    on      "CodemodRun.CodemodExamined"
    trigger CodemodRun::Accept, with: { checkout: :checkout }
  end

  policy "FaultCodemodWhenNotAccepted" do
    on      "CodemodRun.CodemodExamined"
    where   { !checkout.value }
    trigger CodemodRun::Fault, with: { refusal: "needs a hecks checkout: hecks.gemspec stands beside lib/" }
  end

  policy "PerformCodemodWhenAccepted" do
    on      "CodemodRun.CodemodAccepted"
    ask     :perform, with: { run: :run }
  end

  policy "RecordCodemodOutcome" do
    on      "CodemodRun.CodemodAnswered"
    trigger CodemodRun::Complete, with: { report: :report }
  end

  policy "RecordCodemodFault" do
    on      "CodemodRun.CodemodRefused"
    trigger CodemodRun::Fault, with: { refusal: :refusal }
  end

  # TestSuite: the tooling around this repository's specs. Listings of which files a shard or a
  # job runs are pure reads; refreshing the committed timings, rewriting the persistence fixtures
  # and writing the committed spec list change tracked files and need --confirm; a stress run
  # and a single example only run specs and write nothing tracked.
  aggregate "TestSuiteRun" do
    description "One piece of work on the test suite: a listing, a baseline, a run or a fixture rewrite."

    attribute :run,         RunKey
    attribute :operation,   Operation, optional: true
    attribute :confirm,     Switch, optional: true
    attribute :workers,     Count, optional: true
    attribute :from_run,    RunId, optional: true
    attribute :file,        FilePath, optional: true
    attribute :example,     ExampleText, optional: true
    attribute :runs,        Count, optional: true
    attribute :parallel,    Count, optional: true
    attribute :seed_start,  Count, optional: true
    attribute :fixture,     FixtureName, optional: true
    attribute :exclude,     ExcludePattern, optional: true
    attribute :tags,        TagArguments, optional: true
    attribute :strict,      Switch, optional: true
    attribute :seeds,       Count, optional: true
    attribute :environment, EnvironmentName, optional: true
    attribute :declaration_cache, Switch, optional: true
    attribute :crate,       CrateName, optional: true
    attribute :write,       FilePath, optional: true
    attribute :group,       Count, optional: true
    attribute :groups,      Count, optional: true
    attribute :runtime_log, FilePath, optional: true
    attribute :check,       FilePath, optional: true
    attribute :checkout,    Switch, optional: true
    attribute :report,      Report, optional: true
    attribute :refusal,     Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, matches: :present

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Operation" do
      attribute :value, String, matches: :present
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    # How many, always at least one.
    value_object "Count" do
      attribute :value, Integer

      invariant("a count is positive") { value > 0 }
    end

    # A CI run's number.
    value_object "RunId" do
      attribute :value, String, matches: :digits
    end

    # A file, relative to the checkout or absolute.
    value_object "FilePath" do
      attribute :value, String, matches: :not_empty

      invariant("a file is named") { !value.to_s.empty? }
    end

    # Part of an example's description.
    value_object "ExampleText" do
      attribute :value, String, matches: :not_empty

      invariant("an example is named") { !value.to_s.empty? }
    end

    # The name of a semantics-corpus fixture.
    value_object "FixtureName" do
      attribute :value, String, pattern: '^[a-z0-9_]+$'
    end

    # A regular expression naming the specs to leave out.
    value_object "ExcludePattern" do
      attribute :value, String, matches: :not_empty
    end

    # The tag filter, as the test runner spells it.
    value_object "TagArguments" do
      attribute :value, String, pattern: '^[^\t\n\r]+$'
    end

    # An environment overlay's name, as `environments/<name>.world` spells it.
    value_object "EnvironmentName" do
      attribute :value, String, pattern: '^[a-z][a-z0-9_]*$'
    end

    # A Rust test target whose fuzzers take their seed counts as arguments: the host, the parser,
    # or the JSON parse fuzzer of the root crate.
    value_object "CrateName" do
      attribute :value, String, pattern: '^(host|parser|json)$'
    end

    lifecycle :status, default: "requested" do
      mark :failure, "faulted"
      transition "Accept"   => "accepted",  from: "requested"
      transition "Complete" => "completed", from: "accepted"
      transition "Fault"    => "faulted",   from: %w[requested accepted]
      mark :terminal, "completed", "faulted"
    end

    command "RefreshRuntimeBaseline" do
      role "Maintainer"
      goal "Regenerate the committed runtime baselines the sharded jobs group from"

      attribute :workers,  Count, default: 6, sets: true
      attribute :from_run, RunId, optional: true, sets: true
      attribute :run,      RunKey, sets: true
      attribute :confirm,  Switch, optional: true, sets: true

      sets :operation, to: "refresh_runtime_baseline"

      emits RefreshRuntimeBaselineRequested
    end

    command "RunSpecExample" do
      role "Maintainer"
      goal "Run one spec file filtered to one example, through the test runner in this process"

      attribute :file,        FilePath, sets: true
      attribute :example,     ExampleText, sets: true
      attribute :run,         RunKey, sets: true
      # Run the specs as CI does: the slow io, process and fuzzing groups included, and a Postgres
      # that is not reachable a failure, not a skip.
      attribute :strict,      Switch, optional: true, sets: true
      # How many seeds the property specs try, where they default to a few.
      attribute :seeds,       Count, optional: true, sets: true
      # The environment overlay the example boots its domains on, such as `memory`.
      attribute :environment, EnvironmentName, optional: true, sets: true
      # RSpec tag filters, such as `cloudfront` for the examples that call a real AWS account.
      attribute :tags, TagArguments, optional: true, sets: true
      # Whether specs share the loaded declarations of an unchanged domain directory; false loads each
      # boot afresh.
      attribute :declaration_cache, Switch, default: true, sets: true

      sets :operation, to: "run_spec_example"

      emits RunSpecExampleRequested
    end

    command "StressConcurrency" do
      role "Maintainer"
      goal "Rerun the thread-safety specs under many seeds, several processes at a time"

      attribute :runs,       Count, default: 30, sets: true
      # The machine's own core count when none is named, which no fixed default can say.
      attribute :parallel,   Count, optional: true, sets: true
      attribute :seed_start, Count, default: 1, sets: true
      attribute :run,        RunKey, sets: true

      sets :operation, to: "stress_concurrency"

      emits StressConcurrencyRequested
    end

    command "RunCargoTests" do
      role "Maintainer"
      goal "Run the cargo tests of the host, the parser or the JSON fuzzer, with the seed counts their fuzzers take"

      attribute :crate,       CrateName, sets: true
      attribute :seeds,       Count, optional: true, sets: true
      attribute :seed_start,  Count, optional: true, sets: true
      attribute :run,         RunKey, sets: true

      sets :operation, to: "run_cargo_tests"

      emits RunCargoTestsRequested
    end

    # The caches key on a digest of what they were built from, so a stale entry is never read; this
    # is for ruling a cache out as the cause of a surprise, which turning it off used to do.
    command "ClearCaches" do
      role "Maintainer"
      goal "Delete the on-disk syntax-boot and verdict caches, so the next boot builds and judges afresh"

      attribute :run, RunKey, sets: true

      sets :operation, to: "clear_caches"

      emits ClearCachesRequested
    end

    command "RegenerateLegacyFixtures" do
      role "Maintainer"
      goal "Regenerate the persistence legacy fixtures through the real adapters"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "regenerate_legacy_fixtures"

      emits RegenerateLegacyFixturesRequested
    end

    command "SeedSemanticsCorpus" do
      role "Maintainer"
      goal "Fill the expected outcome of every semantics fixture that lacks one, or re-seed one"

      attribute :fixture, FixtureName, optional: true, sets: true
      attribute :run,     RunKey, sets: true

      sets :operation, to: "seed_semantics_corpus"

      emits SeedSemanticsCorpusRequested
    end

    command "WriteIoParallelSpecList" do
      role "Maintainer"
      goal "Write the committed list of the spec files a tag filter selects"

      attribute :exclude, ExcludePattern, sets: true
      attribute :tags,    TagArguments, optional: true, sets: true
      attribute :write,   FilePath, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "write_io_parallel_spec_list"

      emits WriteIoParallelSpecListRequested
    end

    # What the tree reported about itself, held against every request: nothing here runs
    # outside a hecks checkout (hecks.gemspec beside lib/).
    command "Accept" do
      role "System"
      goal "Let a request through only when the working tree is a hecks checkout"

      reference_to TestSuiteRun
      attribute :checkout, Switch, sets: true

      given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }


      emits TestSuiteAccepted
    end

    command "Complete" do
      role "System"
      goal "Record that the request was carried out, and what it reported"

      reference_to TestSuiteRun
      attribute :report, Report, sets: true


      emits TestSuiteCompleted
    end

    command "Fault" do
      role "System"
      goal "Record that the request was refused or could not be carried out, and why"

      reference_to TestSuiteRun
      attribute :refusal, Report, sets: true


      emits TestSuiteFaulted
    end

    query "TestSuiteOutcome" do
      description "How one request ended: its status, and what it reported or why it failed."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "TestSuiteFaulted" do
      description "Every request that was refused or could not be carried out."
      where(status: "faulted")
      order_by :run
    end

    # An answer that is one document of text, exactly as the tool that produced it wrote it.
    value_object "Document" do
      attribute :text, String
    end

    query "ShardSpecs" do
      description "The spec files one group of a runtime-balanced split runs."
      attribute :group, Count
      attribute :groups, Count
      attribute :runtime_log, FilePath, optional: true
      returns Document
    end

    query "ListIoParallelSpecs" do
      description "The spec files with an example a tag filter selects."
      attribute :exclude, ExcludePattern
      attribute :tags, TagArguments, optional: true
      attribute :check, FilePath, optional: true
      returns Document
    end

    query "RecordPatternCases" do
      description "The expected match results of the pattern cases, as JSON."
      returns Document
    end
  end

  policy "ExamineWhenRefreshRuntimeBaselineRequested" do
    on      "TestSuiteRun.RefreshRuntimeBaselineRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenRunSpecExampleRequested" do
    on      "TestSuiteRun.RunSpecExampleRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenStressConcurrencyRequested" do
    on      "TestSuiteRun.StressConcurrencyRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenRunCargoTestsRequested" do
    on      "TestSuiteRun.RunCargoTestsRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenClearCachesRequested" do
    on      "TestSuiteRun.ClearCachesRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenRegenerateLegacyFixturesRequested" do
    on      "TestSuiteRun.RegenerateLegacyFixturesRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenSeedSemanticsCorpusRequested" do
    on      "TestSuiteRun.SeedSemanticsCorpusRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenWriteIoParallelSpecListRequested" do
    on      "TestSuiteRun.WriteIoParallelSpecListRequested"
    ask     :examine, with: { run: :run }
  end

  policy "AcceptTestSuiteWhenExamined" do
    on      "TestSuiteRun.TestSuiteExamined"
    trigger TestSuiteRun::Accept, with: { checkout: :checkout }
  end

  policy "FaultTestSuiteWhenNotAccepted" do
    on      "TestSuiteRun.TestSuiteExamined"
    where   { !checkout.value }
    trigger TestSuiteRun::Fault, with: { refusal: "needs a hecks checkout: hecks.gemspec stands beside lib/" }
  end

  policy "PerformTestSuiteWhenAccepted" do
    on      "TestSuiteRun.TestSuiteAccepted"
    ask     :perform, with: { run: :run }
  end

  policy "RecordTestSuiteOutcome" do
    on      "TestSuiteRun.TestSuiteAnswered"
    trigger TestSuiteRun::Complete, with: { report: :report }
  end

  policy "RecordTestSuiteFault" do
    on      "TestSuiteRun.TestSuiteRefused"
    trigger TestSuiteRun::Fault, with: { refusal: :refusal }
  end

  # Corpus: what this repository's committed domains are, and what the language's own IR holds.
  # Every question about them is a pure read, answered by the SourceTree port: which domains carry
  # a Rust feature, the order they regenerate in, whether each generated module is covered, and the
  # structural queries over the IR. Two commands open a long-running server: the query MCP server
  # on stdio and the forms app on a local port; each is recorded, runs until it is closed, and
  # answers when it ends.
  aggregate "CorpusRun" do
    description "One look at the corpus and the language's IR, or one server opened on them."

    attribute :run,       RunKey
    attribute :operation, Operation, optional: true
    attribute :confirm,   Switch, optional: true
    attribute :names,     NameList, optional: true
    attribute :domains,   PathList, optional: true
    attribute :meta,      Switch, optional: true
    attribute :files,     Switch, optional: true
    attribute :name,      ConstructName, optional: true
    attribute :field,     FieldName, optional: true
    attribute :port,      Port, optional: true
    attribute :agent,     AgentName, optional: true
    attribute :directory, Directory, optional: true
    attribute :checkout,  Switch, optional: true
    attribute :report,    Report, optional: true
    attribute :refusal,   Report, optional: true
    identified_by :run

    # One directory of files, named by a path.
    value_object "Directory" do
      attribute :value, String, matches: :present
    end

    value_object "RunKey" do
      attribute :value, String, matches: :present

      invariant("a run is named") { !value.to_s.empty? }
    end

    # Which agent drives the Composer's assistant: the real `claude`, or a scripted `fake` for
    # trying the editor without a model.
    value_object "AgentName" do
      attribute :value, String, pattern: '^(claude|fake)$'
    end

    value_object "Operation" do
      attribute :value, String, matches: :present
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    # Construct names, comma separated.
    value_object "NameList" do
      attribute :value, String, pattern: '^[A-Za-z][A-Za-z0-9_]*(,[A-Za-z][A-Za-z0-9_]*)*$'
    end

    # Domain directories, comma separated.
    value_object "PathList" do
      attribute :value, String, matches: :csv_list
    end

    # The name of one IR construct.
    value_object "ConstructName" do
      attribute :value, String, matches: :identifier
    end

    # The name of one field of a construct.
    value_object "FieldName" do
      attribute :value, String, matches: :snake_name
    end

    # A local port a server listens on.
    value_object "Port" do
      attribute :value, Integer

      invariant("a port is 1 to 65535") { value >= 1 && value <= 65535 }
    end

    lifecycle :status, default: "requested" do
      mark :failure, "faulted"
      transition "Accept"   => "accepted",  from: "requested"
      transition "Complete" => "completed", from: "accepted"
      transition "Fault"    => "faulted",   from: %w[requested accepted]
      mark :terminal, "completed", "faulted"
    end

    command "ServeQueryIrMcp" do
      role "Maintainer"
      goal "Serve the IR queries to an MCP client over stdio until it closes"

      attribute :run, RunKey, sets: true

      sets :operation, to: "serve_query_ir_mcp"

      emits ServeQueryIrMcpRequested
    end

    command "Present" do
      role "Maintainer"
      goal "Serve the banking example's rendered forms and views on a local port until stopped"

      attribute :port, Port, optional: true, sets: true
      attribute :run,  RunKey, sets: true

      sets :operation, to: "present"

      emits PresentRequested
    end

    command "Compose" do
      role "Maintainer"
      goal "Serve the Composer, a live bluebook editor over one domain directory, on a local port until stopped"

      attribute :port,    Port, optional: true, sets: true
      attribute :domains, PathList, optional: true, sets: true
      attribute :agent,   AgentName, default: "claude", sets: true
      attribute :run,     RunKey, sets: true

      sets :operation, to: "compose"

      emits ComposeRequested
    end

    command "Preview" do
      role "Maintainer"
      goal "Serve one directory of static files, such as a website, on a local port until stopped"

      attribute :directory, Directory, sets: true
      attribute :port,      Port, optional: true, sets: true
      attribute :run,       RunKey, sets: true

      sets :operation, to: "preview"

      emits PreviewRequested
    end

    # What the tree reported about itself, held against every request: nothing here runs
    # outside a hecks checkout (hecks.gemspec beside lib/).
    command "Accept" do
      role "System"
      goal "Let a request through only when the working tree is a hecks checkout"

      reference_to CorpusRun
      attribute :checkout, Switch, sets: true

      given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }


      emits CorpusAccepted
    end

    command "Complete" do
      role "System"
      goal "Record that the request was carried out, and what it reported"

      reference_to CorpusRun
      attribute :report, Report, sets: true


      emits CorpusCompleted
    end

    command "Fault" do
      role "System"
      goal "Record that the request was refused or could not be carried out, and why"

      reference_to CorpusRun
      attribute :refusal, Report, sets: true


      emits CorpusFaulted
    end

    query "CorpusOutcome" do
      description "How one request ended: its status, and what it reported or why it failed."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "CorpusFaulted" do
      description "Every request that was refused or could not be carried out."
      where(status: "faulted")
      order_by :run
    end

    # An answer that is one document of text, exactly as the tool that produced it wrote it.
    value_object "Document" do
      attribute :text, String
    end

    query "RustDomains" do
      description "The feature and directory of every domain with a Rust feature."
      returns Document
    end

    query "RegenOrder" do
      description "The directories regeneration walks, in the order it walks them."
      returns Document
    end

    query "CorpusRustCoverage" do
      description "Whether every generated Rust module is routed by its domain."
      returns Document
    end

    query "GeneratedKey" do
      description "The content hash of what regenerating the named domains reads: the generator and each domain's own sources."
      attribute :domains, PathList, optional: true
      attribute :files, Switch, optional: true
      returns Document
    end

    query "IrConstructs" do
      description "The structural diff of each IR construct from its meta-domain."
      attribute :names, NameList, optional: true
      returns Document
    end

    query "IrDuplicates" do
      description "The rules declared more than once across the corpus."
      attribute :domains, PathList, optional: true
      attribute :meta, Switch, optional: true
      returns Document
    end

    query "IrImpact" do
      description "Which propagation touchpoints of a construct's field already show it."
      attribute :name, ConstructName
      attribute :field, FieldName
      returns Document
    end
  end

  policy "ExamineWhenServeQueryIrMcpRequested" do
    on      "CorpusRun.ServeQueryIrMcpRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenPresentRequested" do
    on      "CorpusRun.PresentRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenComposeRequested" do
    on      "CorpusRun.ComposeRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenPreviewRequested" do
    on      "CorpusRun.PreviewRequested"
    ask     :examine, with: { run: :run }
  end

  policy "AcceptCorpusWhenExamined" do
    on      "CorpusRun.CorpusExamined"
    trigger CorpusRun::Accept, with: { checkout: :checkout }
  end

  policy "FaultCorpusWhenNotAccepted" do
    on      "CorpusRun.CorpusExamined"
    where   { !checkout.value }
    trigger CorpusRun::Fault, with: { refusal: "needs a hecks checkout: hecks.gemspec stands beside lib/" }
  end

  policy "PerformCorpusWhenAccepted" do
    on      "CorpusRun.CorpusAccepted"
    ask     :perform, with: { run: :run }
  end

  policy "RecordCorpusOutcome" do
    on      "CorpusRun.CorpusAnswered"
    trigger CorpusRun::Complete, with: { report: :report }
  end

  policy "RecordCorpusFault" do
    on      "CorpusRun.CorpusRefused"
    trigger CorpusRun::Fault, with: { refusal: :refusal }
  end

  # Publishing: cutting a release of this gem. The run holds the facts the Git adapter surveyed
  # (branch, tree, versions, changelog, tag), and `Accept` holds the rules that let a release go
  # ahead: the adapter supplies the facts and the givens decide. Only an accepted run is carried
  # out, and without --confirm it is the old dry run: every check and build, nothing tagged,
  # pushed or published. A real run advances the root Release: tagged, published, verified.
  aggregate "PublishingRun" do
    description "One release of the gem, or the rehearsal of it: judged by the facts, then carried out."

    acknowledges :key_by_value, "the version this run tags; its Release is made by the run's own Tag, so a reference would require the record the command exists to make",
                 of: :version
    acknowledges :key_by_value, "the client package's version, not a gem Release",
                 of: :client_version
    acknowledges :key_by_value, "the IR format's version, not a gem Release",
                 of: :ir_version

    attribute :run,            RunKey
    attribute :operation,      Operation, optional: true
    attribute :confirm,        Switch, optional: true
    attribute :gem_only,       Switch, optional: true
    attribute :npm_only,       Switch, optional: true
    attribute :npm_local,      Switch, optional: true
    attribute :no_wait,        Switch, optional: true
    attribute :checkout,       Switch, optional: true
    attribute :branch,         Word, optional: true
    attribute :release_lane,   Word, optional: true
    attribute :on_origin,      Switch, optional: true
    attribute :clean,          Switch, optional: true
    attribute :version,        Version, optional: true
    attribute :client_version, Version, optional: true
    attribute :changelog,      Switch, optional: true
    attribute :approved,       Switch, optional: true
    attribute :tag_state,      Word, optional: true
    attribute :head,           Word, optional: true
    attribute :ir_version,     Version, optional: true
    attribute :ships_from,     Checkout, optional: true
    attribute :tagged,         Switch, optional: true
    attribute :published,      Switch, optional: true
    attribute :verified,       Switch, optional: true
    attribute :report,         Report, optional: true
    attribute :refusal,        Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, matches: :present

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Operation" do
      attribute :value, String, matches: :present
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    # One word of a fact: a branch, a commit, whether a tag stands.
    value_object "Word" do
      attribute :value, String, matches: :present
    end

    value_object "Version" do
      attribute :value, String, matches: :version
    end

    # The working tree the release is cut from.
    value_object "Checkout" do
      attribute :path, String
    end

    lifecycle :status, default: "requested" do
      mark :failure, "faulted"
      transition "Accept"     => "accepted",  from: "requested"
      transition "AcceptGem"  => "accepted",  from: "requested"
      transition "Complete"   => "completed", from: "accepted"
      transition "Fault"      => "faulted",   from: %w[requested accepted]
      mark :terminal, "completed", "faulted"
    end

    command "Publish" do
      role "Maintainer"
      goal "Tag the merged release commit, publish the gem, and get the client package published"

      attribute :gem_only,  Switch, optional: true, sets: true
      attribute :npm_only,  Switch, optional: true, sets: true
      attribute :npm_local, Switch, optional: true, sets: true
      attribute :no_wait,   Switch, optional: true, sets: true
      attribute :run,       RunKey, sets: true
      attribute :confirm,   Switch, optional: true, sets: true

      sets :operation, to: "publish"

      emits PublishRequested
    end

    command "PublishGem" do
      role "Maintainer"
      goal "Build the gem and push it to the gem registry, with the key the vault holds"

      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "publish_gem"

      emits PublishGemRequested
    end

    # What the tree reported about itself, and the facts the Git adapter surveyed, held against the
    # rules of a release. Nothing here runs outside a hecks checkout (hecks.gemspec beside lib/).
    command "Accept" do
      role "System"
      goal "Let a release go ahead only in a hecks checkout, and only when the facts satisfy every rule"

      reference_to PublishingRun
      attribute :checkout,       Switch, sets: true
      attribute :branch,         Word, sets: true
      attribute :release_lane,   Word, sets: true
      attribute :on_origin,      Switch, sets: true
      attribute :clean,          Switch, sets: true
      attribute :version,        Version, sets: true
      attribute :client_version, Version, sets: true
      attribute :changelog,      Switch, sets: true
      attribute :approved,       Switch, sets: true
      attribute :tag_state,      Word, sets: true
      attribute :head,           Word, sets: true
      attribute :ir_version,     Version, sets: true
      attribute :ships_from,     Checkout, sets: true

      given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }
      given("a release is cut from the release lane (the Lane row that feeds a tag): switch to it first") do
        branch.value == release_lane.value
      end
      given("the release lane is its origin: wait for the release commit to be promoted, then pull") { on_origin.value }
      given("the working tree is clean: commit or discard changes first") { clean.value }
      given("the client package is at the gem's version: bump the package first") do
        client_version.value == version.value
      end
      given("CHANGELOG.md has a heading for the version: add the release entry") { changelog.value }
      given("the commit that set the version carries a Release-Approved-By line: the owner decides when a release happens") do
        approved.value || tag_state.value == "at_release_commit"
      end
      given("a tag for the version points at the release commit, not elsewhere") do
        tag_state.value != "elsewhere"
      end


      emits PublishingAccepted
    end

    # release_gem's one rule: the client package is released beside the gem at the same version.
    command "AcceptGem" do
      role "System"
      goal "Let a gem push go ahead only in a hecks checkout, with the client package at the gem's version"

      reference_to PublishingRun
      attribute :checkout,       Switch, sets: true
      attribute :version,        Version, sets: true
      attribute :client_version, Version, sets: true
      attribute :ir_version,     Version, sets: true
      attribute :ships_from,     Checkout, sets: true

      given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }
      given("the client package is at the gem's version: bump the package first") do
        client_version.value == version.value
      end


      emits GemAccepted
    end

    command "Complete" do
      role "System"
      goal "Record that the release was carried out, what it did, and what it reported"

      reference_to PublishingRun
      attribute :report,    Report, sets: true
      attribute :tagged,    Switch, sets: true
      attribute :published, Switch, sets: true
      attribute :verified,  Switch, sets: true


      emits PublishingCompleted
    end

    command "Fault" do
      role "System"
      goal "Record that the request was refused or could not be carried out, and why"

      reference_to PublishingRun
      attribute :refusal, Report, sets: true


      emits PublishingFaulted
    end

    query "PublishingOutcome" do
      description "How one request ended: its status, and what it reported or why it failed."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "PublishingFaulted" do
      description "Every request that was refused or could not be carried out."
      where(status: "faulted")
      order_by :run
    end
  end

  policy "ExaminePublishingWhenPublishRequested" do
    on      "PublishingRun.PublishRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExaminePublishingWhenPublishGemRequested" do
    on      "PublishingRun.PublishGemRequested"
    ask     :examine, with: { run: :run }
  end

  policy "AcceptTheReleaseWhenExamined" do
    on      "PublishingRun.PublishingExamined"
    where   { operation.value == "publish" }
    trigger PublishingRun::Accept, with: { checkout: :checkout, branch: :branch, release_lane: :release_lane,
                                           on_origin: :on_origin, clean: :clean, version: :version,
                                           client_version: :client_version,
                                           changelog: :changelog, approved: :approved, tag_state: :tag_state,
                                           head: :head, ir_version: :ir_version, ships_from: :ships_from }
  end

  policy "AcceptTheGemWhenExamined" do
    on      "PublishingRun.PublishingExamined"
    where   { operation.value == "publish_gem" }
    trigger PublishingRun::AcceptGem, with: { checkout: :checkout, version: :version,
                                              client_version: :client_version, ir_version: :ir_version,
                                              ships_from: :ships_from }
  end

  policy "FaultTheReleaseWhenNotAccepted" do
    on      "PublishingRun.PublishingExamined"
    where do
      operation.value == "publish" &&
        (!checkout.value || branch.value != release_lane.value || !on_origin.value || !clean.value ||
          client_version.value != version.value || !changelog.value || tag_state.value == "elsewhere" ||
          (!approved.value && tag_state.value != "at_release_commit"))
    end
    trigger PublishingRun::Fault, with: { refusal: "a release rule is not met: check the branch, tree, versions, CHANGELOG, tag and the Release-Approved-By line" }
  end

  policy "FaultTheGemWhenNotAccepted" do
    on      "PublishingRun.PublishingExamined"
    where do
      operation.value == "publish_gem" && (!checkout.value || client_version.value != version.value)
    end
    trigger PublishingRun::Fault, with: { refusal: "a gem push rule is not met: needs a checkout and the client at the gem's version" }
  end

  policy "PerformPublishingWhenAccepted" do
    on      "PublishingRun.PublishingAccepted"
    ask     :perform, with: { run: :run }
  end

  policy "PerformPublishingWhenGemAccepted" do
    on      "PublishingRun.GemAccepted"
    ask     :perform, with: { run: :run }
  end

  # A real run advances the root Release: tagged when the tag was made, published when a registry
  # took the gem, verified when every registry in scope lists the version.
  policy "RecordTheTagWhenPublished" do
    on      "PublishingRun.PublishingAnswered"
    where   { tagged.value }
    trigger Release::Tag, with: { version: :version, ir_version: :ir_version, ships_from: :ships_from }
  end

  policy "RecordThePublishingWhenPublished" do
    on      "PublishingRun.PublishingAnswered"
    where   { published.value }
    trigger Release::MarkPublished, with: { version: :version }
  end

  policy "RecordTheVerificationWhenPublished" do
    on      "PublishingRun.PublishingAnswered"
    where   { verified.value }
    trigger Release::Verify, with: { version: :version }
  end

  # A release that stopped after a real step (the tag pushed, the gem published) still records the
  # steps it took on the root Release, then ends as a fault carrying what the release said.
  policy "RecordPublishingOutcome" do
    on      "PublishingRun.PublishingAnswered"
    where   { succeeded.value }
    trigger PublishingRun::Complete, with: { report: :report, tagged: :tagged, published: :published,
                                             verified: :verified }
  end

  policy "RecordPublishingShortfall" do
    on      "PublishingRun.PublishingAnswered"
    where   { succeeded.value == false }
    trigger PublishingRun::Fault, with: { refusal: :report }
  end

  policy "RecordPublishingFault" do
    on      "PublishingRun.PublishingRefused"
    trigger PublishingRun::Fault, with: { refusal: :refusal }
  end

  # Promotion: moving a lane forward onto a commit that has passed every `RequiredCheck`. The
  # adapter reads the facts (does the lane exist, where its head stands, where each check stands
  # against the commit) and `Accept` holds the rules, so what makes a commit fit for the lane is
  # decided here and in the Lane and RequiredCheck rows, never by the workflow that runs
  # `hecks promotion_run.promote`. Without --confirm the run is a rehearsal: it names the move it
  # would make and makes none. A real run fast-forwards the lane (never forces it) and moves the
  # tag the lane `feeds`, forward only; a lane that already holds the commit still has its tag
  # brought up to the lane's head, so a half-finished run is finished by the next.
  #
  # A commit is certified by the checks of that exact commit. With `commit` named, that commit is
  # the one judged, and no other is ever put in its place. Without it, the commit is the newest
  # one of the followed lane (first-parent, a bounded way back) that every `RequiredCheck` passed
  # on and that fast-forwards the lane, so the outcome never depends on which push's CI run
  # started the promotion; when none qualifies the refusal names what the lane's head is
  # waiting on.
  aggregate "PromotionRun" do
    description "One move of a lane onto a commit, or the rehearsal of it: judged by the facts, then carried out."

    attribute :run,        RunKey
    attribute :operation,  Operation, optional: true
    attribute :confirm,    Switch, optional: true
    attribute :lane,       Word
    attribute :commit,     Word, optional: true
    attribute :checkout,   Switch, optional: true
    attribute :lane_known, Switch, optional: true
    attribute :green,      Switch, optional: true
    attribute :descends,   Switch, optional: true
    attribute :head,       Word, optional: true
    attribute :behind_hours, Hours, optional: true
    attribute :limit_hours,  Hours, optional: true
    attribute :alert_key,    Word, optional: true
    attribute :promoted,   Switch, optional: true
    attribute :reason,     Report, optional: true
    attribute :report,     Report, optional: true
    attribute :refusal,    Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, matches: :present

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "Operation" do
      attribute :value, String, matches: :present
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    # A branch name, or a commit.
    value_object "Word" do
      attribute :value, String, matches: :present
    end

    # How long a lane has stood behind the lane it follows, or how long its row lets it.
    value_object "Hours" do
      attribute :value, Integer
    end

    lifecycle :status, default: "requested" do
      mark :failure, "faulted"
      transition "Accept"   => "accepted",  from: "requested"
      transition "Observe"  => "observed",  from: "requested"
      transition "Complete" => "completed", from: %w[accepted observed]
      transition "Fault"    => "faulted",   from: %w[requested accepted]
      transition "Lag"      => "faulted",   from: "observed"
      mark :terminal, "completed", "faulted"
    end

    # Looks at a lane and moves nothing: faults when it has stood behind the lane it follows for
    # longer than its `Lane` row allows, which files a finding. A lane whose row allows no lag is
    # never late.
    command "Watch" do
      role "Maintainer"
      goal "Fault when a lane has stood behind the lane it follows for longer than its Lane row allows"

      attribute :lane,      Word, sets: true
      attribute :run,       RunKey, sets: true
      attribute :alert_key, Word, sets: true

      sets :operation, to: "watch"

      emits WatchRequested
    end

    command "Promote" do
      role "Maintainer"
      goal "Move a lane onto a commit that has passed every required check, or with no --confirm rehearse the move"

      attribute :lane,    Word, sets: true
      attribute :commit,  Word, optional: true, sets: true
      attribute :run,     RunKey, sets: true
      attribute :confirm, Switch, optional: true, sets: true

      sets :operation, to: "promote"

      emits PromoteRequested
    end

    # What the tree and the remote reported, held against the rules of a promotion: the adapter
    # supplies the facts and the givens decide.
    command "Accept" do
      role "System"
      goal "Let a lane move only in a hecks checkout, onto a commit that is green on every required check and contains the lane's head"

      reference_to PromotionRun
      attribute :checkout,   Switch, sets: true
      attribute :lane_known, Switch, sets: true
      attribute :green,      Switch, sets: true
      attribute :descends,   Switch, sets: true
      attribute :commit,     Word, sets: true
      attribute :head,       Word, optional: true, sets: true

      given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }
      given("the lane is one of the Lane rows, and follows another lane") { lane_known.value }
      given("every RequiredCheck is green on the commit: wait for the checks, or fix the red one") { green.value }
      given("the commit is on the lane it follows and contains the lane's head: a lane only moves forward") { descends.value }


      emits PromotionAccepted
    end

    # What the tree and the remote reported about a watched lane, held against the rules of a
    # watch: it needs a hecks checkout and a lane that follows another.
    command "Observe" do
      role "System"
      goal "Let a lane be judged late or on time only in a hecks checkout, for a lane that follows another"

      reference_to PromotionRun
      attribute :checkout,     Switch, sets: true
      attribute :lane_known,   Switch, sets: true
      attribute :behind_hours, Hours, sets: true
      attribute :limit_hours,  Hours, sets: true
      attribute :alert_key,    Word, sets: true
      attribute :promoted,     Switch, sets: true
      attribute :reason,       Report, sets: true

      given("needs a hecks checkout: hecks.gemspec stands beside lib/") { checkout.value }
      given("the lane is one of the Lane rows, and follows another lane") { lane_known.value }


      emits LaneObserved
    end

    command "Complete" do
      role "System"
      goal "Record that the promotion was carried out or rehearsed, or the lane was on time, and what it reported"

      reference_to PromotionRun
      attribute :report,   Report, sets: true
      attribute :promoted, Switch, sets: true


      emits PromotionCompleted
    end

    # A lane that has stood behind the lane it follows for longer than its Lane row allows.
    command "Lag" do
      role "System"
      goal "Record that a lane is late, and what it is waiting on, under the alert key that names its finding"

      reference_to PromotionRun
      attribute :refusal,   Report, sets: true
      attribute :alert_key, Word, sets: true


      emits LaneLagged
    end

    command "Fault" do
      role "System"
      goal "Record that the promotion was refused or could not be carried out, and why"

      reference_to PromotionRun
      attribute :refusal, Report, sets: true


      emits PromotionFaulted
    end

    query "PromotionOutcome" do
      description "How one promotion ended: its status, and what it reported or why it failed."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "PromotionFaulted" do
      description "Every promotion that was refused or could not be carried out."
      where(status: "faulted")
      order_by :run
    end
  end

  policy "ExamineWhenPromoteRequested" do
    on      "PromotionRun.PromoteRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ExamineWhenWatchRequested" do
    on      "PromotionRun.WatchRequested"
    ask     :examine, with: { run: :run }
  end

  policy "ObserveWhenWatchExamined" do
    on      "PromotionRun.PromotionExamined"
    where   { operation.value == "watch" }
    trigger PromotionRun::Observe, with: { checkout: :checkout, lane_known: :lane_known, behind_hours: :behind_hours,
                                           limit_hours: :limit_hours, alert_key: :alert_key, promoted: :promoted,
                                           reason: :reason }
  end

  policy "FaultWhenWatchCannotBeJudged" do
    on      "PromotionRun.PromotionExamined"
    where   { operation.value == "watch" && (!checkout.value || !lane_known.value) }
    trigger PromotionRun::Fault, with: { refusal: :reason }
  end

  policy "LagWhenLaneLate" do
    on      "PromotionRun.LaneObserved"
    where   { behind_hours.value > limit_hours.value }
    trigger PromotionRun::Lag, with: { refusal: :reason, alert_key: :alert_key }
  end

  policy "CompleteWhenLaneOnTime" do
    on      "PromotionRun.LaneObserved"
    where   { behind_hours.value <= limit_hours.value }
    trigger PromotionRun::Complete, with: { report: :reason, promoted: :promoted }
  end

  policy "AcceptPromotionWhenExamined" do
    on      "PromotionRun.PromotionExamined"
    where   { operation.value == "promote" }
    trigger PromotionRun::Accept, with: { checkout: :checkout, lane_known: :lane_known, green: :green,
                                          descends: :descends, commit: :commit, head: :head }
  end

  policy "FaultPromotionWhenNotAccepted" do
    on      "PromotionRun.PromotionExamined"
    where   { operation.value == "promote" && (!checkout.value || !lane_known.value || !green.value || !descends.value) }
    trigger PromotionRun::Fault, with: { refusal: :reason }
  end

  policy "PerformPromotionWhenAccepted" do
    on      "PromotionRun.PromotionAccepted"
    ask     :perform, with: { run: :run }
  end

  policy "RecordPromotionOutcome" do
    on      "PromotionRun.PromotionAnswered"
    trigger PromotionRun::Complete, with: { report: :report, promoted: :promoted }
  end

  policy "RecordPromotionFault" do
    on      "PromotionRun.PromotionRefused"
    trigger PromotionRun::Fault, with: { refusal: :refusal }
  end
end
