# Sibling bounded-context hecksagons.
# Same-name blocks merge with hecks.hecksagon, order-independent.

# Governance's aggregates take the store the Hecks domain gives the bluebooks it attaches, and are
# in Memory when it gives none.
Hecks.hecksagon "Governance" do
end

# The attached bluebooks (hecks.hecksagon `attaches`): each is a bounded context whose store is the
# one the Hecks domain's own `persisted_by` gives it, so a copy that opts the Hecks bluebook in
# opts them all in.
Hecks.hecksagon "Bluebook" do
  attaches "Governance"
end

Hecks.hecksagon "Hecksagon" do
  attaches "Governance"
end

Hecks.hecksagon "World" do
  attaches "Governance"
end

Hecks.hecksagon "Adapter" do
  attaches "Governance"
end

Hecks.hecksagon "Port" do
  attaches "Governance"
end

Hecks.hecksagon "Translation" do
  attaches "Governance"
end

Hecks.hecksagon "Expression" do
  attaches "Governance"
end

Hecks.hecksagon "Tenancy" do
  attaches "Governance"
end

Hecks.hecksagon "Deploy" do
  attaches "Governance"
end

Hecks.hecksagon "Site" do
  attaches "Governance"
end

Hecks.hecksagon "Tickets" do
  attaches "Governance"
end

Hecks.hecksagon "Protocols" do
  attaches "Governance"
end

