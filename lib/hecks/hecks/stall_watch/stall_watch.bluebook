Hecks.bluebook "Hecks" do
  domain_module "StallWatch" do
    vision "A stall is noticed by data, not by a person watching: each kind is a row, and every stall found becomes one Work item for its fixer."

    # One look at the event tap for stalls. The clock's beat asks it (`DetectOnHeartbeat`), and so may
    # anyone (`StallWatch.detect!`). The `Watching` port reads the tap and answers the opening lines
    # whose closing line has not come; each is offered to `Stall.File`, which decides by its kind's
    # row whether it is a stall. The look itself writes nothing outside this domain.
    aggregate "StallWatch" do
      description "One look at the event tap for opening events whose closing event has not come."
      created_by "StallWatch.detect!"

      attribute :run, RunKey
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      # One kind of stall, one row each: the aggregate and event that open it, the events on the same
      # aggregate id that close it (comma separated), the minutes it may stay open before it is a
      # stall, the minutes after which an open line is history rather than a stall, the role that
      # fixes it, and the move it makes, in Hecks commands: the stall's Work item carries it as its
      # detail. The opening line's aggregate id is the stall's subject. `closed_by` says which
      # closing lines close an opening line: "id" (the default) those on the same aggregate id,
      # "any" every closing line on the aggregate after it, whatever its id. `evidence` names a
      # read the stall's detail carries when it is filed: "processes" is the busiest process class
      # and the session whose shell owns it.
      value_object "StallKind" do
        attribute :kind,      String
        attribute :aggregate, String
        attribute :opens,     String
        attribute :closes,    String
        attribute :closed_by, String
        attribute :evidence,  String
        attribute :minutes,   Integer
        attribute :forgets,   Integer
        attribute :fixer,     String
        attribute :move,      String
        attribute :ends_aggregate, String
        attribute :ends,           String

        member kind: "plan-review", aggregate: "Agents::PlanReview", opens: "PlanReviewRequested",
               closes: "PlanReviewed,PlanReviewRecorded,ReviewUnstarted", minutes: 20, forgets: 1440, fixer: "orchestrator",
               ends_aggregate: "Hecks::AgentRun", ends: "SessionFinished,SessionFailed,AgentRunRetired,AgentTrialRunRetired",
               move: "Read the architect's closing report, record its verdict with PlanReview.answer! " \
                     "(PlanReview.record! when no request row exists), then AgentRun.answer! the waiting coder."
        member kind: "train-pr-red", aggregate: "Hecks::TrainPr", opens: "TrainPrFailed",
               closes: "TrainPrRerun,TrainPrExhausted", minutes: 10, forgets: 1440, fixer: "orchestrator",
               move: "Read the failed PR's CI (gh pr view), rerun its failed jobs once (gh run rerun --failed), " \
                     "and if it fails again Work.plan! red-train-<pr> (category red, priority now) with the failure as its detail."
        member kind: "agent-run-start", aggregate: "Hecks::AgentRun", opens: "AgentRunRequested",
               closes: "AgentRunStarted,AgentRunDeclined", minutes: 10, forgets: 1440, fixer: "orchestrator",
               move: "Work.yield! the run's Work item (AgentRun.running names it) with the reason, " \
                     "so the fill restarts it once."
        member kind: "agent-run-session", aggregate: "Hecks::AgentRun", opens: "AgentRunStarted",
               closes: "SessionFinished,SessionFailed,AgentRunRetired,AgentTrialRunRetired", minutes: 240,
               forgets: 1440, fixer: "orchestrator",
               move: "AgentRun.check! the run; if it is unchanged AgentRun.answer! it asking for status once; " \
                     "then Work.yield! the run's Work item (AgentRun.running names it) with the reason."
        member kind: "agent-run-blocked", aggregate: "Hecks::AgentRun", opens: "SessionBlocked",
               closes: "AnswerRequested,AgentRunAnswered,SessionWorking,SessionFinished,SessionFailed,AgentRunRetired,AgentTrialRunRetired",
               minutes: 15, forgets: 1440, fixer: "orchestrator",
               move: "AgentRun.answer! the [confirm] or [retry] question it waits on, and confirm the board did. " \
                     "For a [choose] question answer it with AgentRun.answer! when the answer follows from the brief, " \
                     "the Work item's area or an architect verdict (a wrong area: Work.rescope!, then answer); " \
                     "otherwise Work.plan! a work item titled 'needs an answer: <run>' with the question text as its detail " \
                     "(the orchestrator holds Work.*; it needs no other permission). Never ask the owner."
        # A volume at high past half an hour is a stall for the pruner, once per volume, ever: the
        # DiskSpace `Volume` it opens on rises once.
        member kind: "disk", aggregate: "Hecks::Volume", opens: "VolumeRose", closes: "VolumeEased",
               minutes: 30, forgets: 10080, fixer: "pruner",
               move: "Relief.plan! run.value=<stall> to see what frees space, then Relief.relieve! " \
                     "run.value=<stall>-relief state.value=high --confirm, which retires merged worktrees and " \
                     "tidies done runs only; report unpushed, dirty and pinned subjects by path, never remove them."
        # The machine's load over its mark for five minutes. Each crossing is keyed by the beat that
        # heard it, so any later fall closes the rise, and the subject is the beat of the rise.
        member kind: "load", aggregate: "Hecks::Machine", opens: "LoadRoseAbove", closes: "LoadFellBelow",
               closed_by: "any", evidence: "processes", minutes: 5, forgets: 1440, fixer: "orchestrator",
               move: "The detail names the busiest process class and the session whose shell owns it " \
                     "(Machine.busiest reads every class again); AgentRun.running names that session's started run. " \
                     "AgentRun.answer! that run naming the processes and asking it to end the processes its " \
                     "commands start and to bound how many it starts. Never kill a pid. If no pipeline " \
                     "session owns them, Work.plan! a work item with the process list as its detail and leave it to the owner."
      end

      # One opening line still waiting for its closing line, as the tap shows it and its kind's row
      # prices it: the facts `Stall.File` judges. `id` is the look that found it.
      value_object "Sighting" do
        attribute :id,         String
        attribute :stall,      String
        attribute :stall_kind, String
        attribute :subject,    String
        attribute :opened_at,  String
        attribute :waited,     Integer
        attribute :minutes,    Integer
        attribute :forgets,    Integer
        attribute :fixer,      String
        attribute :title,      String
        attribute :detail,     String
      end

      command "Detect" do
        role "System"
        goal "Look at the event tap for opening events whose closing event has not come"

        attribute :run, RunKey, sets: true

        emits StallDetectRequested
      end

      # A filed stall whose run (named by the kind's `ends` events, on the same id) has ended: its
      # closing line will not come, so it is closed with the reason.
      value_object "Abandoned" do
        attribute :id,      String
        attribute :stall,   String
        attribute :subject, String
        attribute :reason,  String
      end

      query "Unclosed" do
        description "The opening lines of every stall kind whose closing line has not come, within the kind's window, with how long each has waited. A line the tap shows filed already, or whose run has ended, is left out: it is handled once and a later look emits nothing for it. Read-only: it reads the tap and boots nothing."
        attribute :run, String
        returns list_of(Sighting)
      end

      query "Abandoned" do
        description "The filed stalls whose run has ended and which no look has closed yet, each with the ending event as its reason. Read-only: it reads the tap and boots nothing."
        attribute :run, String
        returns list_of(Abandoned)
      end
    end

    # One stall, filed once: `stall-<kind>-<subject>`. Its key is the dedupe, so a stall seen by a
    # later look is refused as already filed; the Work item it becomes carries the same key, so a
    # look after a restart, when this store is empty again, is refused by Tickets instead.
    aggregate "Stall" do
      description "One stall: an opening event whose closing event did not come within its kind's minutes, and the role that fixes it."
      created_by "Stall.file!"

      attribute :stall,     StallKey
      attribute :kind,      Word
      attribute :subject,   Word
      attribute :opened_at, Word
      attribute :waited,    Minutes
      attribute :minutes,   Minutes
      attribute :forgets,   Minutes
      attribute :fixer,     Fixer
      attribute :title,     Line
      attribute :detail,    Line
      attribute :reason,    Line, optional: true
      reference_to StallWatch, as: :watch
      identified_by :stall

      value_object "StallKey" do
        attribute :value, String, pattern: '\Astall-[a-z0-9-]+-[A-Za-z0-9._-]+\z'
      end

      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Line" do
        attribute :value, String, matches: :present
      end

      value_object "Minutes" do
        attribute :value, Integer

        invariant("minutes are not negative") { !value.negative? }
      end

      # The role a stall's Work item is for: one of the pipeline's agent roles.
      value_object "Fixer" do
        attribute :value, String, one_of: %w[orchestrator coder architect planner reviewer pruner release_manager]
      end

      command "File" do
        role "System"
        goal "File a stall once: an opening event left open past its kind's minutes, for the role that fixes it"

        reference_to StallWatch, as: :watch
        attribute :stall,     StallKey, sets: true
        attribute :kind,      Word, sets: true
        attribute :subject,   Word, sets: true
        attribute :opened_at, Word, sets: true
        attribute :waited,    Minutes, sets: true
        attribute :minutes,   Minutes, sets: true
        attribute :forgets,   Minutes, sets: true
        attribute :fixer,     Fixer, sets: true
        attribute :title,     Line, sets: true
        attribute :detail,    Line, sets: true

        sets :watch

        given("a stall has waited past its kind's minutes") { waited.value >= minutes.value }
        given("a stall is younger than its kind's window") { waited.value < forgets.value }

        emits StallFiled
      end

      # A stall whose run ended can no longer close: it is closed here, once, with the reason. Like
      # `File` it creates the record by its key, so a look in a fresh process can name it.
      command "Abandon" do
        role "System"
        goal "Close a stall whose run has ended, because its closing event will not come"

        reference_to StallWatch, as: :watch
        attribute :stall,  StallKey, sets: true
        attribute :reason, Line, sets: true

        sets :watch

        emits StallAbandoned
      end
    end

    # Each beat of the clock looks once, keyed by the beat. A root, so the look starts its own chain.
    policy "DetectOnHeartbeat" do
      on      "Heartbeat.Beaten"
      root
      trigger StallWatch::Detect, with: { run: :beat }
    end

    # Every opening line the look found is offered to `File`; a refusal (not yet past its minutes,
    # already filed) is recorded per line and the rest go on.
    policy "FileEveryStallWhenDetected" do
      on       "StallWatch.StallDetectRequested"
      for_each "StallWatch.Unclosed"
      trigger  Stall::File, with: { watch: :id, stall: :stall, kind: :stall_kind, subject: :subject, opened_at: :opened_at,
                                    waited: :waited, minutes: :minutes, forgets: :forgets, fixer: :fixer,
                                    title: :title, detail: :detail }
    end

    # Every filed stall whose run has ended is closed, once: the tap shows it abandoned afterwards.
    policy "AbandonEveryStallWhenDetected" do
      on       "StallWatch.StallDetectRequested"
      for_each "StallWatch.Abandoned"
      trigger  Stall::Abandon, with: { watch: :id, stall: :stall, reason: :reason }
    end
  end
end
