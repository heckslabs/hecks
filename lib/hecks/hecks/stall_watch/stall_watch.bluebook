Hecks.bluebook "Hecks" do
  domain_module "StallWatch" do
    vision "A stall is noticed by data, not by a person watching: each kind is a row, and every stall found becomes one Work item for its fixer."

    # One look at the event tap for stalls. The clock's beat asks it (`DetectOnHeartbeat`), and so may
    # anyone (`StallWatch.detect!`). The `Watching` port reads the tap and answers the opening lines
    # whose closing line has not come; each is offered to `Stall.File`, which decides by its kind's
    # row whether it is a stall. The look itself writes nothing outside this domain.
    aggregate "StallWatch" do
      description "One look at the event tap for opening events whose closing event has not come."
      created_by "StallWatch.detect!"

      attribute :run, RunKey
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      # One kind of stall, one row each: the aggregate and event that open it, the events on the same
      # aggregate id that close it (comma separated), the minutes it may stay open before it is a
      # stall, the minutes after which an open line is history rather than a stall, the role that
      # fixes it, and the move it makes (its Work item's detail). The opening line's aggregate id is
      # the subject. `closed_by` says which closing lines close it: "id" (the default) those on the
      # same aggregate id, "any" every closing line on the aggregate after it. `evidence` names a
      # read the detail carries: "processes" is the busiest class and its session. `not_about` is a
      # subject prefix never filed for ("stall-").
      value_object "StallKind" do
        attribute :kind,      String
        attribute :aggregate, String
        attribute :opens,     String
        attribute :closes,    String
        attribute :closed_by, String
        attribute :evidence,  String
        attribute :minutes,   Integer
        attribute :forgets,   Integer
        attribute :fixer,     String
        attribute :move,      String
        attribute :ends_aggregate, String
        attribute :ends,           String
        attribute :not_about,      String
        # The reverse of `not_about`: only openings whose id starts with it are timed.
        attribute :only_about,     String
        # The lifecycle state of the row's aggregate that the row times, which model_check holds
        # it to. A row that times something else, as agent-run-blocked times a session's
        # condition, names none.
        attribute :state,          String
        # A later `settled_by` line on `settled_aggregate` (same id, or `settled_on: "branch"`) settles
        # the subject: it is not filed, and a filed one is abandoned. A yield never settles a run:
        # the fixer's own move yields it.
        attribute :settled_aggregate, String
        attribute :settled_by,        String
        attribute :settled_on,        String

        member kind: "plan-review", not_about: "stall-", aggregate: "Agents::PlanReview", opens: "PlanReviewRequested",
               closes: "PlanReviewed,PlanReviewRecorded,ReviewUnstarted", minutes: 20, forgets: 1440, fixer: "orchestrator",
               ends_aggregate: "Hecks::AgentRun", ends: "SessionFinished,SessionFailed,AgentRunRetired,AgentTrialRunRetired",
               move: "Read the architect's closing report, record its verdict with PlanReview.answer! " \
                     "(PlanReview.record! when no request row exists), then AgentRun.answer! the waiting coder."
        member kind: "train-pr-red", aggregate: "Hecks::TrainPr", opens: "TrainPrFailed",
               closes: "TrainPrRerun,TrainPrExhausted", minutes: 10, forgets: 1440, fixer: "orchestrator",
               move: "Read the failed PR's CI (gh pr view), rerun its failed jobs once (gh run rerun --failed), " \
                     "and if it fails again Work.plan! red-train-<pr> (category red, priority now) with the failure as its detail."
        # A queued train pull request asks for a chain of ticks keyed by the boarded commit
        # (`TickWhenQueued`); a chain that never beats within 3 minutes has no live worker. A healthy
        # chain's first beat comes about half a minute after it is asked for. Every verdict on the
        # pull request stops the chain (`TickerStopped`), so a closed run is not a stall; a declined
        # start is no worker and stays one. A chain that beats and then dies is not this kind: the
        # line closes on its first beat.
        member kind: "train-pr-unbeaten", aggregate: "Hecks::Ticker", opens: "TickerRequested",
               closes: "Ticked,TickerStopped", minutes: 3, forgets: 1440, fixer: "orchestrator",
               move: "The launchd beat is the pulse (every minute): start none, since a second is refused while one " \
                     "runs, and read when it last ran from the mtime of ~/.claude/hecks-dev/train-beat.log. Then " \
                     "Integration.advance! confirm=true, so the pushed run is observed; then read the chain's log (~/.claude/hecks-dev/ticker/<commit>.log) and " \
                     "report a declined or ended chain as the cause."
        # A train pull request whose CI never started: `TrainPrCi.Await` records it only once its
        # bound has passed (deliver.bluebook), so it is a stall as soon as a look sees it.
        member kind: "ci-not-started", aggregate: "Hecks::TrainPrCi", opens: "TrainPrCiAwaited",
               closes: "TrainPrCiStarted", minutes: 0, forgets: 1440, fixer: "orchestrator",
               move: "Read githubstatus.com for GitHub Actions, and the PR's checks with SendTrain.watch! to=<boarding> (gh pr view <pr> --json statusCheckRollup). " \
                     "The pipeline closes and reopens it once after 20 minutes (TrainPrReopen); if CI still has not " \
                     "started once Actions is up, read when the launchd beat last ran from the mtime of ~/.claude/hecks-dev/train-beat.log (start no beat), then close and reopen it by hand (gh pr close, gh pr reopen, gh pr merge --auto --squash)."
        # The four AgentRun rows end on the run's last lines: `closes` clears a line before it is
        # filed, and `ends` abandons a filed stall whose run was tidied or retired after it opened,
        # even when a closing line came first, so its Work item is not started on a run that is gone.
        member kind: "agent-run-start", not_about: "stall-", aggregate: "Hecks::AgentRun", state: "requested", opens: "AgentRunRequested",
               ends_aggregate: "Hecks::AgentRun", ends: "AgentRunTidied,AgentRunRetired,AgentTrialRunRetired",
               settled_aggregate: "Tickets::Work", settled_by: "WorkFinished,WorkDropped,WorkLapsed",
               closes: "AgentRunStarted,AgentRunDeclined", minutes: 10, forgets: 1440, fixer: "orchestrator",
               move: "Work.yield! the run's Work item (AgentRun.running names it) with the reason, " \
                     "so the fill restarts it once."
        member kind: "agent-run-session", not_about: "stall-", aggregate: "Hecks::AgentRun", state: "started", opens: "AgentRunStarted",
               ends_aggregate: "Hecks::AgentRun", ends: "AgentRunTidied,AgentRunRetired,AgentTrialRunRetired",
               settled_aggregate: "Tickets::Work", settled_by: "WorkFinished,WorkDropped,WorkLapsed",
               closes: "SessionFinished,SessionFailed,AgentRunRetired,AgentTrialRunRetired", minutes: 240,
               forgets: 1440, fixer: "orchestrator",
               move: "AgentRun.check! the run; if it is unchanged AgentRun.answer! it asking for status once; " \
                     "then Work.yield! the run's Work item (AgentRun.running names it) with the reason."
        # A verdict's resume was refused while the coder waits on it. Each sweep sends it again up to
        # three times and then finishes the run, which closes this line, so a line open for ten minutes
        # means the sweep or its retry chain is broken: the dead run still holds its Work item's area.
        member kind: "agent-run-unresumed", not_about: "stall-", aggregate: "Hecks::AgentRun", opens: "AgentRunUnresumed",
               ends_aggregate: "Hecks::AgentRun", ends: "AgentRunTidied,AgentRunRetired,AgentTrialRunRetired",
               settled_aggregate: "Tickets::Work", settled_by: "WorkFinished,WorkDropped,WorkLapsed",
               closes: "AgentRunAnswered,SessionFinished,SessionFailed,AgentRunRetired,AgentTrialRunRetired",
               minutes: 10, forgets: 1440, fixer: "orchestrator",
               move: "The sweep already sends the verdict again and then ends the run, so a stall here means the " \
                     "sweep or its retry chain is broken: report that as the finding. AgentRun.check! the run, then " \
                     "Work.yield! the run's Work item (AgentRun.running names it) with the reason, so its area claim is freed."
        member kind: "agent-run-blocked", not_about: "stall-", aggregate: "Hecks::AgentRun", opens: "SessionBlocked",
               ends_aggregate: "Hecks::AgentRun", ends: "AgentRunTidied,AgentRunRetired,AgentTrialRunRetired",
               settled_aggregate: "Tickets::Work", settled_by: "WorkFinished,WorkDropped,WorkLapsed",
               closes: "AnswerRequested,AgentRunAnswered,SessionWorking,SessionFinished,SessionFailed,AgentRunRetired,AgentTrialRunRetired",
               minutes: 15, forgets: 1440, fixer: "orchestrator",
               move: "AgentRun.answer! the [confirm] or [retry] question it waits on, and confirm the board did. " \
                     "For a [choose] question answer it with AgentRun.answer! when the answer follows from the brief, " \
                     "the Work item's area or an architect verdict (a wrong area: Work.rescope!, then answer); " \
                     "otherwise Work.plan! a work item titled 'needs an answer: <run>' with the question text as its detail " \
                     "(the orchestrator holds Work.*; it needs no other permission). Never ask the owner."
        # A volume at high past half an hour is a stall for the pruner, once per volume, ever: the
        # DiskSpace `Volume` it opens on rises once.
        member kind: "disk", aggregate: "Hecks::Volume", state: "high", opens: "VolumeRose", closes: "VolumeEased",
               minutes: 30, forgets: 10080, fixer: "pruner",
               move: "Relief.plan! run.value=<stall> to see what frees space, then Relief.relieve! " \
                     "run.value=<stall>-relief state.value=high --confirm, which retires merged worktrees and " \
                     "tidies done runs only; report unpushed, dirty and pinned subjects by path, never remove them."
        # The machine's load over its mark for five minutes, keyed by the beat that heard each crossing.
        # Only the beat's readings (`launchd-`) are the fleet's load: a gate step's `<sha>-<step>`
        # reading is never followed by a fall under its key, so it opens no stall.
        member kind: "load", only_about: "launchd-", aggregate: "Hecks::Machine", opens: "LoadRoseAbove", closes: "LoadFellBelow",
               closed_by: "any", evidence: "processes", minutes: 5, forgets: 1440, fixer: "orchestrator",
               move: "The rise itself already asked the lowest-priority started item to yield (Shed.ShedAsked, " \
                     "or ShedSpared with the reason): do not ask that run again. " \
                     "The detail names the busiest process class and the session whose shell owns it " \
                     "(Machine.busiest reads every class again); AgentRun.running names that session's started run. " \
                     "AgentRun.answer! that run naming the processes and asking it to end the processes its " \
                     "commands start and to bound how many it starts. Never kill a pid. If no pipeline " \
                     "session owns them, Work.plan! a work item with the process list as its detail and leave it to the owner."
        # A landing job (`Landing.Carry`) neither landed nor refused in ten minutes: a quick gate takes a few.
        # The tap holds no process data, so the move names the check. `Landing.Finish` is not timed: it has
        # no closing line when it refuses before its merge.
        member kind: "landing-carry", not_about: "stall-", aggregate: "Delivery::Landing", opens: "CarryRequested",
               closes: "BranchLanded,LandingRefused", minutes: 30, forgets: 1440, fixer: "orchestrator",
               settled_aggregate: "Delivery::Landing", settled_by: "BranchLanded,LandingRefused", settled_on: "branch",
               move: "Read .git/hecks-landings/<branch>.log and look for a gate process (ps) of that branch's worktree: " \
                     "a gate still running or output still growing is only slow, so leave it. " \
                     "A gate may be queued, not slow: landing gates take turns (the Tickets world's heavy_jobs cap), and " \
                     "the files heavy-jobs/slot-N.lock under the cache directory name each holder (job and pid). A queued " \
                     "gate is only waiting for up to 1800 s, after which it runs anyway. The log is written when the carry " \
                     "ends, so it holds no line about the queue; read ps and the slot files instead. With neither,the job has " \
                     "stopped: Work.release! its item so the fill hands the branch to a coder to submit again, and report the log's last line as the cause."
        # A handed landing whose job never reached `Landing.Carry`. Carry has a run of its own, so any later
        # closing line closes this one (`any`): the next landing hides a dropped handoff, which is accepted.
        # The carry starts within seconds and its retries come after it, so ten minutes is ample.
        member kind: "landing-handed", not_about: "stall-", aggregate: "Delivery::Landing", opens: "LandingSubmitted",
               closes: "CarryRequested,BranchLanded,LandingRefused", closed_by: "any", minutes: 10, forgets: 1440,
               settled_aggregate: "Delivery::Landing", settled_by: "BranchLanded,LandingRefused", settled_on: "branch",
               fixer: "orchestrator",
               move: "This landing was handed to a job that never began its carry. The log is written when a carry " \
                     "ends, so a missing .git/hecks-landings/<branch>.log is expected and proves nothing: look for a " \
                     "launcher process (ps) of that branch's worktree. A running one is only slow, so leave it. With none, " \
                     "the job has died: Work.release! its item so the fill hands the branch to a coder to submit again."
        # A boarding that could not push: a refused push and failed checks both record `PushFaulted`.
        # The move reads whether a later boarding, which has a run of its own, already pushed.
        member kind: "train-faulted", aggregate: "Hecks::SendTrain", state: "faulted", opens: "PushFaulted",
               closes: "BranchPushed", minutes: 0, forgets: 1440, fixer: "orchestrator",
               move: "Read SendTrain.outcome for the boarding's refusal, and RedFlag.status. If a later boarding " \
                     "already pushed the commit (BranchPushed), report that and stop. Otherwise fix the cause the " \
                     "refusal names and board again (SendTrain.board! --confirm); never use --no-verify or HECKS_OWNER_PUSH."
        # A queued boarding whose pull request has not merged in 45 minutes: its checks are slow or stuck.
        # A merge, a failed-checks verdict (`train-checks-failed` takes over) or a pull request closed
        # unmerged (`BoardingClosed`: settled, nothing left to watch) closes it.
        member kind: "train-unmerged", aggregate: "Hecks::SendTrain", state: "queued", opens: "BoardingQueued",
               closes: "BranchPushed,TrainChecksFailed,PushFaulted,BoardingClosed", minutes: 45, forgets: 1440, fixer: "orchestrator",
               move: "Read the train pull request with SendTrain.watch! to=<boarding> (gh pr view <pr> --json mergeStateStatus,statusCheckRollup): " \
                     "BLOCKED on pending checks is only slow, so leave it; CLEAN without a merge means auto-merge " \
                     "is off, so turn it on (gh pr merge <pr> --auto). The launchd beat records a merge GitHub made: start none, and read when it last ran from the mtime of ~/.claude/hecks-dev/train-beat.log."
        # A queued boarding's required checks ended red; its pull request stays open and a merge closes it.
        member kind: "train-checks-failed", aggregate: "Hecks::SendTrain", state: "red", opens: "TrainChecksFailed",
               closes: "BranchPushed,BoardingClosed", minutes: 0, forgets: 1440, fixer: "orchestrator",
               move: "The report names the failed jobs: read them (gh run view --log-failed). A flaky job is rerun " \
                     "once (gh run rerun --failed); a real failure is Work.plan! as a red-* work item with the " \
                     "failed jobs as its detail."
      end

      # One opening line still waiting for its closing line, as the tap shows it and its kind's row
      # prices it: the facts `Stall.File` judges. `id` is the look that found it.
      value_object "Sighting" do
        attribute :id,         String
        attribute :stall,      String
        attribute :stall_kind, String
        attribute :subject,    String
        attribute :opened_at,  String
        attribute :waited,     Integer
        attribute :minutes,    Integer
        attribute :forgets,    Integer
        attribute :fixer,      String
        attribute :title,      String
        attribute :detail,     String
      end

      command "Detect" do
        role "System"
        goal "Look at the event tap for opening events whose closing event has not come"

        attribute :run, RunKey, sets: true

        emits StallDetectRequested
      end

      # A filed stall, its line closed or not, whose run ended (the kind's `ends` lines on the same
      # id) or whose subject settled (its `settled_by` lines) since it opened: no fixer is needed,
      # so it is closed with the reason.
      value_object "Abandoned" do
        attribute :id,      String
        attribute :stall,   String
        attribute :subject, String
        attribute :reason,  String
      end

      query "Unclosed" do
        description "The opening lines of every stall kind whose closing line has not come, within the kind's window, with how long each has waited. A line the tap shows filed already, whose run has ended or whose subject has settled since it opened, is left out: it is handled once and a later look emits nothing for it. Read-only: it reads the tap and boots nothing."
        attribute :run, String
        returns list_of(Sighting)
      end

      query "Abandoned" do
        description "The filed stalls, opened within their kind's window, whose run has ended or whose subject has settled since they opened and which no look has closed yet, each with the ending or settling line as its reason; a filed stall whose line has closed is one too. Read-only: it reads the tap and boots nothing."
        attribute :run, String
        returns list_of(Abandoned)
      end
    end

    # One stall, filed once: `stall-<kind>-<subject>`. Its key is the dedupe, so a stall seen by a
    # later look is refused as already filed; the Work item it becomes carries the same key, so a
    # look after a restart, when this store is empty again, is refused by Tickets instead.
    aggregate "Stall" do
      description "One stall: an opening event whose closing event did not come within its kind's minutes, and the role that fixes it."
      created_by "Stall.file!"

      attribute :stall,     StallKey
      attribute :kind,      Word
      attribute :subject,   Word
      attribute :opened_at, Word
      attribute :waited,    Minutes
      attribute :minutes,   Minutes
      attribute :forgets,   Minutes
      attribute :fixer,     Fixer
      attribute :title,     Line
      attribute :detail,    Line
      attribute :reason,    Line, optional: true
      reference_to StallWatch, as: :watch
      identified_by :stall

      value_object "StallKey" do
        attribute :value, String, pattern: '\Astall-[a-z0-9-]+-[A-Za-z0-9._-]+\z'
      end

      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Line" do
        attribute :value, String, matches: :present
      end

      value_object "Minutes" do
        attribute :value, Integer

        invariant("minutes are not negative") { !value.negative? }
      end

      # The role a stall's Work item is for: one of the pipeline's agent roles.
      value_object "Fixer" do
        attribute :value, String, one_of: %w[orchestrator coder architect planner reviewer pruner release_manager]
      end

      command "File" do
        role "System"
        goal "File a stall once: an opening event left open past its kind's minutes, for the role that fixes it"

        reference_to StallWatch, as: :watch
        attribute :stall,     StallKey, sets: true
        attribute :kind,      Word, sets: true
        attribute :subject,   Word, sets: true
        attribute :opened_at, Word, sets: true
        attribute :waited,    Minutes, sets: true
        attribute :minutes,   Minutes, sets: true
        attribute :forgets,   Minutes, sets: true
        attribute :fixer,     Fixer, sets: true
        attribute :title,     Line, sets: true
        attribute :detail,    Line, sets: true

        sets :watch

        given("a stall is not about a stall item") { !subject.value.start_with?("stall-") }
        given("a stall has waited past its kind's minutes") { waited.value >= minutes.value }
        given("a stall is younger than its kind's window") { waited.value < forgets.value }

        emits StallFiled
      end

      # A stall whose run ended or whose subject settled needs no fixer: it is closed here, once,
      # with the reason; Tickets drops its work item. Like
      # `File` it creates the record by its key, so a look in a fresh process can name it.
      command "Abandon" do
        role "System"
        goal "Close a stall whose run has ended or whose subject has settled, because no fixer is needed"

        reference_to StallWatch, as: :watch
        attribute :stall,  StallKey, sets: true
        attribute :reason, Line, sets: true

        sets :watch

        emits StallAbandoned
      end
    end

    # Each beat of the clock looks once, keyed by the beat. A root, so the look starts its own chain.
    policy "DetectOnHeartbeat" do
      on      "Heartbeat.Beaten"
      root
      trigger StallWatch::Detect, with: { run: :beat }
    end

    # Every opening line the look found is offered to `File`; a refusal (not yet past its minutes,
    # already filed) is recorded per line and the rest go on.
    policy "FileEveryStallWhenDetected" do
      on       "StallWatch.StallDetectRequested"
      for_each "StallWatch.Unclosed"
      trigger  Stall::File, with: { watch: :id, stall: :stall, kind: :stall_kind, subject: :subject, opened_at: :opened_at,
                                    waited: :waited, minutes: :minutes, forgets: :forgets, fixer: :fixer,
                                    title: :title, detail: :detail }
    end

    # Every filed stall whose run has ended or whose subject has settled is closed, once: the tap
    # shows it abandoned afterwards.
    policy "AbandonEveryStallWhenDetected" do
      on       "StallWatch.StallDetectRequested"
      for_each "StallWatch.Abandoned"
      trigger  Stall::Abandon, with: { watch: :id, stall: :stall, reason: :reason }
    end
  end
end
