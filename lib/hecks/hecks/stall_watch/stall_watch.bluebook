Hecks.bluebook "Hecks" do
  domain_module "StallWatch" do
    vision "A stall is noticed by data, not by a person watching: each kind is a row that says how its stall is cleared. Its stall item wakes one run of the orchestrator, keyed by the stall, that settles it in place and is never a Work item; a call for help is assigned by the Lead. No stall gets both."

    # One look at the event tap for stalls. The clock's beat asks it (`DetectOnHeartbeat`), and so may
    # anyone (`StallWatch.detect!`). The `Watching` port reads the tap and answers the opening lines
    # whose closing line has not come; each is offered to `Stall.File`, which decides by its kind's
    # row whether it is a stall. The look itself writes nothing outside this domain.
    aggregate "StallWatch" do
      description "One look at the event tap for opening events whose closing event has not come."
      created_by "StallWatch.detect!"

      attribute :run, RunKey
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      # One kind of stall, one row each: the aggregate and event that open it, the events on the same
      # aggregate id that close it (comma separated), the minutes it may stay open before it is a
      # stall, the minutes after which an open line is history rather than a stall, the role that
      # fixes it, and the move it makes (the brief of the run that settles it). The
      # opening line's aggregate id is the subject. `closed_by` says which closing lines close it:
      # "id" (the default) those on the same aggregate id, "any" every closing line on the aggregate
      # after it. `evidence` names a read the detail carries: "processes" is the busiest class and its
      # session. `not_about` is a subject prefix never filed for ("stall-").
      value_object "StallKind" do
        attribute :kind,      String
        attribute :aggregate, String
        attribute :opens,     String
        attribute :closes,    String
        attribute :closed_by, String
        attribute :evidence,  String
        attribute :minutes,   Integer
        attribute :forgets,   Integer
        attribute :fixer,     String
        attribute :move,      String
        attribute :ends_aggregate, String
        attribute :ends,           String
        attribute :not_about,      String
        # The reverse of `not_about`: only openings whose id starts with it are timed.
        attribute :only_about,     String
        # Subject ids the row never times, comma separated and matched exactly on the subject
        # (never the branch): a standing run that waits by design and never finishes. It filters
        # only the openings; a closing line still closes the subject as `closes` says.
        attribute :exempt,         String
        # The lifecycle state of the row's aggregate that the row times, which model_check holds
        # it to. A row that times something else, as agent-run-blocked times a session's
        # condition, names none.
        attribute :state,          String
        # A later `settled_by` line on `settled_aggregate` (same id, `settled_on: "branch"`, or any
        # id with `settled_on: "any"`) settles the subject: it is not filed, and a filed one is
        # abandoned. A yield never settles a run: the fixer's own move yields it.
        attribute :settled_aggregate, String
        attribute :settled_by,        String
        attribute :settled_on,        String
        # A read the adapter makes at look time that settles a subject the tap cannot, as
        # `settled_by` does: "boarded-on-origin", the commit the opening line links as `boarded`
        # is on origin/main (a merge the tap never recorded). The adapter refuses any other value.
        attribute :settled_read,      String
        # How the stall is cleared, one path each: "item" (or empty) by its stall item, which a look
        # files and the row's move fixes; "help" by a call for help (`HelpWanted`), for a block that
        # needs judgment, which a look only lists. The adapter refuses any other value.
        attribute :cleared_by,        String
        # "kind" lists every open line of the row as one impediment, the oldest line's, with how
        # many lines it stands for; empty lists one per subject.
        attribute :folds,             String
        # Rows of one `shares` group file one stall per subject: the first declared past its minutes
        # files, and no sibling files while it stands filed and open, so its fixer owns the subject.
        # The Watching adapter applies the rule.
        attribute :shares,            String
        # The most stalls a `shares` group holds open at once (filed, not abandoned, their work item
        # not settled): past it a ready line waits for a look after one settles. Empty or 0 is no cap.
        attribute :cap,               Integer
        # A run started to answer a question: an `answers_by` line on `answers_aggregate` names the
        # run that asks, and the answering run's own line links it as its `work`. Its block is never
        # filed, so a helper's block starts no helper; the asking run's own stall still files.
        attribute :answers_aggregate, String
        attribute :answers_by,        String
        # The aggregate whose lines carry a run's work item. A run whose own lines link no work and
        # that no such line names is labelled unnamed in its detail, so it can be told and reaped.
        attribute :named_aggregate,   String

        member kind: "plan-review", not_about: "stall-", aggregate: "Agents::PlanReview", opens: "PlanReviewRequested",
               closes: "PlanReviewed,PlanReviewRecorded,ReviewUnstarted", minutes: 20, forgets: 1440, fixer: "orchestrator",
               ends_aggregate: "Hecks::AgentRun", ends: "SessionFinished,SessionFailed,AgentRunRetired,AgentTrialRunRetired",
               move: "Read the architect's closing report, record its verdict with PlanReview.answer! " \
                     "(PlanReview.record! when no request row exists), then AgentRun.answer! the waiting coder."
        # A rerun does not close the line; an exhaust or a search does, and any later merge settles it
        # (`TrainPr` records no pass), even an unrelated one. A failed rerun exhausts or is searched
        # under a new key, so this line still files and its move stops.
        member kind: "train-pr-red", aggregate: "Hecks::TrainPr", opens: "TrainPrFailed",
               closes: "TrainPrExhausted,TrainPrSearched", minutes: 30, forgets: 1440, fixer: "orchestrator",
               settled_aggregate: "Hecks::SendTrain", settled_by: "BranchPushed", settled_on: "any",
               move: "The failed jobs were rerun already; read the PR (gh pr view <pr> --json state,statusCheckRollup). " \
                     "If a later attempt was exhausted (a red-train-<pr> work item exists), report that and stop. A PR " \
                     "closed unmerged or red again is Work.plan! red-train-<pr> (category red, priority now) naming the " \
                     "failed specs; when an undone red-train work item already names the same specs from an earlier PR, " \
                     "add this PR to its detail instead: consecutive PRs failing the same specs are one cause."
        # A queued train pull request asks for a chain of ticks keyed by the boarded commit
        # (`TickWhenQueued`); a chain that never beats within 3 minutes has no live worker. A healthy
        # chain's first beat comes about half a minute after it is asked for. Every verdict on the
        # pull request stops the chain (`TickerStopped`), so a closed run is not a stall; a declined
        # start is no worker and stays one. A chain that beats and then dies is not this kind: the
        # line closes on its first beat.
        member kind: "train-pr-unbeaten", aggregate: "Hecks::Ticker", opens: "TickerRequested",
               closes: "Ticked,TickerStopped", minutes: 3, forgets: 1440, fixer: "orchestrator",
               move: "The launchd beat is the pulse (every minute): start none, since a second is refused while one " \
                     "runs, and read when it last ran from the mtime of ~/.claude/hecks-dev/train-beat.log. Then " \
                     "Integration.advance! confirm=true, so the pushed run is observed; then read the chain's log (~/.claude/hecks-dev/ticker/<commit>.log) and " \
                     "report a declined or ended chain as the cause."
        # A train pull request whose CI never started: `TrainPrCi.Await` records it only once its
        # bound has passed (deliver.bluebook), so it is a stall as soon as a look sees it.
        member kind: "ci-not-started", aggregate: "Hecks::TrainPrCi", opens: "TrainPrCiAwaited",
               closes: "TrainPrCiStarted", minutes: 0, forgets: 1440, fixer: "orchestrator",
               move: "Read githubstatus.com for GitHub Actions, and the PR's checks with SendTrain.watch! to=<boarding> (gh pr view <pr> --json statusCheckRollup). " \
                     "The pipeline closes and reopens it once after 20 minutes (TrainPrReopen); if CI still has not " \
                     "started once Actions is up, read when the launchd beat last ran from the mtime of ~/.claude/hecks-dev/train-beat.log (start no beat), then close and reopen it by hand (gh pr close, gh pr reopen). Turning auto-merge back on merges main, so it is not yours: " \
                     "Work.plan! one work item for a coder naming the pull request."
        # The four AgentRun rows end on the run's last lines: `closes` clears a line before it is
        # filed, and `ends` abandons a filed stall whose run was tidied or retired after it opened,
        # even when a closing line came first, so its Work item is not started on a run that is gone.
        member kind: "agent-run-start", shares: "agent-run", cap: 3, answers_aggregate: "Hecks::Question", answers_by: "QuestionSeated",
               named_aggregate: "Tickets::Work", not_about: "stall-", aggregate: "Hecks::AgentRun", state: "requested", opens: "AgentRunRequested",
               ends_aggregate: "Hecks::AgentRun", ends: "AgentRunTidied,AgentRunRetired,AgentTrialRunRetired",
               settled_aggregate: "Tickets::Work", settled_by: "WorkFinished,WorkDropped,WorkLapsed",
               closes: "AgentRunStarted,AgentRunDeclined", minutes: 10, forgets: 1440, fixer: "orchestrator",
               move: "Work.yield! the run's Work item (AgentRun.running names it) with the reason, " \
                     "so the fill restarts it once."
        # The standing seat (`orchestrator-seat`, the run `StartTheStandingSeatWhenWoken` in
        # delegate.bluebook starts) ends each turn waiting and never finishes, so it is exempt.
        member kind: "agent-run-session", shares: "agent-run", cap: 3, answers_aggregate: "Hecks::Question", answers_by: "QuestionSeated",
               named_aggregate: "Tickets::Work", not_about: "stall-", exempt: "orchestrator-seat",
               aggregate: "Hecks::AgentRun", state: "started", opens: "AgentRunStarted",
               ends_aggregate: "Hecks::AgentRun", ends: "AgentRunTidied,AgentRunRetired,AgentTrialRunRetired",
               settled_aggregate: "Tickets::Work", settled_by: "WorkFinished,WorkDropped,WorkLapsed",
               closes: "SessionFinished,SessionFailed,AgentRunRetired,AgentTrialRunRetired", minutes: 240,
               forgets: 1440, fixer: "orchestrator",
               move: "AgentRun.check! the run; if it is unchanged AgentRun.answer! it asking for status once; " \
                     "then Work.yield! the run's Work item (AgentRun.running names it) with the reason."
        # A verdict's resume was refused while the coder waits on it. Each sweep sends it again up to
        # three times and then finishes the run, which closes this line, so a line open for ten minutes
        # means the sweep or its retry chain is broken: the dead run still holds its Work item's area.
        member kind: "agent-run-unresumed", shares: "agent-run", cap: 3, answers_aggregate: "Hecks::Question", answers_by: "QuestionSeated",
               named_aggregate: "Tickets::Work", not_about: "stall-", aggregate: "Hecks::AgentRun", opens: "AgentRunUnresumed",
               ends_aggregate: "Hecks::AgentRun", ends: "AgentRunTidied,AgentRunRetired,AgentTrialRunRetired",
               settled_aggregate: "Tickets::Work", settled_by: "WorkFinished,WorkDropped,WorkLapsed",
               closes: "AgentRunAnswered,SessionFinished,SessionFailed,AgentRunRetired,AgentTrialRunRetired",
               minutes: 10, forgets: 1440, fixer: "orchestrator",
               move: "The sweep already sends the verdict again and then ends the run, so a stall here means the " \
                     "sweep or its retry chain is broken: report that as the finding. AgentRun.check! the run, then " \
                     "Work.yield! the run's Work item (AgentRun.running names it) with the reason, so its area claim is freed."
        # A verdict no coder run could take: tidied, retired or never started (`AnswerRefused`), or
        # finished (`AgentRunUnreached`). It is settled undeliverable, so no retry follows; the stall
        # files at once, so the orchestrator restarts the Work item with its review.
        member kind: "agent-run-answer-refused", not_about: "stall-", aggregate: "Hecks::AgentRun", opens: "AnswerRefused",
               settled_aggregate: "Tickets::Work", settled_by: "WorkFinished,WorkDropped,WorkLapsed",
               closes: "AgentRunStarted,AgentRunAnswered", minutes: 0, forgets: 1440, fixer: "orchestrator",
               move: "Work.yield! the run's Work item (AgentRun.running names it) with the refusal on the event, so the " \
                     "fill restarts it with the review in its brief."
        member kind: "agent-run-unreached", not_about: "stall-", aggregate: "Hecks::AgentRun", opens: "AgentRunUnreached",
               settled_aggregate: "Tickets::Work", settled_by: "WorkFinished,WorkDropped,WorkLapsed",
               closes: "AgentRunStarted,AgentRunAnswered", minutes: 0, forgets: 1440, fixer: "orchestrator",
               move: "Work.yield! the run's Work item (AgentRun.running names it) with the refusal on the event, so the " \
                     "fill restarts it with the review in its brief."
        # A blocked run tidied afterwards (a reviewer whose worktree went at its landing) waits on
        # nothing: its `ends` abandons a filed stall and a look files none, so the move plans no item.
        member kind: "agent-run-blocked", shares: "agent-run", cap: 3, answers_aggregate: "Hecks::Question", answers_by: "QuestionSeated",
               named_aggregate: "Tickets::Work", not_about: "stall-", aggregate: "Hecks::AgentRun", opens: "SessionBlocked",
               ends_aggregate: "Hecks::AgentRun", ends: "AgentRunTidied,AgentRunRetired,AgentTrialRunRetired",
               settled_aggregate: "Tickets::Work", settled_by: "WorkFinished,WorkDropped,WorkLapsed",
               closes: "AnswerRequested,AgentRunAnswered,SessionWorking,SessionFinished,SessionFailed,AgentRunRetired,AgentTrialRunRetired",
               minutes: 15, forgets: 1440, fixer: "orchestrator",
               move: "First AgentRun.check! the run: a run whose status is finished or tidied, or whose condition is " \
                     "stopped, and that asks no question waits on nothing. Plan no work item and make no AgentRun.retire! " \
                     "(refused once tidied): the watch abandons this stall when the run is tidied. Otherwise " \
                     "AgentRun.answer! the [confirm] or [retry] question it waits on, and confirm the board did. " \
                     "For a [choose] question answer it with AgentRun.answer! when the answer follows from the brief, " \
                     "the Work item's area or an architect verdict (a wrong area: Work.rescope!, then answer); " \
                     "otherwise Work.plan! a work item titled 'needs an answer: <run>' with the question text as its detail " \
                     "(the orchestrator holds Work.*; it needs no other permission). Never ask the owner."
        # A session that failed whose Work item nothing has moved since: not started, yielded,
        # released, refused, finished, dropped or lapsed. Dispatch.Settle moves most of them.
        member kind: "agent-run-failed", not_about: "stall-", aggregate: "Hecks::AgentRun", opens: "SessionFailed",
               ends_aggregate: "Hecks::AgentRun", ends: "AgentRunTidied,AgentRunRetired,AgentTrialRunRetired",
               settled_aggregate: "Tickets::Work",
               settled_by: "WorkStarted,WorkYielded,WorkReleased,WorkRefused,WorkFinished,WorkDropped,WorkLapsed",
               closes: "AgentRunStarted,AgentRunRetired,AgentTrialRunRetired", minutes: 0, forgets: 1440,
               fixer: "orchestrator", cleared_by: "help",
               move: "Read the run's last report (AgentRun.check!), then Work.yield! its Work item with the " \
                     "failure as the reason, so the fill starts it again."
        # Main held for a boarding ten minutes on and not released. One marker holds main, so any
        # later release settles it; a hold nobody lifts expires at the world's boarding_hold window
        # (20 minutes), after which it is history.
        member kind: "held-lock", aggregate: "Hecks::BoardingHold", opens: "BoardingHoldSettled",
               settled_aggregate: "Hecks::BoardingRelease", settled_by: "BoardingReleaseSettled", settled_on: "any",
               minutes: 10, forgets: 20, fixer: "orchestrator", cleared_by: "help",
               move: "Read send_train.status and the train's log: a rehearsal still running is only slow, so leave it. " \
                     "With none, the hold expires at the boarding_hold window by itself; Work.plan! a work item naming " \
                     "the hold's run and what took it, so the cause is fixed."
        # A failed Codebase run's finding (`Finding.ReportFailedRun`, one per cause or per run that
        # named none) whose Work item is undone. The tap carries no cause, so the row folds every
        # open one into one impediment; ReportWhenGateFaulted already plans each Work item.
        member kind: "codebase-check-failed", aggregate: "Tickets::Finding", opens: "RunFindingReported",
               closes: "FindingResolved,FindingDismissed", settled_aggregate: "Tickets::Work",
               settled_by: "WorkFinished,WorkDropped,WorkLapsed", minutes: 0, forgets: 10080,
               fixer: "orchestrator", cleared_by: "help", folds: "kind",
               move: "Read the open findings titled 'A Codebase check failed' (Work.undone): a cause a later green " \
                     "gate cleared is Work.drop!ped with that run as the reason; the rest are one red-* work item."
        # A boarding begun ten minutes ago and not pushed, refused or superseded. `Board` moves no
        # state, so the row times the boarding and names none. The subject is the boarding's run,
        # so another run's push never closes it and a new boarding files again.
        member kind: "stale-boarding", aggregate: "Hecks::Integration", opens: "MainBoardingStarted",
               closes: "MainPushed,MainPushRefused,IntegrationSuperseded", minutes: 10, forgets: 1440, fixer: "orchestrator",
               move: "Read the boarding (exe/hecks send_train.status, Integration.advance! confirm=true) and the train's " \
                     "log; a held lock or a dead push is reported as the cause, and the boarding is boarded again once."
        # A volume at high past half an hour is a stall, once per volume, ever: the DiskSpace
        # `Volume` it opens on rises once. The orchestrator it wakes frees space with its own verbs:
        # it retires merged worktrees and tidies done runs, as the pruner's relief does.
        member kind: "disk", aggregate: "Hecks::Volume", state: "high", opens: "VolumeRose", closes: "VolumeEased",
               minutes: 30, forgets: 10080, fixer: "orchestrator",
               move: "Free space: Landing.retire! branch.value=<branch> --confirm each worktree whose work is on main " \
                     "(git worktree list, git branch --merged main), and AgentRun.tidy! to=<run> each run whose " \
                     "session ended done (AgentRun.running names the rest); report unpushed, dirty and pinned " \
                     "subjects by path, never remove them."
        # The machine's load over its mark for five minutes, keyed by the beat that heard each crossing.
        # Only the beat's readings (`launchd-`) are the fleet's load: a gate step's `<sha>-<step>`
        # reading is never followed by a fall under its key, so it opens no stall.
        member kind: "load", only_about: "launchd-", aggregate: "Hecks::Machine", opens: "LoadRoseAbove", closes: "LoadFellBelow",
               closed_by: "any", evidence: "processes", minutes: 5, forgets: 1440, fixer: "orchestrator",
               move: "The rise itself already asked the lowest-priority started item to yield (Shed.ShedAsked, " \
                     "or ShedSpared with the reason): do not ask that run again. " \
                     "The detail names the busiest process class and the session whose shell owns it " \
                     "(Machine.busiest reads every class again); AgentRun.running names that session's started run. " \
                     "AgentRun.answer! that run naming the processes and asking it to end the processes its " \
                     "commands start and to bound how many it starts. Never kill a pid. If no pipeline " \
                     "session owns them, Work.plan! a work item with the process list as its detail and leave it to the owner."
        # A pressure beat left looked: its copy was refused clearance, so nothing was published.
        # A refusal writes no line; a later beat published or faulted closes the row.
        member kind: "beat-uncleared", only_about: "launchd-", aggregate: "Signalbox::Beat", opens: "BeatRecorded",
               closes: "BeatPublished,BeatFaulted", closed_by: "any", state: "looked", folds: "kind",
               minutes: 5, forgets: 1440, fixer: "orchestrator",
               move: "Read the beat log (~/.claude/hecks-dev/train-beat.log) for the refused given of Clearance.Grant: " \
                     "a head behind main means the train copy did not follow (the beat job's follow step); " \
                     "'every local file the main checkout has' means a *.local.world or *.local.hecksagon differs " \
                     "from the main checkout's (the beat job's copy step). Bring the copy to local main and copy the files, " \
                     "then the next beat clears; Work.plan! a work item when the beat job itself does not run them."
        # A landing job (`Landing.Carry`) neither landed nor refused in ten minutes: a quick gate takes a few.
        # The tap holds no process data, so the move names the check. `Landing.Finish` is not timed: it has
        # no closing line when it refuses before its merge.
        member kind: "landing-carry", not_about: "stall-", aggregate: "Delivery::Landing", opens: "CarryRequested",
               closes: "BranchLanded,LandingRefused", minutes: 30, forgets: 1440, fixer: "orchestrator",
               settled_aggregate: "Delivery::Landing", settled_by: "BranchLanded,LandingRefused", settled_on: "branch",
               move: "Read .git/hecks-landings/<branch>.log and look for a gate process (ps) of that branch's worktree: " \
                     "a gate still running or output still growing is only slow, so leave it. " \
                     "A gate may be queued, not slow: landing gates take turns (the Tickets world's heavy_jobs cap), and " \
                     "the files heavy-jobs/slot-N.lock under the cache directory name each holder (job and pid). A queued " \
                     "gate is only waiting for up to 1800 s, after which it runs anyway. The log is written when the carry " \
                     "ends, so it holds no line about the queue; read ps and the slot files instead. With neither,the job has " \
                     "stopped: Work.release! its item so the fill hands the branch to a coder to submit again, and report the log's last line as the cause."
        # A handed landing whose job never reached `Landing.Carry`. Carry has a run of its own, so any later
        # closing line closes this one (`any`): the next landing hides a dropped handoff, which is accepted.
        # The carry starts within seconds and its retries come after it, so ten minutes is ample.
        member kind: "landing-handed", not_about: "stall-", aggregate: "Delivery::Landing", opens: "LandingSubmitted",
               closes: "CarryRequested,BranchLanded,LandingRefused", closed_by: "any", minutes: 10, forgets: 1440,
               settled_aggregate: "Delivery::Landing", settled_by: "BranchLanded,LandingRefused", settled_on: "branch",
               fixer: "orchestrator",
               move: "This landing was handed to a job that never began its carry. The log is written when a carry " \
                     "ends, so a missing .git/hecks-landings/<branch>.log is expected and proves nothing: look for a " \
                     "launcher process (ps) of that branch's worktree. A running one is only slow, so leave it. With none, " \
                     "the job has died: Work.release! its item so the fill hands the branch to a coder to submit again."
        # A boarding that could not push: a refused push and failed checks both record `PushFaulted`.
        # The move reads whether a later boarding, which has a run of its own, already pushed.
        member kind: "train-faulted", aggregate: "Hecks::SendTrain", state: "faulted", opens: "PushFaulted",
               closes: "BranchPushed", minutes: 0, forgets: 1440, fixer: "orchestrator",
               move: "Read SendTrain.outcome for the boarding's refusal, and RedFlag.status. If a later boarding " \
                     "already pushed the commit (BranchPushed), report that and stop. Otherwise fix the cause the " \
                     "refusal names and board again (SendTrain.board! --confirm); never use --no-verify or HECKS_OWNER_PUSH."
        # A queued boarding whose pull request has not merged in 45 minutes: its checks are slow or stuck.
        # Failed checks close it (`train-checks-failed` takes over); a merge, a close unmerged or its
        # boarded commit on origin/main settles it, so a filed stall is abandoned and its session told to stop.
        member kind: "train-unmerged", aggregate: "Hecks::SendTrain", state: "queued", opens: "BoardingQueued",
               closes: "BranchPushed,TrainChecksFailed,PushFaulted,BoardingClosed", minutes: 45, forgets: 1440, fixer: "orchestrator",
               settled_aggregate: "Hecks::SendTrain", settled_by: "BranchPushed,BoardingClosed",
               settled_read: "boarded-on-origin",
               move: "Read the train pull request with SendTrain.watch! to=<boarding> (gh pr view <pr> --json mergeStateStatus,statusCheckRollup): " \
                     "BLOCKED on pending checks is only slow, so leave it; CLEAN without a merge means auto-merge " \
                     "is off: turning it on merges main, so Work.plan! one work item for a coder naming the pull request. The launchd beat records a merge GitHub made: start none, and read when it last ran from the mtime of ~/.claude/hecks-dev/train-beat.log."
        # A queued boarding's required checks ended red; its pull request stays open and a merge closes it.
        # A merge or a close settles the boarding, so a filed stall is abandoned and its session told to stop.
        member kind: "train-checks-failed", aggregate: "Hecks::SendTrain", state: "red", opens: "TrainChecksFailed",
               closes: "BranchPushed,BoardingClosed", minutes: 0, forgets: 1440, fixer: "orchestrator",
               settled_aggregate: "Hecks::SendTrain", settled_by: "BranchPushed,BoardingClosed",
               move: "The report names the failed jobs: read them (gh run view --log-failed). A flaky job is rerun " \
                     "once (gh run rerun --failed); a real failure is Work.plan! as a red-* work item with the " \
                     "failed jobs as its detail."
        # The pipeline patterns the scrum master wakes on, each cleared by a call for help. A beat
        # declined ("already running") with no beat taken since for ten minutes is a stuck tick;
        # any later `Beaten` closes it.
        member kind: "beat-declined", aggregate: "Hecks::Heartbeat", opens: "BeatDeclined", closes: "Beaten",
               closed_by: "any", folds: "kind", minutes: 10, forgets: 1440, fixer: "orchestrator", cleared_by: "help",
               move: "The beat has been declined for ten minutes with none taken since: a tick is stuck. Read the beat log " \
                     "(~/.claude/hecks-dev/train-beat.log) and the process that holds the beat; Work.plan! a " \
                     "work item naming the cause, and never signal a process group or a pid of 1 or less."
        # Every landing refused and none landed for thirty minutes: one refusal gate (main's quick
        # gate red) or a stalled seat holds them all. Any later `BranchLanded` closes it.
        member kind: "landings-refused", aggregate: "Delivery::Landing", opens: "LandingRefused", closes: "BranchLanded",
               closed_by: "any", folds: "kind", minutes: 30, forgets: 1440, fixer: "orchestrator", cleared_by: "help",
               move: "Landings were refused and none landed since. Read each refusal's gate subject " \
                     "(.git/hecks-landings/<branch>.log) and RedFlag.status: refusals that share one subject " \
                     "mean main is red: Work.plan! one red-* work item naming that subject (the landing coders do not fix it)."
      end

      # An impediment `Impediments` computes at look time and never files, one row each. `read` is
      # what the adapter reads: "shared-files", the file names two open branches both changed. A
      # branch is open while its work item's latest line on `aggregate` is `opens`, not a `closes`.
      value_object "ComputedSignal" do
        attribute :kind,      String
        attribute :read,      String
        attribute :aggregate, String
        attribute :opens,     String
        attribute :closes,    String
        attribute :fixer,     String
        attribute :move,      String
        # How it is cleared, as `StallKind.cleared_by` says it: "help", since no look files it.
        attribute :cleared_by, String
        # What a read counts or times, by name: `minutes` the age it must reach (the window of a rate),
        # `limit` the count a leftover may reach (the percent of the three-hour rate a landing rate
        # may fall to), `pattern` the text a held start's reason holds or the leftover it counts,
        # and `ends_aggregate` and `ends` the lines that end a run or restart a count.
        attribute :minutes,        Integer
        attribute :limit,          Integer
        attribute :pattern,        String
        attribute :ends_aggregate, String
        attribute :ends,           String

        member kind: "branches-share-files", read: "shared-files", aggregate: "Tickets::Work", opens: "WorkStarted",
               closes: "WorkFinished,WorkYielded,WorkReleased,WorkRefused,WorkDropped,WorkLapsed", fixer: "orchestrator",
               cleared_by: "help",
               move: "Two started work items edit the same files, so the later landing meets a conflict. " \
                     "AgentRun.answer! each run naming the other work item and the shared files, so the two agree " \
                     "who lands first and the other rebases; when one must wait, Work.wait_on! it on the other."

        # Starts held while the machine could take them: `FillStalled` stands (no `FillStallCleared`
        # since), its reason names the hold, and the 1-minute load is under the low mark, counted from
        # the later of the stall and the load's last fall. The reason is the tap's `reason` link.
        member kind: "starts-held-by-load", read: "held-starts", aggregate: "Hecks::FillStall", opens: "FillStalled",
               closes: "FillStallCleared", pattern: "load pause", minutes: 10, ends_aggregate: "Hecks::Machine",
               ends: "LoadFellBelow", fixer: "orchestrator", cleared_by: "help",
               move: "The load pause holds starts although the load is under its low mark. Read Machine.busiest and " \
                     "the machine_marks line of the Tickets world; the pause lifts at Machine.LoadFellBelow, so a " \
                     "fall that never reached the fill means a stuck beat: Work.plan! a work item naming the cause."
        member kind: "starts-held-by-breaker", read: "held-starts", aggregate: "Hecks::FillStall", opens: "FillStalled",
               closes: "FillStallCleared", pattern: "breaker", minutes: 30, ends_aggregate: "Hecks::Machine",
               ends: "LoadFellBelow", fixer: "orchestrator", cleared_by: "help",
               move: "A tripped breaker holds starts although the load is under its low mark. Read Breaker.tripped; " \
                     "a breaker resets once its load is under its rating by the gap, so a breaker that stays open " \
                     "needs its load read again: Work.plan! a work item naming the breaker and its rating."
        # What a clean-up has not removed, each over a count: finished sessions the tap shows no
        # `AgentRunTidied` for, worktrees beside the main checkout, and local branches merged into main.
        member kind: "finished-sessions-standing", read: "leftovers", pattern: "finished-sessions", limit: 15,
               fixer: "orchestrator", cleared_by: "help",
               move: "Finished sessions stand untidied. AgentRun.tidyable names them; AgentRun.tidy! each whose " \
                     "commits are on origin, and report the refusals."
        member kind: "worktrees-standing", read: "leftovers", pattern: "worktrees", limit: 20,
               fixer: "orchestrator", cleared_by: "help",
               move: "Worktrees stand beside the main checkout. git worktree list names them; Landing.retire! each " \
                     "whose work is on main, and report the dirty ones by path."
        member kind: "merged-branches-standing", read: "leftovers", pattern: "merged-branches", limit: 20,
               fixer: "orchestrator", cleared_by: "help",
               move: "Local branches stand merged into main. git branch --merged main names them; Landing.retire! " \
                     "each, and report the ones a worktree holds."
        # A plan review whose architect run finished with no verdict: the coder that asked waits for ever.
        # The plan-review stall row drops such a review (its run ended), so this view row carries it.
        member kind: "plan-review-unrecorded", read: "run-finished", aggregate: "Agents::PlanReview",
               opens: "PlanReviewRequested", closes: "PlanReviewed,PlanReviewRecorded,ReviewUnstarted",
               ends_aggregate: "Hecks::AgentRun", ends: "SessionFinished,SessionFailed,AgentRunRetired,AgentTrialRunRetired",
               minutes: 5, fixer: "orchestrator", cleared_by: "help",
               move: "The architect's run finished and no verdict was recorded. Read its closing report, record the " \
                     "verdict with PlanReview.answer! (PlanReview.record! when no request row exists), then " \
                     "AgentRun.answer! the waiting coder."
        # Landings in the last hour under `limit` percent of the three-hour hourly rate.
        member kind: "landing-rate-low", read: "landing-rate", aggregate: "Delivery::Landing", opens: "BranchLanded",
               minutes: 60, limit: 50, fixer: "orchestrator", cleared_by: "help",
               move: "Landings slowed to under half the three-hour rate. Read Landing.refused, Dispatch.preview and " \
                     "the pipeline board for what holds the work: refusals, held starts, waiting reviews."
      end

      # One opening line still waiting for its closing line, as the tap shows it and its kind's row
      # prices it: the facts `Stall.File` judges. `id` is the look that found it.
      value_object "Sighting" do
        attribute :id,         String
        attribute :stall,      String
        attribute :stall_kind, String
        attribute :subject,    String
        attribute :opened_at,  String
        attribute :waited,     Integer
        attribute :minutes,    Integer
        attribute :forgets,    Integer
        attribute :fixer,      String
        attribute :title,      String
        attribute :detail,     String
        # The stall key a look filed for the line, empty when none was; and, for an impediment,
        # how many lines it stands for (one unless its row folds).
        attribute :filed,      String
        attribute :count,      Integer
        # What an impediment stands for, the same over every look: its stall key, or
        # `stall-<kind>` for a row that folds, whose oldest line changes as lines close.
        attribute :impediment, String
        # How its row says the stall is cleared: "item" by its stall item, "help" by a call for help.
        attribute :cleared_by, String
      end

      command "Detect" do
        role "System"
        goal "Look at the event tap for opening events whose closing event has not come"

        attribute :run, RunKey, sets: true

        emits StallDetectRequested
      end

      # A filed stall, its line closed or not, whose run ended (the kind's `ends` lines on the same
      # id) or whose subject settled (its `settled_by` lines) since it opened: no fixer is needed,
      # so it is closed with the reason.
      value_object "Abandoned" do
        attribute :id,      String
        attribute :stall,   String
        attribute :subject, String
        attribute :reason,  String
      end

      query "Unclosed" do
        description "The opening lines of every stall kind whose closing line has not come, within the kind's window, with how long each has waited. A line the tap shows filed already, whose run has ended or whose subject has settled since it opened, is left out: it is handled once and a later look emits nothing for it. Read-only: it reads the tap and boots nothing."
        attribute :run, String
        returns list_of(Sighting)
      end

      # The impediments: what holds work up now, oldest first. `subject` is the source record,
      # `waited` its age in minutes, `fixer` its owner and `detail` the help it needs.
      query "Impediments" do
        description "Every opening line of every stall kind still open past its kind's minutes and within its window, filed or not: its run not ended, its subject not settled, its closing line not come. One per subject, or one per kind for a row that folds, with how many lines it stands for; and one per pair of open branches that changed the same files against main, naming the files, until either branch's tip moves; oldest first. Read-only: it reads the tap and the branches' file names, and boots nothing."
        attribute :run, String
        returns list_of(Sighting)
      end

      # An open call for help whose impediment a look no longer holds: it is closed with the
      # reason, whatever its helper reported.
      value_object "Relieved" do
        attribute :id,     String
        attribute :help,   String
        attribute :reason, String
      end

      query "Relieved" do
        description "The calls for help the tap shows raised and not closed since, whose impediment is no longer among the impediments or is one its stall item clears, each with that as its reason. Read-only: it reads the tap and boots nothing."
        attribute :run, String
        returns list_of(Relieved)
      end

      # The impediments a call for help clears that nobody has met: no call for help stands for
      # one and no run of the scrum master was ever started for it, so a wake that failed is not
      # repeated on every beat. The scrum master's wake reads it.
      query "Unraised" do
        description "The impediments cleared by a call for help whose call is not open and for which no run was ever started under its key, oldest first, each as the view holds it. Read-only: it reads the tap and boots nothing."
        attribute :run, String
        returns list_of(Sighting)
      end

      query "Abandoned" do
        description "The filed stalls, opened within their kind's window, whose run has ended or whose subject has settled since they opened and which no look has closed yet, each with the ending or settling line as its reason; a filed stall whose line has closed is one too. Read-only: it reads the tap and boots nothing."
        attribute :run, String
        returns list_of(Abandoned)
      end
    end

    # One stall, filed once: `stall-<kind>-<subject>`. Its key is the dedupe (a later look, or one after
    # a restart, finds it filed on the tap) and keys the orchestrator run its wake starts, which plans
    # a Work item, citing the key, only when the fix needs code.
    aggregate "Stall" do
      description "One stall: an opening event whose closing event did not come within its kind's minutes, and the role that fixes it."
      created_by "Stall.file!"

      attribute :stall,     StallKey
      attribute :kind,      Word
      attribute :subject,   Word
      attribute :opened_at, Word
      attribute :waited,    Minutes
      attribute :minutes,   Minutes
      attribute :forgets,   Minutes
      attribute :fixer,     Fixer
      attribute :title,     Line
      attribute :detail,    Line
      attribute :reason,    Line, optional: true
      reference_to StallWatch, as: :watch
      identified_by :stall

      value_object "StallKey" do
        attribute :value, String, pattern: '\Astall-[a-z0-9-]+-[A-Za-z0-9._-]+\z'
      end

      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Line" do
        attribute :value, String, matches: :present
      end

      value_object "Minutes" do
        attribute :value, Integer

        invariant("minutes are not negative") { !value.negative? }
      end

      # The role that settles a stall: one of the pipeline's agent roles. Every row names the
      # orchestrator, whose run a filed stall wakes; no stall is ever a Work item, and no row now
      # names another role (`pruner` is unused).
      value_object "Fixer" do
        attribute :value, String, one_of: %w[orchestrator coder architect planner reviewer pruner]
      end

      command "File" do
        role "System"
        goal "File a stall once: an opening event left open past its kind's minutes, for the role that fixes it"

        reference_to StallWatch, as: :watch
        attribute :stall,     StallKey, sets: true
        attribute :kind,      Word, sets: true
        attribute :subject,   Word, sets: true
        attribute :opened_at, Word, sets: true
        attribute :waited,    Minutes, sets: true
        attribute :minutes,   Minutes, sets: true
        attribute :forgets,   Minutes, sets: true
        attribute :fixer,     Fixer, sets: true
        attribute :title,     Line, sets: true
        attribute :detail,    Line, sets: true

        sets :watch

        given("a stall is not about a stall item") { !subject.value.start_with?("stall-") }
        given("a stall has waited past its kind's minutes") { waited.value >= minutes.value }
        given("a stall is younger than its kind's window") { waited.value < forgets.value }

        emits StallFiled
      end

      # A stall whose run ended or whose subject settled needs no fixer: it is closed here, once,
      # with the reason, and its orchestrator run is told to end. Like
      # `File` it creates the record by its key, so a look in a fresh process can name it.
      command "Abandon" do
        role "System"
        goal "Close a stall whose run has ended or whose subject has settled, because no fixer is needed"

        reference_to StallWatch, as: :watch
        attribute :stall,  StallKey, sets: true
        attribute :reason, Line, sets: true

        sets :watch

        emits StallAbandoned
      end
    end

    # One call to the scrum master for one impediment, keyed by the impediment: the evidence its run
    # is briefed with. Nothing else is kept; the call for help is the scrum master's to raise.
    aggregate "ScrumWake" do
      description "One call to the scrum master for one impediment a call for help clears, keyed by the impediment, with the evidence its run is briefed with."
      created_by "ScrumWake.call!"

      attribute :wake,   WakeKey
      attribute :detail, Line
      reference_to StallWatch, as: :watch
      identified_by :wake

      value_object "WakeKey" do
        attribute :value, String, pattern: '\Astall-[a-z0-9-]+-[A-Za-z0-9._-]+\z'
      end

      value_object "Line" do
        attribute :value, String, matches: :present
      end

      command "Call" do
        role "System"
        goal "Call the scrum master for one impediment, once"

        reference_to StallWatch, as: :watch
        attribute :wake,   WakeKey, sets: true
        attribute :detail, Line, sets: true

        sets :watch

        emits ScrumMasterCalled
      end
    end

    # Its key is the bound of ADR 0219, decision 10: one call per impediment, and a closed one
    # frees its key. No command records a helper's report, so a finished helper leaves it aging.
    aggregate "HelpWanted" do
      description "One call for help with one impediment, keyed `help-<impediment>`: when the block opened, what it holds up, the help it needs and the role that fits, and the helper the Lead assigned. A second call for an impediment whose call stands is refused by name, and so is a call for a stall its stall item clears; only a look that does not hold the impediment closes it."
      created_by "HelpWanted.raise!"

      # The impediment it is for, as `help-` and that impediment's key in the view: one fact, so
      # the call and its impediment cannot name different blocks.
      attribute :help,       HelpKey
      attribute :opened_at,  Word
      attribute :waited,     Minutes
      attribute :holds_up,   Line
      attribute :kind,       HelpKindName
      attribute :needs,      Line
      attribute :role,       HelperRole
      attribute :helper,     Word, optional: true
      attribute :how,        Way, optional: true
      attribute :reason,     Line, optional: true
      # The look that closed it.
      reference_to StallWatch, as: :watch, optional: true
      identified_by :help

      value_object "HelpKey" do
        attribute :value, String, pattern: '\Ahelp-stall-[A-Za-z0-9._-]+\z'
      end

      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Line" do
        attribute :value, String, matches: :present
      end

      # The block's age in minutes when help was asked; its age now is read from `opened_at`.
      value_object "Minutes" do
        attribute :value, Integer

        invariant("minutes are not negative") { !value.negative? }
      end

      # One kind of help, one row each: the role that fits it and what a helper of that kind
      # does. A record names its kind and says in `needs` what this block wants of it.
      value_object "HelpKind" do
        attribute :kind,  String
        attribute :role,  String
        attribute :needs, String

        member kind: "rebase", role: "coder",
               needs: "Rebase the branch onto main, run its specs and submit it again."
        member kind: "owner-answer", role: "owner",
               needs: "An answer only the owner can give: it is asked on the board, never assigned."
        member kind: "release-dead-holder", role: "orchestrator",
               needs: "Release what the holder holds, once the holder is confirmed dead."
        member kind: "settle-block", role: "orchestrator",
               needs: "Read the evidence the call carries and settle the block, or plan the work item that does."
      end

      value_object "HelpKindName" do
        attribute :value, String, one_of: %w[rebase owner-answer release-dead-holder settle-block]
      end

      # The role that fits the help: one of the pipeline's agent roles, or the owner.
      value_object "HelperRole" do
        attribute :value, String, one_of: %w[orchestrator coder architect planner reviewer owner]
      end

      # How the impediment's row says its stall is cleared, as the impediment view gives it.
      value_object "Clearing" do
        attribute :value, String, one_of: %w[item help]
      end

      # How the Lead assigns: `idle` answers a started run that has room, `dispatch` starts a run.
      value_object "Way" do
        attribute :value, String, one_of: %w[idle dispatch]
      end

      lifecycle :status, default: "open" do
        transition "Assign" => "assigned", from: %w[open assigned]
        transition "Close"  => "closed",   from: %w[open assigned]
        mark :terminal, "closed"
        mark :reusable, "closed"
      end

      command "Raise" do
        role "System"
        goal "Ask for help with one impediment, once while the call stands"

        attribute :help,       HelpKey, sets: true
        attribute :opened_at,  Word, sets: true
        attribute :waited,     Minutes, sets: true
        attribute :holds_up,   Line, sets: true
        attribute :kind,       HelpKindName, sets: true
        attribute :needs,      Line, sets: true
        attribute :role,       HelperRole, sets: true
        # The impediment's `cleared_by` in the view: the call says which path its stall has.
        attribute :cleared_by, Clearing

        given("a stall its stall item clears gets no call for help") { cleared_by.value == "help" }

        emits HelpWantedRaised
      end

      # Assigning again, after a helper finished with the block still in the view, names the
      # next helper; a dispatch then starts a new run under the same key.
      command "Assign" do
        role "Operator"
        goal "Give a call for help to an idle run or to a new run of the role that fits"

        reference_to HelpWanted
        attribute :helper, Word, sets: true
        attribute :how,    Way, sets: true

        given("the owner's help is asked on the board, never assigned") { role.value != "owner" }

        emits HelpWantedAssigned
      end

      # What the call needs and the role that fits, said beside the helper the Lead named, so the
      # reaction that reaches the helper reads them from the event. It changes nothing.
      command "Brief" do
        role "System"
        goal "Say what an assigned call for help needs of its helper"

        reference_to HelpWanted
        attribute :helper, Word
        attribute :how,    Way
        attribute :needs,  Line
        attribute :role,   HelperRole

        emits HelperBriefed
      end

      command "Close" do
        role "System"
        goal "Close a call for help whose impediment has left the view"

        reference_to HelpWanted
        reference_to StallWatch, as: :watch
        attribute :reason, Line, sets: true

        sets :watch

        emits HelpWantedClosed
      end

      query "Open" do
        description "Every call for help not closed, assigned or not, the oldest block first."
        where(status: { ne: "closed" })
        order_by :opened_at
      end

      query "Unassigned" do
        description "Every call for help no helper was assigned to, the oldest block first: what the Lead assigns."
        where(status: "open")
        order_by :opened_at
      end

      # The one call under a key while it is assigned, so the reaction that reaches its helper
      # reads what the call needs and the role that fits from the record.
      query "AssignedOfHelp" do
        description "The call for help under one key, when it is assigned."
        attribute :help, HelpKey
        where(status: "assigned", help: :help)
      end
    end

    # A call for help closes when a look no longer holds its impediment, and only then: no
    # helper's report closes it.
    policy "CloseEveryHelpWantedWhenItsBlockLeavesTheView" do
      on       "StallWatch.StallDetectRequested"
      for_each "StallWatch.Relieved"
      trigger  HelpWanted::Close, with: { watch: :id, help: :help, reason: :reason }
    end

    # An assigned call says what it needs of its helper, read from its own record.
    policy "BriefTheHelperWhenAssigned" do
      on       "HelpWanted.HelpWantedAssigned"
      for_each "HelpWanted.AssignedOfHelp"
      trigger  HelpWanted::Brief, with: { help: :help, helper: :helper, how: :how, needs: :needs, role: :role }
    end

    # Assigned to an idle run, the call is that run's next answer: what the block needs of it.
    # A root, as the dispatch below is: answering or starting a session is a chain of its own.
    policy "AnswerTheIdleHelperWhenBriefed" do
      on      "HelpWanted.HelperBriefed"
      root
      where   { how.value == "idle" }
      trigger AgentRun::Answer, with: { run: :helper, answer: :needs }
    end

    # Assigned to a new dispatch, the call starts one run of its role under the call's own key,
    # so a second dispatch is refused by name while that run stands.
    policy "DispatchAHelperWhenBriefed" do
      on      "HelpWanted.HelperBriefed"
      root
      where   { how.value == "dispatch" }
      trigger AgentRun::Dispatch, with: { run: :help, agent: :role, brief: :needs }
    end

    # A new impediment is called to the scrum master once, keyed by the impediment (a second call for
    # it is refused by name), and the call starts one run of the scrum master under that key. The
    # run raises the call for help with its evidence.
    policy "CallTheScrumMasterForEveryNewImpediment" do
      on       "StallWatch.StallDetectRequested"
      for_each "StallWatch.Unraised"
      trigger  ScrumWake::Call, with: { watch: :id, wake: :impediment, detail: :detail }
    end

    # A root, as the helper's dispatch is: starting a session is a chain of its own.
    policy "WakeTheScrumMasterWhenCalled" do
      on      "ScrumWake.ScrumMasterCalled"
      root
      trigger AgentRun::Dispatch, with: { run: :wake, agent: "scrum-master", brief: :detail }
    end

    # Each beat of the clock looks once, keyed by the beat. A root, so the look starts its own chain.
    policy "DetectOnHeartbeat" do
      on      "Heartbeat.Beaten"
      root
      trigger StallWatch::Detect, with: { run: :beat }
    end

    # Every opening line the look found is offered to `File`; a refusal (not yet past its minutes,
    # already filed) is recorded per line and the rest go on.
    policy "FileEveryStallWhenDetected" do
      on       "StallWatch.StallDetectRequested"
      for_each "StallWatch.Unclosed"
      trigger  Stall::File, with: { watch: :id, stall: :stall, kind: :stall_kind, subject: :subject, opened_at: :opened_at,
                                    waited: :waited, minutes: :minutes, forgets: :forgets, fixer: :fixer,
                                    title: :title, detail: :detail }
    end

    # Every filed stall whose run has ended or whose subject has settled is closed, once: the tap
    # shows it abandoned afterwards.
    policy "AbandonEveryStallWhenDetected" do
      on       "StallWatch.StallDetectRequested"
      for_each "StallWatch.Abandoned"
      trigger  Stall::Abandon, with: { watch: :id, stall: :stall, reason: :reason }
    end

    # An abandoned stall asks its session, the run its wake started under the stall's key, to end
    # its turn; nothing is stopped, and a stall with no started run refuses as `Answer` does. A root,
    # since the abandon already sits several reactions deep.
    policy "EndTheStallSessionWhenAbandoned" do
      on      "Stall.StallAbandoned"
      root
      trigger AgentRun::Answer,
              with: { run: :stall,
                      answer: "The stall you were started for has settled or its run has ended, so the stall " \
                              "watch abandoned it. Make no move for it: commit " \
                              "nothing, start nothing, and end your turn now." }
    end
  end
end
