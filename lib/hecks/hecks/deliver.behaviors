Hecks.behaviors "Deliver" do
  vision "A coder's branch is checked by CI before hand-off, and main, stable, a train and a ci branch are never that branch."

  loads "hecks.bluebook", "context_map.hecksagon", "hecks.hecksagon", "red_wake.hecksagon", "stable_roll.hecksagon", "environments/memory.world", modules: :all

  test "Request refuses main as the coder's branch" do
    tests "Request", on: "EarlyCi"
    input run: { value: "main" }, branch: { value: "main" }, sha: { value: "abc" }, checkout: { value: "/tmp/w" }, clean: { value: true }
    expect refused: "a coder's own branch"
  end

  test "Request refuses stable as the coder's branch" do
    tests "Request", on: "EarlyCi"
    input run: { value: "stable" }, branch: { value: "stable" }, sha: { value: "abc" }, checkout: { value: "/tmp/w" }, clean: { value: true }
    expect refused: "a coder's own branch"
  end

  test "Request refuses a train branch" do
    tests "Request", on: "EarlyCi"
    input run: { value: "train/x" }, branch: { value: "train/x" }, sha: { value: "abc" }, checkout: { value: "/tmp/w" }, clean: { value: true }
    expect refused: "a coder's own branch"
  end

  test "Request refuses a ci branch" do
    tests "Request", on: "EarlyCi"
    input run: { value: "ci/x" }, branch: { value: "ci/x" }, sha: { value: "abc" }, checkout: { value: "/tmp/w" }, clean: { value: true }
    expect refused: "a coder's own branch"
  end

  test "Request asks CI to check a coder's own clean branch" do
    tests "Request", on: "EarlyCi"
    input run: { value: "work-1" }, branch: { value: "work-1" }, sha: { value: "abc" }, checkout: { value: "/tmp/w" }, clean: { value: true }
    expect emits: %w[EarlyCiRequested BranchCiRefused EarlyCiDeclined]
  end
end
