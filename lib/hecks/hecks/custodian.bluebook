Hecks.bluebook "Hecks" do
  # Custodian: operating any domain. Each aggregate here is a concern a client runs against
  # their own domain (ADR 0080, section 2).

  aggregate "Introspection" do
    description "A look at a booted domain, answered by the runtime without changing anything."

    attribute :domain, DomainPath
    identified_by :domain

    value_object "DomainPath" do
      attribute :value, String, pattern: '[^\t\n\r]'

      invariant("a domain is named by its path") { !value.to_s.empty? }
    end

    value_object "ChapterName" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a chapter is named") { !value.to_s.empty? }
    end

    value_object "AggregateName" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("an aggregate is named") { !value.to_s.empty? }
    end

    # Each query below is answered by the DomainRuntime port's adapter: the domain is booted
    # in-process and the answer is the exact text the matching bin script printed.

    query "Ir" do
      description "The IR a domain's boot produces, as JSON: what golden specs pin and an era hashes."
      attribute :domain,       DomainPath, optional: true
      attribute :translations, Boolean,    optional: true
      attribute :meta,         Boolean,    optional: true
      answered_by "DomainRuntime"
    end

    query "Shape" do
      description "The storage shape an era's label is minted from: a bluebook file or a directory of them."
      attribute :domain, DomainPath
      answered_by "DomainRuntime"
    end

    query "Stores" do
      description "Every aggregate's current records: the head, not the journal."
      attribute :domain, DomainPath
      answered_by "DomainRuntime"
    end

    query "History" do
      description "Every journal entry a domain's append-only adapters hold: the whole write history."
      attribute :domain, DomainPath
      answered_by "DomainRuntime"
    end

    query "Statements" do
      description "A chapter's declared facts, as plain English sentences."
      attribute :domain,  DomainPath
      attribute :chapter, ChapterName
      answered_by "DomainRuntime"
    end

    query "Narrate" do
      description "A domain read back in English, whole or for one aggregate."
      attribute :domain,    DomainPath,    optional: true
      attribute :aggregate, AggregateName, optional: true
      answered_by "DomainRuntime"
    end

    query "Docs" do
      description "A domain's usage document, whole or for one aggregate."
      attribute :domain,    DomainPath,    optional: true
      attribute :aggregate, AggregateName, optional: true
      answered_by "DomainRuntime"
    end

    query "ProjectDiagrams" do
      description "A chapter's Mermaid diagrams, as file names mapped to their text; nothing is written."
      attribute :domain,  DomainPath
      attribute :chapter, ChapterName
      answered_by "DomainRuntime"
    end

    query "Glossary" do
      description "A chapter's Ubiquitous Language glossary, as file names mapped to their text; nothing is written."
      attribute :domain,  DomainPath
      attribute :chapter, ChapterName
      answered_by "DomainRuntime"
    end
  end

  # A journaled command whose work happens outside the runtime (ADR 0080, section 11). Every
  # command below that runs something follows this one shape, so later aggregates copy it:
  #
  #   1. A creating command records the request as a record in state "requested" and emits.
  #   2. A policy on that event triggers an ask on one of the record's ports. The runtime hands
  #      the port's adapter the whole record, so the adapter does all the IO, and only there.
  #   3. The adapter answers (a hash named like a command's arguments) or raises (its message
  #      is the refusal). One policy per outcome re-enters the record with a command that stores it.
  #
  # The ports are declared in hecks.hecksagon; each adapter is in adapters/.

  aggregate "ModelCheckRun" do
    description "One static analysis over domains' models, and what it found: a check's history."

    attribute :run,     RunKey
    attribute :domains, DomainList,  optional: true
    attribute :profile, ProfileName, optional: true
    attribute :strict,  Switch,      optional: true
    attribute :report,  Report,      optional: true
    attribute :refusal, Report,      optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a run is named") { !value.to_s.empty? }
    end

    value_object "DomainList" do
      attribute :value, String, pattern: '[^\t\n\r]'
    end

    value_object "ProfileName" do
      attribute :value, String, pattern: '^client$'
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Pass" => "clean",   from: "requested"
      transition "Flag" => "flagged", from: "requested"
    end

    command "ModelCheck" do
      role "Operator"
      goal "Check domains for dead states and unreachable steps, and keep the verdict"

      attribute :run,     RunKey
      attribute :domains, DomainList,  optional: true
      attribute :profile, ProfileName, optional: true
      attribute :strict,  Switch,      optional: true

      sets :run
      sets :domains
      sets :profile
      sets :strict

      emits ModelCheckRequested
    end

    command "Pass" do
      role "System"
      goal "Record that the analysis left no error"

      reference_to ModelCheckRun
      attribute :report, Report

      sets :report

      emits ModelCheckPassed
    end

    command "Flag" do
      role "System"
      goal "Record that the analysis found something, or could not run, and what it said"

      reference_to ModelCheckRun
      attribute :refusal, Report

      sets :refusal

      emits ModelCheckFlagged
    end

    # `hecks model_check` answers once the request is recorded, so the verdict is read here.
    query "Verdict" do
      description "What one check found: its status, and the report or the reason it could not run."
      attribute :run, RunKey
      where(run: :run)
      order_by :run
    end

    query "Flagged" do
      description "Every check that left a finding or could not run."
      where(status: "flagged")
      order_by :run
    end
  end

  policy "AnalyseWhenRequested" do
    on      "ModelCheckRun.ModelCheckRequested"
    trigger ModelCheckRun::DomainRuntime::Check, with: { run: :run }
  end

  policy "RecordTheClean" do
    on      "ModelCheckRun.ModelCheckAnswered"
    trigger ModelCheckRun::Pass, with: { report: :report }
  end

  policy "RecordTheFlag" do
    on      "ModelCheckRun.ModelCheckRefused"
    trigger ModelCheckRun::Flag, with: { refusal: :refusal }
  end

  aggregate "Operation" do
    description "One thing an operator ran against a domain, and how it ended."

    attribute :run,          OperationKey
    attribute :subject,      Subject,    optional: true
    attribute :script,       Script,     optional: true
    attribute :verb,         Verb,       optional: true
    attribute :arguments,    list_of(Word), optional: true
    attribute :url,          Address,    optional: true
    attribute :path,         RoutePath,  optional: true
    attribute :header,       HeaderName, optional: true
    attribute :scheme,       Scheme,     optional: true
    attribute :payload,      Payload,    optional: true
    attribute :payload_file, PayloadFile, optional: true
    attribute :health_path,  RoutePath,  optional: true
    attribute :state_path,   RoutePath,  optional: true
    attribute :output,       Output,     optional: true
    attribute :refusal,      Output,     optional: true
    identified_by :run

    value_object "OperationKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("an operation is named") { !value.to_s.empty? }
    end

    # What the operation acts on: a domain directory, or a behaviors file or directory.
    value_object "Subject" do
      attribute :value, String, pattern: '[^\t\n\r]'
    end

    value_object "Script" do
      attribute :value, String
    end

    value_object "Verb" do
      attribute :value, String, pattern: '[^ \t\n\r]'
    end

    # One `name=value` word of the verb a run dispatches.
    value_object "Word" do
      attribute :value, String
    end

    value_object "Address" do
      attribute :value, String, pattern: '^https?://'
    end

    value_object "RoutePath" do
      attribute :value, String, pattern: '^/'
    end

    value_object "HeaderName" do
      attribute :value, String, pattern: '[^ \t\n\r]'
    end

    value_object "Scheme" do
      attribute :value, String, pattern: '^(timestamped|sha256|hex)$'
    end

    value_object "Payload" do
      attribute :value, String
    end

    value_object "PayloadFile" do
      attribute :value, String, pattern: '[^\t\n\r]'
    end

    value_object "Output" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Succeed" => "succeeded", from: "requested"
      transition "Fail"    => "failed",    from: "requested"
    end

    # Runs one verb, or a JSON step list, against the domain: `hecks run [domain] script=steps.json`
    # or `hecks run [domain] verb=create_pizza arguments=name.value=Margherita`. The signing secret
    # for SmokeHttp is never an argument: it is read from SMOKE_WEBHOOK_SECRET.
    command "Run" do
      role "Operator"
      goal "Dispatch a verb or a step list against a domain and keep what it reported"

      attribute :run,     OperationKey
      attribute :subject, Subject,       optional: true
      attribute :script,  Script,        optional: true
      attribute :verb,    Verb,          optional: true
      attribute :arguments, list_of(Word), optional: true

      sets :run
      sets :subject
      sets :script
      sets :verb
      sets :arguments

      emits RunRequested
    end

    command "RefreshProjections" do
      role "Operator"
      goal "Bring every read-model projection of a domain up to date now"

      attribute :run,     OperationKey
      attribute :subject, Subject

      sets :run
      sets :subject

      emits ProjectionsRefreshRequested
    end

    command "RunBehaviors" do
      role "Operator"
      goal "Run a domain's behavior tests and keep the verdict"

      attribute :run,     OperationKey
      attribute :subject, Subject

      sets :run
      sets :subject

      emits BehaviorsRequested
    end

    command "OpenConsole" do
      role "Operator"
      goal "Open an interactive console on a domain"

      attribute :run,     OperationKey
      attribute :subject, Subject, optional: true

      sets :run
      sets :subject

      emits ConsoleRequested
    end

    command "SmokeTest" do
      role "Operator"
      goal "Dispatch one synthesized call per command and report of a wired domain"

      attribute :run,     OperationKey
      attribute :subject, Subject, optional: true

      sets :run
      sets :subject

      emits SmokeTestRequested
    end

    command "SmokeHttp" do
      role "Operator"
      goal "Check that a running service refuses bad signatures and accepts a good one"

      attribute :run,          OperationKey
      attribute :url,          Address,     optional: true
      attribute :path,         RoutePath
      attribute :header,       HeaderName,  optional: true
      attribute :scheme,       Scheme,      optional: true
      attribute :payload,      Payload,     optional: true
      attribute :payload_file, PayloadFile, optional: true
      attribute :health_path,  RoutePath,   optional: true
      attribute :state_path,   RoutePath,   optional: true

      sets :run
      sets :url
      sets :path
      sets :header
      sets :scheme
      sets :payload
      sets :payload_file
      sets :health_path
      sets :state_path

      emits SmokeHttpRequested
    end

    command "Succeed" do
      role "System"
      goal "Record that the operation ended well, and what it reported"

      reference_to Operation
      attribute :output, Output

      sets :output

      emits OperationSucceeded
    end

    command "Fail" do
      role "System"
      goal "Record that the operation was refused or found a problem, and what it said"

      reference_to Operation
      attribute :refusal, Output

      sets :refusal

      emits OperationFailed
    end

    query "Outcome" do
      description "How one operation ended: its status, and what it reported or why it failed."
      attribute :run, OperationKey
      where(run: :run)
      order_by :run
    end

    query "Failed" do
      description "Every operation that was refused or found a problem."
      where(status: "failed")
      order_by :run
    end

    # A launcher answers once, so a follow is a bounded poll: it answers the entries past `since`
    # and a `cursor` to pass as the next `since`, waiting up to `wait` seconds for the first one.
    query "Follow" do
      description "A domain's persisted event log past a cursor, for tailing it call by call."
      attribute :domain,    Subject
      attribute :aggregate, Verb,    optional: true
      attribute :since,     Integer, optional: true
      attribute :from_now,  Boolean, optional: true
      attribute :wait,      Integer, optional: true
      attribute :interval,  Float,   optional: true
      answered_by "DomainRuntime"
    end
  end

  policy "RunWhenRequested" do
    on      "Operation.RunRequested"
    trigger Operation::DomainRuntime::Execute, with: { run: :run }
  end

  policy "RefreshWhenRequested" do
    on      "Operation.ProjectionsRefreshRequested"
    trigger Operation::DomainRuntime::Refresh, with: { run: :run }
  end

  policy "VerifyWhenRequested" do
    on      "Operation.BehaviorsRequested"
    trigger Operation::DomainRuntime::Verify, with: { run: :run }
  end

  policy "SmokeWhenRequested" do
    on      "Operation.SmokeTestRequested"
    trigger Operation::DomainRuntime::Smoke, with: { run: :run }
  end

  policy "OpenWhenRequested" do
    on      "Operation.ConsoleRequested"
    trigger Operation::Terminal::Open, with: { run: :run }
  end

  policy "ProbeWhenRequested" do
    on      "Operation.SmokeHttpRequested"
    trigger Operation::HostHttp::Probe, with: { run: :run }
  end

  policy "RecordTheOutput" do
    on      "Operation.OperationAnswered"
    trigger Operation::Succeed, with: { output: :output }
  end

  policy "RecordTheFailure" do
    on      "Operation.OperationRefused"
    trigger Operation::Fail, with: { refusal: :refusal }
  end

  aggregate "Host" do
    description "A running rust/host, and the version and era it last reported."

    attribute :host,     Address
    attribute :expected, ExpectedFile,  optional: true
    attribute :timeout,  Seconds,       optional: true
    attribute :era,      EraId,         optional: true
    attribute :version,  VersionText,   optional: true
    attribute :report,   Report,        optional: true
    attribute :refusal,  Report,        optional: true
    identified_by :host

    value_object "Address" do
      attribute :value, String, pattern: '^https?://'
    end

    # The file listing the eras that should be running, one per line.
    value_object "ExpectedFile" do
      attribute :value, String, pattern: '[^\t\n\r]'
    end

    value_object "Seconds" do
      attribute :value, Float

      invariant("a timeout is positive") { value > 0 }
    end

    value_object "EraId" do
      attribute :value, String, pattern: '[^ \t\n\r]'
    end

    value_object "VersionText" do
      attribute :value, String
    end

    value_object "Verdict" do
      attribute :value, String, pattern: '^(match|unlisted|mismatch)$'
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Recheck" => "requested",   from: %w[observed drifted unreachable]
      transition "Observe" => "observed",    from: "requested"
      transition "Drift"   => "drifted",     from: "requested"
      transition "Lose"    => "unreachable", from: "requested"
    end

# `hecks check_era <url> expected=era-file [timeout=10]` records the first check of a host under
# its URL. A host is one record, and a creating command cannot repeat an identity, so a later
# check of the same host is `hecks recheck <url> expected=era-file`. Both are read with
# `hecks standing <url>`.
command "CheckEra" do
      role "Operator"
      goal "Ask a running host which era it reports, and keep whether it is one that should be running"

      attribute :host,     Address
      attribute :expected, ExpectedFile
      attribute :timeout,  Seconds, optional: true

      sets :host
      sets :expected
      sets :timeout

      emits EraCheckRequested
    end

command "Recheck" do
  role "Operator"
  goal "Ask a host already checked which era it reports now"

  reference_to Host
  attribute :expected, ExpectedFile
  attribute :timeout,  Seconds, optional: true

  sets :expected
  sets :timeout

  emits EraRecheckRequested
end

# The host reported an era the list accepts, or a list that names none.
    command "Observe" do
      role "System"
      goal "Record the version and era a running host reported"

      reference_to Host
      attribute :era,     EraId
      attribute :version, VersionText
      attribute :report,  Report

      sets :era
      sets :version
      sets :report

      emits EraObserved
    end

    # The host reported an era that is not on the list: the finding the roll must stop on.
    command "Drift" do
      role "System"
      goal "Record that a running host reports an era that should not be running"

      reference_to Host
      attribute :era,     EraId
      attribute :version, VersionText
      attribute :report,  Report

      sets :era
      sets :version
      sets :report

      emits EraDrifted
    end

    command "Lose" do
      role "System"
      goal "Record that the host could not be reached, or answered no era, and what was said"

      reference_to Host
      attribute :refusal, Report

      sets :refusal

      emits HostLost
    end

    query "Standing" do
      description "What one check of a host found: its status, era and version, or why it failed."
      attribute :host, Address
      where(host: :host)
      order_by :host
    end

    query "Drifted" do
      description "Every host that reported an era that should not be running."
      where(status: "drifted")
      order_by :host
    end
  end

  policy "FetchWhenChecked" do
    on      "Host.EraCheckRequested"
    trigger Host::HostHttp::Fetch, with: { host: :host }
  end

policy "FetchWhenRechecked" do
  on      "Host.EraRecheckRequested"
  trigger Host::HostHttp::Fetch, with: { host: :host }
end

policy "RecordTheEra" do
    on      "Host.EraReported"
    where   { verdict.value != "mismatch" }
    trigger Host::Observe, with: { era: :era, version: :version, report: :report }
  end

  policy "RecordTheDrift" do
    on      "Host.EraReported"
    where   { verdict.value == "mismatch" }
    trigger Host::Drift, with: { era: :era, version: :version, report: :report }
  end

  policy "RecordTheLostHost" do
    on      "Host.HostRefused"
    trigger Host::Lose, with: { refusal: :refusal }
  end

  aggregate "Package" do
    description "One package of the bluebook registry, vendored into a project and pinned."

    attribute :package, PackageRef
    attribute :from,    Location, optional: true
    attribute :root,    Location, optional: true
    attribute :report,  Report,   optional: true
    attribute :refusal, Report,   optional: true
    identified_by :package

    # `name` for the newest release, `name@1.2.0` for one release, `name@9f2c1ab` for a commit.
    value_object "PackageRef" do
      attribute :value, String, pattern: '^[a-z][a-z0-9_]*(@[^ \t\n\r]+)?$'

      invariant("a package is named") { !value.to_s.empty? }
    end

    # A directory: the source repository (`from`), or the project the files land in (`root`).
    value_object "Location" do
      attribute :value, String, pattern: '[^\t\n\r]'
    end

    value_object "Report" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Revendor" => "requested", from: %w[vendored refused]
      transition "Complete" => "vendored",  from: "requested"
      transition "Abandon"  => "refused",   from: "requested"
    end

    # `hecks vendor <package[@version]> [from=path] [root=path]`. The record is named by what was
    # asked for, so a release is one record; vendoring the same spelling again is `hecks revendor`.
    # `from` defaults to $EMBRYONAUT_BLUEBOOKS_SRC and `root` to the current directory, both read by
    # the adapter.
    command "Vendor" do
      role "Operator"
      goal "Pin a package of the bluebook registry into this project, at a release or a commit"

      attribute :package, PackageRef
      attribute :from,    Location, optional: true
      attribute :root,    Location, optional: true

      sets :package
      sets :from
      sets :root

      emits VendorRequested
    end

    command "Revendor" do
      role "Operator"
      goal "Pin a package that was vendored before again, for the newest release or the same one"

      reference_to Package
      attribute :from, Location, optional: true
      attribute :root, Location, optional: true

      sets :from
      sets :root

      emits RevendorRequested
    end

    command "Complete" do
      role "System"
      goal "Record that the package was pinned, and what changed"

      reference_to Package
      attribute :report, Report

      sets :report

      emits PackageVendored
    end

    command "Abandon" do
      role "System"
      goal "Record that the package could not be pinned, and why"

      reference_to Package
      attribute :refusal, Report

      sets :refusal

      emits VendoringRefused
    end

    query "Pinning" do
      description "What vendoring one package did: its status, and the report or the refusal."
      attribute :package, PackageRef
      where(package: :package)
      order_by :package
    end

    query "Unpinned" do
      description "Every package the last vendoring of which was refused."
      where(status: "refused")
      order_by :package
    end
  end

  policy "PinWhenVendored" do
    on      "Package.VendorRequested"
    trigger Package::Git::Pin, with: { package: :package }
  end

  policy "PinWhenRevendored" do
    on      "Package.RevendorRequested"
    trigger Package::Git::Pin, with: { package: :package }
  end

  policy "RecordThePinning" do
    on      "Package.PackagePinned"
    trigger Package::Complete, with: { report: :report }
  end

  policy "RecordTheRefusedPin" do
    on      "Package.PinRefused"
    trigger Package::Abandon, with: { refusal: :refusal }
  end

  aggregate "Door" do
    description "A way into the framework opened for a project: its launchers, or an MCP server."

    attribute :run,     DoorKey
    attribute :domains, DomainList, optional: true
    attribute :stdio,   Switch,     optional: true
    attribute :output,  Note,       optional: true
    attribute :refusal, Note,       optional: true
    identified_by :run

    value_object "DoorKey" do
      attribute :value, String, pattern: '[^ \t\n\r]'

      invariant("a door is named") { !value.to_s.empty? }
    end

    # Domain directories under the project, comma separated.
    value_object "DomainList" do
      attribute :value, String, pattern: '[^\t\n\r]'
    end

    value_object "Switch" do
      attribute :value, Boolean
    end

    value_object "Note" do
      attribute :value, String
    end

    lifecycle :status, default: "requested" do
      transition "Finish" => "finished", from: "requested"
      transition "Stop"   => "stopped",  from: "requested"
    end

    # Writes a launcher beside each domain. It replaces the generated launcher already there and
    # deletes nothing, so it runs without `confirm` (`hecks project_cli` never asked for one).
    command "ProjectCli" do
      role "Operator"
      goal "Write a command-line launcher beside each domain of this project"

      attribute :run,     DoorKey
      attribute :domains, DomainList, optional: true

      sets :run
      sets :domains

      emits LaunchersRequested
    end

    # A stdio server runs until its client closes stdin, so it cannot be asked and answered
    # quickly like the others. The command records that the door was started; the Terminal
    # adapter hands the process over to the door and answers when it closes, as OpenConsole
    # does for a console. The launcher spells it `serve_mcp`; the `mcp` spelling exe/hecks ships
    # today stays with its router until the launcher is generated.
    command "ServeMcp" do
      role "Operator"
      goal "Serve the storehouse bus to an MCP client over stdio until it closes"

      attribute :run,   DoorKey
      attribute :stdio, Switch, optional: true

      sets :run
      sets :stdio

      emits McpRequested
    end

    command "Finish" do
      role "System"
      goal "Record that the door did its work, or was closed, and what it said"

      reference_to Door
      attribute :output, Note

      sets :output

      emits DoorFinished
    end

    command "Stop" do
      role "System"
      goal "Record that the door could not be opened, and why"

      reference_to Door
      attribute :refusal, Note

      sets :refusal

      emits DoorStopped
    end

    query "Ended" do
      description "How one door ended: its status, and what it said or why it stopped."
      attribute :run, DoorKey
      where(run: :run)
      order_by :run
    end

    query "Stopped" do
      description "Every door that could not be opened."
      where(status: "stopped")
      order_by :run
    end
  end

  policy "WriteWhenRequested" do
    on      "Door.LaunchersRequested"
    trigger Door::Workspace::Write, with: { run: :run }
  end

  policy "ServeWhenRequested" do
    on      "Door.McpRequested"
    trigger Door::Terminal::Serve, with: { run: :run }
  end

  policy "RecordTheDoor" do
    on      "Door.DoorAnswered"
    trigger Door::Finish, with: { output: :output }
  end

  policy "RecordTheStoppedDoor" do
    on      "Door.DoorRefused"
    trigger Door::Stop, with: { refusal: :refusal }
  end
end
