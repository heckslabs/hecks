Hecks.bluebook "Hecks" do
  domain_module "MachineProfile" do
    vision "A machine's capacity settings are derived from what the machine is, by declared formulas inside declared bounds, so a smaller machine gets smaller defaults and a declared setting still wins."

    # The profile holds facts an adapter measured; the Formula and Bound rows are the whole derivation.
    # A declared world setting is the override and wins. A new profile supersedes the old by fingerprint.
    aggregate "Profile" do
      description "What this machine is: its cores, memory, free disk and the measured size of a resident and of a coder. Each setting is its Formula row's measure times `times` over `divisor` (and over the `per` measure), rounded down when whole, then held inside its Bound row."
      created_by "Profile.take!"

      attribute :run,               RunKey
      attribute :fingerprint,       Word
      attribute :performance_cores, Count
      attribute :efficiency_cores,  Count
      attribute :cores,             Count
      attribute :memory_mb,         Count
      attribute :free_memory_mb,    Count
      attribute :free_disk_gb,      Count
      attribute :resident_mb,       Count
      attribute :coder_mb,          Count
      identified_by :run

      value_object "RunKey" do
        attribute :value, String, matches: :present
      end

      value_object "Word" do
        attribute :value, String, matches: :present
      end

      value_object "Count", Integer

      value_object "Document" do
        attribute :text, String
      end

      # How one capacity setting is derived: `measure` times `times`, over `divisor`, over the `per`
      # measure when one is named. `whole` says the result is rounded down to a whole number.
      value_object "Formula" do
        attribute :setting, String
        attribute :measure, String
        attribute :times,   Float
        attribute :divisor, Float
        attribute :per,     String
        attribute :whole,   String

        member setting: "residents",    measure: "free_memory_mb",    times: 0.5, divisor: 1.0, per: "resident_mb", whole: "yes"
        member setting: "heavy_jobs",   measure: "performance_cores", times: 1.0, divisor: 3.0, per: "",            whole: "yes"
        member setting: "spec_workers", measure: "performance_cores", times: 1.0, divisor: 2.0, per: "",            whole: "yes"
        member setting: "load_low",     measure: "cores",             times: 1.0, divisor: 1.0, per: "",            whole: "no"
        member setting: "load_high",    measure: "cores",             times: 1.5, divisor: 1.0, per: "",            whole: "no"
      end

      # The hard bounds of a derived value. `most_measure` also holds it at or under that measure.
      value_object "Bound" do
        attribute :setting,      String
        attribute :least,        Float
        attribute :most,         Float
        attribute :most_measure, String

        member setting: "residents",    least: 1.0, most: 16.0, most_measure: ""
        member setting: "heavy_jobs",   least: 1.0, most: 8.0,  most_measure: ""
        member setting: "spec_workers", least: 1.0, most: 16.0, most_measure: "cores"
        member setting: "load_low",     least: 1.0, most: 40.0, most_measure: ""
        member setting: "load_high",    least: 2.0, most: 60.0, most_measure: ""
      end

      command "Take" do
        role "System"
        goal "Record one profile of this machine; a later profile supersedes it"

        attribute :run,               RunKey, sets: true
        attribute :fingerprint,       Word, sets: true
        attribute :performance_cores, Count, sets: true
        attribute :efficiency_cores,  Count, sets: true
        attribute :cores,             Count, sets: true
        attribute :memory_mb,         Count, sets: true
        attribute :free_memory_mb,    Count, sets: true
        attribute :free_disk_gb,      Count, sets: true
        attribute :resident_mb,       Count, sets: true
        attribute :coder_mb,          Count, sets: true

        emits Taken
      end

      query "Derive" do
        description "One capacity setting derived from the profile by its Formula row and held inside its Bound row."
        attribute :run,     RunKey
        attribute :setting, Word
        returns Document
      end
    end
  end
end
