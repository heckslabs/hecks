Hecks.behaviors "Hecks" do
  vision "A release moves tagged, published, verified; the grammar cache moves fresh, stale, fresh."

  loads "hecks.bluebook", "custodian.bluebook", "tooling.bluebook", "codebase.bluebook", "context_map.hecksagon", "hecks.hecksagon", "environments/memory.world"

  test "Tag records a version as tagged" do
    tests "Tag", on: "Release"
    input  version: { value: "3.0.0" }, ir_version: { value: "1.0.0" }, ships_from: { path: "/work/hecks" }
    expect state: "tagged"
  end

  test "MarkPublished advances a tagged release" do
    # The setup is spelled in full: the attached QualityControl chapter also has a `Tag` command.
    tests "MarkPublished", on: "Release"
    setup  "Hecks::Release.Tag", version: { value: "3.0.0" }, ir_version: { value: "1.0.0" }, ships_from: { path: "/work/hecks" }
    input  version: { value: "3.0.0" }
    expect emits: ["Published"]
  end

  test "Verify advances a published release" do
    tests "Verify", on: "Release"
    setup  "Hecks::Release.Tag", version: { value: "3.0.0" }, ir_version: { value: "1.0.0" }, ships_from: { path: "/work/hecks" }
    setup  "Hecks::Release.MarkPublished", version: { value: "3.0.0" }
    input  version: { value: "3.0.0" }
    expect state: "verified"
  end

  test "Verify refuses a release that is only tagged" do
    tests "Verify", on: "Release"
    setup  "Hecks::Release.Tag", version: { value: "3.0.0" }, ir_version: { value: "1.0.0" }, ships_from: { path: "/work/hecks" }
    input  version: { value: "3.0.0" }
    expect refused: "state"
  end

  test "Record keeps a boot cache as fresh" do
    tests "Record", on: "SyntaxBootCache"
    input digest: { value: "abc123" }
    expect state: "fresh"
  end

  test "Invalidate marks a fresh grammar cache stale" do
    tests "Invalidate", on: "SyntaxBootCache"
    setup  "Hecks::SyntaxBootCache.Record", digest: { value: "abc123" }
    input  digest: { value: "abc123" }
    expect state: "stale"
  end

  test "Rebuild makes a stale grammar cache fresh again" do
    tests "Rebuild", on: "SyntaxBootCache"
    setup  "Hecks::SyntaxBootCache.Record", digest: { value: "abc123" }
    setup  "Hecks::SyntaxBootCache.Invalidate", digest: { value: "abc123" }
    input  digest: { value: "abc123" }
    expect state: "fresh"
  end

  test "Rebuild refuses a cache that is still fresh" do
    tests "Rebuild", on: "SyntaxBootCache"
    setup  "Hecks::SyntaxBootCache.Record", digest: { value: "abc123" }
    input  digest: { value: "abc123" }
    expect refused: "state"
  end
end
