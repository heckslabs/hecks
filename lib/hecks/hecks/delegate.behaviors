Hecks.behaviors "Delegate" do
  vision "A responder answers a blocked run's question from a fact, only once a replay of the lead's past answers matched, never for the owner, and never faster than its spacing."

  loads "hecks.bluebook", "context_map.hecksagon", "hecks.hecksagon", "red_wake.hecksagon", "stable_roll.hecksagon", "environments/memory.world", modules: :all

  test "Declare opens a responder switched off, its replay unmatched" do
    tests "Declare", on: "Responder"
    input family: { value: "false-stall" }, spacing: { value: 5 }
    expect emits: ["ResponderDeclared"]
  end

  test "SwitchOn refuses a responder whose replay has not matched" do
    tests "SwitchOn", on: "Responder"
    setup  "Hecks::Responder.Declare", family: { value: "false-stall" }, spacing: { value: 5 }
    input  family: { value: "false-stall" }
    expect refused: "replay"
  end

  test "SwitchOn switches on a responder whose replay matched" do
    tests "SwitchOn", on: "Responder"
    setup  "Hecks::Responder.Declare", family: { value: "false-stall" }, spacing: { value: 5 }
    setup  "Hecks::Responder.RecordReplay", family: { value: "false-stall" }
    input  family: { value: "false-stall" }
    expect emits: ["ResponderSwitchedOn"]
  end

  test "Admit refuses a responder that is switched off" do
    tests "Admit", on: "Responder"
    setup  "Hecks::Responder.Declare", family: { value: "false-stall" }, spacing: { value: 5 }
    input  family: { value: "false-stall" }, run: { value: "stall-x-1" }, text: { value: "[choose] A or B?" }, answer: { value: "a" }, now: { value: 100 }
    expect refused: "switched on"
  end

  test "Admit refuses a question that is the owner's" do
    tests "Admit", on: "Responder"
    setup  "Hecks::Responder.Declare", family: { value: "false-stall" }, spacing: { value: 5 }
    setup  "Hecks::Responder.RecordReplay", family: { value: "false-stall" }
    setup  "Hecks::Responder.SwitchOn", family: { value: "false-stall" }
    input  family: { value: "false-stall" }, run: { value: "stall-x-1" }, text: { value: "[owner] Release?" }, answer: { value: "a" }, now: { value: 100 }
    expect refused: "owner"
  end

  test "Admit admits a switched-on responder for a question that is not the owner's" do
    tests "Admit", on: "Responder"
    setup  "Hecks::Responder.Declare", family: { value: "false-stall" }, spacing: { value: 5 }
    setup  "Hecks::Responder.RecordReplay", family: { value: "false-stall" }
    setup  "Hecks::Responder.SwitchOn", family: { value: "false-stall" }
    input  family: { value: "false-stall" }, run: { value: "stall-x-1" }, text: { value: "[choose] A or B?" }, answer: { value: "a" }, now: { value: 100 }
    expect emits: ["ResponderAdmitted"]
  end

  test "Admit refuses a second answer inside the spacing" do
    tests "Admit", on: "Responder"
    setup  "Hecks::Responder.Declare", family: { value: "false-stall" }, spacing: { value: 5 }
    setup  "Hecks::Responder.RecordReplay", family: { value: "false-stall" }
    setup  "Hecks::Responder.SwitchOn", family: { value: "false-stall" }
    setup  "Hecks::Responder.Admit", family: { value: "false-stall" }, run: { value: "stall-x-1" }, text: { value: "q" }, answer: { value: "a" }, now: { value: 100 }
    input  family: { value: "false-stall" }, run: { value: "stall-x-2" }, text: { value: "q" }, answer: { value: "a" }, now: { value: 102 }
    expect refused: "spacing"
  end

  test "Record keeps the consumers the reading found" do
    tests "Record", on: "Machine"
    setup  "Hecks::Machine.Sample", run: { value: "m-1" }
    input  load_state: { value: "above" }, memory_state: { value: "ok" }, lane_state: { value: "idle" }, consumers: { value: "[]" }
    expect emits: ["MachineRead"]
  end
end
