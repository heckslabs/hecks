Hecks.behaviors "Deploy" do
  vision "A recipe, a lint, a comparison or a projection is recorded as requested before anything outside is asked."

  loads "hecks.bluebook", "custodian.bluebook", "codebase.bluebook", "context_map.hecksagon", "hecks.hecksagon", "deploy.world", "environments/memory.world"

  test "Project keeps a domain that has no world file as a faulted recipe" do
    tests "Project", on: "Recipe"
    input run: { value: "stack" }, domain: { value: "/tmp/hecks-behaviors-absent/domain" }
    expect emits: %w[ProjectionRequested RecipeRefused RecipeFaulted]
  end

  test "Project refuses a tenant slug that is not lowercase" do
    tests "Project", on: "Recipe"
    input run: { value: "stack" }, domain: { value: "examples/pizzas" }, tenant: { value: "Not A Slug" }
    expect refused: "must match"
  end

  test "Lint keeps a Makefile that is not there as a flagged lint" do
    tests "Lint", on: "MakefileCheck"
    input run: { value: "recipes" }, makefiles: { value: "/tmp/hecks-behaviors-absent/Makefile" }
    expect emits: %w[LintRequested LintRefused LintFlagged]
  end

  test "Diff keeps a template that is not there as a refused comparison" do
    tests "Diff", on: "TemplateComparison"
    input run: { value: "stacks" }, before: { value: "/tmp/hecks-behaviors-absent/before.yaml" }, after: { value: "/tmp/hecks-behaviors-absent/after.yaml" }
    expect emits: %w[ComparisonRequested ComparisonUnreadable ComparisonRefused]
  end

  test "Diff refuses a template with no path" do
    tests "Diff", on: "TemplateComparison"
    input run: { value: "stacks" }, before: { value: "" }, after: { value: "/tmp/hecks-behaviors-absent/after.yaml" }
    expect refused: "must match"
  end

  test "ProjectOidc keeps a domain it cannot boot out of the manifests and answers" do
    tests "ProjectOidc", on: "OidcManifest"
    input run: { value: "manifests" }, domains: { value: "/tmp/hecks-behaviors-absent/domain" }
    expect emits: %w[OidcProjectionRequested ManifestAnswered OidcProjected]
  end

  test "Provision refuses a slug that is not lowercase, and writes nothing" do
    tests "Provision", on: "Tenant"
    input directory: { value: "/tmp/hecks-behaviors-absent/domain" }, slug: { value: "Not A Slug" }, domain: { value: "Scratch" },
          realm: { value: "Acme" }, schema: { value: "acme" }, database: { value: "hecks_tenants" }
    expect refused: "must match"
  end

  test "Provision refuses a tenant with no realm" do
    tests "Provision", on: "Tenant"
    input directory: { value: "/tmp/hecks-behaviors-absent/domain" }, slug: { value: "acme" }, domain: { value: "Scratch" },
          realm: { value: "" }, schema: { value: "acme" }, database: { value: "hecks_tenants" }
    expect refused: "a tenant realm is named"
  end

  test "Provision on a slug that is already recorded is refused as AlreadyExists" do
    tests "Provision", on: "Tenant"
    setup  "Deploy::Tenant.Provision", directory: { value: "/tmp/hecks-behaviors-absent/domain" }, slug: { value: "acme" }, domain: { value: "Scratch" },
           realm: { value: "Acme" }, schema: { value: "acme" }, database: { value: "hecks_tenants" }
    input directory: { value: "/tmp/hecks-behaviors-absent/domain" }, slug: { value: "acme" }, domain: { value: "Scratch" },
          realm: { value: "Acme" }, schema: { value: "acme" }, database: { value: "hecks_tenants" }
    expect refused: "already"
  end

  # A directory that is not there is refused, so no overlay is written and the test creates
  # nothing; the writing path runs against a real tmpdir in spec/adapters/driven/tenant_provisioner_spec.rb.
  test "Reprovision keeps a directory that is not there as a refused provisioning" do
    tests "Reprovision", on: "Tenant"
    setup  "Deploy::Tenant.Provision", directory: { value: "/tmp/hecks-behaviors-absent/domain" }, slug: { value: "acme" }, domain: { value: "Scratch" },
           realm: { value: "Acme" }, schema: { value: "acme" }, database: { value: "hecks_tenants" }
    input  tenant: "acme", directory: { value: "/tmp/hecks-behaviors-absent/domain" }, database: { value: "hecks_tenants" }
    expect emits: %w[TenantReprovisionRequested ProvisioningRefused ProvisioningAbandoned]
  end
end
