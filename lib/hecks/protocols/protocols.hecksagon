# The Protocols bluebook, bound so it boots standing alone (a behaviors or model_check boot of this
# directory). Working agreements live in memory; the Hecks domain attaches the domain through its
# own hecksagon, which is the owner of that wiring.
Hecks.hecksagon "Protocols" do
  attaches "Governance"
  persisted_by "Memory"
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
