Hecks.behaviors "Protocols" do
  vision "A working agreement is accepted when every affected role says yes, vetoed with a reason, sent to the owner when it touches the owner, and a break of it is flagged."

  loads "protocols.hecksagon", "protocols.bluebook"

  test "Propose opens an agreement owing one answer per affected role" do
    tests "Propose", on: "Agreement"
    input reference: { value: "WA-1" }, text: { value: "A run checks in every 20 minutes" },
          proposer: { value: "scrum-master" }, affects: { value: "|coder|reviewer|" },
          touches_owner: { value: "no" }, owed: { value: 2 }
    expect emits: ["AgreementProposed"], status: "proposed", owed: { value: 2 }
  end

  test "Propose refuses an agreement that affects no role" do
    tests "Propose", on: "Agreement"
    input reference: { value: "WA-2" }, text: { value: "Nothing" }, proposer: { value: "scrum-master" },
          affects: { value: "||" }, touches_owner: { value: "no" }, owed: { value: 0 }
    expect refused: "an agreement affects at least one role"
  end

  test "The last yes accepts the agreement" do
    tests "Cast", on: "Vote"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-3" },
          text: { value: "A reviewer answers in 10 minutes" }, proposer: { value: "scrum-master" },
          affects: { value: "|reviewer|" }, touches_owner: { value: "no" }, owed: { value: 1 }
    input agreement: { value: "WA-3" }, seat: { value: "reviewer-1" }, role: { value: "reviewer" },
          gesture: { value: "yes" }, message: { value: "msg-31" }, now: { value: 1000 }
    expect emits: %w[VoteCast AgreementAgreed AgreementAccepted]
  end

  test "A yes with another role still owing leaves the agreement proposed" do
    tests "Cast", on: "Vote"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-4" },
          text: { value: "At most two items expedited" }, proposer: { value: "scrum-master" },
          affects: { value: "|coder|reviewer|" }, touches_owner: { value: "no" }, owed: { value: 2 }
    input agreement: { value: "WA-4" }, seat: { value: "coder-1" }, gesture: { value: "yes" },
          message: { value: "m-2" }, now: { value: 100 }
    expect emits: %w[VoteCast AgreementAgreed]
  end

  test "Veto settles the agreement with its reason" do
    tests "Veto", on: "Agreement"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-5" },
          text: { value: "No landing deletes outside its area" }, proposer: { value: "scrum-master" },
          affects: { value: "|coder|" }, touches_owner: { value: "no" }, owed: { value: 1 }
    input agreement: "WA-5", veto_reason: { value: "The area is not always known up front" }
    expect emits: ["AgreementVetoed"], status: "vetoed"
  end

  test "Veto refuses no reason" do
    tests "Veto", on: "Agreement"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-6" }, text: { value: "Anything" },
          proposer: { value: "scrum-master" }, affects: { value: "|coder|" }, touches_owner: { value: "no" },
          owed: { value: 1 }
    input agreement: "WA-6"
    expect refused: "veto_reason"
  end

  test "An agreement touching the owner goes to the owner" do
    tests "Propose", on: "Agreement"
    input reference: { value: "WA-7" }, text: { value: "A release waits a day" },
          proposer: { value: "scrum-master" }, affects: { value: "|coder|" },
          touches_owner: { value: "yes" }, owed: { value: 1 }
    expect emits: %w[AgreementProposed AgreementEscalated], status: "owner_pending"
  end

  test "A yes on an agreement that touches the owner is recorded but not counted" do
    tests "Cast", on: "Vote"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-8" },
          text: { value: "A release waits a day" }, proposer: { value: "scrum-master" },
          affects: { value: "|coder|" }, touches_owner: { value: "yes" }, owed: { value: 1 }
    input agreement: { value: "WA-8" }, seat: { value: "coder-1" }, gesture: { value: "yes" },
          message: { value: "m-3" }, now: { value: 100 }
    expect emits: ["VoteCast"]
  end

  test "Flag records a break of an accepted agreement" do
    tests "Flag", on: "Agreement"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-9" },
          text: { value: "A reviewer answers in 10 minutes" }, proposer: { value: "scrum-master" },
          affects: { value: "|reviewer|" }, touches_owner: { value: "no" }, owed: { value: 1 }
    setup "Protocols::Vote.Cast", agreement: { value: "WA-9" }, seat: { value: "reviewer-1" },
          gesture: { value: "yes" }, message: { value: "m-4" }, now: { value: 100 }
    input agreement: "WA-9", peer: { value: "coder" }, what: { value: "No answer after 25 minutes" }
    expect emits: ["ProtocolFlagged"], breaks: { value: 1 }
  end

  test "Flag refuses a break of an agreement not accepted" do
    tests "Flag", on: "Agreement"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-10" }, text: { value: "Anything" },
          proposer: { value: "scrum-master" }, affects: { value: "|coder|" }, touches_owner: { value: "no" },
          owed: { value: 1 }
    input agreement: "WA-10", peer: { value: "coder" }, what: { value: "Early" }
    expect refused: "only an accepted agreement can be broken"
  end

  test "A second vote from the same seat before the reveal is refused" do
    tests "Cast", on: "Vote"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-11" }, text: { value: "Two sessions" },
          proposer: { value: "scrum-master" }, affects: { value: "|coder|reviewer|" },
          touches_owner: { value: "no" }, owed: { value: 2 }
    setup "Protocols::Vote.Cast", agreement: { value: "WA-11" }, seat: { value: "coder-1" },
          gesture: { value: "yes" }, message: { value: "m-5" }, now: { value: 100 }
    input agreement: { value: "WA-11" }, seat: { value: "coder-1" }, gesture: { value: "yes" },
          message: { value: "m-6" }, now: { value: 101 }
    expect refused: "Cast creates a Vote that already exists"
  end

  test "A no is replaced by a later yes from the same seat and both are kept" do
    tests "Replace", on: "Vote"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-12" }, text: { value: "Replace" },
          proposer: { value: "scrum-master" }, affects: { value: "|coder|" },
          touches_owner: { value: "no" }, owed: { value: 1 }
    setup "Protocols::Vote.Cast", agreement: { value: "WA-12" }, seat: { value: "coder-1" },
          gesture: { value: "no" }, message: { value: "m-7" }, now: { value: 100 }
    input agreement: { value: "WA-12" }, seat: { value: "coder-1" }, held_against: { value: "WA-12" }
    expect emits: %w[VoteReplaced ObjectionWithdrawn], status: "replaced"
  end

  test "A seat's later yes after its replaced no carries the agreement" do
    tests "Cast", on: "Vote"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-13" }, text: { value: "Carry" },
          proposer: { value: "scrum-master" }, affects: { value: "|coder|" },
          touches_owner: { value: "no" }, owed: { value: 1 }
    setup "Protocols::Vote.Cast", agreement: { value: "WA-13" }, seat: { value: "coder-1" },
          gesture: { value: "no" }, message: { value: "m-8" }, now: { value: 100 }
    setup "Protocols::Vote.Replace", agreement: { value: "WA-13" }, seat: { value: "coder-1" },
          held_against: { value: "WA-13" }
    input agreement: { value: "WA-13" }, seat: { value: "coder-1" }, gesture: { value: "yes" },
          message: { value: "m-9" }, now: { value: 200 }
    expect emits: %w[VoteCast AgreementAgreed AgreementAccepted]
  end

  test "A yes stands and is not replaced" do
    tests "Replace", on: "Vote"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-14" }, text: { value: "Stands" },
          proposer: { value: "scrum-master" }, affects: { value: "|coder|reviewer|" },
          touches_owner: { value: "no" }, owed: { value: 2 }
    setup "Protocols::Vote.Cast", agreement: { value: "WA-14" }, seat: { value: "coder-1" },
          gesture: { value: "yes" }, message: { value: "m-10" }, now: { value: 100 }
    input agreement: { value: "WA-14" }, seat: { value: "coder-1" }, held_against: { value: "WA-14" }
    expect refused: "only a no can be replaced"
  end

  test "A proposal with an open thumbs-down does not carry" do
    tests "Cast", on: "Vote"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-15" }, text: { value: "Open no" },
          proposer: { value: "scrum-master" }, affects: { value: "|coder|" },
          touches_owner: { value: "no" }, owed: { value: 1 }
    input agreement: { value: "WA-15" }, seat: { value: "coder-1" }, gesture: { value: "no" },
          message: { value: "m-11" }, now: { value: 100 }
    expect emits: %w[VoteCast AgreementOpposed]
  end

  test "Close is refused while the deadline has not passed" do
    tests "Close", on: "Agreement"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-16" }, text: { value: "Early" },
          proposer: { value: "scrum-master" }, affects: { value: "|coder|" },
          touches_owner: { value: "no" }, owed: { value: 1 }, deadline: { value: 500 }
    input agreement: "WA-16", now: { value: 400 }
    expect refused: "an agreement closes only after its deadline"
  end

  test "Close is allowed after the deadline with a seat still owed, and keeps when it closed" do
    tests "Close", on: "Agreement"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-17" }, text: { value: "Late" },
          proposer: { value: "scrum-master" }, affects: { value: "|coder|" },
          touches_owner: { value: "no" }, owed: { value: 1 }, deadline: { value: 500 }
    input agreement: "WA-17", now: { value: 600 }
    expect emits: ["AgreementClosed"], status: "closed", closed_at: { value: 600 }
  end

  test "Another seat's yes does not carry an agreement while a thumbs-down is open" do
    tests "Cast", on: "Vote"
    setup "Protocols::Agreement.Propose", reference: { value: "WA-18" }, text: { value: "Open no" },
          proposer: { value: "scrum-master" }, affects: { value: "|coder|" },
          touches_owner: { value: "no" }, owed: { value: 1 }
    setup "Protocols::Vote.Cast", agreement: { value: "WA-18" }, seat: { value: "coder-1" },
          gesture: { value: "no" }, message: { value: "m-12" }, now: { value: 100 }
    input agreement: { value: "WA-18" }, seat: { value: "coder-2" }, gesture: { value: "yes" },
          message: { value: "m-13" }, now: { value: 101 }
    expect emits: %w[VoteCast AgreementAgreed]
  end
end
