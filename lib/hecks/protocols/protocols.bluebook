# Protocols: the crew sets its own working agreements through the Decider protocol.
Hecks.bluebook "Protocols" do
  vision "A role proposes a working agreement; the roles it affects settle it by a quick yes or a veto with a reason; an accepted agreement is recorded and a peer flags a break for the retrospective."
  supporting

  aggregate "Agreement" do
    description "One working agreement: the text proposed, the roles it affects, which of them still owe an answer, and whether it was accepted, vetoed or sent to the owner."
    created_by "Agreement.propose!"

    identified_by :reference

    attribute :reference,     Reference
    attribute :text,          Text
    attribute :proposer,      Speaker
    # The affected roles, bar-delimited (`|coder|reviewer|`), because a rule cannot look inside a list.
    attribute :affects,       Roles
    attribute :touches_owner, Flag
    # Each role's yes takes one away; the agreement is accepted when none is owed.
    attribute :owed,          Tally
    attribute :veto_reason,   Text, optional: true
    # Each flagged break adds one, for the scrum master's retrospective.
    attribute :breaks,        Tally
    # The instant after which an absent seat no longer holds the agreement, and when it closed.
    attribute :deadline,      Instant, optional: true
    attribute :closed_at,     Instant, optional: true

    value_object "Reference" do
      attribute :value, String, matches: :present
    end

    value_object "Text" do
      attribute :value, String, matches: :not_empty
    end

    value_object "Speaker" do
      attribute :value, String, matches: :present
    end

    value_object "Roles" do
      attribute :value, String, matches: :present
    end

    # An agreement that touches the owner's charter marks, spend or releases goes to the owner.
    value_object "Flag" do
      attribute :value, String, one_of: %w[yes no]
    end

    value_object "Instant" do
      attribute :value, Integer, default: 0
      invariant("an instant is not before the epoch") { !value.negative? }
    end

    value_object "Tally" do
      attribute :value, Integer, default: 0
      invariant("a tally is not negative") { !value.negative? }
    end

    lifecycle :status, default: "proposed" do
      transition "Accept"   => "accepted",      from: "proposed"
      transition "Veto"     => "vetoed",        from: "proposed"
      transition "Escalate" => "owner_pending", from: "proposed"
      transition "Close"    => "closed",        from: "proposed"
      # An owner-pending agreement ends here for the roles: the owner settles it outside this domain.
      mark :terminal, "accepted", "vetoed", "owner_pending", "closed"
    end

    command "Propose" do
      role "Maintainer"
      goal "Put a working agreement forward to the roles it affects"

      attribute :reference,     Reference
      attribute :text,          Text
      attribute :proposer,      Speaker
      attribute :affects,       Roles
      attribute :touches_owner, Flag
      attribute :owed,          Tally
      attribute :deadline,      Instant, optional: true

      given("an agreement affects at least one role") { owed.value.positive? }

      emits "AgreementProposed"
    end

    command "Agree" do
      role "System"
      policy_only
      goal "Count one seat's standing yes against the roles still owing an answer"

      reference_to Agreement

      given("a yes is counted only while the agreement waits on roles") { status == "proposed" && owed.value.positive? }

      sets :owed, decrement: { value: 1 }

      emits "AgreementAgreed"
    end

    command "Veto" do
      role "Maintainer"
      goal "One affected role refuses, and says why"

      reference_to Agreement
      attribute :veto_reason, Text, sets: true

      emits "AgreementVetoed"
    end

    command "Accept" do
      role "System"
      policy_only
      goal "Record the agreement once every affected role said yes"

      reference_to Agreement

      given("an agreement is accepted when no affected role still owes an answer") { owed.value.zero? }
      given("an agreement that touches the owner is never accepted by the roles") { touches_owner.value == "no" }

      emits "AgreementAccepted"
    end

    # The deadline passing frees the agreement from a seat that never answered: it closes without it.
    command "Close" do
      role "Maintainer"
      goal "Close an agreement whose deadline passed, recording when, whatever seat still owes an answer"

      reference_to Agreement
      attribute :now, Instant
      needs :now

      given("an agreement closes only after its deadline") { deadline.value.positive? && now.value > deadline.value }

      sets :closed_at, to: :now

      emits "AgreementClosed"
    end

    command "Escalate" do
      role "System"
      policy_only
      goal "Send an agreement that touches the owner to the owner"

      reference_to Agreement

      given("only an agreement that touches the owner goes to the owner") { touches_owner.value == "yes" }

      emits "AgreementEscalated"
    end

    # A refusal to break the agreement needs a guard in the owner of the rule (a routing rule or a
    # stall row); this records the break for the retrospective.
    command "Flag" do
      role "Maintainer"
      goal "A peer flags a break of an accepted agreement"

      reference_to Agreement
      attribute :peer, Speaker
      attribute :what, Text

      given("only an accepted agreement can be broken") { status == "accepted" }

      sets :breaks, increment: { value: 1 }

      emits "ProtocolFlagged"
    end
  end

  # One seat's answer to one agreement, kept as evidence: identified by agreement and seat (the run
  # key, never the session), so one standing vote per seat holds by identity. A no that the seat
  # resolves is replaced and kept, its key freed for the yes; the tally is read from these records.
  aggregate "Vote" do
    description "One seat's vote on one agreement: its gesture, the message that carried it and when it was cast; a replaced no stays as evidence."

    identified_by :agreement, :seat

    attribute :agreement, Reference
    attribute :seat,      Seat
    attribute :role,      Seat, optional: true
    attribute :gesture,   Gesture
    attribute :message,   MessageId
    attribute :voted_at,  Instant

    value_object "Reference" do
      attribute :value, String, matches: :present
    end

    # The run key of the voting session: two sessions of one seat are one seat.
    value_object "Seat" do
      attribute :value, String, matches: :present
    end

    value_object "Gesture" do
      attribute :value, String, one_of: %w[yes no]
    end

    # The id of the Message that carried the vote; Message stays the transport.
    value_object "MessageId" do
      attribute :value, String, matches: :present
    end

    value_object "Instant" do
      attribute :value, Integer, default: 0
      invariant("an instant is not before the epoch") { !value.negative? }
    end

    lifecycle :status, default: "open" do
      transition "Cast"    => "cast",     from: "open"
      transition "Replace" => "replaced", from: "cast"
      mark :terminal, "replaced"
      mark :reusable, "replaced"
    end

    command "Cast" do
      role "Maintainer"
      goal "A seat votes yes or no on an agreement, naming the message that carried it"

      attribute :agreement, Reference, sets: true
      attribute :seat,      Seat, sets: true
      attribute :role,      Seat, sets: true, optional: true
      attribute :gesture,   Gesture, sets: true
      attribute :message,   MessageId, sets: true
      # `now:` is filled from the clock port; an explicit value wins.
      attribute :now,       Instant
      needs :now

      sets :voted_at, to: :now

      emits "VoteCast"
    end

    command "Replace" do
      role "Maintainer"
      goal "A seat resolves its earlier no, freeing its place for a new vote while the no stays as evidence"

      reference_to Vote

      given("only a no can be replaced") { gesture.value == "no" }

      emits "VoteReplaced"
    end
  end

  # How many votes stand in each gesture: the tally, read over the votes and never stored beside
  # them. A replaced no is evidence, not a standing vote, so it is left out.
  read_model "VotesByGesture" do
    description "How many standing votes were cast in each gesture."
    include Vote
    where(status: "cast")
    group_by :gesture
    count
  end

  policy "CountTheYes" do
    on      "Vote.VoteCast"
    where   { gesture.value == "yes" }
    trigger Agreement::Agree, with: { agreement: :agreement }
  end

  policy "AcceptWhenEveryRoleAgreed" do
    on      "Agreement.AgreementAgreed"
    trigger Agreement::Accept, with: { agreement: :reference }
  end

  policy "EscalateWhatTouchesTheOwner" do
    on      "Agreement.AgreementProposed"
    trigger Agreement::Escalate, with: { agreement: :reference }
  end
end
