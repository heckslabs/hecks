Hecks.behaviors "Coach" do
  vision "Miette coaches the crew from evidence: what she saw comes before what she advises, her words are relayed as hers, and what touches one of her vows is the owner's to decide."

  loads "coach.hecksagon", "coach.bluebook"

  test "Observe records what Miette saw and where" do
    tests "Observe", on: "Observation"
    input observation: { value: "obs-1" }, source: { value: "stall_item" }, saw: { value: "A coder stopped short of landing." }
    expect emits: ["Observed"]
  end

  test "Observe refuses a source she does not read from" do
    tests "Observe", on: "Observation"
    input observation: { value: "obs-2" }, source: { value: "hearsay" }, saw: { value: "Someone said so." }
    expect refused: "Source admits"
  end

  test "Notice cites the observations a coaching rests on" do
    tests "Notice", on: "Coaching"
    input coaching: { value: "c-1" }, role: { value: "coder" }, kind: { value: "stumble" },
          pattern: { value: "Cannot run another repo's specs." }, evidence: [{ value: "obs-1" }]
    expect emits: ["Noticed"], status: "noticed"
  end

  test "Notice refuses a coaching that cites no observation" do
    tests "Notice", on: "Coaching"
    input coaching: { value: "c-2" }, role: { value: "coder" }, kind: { value: "stumble" },
          pattern: { value: "Cannot run another repo's specs." }, evidence: []
    expect refused: "at least one observation"
  end

  test "Advise states the change for a coaching that touches no vow" do
    tests "Advise", on: "Coaching"
    setup "Coach::Coaching.Notice", coaching: { value: "c-3" }, role: { value: "coder" }, kind: { value: "stumble" },
          pattern: { value: "Stops short of landing." }, evidence: [{ value: "obs-1" }]
    input coaching: "c-3", change: { value: "Add the landing step to its brief." }, touches: { value: "none" }
    expect emits: ["Advised"], status: "advised"
  end

  test "Advise refuses a change touching a vow, which is the owner's to decide" do
    tests "Advise", on: "Coaching"
    setup "Coach::Coaching.Notice", coaching: { value: "c-4" }, role: { value: "crew" }, kind: { value: "value" },
          pattern: { value: "Direct dispatch past the cap." }, evidence: [{ value: "obs-1" }]
    input coaching: "c-4", change: { value: "Change a vow." }, touches: { value: "vow" }
    expect refused: "owner's to decide"
  end

  test "Refer sends a vow to the owner" do
    tests "Refer", on: "Coaching"
    setup "Coach::Coaching.Notice", coaching: { value: "c-5" }, role: { value: "crew" }, kind: { value: "value" },
          pattern: { value: "Direct dispatch past the cap." }, evidence: [{ value: "obs-1" }]
    input coaching: "c-5", touches: { value: "vow" }
    expect emits: ["Referred"], status: "referred"
  end

  test "Refer refuses what touches no vow" do
    tests "Refer", on: "Coaching"
    setup "Coach::Coaching.Notice", coaching: { value: "c-6" }, role: { value: "coder" }, kind: { value: "stumble" },
          pattern: { value: "Stops short." }, evidence: [{ value: "obs-1" }]
    input coaching: "c-6", touches: { value: "none" }
    expect refused: "touches a vow"
  end

  test "Advise carries the declared row she would add" do
    tests "Advise", on: "Coaching"
    setup "Coach::Coaching.Notice", coaching: { value: "c-7" }, role: { value: "coder" }, kind: { value: "stumble" },
          pattern: { value: "Stops short." }, evidence: [{ value: "obs-1" }]
    input coaching: "c-7", change: { value: "Name the step." }, touches: { value: "none" },
          proposed_row: { value: "member role: coder, rule: land before ending" }
    expect emits: ["Advised"], status: "advised"
  end

  test "Ask puts a question to Miette and stands asked" do
    tests "Ask", on: "Relay"
    input relay: { value: "r-1" }, question: { value: "What did you see in the landings?" }
    expect emits: ["Asked"], status: "asked"
  end

  test "Forward relays her words labelled as hers" do
    tests "Forward", on: "Relay"
    setup "Coach::Relay.Ask", relay: { value: "r-2" }, question: { value: "What did you see?" }
    input relay: "r-2", words: { value: "Three runs stopped before landing." }, author: { value: "miette" }
    expect emits: ["Answered"], status: "answered"
  end

  test "Forward refuses words under any name but hers" do
    tests "Forward", on: "Relay"
    setup "Coach::Relay.Ask", relay: { value: "r-3" }, question: { value: "What did you see?" }
    input relay: "r-3", words: { value: "She would say so." }, author: { value: "coach" }
    expect refused: "Author admits"
  end

  test "Decline answers nothing in her place" do
    tests "Decline", on: "Relay"
    setup "Coach::Relay.Ask", relay: { value: "r-4" }, question: { value: "What did you see?" }
    input relay: "r-4"
    expect emits: ["Declined"], status: "declined"
  end

  test "Invite asks one live run to a one-on-one" do
    tests "Invite", on: "OneOnOne"
    input one_on_one: { value: "m-1" }, coach: { value: "miette" }, run: { value: "run-1" }, role: { value: "coder" }, red_flag: { value: "clear" },
          run_state: { value: "free" }, meetings_open: { value: "none" }, role_met_today: { value: "no" }
    expect emits: ["Invited"], status: "invited"
  end

  test "Invite is refused while a red flag stands" do
    tests "Invite", on: "OneOnOne"
    input one_on_one: { value: "m-2" }, coach: { value: "miette" }, run: { value: "run-1" }, role: { value: "coder" },
          red_flag: { value: "standing" }, run_state: { value: "free" }, meetings_open: { value: "none" }, role_met_today: { value: "no" }
    expect refused: "red flag"
  end

  test "Invite is refused for a run fixing a red item or in a landing" do
    tests "Invite", on: "OneOnOne"
    input one_on_one: { value: "m-3" }, coach: { value: "miette" }, run: { value: "run-1" }, role: { value: "coder" },
          red_flag: { value: "clear" }, run_state: { value: "landing" }, meetings_open: { value: "none" }, role_met_today: { value: "no" }
    expect refused: "fixing a red item"
  end

  test "Invite is refused while another meeting is open" do
    tests "Invite", on: "OneOnOne"
    input one_on_one: { value: "m-4" }, coach: { value: "miette" }, run: { value: "run-1" }, role: { value: "coder" },
          red_flag: { value: "clear" }, run_state: { value: "free" }, meetings_open: { value: "open" }, role_met_today: { value: "no" }
    expect refused: "one meeting"
  end

  test "Invite is refused for a role already met today" do
    tests "Invite", on: "OneOnOne"
    input one_on_one: { value: "m-5" }, coach: { value: "miette" }, run: { value: "run-1" }, role: { value: "coder" },
          red_flag: { value: "clear" }, run_state: { value: "free" }, meetings_open: { value: "none" }, role_met_today: { value: "yes" }
    expect refused: "once a day"
  end

  test "Accept opens the meeting after the checkpoint" do
    tests "Accept", on: "OneOnOne"
    setup "Coach::OneOnOne.Invite", one_on_one: { value: "m-6" }, coach: { value: "miette" }, run: { value: "run-1" }, role: { value: "coder" }, red_flag: { value: "clear" },
          run_state: { value: "free" }, meetings_open: { value: "none" }, role_met_today: { value: "no" }
    input one_on_one: "m-6", checkpoint: { value: "done" }
    expect emits: ["Accepted"], status: "accepted"
  end

  test "Accept is refused until the checkpoint is done" do
    tests "Accept", on: "OneOnOne"
    setup "Coach::OneOnOne.Invite", one_on_one: { value: "m-7" }, coach: { value: "miette" }, run: { value: "run-1" }, role: { value: "coder" }, red_flag: { value: "clear" },
          run_state: { value: "free" }, meetings_open: { value: "none" }, role_met_today: { value: "no" }
    input one_on_one: "m-7", checkpoint: { value: "pending" }
    expect refused: "checkpoint is done"
  end

  test "Decline records the reason and the run goes back to work" do
    tests "Decline", on: "OneOnOne"
    setup "Coach::OneOnOne.Invite", one_on_one: { value: "m-8" }, coach: { value: "miette" }, run: { value: "run-1" }, role: { value: "coder" }, red_flag: { value: "clear" },
          run_state: { value: "free" }, meetings_open: { value: "none" }, role_met_today: { value: "no" }
    input one_on_one: "m-8", reason: { value: "Mid-review." }
    expect emits: ["InvitationDeclined"], status: "declined"
  end

  test "Defer holds the invitation until a later time" do
    tests "Defer", on: "OneOnOne"
    setup "Coach::OneOnOne.Invite", one_on_one: { value: "m-9" }, coach: { value: "miette" }, run: { value: "run-1" }, role: { value: "coder" }, red_flag: { value: "clear" },
          run_state: { value: "free" }, meetings_open: { value: "none" }, role_met_today: { value: "no" }
    input one_on_one: "m-9", until: { value: "2026-11-21T10:00" }
    expect emits: ["Deferred"], status: "deferred"
  end

  test "Reinvite returns a deferred invitation to invited" do
    tests "Reinvite", on: "OneOnOne"
    setup "Coach::OneOnOne.Invite", one_on_one: { value: "m-10" }, coach: { value: "miette" }, run: { value: "run-1" }, role: { value: "coder" }, red_flag: { value: "clear" },
          run_state: { value: "free" }, meetings_open: { value: "none" }, role_met_today: { value: "no" }
    setup "Coach::OneOnOne.Defer", one_on_one: "m-10", until: { value: "2026-11-21T10:00" }
    input one_on_one: "m-10"
    expect emits: ["Reinvited"], status: "invited"
  end

  test "Lapse defers an invitation whose checkpoint ran past its limit" do
    tests "Lapse", on: "OneOnOne"
    setup "Coach::OneOnOne.Invite", one_on_one: { value: "m-11" }, coach: { value: "miette" }, run: { value: "run-1" }, role: { value: "coder" }, red_flag: { value: "clear" },
          run_state: { value: "free" }, meetings_open: { value: "none" }, role_met_today: { value: "no" }
    input one_on_one: "m-11"
    expect emits: ["Lapsed"], status: "deferred"
  end

  test "Say records one turn verbatim under its prompt" do
    tests "Say", on: "Turn"
    input turn: { value: "m-12-1" }, one_on_one: { value: "m-12" }, number: { value: "1" }, prompt: { value: "going_well" },
          words: { value: "Reviews come back fast." }
    expect emits: ["Said"]
  end

  test "Say refuses a fifth turn, the meeting's budget" do
    tests "Say", on: "Turn"
    input turn: { value: "m-13-5" }, one_on_one: { value: "m-13" }, number: { value: "5" }, prompt: { value: "follow_up" },
          words: { value: "One more." }
    expect refused: "Number admits"
  end

  test "Say refuses a prompt but the two and their follow-up" do
    tests "Say", on: "Turn"
    input turn: { value: "m-14-1" }, one_on_one: { value: "m-14" }, number: { value: "1" }, prompt: { value: "orders" },
          words: { value: "Do this." }
    expect refused: "Prompt admits"
  end

  test "Propose records an ask a run makes for the lead" do
    tests "Propose", on: "Proposal"
    input proposal: { value: "p-1" }, one_on_one: { value: "m-15" }, ask: { value: "A longer review window." }
    expect emits: ["Proposed"], status: "proposed"
  end

  test "Close ends a held meeting and carries the resume note" do
    tests "Close", on: "OneOnOne"
    setup "Coach::OneOnOne.Invite", one_on_one: { value: "m-16" }, coach: { value: "miette" }, run: { value: "run-1" }, role: { value: "coder" }, red_flag: { value: "clear" },
          run_state: { value: "free" }, meetings_open: { value: "none" }, role_met_today: { value: "no" }
    setup "Coach::OneOnOne.Accept", one_on_one: "m-16", checkpoint: { value: "done" }
    input one_on_one: "m-16", resume_note: { value: "Back to the landing step." }
    expect emits: ["OneOnOneHeld"], status: "closed"
  end

  test "Close is refused for a meeting never accepted" do
    tests "Close", on: "OneOnOne"
    setup "Coach::OneOnOne.Invite", one_on_one: { value: "m-17" }, coach: { value: "miette" }, run: { value: "run-1" }, role: { value: "coder" }, red_flag: { value: "clear" },
          run_state: { value: "free" }, meetings_open: { value: "none" }, role_met_today: { value: "no" }
    input one_on_one: "m-17", resume_note: { value: "Back to work." }
    expect refused: "Close"
  end
end
