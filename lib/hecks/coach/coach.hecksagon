# The Coach bluebook, bound so it boots alone, persisted in Memory. No read ports yet: Miette asks
# the owner for tickets.db and event-stream access, and a port waits for its adapter.
Hecks.hecksagon "Coach" do
  attaches "Governance"
  persisted_by "Memory"
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
