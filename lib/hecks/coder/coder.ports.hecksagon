# The port Coder declares, for every hecksagon that attaches the bluebook (`Bluebooks` loads this
# file with it). The end of a turn asks the TurnFacts port, which measures what the bluebook cannot
# read: the run, its Work item, a landing since the item started, the session's closing message,
# and an answer or verdict to the coder not yet read. A submission asks it whether an answer to the
# coder its branch is named for is unread. It judges none of it; a reading it cannot take is
# refused, and the turn then ends or the submission is accepted.
Hecks.hecksagon "Coder" do
  Coder::Turn.port "TurnFacts" do
    asks "MeasureTurn", to: Turn do
      attribute :run, TurnRun
      answers "TurnMeasured"
      refuses "TurnUnmeasured"
    end
  end

  # The same port, so the one TurnFacts adapter answers both: a port's asks reach only the
  # aggregate it is declared on.
  Coder::Submission.port "TurnFacts" do
    asks "MeasureSubmitter", to: Submission do
      attribute :branch,   SubmissionBranch
      attribute :sha,      SubmissionSha
      attribute :checkout, SubmissionCheckout
      answers "SubmitterMeasured"
      refuses "SubmitterUnmeasured"
    end
  end
end
