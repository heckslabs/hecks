# Binds the `PushDue` port of `PushNudge` to `PushDueReader`, which asks the rehearsal adapter's `Due`
# whether a push of local main is due. Required by name, not relative, so a copy of this directory shares
# the one implementation loaded.
require "hecks/quality_control/adapters/push_due_reader"

Hecks.adapter "PushDueReader" do
  port "PushDue"
end
