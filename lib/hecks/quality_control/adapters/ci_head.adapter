# Binds the `CiHead` port to `CiRunner`, which answers `Head`'s `Check` from the verdict GitHub
# reports for a commit.
# Required by name, not relative, so a copy of this directory shares the one implementation loaded.
require "hecks/ci_pipeline/adapters/ci_runner"

Hecks.adapter "CiRunner" do
  port "CiHead"
end
