# Binds the `TargetTools` port to `TargetTools`, which answers `Target`'s queries: the seed, generated domains, the miner, the novelty gate and the scan.
# Required by name, not relative, so a copy of this directory shares the one implementation loaded.
require "hecks/quality_control/adapters/target_tools"

Hecks.adapter "TargetTools" do
  port "TargetTools"
end
