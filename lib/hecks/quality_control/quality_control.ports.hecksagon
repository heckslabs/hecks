# The ports QualityControl declares, for every hecksagon that attaches the bluebook (`Bluebooks`
# loads this file with it). Persistence is the attaching hecksagon's: the Hecks bluebook binds
# every aggregate through its world's `default_adapter`, and the QA ledger binds its own
# (qa/bluebook/quality_control.hecksagon).
Hecks.hecksagon "QualityControl" do
  # Bound by adapters/github_issues. The port has to be declared even where no adapter binds it,
  # so FileWhenSubmitted has a target and model_check's deaf-policy check can see it.
  QualityControl::Ticket.port "IssueTracker" do
    asks "File", to: Ticket do
      answers "IssueFiled"
      refuses "IssueFilingRefused"
    end

    tells "Closed", to: Ticket do
      emits "IssueClosedUpstream"
    end
  end

  # Bound by adapters/github_checks. ClearOnPass and RefuseOnFail turn its answer into
  # Clearance::Passed/Failed.
  QualityControl::Clearance.port "CI" do
    asks "Run", to: Clearance do
      answers "SuitePassed"
      refuses "SuiteFailed"
    end
  end

  # Queries answered from outside the domain. The bluebook declares each question and the value
  # object its answer takes and never says who answers it; each `answers_query` binds it to the
  # `*Tools` port's adapter, which runs the script's own command and answers what it printed.
  QualityControl::Target.port "TargetTools" do
    answers_query "Seed"
    answers_query "CheckGeneratedDomains"
    answers_query "MineCombinations"
    answers_query "Mutate"
    answers_query "JudgeNovelty"
    answers_query "DiscoverExternalDomains"
  end

  QualityControl::Sweep.port "SweepTools" do
    answers_query "Tick"
    answers_query "Run"
    answers_query "MigrateLedgerFromHeki"
    answers_query "CreateLedgerRole"
    answers_query "Race"
  end

  QualityControl::Angle.port "AngleTools" do
    answers_query "Seed"
  end

  QualityControl::Clearance.port "ClearanceTools" do
    answers_query "CheckPullRequests"
  end

  # Remote CI's verdict on one commit of a repository's main, answered by `adapters/ci_head`, which
  # reads the
  # runs GitHub reports for the commit. A run still going is a refusal: no verdict until every job
  # settled.
  QualityControl::Head.port "CiHead" do
    asks "Check", to: Head do
      attribute :branch, HeadBranch
      attribute :repo,   HeadRepo
      answers "HeadChecked"
      refuses "HeadRefused"
    end
  end

  # Answered by `adapters/image_roll`: the classifier reads remote CI's green commit's change set
  # and the
  # quick gate on record, and the roll runs the console image's deploy. A refusal ends the chain.
  QualityControl::ImageRoll.port "ImageRoll" do
    asks "Classify", to: ImageRoll do
      attribute :branch, RollBranch
      attribute :repo,   RollRepo
      answers "ImageClassified"
      refuses "ClassifyRefused"
    end

    asks "Roll", to: ImageRoll do
      attribute :app, AppName
      answers "RollAnswered"
      refuses "RollRefused"
    end
  end

  # Answered by `adapters/main_maintenance`: the quick gate on main, the reconcile, and the push through the
  # train. Each answers the event its policy waits for, or refuses with a named event and stops the run.
  QualityControl::Maintenance.port "MainMaintenance" do
    asks "Gate", to: Maintenance do
      answers "GateVerdict"
      refuses "GateRefused"
    end

    asks "Reconcile", to: Maintenance do
      answers "ReconcileDone"
      refuses "ReconcileRefused"
    end

    asks "Push", to: Maintenance do
      answers "Pushed"
      refuses "PushRefused"
    end
  end
end
