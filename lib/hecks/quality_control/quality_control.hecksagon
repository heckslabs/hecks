# The QualityControl bluebook, bound so it boots standing alone (a fuzz or model_check boot of this
# directory). The QA ledger binds PostgresEra in qa/bluebook/quality_control.hecksagon, and the
# Hecks bluebook binds it through its world's `default_adapter`; the ports every one of them shares
# are in quality_control.ports.hecksagon.
Hecks.hecksagon "QualityControl" do
  attaches "Governance"
  persisted_by "Memory"

  # The fixer's steps, which the ledger records as the bug's state. Declarative: the Fixer domain
  # emits them, and the Record policies above react.
  subscribe "Fixer.AttemptClaimed"
  subscribe "Fixer.AttemptInvestigated"
  subscribe "Fixer.FixReady"
  subscribe "Fixer.FixVerified"

  # The coder's submitted branch, which starts the main maintenance run. Declarative: the Coder domain
  # emits it, and the StartOnSubmission policy reacts.
  subscribe "Coder.WorkSubmitted"
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
