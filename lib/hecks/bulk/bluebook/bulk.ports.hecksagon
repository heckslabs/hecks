# The port Bulk declares, for every hecksagon that attaches the bluebook (`Bluebooks` loads this file
# with it). `Sweep` sends the run's command to every row and answers each row's outcome, or refuses
# the run with a reason (a mode the store cannot honour, a verb or query that does not resolve).
# adapters/row_sweeper.adapter binds it.
Hecks.hecksagon "Bulk" do
  Bulk::BulkRun.port "Rows" do
    asks "Sweep", to: BulkRun do
      attribute :run, RunKey
      answers "BulkRunSwept"
      refuses "BulkRunRefused"
    end
  end
end
