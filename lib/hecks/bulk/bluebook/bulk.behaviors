Hecks.behaviors "Bulk" do
  vision "A bulk run names a command and a query in full, and is declined when its command cannot be sent."

  loads "bulk.bluebook", "../../framework/bluebook/governance.bluebook", "bulk.hecksagon", "bulk.ports.hecksagon",
        "adapters/row_sweeper.adapter"

  test "Request refuses a command that is not fully qualified" do
    tests "Request", on: "BulkRun"
    input run: { value: "b2" }, verb: { value: "Cancel" }, over: { value: "Shop::Order.Open" }
    expect refused: "must match"
  end

  test "Request declines a run whose command no loaded bluebook declares" do
    tests "Request", on: "BulkRun"
    input run: { value: "b3" }, verb: { value: "Shop::Order.Cancel" }, over: { value: "Shop::Order.Open" }
    expect status: "declined"
  end
end
