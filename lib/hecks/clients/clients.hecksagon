# The Clients bluebook, bound so it boots standing alone. Nothing of a client is stored in a Hecks
# database: the aggregates live in memory, and a client's record belongs in the client's own repo.
Hecks.hecksagon "Clients" do
  attaches "Governance"
  persisted_by "Memory"
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
