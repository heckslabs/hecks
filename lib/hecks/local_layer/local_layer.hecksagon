# The LocalLayer domain, bound so it boots standing alone. Edits and batches are held in Memory;
# the journal port keeps each edit on disk so a restart does not lose a recorded edit.
Hecks.hecksagon "LocalLayer" do
  attaches "Governance"
  persisted_by "Memory"

  # The outside an edit reaches: the journal file, append-only. The port never edits a line; a
  # withdrawal is a record of its own.
  LocalLayer::Edit.port "Journaling" do
    asks "Append", to: Edit do
      attribute :run, EditKey
      answers "EditJournaled"
      refuses "EditJournalRefused"
    end
  end

  # The outside a sealed batch reaches: the target's text and the journal. Diff applies the
  # batch's gathered edits to a copy of the target and answers the digest of the diff; Check
  # recomputes that diff, refuses when it is not the one shown, and loads the patched copy under
  # the validators. Neither writes the target: applying is the pipeline's.
  LocalLayer::Batch.port "Previewing" do
    asks "Diff", to: Batch do
      attribute :run,    BatchRun
      attribute :target, Target
      answers "DiffComputed"
      refuses "DiffRefused"
    end

    asks "Check", to: Batch do
      attribute :run,    BatchRun
      attribute :target, Target
      attribute :diff,   Digest
      answers "ChecksPassed"
      refuses "ChecksFailed"
    end
  end
end

Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
