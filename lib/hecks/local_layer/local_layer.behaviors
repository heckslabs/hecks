Hecks.behaviors "LocalLayer" do
  vision "A bluebook is edited locally as recorded typed edits, and the pipeline takes them as one batch, shown as a diff and checked first."

  loads "local_layer.bluebook", "local_layer.hecksagon"

  test "an edit is recorded as a typed change to a named bluebook" do
    tests "Record", on: "Edit"
    input run: { value: "edit-1" }, target: { value: "lib/hecks/triage/triage.bluebook" },
          operation: { value: "AddTransition" }, subject: { value: "Incident.status" }, detail: { value: "reopen" }
    expect emits: %w[EditRecorded EditJournalRefused], status: "recorded"
  end

  test "an edit that is no known operation is not recorded" do
    tests "Record", on: "Edit"
    input run: { value: "edit-1" }, target: { value: "lib/hecks/triage/triage.bluebook" },
          operation: { value: "Rewrite" }, subject: { value: "Incident.status" }, detail: { value: "reopen" }
    expect refused: "admits"
  end

  test "an edit the journal has not kept is not gathered into a batch" do
    tests "Gather", on: "Edit"
    setup "LocalLayer::Edit.Record", run: { value: "edit-1" }, target: { value: "lib/hecks/triage/triage.bluebook" },
          operation: { value: "AddMark" }, subject: { value: "Incident.status" }, detail: { value: "terminal" }
    input run: { value: "edit-1" }, batch: { value: "sprint-9" }
    expect refused: "journal"
  end

  test "a journaled edit is gathered into a batch" do
    tests "Gather", on: "Edit"
    setup "LocalLayer::Edit.Record", run: { value: "edit-1" }, target: { value: "lib/hecks/triage/triage.bluebook" },
          operation: { value: "AddMark" }, subject: { value: "Incident.status" }, detail: { value: "terminal" }
    setup "LocalLayer::Edit.Journal", run: { value: "edit-1" }
    input run: { value: "edit-1" }, batch: { value: "sprint-9" }
    expect emits: %w[EditGathered EditJournalRefused], status: "batched"
  end

  # No journal adapter is bound in a behaviors boot, so the port answers EditJournalRefused.
  test "a withdrawn edit is a lifecycle step, the journal keeps its record" do
    tests "Withdraw", on: "Edit"
    setup "LocalLayer::Edit.Record", run: { value: "edit-1" }, target: { value: "lib/hecks/triage/triage.bluebook" },
          operation: { value: "AddMark" }, subject: { value: "Incident.status" }, detail: { value: "terminal" }
    input run: { value: "edit-1" }
    expect emits: %w[EditWithdrawn EditJournalRefused], status: "withdrawn"
  end

  test "a batch opens at the end of a sprint against the target's digest" do
    tests "Open", on: "Batch"
    input run: { value: "sprint-9" }, target: { value: "lib/hecks/triage/triage.bluebook" },
          base: { value: "ab12" }, trigger: { value: "sprint_end" }
    expect emits: ["BatchOpened"], status: "open"
  end

  test "an empty batch is not sealed" do
    tests "Seal", on: "Batch"
    setup "LocalLayer::Batch.Open", run: { value: "sprint-9" }, target: { value: "lib/hecks/triage/triage.bluebook" },
          base: { value: "ab12" }, trigger: { value: "sprint_end" }
    input run: { value: "sprint-9" }, target: { value: "lib/hecks/triage/triage.bluebook" }, edits: { value: 0 }
    expect refused: "edit"
  end

  # The stand-in in behavior_adapters/ answers the Previewing port: it diffs every target to "cd34"
  # and passes every check, except that it cannot read lib/missing.bluebook and fails the checks
  # of lib/broken.bluebook.
  test "a sealed batch is shown as a diff and checked" do
    tests "Seal", on: "Batch"
    setup "LocalLayer::Batch.Open", run: { value: "sprint-9" }, target: { value: "lib/hecks/triage/triage.bluebook" },
          base: { value: "ab12" }, trigger: { value: "sprint_end" }
    input run: { value: "sprint-9" }, target: { value: "lib/hecks/triage/triage.bluebook" }, edits: { value: 2 }
    expect emits: %w[BatchSealed DiffComputed DiffShown ChecksPassed ChecksRecorded], status: "checked"
  end

  test "a batch whose diff cannot be made is refused" do
    tests "Seal", on: "Batch"
    setup "LocalLayer::Batch.Open", run: { value: "sprint-9" }, target: { value: "lib/missing.bluebook" },
          base: { value: "ab12" }, trigger: { value: "sprint_end" }
    input run: { value: "sprint-9" }, target: { value: "lib/missing.bluebook" }, edits: { value: 2 }
    expect emits: %w[BatchSealed DiffRefused BatchRefused], status: "refused"
  end

  test "a batch whose checks failed is refused" do
    tests "Seal", on: "Batch"
    setup "LocalLayer::Batch.Open", run: { value: "sprint-9" }, target: { value: "lib/broken.bluebook" },
          base: { value: "ab12" }, trigger: { value: "sprint_end" }
    input run: { value: "sprint-9" }, target: { value: "lib/broken.bluebook" }, edits: { value: 2 }
    expect emits: %w[BatchSealed DiffComputed DiffShown ChecksFailed BatchRefused], status: "refused"
  end

  test "a batch is applied only against the diff that was shown" do
    tests "Apply", on: "Batch"
    setup "LocalLayer::Batch.Open", run: { value: "sprint-9" }, target: { value: "lib/hecks/triage/triage.bluebook" },
          base: { value: "ab12" }, trigger: { value: "sprint_end" }
    setup "LocalLayer::Batch.Seal", run: { value: "sprint-9" }, target: { value: "lib/hecks/triage/triage.bluebook" }, edits: { value: 2 }
    input run: { value: "sprint-9" }, target: { value: "lib/hecks/triage/triage.bluebook" }, confirmed: { value: "ee99" }, current: { value: "ab12" }
    expect refused: "diff"
  end

  test "a batch is not applied when the target moved since it was opened" do
    tests "Apply", on: "Batch"
    setup "LocalLayer::Batch.Open", run: { value: "sprint-9" }, target: { value: "lib/hecks/triage/triage.bluebook" },
          base: { value: "ab12" }, trigger: { value: "sprint_end" }
    setup "LocalLayer::Batch.Seal", run: { value: "sprint-9" }, target: { value: "lib/hecks/triage/triage.bluebook" }, edits: { value: 2 }
    input run: { value: "sprint-9" }, target: { value: "lib/hecks/triage/triage.bluebook" }, confirmed: { value: "cd34" }, current: { value: "ff00" }
    expect refused: "moved"
  end

  test "a diffed, checked batch is applied against the diff shown" do
    tests "Apply", on: "Batch"
    setup "LocalLayer::Batch.Open", run: { value: "sprint-9" }, target: { value: "lib/hecks/triage/triage.bluebook" },
          base: { value: "ab12" }, trigger: { value: "sprint_end" }
    setup "LocalLayer::Batch.Seal", run: { value: "sprint-9" }, target: { value: "lib/hecks/triage/triage.bluebook" }, edits: { value: 2 }
    input run: { value: "sprint-9" }, target: { value: "lib/hecks/triage/triage.bluebook" }, confirmed: { value: "cd34" }, current: { value: "ab12" }
    expect emits: %w[BatchApplied TargetWritten], status: "applied"
  end

  # The stand-in in behavior_adapters/ answers the Applying port: it writes nothing, and refuses
  # lib/unwritable.bluebook.
  test "a batch whose target cannot be written is refused" do
    tests "Apply", on: "Batch"
    setup "LocalLayer::Batch.Open", run: { value: "sprint-9" }, target: { value: "lib/unwritable.bluebook" },
          base: { value: "ab12" }, trigger: { value: "sprint_end" }
    setup "LocalLayer::Batch.Seal", run: { value: "sprint-9" }, target: { value: "lib/unwritable.bluebook" }, edits: { value: 2 }
    input run: { value: "sprint-9" }, target: { value: "lib/unwritable.bluebook" }, confirmed: { value: "cd34" }, current: { value: "ab12" }
    expect emits: %w[BatchApplied TargetWriteRefused BatchRefused], status: "refused"
  end
end
