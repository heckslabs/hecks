Hecks.behaviors "Roundhouse" do
  vision "Every example is one law or one incident of 2026-11-18 and 2026-11-19: given a session or a reading, when Roundhouse acts, then what it records."

  # Given is each test's setup; When is the command; Then is the expectation. Roundhouse decides
  # nothing: each session here was admitted by Signalbox, whose admission key it carries.
  loads "roundhouse.bluebook", "roundhouse.hecksagon", "roundhouse.ports.hecksagon"

  # ---- Law 5: every session closes its circuit ----

  test "law 5: a session starts with its admission, labels and fuse" do
    tests "Start", on: "Session"
    input session: { value: "coder-signalbox" }, admission: { value: "coder-signalbox" }, role: { value: "coder" },
          owner: { value: "signalbox-five-laws-adr" }, purpose: { value: "write the ADR" }, ends_when: { value: "the branch lands" },
          fuse: { value: 4096 }, fuse_minutes: { value: 240 }
    expect emits: ["SessionStarted"], status: "running"
  end

  # Incident: about 20 handrun-* and orchestrator-seat-* sessions were started with no admission.
  test "Roundhouse never starts a session on its own" do
    tests "Start", on: "Session"
    input session: { value: "handrun-orchestrator-3" }, admission: { value: "" }, role: { value: "orchestrator" },
          owner: { value: "liveness-keepalive" }, purpose: { value: "keep the seat alive" }, ends_when: { value: "the owner stops it" },
          fuse: { value: 1024 }, fuse_minutes: { value: 1440 }
    expect refused: "a session starts only under an admission"
  end

  test "an unlabeled session is never started" do
    tests "Start", on: "Session"
    input session: { value: "exe-hecks" }, admission: { value: "exe-hecks" }, role: { value: "helper" },
          owner: { value: "" }, purpose: { value: "run a command" }, ends_when: { value: "the command returns" },
          fuse: { value: 1024 }, fuse_minutes: { value: 30 }
    expect refused: "a session names its owner, its purpose and its end condition"
  end

  test "a session with no fuse is never started" do
    tests "Start", on: "Session"
    input session: { value: "coder-unfused" }, admission: { value: "coder-unfused" }, role: { value: "coder" },
          owner: { value: "signalbox-five-laws-adr" }, purpose: { value: "write the ADR" }, ends_when: { value: "the branch lands" },
          fuse: { value: 0 }, fuse_minutes: { value: 240 }
    expect refused: "a session's fuse has a memory and a time rating"
  end

  # ---- Protection, the smallest breaker: each session's own fuse ----

  test "a session that draws past its memory rating blows its own fuse" do
    tests "Meter", on: "Session"
    setup "Roundhouse::Session.Start", session: { value: "coder-2" }, admission: { value: "coder-2" }, role: { value: "coder" },
          owner: { value: "pipeline-board-tiles" }, purpose: { value: "add a tile" }, ends_when: { value: "the branch lands" },
          fuse: { value: 4096 }, fuse_minutes: { value: 240 }
    input session: "coder-2", drawn: { value: 5200 }, minutes: { value: 40 }, rated: { value: 4096 }, rated_minutes: { value: 240 }
    expect emits: %w[SessionMetered SessionFuseBlown], status: "blown"
  end

  # Incident: phantom load, about 40 sessions showing as working for 7 items. A helper that runs
  # past its time rating blows its fuse instead of holding memory for nothing.
  test "phantom load: a helper past its time rating blows its fuse" do
    tests "Meter", on: "Session"
    setup "Roundhouse::Session.Start", session: { value: "stall-check-12" }, admission: { value: "stall-check-12" },
          role: { value: "helper" }, owner: { value: "orchestrator" }, purpose: { value: "check a quiet coder" },
          ends_when: { value: "the check reports" }, fuse: { value: 1024 }, fuse_minutes: { value: 30 }
    input session: "stall-check-12", drawn: { value: 280 }, minutes: { value: 190 }, rated: { value: 1024 }, rated_minutes: { value: 30 }
    expect emits: %w[SessionMetered SessionFuseBlown], status: "blown"
  end

  test "a session within its fuse is only metered" do
    tests "Meter", on: "Session"
    setup "Roundhouse::Session.Start", session: { value: "coder-3" }, admission: { value: "coder-3" }, role: { value: "coder" },
          owner: { value: "pipeline-board-tiles" }, purpose: { value: "add a tile" }, ends_when: { value: "the branch lands" },
          fuse: { value: 4096 }, fuse_minutes: { value: 240 }
    input session: "coder-3", drawn: { value: 1500 }, minutes: { value: 40 }, rated: { value: 4096 }, rated_minutes: { value: 240 }
    expect emits: ["SessionMetered"], status: "running"
  end

  test "a meter reading records the session's item, processor draw and idle time" do
    tests "Meter", on: "Session"
    setup "Roundhouse::Session.Start", session: { value: "coder-6" }, admission: { value: "coder-6" }, role: { value: "coder" },
          owner: { value: "pipeline-board-tiles" }, purpose: { value: "add a tile" }, ends_when: { value: "the branch lands" },
          fuse: { value: 4096 }, fuse_minutes: { value: 240 }
    input session: "coder-6", drawn: { value: 1500 }, minutes: { value: 40 }, rated: { value: 4096 }, rated_minutes: { value: 240 },
          item: { value: "roundhouse-meters-every-session" }, cpu: { value: 85 }, idle: { value: 3 }
    expect emits: ["SessionMetered"], status: "running"
  end

  test "a session without an item is still metered" do
    tests "Meter", on: "Session"
    setup "Roundhouse::Session.Start", session: { value: "helper-9" }, admission: { value: "helper-9" }, role: { value: "helper" },
          owner: { value: "orchestrator" }, purpose: { value: "check a coder" }, ends_when: { value: "the check reports" },
          fuse: { value: 1024 }, fuse_minutes: { value: 30 }
    input session: "helper-9", drawn: { value: 280 }, minutes: { value: 5 }, rated: { value: 1024 }, rated_minutes: { value: 30 },
          item: { value: "" }, cpu: { value: 0 }, idle: { value: 0 }
    expect emits: ["SessionMetered"], status: "running"
  end

  test "a meter reading that names another fuse is refused" do
    tests "Meter", on: "Session"
    setup "Roundhouse::Session.Start", session: { value: "coder-4" }, admission: { value: "coder-4" }, role: { value: "coder" },
          owner: { value: "pipeline-board-tiles" }, purpose: { value: "add a tile" }, ends_when: { value: "the branch lands" },
          fuse: { value: 4096 }, fuse_minutes: { value: 240 }
    input session: "coder-4", drawn: { value: 5200 }, minutes: { value: 40 }, rated: { value: 8192 }, rated_minutes: { value: 240 }
    expect refused: "a meter reading names the session's own fuse"
  end

  # ---- Law 3, carried out: rest and resume ----

  test "a rested coder resumes under a new admission" do
    tests "Resume", on: "Session"
    setup "Roundhouse::Session.Start", session: { value: "coder-5" }, admission: { value: "coder-5" }, role: { value: "coder" },
          owner: { value: "pipeline-board-tiles" }, purpose: { value: "add a tile" }, ends_when: { value: "the branch lands" },
          fuse: { value: 4096 }, fuse_minutes: { value: 240 }
    setup "Roundhouse::Session.Rest", session: "coder-5"
    input session: "coder-5", admission: { value: "coder-5-again" }
    expect emits: ["SessionResumed"], status: "running"
  end

  # ---- Reaping: the draw returns, the work is kept ----

  test "a finished session with nothing unsaved is reaped" do
    tests "Reap", on: "Session"
    setup "Roundhouse::Session.Start", session: { value: "reviewer-1" }, admission: { value: "reviewer-1" }, role: { value: "helper" },
          owner: { value: "signalbox-five-laws-adr" }, purpose: { value: "review the branch" }, ends_when: { value: "the verdict is given" },
          fuse: { value: 1024 }, fuse_minutes: { value: 30 }
    setup "Roundhouse::Session.Finish", session: "reviewer-1"
    input session: "reviewer-1", unsaved: { value: 0 }
    expect emits: ["SessionReaped"], status: "reaped"
  end

  test "a session with unsaved work is never reaped" do
    tests "Reap", on: "Session"
    setup "Roundhouse::Session.Start", session: { value: "coder-6" }, admission: { value: "coder-6" }, role: { value: "coder" },
          owner: { value: "pipeline-board-tiles" }, purpose: { value: "add a tile" }, ends_when: { value: "the branch lands" },
          fuse: { value: 4096 }, fuse_minutes: { value: 240 }
    setup "Roundhouse::Session.Finish", session: "coder-6"
    input session: "coder-6", unsaved: { value: 4 }
    expect refused: "a session with unsaved work is never reaped"
  end

  # ---- Law 2's input: the reading ----

  # Incident: the helper storm. 22 GB drawn of 36, with 8 GB kept for the person, leaves 6 GB.
  test "the helper storm's reading leaves 6 GB of headroom" do
    tests "Take", on: "Reading"
    input reading: { value: "m3-pro-2026-11-18T21:40" }, machine: { value: "m3-pro" }, capacity: { value: 36864 },
          drawn: { value: 22528 }, reserve: { value: 8192 }, headroom: { value: 6144 }
    expect emits: ["MachineRead"]
  end

  test "a reading whose headroom does not add up is refused" do
    tests "Take", on: "Reading"
    input reading: { value: "m3-pro-2026-11-18T21:41" }, machine: { value: "m3-pro" }, capacity: { value: 36864 },
          drawn: { value: 22528 }, reserve: { value: 8192 }, headroom: { value: 14336 }
    expect refused: "headroom is the capacity less the draw less the person's reserve"
  end

  # ---- The meter ----

  # Phantom load as the meter shows it: 7 productive sessions of 40 is a power factor under 0.2.
  test "the meter records the power factor of a window" do
    tests "Close", on: "Tally"
    input tally: { value: "2026-11-19T11" }, sessions: { value: 40 }, productive: { value: 7 }, landings: { value: 2 },
          gb_hours: { value: 22 }, reclaimed: { value: 0 }, curtailed: { value: 0 }, headroom: { value: 1024 }
    expect emits: ["TallyClosed"]
  end

  # Incident: 90 minutes of landings bounced on shared files; the meter counts them as curtailed.
  test "the meter records curtailment: finished work refused at landing" do
    tests "Close", on: "Tally"
    input tally: { value: "2026-11-18T13" }, sessions: { value: 9 }, productive: { value: 5 }, landings: { value: 0 },
          gb_hours: { value: 9 }, reclaimed: { value: 0 }, curtailed: { value: 6 }, headroom: { value: 7000 }
    expect emits: ["TallyClosed"]
  end

  test "a window never counts more productive sessions than sessions" do
    tests "Close", on: "Tally"
    input tally: { value: "2026-11-19T12" }, sessions: { value: 7 }, productive: { value: 9 }, landings: { value: 2 },
          gb_hours: { value: 6 }, reclaimed: { value: 14 }, curtailed: { value: 0 }, headroom: { value: 9000 }
    expect refused: "productive sessions are no more than all sessions"
  end

  # ---- What set a turn going ----

  test "a trigger kind is declared with its pattern and label" do
    tests "Declare", on: "TriggerKind"
    input kind: { value: "task-notification" }, pattern: { value: "<task-notification>" }, label: { value: "task notification" }
    expect emits: ["TriggerKindDeclared"]
  end

  test "a trigger kind with no pattern is never declared" do
    tests "Declare", on: "TriggerKind"
    input kind: { value: "blank" }, pattern: { value: "" }, label: { value: "blank" }
    expect refused: "a trigger kind names the pattern it matches"
  end

  # ---- One bus: Signalbox decides and Roundhouse carries it out ----

  # Roundhouse attaches Signalbox, so an admission reaches StartWhatSignalboxAdmitted. The session
  # is a record here: no port of Roundhouse starts or stops a process (ADR 0222, phase 2).
  test "one bus: the session Signalbox admits is started under its admission" do
    tests "Signalbox::Admission.Admit"
    input admission: { value: "reviewer-of-signalbox" }, role: { value: "helper" }, tier: { value: "normal" },
          owner: { value: "signalbox-five-laws-adr" }, purpose: { value: "review the branch" }, ends_when: { value: "the verdict is given" },
          draw: { value: 300 }, fuse: { value: 1024 }, fuse_minutes: { value: 30 }, asked_by: { value: "orchestrator" },
          switch: { value: "on" }, met: { value: "no" }, band: { value: "normal" }, headroom: { value: 9000 }, age: { value: 30 },
          stale_after: { value: 120 }, started: { value: 0 }, ramp: { value: 1 }, coders: { value: 3 }, helpers: { value: 2 },
          share: { value: 100 }, outranked: { value: 0 }, seats: { value: 1 }, unused_servers: { value: 0 }, curtailed: { value: 0 }
    expect emits: %w[SessionAdmitted SessionStarted]
  end

  # ---- The arms: a run is tagged with how its Work item was authored, and compared on the same change ----

  # The fixed history: two bluebook runs (input 100000 and 140000, mean 120000) and two direct runs
  # (300000 and 260000, mean 280000) on one change, and one run nobody tagged.
  test "a run with no tag is shown as untagged" do
    tests "Roundhouse::ArmRun.Untagged", kind: :query
    setup "Roundhouse::ArmRun.Record", run: { value: "r1" }, item: { value: "w-a" }, change: { value: "change-1" }, arm: { value: "bluebook" },
          input: { value: 100000 }, output: { value: 20000 }, cache: { value: 500000 }, minutes: { value: 30 },
          rounds: { value: 1 }, red_trains: { value: 0 }, defects: { value: 0 }
    setup "Roundhouse::ArmRun.Record", run: { value: "r2" }, item: { value: "w-b" }, change: { value: "change-1" }, arm: { value: "bluebook" },
          input: { value: 140000 }, output: { value: 30000 }, cache: { value: 600000 }, minutes: { value: 50 },
          rounds: { value: 2 }, red_trains: { value: 0 }, defects: { value: 1 }
    setup "Roundhouse::ArmRun.Record", run: { value: "r3" }, item: { value: "w-c" }, change: { value: "change-1" }, arm: { value: "direct" },
          input: { value: 300000 }, output: { value: 60000 }, cache: { value: 900000 }, minutes: { value: 90 },
          rounds: { value: 3 }, red_trains: { value: 1 }, defects: { value: 2 }
    setup "Roundhouse::ArmRun.Record", run: { value: "r4" }, item: { value: "w-d" }, change: { value: "change-1" }, arm: { value: "direct" },
          input: { value: 260000 }, output: { value: 50000 }, cache: { value: 800000 }, minutes: { value: 70 },
          rounds: { value: 2 }, red_trains: { value: 0 }, defects: { value: 0 }
    setup "Roundhouse::ArmRun.Record", run: { value: "r5" }, item: { value: "w-e" }, arm: { value: "untagged" },
          input: { value: 90000 }, output: { value: 10000 }, cache: { value: 0 }, minutes: { value: 20 },
          rounds: { value: 1 }, red_trains: { value: 0 }, defects: { value: 0 }
    expect count: 1
  end

  test "the tagged runs are listed apart from the untagged one" do
    tests "Roundhouse::ArmRun.ByArm", kind: :query
    setup "Roundhouse::ArmRun.Record", run: { value: "r1" }, item: { value: "w-a" }, change: { value: "change-1" }, arm: { value: "bluebook" },
          input: { value: 100000 }, output: { value: 20000 }, cache: { value: 500000 }, minutes: { value: 30 },
          rounds: { value: 1 }, red_trains: { value: 0 }, defects: { value: 0 }
    setup "Roundhouse::ArmRun.Record", run: { value: "r2" }, item: { value: "w-b" }, change: { value: "change-1" }, arm: { value: "bluebook" },
          input: { value: 140000 }, output: { value: 30000 }, cache: { value: 600000 }, minutes: { value: 50 },
          rounds: { value: 2 }, red_trains: { value: 0 }, defects: { value: 1 }
    setup "Roundhouse::ArmRun.Record", run: { value: "r3" }, item: { value: "w-c" }, change: { value: "change-1" }, arm: { value: "direct" },
          input: { value: 300000 }, output: { value: 60000 }, cache: { value: 900000 }, minutes: { value: 90 },
          rounds: { value: 3 }, red_trains: { value: 1 }, defects: { value: 2 }
    setup "Roundhouse::ArmRun.Record", run: { value: "r4" }, item: { value: "w-d" }, change: { value: "change-1" }, arm: { value: "direct" },
          input: { value: 260000 }, output: { value: 50000 }, cache: { value: 800000 }, minutes: { value: 70 },
          rounds: { value: 2 }, red_trains: { value: 0 }, defects: { value: 0 }
    setup "Roundhouse::ArmRun.Record", run: { value: "r5" }, item: { value: "w-e" }, arm: { value: "untagged" },
          input: { value: 90000 }, output: { value: 10000 }, cache: { value: 0 }, minutes: { value: 20 },
          rounds: { value: 1 }, red_trains: { value: 0 }, defects: { value: 0 }
    expect count: 5
  end

  test "an arm that is not bluebook, direct or untagged is refused" do
    tests "Record", on: "ArmRun"
    input run: { value: "r6" }, item: { value: "w-f" }, arm: { value: "handmade" }, input: { value: 1 }, output: { value: 1 },
          cache: { value: 0 }, minutes: { value: 1 }, rounds: { value: 0 }, red_trains: { value: 0 }, defects: { value: 0 }
    expect refused: "a run is bluebook, direct or untagged"
  end

  test "an untagged run cannot claim a matched change" do
    tests "Record", on: "ArmRun"
    input run: { value: "r7" }, item: { value: "w-g" }, change: { value: "change-1" }, arm: { value: "untagged" }, input: { value: 1 },
          output: { value: 1 }, cache: { value: 0 }, minutes: { value: 1 }, rounds: { value: 0 }, red_trains: { value: 0 },
          defects: { value: 0 }
    expect refused: "a run with a matched change is tagged, never untagged"
  end

  # Known per-arm difference: 280000 less 120000 is 160000 tokens saved per landed item.
  test "the arms differ by a known number of input tokens per landed item" do
    tests "Compare", on: "ArmComparison"
    input comparison: { value: "change-1:input" }, measure: { value: "input" }, bluebook_runs: { value: 2 }, direct_runs: { value: 2 },
          bluebook: { value: 120000 }, direct: { value: 280000 }, reading: { value: "reading" }, difference: { value: 160000 },
          authoring: { value: 400000 }, break_even: { value: 3 }
    expect emits: ["ArmCompared"]
  end

  # Known break-even: 400000 of authoring over 160000 saved per item is 2.5, so 3 changes.
  test "a break-even that is not the authoring cost over the difference, rounded up, is refused" do
    tests "Compare", on: "ArmComparison"
    input comparison: { value: "change-1:input" }, measure: { value: "input" }, bluebook_runs: { value: 2 }, direct_runs: { value: 2 },
          bluebook: { value: 120000 }, direct: { value: 280000 }, reading: { value: "reading" }, difference: { value: 160000 },
          authoring: { value: 400000 }, break_even: { value: 2 }
    expect refused: "a break-even pays back the authoring cost"
  end

  test "a difference that is not the direct figure less the bluebook figure is refused" do
    tests "Compare", on: "ArmComparison"
    input comparison: { value: "change-1:minutes" }, measure: { value: "minutes" }, bluebook_runs: { value: 2 }, direct_runs: { value: 2 },
          bluebook: { value: 40 }, direct: { value: 80 }, reading: { value: "reading" }, difference: { value: 30 }
    expect refused: "the difference is the direct arm's figure less the bluebook arm's"
  end

  test "with no direct run there is no matched baseline and the reading says no reading" do
    tests "Compare", on: "ArmComparison"
    input comparison: { value: "change-2:input" }, measure: { value: "input" }, bluebook_runs: { value: 1 }, direct_runs: { value: 0 },
          reading: { value: "no reading" }
    expect emits: ["ArmCompared"]
  end

  test "a reading claimed with no matched baseline is refused" do
    tests "Compare", on: "ArmComparison"
    input comparison: { value: "change-2:input" }, measure: { value: "input" }, bluebook_runs: { value: 1 }, direct_runs: { value: 0 },
          reading: { value: "reading" }, bluebook: { value: 100 }, direct: { value: 0 }, difference: { value: -100 }
    expect refused: "a reading needs a matched baseline: a run on each arm"
  end

  test "no reading never carries a difference of zero" do
    tests "Compare", on: "ArmComparison"
    input comparison: { value: "change-2:input" }, measure: { value: "input" }, bluebook_runs: { value: 1 }, direct_runs: { value: 0 },
          reading: { value: "no reading" }, difference: { value: 0 }
    expect refused: "no reading carries no difference, no figures and no break-even, never zero"
  end

  # ADR 0220's usage reading is not live: a run recorded with no token reading carries none, which
  # is no reading, never zero.
  test "a run with no usage reading is recorded with no token figures" do
    tests "Record", on: "ArmRun"
    input run: { value: "r8" }, item: { value: "w-h" }, change: { value: "change-3" }, arm: { value: "bluebook" },
          minutes: { value: 40 }, rounds: { value: 1 }, red_trains: { value: 0 }, defects: { value: 0 }
    expect emits: ["ArmRunRecorded"]
  end
end
