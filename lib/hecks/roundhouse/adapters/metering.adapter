# Binds the `Metering` port to `Metering`, which answers `Sessions` and `Machine` from `claude agents
# --json`, `ps`, `sysctl` and `vm_stat`. It only reads.
# Required by name, not relative, so a copy of this directory shares the one implementation loaded.
require "hecks/roundhouse/adapters/metering"

Hecks.adapter "Metering" do
  port "Metering"
end
