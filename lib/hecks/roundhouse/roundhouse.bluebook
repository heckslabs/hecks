# Roundhouse executes what Signalbox decides (ADR 0222): it starts, meters, rests, resumes, finishes
# and reaps sessions, reads the machine and keeps the compute meter. It never decides, and it never
# starts a session that Signalbox did not admit.

Hecks.bluebook "Roundhouse" do
  vision "Every session runs only on an admission, is metered for what it draws, blows its own fuse when it overdraws, and is reaped only with nothing unsaved."

  supporting

  # Law 5: a session is born with an owner, a purpose, an end condition and its own fuse, all
  # carried from its admission. The fuse is the smallest breaker; it blows on the meter alone.
  aggregate "Session" do
    description "One session on the machine: its admission, role, owner, purpose, end condition and fuse, what it draws, and where it stands."
    created_by "Session.start!"

    identified_by :session

    attribute :session,      SessionKey
    attribute :admission,    AdmissionKey
    attribute :role,         Word
    attribute :owner,        Label
    attribute :purpose,      Label
    attribute :ends_when,    Label
    attribute :fuse,         Megabytes
    attribute :fuse_minutes, Minutes
    attribute :drawn,        Megabytes, optional: true
    attribute :minutes,      Minutes, optional: true
    attribute :item,         Item, optional: true
    attribute :cpu,          CoreHundredths, optional: true
    attribute :idle,         Minutes, optional: true

    value_object "SessionKey" do
      attribute :value, String, matches: :present
    end

    # The admission Signalbox gave; Roundhouse has no other way to start a session.
    value_object "AdmissionKey" do
      attribute :value, String
      invariant("a session starts only under an admission") { !value.to_s.strip.empty? }
    end

    value_object "Label" do
      attribute :value, String
      invariant("a session names its owner, its purpose and its end condition") { !value.to_s.strip.empty? }
    end

    value_object "Word" do
      attribute :value, String, matches: :present
    end

    value_object "Megabytes" do
      attribute :value, Integer, default: 0
      invariant("an amount of memory is not negative") { !value.negative? }
    end

    value_object "Minutes" do
      attribute :value, Integer, default: 0
      invariant("a duration is not negative") { !value.negative? }
    end

    value_object "Count" do
      attribute :value, Integer, default: 0
      invariant("a count is not negative") { !value.negative? }
    end

    # The Work item a session works, which a helper may not have: it carries no emptiness rule.
    value_object "Item", String

    # The processor a session draws, in hundredths of a core.
    value_object "CoreHundredths" do
      attribute :value, Integer, default: 0
      invariant("a processor draw is not negative") { !value.negative? }
    end

    query "Live" do
      description "Every running session, which the beat meters."
      where(status: "running")
      order_by :session
    end

    # A finished or blown session rests until the beat reaps it with nothing unsaved.
    lifecycle :status, default: "running" do
      mark :rests, "running", "resting", "finished", "blown"
      mark :terminal, "reaped"
      transition "Rest"   => "resting",  from: "running"
      transition "Resume" => "running",  from: "resting"
      transition "Finish" => "finished", from: %w[running resting]
      transition "Blow"   => "blown",    from: %w[running resting]
      transition "Reap"   => "reaped",   from: %w[finished blown]
    end

    command "Start" do
      role "System"
      goal "Start the session Signalbox admitted, with the labels and fuse of its admission"

      attribute :session,      SessionKey, sets: true
      attribute :admission,    AdmissionKey, sets: true
      attribute :role,         Word, sets: true
      attribute :owner,        Label, sets: true
      attribute :purpose,      Label, sets: true
      attribute :ends_when,    Label, sets: true
      attribute :fuse,         Megabytes, sets: true
      attribute :fuse_minutes, Minutes, sets: true

      given("a session's fuse has a memory and a time rating") { fuse.value.positive? && fuse_minutes.value.positive? }

      emits SessionStarted
    end

    # A meter reading carries the session's own fuse ratings, so the fuse blows on it alone.
    command "Meter" do
      role "System"
      goal "Record what the session draws and how long it has run"

      reference_to Session
      attribute :drawn,         Megabytes, sets: true
      attribute :minutes,       Minutes, sets: true
      attribute :rated,         Megabytes
      attribute :rated_minutes, Minutes
      attribute :item,          Item, sets: true, optional: true
      attribute :cpu,           CoreHundredths, sets: true, optional: true
      attribute :idle,          Minutes, sets: true, optional: true

      given("a meter reading names the session's own fuse") do
        rated.value == fuse.value && rated_minutes.value == fuse_minutes.value
      end

      emits SessionMetered
    end

    command "Blow" do
      role "System"
      goal "Blow the session's own fuse: it drew past its memory rating or ran past its time rating"

      reference_to Session

      emits SessionFuseBlown
    end

    command "Rest" do
      role "System"
      goal "Pause the session's heavy steps, as Signalbox's response or shedding asked"

      reference_to Session

      emits SessionRested
    end

    command "Resume" do
      role "System"
      goal "Resume a rested session under the admission Signalbox gave it again"

      reference_to Session
      attribute :admission, AdmissionKey, sets: true

      emits SessionResumed
    end

    command "Finish" do
      role "System"
      goal "End the session: its end condition was met or Signalbox sent it home"

      reference_to Session

      emits SessionFinished
    end

    # Reaping ends the process and keeps the worktree: unsaved work is never discarded.
    command "Reap" do
      role "System"
      goal "Remove the ended session's process, which returns its draw to the machine"

      reference_to Session
      attribute :unsaved, Count

      given("a session with unsaved work is never reaped") { unsaved.value.zero? }

      emits SessionReaped
    end
  end

  # One reading of the machine: what the pipeline may draw, what it draws, and the person's reserve.
  # The `Metering` port answers the two looks a reading is taken from: each live session's draw, and
  # the machine's memory and load. They only read; Roundhouse takes the reading from them.
  aggregate "Reading" do
    description "One reading of the machine's memory: capacity, the sessions' draw, the person's reserve, and the headroom left."
    created_by "Reading.take!"

    identified_by :reading

    attribute :reading,  ReadingKey
    attribute :machine,  Word
    attribute :capacity, Megabytes
    attribute :drawn,    Megabytes
    attribute :reserve,  Megabytes
    attribute :headroom, Signed

    value_object "ReadingKey" do
      attribute :value, String, matches: :present
    end

    value_object "Word" do
      attribute :value, String, matches: :present
    end

    value_object "Megabytes" do
      attribute :value, Integer, default: 0
      invariant("an amount of memory is not negative") { !value.negative? }
    end

    value_object "Signed" do
      attribute :value, Integer, default: 0
    end

    # A JSON document: the rows or the facts a look at the machine found.
    value_object "Document" do
      attribute :text, String
    end

    query "Sessions" do
      description "The per-session meter: each live Claude session's role, Work item, memory (its whole process tree, its MCP servers counted), CPU and last activity."
      returns Document
    end

    query "Machine" do
      description "The machine as one look finds it: its memory, what the sessions draw, the 1-minute load and the performance cores."
      returns Document
    end

    # Delegate's readers of load read this, once the Tickets world's `metering.roundhouse` switch
    # is on (ADR 0222, phase 3, metering), so the fill, the sampler and the board count one load.
    query "Load" do
      description "The machine's 1-minute load in hundredths and the performance cores it is read against, read without listing a session."
      returns Document
    end

    # What a reap is ruled on (ADR 0222, phase 3, reaping): Signalbox's `Reaping.Rule` judges each
    # row before Delegate's reap removes anything, once the Tickets world's `reaping.signalbox` is on.
    query "Ended" do
      description "The ended part of the meter: each session listed done or stopped, or whose process is gone, with its role, run, idle minutes and directory; and each copy of the checkout, with its branch, whether main holds it, its unsaved files and whether a live session works in it."
      returns Document
    end

    # Not the machine's memory: the compute the sessions spent in tokens, which the board shows beside
    # the memory they draw. It rides this aggregate's port because it is read the same way, off the
    # sessions' own records, and no domain is booted to answer it.
    query "Tokens" do
      description "Tokens used per session, role, Work item and day (input, output and cache split, turns and the context each turn read in, with dollars from the declared price table), the turns by what set them going (a trigger kind label, never the prompt text) and tokens saved by prompt cache and by model routing, each line labelled with how it is counted; the Hecks door and work not redone are read by comparison against a matched baseline (see ArmComparison), never counted directly."
      returns Document
    end

    query "Latest" do
      description "The readings taken, the newest last, which the board and the pressure beat read."
      order_by :reading
    end

    command "Take" do
      role "System"
      goal "Record one reading of the machine, the headroom Signalbox publishes as pressure"

      attribute :reading,  ReadingKey, sets: true
      attribute :machine,  Word, sets: true
      attribute :capacity, Megabytes, sets: true
      attribute :drawn,    Megabytes, sets: true
      attribute :reserve,  Megabytes, sets: true
      attribute :headroom, Signed, sets: true

      given("headroom is the capacity less the draw less the person's reserve") do
        headroom.value == capacity.value - drawn.value - reserve.value
      end

      emits MachineRead
    end
  end

  # The compute meter, one window at a time. Power factor is productive over all sessions;
  # negawatts are compute reclaimed from waste; curtailment is finished work refused at landing.
  aggregate "Tally" do
    description "One window of the compute meter: sessions, productive sessions, landings, compute drawn, compute reclaimed, and landings refused."
    created_by "Tally.close!"

    identified_by :tally

    attribute :tally,      TallyKey
    attribute :sessions,   Count
    attribute :productive, Count
    attribute :landings,   Count
    attribute :gb_hours,   Count
    attribute :reclaimed,  Count
    attribute :curtailed,  Count
    attribute :headroom,   Signed

    value_object "TallyKey" do
      attribute :value, String, matches: :present
    end

    value_object "Count" do
      attribute :value, Integer, default: 0
      invariant("a count is not negative") { !value.negative? }
    end

    # The lowest headroom read in the window, in megabytes.
    value_object "Signed" do
      attribute :value, Integer, default: 0
    end

    command "Close" do
      role "System"
      goal "Close one window of the compute meter with what it counted"

      attribute :tally,      TallyKey, sets: true
      attribute :sessions,   Count, sets: true
      attribute :productive, Count, sets: true
      attribute :landings,   Count, sets: true
      attribute :gb_hours,   Count, sets: true
      attribute :reclaimed,  Count, sets: true
      attribute :curtailed,  Count, sets: true
      attribute :headroom,   Signed, sets: true

      given("productive sessions are no more than all sessions") { productive.value <= sessions.value }

      emits TallyClosed
    end
  end

  # What set a turn going: the declared rows (a pattern on the prompt's opening text, and a label)
  # are projected to the lookup the Tokens query labels each turn with. The first row that matches
  # wins, in the order declared; a prompt no row matches is a user prompt when typed, else other.
  aggregate "TriggerKind" do
    description "One declared kind of trigger: the pattern a prompt's opening text matches and the label the token report gives the turn."
    created_by "TriggerKind.declare!"

    identified_by :kind

    attribute :kind,    KindKey
    attribute :pattern, Pattern
    attribute :label,   KindLabel

    value_object "KindKey" do
      attribute :value, String, matches: :present
    end

    value_object "Pattern" do
      attribute :value, String
      invariant("a trigger kind names the pattern it matches") { !value.to_s.strip.empty? }
    end

    value_object "KindLabel" do
      attribute :value, String
      invariant("a trigger kind names the label it gives") { !value.to_s.strip.empty? }
    end

    command "Declare" do
      role "System"
      goal "Declare one trigger kind: the pattern and the label a turn it matches is given"

      attribute :kind,    KindKey, sets: true
      attribute :pattern, Pattern, sets: true
      attribute :label,   KindLabel, sets: true

      emits TriggerKindDeclared
    end
  end

  # How a run's Work item was authored. Generated code spends no tokens, so the saving is read by
  # comparing arms on one change; an untagged run is never folded into an arm.
  aggregate "ArmRun" do
    description "One landed run, tagged with the arm its Work item was authored in, and what it cost and how it fared."
    created_by "ArmRun.record!"

    identified_by :run

    attribute :run,         Key
    attribute :item,        ItemKey
    attribute :change,      ChangeKey, optional: true
    attribute :arm,         Arm
    attribute :input,       Tokens, optional: true
    attribute :output,      Tokens, optional: true
    attribute :cache,       Tokens, optional: true
    attribute :minutes,     Count
    attribute :rounds,      Count
    attribute :red_trains,  Count
    attribute :defects,     Count

    value_object "Key" do
      attribute :value, String, matches: :present
    end

    value_object "ItemKey" do
      attribute :value, String, matches: :present
    end

    value_object "ChangeKey" do
      attribute :value, String, matches: :present
    end

    value_object "Arm" do
      attribute :value, String
      invariant("a run is bluebook, direct or untagged") { value == "bluebook" || value == "direct" || value == "untagged" }
    end

    # Tokens a run spent, from the usage reading (ADR 0220). No default: a run with no reading carries
    # none, which is no reading, never zero.
    value_object "Tokens" do
      attribute :value, Integer
      invariant("tokens are not negative") { !value.negative? }
    end

    # Minutes from dispatch to green main, review rounds, red-train events, or defects the
    # held-back acceptance suite found after landing.
    value_object "Count" do
      attribute :value, Integer, default: 0
      invariant("a count is not negative") { !value.negative? }
    end

    query "ByArm" do
      description "Every tagged run, the arm first, the run after."
      order_by :arm
    end

    query "Untagged" do
      description "The runs no one tagged: shown as untagged, never counted in either arm."
      where(arm: "untagged")
      order_by :run
    end

    command "Record" do
      role "System"
      goal "Record one landed run with the arm its Work item was authored in and its measures"

      attribute :run,        Key, sets: true
      attribute :item,       ItemKey, sets: true
      attribute :change,     ChangeKey, optional: true, sets: true
      attribute :arm,        Arm, sets: true
      attribute :input,      Tokens, optional: true, sets: true
      attribute :output,     Tokens, optional: true, sets: true
      attribute :cache,      Tokens, optional: true, sets: true
      attribute :minutes,    Count, sets: true
      attribute :rounds,     Count, sets: true
      attribute :red_trains, Count, sets: true
      attribute :defects,    Count, sets: true

      given("a run with a matched change is tagged, never untagged") { arm.value != "untagged" || change.value.to_s.empty? }

      emits ArmRunRecorded
    end
  end

  # One reduction each, per arm: an untagged run is its own row, never folded into an arm.
  read_model "ArmRunsByArm" do
    description "How many landed runs each arm holds; an untagged run is its own row."
    include ArmRun
    group_by :arm
    count
  end

  read_model "ArmInputByArm" do
    description "The input tokens of each arm's runs, added up."
    include ArmRun
    group_by :arm
    sum :input
  end

  read_model "ArmOutputByArm" do
    description "The output tokens of each arm's runs, added up."
    include ArmRun
    group_by :arm
    sum :output
  end

  read_model "ArmCacheByArm" do
    description "The cache tokens of each arm's runs, added up."
    include ArmRun
    group_by :arm
    sum :cache
  end

  read_model "ArmMinutesByArm" do
    description "The minutes from dispatch to green main of each arm's runs, added up."
    include ArmRun
    group_by :arm
    sum :minutes
  end

  read_model "ArmRoundsByArm" do
    description "The review rounds of each arm's runs, added up."
    include ArmRun
    group_by :arm
    sum :rounds
  end

  read_model "ArmRedTrainsByArm" do
    description "The red-train events of each arm's runs, added up."
    include ArmRun
    group_by :arm
    sum :red_trains
  end

  read_model "ArmDefectsByArm" do
    description "The defects found after landing by the held-back acceptance suite of each arm's runs, added up."
    include ArmRun
    group_by :arm
    sum :defects
  end

  # No run on one arm means no reading: no difference, never zero. Authoring cost is apart.
  aggregate "ArmComparison" do
    description "One measure of one change compared across the two arms, with the authoring cost and the break-even reported apart."
    created_by "ArmComparison.compare!"

    identified_by :comparison

    attribute :comparison,     Key
    attribute :measure,        Measure
    attribute :bluebook_runs,  Count
    attribute :direct_runs,    Count
    attribute :bluebook,       Figure, optional: true
    attribute :direct,         Figure, optional: true
    attribute :reading,        Reading
    attribute :difference,     Gap, optional: true
    attribute :authoring,      Figure, optional: true
    attribute :break_even,     Figure, optional: true

    value_object "Key" do
      attribute :value, String, matches: :present
    end

    value_object "Measure" do
      attribute :value, String
      invariant("a measure is one the meter takes") do
        value == "input" || value == "output" || value == "cache" || value == "minutes" ||
          value == "rounds" || value == "red_trains" || value == "defects"
      end
    end

    value_object "Count" do
      attribute :value, Integer, default: 0
      invariant("a count is not negative") { !value.negative? }
    end

    # No default: a figure that is absent is absent, never zero.
    value_object "Figure" do
      attribute :value, Integer
      invariant("a figure is not negative") { !value.negative? }
    end

    value_object "Gap", Integer

    value_object "Reading" do
      attribute :value, String
      invariant("a comparison is a reading or no reading") { value == "reading" || value == "no reading" }
    end

    query "Readings" do
      description "Every comparison, a reading or no reading, by measure."
      order_by :comparison
    end

    query "NoReadings" do
      description "The comparisons with no matched baseline, which carry no difference."
      where(reading: "no reading")
      order_by :comparison
    end

    # Difference is the direct figure less the bluebook's; break-even is authoring over it, rounded up.
    command "Compare" do
      role "System"
      goal "Compare one measure of one change across the two arms, or say there is no reading"

      attribute :comparison,    Key, sets: true
      attribute :measure,       Measure, sets: true
      attribute :bluebook_runs, Count, sets: true
      attribute :direct_runs,   Count, sets: true
      attribute :bluebook,      Figure, optional: true, sets: true
      attribute :direct,        Figure, optional: true, sets: true
      attribute :reading,       Reading, sets: true
      attribute :difference,    Gap, optional: true, sets: true
      attribute :authoring,     Figure, optional: true, sets: true
      attribute :break_even,    Figure, optional: true, sets: true

      given("a reading needs a matched baseline: a run on each arm") do
        reading.value == "no reading" || (bluebook_runs.value > 0 && direct_runs.value > 0)
      end
      given("without a run on each arm there is no reading") do
        reading.value == "reading" || bluebook_runs.value == 0 || direct_runs.value == 0
      end
      given("no reading carries no difference, no figures and no break-even, never zero") do
        reading.value == "reading" || (difference.value.to_s.empty? && bluebook.value.to_s.empty? &&
                                       direct.value.to_s.empty? && break_even.value.to_s.empty?)
      end
      given("the difference is the direct arm's figure less the bluebook arm's") do
        reading.value == "no reading" || difference.value == direct.value - bluebook.value
      end
      given("a break-even pays back the authoring cost") do
        break_even.value.to_s.empty? || break_even.value * difference.value >= authoring.value
      end
      given("a break-even is the first change that pays back the authoring cost") do
        break_even.value.to_s.empty? || (break_even.value - 1) * difference.value < authoring.value
      end

      emits ArmCompared
    end
  end

  policy "BlowTheFuseWhenOverdrawn" do
    on      "Session.SessionMetered"
    where   { drawn.value > rated.value || minutes.value > rated_minutes.value }
    trigger Session::Blow, with: { session: :session }
  end

  # What Signalbox decided, carried out. These fire once the two bluebooks share a bus (phase 2).
  policy "StartWhatSignalboxAdmitted" do
    on      "Admission.SessionAdmitted"
    trigger Session::Start, with: { session: :admission, admission: :admission, role: :role, owner: :owner,
                                    purpose: :purpose, ends_when: :ends_when, fuse: :fuse,
                                    fuse_minutes: :fuse_minutes }
  end

  policy "RestWhatSignalboxDeferred" do
    on      "Response.ResponseDeferred"
    trigger Session::Rest, with: { session: :session }
  end

  policy "FinishWhatSignalboxSentHome" do
    on      "Response.ResponseLeft"
    trigger Session::Finish, with: { session: :session }
  end

  policy "RestWhatSignalboxShed" do
    on      "Breaker.BreakerShed"
    trigger Session::Rest, with: { session: :shed }
  end

  # A pressure beat Signalbox cleared is the machine's reading: Roundhouse records it.
  policy "TakeTheClearedBeatsReading" do
    on      "Beat.BeatPublished"
    trigger Reading::Take, with: {
      reading: :beat, machine: { value: "this-machine" }, capacity: :capacity, drawn: :used,
      reserve: :reserve, headroom: :headroom
    }
  end
end
