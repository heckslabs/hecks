# The Roundhouse bluebook, bound so it boots standing alone (a behaviors or model_check boot of this
# directory). It persists in Memory and is wired into nothing yet (ADR 0222, phase 1).
Hecks.hecksagon "Roundhouse" do
  attaches "Governance"
  persisted_by "Memory"

  # Signalbox's decisions, which Roundhouse carries out. Signalbox is not attached in phase 1.
  subscribe "Signalbox.SessionAdmitted"
  subscribe "Signalbox.ResponseDeferred"
  subscribe "Signalbox.ResponseLeft"
  subscribe "Signalbox.BreakerShed"
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
