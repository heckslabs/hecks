# The Roundhouse bluebook, bound so it boots standing alone (a behaviors or model_check boot of this
# directory). It persists in Memory. The ports it shares with every attaching hecksagon are in
# roundhouse.ports.hecksagon.
Hecks.hecksagon "Roundhouse" do
  attaches "Governance"
  persisted_by "Memory"

  # Signalbox decides and Roundhouse carries it out, on one bus: attaching Signalbox puts its events
  # (an admission, a deferral, a send-home, a shed) on the bus Roundhouse's policies hear.
  attaches "Signalbox"
end

# The anti-corruption layer for Governance, which the bluebook's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
