# The CiSpeed chapter, bound so it boots standing alone (a behaviors or model_check boot of this
# directory). The ports it shares with every attaching hecksagon are in ci_speed.ports.hecksagon.
Hecks.hecksagon "CiSpeed" do
  attaches "Governance"
  persisted_by "Memory"
end

# The anti-corruption layer for Governance, which the chapter's roles are checked against.
Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
