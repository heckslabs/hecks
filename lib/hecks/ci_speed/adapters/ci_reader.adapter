# Binds the `CiReader` port to `CiReader`, which answers `Run`'s `Reading` query with one main CI run as GitHub reports it.
# Required by name, not relative, so a copy of this directory shares the one implementation loaded.
require "hecks/ci_speed/adapters/ci_reader"

Hecks.adapter "CiReader" do
  port "CiReader"
end
