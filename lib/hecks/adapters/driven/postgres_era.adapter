# Declares the PostgresEra adapter's port and fields; the class is `postgres_era.rb` beside it.
# This file is loaded on every boot, so it stays metadata only.
Hecks.adapter "PostgresEra" do
  port  "persistence"
  field :database
  field :role
  field :schema
  # Opt-in to boot over a superuser or BYPASSRLS role, which the era write fence cannot
  # bite. Refused by default; see `Lineage#check_fence_applies!`.
  field :allow_superuser
  # Whether this copy may migrate the database to a newer storage shape at boot, by minting the
  # next era through a translation edge. `false` refuses; unset follows
  # `LineageManager::EraResolver::MINT_BY_DEFAULT`; see `Refusals#refuse_unpermitted_mint!`.
  field :mint_eras
  # Declares the store a disposable tooling ledger: a shape change needs no era, edge or mint, an
  # additive one is applied in place, any other archives the aggregate's rows under a dated name
  # and starts it empty, and a boot never refuses as unminted or superseded. Unset or `false`
  # keeps the era guard; see `LineageManager::DisposableLedger`. Never for client data.
  field :disposable_ledger
  # Rewrites every row of an aggregate in one statement, on the same SQL path as Postgres.
  provides "set_transform"
end
