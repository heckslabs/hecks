Hecks.bluebook "HopChain" do
  generic

  # Proposal -> Engagement -> Client, the real shape this feature exists
  # for (Embryonaut's own hand-written PRECONDITIONS table, made a
  # declared query instead).
  aggregate "Client" do
    identified_by :name
    attribute :name, Name
    value_object("Name") { attribute :value, String }

    lifecycle :status, default: "active" do
      transition "Churn" => "churned", from: "active"
    end

    command "Register" do
      attribute :name, Name
      sets :name
      emits "Registered"
    end

    command "Churn" do
      reference_to Client
      emits "Churned"
    end
  end

  aggregate "Engagement" do
    identified_by :reference
    reference_to Client
    attribute :reference, Reference
    value_object("Reference") { attribute :value, String }

    lifecycle :stage, default: "started" do
      transition "Demo" => "demo_shown", from: "started"
    end

    command "Start" do
      reference_to Client
      attribute :reference, Reference
      sets :reference
      emits "Started"
    end

    command "Demo" do
      reference_to Engagement
      emits "Demoed"
    end

    query "WithActiveClient" do
      where :"client/status" => "active"
    end
  end

  aggregate "Proposal" do
    identified_by :number
    reference_to Engagement, optional: true
    attribute :number, Number
    value_object("Number") { attribute :value, String }

    lifecycle :status, default: "drafted" do
      transition "Send" => "sent", from: "drafted"
      transition "Accept" => "accepted", from: "sent"
    end

    # The command's own reference is optional, even though the aggregate
    # head's is optional too — a nil/never-set reference is real state a hop has
    # to answer for (it never holds, whatever the comparator), and this
    # to answer for. The command input and retained relationship therefore
    # state the same optionality explicitly.
    command "Draft" do
      reference_to Engagement, optional: true
      attribute :number, Number
      sets :number
      emits "Drafted"
    end

    command "Send" do
      reference_to Proposal
      emits "Sent"
    end

    command "Accept" do
      reference_to Proposal
      emits "Accepted"
    end

    query "AwaitingReplyFromActiveClients" do
      where status: "sent"
      where :"engagement/client/status" => "active"
      order_by :number
    end

    # The existential-negation case: NOT active must mean "points at a
    # client that is churned," not "nil/dangling reference also counts."
    query "SentButNotFromActiveClients" do
      where status: "sent"
      where :"engagement/client/status" => { ne: "active" }
    end

    query "PricedAboveViaEngagement" do
      where :"engagement/client/status" => "active"
      order_by :number
      limit 1
    end
  end

  # A SELF-REFERENCE, TWO HOPS DEEP — "grandparent" — proving a hop
  # chain revisiting the same aggregate TYPE is real and safe, not a
  # cycle to refuse. HopPath.MAX_HOPS bounds chain LENGTH, deliberately
  # not aggregate identity: nothing about walking Node -> Node -> Node
  # can loop forever, since the walk is bounded by the query's own
  # literal dotted string, not by the reference graph's shape.
  aggregate "Node" do
    identified_by :label
    # `as:` is required for a self-reference to mean a plain ATTRIBUTE
    # rather than "the root this command acts on" —
    # CommandBuilder#reference_to's own comment names this exactly:
    # without it, a command referencing its own aggregate's type reads
    # as a second self-reference, refused as naming two roots.
    reference_to Node, as: :parent, optional: true
    attribute :label, Label
    value_object("Label") { attribute :value, String }

    command "Plant" do
      reference_to Node, as: :parent, optional: true
      attribute :label, Label
      sets :label
      emits "Planted"
    end

    query "GrandparentLabelled" do
      where :"parent/parent/label" => :label
    end
  end
end
