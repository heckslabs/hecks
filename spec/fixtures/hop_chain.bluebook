Hecks.bluebook "HopChain" do
  generic

  # Proposal -> Engagement -> Client: a two-hop reference chain queried by dotted path.
  aggregate "Client" do
    identified_by :name
    attribute :name, Name
    value_object("Name") { attribute :value, String }

    lifecycle :status, default: "active" do
      transition "Churn" => "churned", from: "active"
    end

    command "Register" do
      attribute :name, Name
      sets :name
      emits "Registered"
    end

    command "Churn" do
      reference_to Client
      emits "Churned"
    end
  end

  aggregate "Engagement" do
    identified_by :reference
    reference_to Client
    attribute :reference, Reference
    value_object("Reference") { attribute :value, String }

    lifecycle :stage, default: "started" do
      transition "Demo" => "demo_shown", from: "started"
    end

    command "Start" do
      reference_to Client
      attribute :reference, Reference
      sets :reference
      emits "Started"
    end

    command "Demo" do
      reference_to Engagement
      emits "Demoed"
    end

    query "WithActiveClient" do
      where :"client/status" => "active"
    end
  end

  aggregate "Proposal" do
    identified_by :number
    reference_to Engagement, optional: true
    attribute :number, Number
    value_object("Number") { attribute :value, String }

    lifecycle :status, default: "drafted" do
      transition "Send" => "sent", from: "drafted"
      transition "Accept" => "accepted", from: "sent"
    end

    # A nil reference is real state a hop must answer for (it never holds, whatever
    # the comparator), so the command and the aggregate both declare optional: true.
    command "Draft" do
      reference_to Engagement, optional: true
      attribute :number, Number
      sets :number
      emits "Drafted"
    end

    command "Send" do
      reference_to Proposal
      emits "Sent"
    end

    command "Accept" do
      reference_to Proposal
      emits "Accepted"
    end

    query "AwaitingReplyFromActiveClients" do
      where status: "sent"
      where :"engagement/client/status" => "active"
      order_by :number
    end

    # Negation must mean "points at a churned client", not "nil or dangling also counts".
    query "SentButNotFromActiveClients" do
      where status: "sent"
      where :"engagement/client/status" => { ne: "active" }
    end

    query "PricedAboveViaEngagement" do
      where :"engagement/client/status" => "active"
      order_by :number
      limit 1
    end
  end

  # A self-reference two hops deep: a chain may revisit an aggregate type, since
  # HopPath.MAX_HOPS bounds chain length, not aggregate identity.
  aggregate "Node" do
    identified_by :label
    # Without `as:`, a command referencing its own aggregate's type reads as a
    # second self-reference and is refused as naming two roots.
    reference_to Node, as: :parent, optional: true
    attribute :label, Label
    value_object("Label") { attribute :value, String }

    command "Plant" do
      reference_to Node, as: :parent, optional: true
      attribute :label, Label
      sets :label
      emits "Planted"
    end

    query "GrandparentLabelled" do
      where :"parent/parent/label" => :label
    end
  end
end
