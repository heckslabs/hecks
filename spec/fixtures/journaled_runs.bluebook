Hecks.bluebook "Runs" do
  vision "A journaled run, to show which questions are the run's own bookkeeping"

  aggregate "Job" do
    description "One job, recorded from request to end."

    attribute :run, RunKey
    attribute :report, Report, optional: true
    identified_by :run

    value_object "RunKey" do
      attribute :value, String
    end

    value_object "Report" do
      attribute :value, String
    end

    value_object "Document" do
      attribute :text, String
    end

    lifecycle :status, default: "requested" do
      transition "Accept" => "accepted", from: "requested"
      transition "Fault"  => "faulted",  from: %w[requested accepted]
    end

    command "Start" do
      role "Maintainer"
      goal "Ask for a job"

      attribute :run, RunKey
      sets :run
      emits JobRequested
    end

    command "Accept" do
      role "System"
      goal "Let the job through"

      reference_to Job
      emits JobAccepted
    end

    query "JobOutcome" do
      description "How one job ended."
      attribute :run, RunKey
      where(run: :run)
    end

    query "JobFaulted" do
      description "Every job that was refused."
      where(status: "faulted")
    end

    query "JobsByReport" do
      description "Jobs that reported something."
      attribute :report, Report
      where(report: :report)
    end

    query "JobDigest" do
      description "A text digest of the jobs."
      returns Document
    end
  end
end
