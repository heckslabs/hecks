
Hecks.bluebook "TillRoom" do
  vision "A till takes money in and gives money out, and the drawer count is arithmetic — never a guess."
  core

  aggregate "Till" do
    description "One cash drawer and the count of cents inside it."

    identified_by :number

    attribute :number,  TillNumber
    attribute :balance, Money, default: { cents: 0 }
    attribute :marks,   list_of(Mark)
    # A clerk may say why a taking was unusual, or say nothing — the one OPTIONAL
    # fact in this fixture, and the only entry point left through which an absent
    # argument can still reach a mutation. A REQUIRED one is refused at the
    # payload gate long before `sets` ever resolves its source.
    attribute :note,    Note

    value_object "TillNumber" do
      attribute :value, String
    end

    value_object "Money" do
      attribute :cents, Integer
      invariant("a cash amount is never negative") { cents >= 0 }
    end

    value_object "Mark" do
      attribute :amount,    Integer
      attribute :direction, String
    end

    value_object "Note" do
      attribute :text, String
    end

    command "OpenTill" do
      role "Clerk"
      goal "Start the day with an empty drawer"

      attribute :number, TillNumber

      # Wave 8 fix — :number is this aggregate's own IDENTITY (line 9),
      # already a required command attribute, but was never `sets`.
      sets :number

      emits "TillOpened"
    end

    command "TakeIn" do
      role "Clerk"
      goal "Add cents to the drawer"

      reference_to Till
      attribute :amount, Money
      attribute :note,   Note, optional: true

      sets :balance, increment: :amount
      sets :marks,   append: { amount: :amount, direction: "in" }
      sets :note

      emits "TakenIn"
    end

    command "PayOut" do
      role "Clerk"
      goal "Take cents out of the drawer"

      reference_to Till
      attribute :amount, Money

      sets :balance, decrement: :amount
      sets :marks,   append: { amount: :amount, direction: "out" }

      emits "PaidOut"
    end

    command "Bump" do
      role "Clerk"
      goal "Add the fixed float the branch always starts with"

      reference_to Till
      sets :balance, increment: { cents: 500 }

      emits "Bumped"
    end
  end
end
