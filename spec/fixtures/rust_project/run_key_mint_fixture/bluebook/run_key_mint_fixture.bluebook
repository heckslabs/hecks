# A reaction mints the run key its creating command requires and names none; both engines run it
# by spec/corpus/rust_conformance/reaction_mints_run_key.json and its spent-identity sibling.
Hecks.bluebook "RunKeyMintFixture" do
  vision "The smallest domain whose placed booking starts a check under a run key nobody named."

  core

  aggregate "Booking" do
    description "A booking, placed once."

    identified_by :ref

    attribute :ref, BookingRef

    value_object "BookingRef" do
      attribute :value, String
    end

    command "Place" do
      goal "Place a booking"

      attribute :ref, BookingRef

      sets :ref

      emits "BookingPlaced"
    end
  end

  aggregate "Check" do
    description "A check run for a booking, keyed by its run."

    identified_by :run

    attribute :run, RunKey
    attribute :booking, BookingRef

    value_object "RunKey" do
      attribute :value, String
    end

    value_object "BookingRef" do
      attribute :value, String
    end

    command "Start" do
      goal "Start a check run"

      attribute :run, RunKey
      attribute :booking, BookingRef

      sets :run
      sets :booking

      emits "CheckStarted"
    end
  end

  policy "StartCheckOnPlaced" do
    on "BookingPlaced"
    trigger Check::Start, with: { booking: :ref }
  end
end
