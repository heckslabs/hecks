# Pins `sets` taking arithmetic as its source: `*`, `-` and floor `/` over command arguments and
# the record's own fields, each result wrapped in the target's single-field value object.
#
# Dispatched against both engines by spec/corpus/rust_conformance/computed_sets.json
Hecks.bluebook "ComputedSetsFixture" do
  vision "The smallest domain whose commands compute a value: a percentage refund, a difference and a floor share."

  core

  aggregate "Settlement" do
    description "A payment, and what is computed from it."

    identified_by :ref

    attribute :ref, SettlementRef
    attribute :paid, Cents
    attribute :refund, Cents, default: { value: 0 }
    attribute :remaining, Cents, default: { value: 0 }
    attribute :share, Cents, default: { value: 0 }
    attribute :charged, Charge, default: { cents: 0, currency: "USD" }
    attribute :late_owed, Cents, default: { value: 0 }
    attribute :net, Cents, default: { value: 0 }

    value_object "SettlementRef" do
      attribute :value, String
    end

    value_object "Cents" do
      attribute :value, Integer
    end

    value_object "Percent" do
      attribute :value, Integer
    end

    value_object "Charge" do
      attribute :cents, Integer
      attribute :currency, String
    end

    command "Open" do
      goal "Record a payment"

      attribute :ref, SettlementRef
      attribute :paid, Cents

      sets :ref
      sets :paid

      emits "SettlementOpened"
    end

    # `paid` is the record's own field; `rate` and `shortfall` are arguments.
    command "Settle" do
      goal "Refund a percentage of the payment and work out what remains"

      reference_to Settlement
      attribute :rate, Percent
      attribute :shortfall, Cents

      sets :refund, to: paid * rate / 100
      sets :remaining, to: paid - shortfall

      emits "SettlementSettled"
    end

    command "Charge" do
      goal "Record what was charged, in a currency"

      reference_to Settlement
      attribute :charged, Charge

      sets :charged

      emits "SettlementCharged"
    end

    # `charged.cents` reads a field of the record's own multi-field value object; `late_percent.value`
    # reads the one field of a single-field value object explicitly.
    command "Late" do
      goal "Work out what a late payment owes"

      reference_to Settlement
      attribute :late_percent, Percent

      sets :late_owed, to: charged.cents * late_percent.value / 100

      emits "SettlementLate"
    end

    # `discount.cents` reaches into an argument's multi-field value object.
    command "Discount" do
      goal "Take a discount off what was charged"

      reference_to Settlement
      attribute :discount, Charge

      sets :net, to: charged.cents - discount.cents

      emits "SettlementDiscounted"
    end

    command "Share" do
      goal "Split an amount into equal parts, rounding down"

      reference_to Settlement
      attribute :amount, Cents
      attribute :parts, Percent

      sets :share, to: amount / parts

      emits "SettlementShared"
    end
  end
end
