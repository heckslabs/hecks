Hecks.bluebook "Payments" do
  vision "money changing hands is a fact someone outside tells us about, not a fact we compute"
  supporting

  aggregate "Payment" do
    identified_by :payment_id

    value_object "PaymentId" do
      attribute :value, String
    end

    value_object "Money" do
      attribute :cents, Integer
    end

    value_object "DeclineReason" do
      attribute :code, String
      attribute :message, String
    end

    attribute :payment_id, PaymentId
    attribute :amount, Money
    attribute :decline_reason, DeclineReason, optional: true

    # THE LIFECYCLE MOVES THE FIELD (C5.3, docs/semantics/bluebook-
    # semantics.md) — each command that changes `status` names its
    # transition here; a `sets :status` is refused at build.
    lifecycle :status, default: "pending" do
      transition "ConfirmReceipt" => "received",  from: "pending"
      transition "Confirm"        => "confirmed", from: "received"
      transition "RejectPayment"  => "declined",  from: "pending"
    end

    command "Open" do
      role "Merchant"
      goal "start tracking a payment we expect to receive"
      attribute :payment_id, PaymentId
      attribute :amount, Money
      emits "PaymentOpened"
    end

    command "ConfirmReceipt" do
      role "System"
      goal "record that the gateway told us the money arrived"
      reference_to Payment
      attribute :amount, Money
      given("payment is still pending") { status == "pending" }
      emits "PaymentConfirmed"
    end

    command "RejectPayment" do
      role "System"
      goal "record that the gateway declined the charge"
      reference_to Payment
      attribute :reason, DeclineReason
      given("payment is still pending") { status == "pending" }
      sets :decline_reason, to: :reason
      emits "PaymentRejected"
    end
  end

  policy "OnPaymentReceived" do
    on "PaymentReceived"
    trigger Payment::ConfirmReceipt
  end

  policy "OnPaymentDeclined" do
    on "PaymentDeclined"
    trigger Payment::RejectPayment
  end
end
