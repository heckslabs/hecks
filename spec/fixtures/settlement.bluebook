
Hecks.bluebook "Wire" do
  vision "Money leaves one drawer for another, and something remembers which half happened."
  core

  aggregate "Drawer" do
    identified_by :number

    attribute :number, DrawerNumber
    attribute :cents, Money, default: { cents: 0 }

    value_object "DrawerNumber" do
      attribute :value, String
    end

    value_object "Money" do
      attribute :cents, Integer
    end

    lifecycle :status, default: "open" do
      transition "Shut" => "shut", from: "open"
      transition "Reopen" => "open", from: "shut"
    end

    command "Open" do
      role "Clerk"
      goal "A new drawer"
      attribute :number, DrawerNumber
      emits "DrawerOpened"
    end

    command "Put" do
      role "Clerk"
      goal "Money in"
      reference_to Drawer
      attribute :amount, Money
      given("the drawer is open") { status == "open" }
      sets :cents, increment: :amount
      emits "PutIn"
    end

    command "Take" do
      role "Clerk"
      goal "Money out"
      reference_to Drawer
      attribute :amount, Money
      given("the drawer is open")  { status == "open" }
      given("the cents cover it")  { cents.cents >= amount.cents }
      sets :cents, decrement: :amount
      emits "Taken"
    end

    command "Shut" do
      role "Clerk"
      goal "Shut the drawer"
      reference_to Drawer
      emits "DrawerShut"
    end

    command "Reopen" do
      role "Clerk"
      goal "Open it again"
      reference_to Drawer
      emits "DrawerReopened"
    end
  end

  aggregate "Wire" do
    identified_by :reference

    attribute :reference,   WireReference
    attribute :amount,      Money, default: { cents: 0 }

    value_object "WireReference" do
      attribute :value, String
    end
    reference_to Drawer, as: :source
    reference_to Drawer, as: :destination

    value_object "Money" do
      attribute :cents, Integer
    end

    lifecycle :status, default: "asked" do
      transition "Moved"    => "moved",    from: "asked"
      transition "Landed"   => "landed",   from: "moved"
      transition "Returned" => "returned", from: "moved"
    end

    command "Ask" do
      role "Customer"
      goal "Move money between drawers"
      attribute :reference,   WireReference
      attribute :amount,      Money
      reference_to Drawer, as: :source
      reference_to Drawer, as: :destination
      given("a wire moves something") { amount.cents.positive? }
      sets :amount
      sets :source
      sets :destination
      emits "WireAsked"
    end

    command "Moved" do
      role "System"
      goal "The source gave it up"
      reference_to Wire
      emits "WireMoved"
    end

    command "Landed" do
      role "System"
      goal "The destination has it"
      reference_to Wire
      emits "WireLanded"
    end

    command "Returned" do
      role "System"
      goal "It went back"
      reference_to Wire
      emits "WireReturned"
    end
  end

  process_manager "Carry" do
    # Names the field: Wire's `identified_by :reference` derives its id from the same scalar.
    correlates_by :"reference.value"
    starts_on "WireAsked"
    ends_on   "WireLanded"

    transition "WireAsked" => "asked", from: "asked" do
      # `reference:` carries the correlation forward — Drawer does not
      # reference Wire, so this is pure passthrough, not an addressing key.
      dispatch Drawer::Take, with: { number: :source, amount: :amount, reference: :reference }
    end

    transition "Taken" => "carrying", from: "asked" do
      # Wire.Moved references Wire itself, so `wire:` is the addressing key; the value is still
      # `:reference`.
      dispatch Wire::Moved,  with: { wire: :reference }
      dispatch Drawer::Put,  with: { number: :destination, amount: :amount, reference: :reference }
    end

    transition "PutIn" => "landed", from: "carrying" do
      dispatch Wire::Landed, with: { wire: :reference }
    end

    # Compensating leg, triggered by a refusal because no aggregate announces a declined leg.
    transition :refused => "returned", from: "carrying" do
      dispatch Drawer::Put,    with: { number: :source, amount: :amount, reference: :reference }
      dispatch Wire::Returned, with: { wire: :reference }
    end
  end
end
