Hecks.bluebook "PrivacyAttach" do
  aggregate "Note" do
    attribute :text, Text
    identified_by :id
    value_object "Text" do
      attribute :value, String
    end
    command "Write" do
      goal "write a note"
      attribute :text, Text
      sets :text
      emits "Written"
    end
  end
end
