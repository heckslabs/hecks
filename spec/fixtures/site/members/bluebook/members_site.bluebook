# A members' club's site: a third neutral sample project beside the studio and the gallery. It
# declares an `Admin` row, so it exercises the admin sign-in module: a public login page beneath
# the admin prefix, an admin endpoint that hands a signed-in admin to the CMS, a draft preview, and
# a page listed after a wildcard that still has to win because it is more specific.
Hecks.bluebook "MembersSite" do
  vision "The routes of a members' club's website, with a sign-in for its admins."

  aggregate "SiteMap" do
    description "The club site's routes."

    attribute :name, MapName
    identified_by :name

    value_object "MapName" do
      attribute :value, String
    end

    value_object "Route" do
      attribute :path,      String
      attribute :kind,      String
      attribute :render,    String
      attribute :auth,      String
      attribute :methods,   String
      attribute :cache,     String
      attribute :origin,    String
      attribute :source,    String
      attribute :indexable, Boolean
      attribute :label,     String
      attribute :seo,       String
      attribute :preview,   String
      attribute :nav_order, Integer

      member path: "/",              label: "Home", cache: "home", source: "global:home", seo: "home", nav_order: 1
      member path: "/events",        label: "Events", source: "global:events", seo: "events", nav_order: 2
      member path: "/cms/*",         kind: "proxy", origin: "cms", auth: "admin", methods: "GET,POST,PUT,PATCH,DELETE"
      member path: "/:slug.html",    render: "ssr", methods: "GET"
      member path: "/admin*",        kind: "proxy", auth: "admin", methods: "GET,POST"
      member path: "/admin-orders.html", render: "ssr", auth: "admin", methods: "GET"
      member path: "/admin-login",   render: "ssr", cache: "no_store", methods: "GET", indexable: false
      member path: "/api/cms-sso",   kind: "endpoint", auth: "admin", methods: "GET"
      member path: "/admin-preview/*", kind: "proxy", auth: "admin", methods: "GET"
      member path: "/*",             kind: "proxy"
    end

    value_object "Admin" do
      attribute :session_cookie,  String
      attribute :host_env,        String
      attribute :login,           String
      attribute :sso,             String
      attribute :session_max_age, Integer
      attribute :host_default,    String
      attribute :roles,           String
      attribute :verdict_ttl_ms,  Integer

      member session_cookie: "club_session", host_env: "CLUB_DOMAIN_SERVICE_URL", login: "/admin-login",
             sso: "/api/cms-sso", host_default: "http://127.0.0.1:4500", roles: "Admin,Owner",
             verdict_ttl_ms: 2000
    end

    value_object "Secrets" do
      attribute :vault,   String
      attribute :item,    String
      attribute :section, String

      member vault: "Club", item: "club-site", section: "local"
    end

    value_object "Env" do
      attribute :name,  String
      attribute :value, String

      member name: "SESSION_SECRET"
      member name: "PAYLOAD_SECRET"
      member name: "HECKS_SESSION_COOKIE", value: "club_session"
      member name: "DATABASE_URI", value: "file:./club-cms.db"
    end

    value_object "Cms" do
      attribute :heap_mb, Integer

      member heap_mb: 768
    end

    value_object "BootSecret" do
      attribute :env,   String
      attribute :from,  String
      attribute :field, String

      member env: "AUTH_SECRET", from: "AUTH_SECRET_ARN", field: "session_secret"
      member env: "ANALYTICS_KEY_JSON", from: "ANALYTICS_SECRET_ID"
    end

    value_object "Ci" do
      attribute :gem_dir, String
      attribute :paths,   String
      attribute :test,    String

      member gem_dir: "club", paths: "site-routes/**,src/**", test: "npm run check"
    end

    value_object "Payload" do
      attribute :domain,  String
      attribute :chapter, String
      attribute :skip,    String

      member domain: "domain", chapter: "Club"
    end

    value_object "PayloadField" do
      attribute :aggregate,   String
      attribute :attribute,   String
      attribute :field,       String
      attribute :kind,        String
      attribute :options,     String
      attribute :relation,    String
      attribute :label,       String
      attribute :description, String
      attribute :required,    Boolean

      member aggregate: "Meeting", attribute: "slug", description: "The meeting's address."
      member aggregate: "Meeting", attribute: "kind", kind: "select", options: "talk=Talk,social=Social"
      member aggregate: "Meeting", attribute: "starts_on", kind: "date", description: "When it starts."
      member aggregate: "Meeting", attribute: "join_link", description: "Full https:// address."
      member aggregate: "Meeting", attribute: "cover", kind: "upload", relation: "media"
      member aggregate: "Meeting", attribute: "agenda", label: "Item|Items"
      member aggregate: "Meeting", attribute: "agenda.starts", kind: "date"
      member aggregate: "Meeting", attribute: "agenda.details", kind: "textarea", required: false
      member aggregate: "Meeting", attribute: "tags", label: "Tag|Tags"
      member aggregate: "Notice", attribute: "posted_on", field: "postedDate", kind: "day"
      member aggregate: "Notice", attribute: "summary", kind: "textarea"
    end
  end
end
