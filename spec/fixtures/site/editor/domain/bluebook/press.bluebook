# A small publisher's content domain, as the neutral fixture the editor generator reads: an
# aggregate identified by a slug, value-object attributes (single-part and several-part), lists of
# value objects nested two levels deep (sections of links; a body of blocks of spans), optional
# attributes, a lifecycle with transitions, commands that refer to the instance they act on, and
# queries. A second aggregate has no lifecycle and no query.
Hecks.bluebook "Press" do
  vision "The articles and the settings a small publisher keeps."
  core

  aggregate "Article" do
    description "One piece the publisher writes, from draft to archive."

    identified_by :slug

    value_object "ArticleSlug" do
      attribute :value, String
      invariant("an article has a slug") { !value.to_s.empty? }
    end

    value_object "Headline" do
      attribute :value, String
      invariant("an article has a headline") { !value.to_s.empty? }
    end

    value_object "Standfirst" do
      attribute :value, String
    end

    value_object "Byline" do
      attribute :name, String
      attribute :contact, String
    end

    value_object "Tag" do
      attribute :value, String
    end

    value_object "Link" do
      attribute :label, String
      attribute :url,   String
    end

    value_object "Section" do
      attribute :heading, String
      attribute :links,   list_of(Link)
    end

    value_object "Span" do
      attribute :from, Integer
      attribute :to,   Integer
      attribute :mark, String
    end

    value_object "Block" do
      attribute :kind,  String
      attribute :text,  String
      attribute :spans, list_of(Span)
    end

    value_object "Body" do
      attribute :blocks, list_of(Block)
    end

    attribute :slug,       ArticleSlug
    attribute :headline,   Headline
    attribute :standfirst, Standfirst, optional: true
    attribute :byline,     Byline
    attribute :tags,       list_of(Tag)
    attribute :sections,   list_of(Section)
    attribute :body,       Body

    lifecycle :status, default: "draft" do
      transition "Publish" => "published", from: "draft"
      transition "Archive" => "archived", from: ["draft", "published"]
      transition "Restore" => "draft", from: "archived"
    end

    command "Draft" do
      role "Editor"
      goal "Start an article the site does not show yet"

      attribute :slug,       ArticleSlug
      attribute :headline,   Headline
      attribute :standfirst, Standfirst, optional: true
      attribute :byline,     Byline
      attribute :tags,       list_of(Tag)
      attribute :sections,   list_of(Section)
      attribute :body,       Body

      emits "ArticleDrafted"
    end

    command "Revise" do
      role "Editor"
      goal "Change an article's words"
      reference_to Article

      attribute :headline,   Headline
      attribute :standfirst, Standfirst, optional: true
      attribute :byline,     Byline
      attribute :tags,       list_of(Tag)
      attribute :sections,   list_of(Section)
      attribute :body,       Body

      emits "ArticleRevised"
    end

    command "Publish" do
      role "Editor"
      goal "Put a drafted article on the site"
      reference_to Article

      emits "ArticlePublished"
    end

    command "Archive" do
      role "Editor"
      goal "Take an article off the site and out of the way"
      reference_to Article

      emits "ArticleArchived"
    end

    command "Restore" do
      role "Editor"
      goal "Bring an archived article back as a draft"
      reference_to Article

      emits "ArticleRestored"
    end

    query "Published" do
      description "Every article the site shows."
      where(status: "published")
    end

    query "ByHeadline" do
      description "Articles with exactly this headline."
      attribute :headline, Headline
      where(headline: :headline)
    end
  end

  aggregate "Masthead" do
    description "The publisher's name and contact: one row, no lifecycle."

    identified_by :key

    value_object "MastheadKey" do
      attribute :value, String
    end

    value_object "Title" do
      attribute :value, String
    end

    attribute :key,   MastheadKey
    attribute :title, Title, optional: true

    command "Establish" do
      role "Editor"
      goal "Set the masthead"

      attribute :key,   MastheadKey
      attribute :title, Title, optional: true

      emits "MastheadEstablished"
    end
  end
end
