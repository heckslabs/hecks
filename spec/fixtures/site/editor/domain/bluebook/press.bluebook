# A small publisher's content domain, as the neutral fixture the editor generator reads: an
# aggregate identified by a slug, value-object attributes (single-part and several-part), lists of
# value objects nested two levels deep (sections of links; a body of blocks of spans), optional
# attributes, a lifecycle with transitions, commands that refer to the instance they act on, and
# queries. A second aggregate has no lifecycle and no query.
Hecks.bluebook "Press" do
  vision "The articles and the settings a small publisher keeps."
  core

  aggregate "Article" do
    description "One piece the publisher writes, from draft to archive."

    identified_by :slug

    value_object "ArticleSlug" do
      attribute :value, String
      invariant("an article has a slug") { !value.to_s.empty? }
    end

    value_object "Headline" do
      attribute :value, String
      invariant("an article has a headline") { !value.to_s.empty? }
    end

    value_object "Standfirst" do
      attribute :value, String
    end

    value_object "Byline" do
      attribute :name, String
      attribute :contact, String
    end

    value_object "Tag" do
      attribute :value, String
    end

    value_object "Link" do
      attribute :label, String
      attribute :url,   String
    end

    value_object "Section" do
      attribute :heading, String
      attribute :links,   list_of(Link)
    end

    value_object "Mark" do
      attribute :name, String
    end

    value_object "Span" do
      attribute :text,  String
      attribute :marks, list_of(Mark)
      attribute :href,  String, optional: true
    end

    value_object "Item" do
      attribute :spans,     list_of(Span)
      attribute :depth,     Integer, optional: true
      attribute :list_kind, String, optional: true
    end

    value_object "Block" do
      attribute :kind,      String
      attribute :level,     Integer, optional: true
      attribute :align,     String, optional: true
      attribute :indent,    Integer, optional: true
      attribute :spans,     list_of(Span)
      attribute :items,     list_of(Item)
      attribute :media_ref, String, optional: true
      attribute :alt,       String, optional: true
      attribute :caption,   String, optional: true
    end

    value_object "Body" do
      attribute :blocks, list_of(Block)
    end

    attribute :slug,       ArticleSlug
    attribute :headline,   Headline
    attribute :standfirst, Standfirst, optional: true
    attribute :byline,     Byline
    attribute :tags,       list_of(Tag)
    attribute :sections,   list_of(Section)
    attribute :body,       Body
    attribute :draft_body, Body, optional: true

    lifecycle :status, default: "draft" do
      transition "Publish" => "published", from: "draft"
      transition "Archive" => "archived", from: ["draft", "published"]
      transition "Restore" => "draft", from: "archived"
    end

    command "Draft" do
      role "Editor"
      goal "Start an article the site does not show yet"

      attribute :slug,       ArticleSlug
      attribute :headline,   Headline
      attribute :standfirst, Standfirst, optional: true
      attribute :byline,     Byline
      attribute :tags,       list_of(Tag)
      attribute :sections,   list_of(Section)
      attribute :body,       Body

      emits "ArticleDrafted"
    end

    command "Revise" do
      role "Editor"
      goal "Change an article's words"
      reference_to Article

      attribute :headline,   Headline
      attribute :standfirst, Standfirst, optional: true
      attribute :byline,     Byline
      attribute :tags,       list_of(Tag)
      attribute :sections,   list_of(Section)
      attribute :body,       Body

      emits "ArticleRevised"
    end

    command "SaveDraft" do
      role "Editor"
      goal "Keep an edit aside until it is promoted"
      reference_to Article

      attribute :draft_body, Body

      sets :draft_body

      emits "ArticleDraftSaved"
    end

    # `nothing` is never sent: it is how the bluebook clears an optional field, so the editor must
    # not offer it as a field of the form.
    command "PublishDraft" do
      role "Editor"
      goal "Promote the saved edit to the article's body"
      reference_to Article

      attribute :nothing, Body, optional: true

      given("an edit is saved") { draft_body.set? }
      sets :body, to: state(:draft_body)
      sets :draft_body, to: :nothing

      emits "ArticleDraftPublished"
    end

    command "DiscardDraft" do
      role "Editor"
      goal "Throw the saved edit away"
      reference_to Article

      attribute :nothing, Body, optional: true

      given("an edit is saved") { draft_body.set? }
      sets :draft_body, to: :nothing

      emits "ArticleDraftDiscarded"
    end

    command "Publish" do
      role "Editor"
      goal "Put a drafted article on the site"
      reference_to Article

      emits "ArticlePublished"
    end

    command "Archive" do
      role "Editor"
      goal "Take an article off the site and out of the way"
      reference_to Article

      emits "ArticleArchived"
    end

    command "Restore" do
      role "Editor"
      goal "Bring an archived article back as a draft"
      reference_to Article

      emits "ArticleRestored"
    end

    query "Published" do
      description "Every article the site shows."
      where(status: "published")
    end

    query "ByHeadline" do
      description "Articles with exactly this headline."
      attribute :headline, Headline
      where(headline: :headline)
    end
  end

  aggregate "Masthead" do
    description "The publisher's name and contact: one row, no lifecycle."

    identified_by :key

    value_object "MastheadKey" do
      attribute :value, String
    end

    value_object "Title" do
      attribute :value, String
    end

    # A document body under other names: the editor picks its widget by this shape, not by a name.
    value_object "Run" do
      attribute :text, String
    end

    value_object "Piece" do
      attribute :kind,  String
      attribute :spans, list_of(Run)
    end

    value_object "Statement" do
      attribute :blocks, list_of(Piece)
    end

    attribute :key,   MastheadKey
    attribute :title, Title, optional: true
    attribute :about, Statement, optional: true

    command "Establish" do
      role "Editor"
      goal "Set the masthead"

      attribute :key,   MastheadKey
      attribute :title, Title, optional: true
      attribute :about, Statement, optional: true

      emits "MastheadEstablished"
    end
  end

  aggregate "MediaItem" do
    description "A picture the publisher has uploaded: its record only, the bytes are kept elsewhere."

    identified_by :key

    value_object "PictureKey" do
      attribute :value, String
      invariant("a picture has a key") { !value.to_s.empty? }
    end

    value_object "AltText" do
      attribute :value, String
      invariant("a picture has alt text") { !value.to_s.strip.empty? }
    end

    value_object "MimeType" do
      attribute :value, String
    end

    value_object "Pixels" do
      attribute :value, Integer
    end

    value_object "FocalPoint" do
      attribute :x, Float
      attribute :y, Float
    end

    attribute :key,         PictureKey
    attribute :alt,         AltText
    attribute :mime_type,   MimeType
    attribute :width,       Pixels, optional: true
    attribute :height,      Pixels, optional: true
    attribute :focal_point, FocalPoint, optional: true

    command "RegisterPicture" do
      role "Editor"
      goal "Record a picture that has been uploaded"

      attribute :key,         PictureKey
      attribute :alt,         AltText
      attribute :mime_type,   MimeType
      attribute :width,       Pixels, optional: true
      attribute :height,      Pixels, optional: true
      attribute :focal_point, FocalPoint, optional: true

      emits "PictureRegistered"
    end

    query "Pictures" do
      description "Every registered picture."
    end
  end
end
