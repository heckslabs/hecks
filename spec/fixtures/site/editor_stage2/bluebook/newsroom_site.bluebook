# A small newsroom's site whose editor does what a working desk needs beyond editing: it runs the
# actions scheduled for a post when they come due, keeps a list of who changed what and puts a change
# back, lists the pictures already uploaded and where each is used, says who may edit, has a sign-in
# page of its own and draws an approximate preview. The neutral fixture those parts of the editor
# generator are held to. Its `Editor` row names six chapters; they refer to each other only by plain
# `<kind>:<slug>` keys.
Hecks.bluebook "NewsroomSite" do
  vision "The routes of a small newsroom's website, with an editor for its posts and pages."

  aggregate "SiteMap" do
    description "The newsroom site's routes."

    attribute :name, MapName
    identified_by :name

    value_object "MapName" do
      attribute :value, String
    end

    value_object "Route" do
      attribute :path,      String
      attribute :kind,      String
      attribute :render,    String
      attribute :auth,      String
      attribute :methods,   String
      attribute :cache,     String
      attribute :origin,    String
      attribute :source,    String
      attribute :indexable, Boolean
      attribute :label,     String
      attribute :nav_order, Integer

      member path: "/",            label: "Home", cache: "home", source: "global:home", nav_order: 1
      member path: "/editor*",     kind: "proxy", origin: "cms", auth: "admin", methods: "GET,POST"
      member path: "/admin-login", render: "ssr", cache: "no_store", methods: "GET", indexable: false
      member path: "/*",           kind: "proxy"
    end

    value_object "Editor" do
      attribute :domain,         String
      attribute :chapter,        String
      attribute :base_path,      String
      attribute :session_cookie, String
      attribute :host_cookie,    String
      attribute :host_env,       String
      attribute :host_default,   String
      attribute :roles,          String
      attribute :login,          String
      attribute :title,          String
      attribute :preview,        String
      attribute :zone,           String
      attribute :upload_env,        String
      attribute :upload_default,    String
      attribute :upload_api,        String
      attribute :members_aggregate, String
      attribute :admin_roles,       String
      attribute :sign_in,           String
      attribute :landing,           String

      member domain: "domain", chapter: "Publishing, Documents, Pictures, Discovery, Schedule, People",
             base_path: "/editor", session_cookie: "newsroom_editor", host_cookie: "newsroom_session",
             host_env: "NEWSROOM_DOMAIN_SERVICE_URL", host_default: "http://127.0.0.1:4500",
             roles: "Admin,Owner,Editor", login: "/admin-login", title: "Newsroom editor",
             preview: "https://site.example.com/{kind}/{slug}?preview=1", zone: "-07:00",
             upload_env: "NEWSROOM_FILES_URL", upload_default: "http://127.0.0.1:4501", upload_api: "/files/api",
             members_aggregate: "People::Person", admin_roles: "Admin,Owner",
             sign_in: "/auth/google", landing: "/admin.html"
    end

    # A post's photo is a file kept by the content system, at the address it gives back.
    value_object "EditorField" do
      attribute :aggregate, String
      attribute :attribute, String
      attribute :kind,      String
      attribute :picks,     String

      member aggregate: "Post", attribute: "photo", kind: "image", picks: "media"
    end

    # What a due scheduled action does to a record of each aggregate: the commands to try, in order.
    value_object "EditorRun" do
      attribute :aggregate, String
      attribute :action,    String
      attribute :command,   String

      member aggregate: "Post", action: "publish", command: "Publish"
      member aggregate: "Post", action: "withdraw", command: "Withdraw"
    end
  end
end
