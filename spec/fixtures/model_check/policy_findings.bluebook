Hecks.bluebook "PolicyFindings" do
  vision "One aggregate and two policies — one deaf, one aimed at nothing."
  core

  aggregate "Note" do
    identified_by :number

    attribute :number, Number

    value_object "Number" do
      attribute :value, String
    end

    command "Write" do
      role "Tester"
      goal "Bring a note into being"
      attribute :number, Number
      emits "NoteWritten"
    end

    command "Stamp" do
      role "Tester"
      goal "A real command, so the trigger-resolves test has something true to contrast against"
      reference_to Note
      emits "NoteStamped"
    end
  end

  # Deaf policy: nothing in this domain ever emits "NoteArchived".
  policy "OnArchive" do
    on      "NoteArchived"
    trigger Note::Stamp
  end

  # Unknown trigger: the event is real, but "Note.Vanish" resolves to no command.
  policy "OnWrite" do
    on      "NoteWritten"
    trigger Note::Vanish
  end
end
