Hecks.bluebook "LifecycleFindings" do
  vision "One aggregate, one entity, four lifecycle finding kinds — each construct exists to fire exactly one."
  core

  aggregate "Widget" do
    identified_by :number

    attribute :number, Number
    attribute :parts,  list_of(Part)

    value_object "Number", String

    # Unreachable state and dead transition from one declaration: no other transition
    # reaches "orphaned", and the transition into it has an unreachable source.
    lifecycle :status, default: "new" do
      transition "Activate" => "active",   from: "new"
      transition "Retire"   => "orphaned", from: "abandoned"
      # Unknown command: nothing on Widget is ever called "Vanish".
      transition "Vanish"   => "gone",     from: "active"
    end

    command "Open" do
      role "Tester"
      goal "Bring a widget into being"
      attribute :number, Number
      emits "Opened"
    end

    command "Activate" do
      role "Tester"
      goal "Move it to active"
      reference_to Widget
      emits "Activated"
    end

    command "Retire" do
      role "Tester"
      goal "Declared, but its transition's own from: is never reached — dead by construction"
      reference_to Widget
      emits "Retired"
    end

    entity "Part" do
      identified_by :serial
      attribute :serial, Serial

      # Stuck state: reachable as the default, but nothing transitions out (a warning).
      lifecycle :status, default: "mounted" do
      end

      command "Mount" do
        role "Tester"
        goal "no-op, exists so the entity has at least one command"
        attribute :serial, Serial
        emits "Mounted"
      end
    end

    value_object "Serial", String
  end

  # Terminal exempt: unlike Widget::Part's empty lifecycle, this one declares a real
  # transition elsewhere, so `terminal_exempt` raises no stuck_state for "queued".
  aggregate "Gadget" do
    identified_by :code

    attribute :code, Code

    value_object "Code", String

    lifecycle :status, default: "queued" do
      transition "Escalate" => "escalated", from: "flagged"
    end

    command "Enqueue" do
      role "Tester"
      goal "Bring a gadget into being"
      attribute :code, Code
      emits "Enqueued"
    end

    command "Escalate" do
      role "Tester"
      goal "Declared so terminal_exempt has a real transition to reason about"
      reference_to Gadget
      emits "Escalated"
    end
  end

  # A state marked :terminal raises no stuck_state: Shipment ends deliberately in "closed".

  aggregate "Shipment" do
    identified_by :code

    attribute :code, Code

    value_object "Code", String

    lifecycle :status, default: "open" do
      transition "Close" => "closed", from: "open"
      mark :terminal, "closed"
    end

    command "Open" do
      role "Tester"
      goal "Bring one into being"
      attribute :code, Code
      emits "ShipmentOpened"
    end

    command "Close" do
      role "Tester"
      goal "End the shipment"
      reference_to Shipment
      emits "ShipmentClosed"
    end
  end

  # A :terminal state a transition still leaves is a terminal_has_exit error.

  aggregate "Parcel" do
    identified_by :code

    attribute :code, Code

    value_object "Code", String

    lifecycle :status, default: "open" do
      transition "Close"  => "closed", from: "open"
      transition "Reopen" => "open",   from: "closed"
      mark :terminal, "closed"
    end

    command "Open" do
      role "Tester"
      goal "Bring one into being"
      attribute :code, Code
      emits "ParcelOpened"
    end

    command "Close" do
      role "Tester"
      goal "Close the parcel"
      reference_to Parcel
      emits "ParcelClosed"
    end

    command "Reopen" do
      role "Tester"
      goal "Contradicts the terminal mark"
      reference_to Parcel
      emits "ParcelReopened"
    end
  end
end
