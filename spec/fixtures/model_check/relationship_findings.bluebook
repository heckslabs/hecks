Hecks.bluebook "RelationshipFindings" do
  vision "Four cross-domain policies — unacknowledged, contradictory (twice), and clean."
  core

  aggregate "Thing" do
    identified_by :number

    attribute :number, Number

    value_object "Number" do
      attribute :value, String
    end

    command "Do" do
      role "Tester"
      goal "A real local command, so trigger has something true to resolve"
      emits "ThingDone"
    end
  end

  # Unacknowledged: across "Elsewhere" with no attaches or subscribe in the hecksagon.
  policy "OnElsewhere" do
    on      "ThingDone"
    trigger Elsewhere::SomeCommand
    across  "Elsewhere"
  end

  # Contradictory: across "Governance" while the hecksagon also attaches it,
  # claiming Shared Kernel and Customer/Supplier at once.
  policy "OnGovernance" do
    on      "ThingDone"
    trigger Governance::SomeCommand
    across  "Governance"
  end

  # Contradictory too: Tenancy is a chapter the gem carries rather than a framework member, and
  # `attaches` covers it the same way.
  policy "OnTenancy" do
    on      "ThingDone"
    trigger Tenancy::SomeCommand
    across  "Tenancy"
  end

  # Clean: a matching subscribe "Known.*" in the hecksagon must not be flagged.
  policy "OnKnown" do
    on      "ThingDone"
    trigger Known::SomeCommand
    across  "Known"
  end
end
