Hecks.bluebook "RelationshipFindings" do
  vision "Four cross-domain policies — one unacknowledged, three acknowledged (two by attaches, one by subscribe)."
  core

  aggregate "Thing" do
    identified_by :number

    attribute :number, Number

    value_object "Number" do
      attribute :value, String
    end

    command "Do" do
      role "Tester"
      goal "A real local command, so trigger has something true to resolve"
      emits "ThingDone"
    end
  end

  # Unacknowledged: across "Elsewhere" with no attaches or subscribe in the hecksagon.
  policy "OnElsewhere" do
    on      "ThingDone"
    trigger Elsewhere::SomeCommand
    across  "Elsewhere"
  end

  # Acknowledged: across "Governance", which the hecksagon attaches, so this context depends on
  # Governance and calls its command in that one direction.
  policy "OnGovernance" do
    on      "ThingDone"
    trigger Governance::SomeCommand
    across  "Governance"
  end

  # Acknowledged too: Tenancy is a bluebook the gem carries rather than a framework member, and
  # `attaches` covers it the same way.
  policy "OnTenancy" do
    on      "ThingDone"
    trigger Tenancy::SomeCommand
    across  "Tenancy"
  end

  # Clean: a matching subscribe "Known.*" in the hecksagon must not be flagged.
  policy "OnKnown" do
    on      "ThingDone"
    trigger Known::SomeCommand
    across  "Known"
  end
end
