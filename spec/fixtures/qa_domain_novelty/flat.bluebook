# Fixture for spec/qa_domain_novelty_spec.rb: a flat bluebook, which bin/qa_domain_novelty
# refuses (a stress domain is `<name>/bluebook/<name>.bluebook`, never a bare file).
Hecks.bluebook "Flat" do
  generic

  aggregate "Thing" do
    identified_by :name
    attribute :name, Name
    value_object("Name") { attribute :value, String }

    command "Make" do
      attribute :name, Name
      sets :name
      emits "Made"
    end
  end
end
