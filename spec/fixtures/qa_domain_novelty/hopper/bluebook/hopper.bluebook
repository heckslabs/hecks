# Fixture for spec/qa_domain_novelty_spec.rb: the candidate side, `baseline` plus a
# Proposal aggregate whose `where` hops twice (Proposal -> Engagement -> Client).
Hecks.bluebook "Hopper" do
  generic

  aggregate "Client" do
    identified_by :name
    attribute :name, Name
    value_object("Name") { attribute :value, String }

    lifecycle :status, default: "active" do
      transition "Churn" => "churned", from: "active"
    end

    command "Register" do
      attribute :name, Name
      sets :name
      emits "Registered"
    end

    command "Churn" do
      reference_to Client
      emits "Churned"
    end
  end

  aggregate "Engagement" do
    identified_by :reference
    reference_to Client
    attribute :reference, Reference
    value_object("Reference") { attribute :value, String }

    lifecycle :stage, default: "started" do
      transition "Close" => "closed", from: "started"
    end

    command "Start" do
      reference_to Client
      attribute :reference, Reference
      sets :reference
      sets :client
      emits "Started"
    end

    command "Close" do
      reference_to Engagement
      emits "Closed"
    end

    query "Started" do
      where stage: "started"
    end
  end

  aggregate "Proposal" do
    identified_by :number
    reference_to Engagement
    attribute :number, Number
    value_object("Number") { attribute :value, String }

    command "Draft" do
      reference_to Engagement
      attribute :number, Number
      sets :number
      sets :engagement
      emits "Drafted"
    end

    query "FromActiveClients" do
      where :"engagement/client/status" => "active"
    end
  end
end
