Hecks.bluebook "Reflex" do
  vision "An event arrives and a command fires — the whole of a policy, in one aggregate."
  core

  aggregate "Light" do
    description "A light that logs its own flip"

    identified_by :name

    attribute :name,      LightName
    attribute :condition, LightCondition

    value_object "LightName" do
      attribute :value, String
    end

    value_object "LightCondition" do
      attribute :value, String
    end

    command "Flip" do
      role "Operator"
      goal "Turn the light on"

      attribute :name, LightName

      sets :condition, to: { value: "on" }

      emits "Flipped"
    end

    # Mutating, not creating: the policy re-dispatches it against the light Flip created,
    # and a creating command refuses a second creation over the same identity.
    command "Log" do
      role "System"
      goal "Record that the flip was noticed"

      reference_to Light

      sets :condition, to: { value: "logged" }
    end

    policy "LogOnFlip" do
      on      "Flipped"
      trigger Light::Log
    end

    # Exercises every query option (offset, nulls, authorize, inspect_query) so the
    # Query.Option verb is dispatched somewhere. `cursor` is refused at build, so it is absent.
    # Lives here, not in an example, because a fixture stays out of the frozen corpus goldens.
    query "Lit" do
      description "Lights that are on, most recent first, with every option a query can carry"
      where(condition: "on")
      order_by :condition, :desc
      limit 10
      offset 5
      nulls :last
      authorize :operator_access, tenant: :condition
      inspect_query :sql
    end
  end

  aggregate "Echo" do
    description "A bell whose ring makes it ring"

    identified_by :name

    attribute :name,  BellName
    attribute :rings, RingCount

    value_object "BellName" do
      attribute :value, String
    end

    value_object "RingCount" do
      attribute :value, Integer
    end

    command "Install" do
      role "Operator"
      goal "Hang a bell that can be rung"

      attribute :name, BellName

      emits "Installed"
    end

    # Mutating, not creating: the MAX_REACTION_DEPTH loop guard needs the same record
    # to be ringable repeatedly, and a creating command refuses a second creation.
    command "Ring" do
      role "Operator"
      goal "Ring the bell, which rings the bell"

      reference_to Echo

      emits "Rang"
    end

    policy "RingOnRang" do
      on      "Rang"
      trigger Echo::Ring
    end
  end

  aggregate "Beacon" do
    description "A beacon that signals a domain which is not loaded — the undeliverable reaction, which must be recorded rather than swallowed"

    identified_by :signal

    attribute :signal, SignalName

    value_object "SignalName" do
      attribute :value, String
    end

    command "Raise" do
      role "Operator"
      goal "Raise the beacon and announce it outward"

      emits "Raised"
    end

    policy "NotifyOnRaise" do
      on      "Raised"
      trigger Notifications::Send
      across  "Notifications"
    end
  end

  # A read model carrying the same options a query does, so ReadModel.Option is exercised.
  # Its filters (where, order_by, limit) are covered elsewhere (spec/orchestration_spec).
  read_model "Signals" do
    description "Every echo gathered around a light, with the options a projection can carry"
    reference_to Light

    include Echo

    offset 5
    nulls :last
    authorize :operator_access, tenant: :condition
    inspect_query :sql
  end
end
