Hecks.hecksagon "Lamps" do
  attaches "Bulk"
  persisted_by "Memory"
end

Hecks.hecksagon "Bulk" do
  attaches "Governance"
  Bulk::BulkRun.persisted_by("Memory")
end

Hecks.hecksagon "Governance" do
  Governance::RoleAssignment.persisted_by("Memory")
  Governance::RoleTransition.persisted_by("Memory")
end
