Hecks.bluebook "Shaped" do
  aggregate "Customer" do
    identified_by :full_name

    attribute :full_name, FullName

    value_object "FullName" do
      attribute :value, String
    end
  end

  aggregate "Account" do
    identified_by :number

    # Explicit `as:` because a bare `reference_to` names itself differently under
    # EraGuard.shadow_parse (`customer_id`) than live (`customer`), which reads as shape
    # drift (ADR 0025).
    reference_to Customer, as: :customer

    attribute :number,  AccountNumber
    attribute :balance, Money
    attribute :tags,    list_of(Tag)

    lifecycle :status, default: "open" do
      transition "Close" => "closed", from: "open"
    end

    value_object "AccountNumber" do
      attribute :value, String
    end

    value_object "Money" do
      attribute :cents,    Integer
      attribute :currency, String, default: "USD"
    end

    value_object "Tag" do
      attribute :value, String
    end

    command "Open" do
      attribute :number,  AccountNumber
      attribute :balance, Money

      emits "AccountOpened"
    end

    command "Close" do
      reference_to Account

      given("an account must be open to close") { status == "open" }

      emits "AccountClosed"
    end
  end
end
