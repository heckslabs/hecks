Hecks.bluebook "Shaped" do
  aggregate "Customer" do
    identified_by :full_name

    attribute :full_name, FullName

    value_object "FullName", String
  end

  aggregate "Account" do
    identified_by :number

    reference_to Customer, as: :customer

    attribute :number,  AccountNumber
    attribute :balance, Money
    attribute :tags,    list_of(Tag)

    lifecycle :phase, default: "open" do
      transition "Close" => "closed", from: "open"
    end

    value_object "AccountNumber", String

    value_object "Money" do
      attribute :cents,    Integer
      attribute :currency, String, default: "USD"
    end

    value_object "Tag", String

    command "Open" do
      attribute :number,  AccountNumber
      attribute :balance, Money

      emits "AccountOpened"
    end

    command "Close" do
      reference_to Account

      given("an account must be open to close") { phase == "open" }

      emits "AccountClosed"
    end
  end
end
