# Memory-bound wiring for sentence_form.examples, after examples/pizzas/pizzas_behaviors.hecksagon:
# the roles are checked by an attached Governance, and the payment gateway is the port the domain
# listens on. The examples run without anything answering it.
Hecks.hecksagon "Pizzas" do
  attaches "Governance"
  Pizzas::Order.persisted_by("Memory")

  Pizzas::Order.port "PaymentGateway" do
    operation "Receive" do
      attribute :customer_name, CustomerName
      attribute :amount, Price
      emits "PizzaPaymentReceived"
    end
  end
end

Hecks.hecksagon "Governance" do
  Governance::RoleAssignment.persisted_by("Memory")
  Governance::RoleTransition.persisted_by("Memory")
end
