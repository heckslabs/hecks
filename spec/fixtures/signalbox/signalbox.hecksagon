# Signalbox bound as signalbox.hecksagon binds it, for signalbox.behaviors: a behaviors boot binds
# the adapters beside its first file, so the replayed `Looking` in adapters/ stands in for the
# real one, which reads git, the machine and Delegate.
Hecks.hecksagon "Signalbox" do
  attaches "Governance"
  persisted_by "Memory"
end

Hecks.hecksagon "Governance" do
  persisted_by "Memory"
end
