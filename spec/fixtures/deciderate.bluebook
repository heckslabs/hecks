Hecks.bluebook "Deciderate" do
  supporting
  aggregate "Game" do
    identified_by :label
    attribute :label, GameLabel
    value_object("GameLabel") { attribute :value, String }
    command("StartGame") { attribute :label, GameLabel }
  end
  aggregate "Bubble" do
    identified_by :label
    attribute :label, BubbleLabel
    value_object("BubbleLabel") { attribute :value, String }
    command("PopBubble") { attribute :label, BubbleLabel }
  end
end
