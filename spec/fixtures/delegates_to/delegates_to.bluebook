# Fixture for `delegates_to`: an aggregate-level command hands its dispatch to one
# nested entity command, synchronously and atomically.
Hecks.bluebook "DelegatesTo" do
  vision "A board holding pieces, and an aggregate-level MovePiece a caller dispatches instead of ever naming the entity directly."
  core

  aggregate "Board" do
    description "A board. MovePiece is the only door a caller uses to move a piece — Piece.Move itself is never dispatched directly here."

    identified_by :name

    attribute :name,       BoardName
    attribute :pieces,     list_of(Piece)
    attribute :move_count, MoveCount

    value_object "BoardName" do
      attribute :value, String
    end

    value_object "PieceId" do
      attribute :value, String
    end

    value_object "Square" do
      attribute :file, Integer
      attribute :rank, Integer
    end

    # MoveCount, BumpMoveCount and the policy below pin that ambient args (such as `name`,
    # absent from `with:`) reach the delegated entity command, so a policy can re-locate
    # this aggregate by identity.
    value_object "MoveCount" do
      attribute :value, Integer, default: 0
    end

    value_object "RelabelReason" do
      attribute :value, String
    end

    command "OpenBoard" do
      goal "Start a fresh, empty board"

      attribute :name, BoardName

      emits "BoardOpened"
    end

    command "BumpMoveCount" do
      goal "One piece somewhere on this board just moved"

      reference_to Board
      attribute :to, Square, optional: true

      sets :move_count, increment: 1

      emits "MoveCountBumped"
    end

    command "PlacePiece" do
      goal "Set a piece down on the board, for testing"

      reference_to Board
      attribute :id,     PieceId
      attribute :square, Square

      sets :pieces, append: { id: :id, square: :square }

      emits "PiecePlaced"
    end

    # Callers dispatch this, never Piece.Move directly; `with:` maps `id`/`to` onto Piece.Move.
    command "MovePiece" do
      goal "Move a specific piece, on the caller's behalf"

      reference_to Board
      attribute :id, PieceId
      attribute :to, Square

      delegates_to "Piece.Move", with: { id: :id, to: :to }
    end

    # `with:` maps `id` and `destination` onto Piece.Relabel, but deliberately never mentions
    # `reason` — pinning that a delegated dispatch still refuses the target command's own
    # absent required argument the same way a direct dispatch would.
    command "RelabelPiece" do
      goal "Relabel a specific piece, on the caller's behalf"

      reference_to Board
      attribute :id,          PieceId
      attribute :destination, Square

      delegates_to "Piece.Relabel", with: { id: :id, destination: :destination }
    end

    entity "Piece" do
      description "One piece. Its own Move is the real rule; MovePiece above is only the door a caller uses to reach it."

      attribute :id,     PieceId
      attribute :square, Square

      identified_by :id

      command "Move" do
        goal "Move to a square, if it actually differs from the current one"

        attribute :to, Square

        given("destination differs from current square") { square.file != to.file || square.rank != to.rank }

        sets :square, to: :to

        emits "PieceMoved"
      end

      # `reason` is required and never named by `RelabelPiece`'s `with:` — a direct dispatch
      # of `Piece.Relabel` omitting it must refuse, and so must a dispatch of `RelabelPiece`.
      command "Relabel" do
        goal "Move to a new square and record why, for testing the delegation argument gate"

        attribute :destination, Square
        attribute :reason,      RelabelReason

        sets :square, to: :destination

        emits "PieceRelabeled"
      end
    end
  end

  # Reacts to the delegated command's event and re-locates the Board by identity.
  policy "OnPieceMovedBumpMoveCount" do
    on "PieceMoved"
    trigger Board::BumpMoveCount
  end
end
