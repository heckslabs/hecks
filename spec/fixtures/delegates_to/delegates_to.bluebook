# A DEDICATED FIXTURE for `delegates_to` (CommandBuilder#delegates_to_impl's
# own comment has the full reasoning) — proves an aggregate-level command
# can hand its own dispatch to one nested entity command, synchronously,
# atomically, before the mechanism is used for real in a downstream
# project's own chess domain (the motivating need — see
# spec/word_coverage_spec.rb's own EXEMPT entry for `delegates_to`).
Hecks.bluebook "DelegatesTo" do
  vision "A board holding pieces, and an aggregate-level MovePiece a caller dispatches instead of ever naming the entity directly."
  core

  aggregate "Board" do
    description "A board. MovePiece is the only door a caller uses to move a piece — Piece.Move itself is never dispatched directly here."

    identified_by :name

    attribute :name,       BoardName
    attribute :pieces,     list_of(Piece)
    attribute :move_count, MoveCount

    value_object "BoardName" do
      attribute :value, String
    end

    value_object "PieceId" do
      attribute :value, String
    end

    value_object "Square" do
      attribute :file, Integer
      attribute :rank, Integer
    end

    # NOT TESTED FOR ITS OWN SAKE — this and `BumpMoveCount`/the policy
    # below exist to prove a real bug found live building this fixture's
    # own downstream consumer (a chess domain): `delegates_to`'s own
    # `with:` maps ONLY the fields it names, so a policy reacting to the
    # DELEGATED command's own emitted event and trying to re-locate THIS
    # aggregate by its own identity (`name`, never named in `with: {
    # id:, to: }`) found nothing — `reaction_log` read "no Board with
    # name.value ...", the delivery rescued and recorded, never raised
    # (the same shape the real bug read as "no Game with label.value
    # ..."). Fixed at `CommandInterpreter#step_delegate_to_entity` —
    # `target_args` now starts from a COPY of the delegating command's
    # own already-resolved args, so ambient context the caller never had
    # to name flows through, same as a direct entity dispatch always
    # would.
    value_object "MoveCount" do
      attribute :value, Integer, default: 0
    end

    command "OpenBoard" do
      goal "Start a fresh, empty board"

      attribute :name, BoardName

      emits "BoardOpened"
    end

    command "BumpMoveCount" do
      goal "One piece somewhere on this board just moved"

      reference_to Board
      attribute :to, Square, optional: true

      sets :move_count, increment: 1

      emits "MoveCountBumped"
    end

    command "PlacePiece" do
      goal "Set a piece down on the board, for testing"

      reference_to Board
      attribute :id,     PieceId
      attribute :square, Square

      sets :pieces, append: { id: :id, square: :square }

      emits "PiecePlaced"
    end

    # THE WHOLE POINT OF THIS FIXTURE — a caller dispatches THIS, never
    # "DelegatesTo::Board.Piece.Move" directly. `delegates_to`'s own
    # `with:` maps this command's own `id`/`to` onto Piece.Move's own
    # identically-named arguments.
    command "MovePiece" do
      goal "Move a specific piece, on the caller's behalf"

      reference_to Board
      attribute :id, PieceId
      attribute :to, Square

      delegates_to "Piece.Move", with: { id: :id, to: :to }
    end

    # A DOOR ONTO A ROLE-GUARDED TARGET — maps everything `Piece.Retire`
    # requires, so the only thing standing between a caller and the move is
    # that command's own `role`.
    command "RetirePiece" do
      goal "Retire a piece, on the caller's behalf"

      reference_to Board
      attribute :id,          PieceId
      attribute :destination, Square
      attribute :reason,      BoardName

      delegates_to "Piece.Retire", with: { id: :id, destination: :destination, reason: :reason }
    end

    # A DOOR THAT FORGETS ONE — never declares or maps `Piece.Retire`'s own
    # required `reason`, so a delegated dispatch has to refuse the same way a
    # direct one would.
    command "RetirePieceForgettingReason" do
      goal "Retire a piece, having forgotten what the target requires"

      reference_to Board
      attribute :id,          PieceId
      attribute :destination, Square

      delegates_to "Piece.Retire", with: { id: :id, destination: :destination }
    end

    entity "Piece" do
      description "One piece. Its own Move is the real rule; MovePiece above is only the door a caller uses to reach it."

      attribute :id,     PieceId
      attribute :square, Square

      identified_by :id

      command "Move" do
        goal "Move to a square, if it actually differs from the current one"

        attribute :to, Square

        given("destination differs from current square") { square.file != to.file || square.rank != to.rank }

        sets :square, to: :to

        emits "PieceMoved"
      end

      # A REQUIRED ARGUMENT THE DOOR CAN FORGET — half the regression case for
      # `CommandInterpreter#step_delegate_to_entity`'s own gate comment. Before
      # that fix, `RetirePieceForgettingReason` succeeded with `reason`
      # silently absent. The ROLE half lives in
      # `spec/fixtures/delegates_to_role/` instead: a declared `role` with no
      # Governance to check it against is refused at boot by
      # `Registry::Verification#refuse_ungoverned_roles!`, and THIS fixture is
      # booted for real (with `delegates_to_sqlite.hecksagon`) by
      # spec/behaviors/runner_spec.rb.
      command "Retire" do
        goal "Move a piece aside, with a reason"

        # NAMED `destination`, NOT `to` (as `Move` above does) — `to:` is also
        # the dispatcher's own routing keyword, so an attribute of that name
        # can only be addressed through the `to:`/`with:` envelope form. These
        # examples dispatch the entity command DIRECTLY as their control, which
        # uses plain kwargs, so the collision has to be avoided here.
        attribute :destination, Square
        attribute :reason,      BoardName

        sets :square, to: :destination

        emits "PieceRetired"
      end
    end
  end

  # THE POLICY THAT ACTUALLY PROVES THE AMBIENT-ARGS FIX — reacts to a
  # DELEGATED command's own emitted event and re-locates THIS aggregate
  # by its own identity, the same shape `domain/chess`'s real
  # `OnKnightMovedAdvancePly` is.
  policy "OnPieceMovedBumpMoveCount" do
    on "PieceMoved"
    trigger Board::BumpMoveCount
  end
end
