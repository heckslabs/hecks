Hecks.bluebook "Shop" do
  vision "A small shop whose widgets carry a free-text size."

  aggregate "Widget" do
    attribute :sku,  Sku
    attribute :size, Size
    identified_by :sku

    value_object "Sku", String

    value_object "Size", String

    lifecycle :status, default: "listed" do
      transition "Retire" => "retired", from: "listed"
    end

    command "List" do
      attribute :sku,  Sku
      attribute :size, Size

      sets :sku
      sets :size

      emits WidgetListed
    end

    command "Retire" do
      reference_to Widget

      emits WidgetRetired
    end
  end

  aggregate "Order" do
    attribute :number, Number
    identified_by :number

    value_object "Number", String

    command "Place" do
      attribute :number, Number

      sets :number

      emits OrderPlaced
    end
  end
end
