
# Exercises EntityInterpreter#apply_to_element's :append/:remove/:multiply/:clamp
# cases against a small synthetic entity (ADR 0026).
Hecks.bluebook "EntityListMutations" do
  vision "An entity that holds a list of its own — the shape Member.pairs and Dispatch.with_spec both need."
  core

  aggregate "Board" do
    description "A board holding one or more lists, each with its own tagged entries."

    identified_by :name

    attribute :name, BoardName
    attribute :lists, list_of(TaggedList)
    # Aggregate-level, filled by a bare `sets` from a whole-array argument: the shape
    # that pins Value::Coercion#hydrate_entity_list handing back real `Value`s so
    # `remove:` can match them (ADR 0047). Used by SetTags and RemoveTagFromBoard.
    attribute :tags, list_of(Tag)
    # Never set by any command — every board gets `Instance.defaults`' own fill,
    # `ListCount`'s declared `default: 0`, with no command ever offering a value.
    # `ByHighlightCount` exists to query it with a caller arg that omits its own
    # sole field, the same default-omission shape `AddPrice`/`RemovePrice` exercise below.
    attribute :highlight_count, ListCount

    value_object "BoardName" do
      attribute :value, String
    end

    value_object "Tag" do
      attribute :key,   String
      attribute :value, String
    end

    value_object "ListLabel" do
      attribute :value, String
    end

    value_object "ListCount" do
      attribute :value, Integer, default: 0
    end

    # A `list_of` element type with its own declared default: `AddPrice` never maps
    # `tier`, and `RemovePrice` may be handed a `price` naming only `name` — both rely
    # on this default filling in real dispatch's `Value.build`, which replay's own
    # independent recompute must fill the same way.
    value_object "PriceTier" do
      attribute :name, String
      attribute :tier, String, default: "standard"
    end

    entity "TaggedList" do
      description "One list, own its own tags — the entity-owned list attribute this whole fixture exists to exercise."

      attribute :label, ListLabel

      identified_by :label

      attribute :tags,   list_of(Tag)
      attribute :count,  ListCount
      attribute :prices, list_of(PriceTier)

      command "AddTag" do
        role "Editor"
        goal "Add a tag to this list"

        attribute :key,   String
        attribute :value, String

        sets :tags, append: { key: :key, value: :value }

        emits "TagAdded"
      end

      command "RemoveTag" do
        role "Editor"
        goal "Remove a tag from this list, by value"

        attribute :tag, Tag

        sets :tags, remove: :tag

        emits "TagRemoved"
      end

      command "Bump" do
        role "Editor"
        goal "Increment this list's own count"

        sets :count, increment: { value: 1 }

        emits "Bumped"
      end

      command "Scale" do
        role "Editor"
        goal "Multiply this list's own count"

        attribute :factor, Integer

        sets :count, multiply: :factor

        emits "Scaled"
      end

      command "Clamp" do
        role "Editor"
        goal "Bound this list's own count into a range"

        sets :count, clamp: [0, 10]

        emits "Clamped"
      end

      command "AddPrice" do
        role "Editor"
        goal "Add a price tier to this list, leaving `tier` to its own declared default"

        # `price_name`, not `name`: `name` is already Board's own routing identity arg.
        attribute :price_name, String

        # `tier` is deliberately unmapped: PriceTier's own `default: "standard"` must
        # fill it, the same way real dispatch's `Value.build` does.
        sets :prices, append: { name: :price_name }

        emits "PriceAdded"
      end

      command "RemovePrice" do
        role "Editor"
        goal "Remove a price tier from this list, by a possibly-partial value"

        attribute :price, PriceTier

        sets :prices, remove: :price

        emits "PriceRemoved"
      end
    end

    command "OpenBoard" do
      role "Editor"
      goal "Start a new board"

      attribute :name, BoardName

      emits "BoardOpened"
    end

    command "SetTags" do
      role "Editor"
      goal "Replace this board's own tags in one shot — bare `sets`, argument-sourced (ADR 0047's own repro shape)"

      reference_to Board
      attribute :tags, list_of(Tag)

      sets :tags

      emits "TagsSet"
    end

    command "RemoveTagFromBoard" do
      role "Editor"
      goal "Remove a tag from the board's own list, by value"

      reference_to Board
      attribute :tag, Tag

      sets :tags, remove: :tag

      emits "TagRemovedFromBoard"
    end

    command "AddList" do
      role "Editor"
      goal "Add a list to the board"

      reference_to Board
      attribute :label, ListLabel

      # `count: 0` is a literal (MutationApplier#resolve_append_source passes non-Symbols
      # through). It must be listed: `entity_element` only defaults fields already in the map.
      sets :lists, append: { label: :label, count: 0 }

      emits "ListAdded"
    end

    query "ByHighlightCount" do
      description "Boards matching a caller-supplied highlight count, possibly entirely omitted."

      attribute :count, ListCount
      where(highlight_count: :count)
      order_by :name
      limit 10
    end
  end
end
