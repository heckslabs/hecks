# Single-attribute value objects: the bare `value_object "Name", Type` shorthand, an
# author-named sole attribute (`Price{amount}`), and a bare-field query over each.
Hecks.bluebook "ScalarValueObjects" do
  vision "A single-attribute value object is a name for a scalar — it answers .value, and takes the bare scalar at the call site."
  core

  aggregate "Sticker" do
    description "A price sticker whose every field is a single-attribute value object."

    identified_by :ref

    attribute :ref,   StickerRef
    attribute :price, Price, default: { amount: 0 }
    attribute :shelf, Shelf, optional: true

    # Bare shorthand: one attribute named `value` of the given type.
    value_object "StickerRef", String
    value_object "Shelf", Integer

    # Same shape with an author-chosen field name; `.value` answers `amount`.
    value_object "Price" do
      attribute :amount, Integer
      invariant("a price is never negative") { amount >= 0 }
    end

    command "Print" do
      role "Clerk"
      goal "Print a sticker at a starting price"

      attribute :ref,   StickerRef
      attribute :price, Price

      sets :ref
      sets :price

      emits "StickerPrinted"
    end

    command "Reprice" do
      role "Clerk"
      goal "Change a sticker's price"

      reference_to Sticker
      attribute :price, Price

      sets :price

      emits "StickerRepriced"
    end

    # A bare field naming a single-attribute value object is an unambiguous comparison.
    query "AtPrice" do
      attribute :price, Price
      where price: :price
    end

    query "ByRef" do
      attribute :ref, StickerRef
      where ref: :ref
    end
  end
end
