# Ruby side of the dry_runs case in spec/qa_sweep_all_spec.rb: a well-behaved domain whose
# Rust twin (../qa_sweep_all_found_fixture_rust/src/main.rs) diverges on `dry_runs` alone.
Hecks.bluebook "QaSweepAllDryRunFixture" do
  vision "A trivially well-behaved domain, authored only so spec/qa_sweep_all_spec.rb can prove the dry_runs comparison surface finds a divergence on its own, with every other surface agreeing."

  aggregate "Gate" do
    description "One opened gate — nothing a fuzzer can ever catch on the Ruby side alone."

    identified_by :reference

    attribute :reference, GateReference

    value_object "GateReference" do
      attribute :value, String, pattern: '[^ \t\n\r]'
      invariant("a gate is referenced") { !value.to_s.empty? }
    end

    command "Open" do
      attribute :reference, GateReference

      sets :reference

      emits "GateOpened"
    end
  end
end
