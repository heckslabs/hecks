# THE "DRY RUNS FOUND SOMETHING" SIDE OF `spec/qa_sweep_all_spec.rb` —
# a trivially well-behaved Ruby domain, same spirit as its sibling
# `qa_sweep_all_found_fixture`: one aggregate, one creating command,
# nothing the Ruby side can ever get wrong. The divergence that example
# needs is on the `dry_runs` comparison surface ALONE — `../qa_sweep_all_
# found_fixture_rust/src/main.rs`'s `qa_sweep_all_dry_run_fixture`
# feature answers empty instances/events/refusals (exactly what Ruby
# produces when every command step is a dry run, `--dry-run 1`) and one
# dry-run entry per `"dry_run":` step naming a sentinel verb the Ruby
# side never dispatches, so `instances`/`events` AGREE and only
# `dry_runs` splits — see that file's own header for the full reasoning.
Hecks.bluebook "QaSweepAllDryRunFixture" do
  vision "A trivially well-behaved domain, authored only so spec/qa_sweep_all_spec.rb can prove the dry_runs comparison surface finds a divergence on its own, with every other surface agreeing."

  aggregate "Gate" do
    description "One opened gate — nothing a fuzzer can ever catch on the Ruby side alone."

    identified_by :reference

    attribute :reference, GateReference

    value_object "GateReference" do
      attribute :value, String, pattern: '[^ \t\n\r]'
      invariant("a gate is referenced") { !value.to_s.empty? }
    end

    command "Open" do
      attribute :reference, GateReference

      sets :reference

      emits "GateOpened"
    end
  end
end
