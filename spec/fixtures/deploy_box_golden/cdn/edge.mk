EDGE_STACK = hecks-widget-shop-edge

.PHONY: edge

# Creates or updates the CloudFront edge stack in front of the box (run `make stacks` first: the
# box's AppOriginDomain output is the distribution's origin). The certificate is never created
# here: issue it in ACM in us-east-1, validate its DNS records, then pass its ARN.
#   make edge CERTIFICATE_ARN=arn:aws:acm:us-east-1:<account>:certificate/<id>
edge:
	@test -n "$(CERTIFICATE_ARN)" || { echo "usage: make edge CERTIFICATE_ARN=arn:aws:acm:us-east-1:..." >&2; exit 1; }
	aws cloudformation deploy --region eu-west-1 --template-file edge.yaml --stack-name $(EDGE_STACK) \
		--parameter-overrides CertificateArn=$(CERTIFICATE_ARN) \
		AppOriginDomain=$$(aws cloudformation describe-stacks --region eu-west-1 --stack-name $(BOX_STACK) --query "Stacks[0].Outputs[?OutputKey=='AppOriginDomain'].OutputValue" --output text)
