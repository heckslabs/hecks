# widget-shop's proxy. Only requests that carry X-Origin-Secret with the origin secret are proxied;
# everything else gets a flat 403.
{
	# No certificate for the :80 site. disable_redirects, not off, so a listener a rehearsal
	# mounts under caddy-extra can still ask for `tls internal`.
	auto_https disable_redirects
	admin off
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:80 {
	@origin header X-Origin-Secret {$ORIGIN_SECRET}

	handle @origin {
		@r1 path /cms/*
		handle @r1 {
			reverse_proxy 127.0.0.1:8081 {
				lb_try_duration 15s
				lb_try_interval 250ms
			}
		}

		@r2 path /registrations /registrations/* /webhooks/*
		handle @r2 {
			reverse_proxy 127.0.0.1:8082 {
				lb_try_duration 15s
				lb_try_interval 250ms
			}
		}

		handle {
			reverse_proxy 127.0.0.1:8080 {
				lb_try_duration 15s
				lb_try_interval 250ms
			}
		}
	}

	handle {
		respond "Forbidden" 403
	}
}

# Rehearsal-only sites are mounted here; nothing matches in production. Restart the proxy
# after adding one: the admin API is off, so a reload cannot reach it.
import /etc/caddy/extra/*
