# GENERATED by hecks deploy project -- re-run it to refresh this file rather than hand-editing.
# Included by the Makefile beside it; settings come from the domain's deployed_to("AwsBox") block
# (hosting_scripts true).

HECKS   ?= hecks
SERVICE ?= website
URL     ?= https://widgets.example.com

.PHONY: deploy-service smoke-after-deploy check-era

# Pushes one container's already-built local image under a fresh tag and rolls it onto the box.
# Build the image first; see deploy-service.sh.
deploy-service:
	bash ./deploy-service.sh $(SERVICE)

# Waits for the last roll to settle, then dispatches and follows the smoke.
# SKIP_POST_DEPLOY_SMOKE=1 opts out, DRY_RUN=1 dispatches nothing.
smoke-after-deploy:
	bash ./smoke-after-deploy.sh

# Compares the era a live host reports at GET /version with expected-era.
check-era:
	@test -n "$(URL)" || { echo "usage: make check-era URL=https://host.example"; exit 1; }
	HECKS_ENVIRONMENT=memory $(HECKS) host.check_era host="$(URL)" expected=expected-era --wait
