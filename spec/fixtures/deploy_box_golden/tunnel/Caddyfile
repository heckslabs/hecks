# scratch-fixture's proxy. Every request is proxied.
{
	# No certificate for the :80 site. disable_redirects, not off, so a listener a rehearsal
	# mounts under caddy-extra can still ask for `tls internal`.
	auto_https disable_redirects
	admin off
}

:80 {
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}

# Rehearsal-only sites are mounted here; nothing matches in production. Restart the proxy
# after adding one: the admin API is off, so a reload cannot reach it.
import /etc/caddy/extra/*
