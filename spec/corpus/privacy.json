{
  "name": "privacy-parity",
  "note": "Mark one attribute of a foreign domain's aggregate sensitive then unmark it, and issue one subject's own encryption key then shred it — proves Mark/Unmark and Issue/Shred all work end to end, composite identity included both times.",
  "expectations": {
    "events": 6
  },
  "steps": [
    {
      "verb": "Privacy::Marking.Mark",
      "args": {
        "domain": { "value": "Studio::Registration" },
        "attribute_path": { "value": "attendee.medications" },
        "category": { "value": "phi" },
        "readable_by": { "value": "Privacy officer" }
      }
    },
    {
      "verb": "Privacy::Marking.Unmark",
      "args": {
        "domain": { "value": "Studio::Registration" },
        "attribute_path": { "value": "attendee.medications" }
      }
    },
    {
      "verb": "Privacy::SubjectKey.Issue",
      "args": {
        "domain": { "value": "Studio::Registration" },
        "subject_id": { "value": "attendee-482" }
      }
    },
    {
      "verb": "Privacy::SubjectKey.Shred",
      "args": {
        "domain": { "value": "Studio::Registration" },
        "subject_id": { "value": "attendee-482" }
      }
    }
  ]
}
