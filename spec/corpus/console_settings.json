{
  "name": "console-settings-parity",
  "note": "One aggregate's state styled (Declare, then every Set command including the opaque-passthrough SetExtra), one collection's own presentation curated (Declare, then a representative slice of every Set/Replace command, including identity_extra_json and a column's own extra_json), and the dashboard's own singleton overview stat list (Declare, then ReplaceStats) — enough to prove every declared command actually dispatches, not an exhaustive walk of every field combination. Ends by asking the two rootless, grouped reports (Styles, Curated) this domain's own presentation_config.rb dispatches for real.",
  "expectations": {
    "events": 12
  },
  "steps": [
    {
      "verb": "ConsoleSettings::StateStyle.Declare",
      "args": {
        "agg": { "value": "Client" },
        "state": { "value": "active" }
      }
    },
    {
      "verb": "ConsoleSettings::StateStyle.SetTone",
      "args": {
        "id": "Client:active",
        "tone": { "value": "good" }
      }
    },
    {
      "verb": "ConsoleSettings::StateStyle.SetAttention",
      "args": {
        "id": "Client:active",
        "attention": { "value": "false" }
      }
    },
    {
      "verb": "ConsoleSettings::StateStyle.SetExtra",
      "args": {
        "id": "Client:active",
        "extra_json": { "value": "{\"label\":\"Active client\"}" }
      }
    },
    {
      "verb": "ConsoleSettings::Collection.Declare",
      "args": {
        "agg": { "value": "Client" }
      }
    },
    {
      "verb": "ConsoleSettings::Collection.SetLabel",
      "args": {
        "id": "Client",
        "label": { "value": "Clients" }
      }
    },
    {
      "verb": "ConsoleSettings::Collection.SetNavOrder",
      "args": {
        "id": "Client",
        "nav_order": { "value": 1 }
      }
    },
    {
      "verb": "ConsoleSettings::CollectionIdentity.Declare",
      "args": {
        "agg": { "value": "Client" }
      }
    },
    {
      "verb": "ConsoleSettings::CollectionIdentity.SetIdentity",
      "args": {
        "id": "Client",
        "identity_field": { "value": "reference" },
        "identity_strategy": { "value": "sequence" },
        "identity_prefix": { "value": "C-" },
        "identity_extra_json": { "value": "{\"pad\":3}" }
      }
    },
    {
      "verb": "ConsoleSettings::Collection.SetExtra",
      "args": {
        "id": "Client",
        "extra_json": { "value": "{\"noun_sing\":\"client\",\"create_label\":\"Add client\"}" }
      }
    },
    {
      "verb": "ConsoleSettings::CollectionLayout.Declare",
      "args": {
        "agg": { "value": "Client" }
      }
    },
    {
      "verb": "ConsoleSettings::CollectionLayout.ReplaceColumns",
      "args": {
        "id": "Client",
        "columns": [
          { "field": "reference" },
          { "field": "name", "extra_json": "{\"as\":\"count\"}" }
        ]
      }
    },
    {
      "verb": "ConsoleSettings::Overview.Declare",
      "args": {
        "key": { "value": "overview" }
      }
    },
    {
      "verb": "ConsoleSettings::Overview.ReplaceStats",
      "args": {
        "id": "overview",
        "stats": [
          { "label": "Active clients", "collection": "clients", "as": "count", "where_json": "{\"state\":\"active\"}" }
        ]
      }
    },
    { "query": "ConsoleSettings.styles" },
    { "query": "ConsoleSettings.curated" },
    { "query": "ConsoleSettings.curated_identities" },
    { "query": "ConsoleSettings.curated_layouts" },
    { "query": "ConsoleSettings.curated_rules" }
  ]
}
