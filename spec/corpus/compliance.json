{
  "name": "compliance-parity",
  "note": "All three aggregates through their full lifecycle once each — a frozen account cleared (no finding), a surrendered box escalated (a real finding), a privacy marking cleared — proving Open/Clear/Escalate all work, not just the creating command.",
  "domain": "examples/compliance",
  "expectations": {
    "events": 6
  },
  "steps": [
    {
      "verb": "Compliance::AccountFreezeReview.Open",
      "args": {
        "number": { "value": "acct-1" }
      }
    },
    {
      "verb": "Compliance::AccountFreezeReview.Clear",
      "args": {
        "number": { "value": "acct-1" }
      }
    },
    {
      "verb": "Compliance::BoxSurrenderReview.Open",
      "args": {
        "branch_code": { "value": "DOWNTOWN" },
        "box_number": { "value": 12 }
      }
    },
    {
      "verb": "Compliance::BoxSurrenderReview.Escalate",
      "args": {
        "branch_code": { "value": "DOWNTOWN" },
        "box_number": { "value": 12 }
      }
    },
    {
      "verb": "Compliance::PrivacyReview.Open",
      "args": {
        "domain": { "value": "Lifeadelics::Registration" },
        "attribute_path": { "value": "attendee.medications" }
      }
    },
    {
      "verb": "Compliance::PrivacyReview.Clear",
      "args": {
        "domain": { "value": "Lifeadelics::Registration" },
        "attribute_path": { "value": "attendee.medications" }
      }
    }
  ]
}
