{
  "name": "compliance-parity",
  "note": "One review of each kind through its lifecycle — a frozen account cleared (no finding), a surrendered box escalated (a real finding), a privacy marking cleared — proving Open/Clear/Escalate all work on the one generic Review, not just the creating command.",
  "domain": "examples/compliance",
  "expectations": {
    "events": 6
  },
  "steps": [
    {
      "verb": "Compliance::Review.Open",
      "args": {
        "subject_kind": { "value": "account_freeze" },
        "subject_key": { "value": "acct-1" }
      }
    },
    {
      "verb": "Compliance::Review.Clear",
      "args": {
        "subject_kind": { "value": "account_freeze" },
        "subject_key": { "value": "acct-1" }
      }
    },
    {
      "verb": "Compliance::Review.Open",
      "args": {
        "subject_kind": { "value": "box_surrender" },
        "subject_key": { "value": "DOWNTOWN:12" }
      }
    },
    {
      "verb": "Compliance::Review.Escalate",
      "args": {
        "subject_kind": { "value": "box_surrender" },
        "subject_key": { "value": "DOWNTOWN:12" }
      }
    },
    {
      "verb": "Compliance::Review.Open",
      "args": {
        "subject_kind": { "value": "privacy_marking" },
        "subject_key": { "value": "Studio::Registration:attendee.medications" }
      }
    },
    {
      "verb": "Compliance::Review.Clear",
      "args": {
        "subject_kind": { "value": "privacy_marking" },
        "subject_key": { "value": "Studio::Registration:attendee.medications" }
      }
    }
  ]
}
