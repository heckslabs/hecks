{
  "name": "order-deadline-parity",
  "note": "Two orders hold the same stock; one is paid, the other is expired once its window has passed, and the saga gives its unit back (ADR 0169). Every clock reading is passed, so the replay compares values, not times.",
  "domain": "examples/order_deadline",
  "expectations": {
    "events": 8
  },
  "steps": [
    {
      "verb": "OrderDeadline::Stock.Stock",
      "args": { "sku": { "value": "lamp" } }
    },
    {
      "verb": "OrderDeadline::Order.Place",
      "args": { "reference": { "value": "o-1" }, "stock": "lamp", "now": { "value": 1000 } }
    },
    {
      "verb": "OrderDeadline::Order.Place",
      "args": { "reference": { "value": "o-2" }, "stock": "lamp", "now": { "value": 1000 } }
    },
    {
      "verb": "OrderDeadline::Order.Pay",
      "args": { "order": "o-1" }
    },
    {
      "verb": "OrderDeadline::Order.Expire",
      "args": { "order": "o-2", "now": { "value": 260200 } }
    }
  ]
}
