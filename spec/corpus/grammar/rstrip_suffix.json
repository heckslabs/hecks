{
  "grammar": [
    "G9"
  ],
  "canonical": "!title.to_s.rstrip.empty?",
  "ruby_only": false,
  "note": ".rstrip is Strip{receiver, side: right}, trimming Ruby's whitespace set (never a Unicode space); it wraps one receiver, so `.to_s.rstrip.empty?` nests Empty over Strip over ToS.",
  "expect_ast": {
    "op": "not",
    "expr": {
      "op": "empty",
      "receiver": {
        "op": "strip",
        "receiver": {
          "op": "to_s",
          "receiver": {
            "op": "lookup",
            "path": [
              "title"
            ]
          }
        },
        "side": "right"
      }
    }
  }
}
