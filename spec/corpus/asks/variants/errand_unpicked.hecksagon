# The Errand hecksagon with `run` on two ports and no `ask_via`: the ask is ambiguous.
Hecks.hecksagon "Errand" do
  Errand::Job.persisted_by("Memory")

  Errand::Job.port "Worker" do
    asks "Run", to: Job do
      attribute :ref, Ref
      answers "JobRan"
      refuses "JobRefused"
    end
  end

  Errand::Job.port "Inspector" do
    asks "Run", to: Job do
      attribute :ref, Ref
      answers "JobRan"
      refuses "JobRefused"
    end
  end
end
