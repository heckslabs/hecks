      "verb": "EmbryonautVendoringDemo::Gadget.Register",
      "args": {
        "name": {
          "value": "g1"
        }
      }
    },
    {
      "verb": "EmbryonautVendoringDemo::Gadget.Activate",
      "args": {
        "name": {
          "value": "g1"
        }
      }
    },
    {
      "verb": "Widgets::Widget.Create",
      "args": {
        "name": {
          "value": "w1"
        }
      }
    },
    {
      "verb": "Widgets::Widget.Retire",
      "args": {
        "name": {
          "value": "w1"
        }
      }
    }
  ]
}
