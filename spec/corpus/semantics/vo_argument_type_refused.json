{
  "domain": "examples/banking",
  "spec": [
    "C3.7",
    "C8.2"
  ],
  "note": "A declared value-object argument is coerced and validated before any given runs (C3.7). An amount whose cents arrive as a word is TypeMismatch (the numeric field's own wording, identical on both runtimes); an email that fails its declared pattern is TypeMismatch; neither touches state. A bare scalar offered where a value object goes is also TypeMismatch on both runtimes, but the two word it differently today (Ruby: value_object_shape; Rust: the missing field) — kept out of this fixture and noted for the structured-reason work of stage 8.",
  "steps": [
    {
      "verb": "Banking::Customer.Register",
      "args": {
        "reference": {
          "value": "cust-1"
        },
        "name": {
          "given": "Ada",
          "family": "Lovelace"
        },
        "email": {
          "address": "ada@example.com"
        }
      }
    },
    {
      "verb": "Banking::Account.Open",
      "args": {
        "customer": "cust-1",
        "number": {
          "value": "acct-1"
        },
        "kind": {
          "name": "current"
        },
        "daily_limit": {
          "cents": 50000
        }
      }
    },
    {
      "verb": "Banking::Account.Credit",
      "args": {
        "number": {
          "value": "acct-1"
        },
        "amount": {
          "cents": "ten",
          "currency": "USD"
        },
        "narrative": {
          "text": "a word where a count goes"
        }
      }
    },
    {
      "verb": "Banking::Customer.Register",
      "args": {
        "reference": {
          "value": "cust-2"
        },
        "name": {
          "given": "Bob",
          "family": "Hope"
        },
        "email": {
          "address": "not-an-email"
        }
      }
    }
  ],
  "expect": {
    "refusals": [
      {
        "verb": "Banking::Account.Credit",
        "error": "PositiveMoney.cents expects Integer, got \"ten\"",
        "kind": "TypeMismatch"
      },
      {
        "verb": "Banking::Customer.Register",
        "error": "EmailAddress.address must match ^[^@ ]+@[^@ ]+\\.[^@ ]+$, got \"not-an-email\"",
        "kind": "TypeMismatch"
      }
    ],
    "instances": {
      "Banking::Customer#cust-1": {
        "reference": {
          "value": "cust-1"
        },
        "name": {
          "given": "Ada",
          "family": "Lovelace"
        },
        "email": {
          "address": "ada@example.com"
        },
        "standing": {
          "value": "good"
        },
        "status": "active"
      },
      "Banking::Account#acct-1": {
        "customer": "cust-1",
        "number": {
          "value": "acct-1"
        },
        "balance": {
          "cents": 0,
          "currency": "USD"
        },
        "kind": {
          "name": "current"
        },
        "daily_limit": {
          "cents": 50000
        },
        "ledger": [

        ],
        "fees_cents": {
          "cents": 0,
          "currency": "USD"
        },
        "interest_cents": {
          "cents": 0,
          "currency": "USD"
        },
        "status": "open",
        "customer_status": "active"
      }
    },
    "events": [
      {
        "name": "CustomerRegistered",
        "aggregate": "Banking::Customer",
        "id": "cust-1",
        "payload": {
          "reference": {
            "value": "cust-1"
          },
          "name": {
            "given": "Ada",
            "family": "Lovelace"
          },
          "email": {
            "address": "ada@example.com"
          }
        }
      },
      {
        "name": "AccountOpened",
        "aggregate": "Banking::Account",
        "id": "acct-1",
        "payload": {
          "customer": "cust-1",
          "number": {
            "value": "acct-1"
          },
          "kind": {
            "name": "current"
          },
          "daily_limit": {
            "cents": 50000
          }
        }
      }
    ]
  }
}
