{
  "domain": "examples/banking",
  "spec": [
    "C1.3",
    "C8.2"
  ],
  "note": "Within one step, rules are checked in declaration order and the first failure refuses (C1.3). ApplyFee declares `customer is active` before `the balance covers a fee`; with the customer suspended AND a zero balance both fail, and the refusal cites the first.",
  "steps": [
    {
      "verb": "Banking::Customer.Register",
      "args": {
        "reference": {
          "value": "cust-1"
        },
        "name": {
          "given": "Ada",
          "family": "Lovelace"
        },
        "email": {
          "address": "ada@example.com"
        }
      }
    },
    {
      "verb": "Banking::Account.Open",
      "args": {
        "customer": "cust-1",
        "number": {
          "value": "acct-1"
        },
        "kind": {
          "name": "current"
        },
        "daily_limit": {
          "cents": 50000
        }
      }
    },
    {
      "verb": "Banking::Customer.Suspend",
      "args": {
        "reference": {
          "value": "cust-1"
        },
        "standing": {
          "value": "under review"
        }
      }
    },
    {
      "verb": "Banking::Account.ApplyFee",
      "args": {
        "number": {
          "value": "acct-1"
        },
        "amount": {
          "cents": 500,
          "currency": "USD"
        },
        "narrative": {
          "text": "monthly fee"
        }
      }
    }
  ],
  "expect": {
    "refusals": [
      {
        "verb": "Banking::Account.ApplyFee",
