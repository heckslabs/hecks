{
  "domain": "spec/corpus/semantics/domains/ledgerbook",
  "spec": [
    "C10.1"
  ],
  "note": "A plain policy's `with:` reads `:id`, the emitting record's whole identity (ADR 0144). Shelf is identified by row and slot, so the identity is composite and `:id` is the two joined by a colon; the Register note carries `A:3`, not either field alone.",
  "steps": [
    {
      "verb": "Ledgerbook::Shelf.Stock",
      "args": {
        "row": {
          "value": "A"
        },
        "slot": {
          "value": "3"
        }
      }
    }
  ],
  "expect": {
    "refusals": [],
    "instances": {
      "Ledgerbook::Shelf#A:3": {
        "row": {
          "value": "A"
        },
        "slot": {
          "value": "3"
        }
      },
      "Ledgerbook::Register#A:3": {
        "shelf": {
          "value": "A:3"
        }
      }
    },
    "events": [
      {
        "name": "ShelfStocked",
        "aggregate": "Ledgerbook::Shelf",
        "id": "A:3",
        "payload": {
          "row": {
            "value": "A"
          },
          "slot": {
            "value": "3"
          }
        }
      },
      {
        "name": "ShelfNoted",
        "aggregate": "Ledgerbook::Register",
        "id": "A:3",
        "payload": {
          "shelf": {
            "value": "A:3"
          }
        }
      }
    ]
  }
}
