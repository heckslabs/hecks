Hecks.bluebook "TallyGaps" do
  # A CORPUS-OWNED DOMAIN (docs/semantics/bluebook-semantics.md, §3 and §4) kept apart from
  # `tally` on purpose: every command here is one the Rust generator does not generate yet
  # (see the manifest's "not generated yet" reasons), so these fixtures are held to the Ruby
  # runtime only. `tally` has none of them, so Rust can be held to everything it declares.
  vision "The tally commands Rust cannot generate yet: arithmetic through a value object, remove on a value-object list, and an operand of the wrong type."
  core

  aggregate "Tally" do
    identified_by :tag

    attribute :tag,    Tag
    attribute :count,  Count,  default: { value: 0 }
    attribute :weight, Weight, default: { value: 0.0 }
    attribute :label,  Label,  default: { value: "" }
    attribute :limit,  Count,  optional: true
    attribute :tags,   list_of(Label)

    value_object "Tag" do
      attribute :value, String
    end

    value_object "Count" do
      attribute :value, Integer
    end

    value_object "Weight" do
      attribute :value, Float
    end

    value_object "Label" do
      attribute :value, String
    end

    command "Open" do
      goal "Start a tally"
      attribute :tag, Tag
      emits "TallyOpened"
    end

    # THE RULE ADDS FLOATS (C3.4): a sum that is not finite is a FAULT.
    command "Weigh" do
      goal "Add weight, but only while there is some"
      reference_to Tally
      attribute :more, Weight
      given("the total is positive") { weight.value + more.value > 0 }
      sets :weight, increment: :more
      emits "Weighed"
    end

    # NUMERIC COMPARISON IS BY VALUE ACROSS INTEGER AND FLOAT (C3.2):
    # a Float weight of 1.0 satisfies `== 1`.
    command "Certify" do
      goal "Certify a tally that weighs exactly one"
      reference_to Tally
      given("it weighs exactly one") { weight.value == 1 }
      emits "Certified"
    end

    # APPEND AND REMOVE (C4.3): remove takes every structurally-equal
    # element, append keeps order.
    command "TagWith" do
      goal "Add a tag"
      reference_to Tally
      attribute :label, Label
      sets :tags, append: { value: :label }
      emits "Tagged"
    end

    command "Untag" do
      goal "Remove every tag equal to the one given"
      reference_to Tally
      attribute :label, Label
      sets :tags, remove: :label
      emits "Untagged"
    end

    # A NON-NUMERIC OPERAND (C4.4): a Label carries a String, so adding it
    # to the count is a TypeMismatch refusal, not a fault.
    command "AddLabel" do
      goal "Add a label's text to the count"
      reference_to Tally
      attribute :label, Label
      sets :count, increment: :label
      emits "LabelAdded"
    end
  end
end
