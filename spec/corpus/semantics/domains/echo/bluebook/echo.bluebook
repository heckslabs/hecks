Hecks.bluebook "Echo" do
  # A CORPUS-OWNED DOMAIN (docs/semantics/bluebook-semantics.md, C10.4).
  # One policy that answers its own command's event with the same command, so a single Ping
  # starts a chain that never ends on its own. The reaction depth bound is the only thing that
  # stops it: five reactions below the root run, the sixth is recorded undelivered.
  vision "A ping is answered by another ping, until the reaction depth bound says enough."
  core

  aggregate "Beacon" do
    identified_by :name

    attribute :name, Name

    value_object "Name" do
      attribute :value, String
    end

    command "Light" do
      goal "Light a beacon"
      attribute :name, Name
      emits "BeaconLit"
    end

    command "Ping" do
      goal "Ping a beacon, which makes the beacon ping again"
      reference_to Beacon
      emits "Pinged"
    end

    policy "PingAgain" do
      on      "Pinged"
      trigger Beacon::Ping
    end
  end

  # THE SAME BOUND, SEEN FROM A SAGA (C10.4). A lamp flickers into another flicker forever. The
  # saga marks the lamp when it is lit, and that mark is compensable; the flicker the sixth
  # reaction announces reaches the saga at the ceiling, so its leg is refused and the saga
  # unwinds. The compensation is itself a reaction at that depth, so it is refused as well.
  aggregate "Lamp" do
    identified_by :name

    attribute :name, Name

    value_object "Name" do
      attribute :value, String
    end

    command "Install" do
      goal "Install a lamp"
      attribute :name, Name
      emits "LampInstalled"
    end

    command "Light" do
      goal "Light a lamp"
      reference_to Lamp
      emits "Lit"
    end

    command "Flicker" do
      goal "Flicker a lamp, which makes the lamp flicker again"
      reference_to Lamp
      emits "Flickered"
    end

    command "Mark" do
      goal "Mark a flicker as seen"
      reference_to Lamp
      emits "Marked"
    end

    command "Unmark" do
      goal "Take back a mark"
      reference_to Lamp
      emits "Unmarked"
    end

    command "Retire" do
      goal "Retire a lamp"
      reference_to Lamp
      emits "LampRetired"
    end

    policy "FlickerAgain" do
      on      "Flickered"
      trigger Lamp::Flicker
    end
  end

  # One level below the bound (C10.4): a strike sets off four reactions, so Burnt comes at depth
  # four; the Blow it dispatches runs fifth and is refused (a fuse blows only unarmed), so the saga
  # unwinds under the ceiling and its Unprime and Scrap still run.
  aggregate "Fuse" do
    identified_by :name

    attribute :name, Name

    value_object "Name" do
      attribute :value, String
    end

    lifecycle :status, default: "laid" do
      transition "Arm"  => "armed", from: "laid"
      transition "Blow" => "blown", from: "laid"
      mark :rests, "laid"
      mark :terminal, "armed", "blown"
    end

    command "Lay" do
      goal "Lay a fuse"
      attribute :name, Name
      emits "FuseLaid"
    end

    command "Arm" do
      goal "Arm a fuse"
      reference_to Fuse
      emits "Armed"
    end

    command "Prime" do
      goal "Prime an armed fuse"
      reference_to Fuse
      emits "Primed"
    end

    command "Unprime" do
      goal "Take back a priming"
      reference_to Fuse
      emits "Unprimed"
    end

    command "Strike" do
      goal "Strike a fuse, which sparks, hisses, glows and burns"
      reference_to Fuse
      emits "Struck"
    end

    command "Spark" do
      goal "Spark a struck fuse"
      reference_to Fuse
      emits "Sparked"
    end

    command "Hiss" do
      goal "Hiss a sparked fuse"
      reference_to Fuse
      emits "Hissed"
    end

    command "Glow" do
      goal "Glow a hissing fuse"
      reference_to Fuse
      emits "Glowed"
    end

    command "Burn" do
      goal "Burn a glowing fuse"
      reference_to Fuse
      emits "Burnt"
    end

    command "Blow" do
      goal "Blow a fuse that was never armed"
      reference_to Fuse
      emits "Blown"
    end

    command "Scrap" do
      goal "Scrap a fuse that would not blow"
      reference_to Fuse
      emits "Scrapped"
    end

    policy "SparkOnStrike" do
      on      "Struck"
      trigger Fuse::Spark
    end

    policy "HissOnSpark" do
      on      "Sparked"
      trigger Fuse::Hiss
    end

    policy "GlowOnHiss" do
      on      "Hissed"
      trigger Fuse::Glow
    end

    policy "BurnOnGlow" do
      on      "Glowed"
      trigger Fuse::Burn
    end
  end

  saga "Charge" do
    correlates_by :"name.value"
    starts_on "FuseLaid"
    ends_on   "Scrapped"

    transition "Armed" => "armed", from: "laid" do
      dispatch Fuse::Prime, with: { fuse: :name } do
        compensates Fuse::Unprime, with: { fuse: :name }
      end
    end

    transition "Burnt" => "burning", from: "armed" do
      dispatch Fuse::Blow, with: { fuse: :name }
    end

    transition :refused => "fizzled", from: "burning" do
      dispatch Fuse::Scrap, with: { fuse: :name }
    end
  end

  saga "Watch" do
    correlates_by :"name.value"
    starts_on "LampInstalled"
    ends_on   "LampRetired"

    transition "Lit" => "lit", from: "installed" do
      dispatch Lamp::Mark, with: { lamp: :name } do
        compensates Lamp::Unmark, with: { lamp: :name }
      end
    end

    transition "Flickered" => "flickering", from: "lit" do
      dispatch Lamp::Mark, with: { lamp: :name }
    end

    transition :refused => "unwound", from: "flickering" do
      dispatch Lamp::Retire, with: { lamp: :name }
    end
  end
end
