Hecks.bluebook "Tallying" do
  # A CORPUS-OWNED DOMAIN (docs/semantics/bluebook-semantics.md, §3 —
  # C3.3 integers, C3.4 floats, C3.6 strings). The value model's own
  # bounds are only observable at their edges — a sum past ±2^63-1, a
  # float sum past the largest finite double, a string that sorts
  # differently by codepoint than by any locale — and no example domain
  # goes there. This one exists to.
  vision "A tally counts, weighs and labels, and refuses to pretend past the edges of its numbers."
  core

  aggregate "Tally" do
    identified_by :tag

    attribute :tag,    Tag
    attribute :count,  Count,  default: { value: 0 }
    attribute :weight, Weight, default: { value: 0.0 }
    attribute :label,  Label,  default: { value: "" }
    attribute :limit,  Count,  optional: true
    attribute :tags,   list_of(Label)

    value_object "Tag" do
      attribute :value, String
    end

    value_object "Count" do
      attribute :value, Integer
    end

    value_object "Weight" do
      attribute :value, Float
    end

    value_object "Label" do
      attribute :value, String
    end

    command "Open" do
      goal "Start a tally"
      attribute :tag, Tag
      emits "TallyOpened"
    end

    command "SetCount" do
      goal "Put the count somewhere"
      reference_to Tally
      attribute :count, Count
      sets :count
      emits "CountSet"
    end

    # THE RULE READS THE SUM (C3.3): a given that adds two 64-bit
    # integers whose sum does not fit is a FAULT, before any effect.
    command "Bump" do
      goal "Add to the count, but only past zero"
      reference_to Tally
      attribute :by, Count
      given("the sum stays positive") { count.value + by.value > 0 }
      sets :count, increment: :by
      emits "CountBumped"
    end

    # THE EFFECT ADDS (C3.3): no rule reads the sum, so the overflow
    # surfaces in the increment itself.
    command "Add" do
      goal "Add to the count"
      reference_to Tally
      attribute :by, Count
      sets :count, increment: :by
      emits "CountAdded"
    end

    # THE ENSURES READS THE SETTLED STATE (C2.3): `count` is both this
    # command's argument and the tally's field; inside the ensures it
    # names the candidate, so the rule judges the increment, not the
    # argument.
    command "Increase" do
      goal "Add to the count and check the count grew by exactly five"
      reference_to Tally
      attribute :count, Count
      sets :count, increment: :count
      ensures("the count grew by five") { count.value == old.count.value + 5 }
      emits "CountIncreased"
    end

    # THE RULE ADDS FLOATS (C3.4): a sum that is not finite is a FAULT.
    command "Weigh" do
      goal "Add weight, but only while there is some"
      reference_to Tally
      attribute :more, Weight
      given("the total is positive") { weight.value + more.value > 0 }
      sets :weight, increment: :more
      emits "Weighed"
    end

    # NUMERIC COMPARISON IS BY VALUE ACROSS INTEGER AND FLOAT (C3.2):
    # a Float weight of 1.0 satisfies `== 1`.
    command "Certify" do
      goal "Certify a tally that weighs exactly one"
      reference_to Tally
      given("it weighs exactly one") { weight.value == 1 }
      emits "Certified"
    end

    # NIL (C3.5): an absent optional equals only nil; ordering against
    # nil is a fault.
    # `cap`, not `limit` — a given reads arguments first (C2.2), so an
    # argument named `limit` would shadow the field this given asks about.
    command "Cap" do
      goal "Set the cap, once"
      reference_to Tally
      attribute :cap, Count
      given("no cap yet") { limit == nil }
      sets :limit, to: :cap
      emits "Capped"
    end

    command "Check" do
      goal "Confirm the count is under the cap"
      reference_to Tally
      given("the count is under the cap") { count.value < limit.value }
      emits "Checked"
    end

    # APPEND AND REMOVE (C4.3): remove takes every structurally-equal
    # element, append keeps order.
    command "TagWith" do
      goal "Add a tag"
      reference_to Tally
      attribute :label, Label
      sets :tags, append: { value: :label }
      emits "Tagged"
    end

    command "Untag" do
      goal "Remove every tag equal to the one given"
      reference_to Tally
      attribute :label, Label
      sets :tags, remove: :label
      emits "Untagged"
    end

    # STRING ORDER IS CODEPOINT ORDER (C3.6): "é" sorts after "m",
    # "M" sorts before it.
    command "Relabel" do
      goal "Give the tally a label that sorts after m"
      reference_to Tally
      attribute :label, Label
      given("the label sorts after m") { label.value > "m" }
      sets :label
      emits "Relabelled"
    end
  end
end
