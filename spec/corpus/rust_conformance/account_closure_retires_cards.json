{
  "domain": "examples/banking",
  "note": "The orphaned-reference policy ADR 0121 asks banking for: closing an account retires the cards still usable on it. acct-1 holds CARD-1 (issued) and CARD-2 (active); acct-2 holds CARD-3. Closing acct-1 fans RetireCardsOnAccountClosure out over ATMCard.LiveForAccount, whose `number` is lent from the closed account's identity, so CARD-1 and CARD-2 retire and CARD-3 stays issued. NotifyOnClosure is refused for want of the Notifications domain, as everywhere else.",
  "steps": [
    {
      "verb": "Banking::Customer.Register",
      "args": {
        "reference": {
          "value": "CUST-0001"
        },
        "name": {
          "given": "Ada",
          "family": "Lovelace"
        },
        "email": {
          "address": "ada@example.com"
        }
      }
    },
    {
      "verb": "Banking::Account.Open",
      "args": {
        "number": {
          "value": "acct-1"
        },
        "kind": {
          "name": "current"
        },
        "daily_limit": {
          "cents": 50000
        },
        "customer": "CUST-0001"
      }
    },
    {
      "verb": "Banking::Account.Open",
      "args": {
        "number": {
          "value": "acct-2"
        },
        "kind": {
          "name": "current"
        },
        "daily_limit": {
          "cents": 50000
        },
        "customer": "CUST-0001"
      }
    },
    {
      "verb": "Banking::ATMCard.Issue",
      "args": {
        "serial": {
          "value": "CARD-1"
        },
        "daily_fee": {
          "amount": 2.5
        },
        "account": "acct-1"
      }
    },
    {
      "verb": "Banking::ATMCard.Issue",
      "args": {
        "serial": {
          "value": "CARD-2"
        },
        "daily_fee": {
          "amount": 0.75
        },
        "account": "acct-1"
      }
    },
    {
      "verb": "Banking::ATMCard.Activate",
      "args": {
        "serial": {
          "value": "CARD-2"
        }
      }
    },
    {
      "verb": "Banking::ATMCard.Issue",
      "args": {
        "serial": {
          "value": "CARD-3"
        },
        "daily_fee": {
          "amount": 1.5
        },
        "account": "acct-2"
      }
    },
    {
      "verb": "Banking::Account.CloseAccount",
      "args": {
        "number": {
          "value": "acct-1"
        }
      }
    }
  ],
