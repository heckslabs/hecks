Hecks.bluebook "Bank", version: "v1" do
  vision "Two aggregates; one entity reaches a sibling's precondition through a namespaced declared_by."
  core

  aggregate "Account" do
    description "Declares the precondition a sibling aggregate's entity references back."

    identified_by :ref
    attribute :ref, AccountRef

    value_object "AccountRef" do
      attribute :value, String
    end

    entity "LedgerEntry" do
      description "The FIRST declaration, a plain given."

      attribute :sequence, Sequence
      identified_by :sequence

      given("customer is active") { true }
    end

    value_object "Sequence" do
      attribute :value, String
    end

    command "Open" do
      role "Clerk"
      goal "Open an account"

      attribute :ref, AccountRef

      emits "AccountOpened"
    end
  end

  aggregate "Box" do
    description "References the sibling precondition by a namespaced owner name."

    identified_by :ref
    attribute :ref, BoxRef

    value_object "BoxRef" do
      attribute :value, String
    end

    entity "Visit" do
      description "The SECOND declaration, a bare reference disambiguated with declared_by."

      attribute :note, Note
      identified_by :note

      given("customer is active", declared_by: "Bank::Account.LedgerEntry")
    end

    value_object "Note" do
      attribute :value, String
    end

    command "Log" do
      role "Clerk"
      goal "Log a visit"

      attribute :note, Note

      emits "VisitLogged"
    end
  end
end
