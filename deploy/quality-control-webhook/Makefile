		cd /Users/christopheryoung/Projects/hecks/.claude/worktrees/agent-a7ac753ca2c223e76 && bin/rust_conformance qa spec/corpus/qa.json $(WASM); \
	else \
		echo "verify-parity-QualityControlWebhookFunction: no spec/corpus/qa.json -- SKIPPING the pre-deploy Ruby/Rust parity check, nothing to compare $(WASM) against. Write one (bin/fuzz/bin/run's own script shape) before this domain's next deploy."; \
	fi
	@echo "verify-parity-QualityControlWebhookFunction: fuzzing $(WASM) against generated sequences (ADR 0037's bridge, WARN-ONLY -- see this target's own comment)..."
