build-LifeadelicsFunction:
	@command -v cargo-lambda >/dev/null 2>&1 || { \
		echo "cargo-lambda isn't installed. Install it once with: pip3 install cargo-lambda"; \
		exit 1; \
	}
# ALWAYS rebuilt, never `test -f $(WASM) || ...` — that guard only
# checked EXISTENCE, not staleness, so a wasm built once at the
# start of a work session silently kept getting deployed through
# every later kernel change (a real, live bug: this cost a stale
# deploy against a wasm that predated the kernel's own "mutations"
# field). `bin/project_wasm` recompiles fast enough that "always
# rebuild" is the safe default, matching rust/host's own bootstrap
# build just below, which was never guarded this way to begin with.
	cd /Users/christopheryoung/Projects/hecksagain && bin/project_wasm /Users/christopheryoung/.claude/jobs/ab113a84/tmp/lifeadelics
	@rustup target list --installed 2>/dev/null | grep -qx aarch64-unknown-linux-gnu || rustup target add aarch64-unknown-linux-gnu
# `rustup run stable`, not a bare `cargo lambda` — same reasoning
# bin/project_wasm's own Makefile-equivalent line holds itself to: a
# `cargo`/`rustc` earlier on PATH than rustup's own shims (Homebrew
# installs one; common on this kind of machine) is a DIFFERENT
# toolchain that never saw `rustup target add`, and fails with
# "can't find crate for `core`" for the cross target even though
# `rustup target list --installed` reports it present.
	cd $(HOST_DIR) && rustup run stable cargo lambda build --release --arm64
	cp $(HOST_DIR)/target/lambda/bootstrap/bootstrap $(ARTIFACTS_DIR)/bootstrap
	cp $(WASM) $(ARTIFACTS_DIR)/lifeadelics.wasm
	cp /Users/christopheryoung/Projects/hecksagain/rust/dist/lifeadelics.ir.json $(ARTIFACTS_DIR)/lifeadelics.ir.json

# `sam build <resource>` WIPES .aws-sam/build/ entirely before
# building just the one resource named -- confirmed live: building
# WebFunction second left NO LifeadelicsFunction/ directory behind at
# all, and reverted its OWN built CodeUri back to the raw, unbuilt
# source value ("../.." -- CodeUri: . resolved two directories up
# from .aws-sam/build/template.yaml). `sam deploy` then zips THAT
# directory verbatim as LifeadelicsFunction's own code -- a real, live
# deploy shipped WebFunction's own source tree (Gemfile,
# lambda_handler.rb, even .env.local) as LifeadelicsFunction's Lambda
# package this way, caught by downloading the actually-deployed
# code and finding WebFunction's file tree inside it.
# `deploy:`'s own two separate `sam build <resource>` calls can
# never both survive in .aws-sam/build/ at once — this target
# re-populates LifeadelicsFunction's build directory from the SAME
# already-built bootstrap+wasm build-LifeadelicsFunction just produced
# (untouched by the second sam build call — only .aws-sam/build/
# itself gets wiped, never $(HOST_DIR)/target or $(WASM)) and
# repoints the built template's CodeUri back at it.
.PHONY: restore-LifeadelicsFunction-build
restore-LifeadelicsFunction-build:
	@mkdir -p .aws-sam/build/LifeadelicsFunction
	cp $(HOST_DIR)/target/lambda/bootstrap/bootstrap .aws-sam/build/LifeadelicsFunction/bootstrap
	cp $(WASM) .aws-sam/build/LifeadelicsFunction/lifeadelics.wasm
	cp /Users/christopheryoung/Projects/hecksagain/rust/dist/lifeadelics.ir.json .aws-sam/build/LifeadelicsFunction/lifeadelics.ir.json
	ruby -e 'lines = File.readlines(".aws-sam/build/template.yaml"); start = lines.index { |l| l.strip == "LifeadelicsFunction:" } or raise "restore-LifeadelicsFunction-build: LifeadelicsFunction resource not found in built template"; idx = (start+1...lines.length).find { |i| lines[i] =~ /CodeUri:/ } or raise "restore-LifeadelicsFunction-build: no CodeUri line found under LifeadelicsFunction"; lines[idx] = lines[idx].sub(/CodeUri:.*/, "CodeUri: LifeadelicsFunction"); File.write(".aws-sam/build/template.yaml", lines.join)'

# `make mint-era` — takes hecksagain-lifeadelics's RDS instance from freshly
# created to "era 1 minted, ready for HECKS_DOMAIN/HECKS_ERA to
# resolve" (template.yaml's own env vars already assume era 1 —
# this is what makes that true). Run ONCE per fresh database, before
# the first real `sam deploy` of the Lambda itself; safe to re-run
# (a second boot against an already-held era 1 is a no-op — see
# era_resolver.rb's own quiet-reboot branch). Stands up bastion.yaml
# as its own sibling stack, uses it for one Ruby boot over an SSM
# tunnel, then deletes it — nothing from this target is left running
# afterward.
