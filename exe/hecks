#!/usr/bin/env -S ruby --disable-gems

# Hecks's command line — GENERATED by hecks project_cli. Do not edit.
#
# A launcher, not a CLI: the commands, their arguments and their refusals are
# projected from the bluebook beside it every time this runs, so a change
# to the bluebook shows up here without re-minting anything.
#
#   exe/hecks                  every command, and every question
#   exe/hecks <command> --help    what it wants, and how it refuses

# When this launcher began, so the usage record can say how long it took to reach the command.
HECKS_LAUNCHED_AT = Process.clock_gettime(Process::CLOCK_MONOTONIC)
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

# A resident for this checkout, when one stands, runs this line and ends it (ADR 0201).
require "hecks/adapters/driving/resident/client"
Hecks::Adapters::Driving::Resident::Client.run(__FILE__)

# Past the probe this boot is cold, and it needs the gems the shebang left unloaded.
require "rubygems" unless defined?(Gem)

# In a hecks checkout this runs on the gems the Gemfile pins, as `bundle exec` and CI do.
# Beside an installed gem, or where that set is not installed, it runs on the gems at hand.
gemfile = File.expand_path("../Gemfile", __dir__)
if File.exist?(File.expand_path("../hecks.gemspec", __dir__)) && File.exist?(gemfile)
  ENV["BUNDLE_GEMFILE"] ||= gemfile
  begin
    require "bundler/setup"
  rescue LoadError, StandardError
    nil
  end
end

# The Ruby this boot compiles and the load path it searches are kept between boots.
begin
  unless defined?(Bootsnap)
    require "bootsnap"
    require "hecks/cache_dir"
    if Hecks::CacheDir.stable?
      Bootsnap.setup(cache_dir: Hecks::CacheDir.path("bootsnap"), development_mode: true,
                     load_path_cache: true, compile_cache_iseq: true, compile_cache_yaml: false)
    end
  end
rescue ScriptError, StandardError
  nil
end

# These commands keep nothing worth a database, so they run on Memory unless told otherwise.
# A person is at them: they wait for their result, say why when they are refused, and print
# no record when they end well.
MEMORY_COMMANDS = %w[console init interview].freeze
ENV["HECKS_ENVIRONMENT"] ||= "memory" if MEMORY_COMMANDS.include?(ARGV.first.to_s.chomp("!"))
ARGV << "--wait" if MEMORY_COMMANDS.include?(ARGV.first.to_s.chomp("!")) && !ARGV.include?("--wait")

# A command a ledger answers boots that ledger's directory, not this domain's.
ledger = { "quality_control" => "qa/bluebook" }.fetch(ARGV.first, nil)
ARGV.shift if ledger

require "hecks"
# Every secret a world hands an adapter is masked in whatever this process prints.
Hecks::Secrets.guard!

# Usage is answered from the projected bluebook alone: no adapter is bound and no
# database is opened. Only a line that runs a command boots the domain,
# and it boots from what the usage check already loaded.
domain = File.expand_path(ledger ? "../#{ledger}" : "../lib/hecks/hecks", __dir__)
program = "hecks"
described = begin
  Hecks.describe(domain)
rescue StandardError => e
  abort "cannot open Hecks: #{e.message.strip}"
end

# `hecks usage` reads the local record of what this launcher ran; it boots nothing.
if ARGV.first == "usage"
  known = Hecks::Adapters::Driving::CliRunner.known_names(runtime: described, program: program)
  puts Hecks::Adapters::Driving::UsageLog.summary(known: known)
  exit 0
end

text, status, reason = Hecks::Adapters::Driving::CliRunner.usage(
  runtime: described, argv: ARGV, program: program
)
unless text
  # A question the world lists under `reads_tap` is answered on a boot that writes nothing.
  read_only = Hecks::Adapters::Driving::ReadOnlyQuestion.for_line?(described, ARGV, "Hecks")
  runtime = begin
    Hecks::Adapters::Driving::LauncherOptions.quietly(hold: MEMORY_COMMANDS.include?(ARGV.first.to_s.chomp("!"))) do
      Hecks.boot_described(described, install_driving: false, read_only: read_only)
    end
  rescue StandardError => e
    abort "cannot open Hecks: #{e.message.strip}"
  end
  # A question the world lists under `streams`, given `--stream`, tails until interrupted.
  streamed = Hecks::Adapters::Driving::CliRunner.stream(runtime: runtime, argv: ARGV, program: program)
  exit streamed unless streamed.nil?
  text, status, reason = Hecks::Adapters::Driving::CliRunner.call(
    runtime: runtime, argv: ARGV, program: program, usage_log: true
  )
end
# A `--wait` run that failed answers its settled record on stdout, so `| jq` reads it
# either way, and says why on stderr.
if reason
  if MEMORY_COMMANDS.include?(ARGV.first.to_s.chomp("!"))
    why = begin
      require "json"
      JSON.parse(text).dig("state", "refusal")
    rescue JSON::ParserError
      nil
    end
    warn(why ? Hecks::BootNotices.cause(why.sub(/\A(\w+::)+\w+: /, "")) : reason)
  else
    puts text
    warn reason
  end
  exit status
end
exit 0 if status.zero? && MEMORY_COMMANDS.include?(ARGV.first.to_s.chomp("!"))
status.zero? ? puts(text) : warn(text)
exit status
