#!/usr/bin/env ruby

# The `hecks` command the gem installs: run, read, check and serve a domain.
# Routes to `Hecks::CLI` (lib/hecks/cli.rb); run with no arguments to list subcommands.

# The gem's own `lib` goes first, as for every `bin/` script, so this also
# runs straight from a checkout.
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli"

exit Hecks::CLI.start(ARGV)
