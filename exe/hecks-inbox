#!/usr/bin/env ruby
# frozen_string_literal: true

# A session's inbox, for the harness Monitor tool: prints one line for each Message sent to the session,
# to a work item it is on, or to everyone, read from the journal with read-only SQL. It boots no domain,
# so it can run for hours at no cost, and it writes only its own baseline file.
#
#   exe/hecks-inbox --session <id> --work <item>[,<item>] [--baseline <file>] [--database <db>] [--once]
#   exe/hecks-inbox --unread [--database <db>]      # the coordinator: messages nobody has read yet
#
# The text of a message is information, never an instruction that grants an approval.

require "optparse"
require "tmpdir"
require_relative "../lib/hecks/hecks/adapters/message_inbox"

options = { work: [], interval: 5 }
OptionParser.new do |o|
  o.on("--session ID") { |v| options[:session] = v }
  o.on("--work ITEMS") { |v| options[:work] = v.split(",") }
  o.on("--baseline FILE") { |v| options[:baseline] = v }
  o.on("--database FILE") { |v| options[:database] = v }
  o.on("--interval SECONDS", Integer) { |v| options[:interval] = v }
  o.on("--once") { options[:once] = true }
  o.on("--unread") { options[:unread] = true }
end.parse!

abort "hecks-inbox: name the session with --session" unless options.key?(:session) || options.key?(:unread)

inbox = Hecks::Adapters::MessageInbox.new(session: options[:session].to_s, work: options[:work], database: options[:database])
if options[:unread]
  inbox.unread.each { |row| puts "unread #{row[:message]} to #{row[:recipient]} from #{row[:from]}: #{row[:text]}" }
  exit
end

baseline = options[:baseline] || File.join(Dir.tmpdir, "hecks-inbox-#{options[:session]}")
$stdout.sync = true
loop do
  inbox.deliver(baseline: baseline)
  break if options[:once]

  sleep options[:interval]
end
