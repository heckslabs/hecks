Hecks.behaviors "Banking" do
  vision "The account rules the app's request specs lean on, held by the domain itself."

  test "FreezeAccount stops an open account moving" do
    tests "FreezeAccount", on: "Account"
    setup "Register", reference: { value: "c1" }, name: { given: "Ada", family: "Clerk" },
                      email: { address: "ada@example.com" }
    setup "Open", customer: "c1", number: { value: "a1" }, kind: { name: "current" }, daily_limit: { cents: 1000 }
    input number: { value: "a1" }
    expect status: "frozen"
  end

  test "FreezeAccount refuses an account that is already frozen" do
    tests "FreezeAccount", on: "Account"
    setup "Register", reference: { value: "c1" }, name: { given: "Ada", family: "Clerk" },
                      email: { address: "ada@example.com" }
    setup "Open", customer: "c1", number: { value: "a1" }, kind: { name: "current" }, daily_limit: { cents: 1000 }
    setup "FreezeAccount", number: { value: "a1" }
    input number: { value: "a1" }
    expect refused: "FreezeAccount moves it only from \"open\""
  end
end
