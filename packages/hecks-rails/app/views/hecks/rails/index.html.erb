<% model = hecks_model %>
<% columns = hecks_columns(model) %>
<% records = @records || model.all %>
<h1><%= hecks_label(model) %></h1>
<% if model.door.ir.description.present? %><p class="goal"><%= model.door.ir.description %></p><% end %>
<%= render "hecks/rails/refusals", record: @record %>

<% hecks_creators(model).each do |command| %>
  <%= render "hecks/rails/command", command: command, subject: model, url: url_for(action: hecks_verb(command), only_path: true) %>
<% end %>

<h2><%= records.size %> <%= records.size == 1 ? "record" : "records" %></h2>
<% if records.empty? %>
  <p><em>None yet.</em></p>
<% else %>
  <div class="table-scroll"><table>
    <thead><tr><% columns.each do |column| %><th><%= hecks_heading(column) %></th><% end %></tr></thead>
    <tbody>
      <% records.each do |record| %>
        <tr>
          <% columns.each_with_index do |column, index| %>
            <td><%= index.zero? ? link_to(hecks_cell(record, column), url_for(action: "show", id: record.to_param, only_path: true)) : hecks_cell(record, column) %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table></div>
<% end %>
