# Read by `op run --env-file` (see bin/release and Hecks::Release::Runner).
# This holds op:// REFERENCES, not secrets — safe to commit. `op run` resolves
# each one at run time (unlocked by Touch ID) and injects it into `npm publish`'s
# one subprocess only. npm expands ${NODE_AUTH_TOKEN} in a throwaway user config,
# so the token is never written to disk.
#
# The token is the concealed field "publish token" on the npm login item
# "npmmjs" in the Hecks vault. Edit the vault, item or field here if
# yours differ.
NODE_AUTH_TOKEN="op://Hecks/npmmjs/publish token"

# For an npm account that requires a one-time code on publish (a token that does
# not bypass two-factor authentication), uncomment this. It is only valid when
# the login item holds an authenticator secret; `op run` then reads a fresh code
# from it for the publish, and npm sends it as the one-time password.
# NPM_CONFIG_OTP="op://Hecks/npmmjs/one-time password?attribute=otp"
