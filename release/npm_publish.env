# Read by `op run --env-file` (see bin/release and Hecks::Release::Runner).
# This holds an op:// REFERENCE, not a secret — safe to commit. `op run` resolves
# it at run time (unlocked by Touch ID) and injects it into `npm publish`'s one
# subprocess only. npm expands ${NODE_AUTH_TOKEN} in a throwaway user config, so
# the token is never written to disk.
#
# The token is the concealed field "publish token" on the npm login item
# "npmmjs" in the Hecks vault. Edit the vault, item or field here if yours
# differ.
#
# npm's second factor is a security key or passkey approved in the browser, so
# the publish step is interactive: npm prints an approval link and waits. Fully
# unattended publishing needs npm trusted publishing from CI, which is not set
# up yet.
NODE_AUTH_TOKEN="op://Hecks/npmmjs/publish token"
