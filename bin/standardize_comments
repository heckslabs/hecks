#!/usr/bin/env ruby

# Checks Ruby comments against docs/COMMENT_STYLE_GUIDE.md, and fixes the
# mechanical categories.
#
#   bin/standardize_comments --report lib/hecks   # summary tables (default)
#   bin/standardize_comments --check  lib/hecks   # exit 1 on any violation
#   bin/standardize_comments --fix    lib/hecks   # rewrite mechanical categories
#
# A fix is written only when it leaves the file's non-comment tokens unchanged.
# CI runs `--check lib/hecks` as a gate (.github/workflows/ci-checks.yml).

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("standardize_comments")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/tools"

Hecks::Tools.script("standardize_comments", ARGV)
