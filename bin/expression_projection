#!/usr/bin/env ruby

# Projects the expression operator tables into lib/hecks/bluebook/expression/projection.json.
# The body lives in lib/hecks/cli/expression_projection.rb; this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("expression_projection")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/expression_projection"

exit(Hecks::CLI::ExpressionProjection.call(ARGV))
