#!/usr/bin/env ruby

# Projects the expression machinery's operator and normalisation tables from the grammar
# chapter into lib/hecks/bluebook/expression/projection.json.
#
#   bin/expression_projection            # rewrites the file in place
#   bin/expression_projection --stdout   # prints instead (the spec's diff mode)
#
# Never redirect with `>`: the shell truncates the file the framework requires at boot, so
# the run dies with nothing written. The default mode replaces the file atomically.
#
# Refuses to write a projection that drops a self-bearing operator, one the chapter's own
# `status != "retired"` givens evaluate through, since that would wedge every later boot.
# Recover a broken file with `git checkout -- lib/hecks/bluebook/expression/projection.json`.

require "json"
require "tempfile"

TARGET = File.expand_path("../lib/hecks/bluebook/expression/projection.json", __dir__)

# Replaces `TARGET` via a same-directory tempfile and rename, so readers never see a partial file.
#
# @return [void]
def write_atomically(content)
  Tempfile.create("projection", File.dirname(TARGET)) do |tmp|
    tmp.write(content)
    tmp.flush
    File.rename(tmp.path, TARGET)
  end
end

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks"
require "hecks/grammar"

dispatcher = Hecks::Grammar.expression

judged     = Hecks::Bluebook::MetaValidator.grammar_registry.bluebook("Bluebook")
vocabulary = judged.aggregates.find { |a| a.name == "Vocabulary" }
algebra    = vocabulary.value_objects.find { |vo| vo.hecks_name == "Comparison" }
                       .members.to_h { |row| [row.to_h.values.first, row.to_h] }

operators = Hecks::Grammar.admitted_operators(dispatcher).map do |op|
  row = { symbol: op[:symbol], category: op[:category],
          precedence: op[:precedence], arity: op[:arity] }
  next row unless op[:category] == "comparison"

  declared = algebra.fetch(op[:symbol]) do
    abort "#{op[:symbol]} is admitted but Vocabulary::Comparison declares no algebra for it"
  end
  row.merge(compares_less_than: declared[:compares_less_than],
            compares_equal: declared[:compares_equal], negated: declared[:negated])
end

# Refuse to write a projection that would wedge every future boot; name each dropped operator.
admitted = operators.map { |row| row[:symbol] }
stranded = Hecks::Grammar.self_bearing_operators.except(*admitted)
unless stranded.empty?
  abort stranded.map { |symbol, sites|
    "#{symbol} is self-bearing — the language's own predicates evaluate through it " \
      "(#{sites.first(3).join('; ')}) — rewrite those guards before retiring it"
  }.join("\n")
end

content = "#{JSON.pretty_generate(
  operators:      operators,
  normalisations: Hecks::Grammar.admitted_normalisations(dispatcher)
)}\n"

if ARGV.include?("--stdout")
  print content
else
  write_atomically(content)
  puts "wrote #{TARGET}"
end
