#!/usr/bin/env ruby

# Projects the model's holding half from the language that declares it.
# Behaviour::X is hand-written and untouched; `settle` is the seam.
#
#   bin/project_model

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_model")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"

chapter = Hecks::Bluebook::MetaValidator.grammar_registry.bluebook("Bluebook")
out     = File.expand_path("../lib/hecks/bluebook", __dir__)

written = Hecks::Projector.write(
  Hecks::Projector.call(:model, bluebook: chapter), out, as: :files
)
written.each { |path| puts "wrote #{path}" }
