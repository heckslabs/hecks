#!/usr/bin/env ruby

# Fails when a query engine re-grows its own comparator dispatch.
# The body lives in lib/hecks/cli/check_engine_agreement.rb; this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("check_engine_agreement")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/check_engine_agreement"

exit(Hecks::CLI::CheckEngineAgreement.call(root: ENV["HECKS_CHECK_ENGINE_AGREEMENT_ROOT"] || File.expand_path("..", __dir__)))
