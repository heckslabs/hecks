#!/usr/bin/env ruby

# Refuses unless every live word in docs/implemented/reference/ has prose and a running example.
# Checks that an example exists; spec/reference_doctest_spec.rb checks that it passes.
# `ruby skip` fences and hidden `<!-- doctest:boot -->` blocks do not count as examples.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks"
require "hecks/doc/reference"

directory = File.join(File.expand_path("..", __dir__), "docs/implemented/reference")

undocumented  = Hecks::Doc::Reference.undocumented(directory)
unexemplified = Hecks::Doc::Reference.unexemplified(directory)

# Prints one gap section; a word missing both kinds is listed twice, one repair each.
#
# @return [Boolean] true if `words` was empty and nothing was printed
def report(words, owed)
  return true if words.empty?

  puts "#{words.size} live #{words.size == 1 ? 'word carries' : 'words carry'} #{owed}:"
  words.each { |word| puts "  #{word}" }
  puts
  false
end

clean = [
  report(undocumented, "no prose — write their sections"),
  report(unexemplified, "no running example — write one in each word's own section")
].all?

if clean
  puts "every live word carries prose and a running example."
  exit 0
end

warn "docs/implemented/reference/ is behind the language. Regenerate with bin/reference to see the words in place."
exit 1
