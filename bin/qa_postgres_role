#!/usr/bin/env ruby

# Creates the ordinary Postgres role the QA ledger connects as.
# The body lives in lib/hecks/quality_control/cli/qa_postgres_role.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_postgres_role")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/quality_control/cli/qa_postgres_role"

exit(Hecks::QualityControlCli::QaPostgresRole.call(ARGV))
