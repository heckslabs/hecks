#!/usr/bin/env ruby

# Reruns the thread-safety specs under many seeds, several OS processes at a time.
# The body lives in lib/hecks/cli/stress_concurrency_specs.rb; this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("stress_concurrency_specs")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/stress_concurrency_specs"

exit(Hecks::CLI::StressConcurrencySpecs.call(ARGV, root: File.expand_path("..", __dir__)))
