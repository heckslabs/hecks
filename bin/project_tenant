#!/usr/bin/env ruby

# THE TENANT PROVISIONER — same split bin/project_deploy already draws
# between VALIDATING a declared shape (lib/hecks/deploy's own
# Tenant.Declare) and ACTING on it. The acting half now lives behind a
# real driven port (Deploy::Tenant.port "TenantProvisioning") instead
# of inline script code — `TenantProvisioner` (lib/hecks/adapters/
# driven/tenant_provisioner.rb) does the file-write/boot/gate work
# this script used to do by hand, and this script's own job shrinks to
# "declare, provision, confirm" — three dispatch calls, no direct file
# IO or booting of its own.
#
# `Deploy` and `Tenancy` are booted TOGETHER, into one shared registry
# (Hecks.boot_files, not two separate `Hecks.boot` calls) — the
# `translates` reaction in tenancy.hecksagon (on Tenant::
# TenantProvisioned, trigger Tenant::Register) can only see across
# domains loaded into the SAME registry; PolicyInterpreter scans every
# bluebook the registry holds, not just the emitting one, but two
# separate registries share nothing.
#
# THE OVERLAY REPLACES, NOT MERGES, THE BASE persisted_by SETTINGS FOR
# THE SAME ADAPTER — Registry#merge_worlds' own documented shallow-merge
# shape. So `--database` is REQUIRED here even when the base `.world`
# already names one.
#
# A REFUSED REACTION IS NEVER RAISED — PolicyInterpreter#deliver
# deliberately swallows a policy-triggered command's own refusal (it
# would blow up the ORIGINAL caller's dispatch for a failure in a
# DIFFERENT command it never asked to run). So this script confirms
# the record actually landed by querying for it afterward, rather than
# trusting that no exception means success.
#
#   bin/project_tenant <domain-directory> <slug> --domain=NAME --realm=NAME \
#     --schema=NAME --database=NAME [--adapter=PostgresEra]

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks"
# ADR 0033 — provisioning a tenant against `PostgresEra` (this script's
# own documented `--adapter=PostgresEra` option) needs the era
# persistence plugin loaded; core no longer carries it unconditionally.
require "hecks/ports/persistence/plugins/era"
require "optparse"

directory = ARGV.shift
slug      = ARGV.shift
(directory && slug) or abort "usage: bin/project_tenant <domain-directory> <slug> --domain=NAME --realm=NAME " \
                             "--schema=NAME --database=NAME [--adapter=PostgresEra]"

options = { adapter: "PostgresEra" }
OptionParser.new do |parser|
  parser.on("--domain=NAME")   { |v| options[:domain] = v }
  parser.on("--realm=NAME")    { |v| options[:realm] = v }
  parser.on("--schema=NAME")   { |v| options[:schema] = v }
  parser.on("--database=NAME") { |v| options[:database] = v }
  parser.on("--adapter=NAME")  { |v| options[:adapter] = v }
end.parse!(ARGV)

%i[domain realm schema database].each do |flag|
  options[flag] or abort "bin/project_tenant needs --#{flag}"
end

domain_directory = File.expand_path(directory)
File.directory?(domain_directory) or abort "no such domain directory: #{domain_directory}"

lib_hecks  = File.expand_path("../lib/hecks", __dir__)
dispatcher = Hecks.boot_files(
  [
    File.join(lib_hecks, "deploy/bluebook/deploy.bluebook"),
    File.join(lib_hecks, "deploy/bluebook/deploy.hecksagon"),
    File.join(lib_hecks, "tenancy/bluebook/tenancy.bluebook"),
    File.join(lib_hecks, "tenancy/bluebook/tenancy.hecksagon")
  ],
  install_facade: false
)

# VALIDATED, not hand-checked — the same given/invariant machinery
# LambdaTarget's own validation already is, before anything is
# provisioned.
begin
  dispatcher.dispatch(
    "Deploy::Tenant.Declare",
    to:   slug,
    with: {
      slug:   { value: slug },
      domain: { value: options[:domain] },
      realm:  { value: options[:realm] },
      schema: { value: options[:schema] }
    }
  )
rescue *Hecks::Runtime::DOMAIN_REFUSALS => e
  abort "tenant #{slug.inspect} is invalid: #{e.message}"
end

# THE ADAPTER RUNS HERE — writes the overlay, boots the target domain
# for real (also provisioning the schema, PostgresEra#connect_for's
# own idempotent `CREATE SCHEMA IF NOT EXISTS`), and runs the
# tenant_capable? gate. Answers TenantProvisioned or refuses
# ProvisioningRefused; either way this call itself never raises.
reactions = dispatcher.dispatch_port(
  "Deploy", "Tenant", "TenantProvisioning", "Provision",
  to:   slug,
  with: { database: { value: options[:database] }, adapter: { value: options[:adapter] } }
)

if reactions.map(&:name).include?("ProvisioningRefused")
  refusal = reactions.find { |event| event.name == "ProvisioningRefused" }
  abort "provisioning #{slug.inspect} was refused: #{refusal.payload[:refusal]}"
end

puts "provisioned #{options[:domain]} for tenant #{slug.inspect} under realm #{options[:realm].inspect}"

# CONFIRMED BY QUERY, NOT BY ABSENCE OF AN EXCEPTION — see this
# script's own header on why a policy's own refusal never raises.
tenant = dispatcher.registry.repository("Tenancy", dispatcher.registry.bluebook("Tenancy").aggregate("Tenant"))
                   .find(slug)
tenant or abort "provisioning succeeded but #{slug.inspect} was never registered in Tenancy — " \
                "check registry.reaction_log for a silently refused Register"

puts "#{options[:domain]} is tenant_capable? for #{slug.inspect} — registered under realm #{options[:realm].inspect}"
