#!/usr/bin/env ruby

# Vendors one package of the bluebook registry into a consuming project,
# pinned to a release or a commit.
#
#   bin/vendor_bluebook payments@1.2.0 --from ../embryonaut_bluebooks
#   bin/vendor_bluebook payments                  # the newest payments-v* release
#   bin/vendor_bluebook payments@9f2c1ab          # a bare commit: marker only, no lock
#
# `--from` defaults to $EMBRYONAUT_BLUEBOOKS_SRC, `--root` to the current
# directory. Files land in vendor/embryonaut_bluebooks/<package>/bluebook/.

require_relative "../lib/hecks"
require_relative "../lib/hecks/embryonaut_bluebook/vendor_cli"

exit Hecks::EmbryonautBluebook::VendorCli.run(ARGV)
