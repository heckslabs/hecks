#!/usr/bin/env ruby

# Projects the Vocabulary tables into rust/src/kernel/vocab/*.rs, one enum per table.
# Deletes any file under vocab/ that the projection does not emit.
#
#   bin/project_rust_vocabulary

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "fileutils"
require "tempfile"

KERNEL = File.expand_path("../rust/src/kernel", __dir__)

# Temp file plus rename, so a reader never sees a partial file if the process is killed.
def write_atomically(target, content)
  FileUtils.mkdir_p(File.dirname(target))
  Tempfile.create(File.basename(target), File.dirname(target)) do |tmp|
    tmp.write(content)
    tmp.flush
    File.rename(tmp.path, target)
  end
  puts "wrote #{target}"
end

chapter = Hecks::Bluebook::MetaValidator.grammar_registry.bluebook("Bluebook")
files   = Hecks::Projector.call(:rust_vocabulary, bluebook: chapter)

files.each { |relative, content| write_atomically(File.join(KERNEL, relative), content) }

emitted = files.keys.map { |relative| File.join(KERNEL, relative) }
(Dir.glob(File.join(KERNEL, "vocab", "*.rs")) - emitted).each do |stale|
  File.delete(stale)
  puts "removed #{stale}"
end
