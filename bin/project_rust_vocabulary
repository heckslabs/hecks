#!/usr/bin/env ruby

# Projects the Vocabulary tables into rust/src/kernel/vocab/*.rs, one enum per table.
# Deletes any file under vocab/ that the projection does not emit.
#
#   bin/project_rust_vocabulary

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_rust_vocabulary")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/projection_files"

Hecks::ProjectionFiles.run(:rust_vocabulary)
