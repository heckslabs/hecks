#!/usr/bin/env ruby

# Compacts a Heki-backed aggregate's journal to empty; the snapshot keeps the current state.
# Refuses any aggregate a `projected_by` binding reads, since projections replay the full journal.
#
#   bin/heki_compact <domain> [aggregate_name ...]           # dry run
#   bin/heki_compact <domain> [aggregate_name ...] --force   # apply

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("heki_compact")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/tools"

Hecks::Tools.script("heki_compact", ARGV)
