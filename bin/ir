#!/usr/bin/env ruby

# Prints a booted domain's IR as JSON — the same `to_h` golden specs
# and StorageShape pin into an era.
#
#   bin/ir <domain> [--translations]
#   bin/ir --meta                     the self-hosted language's own IR

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("ir")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/ir"

Hecks::CLI::Ir.call(ARGV, program: "bin/ir", default_domain: File.expand_path("../examples/pizzas", __dir__))
