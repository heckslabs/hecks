#!/usr/bin/env ruby

# Prints a booted domain's IR as JSON — the same `to_h` the golden
# specs pin and StorageShape hashes into an era, for reading rather
# than asserting on.
#
#   bin/ir <domain> [--translations]
#   bin/ir --meta                     the self-hosted language's own IR

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
# ADR 0033 — a domain wired to PostgresEra needs this plugin loaded
# explicitly; the era/lineage subsystem no longer loads with core.
require "hecks/ports/persistence/plugins/era"

if ARGV.delete("--meta")
  # The language's own IR — Bluebook, Aggregate, Command, ValueObject,
  # Query, Entity, Member, Policy, ProcessManager, Handler, Dispatch,
  # Vocabulary, Syntax, ReadModel, declared across
  # lib/hecks/language/bluebook/*.bluebook and merged into one
  # chapter. This is the only thing in this repository that exercises
  # the full breadth of what the language itself allows — composite
  # identity with a component that isn't even a declared attribute,
  # multi-field closed sets, cross-type `then_set` coercion — none of
  # which either example domain needs. Reused via `MetaValidator.
  # grammar_registry`, the real boot sequence, rather than re-derived,
  # so this can never silently drift from what MetaValidator itself
  # actually loads.
  require "hecks/bluebook/meta_validator"
  puts Hecks::Projector::Exporter.json(Hecks::Bluebook::MetaValidator.grammar_registry)
  exit
end

translations_only = ARGV.delete("--translations")
domain  = ARGV.shift || File.expand_path("../examples/pizzas", __dir__)
runtime = Hecks.boot(domain)

if translations_only
  puts Hecks::Projector::Exporter.translations_json(runtime.registry)
else
  puts Hecks::Projector::Exporter.json(runtime.registry)
end
