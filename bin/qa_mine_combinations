#!/usr/bin/env ruby

# Asks an agent to mine the adversarial corpus for new domain combinations, then checks them.
# The body lives in lib/hecks/quality_control/cli/qa_mine_combinations.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_mine_combinations")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/quality_control/cli/qa_mine_combinations"

exit(Hecks::QualityControlCli::QaMineCombinations.call(ARGV, root: File.expand_path("..", __dir__)))
