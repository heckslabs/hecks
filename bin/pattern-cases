#!/usr/bin/env ruby
require "json"

# The recorded fixture for `pattern:`, and how to regenerate it :
#
#   bin/pattern-cases > spec/corpus/fixtures/patterns.json
#
# spec/pattern_subset_spec.rb reads this fixture and does not generate it —
# a regression contract for Ruby's own pattern matching, recorded once here
# rather than computed inline in the spec. This script exists to author a
# new case: Ruby computes the expected answer, and the fixture holds it.
#
# Every pattern here is one the subset admits — validate_pattern_subset
# answers whether a pattern can be parsed at all; this fixture pins what it
# matches, case by case, so a change in Ruby's own Regexp behavior across
# versions shows up as a spec failure rather than silently.
#
# The inputs were originally chosen to hit places Ruby's Onigmo and a
# differently-implemented regex engine are documented to differ: embedded
# newlines (line anchors vs text anchors), a trailing newline (Ruby's $
# matches before it), and non-ASCII digits and word characters — kept as
# real edge cases worth pinning even with one engine now.
CASES = [
  ["^[A-Z]{3}-[0-9]{4}$", ["ABC-1234", "abc-1234", "xx\nABC-1234\nyy", "ABC-1234\n", "ABC-١٢٣٤"]],
  ["^[0-9]{5}(-[0-9]{4})?$",                     ["12345", "12345-6789", "1234", "12345\nx", "١٢٣٤٥"]],
  ['^[^@ ]+@[^@ ]+\.[^@ ]+$',                    ["a@b.co", "a b@c.co", "no-at-sign", "a@b.co\nevil", "\na@b.co", "café@x.co"]],
  ["^(red|green|blue)$",                         ["red", "purple", "red\ngreen", "RED", "x\nred"]],
  ["^[A-Za-z0-9_]+$",                            ["abc_1", "a b", "café", "abc\ndef"]],
  ['^[ \t]*$',                                   ["", "   ", " ", "a", "\n", "\t"]],
  ["^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$", ["12345678-1234-1234-1234-123456789abc", "nope"]],
  ['^\+?[0-9 ()-]{7,20}$',                       ["+44 20 1234", "abc", "+44 20 1234\nx"]],
  ['\Aonly\z',                                   ["only", "only\n", "x\nonly"]],
  ["^a.c$",                                      ["abc", "a\nc", "a\tc", "aéc"]]
].freeze

rows = CASES.flat_map do |pattern, inputs|
  regexp = Regexp.new(pattern)
  inputs.map { |input| { "pattern" => pattern, "input" => input, "matches" => regexp.match?(input) } }
end
puts JSON.pretty_generate(rows)
