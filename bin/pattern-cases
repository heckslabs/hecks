#!/usr/bin/env ruby

# Records expected match results for pattern: cases.
# The body lives in lib/hecks/cli/pattern_cases.rb; this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("pattern-cases")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/pattern_cases"

exit(Hecks::CLI::PatternCases.call)
