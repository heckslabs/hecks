#!/usr/bin/env ruby

# Checks the era a running host reports (`GET /version`) against an
# allow-list file after a roll. Read-only: one GET, no writes.
#
#   bin/check_era <url> <expected-era-file> [--timeout=<seconds>]

# The logic is `Hecks::CLI::CheckEra` (lib/hecks/cli/check_era.rb), which Custodian's
# `Host.CheckEra` also runs.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("check_era")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/check_era"

exit Hecks::CLI::CheckEra.run(ARGV)
