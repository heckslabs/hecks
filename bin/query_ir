#!/usr/bin/env ruby

# Structured queries against the language's own IR: construct diffs, duplicate rules, impact.
# A thin front end over Hecks::QueryIR, which bin/hecks_query_ir_mcp shares; needs no Postgres.
#
#   bin/query_ir constructs [Name ...]
#   bin/query_ir duplicates [--meta] [domain_dir ...]
#   bin/query_ir impact Name field     (advisory, not a gate)

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("query_ir")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/tools"

Hecks::Tools.script("query_ir", ARGV)
