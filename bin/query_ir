#!/usr/bin/env ruby

# Structured queries against the language's own IR — for a session
# working on the language (adding a resolution rule, checking a
# propagation checklist) rather than a domain running on top of it.
# `bin/ir` already dumps a whole domain's raw JSON; this answers the
# specific questions that recurred across five real feature rounds
# (docs/decisions/0028-.../ and .claude/skills/bluebook-construct-
# creator/SKILL.md) without hand-grepping corpus text or hand-reading
# Ruby source each time. This is a thin text front end — the real
# logic and the text formatting live in Hecks::QueryIR
# (lib/hecks/query_ir.rb), shared with
# bin/hecks_query_ir_mcp so the two front ends can never drift
# into two different answers — or two different renderings of the
# same answer — for the same question.
#
#   bin/query_ir constructs [Name ...]
#     For each Ruby IR class (or just the one named), the real
#     structural diff between what it emits and what the self-hosted
#     meta-domain declares for it. Answers "does Entity already have
#     field X" without opening entity.rb and entity.bluebook by hand.
#
#   bin/query_ir duplicates [--meta] [domain_dir ...]
#     Every given/ensures/invariant declaration across the given
#     domains (all real examples + the self-hosted meta-domain by
#     default), grouped by (kind, description, canonical), reporting
#     every group with more than one independently-declared rule.
#
#   bin/query_ir impact Name field
#     The six propagation touchpoints .claude/skills/bluebook-
#     construct-creator/SKILL.md walks in prose, checked structurally
#     for one construct/field pair — which ones already show signs of
#     it, which don't. Advisory, not a gate (see the doc comment on
#     Hecks::QueryIR.impact_preview for what a not yet can mean).
#
# Boots the lightweight way (Hecks::Codemod's own path) — no live
# Postgres needed for a Postgres-backed domain like compliance.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks"
require "hecks/query_ir"

# Prints the structural diff between each named IR class (or every one) and
# what the self-hosted meta-domain declares for it.
#
# @param args [Array<String>] construct names from `ARGV`, or empty for every
#   known construct
# @return [void]
def run_constructs(args)
  puts Hecks::QueryIR.format_constructs(Hecks::QueryIR.constructs(args))
rescue ArgumentError => e
  warn e.message
  exit 1
end

# Prints every duplicated given/ensures/invariant declaration across the
# given domains.
#
# @param args [Array<String>] domain directory paths from `ARGV`, plus an
#   optional `"--meta"` flag; empty (or `"--meta"` alone) means every real
#   example domain plus the self-hosted meta-domain
# @return [void]
def run_duplicates(args)
  use_meta = args.delete("--meta") || args.empty?
  domains  = args.empty? ? nil : args

  puts Hecks::QueryIR.format_duplicates(Hecks::QueryIR.duplicates(domains: domains, include_meta: use_meta))
end

# Prints the six propagation touchpoints for one construct/field pair.
#
# @param args [Array<String>] `[name, field]` from `ARGV`; prints a usage
#   message and exits if either is missing
# @return [void]
def run_impact(args)
  name, field = args
  unless name && field
    warn "usage: bin/query_ir impact Name field"
    exit 1
  end

  puts Hecks::QueryIR.format_impact_preview(Hecks::QueryIR.impact_preview(name, field))
rescue ArgumentError => e
  warn e.message
  exit 1
end

command = ARGV.shift
case command
when "constructs" then run_constructs(ARGV)
when "duplicates" then run_duplicates(ARGV)
when "impact"     then run_impact(ARGV)
else
  warn <<~USAGE
    Usage:
      bin/query_ir constructs [Name ...]
      bin/query_ir duplicates [--meta] [domain_dir ...]
      bin/query_ir impact Name field
  USAGE
  exit 1
end
