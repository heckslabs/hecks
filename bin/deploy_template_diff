#!/usr/bin/env ruby

# Compares two CloudFormation templates offline; exit 0 same, 1 differ, 2 bad input.
# The body lives in lib/hecks/cli/deploy_template_diff.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("deploy_template_diff")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/deploy_template_diff"

exit(Hecks::CLI::DeployTemplateDiff.call(ARGV))
