#!/usr/bin/env ruby

# Checks that every attribute shape and expression-operator category the Ruby grammar
# admits has a hand-written rust/src/kernel/<category>/<name>.rs file. Exits 1 if any is missing.
#
# Ground truth is Coercion::SHAPES and Grammar.admitted_operators, never a copied list.
# Existence is checked instead of a marker comment, which can be pasted into the wrong file.
# QueryComparator is absent on purpose: it is one flat file with no per-variant files to check.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("rust_kernel_coverage")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/kernel_capabilities"

ROOT = File.expand_path("..", __dir__)

rows = Hecks::KernelCapabilities.coverage(root: ROOT)
missing = rows.reject(&:present)

rows.each do |row|
  mark = row.present ? "OK  " : "MISS"
  puts "#{mark}  #{row.path.sub("#{ROOT}/", '')}  (#{row.source}: #{row.name.inspect})"
end

if missing.empty?
  puts "\n#{rows.size}/#{rows.size} kernel capability files present — every attribute shape and " \
       "expression-operator category the live Ruby grammar admits has a rust/src/kernel/ file at its " \
       "conventional path."
  exit 0
end

warn "\n#{missing.size} capability file(s) missing — the grammar admits these but no hand-written " \
     "Rust interpretation exists for them yet:"
missing.each { |row| warn "  #{row.path.sub("#{ROOT}/", '')}" }
exit 1
