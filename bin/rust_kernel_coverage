#!/usr/bin/env ruby

# The mechanical, comment-tag-free half of the guarantee.
# bin/project_kernel_capabilities generates the enum half — the compiler
# already refuses to build once `rust/src/kernel/expr.rs`'s
# `dispatch_operator` stops being exhaustive over a regenerated
# `OperatorCategory`/`AttributeShape`. But an enum variant existing is
# not the same claim as "a human wrote the real interpretation logic for
# it" — a freshly-added variant could be routed to an empty file, or to
# no file at all, and `cargo build` would still fail loudly (an
# unresolved `pub mod`) long before this script ever runs. What this
# script checks is narrower and comes first, chronologically: for every
# capability the live Ruby grammar admits right now, does
# `rust/src/kernel/<category>/<name>.rs` exist at all?
#
# **No comment tag, on purpose**. An earlier design for this kind of check
# might scan each Rust file for a marker comment naming which capability
# it implements — but a comment can be pasted into the wrong file, left
# behind after the logic it described was deleted, or simply never
# written. A missing file at the conventional path cannot lie either way
# — its absence structurally is "nobody has implemented this yet," the
# same reasoning `rust/project/domain_generator.rb`'s own generated
# `mod.rs` "one #[cfg(feature = ...)] per domain directory found on disk"
# scan already relies on for a different question ("does this domain
# still exist"). This script asks the language-level version of that
# same question.
#
# Ground truth is read the same way bin/project_kernel_capabilities reads
# it — Coercion::SHAPES and Grammar.admitted_operators's own `category`
# field — never a second, hand-copied list that could quietly drift from
# either the generator or from `bin/ir --meta` itself.
#
# `QueryComparator` (rust/src/kernel/query_comparators.rs,
# QuerySpecification::Common::COMPARATORS) is deliberately absent from
# the `rows` below, and that absence is itself the finding worth writing
# down: this script's whole question is "does a hand-written file exist
# at the conventional path for this capability," and `QueryComparator`
# has no per-variant files to exist at — it is one flat file, enum and
# interpretation together (query_comparators.rs's own header — no longer
# bin/project_kernel_capabilities-generated as of the ad hoc single-
# comparator filter step landing; see that script's header for where the
# hand-off happened), never a directory of `<name>.rs` interpretation
# files, so there is nothing this checker could mechanically confirm here
# beyond "the enum file itself exists," which `cargo build` already
# guarantees for free the moment anything `use`s it. Checking it here
# would either always read OK (checking a fact `cargo` already checks) or
# would have to invent a same-shaped-but-meaningless per-variant file
# just to have something to check — exactly the "forced into existence"
# this whole family of scripts exists to avoid. A real dispatch site for
# this enum now exists (`kernel/cli.rs`'s ad hoc "query" step, the object
# form) — but only for that one narrow shape; a named/declared bluebook
# query (the string form of the same step) is still exactly the gap
# bin/rust_coverage's job, not this script's, tracks under `query`'s own
# "whole_kind" gap class, and stays that way.
#
#   bin/rust_kernel_coverage

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "hecks/grammar"
require "hecks/runtime/value/coercion"

ROOT = File.expand_path("..", __dir__)

# Builds one coverage row per capability name, checking whether its Rust
# interpretation file exists at the conventional path.
#
# @param category_dir [String] subdirectory under `rust/src/kernel` to check,
#   such as `"attribute_shapes"`
# @param names [Array<String>] capability names the live Ruby grammar admits for this category
# @param source [String] label naming where `names` came from, echoed into each row for the report
# @return [Array<Hash>] one row per name, with keys `:name` [String], `:path` [String] (the
#   expected file's absolute path), `:present` [Boolean] (whether the file exists on disk), and
#   `:source` [String] (the `source` argument, verbatim)
def check(category_dir, names, source)
  names.map do |name|
    path = File.join(ROOT, "rust/src/kernel", category_dir, "#{name}.rs")
    { name: name, path: path, present: File.file?(path), source: source }
  end
end

rows = check("attribute_shapes", Hecks::Runtime::Value::Coercion::SHAPES,
             "Coercion::SHAPES") +
       check("expression_operators", Hecks::Grammar.admitted_operators.map { |op| op[:category] }.uniq,
             "Grammar.admitted_operators's own category field")

missing = rows.reject { |row| row[:present] }

rows.each do |row|
  mark = row[:present] ? "OK  " : "MISS"
  puts "#{mark}  #{row[:path].sub("#{ROOT}/", '')}  (#{row[:source]}: #{row[:name].inspect})"
end

if missing.empty?
  puts "\n#{rows.size}/#{rows.size} kernel capability files present — every attribute shape and " \
       "expression-operator category the live Ruby grammar admits has a rust/src/kernel/ file at its " \
       "conventional path."
  exit 0
end

warn "\n#{missing.size} capability file(s) missing — the grammar admits these but no hand-written " \
     "Rust interpretation exists for them yet:"
missing.each { |row| warn "  #{row[:path].sub("#{ROOT}/", '')}" }
exit 1
