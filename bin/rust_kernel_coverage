#!/usr/bin/env ruby

# Checks that every attribute shape and expression-operator category the Ruby grammar
# admits has a hand-written rust/src/kernel/<category>/<name>.rs file. Exits 1 if any is missing.
#
# A shim: the check is Hecks::KernelCapabilities.coverage_report (lib/hecks/kernel_capabilities.rb).

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("rust_kernel_coverage")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/kernel_capabilities"

lines, verdict, complete = Hecks::KernelCapabilities.coverage_report(root: File.expand_path("..", __dir__))
puts lines
if complete
  puts "\n#{verdict}"
  exit 0
end

warn "\n#{verdict}"
exit 1
