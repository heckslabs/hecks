#!/usr/bin/env ruby

# Surfaces sibling-repo bluebook domains as rotation candidates — report
# only. The `hecks_qa` practice widens its own rotation from domains it
# already owns (`bin/qa_seed_targets`, `bin/qa_domain_novelty`); this is
# the one that looks outside this repo, at `~/Projects` (or wherever
# `--projects-dir` points), for a domain some other project built against
# the real `hecks` gem.
#
#   bin/qa_discover_external_domains
#   bin/qa_discover_external_domains --projects-dir ~/Projects
#   bin/qa_discover_external_domains --max-depth 4
#   bin/qa_discover_external_domains --known-path <path> ...   # bypass the ledger read (this
#   script's own spec uses this)
#
# **Never identifies anything itself**. A domain a sibling repo owns is
# outside this practice's control in a way `qa/stress_domains/*` never
# is — the decision to fuzz it belongs to a person, not this script. It
# prints the exact `bin/run qa/bluebook identify reference=… path=…`
# command; running that command is a separate, deliberate act. Matches
# the `bin/qa_mine_combinations` precedent: an explicit script
# a person runs, never wired into `bin/qa_tick`'s own default rotation,
# and no `QualityControlDials`/`qa/settings.yml` entry turns it on —
# there is nothing here for a dial to gate.
#
# The shape checked, and why globbing `*.bluebook` is not enough. Every
# domain this repo already sweeps is `<name>/bluebook/<name>.bluebook`
# (`examples/pizzas/bluebook/pizzas.bluebook`, `qa/stress_domains/
# corrections/bluebook/corrections.bluebook` — `bin/qa_domain_novelty`
# enforces the identical shape for a reason: `bin/project_rust` reads
# exactly that file for `source_text`). A bare `*.bluebook` glob would
# also catch every `.adapter`/`.port`-adjacent fixture and every helper
# file a real domain's own `bluebook/` directory carries beside its
# entry point — this only reports a directory whose own name is repeated
# as the file inside its `bluebook/` subdirectory, exactly the one file
# `Hecks.boot` and `bin/project_rust` both treat as the domain's root.
#
# **Two shapes, one check** — nested and repo-root. The name-repetition rule
# above is applied uniformly at every depth the walk visits, including
# depth 0 (the sibling repo's own root): a repo whose own name is
# `foo` and that carries `foo/bluebook/foo.bluebook` at its own top
# matches the identical way `examples/pizzas/bluebook/pizzas.bluebook`
# does one level down — there is no special-casing needed, and none
# exists. Verified against two real siblings, not just fixtures:
# `~/Projects/playaprep` is one domain at its own root
# (`playaprep/bluebook/playaprep.bluebook`) and is reported as
# `playaprep/playaprep`; `~/Projects/embryonautfoundersapp` has the same
# root shape (`bluebook/embryonautfoundersapp.bluebook`, beside sibling
# `adapters/`/`translations/` dirs the walk correctly never descends
# into — the `next if child == "bluebook"` guard below) but is correctly
# not reported, because its `Gemfile` depends on `hecksagain` (vendored,
# aliased `Hecks = Hecksagain` for DSL readability), never on the real
# `hecks` gem — same exclusion `near_miss_repo` in this script's own
# fixtures exists to pin, just at depth 0 instead of depth 1
# (`spec/fixtures/.../near_miss_root_shaped_repo`). If
# `embryonautfoundersapp`'s in-progress `use-hecks-gem` migration branch
# (seen live in its own `.claude/worktrees/use-hecks-gem`, not yet on
# its `main`) ever lands — real `gem "hecks", "~> 1.3"` in its Gemfile —
# this script starts reporting it with no code change at all.
#
# **The second guard**: does the project actually depend on `hecks`. A
# `*.bluebook` file living in some unrelated project that happens to
# share this naming accident is not a hecks domain. `hecks.gemspec`
# names this gem "hecks" (`spec.name = "hecks"`); a real dependent
# either vendors it (`gem "hecks", path: "vendor/hecks"`, exactly
# `hecks_playground`'s own `Gemfile`) or pins a published/git version —
# either way, a line in `Gemfile` or a `specs:` entry in `Gemfile.lock`
# names it. Checked before the recursive shape walk (cheap, two file
# reads) so a project with no `hecks` dependency at all is skipped
# without ever touching its filesystem tree.
#
# Depth is bounded, deliberately, and validated against real siblings —
# not arbitrary. `--max-depth` counts path segments below the sibling
# repo's own root (the repo root itself is depth 0, so it too can be a
# candidate: a project that is one domain, `<repo>/bluebook/<repo>.
# bluebook` at its own top). This repo's two conventions span depth 2
# (`examples/pizzas`) and depth 3 (`qa/stress_domains/corrections`),
# which sets the default. Checked for real against `~/Projects/
# hecks_playground` (a large, real hecks dependent): unbounded recursion
# finds ~100 shape matches, because every aggregate inside its
# `hecks_playground_conception/aggregates/framework/*` tree individually
# satisfies `<name>/bluebook/<name>.bluebook` — they are framework
# chapters of one much larger domain, not standalone targets, and
# reporting all of them would bury the handful that actually are behind
# noise a person cannot usefully review. Depth 3 cuts that to ten real
# candidates. A person can still widen `--max-depth` by hand if a
# sibling's real domains live deeper.
#
# What is still not checked, on purpose: whether a candidate actually
# boots standalone (`Hecks.boot` on it might still fail — a framework
# chapter one level shallower than `--max-depth` would catch could still
# slip through). This script's whole point is to be cheap enough to run
# often and never touch the sibling repo's own Ruby environment; boot-
# checking a candidate is exactly the kind of confirmation the human
# review step (or `bin/run <path> ask …`, by hand) is for, same as
# `bin/qa_domain_novelty` is a separate, later gate for a domain already
# chosen — never folded into discovery itself.
#
# A real, discovered limitation worth naming here: `bin/qa_sweep`
# resolves every `Target.path` as `File.join(ROOT, target_path)` — `ROOT`
# being this repo's own root. An external, absolute path survives
# `identify` (`TargetPath` only forbids whitespace) but `qa_sweep` has
# no code path today that sweeps a target whose real location is outside
# `ROOT`. Printing the `identify` command anyway is still correct — the
# task this script exists for is discovery, and enrollment is a person's
# call — but a sweep of an enrolled external target needs that gap
# closed first; this script does not attempt to close it.
#
# **Exit codes**: 0 ran cleanly (whether or not it found anything to
# report); 1 usage or an operational error (projects dir missing, the
# ledger unreadable and no --known-path given).

require "open3"
require "json"

ROOT = File.expand_path("..", __dir__)

USAGE = "usage: bin/qa_discover_external_domains [--projects-dir <path>] [--max-depth N] " \
        "[--known-path <path> ...]".freeze

DEFAULT_PROJECTS_DIR = File.expand_path("~/Projects").freeze
DEFAULT_MAX_DEPTH = 3

# Never worth descending into, anywhere in a sibling repo: VCS internals,
# vendored/installed dependency trees (a project vendoring `hecks`
# itself would otherwise re-surface every one of this repo's own
# `examples/*`/`qa/stress_domains/*` as a "new" external candidate — see
# `hecks_playground/vendor/hecks`), and this practice's own worktree
# scratch space (`.claude/worktrees/…`, which duplicates whatever the
# sibling repo's real tree already contains).
SKIP_DIR_BASENAMES = %w[.git .hg .svn vendor node_modules .bundle tmp log coverage .yardoc .ruby-lsp .parked
                        bower_components .claude dist build].freeze

# Prints `message` and the usage string to stderr, then exits the process.
#
# @param message [String] what went wrong, printed before the usage string
# @return [void]
def usage!(message)
  warn message
  warn USAGE
  exit 1
end

# `Gemfile` names a gem by a quoted literal (`gem "hecks", path: …`);
# `Gemfile.lock` names it as an indented `specs:` entry (`    hecks
# (0.1.0)`). Either is enough to call the project a real dependent — a
# project pinning a published or `git:`-sourced `hecks` has no `gem
# "hecks"` guarantee in a stray comment line, but always gets a `specs:`
# entry once `bundle install` has run. Matched with a word boundary so
# "hecksagain" (a real, unrelated gem this same ecosystem has — see
# `hecks_playground`'s own vendored `hecksagain`) and "hecks_playground"
# itself never false-positive: `\bhecks\b` cannot match inside either,
# there is no boundary between "hecks" and the character right after it
# in "hecksagain"/"hecks_playground".
GEMFILE_PATTERN      = /gem\s*\(?\s*["']hecks["']/
GEMFILE_LOCK_PATTERN = /^\s+hecks\s+\(/

# Whether the sibling project at `repo_root` actually depends on the real
# `hecks` gem, not just something that happens to carry a `.bluebook` file.
#
# @param repo_root [String] the sibling project's own root directory
# @return [Boolean] whether its `Gemfile` or `Gemfile.lock` names `hecks`
def depends_on_hecks?(repo_root)
  gemfile = File.join(repo_root, "Gemfile")
  lockfile = File.join(repo_root, "Gemfile.lock")

  (File.file?(gemfile) && File.read(gemfile).match?(GEMFILE_PATTERN)) ||
    (File.file?(lockfile) && File.read(lockfile).match?(GEMFILE_LOCK_PATTERN))
end

# Every `<entity>/bluebook/<entity>.bluebook` under `repo_root`, entity
# dir at most `max_depth` path segments below it (`repo_root` itself is
# depth 0). Returns `[entity_dir, entity_name]` pairs.
#
# @param repo_root [String] the sibling project's own root directory to walk
# @param max_depth [Integer] how many path segments below `repo_root` the walk
#   descends
# @return [Array<Array(String, String)>] `[entity_dir, entity_name]` pairs, one
#   per matching directory found
def bluebook_shaped_dirs(repo_root, max_depth)
  found = []
  walk = lambda do |dir, depth|
    entity_name = File.basename(dir)
    candidate = File.join(dir, "bluebook", "#{entity_name}.bluebook")
    found << [dir, entity_name] if File.file?(candidate)
    return if depth >= max_depth

    children = begin
      Dir.children(dir).sort
    rescue Errno::EACCES, Errno::ENOENT
      []
    end

    children.each do |child|
      next if SKIP_DIR_BASENAMES.include?(child)

      child_path = File.join(dir, child)
      next unless File.directory?(child_path) && !File.symlink?(child_path)
      next if child == "bluebook" # the bluebook/ directory itself is never an entity dir

      walk.call(child_path, depth + 1)
    end
  end
  walk.call(repo_root, 0)
  found
end

# Read-only, exactly `bin/qa_domain_novelty`'s own `ledger_target_paths`
# — a subprocess `ask`, never a boot of the ledger in this process, so
# running discovery alongside a live `bin/qa_tick`/`bin/qa_sweep` is
# always safe. Existing paths are normalized to absolute: a target this
# repo seeded (`examples/pizzas`) is stored `ROOT`-relative, one this
# script's own `identify` suggestion produced would be absolute already
# — both have to compare equal to the candidate paths this script finds,
# which are always absolute.
#
# @return [Array<String>] every known target path, `File.expand_path`ed
def ledger_target_paths
  out, err, status = Open3.capture3("bundle", "exec", "ruby", File.join(ROOT, "bin/run"),
                                    "qa/bluebook", "ask", "target.all", chdir: ROOT)
  unless status.success?
    warn "bin/qa_discover_external_domains: could not read the ledger's targets " \
         "(bin/run qa/bluebook ask target.all exited #{status.exitstatus}):\n#{err}"
    warn "pass --known-path <path> ... to run without the ledger"
    exit 1
  end

  JSON.parse(out).filter_map { |row| row.dig("path", "value") }
end

options = { projects_dir: DEFAULT_PROJECTS_DIR, max_depth: DEFAULT_MAX_DEPTH, known_paths: nil }
argv = ARGV.dup
until argv.empty?
  case (arg = argv.shift)
  when "-h", "--help"
    puts USAGE
    exit 0
  when "--projects-dir"
    usage!("--projects-dir needs a path") if argv.empty?
    options[:projects_dir] = File.expand_path(argv.shift)
  when "--max-depth"
    usage!("--max-depth needs a number") if argv.empty?
    options[:max_depth] = Integer(argv.shift)
  when "--known-path"
    usage!("--known-path needs a path") if argv.empty?
    (options[:known_paths] ||= []) << File.expand_path(argv.shift)
  else
    usage!("unexpected argument #{arg.inspect}")
  end
end

usage!("--max-depth must be >= 0") if options[:max_depth].negative?
usage!("#{options[:projects_dir]} is not a directory") unless File.directory?(options[:projects_dir])

known_raw = options[:known_paths] || ledger_target_paths
known_paths = known_raw.to_set { |path| path.start_with?("/") ? File.expand_path(path) : File.expand_path(path, ROOT) }

hecks_root_realpath = begin
  File.realpath(ROOT)
rescue Errno::ENOENT
  ROOT
end

sibling_repos = Dir.children(options[:projects_dir]).sort.filter_map do |child|
  next if child == "hecks" # this repo — already fully covered by existing seeding

  path = File.join(options[:projects_dir], child)
  next unless File.directory?(path) && !File.symlink?(path)

  begin
    next if File.realpath(path) == hecks_root_realpath
  rescue Errno::ENOENT
    next
  end

  path
end

candidates = []
skipped_no_hecks = []

sibling_repos.each do |repo_path|
  unless depends_on_hecks?(repo_path)
    skipped_no_hecks << repo_path
    next
  end

  bluebook_shaped_dirs(repo_path, options[:max_depth]).each do |entity_dir, entity_name|
    absolute = File.expand_path(entity_dir)
    next if known_paths.include?(absolute)

    repo_name = File.basename(repo_path)
    reference = "#{repo_name}/#{entity_name}"
    candidates << { repo: repo_name, reference: reference, path: absolute }
  end
end

candidates.sort_by! { |c| [c[:repo], c[:reference]] }

puts "scanned #{sibling_repos.size} sibling(s) under #{options[:projects_dir]} " \
     "(max depth #{options[:max_depth]}), #{sibling_repos.size - skipped_no_hecks.size} depend on the hecks gem"
puts "no hecks dependency, skipped: #{skipped_no_hecks.map { |p| File.basename(p) }.join(', ')}" unless skipped_no_hecks.empty?
puts

if candidates.empty?
  puts "no new candidates — every hecks-dependent sibling's bluebook-shaped domain is either already a " \
       "Target or none was found in the shape <name>/bluebook/<name>.bluebook within --max-depth " \
       "#{options[:max_depth]}."
  exit 0
end

puts "#{candidates.size} candidate(s) — report only, nothing identified. Review each, then run the command " \
     "yourself to enroll it:"
puts
candidates.each do |c|
  puts "  #{c[:reference]}"
  puts "    path: #{c[:path]}"
  puts "    enroll: bin/run qa/bluebook identify reference=#{c[:reference]} path=#{c[:path]}"
  puts
end

exit 0
