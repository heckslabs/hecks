#!/usr/bin/env ruby

# Reports sibling-repo bluebook domains that depend on hecks but are not enrolled.
# The body lives in lib/hecks/quality_control/cli/qa_discover_external_domains.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_discover_external_domains")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/quality_control/cli/qa_discover_external_domains"

exit(Hecks::QualityControlCli::QaDiscoverExternalDomains.call(ARGV, root: File.expand_path("..", __dir__)))
