#!/usr/bin/env ruby

# Generates the argument-gate ordering matrix: for each adjacent pair of gates a command
# can violate, one input violating both, with Ruby's refusal recorded as the expected answer.
# A row is kept only when Ruby's dispatch trace shows the earlier gate refused (ADR 0010).
#
#   bin/argument_gate_matrix            # report only
#   bin/argument_gate_matrix --write    # rewrite the matrix + fixtures

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("argument_gate_matrix")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/tools"

Hecks::Tools.script("argument_gate_matrix", ARGV)
