#!/usr/bin/env ruby

# THE ARGUMENT-GATE ORDERING MATRIX (roadmap D2) — one generated table
# replacing the hand-written refusal-order fixtures that each pinned ONE
# pair of argument gates on ONE command shape (`refusal_order_*`,
# `bug38_*`, `bug135_*`, `bug136_*`, `ledger_ordering_addslip_refusal_
# precedence`). Those fixtures were each written the day a specific
# ordering bug was found, so the corpus only ever covered the pairs that
# had already gone wrong.
#
# WHAT THIS BUILDS INSTEAD: for every command in a named domain, for every
# ADJACENT PAIR of argument-gate steps the command can actually violate
# (`Vocabulary::AggregateDispatchOrder`/`EntityDispatchOrder`, minus the
# gates that are no-ops for that command — a command with no declared
# `role` cannot violate `refuse_role_mismatch`, so `normalize_args` and
# `resolve_references` are adjacent FOR IT), one input violating BOTH.
# The expected refusal is not written here: it is whatever RUNNING RUBY
# answers, recorded with the step Ruby's own dispatch trace says refused.
# Ruby is the oracle (docs/decisions/0010) — this table is Ruby's answer,
# and `spec/runtime/argument_gate_order_matrix_spec.rb` holds Ruby to it
# while `spec/corpus/rust_conformance/argument_gate_order_*.json` (the
# same rows, as an ordinary conformance script) holds the Rust port to it.
#
# A row is KEPT only when Ruby's trace attributes the refusal to the
# EARLIER of the two steps — which is the property the matrix exists to
# state. A pair whose generated input Ruby refuses somewhere else (a
# generated "valid" value for an unrelated attribute that a domain's own
# pattern or invariant rejects, say) is DROPPED and counted in the
# report, never silently reinterpreted.
#
#   bin/argument_gate_matrix            # report only
#   bin/argument_gate_matrix --write    # rewrite the matrix + fixtures

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "hecks/fuzzing"
require "json"

ROOT = File.expand_path("..", __dir__)

# The domains the matrix is built over — chosen for the argument shapes
# they carry, not by listing every corpus domain: banking (deep value
# objects, references, roles), pizzas (the smallest aggregate-only shape),
# roster (entity commands with an optional identity echo — BUG#132/#135/
# #136's own domain), chess (closed sets), nested_pieces (a two-hop entity
# command), ledger_ordering (an aggregate whose identity wire key collides
# with a declared argument — BUG#54's own domain).
DOMAINS = %w[
  examples/banking
  examples/pizzas
  examples/roster
  examples/chess
  qa/stress_domains/nested_pieces
  qa/stress_domains/ledger_ordering
].freeze

MATRIX_PATH = File.join(ROOT, "spec/corpus/argument_gate_order/matrix.json")

FIXTURE_NOTE = "GENERATED by bin/argument_gate_matrix (roadmap D2) — one step per adjacent pair of " \
               "argument-gate steps this domain's own commands can violate, each input violating BOTH, so " \
               "the refusal that wins is the EARLIER declared step's. Ruby's own answers are pinned in " \
               "spec/corpus/argument_gate_order/matrix.json; this file holds the Rust port to the same rows " \
               "through the ordinary conformance harness. Do not hand-edit — re-run " \
               "bin/argument_gate_matrix --write.".freeze

# The gates, in DECLARED order, read off the generated vocabulary table
# rather than typed here — reordering vocabulary.bluebook reorders this
# matrix's own pairs, which is the point.
AGGREGATE_ORDER = Hecks::Vocabulary.symbols("AggregateDispatchOrder").map(&:to_s)
ENTITY_ORDER    = Hecks::Vocabulary.symbols("EntityDispatchOrder").map(&:to_s)
# `decode_arguments` is a no-op in Ruby (routing hands the interpreter a
# decoded hash), so no input can violate it and no pair can name it.
GATES = %w[refuse_unknown_arguments refuse_absent_arguments normalize_args refuse_role_mismatch resolve_references].freeze
# The step immediately after the gates in both orders — identity
# resolution. The D2 fix is exactly that every gate precedes it.
SETTLES = { "aggregate" => "hydrate", "entity" => "hydrate_parent" }.freeze

# `random.rand` with no argument answers a constant above every
# "sometimes generate something deliberately invalid" probability in
# `ValueGenerator`, so the base payload this builds is the generator's
# VALID shape every time; `rand(n)`/`bytes` stay real so distinct
# attributes still get distinct values.
class SteadyRandom
  def initialize(seed) = @random = Random.new(seed)
  def rand(limit = nil) = limit.nil? ? 0.99 : @random.rand(limit)
  def bytes(count) = @random.bytes(count)
end

def order_for(kind) = kind == "entity" ? ENTITY_ORDER : AGGREGATE_ORDER

def base_args(command, aggregate, random)
  command.attributes.to_h do |attribute|
    [attribute.name.to_s, Hecks::Fuzzing::ValueGenerator.value_for(attribute, aggregate, random: random, known_ids: {})]
  end
rescue ArgumentError
  nil
end

def identity_args(construct, aggregate, random)
  Array(construct.identified_by).to_h do |path|
    head = path.to_s.split(".").first
    attribute = construct.attributes.find { |a| a.name.to_s == head }
    value = attribute && Hecks::Fuzzing::ValueGenerator.value_for(attribute, aggregate, random: random, known_ids: {})
    [head, value || "no-such-#{head}"]
  end
rescue ArgumentError
  {}
end

# `to:`/`with:` are the DISPATCH ENVELOPE's own keywords on the loose-
# keyword form every step here uses — a command that happens to declare an
# attribute by one of those names (`Roster::Roster.Notice`'s own `to`,
# BUG#7) has it read as a route, not as a fact, so corrupting or dropping
# it exercises envelope parsing rather than an argument gate. Left alone.
ENVELOPE_KEYS = %w[to with].freeze

def corruptible(command)
  command.attributes.reject { |a| a.list? || a.reference? || ENVELOPE_KEYS.include?(a.name.to_s) }
end

def droppable(command)
  command.attributes.reject { |a| a.optional? || a.list? || ENVELOPE_KEYS.include?(a.name.to_s) }
end

def live_gates(command, kind)
  gates = ["refuse_unknown_arguments"]
  gates << "refuse_absent_arguments" if droppable(command).any?
  gates << "normalize_args" if corruptible(command).any?
  gates << "refuse_role_mismatch" unless command.role.to_s.empty?
  gates << "resolve_references" if command.attributes.any?(&:reference?)
  gates << SETTLES.fetch(kind) unless kind == "aggregate" && command.creates?
  gates
end

MISMATCHED_ROLE = "a role this caller does not hold".freeze

# Makes `args` violate ONE declared step, answering what it did (for the
# matrix's own `violates` record) or `nil` when this command cannot
# violate that step after all.
def violate!(step, args, command, aggregate, random)
  case step
  when "refuse_unknown_arguments" then violate_unknown!(args, random)
  when "refuse_absent_arguments"  then violate_absent!(args, command)
  when "normalize_args"           then violate_normalize!(args, command, aggregate, random)
  when "refuse_role_mismatch"     then MISMATCHED_ROLE
  when "resolve_references"       then violate_reference!(args, command)
  # Nothing to do for identity — the matrix runs against an empty world,
  # so every acting command addresses a record that does not exist.
  when "hydrate", "hydrate_parent" then "no record exists"
  end
end

def violate_unknown!(args, random)
  name, value = Hecks::Fuzzing::InvalidValueGenerator.undeclared_argument(random: random)
  args[name.to_s] = value
  name.to_s
end

def violate_absent!(args, command)
  dropped = droppable(command).first or return nil

  args.delete(dropped.name.to_s)
  dropped.name.to_s
end

# A WRONG VALUE BOTH ENGINES DESCRIBE THE SAME WAY. `InvalidValueGenerator.
# corrupt` (the fuzzer's own corruption) is deliberately not used here: two
# of the shapes it reaches are already-catalogued RENDERING gaps rather
# than ordering ones — a composite value object offered as a bare scalar
# or array (Ruby names the caller's own attribute, "amount is a
# PositiveMoney — pass its fields as an object"; the generated Rust
# skeleton has no attribute name in hand and says "PositiveMoney expects
# an object", the C8.2 kind-only pin `json_codec.rb#emit_object_shape_
# check` documents), and an Array rendered into a message (`["a", "b"]`
# in Ruby, `["a","b"]` in Rust). This matrix exists to pin WHICH STEP
# refuses, so it stays off both: it corrupts a declared FIELD of the
# value object instead, with a scalar, and every such refusal's wording
# already agrees byte-for-byte.
def violate_normalize!(args, command, aggregate, _random)
  attribute = corruptible(command).find { |a| args.key?(a.name.to_s) } || corruptible(command).first
  return nil unless attribute

  value_object = Hecks::Runtime::Value.value_object_for(aggregate, attribute.type.to_s)
  current = args[attribute.name.to_s]
  wrong =
    if value_object.nil?
      mistyped_scalar(attribute.type)
    elsif current.is_a?(Hash)
      field = value_object.attributes.find { |f| current.key?(f.name.to_s) } or return nil

      current.merge(field.name.to_s => value_object.closed_set? ? NON_MEMBER : mistyped_scalar(field.type))
    end
  return nil if wrong.nil?

  args[attribute.name.to_s] = wrong
  attribute.name.to_s
end

# A string no `one_of` in this corpus admits — a closed set's own refusal
# is about MEMBERSHIP, so the value has to be well-typed to reach it.
NON_MEMBER = "not a declared member".freeze

# A String-typed field is the one shape the two engines describe
# differently when the wrong value is a plain scalar: Ruby answers
# "X.value expects String, got 0", the generated Rust's own scalar branch
# answers "X.value: expected String" (its Ruby-matching wording is on the
# Array/Object/Null branch alone — `json_codec.rb#scalar_from_json_value_
# expr`). An OBJECT takes the branch they DO share, so use that.
def mistyped_scalar(type_name)
  type_name.to_s == "String" ? {} : "not a #{type_name.to_s.downcase}"
end

def violate_reference!(args, command)
  reference = command.attributes.find(&:reference?) or return nil

  args[reference.name.to_s] = "no-such-#{reference.type.target_name.to_s.downcase}"
  reference.name.to_s
end

def refused_step(kind)
  interpreter = kind == "entity" ? Hecks::Runtime::EntityInterpreter : Hecks::Runtime::CommandInterpreter
  ran = interpreter.trace || []
  # `decode_arguments` never traces — it is the one declared step with no
  # work to do in Ruby yet (`CommandInterpreter#step_decode_arguments`
  # does not wrap itself in `step`), so it can never be the step that
  # refused and must not be read as one.
  order_for(kind).reject { |step| step == "decode_arguments" }.find { |step| !ran.include?(step.to_sym) }
end

def run_row(runtime, row, kind)
  Hecks::Runtime::CommandInterpreter.trace = []
  Hecks::Runtime::EntityInterpreter.trace = []
  args = JSON.parse(JSON.generate(row[:args])).transform_keys(&:to_sym)
  begin
    if row[:role]
      Hecks.as_caller(role: row[:role]) { runtime.dispatch_flat(row[:verb], args) }
    else
      runtime.dispatch_flat(row[:verb], args)
    end
    [nil, nil, nil]
  rescue *Hecks::Runtime::DOMAIN_REFUSALS => e
    [e.class.name.split("::").last, e.message, refused_step(kind)]
  end
ensure
  Hecks::Runtime::CommandInterpreter.trace = nil
  Hecks::Runtime::EntityInterpreter.trace = nil
end

def rows_for(command, aggregate, verb, kind, random)
  # A command that declares an attribute named `to` or `with`
  # (`Roster::Roster.Mark`/`.Notice`) cannot be reached through the
  # loose-keyword form every step here uses at all: that fact IS the
  # dispatch envelope (BUG#7, spec/runtime/routing_envelope_shape_spec.rb),
  # so the call never gets as far as an argument gate. Left out entirely
  # rather than exercised through a routing refusal.
  return [] if command.attributes.any? { |a| ENVELOPE_KEYS.include?(a.name.to_s) }

  base = base_args(command, aggregate, random)
  return [] if base.nil?

  gates = live_gates(command, kind)
  gates.each_cons(2).filter_map do |earlier, later|
    args = JSON.parse(JSON.generate(base))
    args.merge!(identity_args(aggregate, aggregate, random)) unless kind == "aggregate" && command.creates?
    role = nil
    earlier_detail = violate!(earlier, args, command, aggregate, random)
    later_detail   = violate!(later, args, command, aggregate, random)
    next if earlier_detail.nil? || later_detail.nil?

    role = MISMATCHED_ROLE if [earlier, later].include?("refuse_role_mismatch")

    { verb: verb, kind: kind, role: role, pair: [earlier, later],
      violates: { earlier => earlier_detail, later => later_detail }, args: args }
  end
end

def candidates(runtime, chapter)
  bluebook = runtime.registry.bluebook(chapter)
  random = SteadyRandom.new(20_260_918)
  bluebook.aggregates.flat_map do |aggregate|
    aggregate_rows = aggregate.commands.flat_map do |command|
      rows_for(command, aggregate, "#{chapter}::#{aggregate.hecks_name}.#{command.hecks_name}", "aggregate", random)
    end
    entity_rows = aggregate.entities.flat_map do |entity|
      entity.commands.flat_map do |command|
        verb = "#{chapter}::#{aggregate.hecks_name}.#{entity.hecks_name}.#{command.hecks_name}"
        rows = rows_for(command, aggregate, verb, "entity", random)
        rows.each { |row| row[:args] = identity_args(entity, aggregate, random).merge(row[:args]) }
      end
    end
    aggregate_rows + entity_rows
  end
end

kept = []
dropped = []

DOMAINS.each do |domain|
  Hecks::Fuzzing::IsolatedBoot.call(File.join(ROOT, domain)) do |copy|
    runtime = Hecks.boot(copy)
    chapters = runtime.registry.bluebooks.keys
    chapter = chapters.find { |name| candidates(runtime, name).any? } || chapters.first
    candidates(runtime, chapter).each do |row|
      kind, error, refused = run_row(runtime, row, row[:kind])
      if kind.nil?
        dropped << row.merge(reason: "Ruby accepted it — neither gate refused")
      elsif refused.to_s != row[:pair].first
        dropped << row.merge(reason: "Ruby refused at #{refused.inspect} (#{kind}), not the earlier declared step")
      else
        kept << row.merge(domain: domain, expected: { "kind" => kind, "error" => error, "refused_at" => refused.to_s })
      end
    end
  end
end

pairs = kept.group_by { |row| row[:pair].join(" before ") }.transform_values(&:size)
puts "kept #{kept.size} rows over #{DOMAINS.size} domains; dropped #{dropped.size}"
pairs.sort.each { |pair, count| puts "  #{pair}: #{count}" }
dropped.group_by { |row| row[:reason] }.sort_by { |_, rows| -rows.size }.each do |reason, rows|
  puts "  dropped #{rows.size}: #{reason}"
end

exit 0 unless ARGV.include?("--write")

FileUtils.mkdir_p(File.dirname(MATRIX_PATH))
matrix = {
  "generated_by"    => "bin/argument_gate_matrix",
  "aggregate_order" => AGGREGATE_ORDER,
  "entity_order"    => ENTITY_ORDER,
  "rows"            => kept.map do |row|
    { "domain" => row[:domain], "verb" => row[:verb], "kind" => row[:kind], "pair" => row[:pair],
      "violates" => row[:violates], "role" => row[:role], "args" => row[:args], "expected" => row[:expected] }
  end
}
File.write(MATRIX_PATH, "#{JSON.pretty_generate(matrix)}\n")
puts "wrote #{MATRIX_PATH}"

kept.group_by { |row| row[:domain] }.each do |domain, rows|
  feature = File.basename(domain)
  path = File.join(ROOT, "spec/corpus/rust_conformance/argument_gate_order_#{feature}.json")
  fixture = {
    "domain" => domain,
    "note"   => FIXTURE_NOTE,
    "steps"  => rows.map do |row|
      step = { "verb" => row[:verb] }
      step["role"] = row[:role] if row[:role]
      step["args"] = row[:args]
      step
    end
  }
  File.write(path, "#{JSON.pretty_generate(fixture)}\n")
  puts "wrote #{path}"
end
