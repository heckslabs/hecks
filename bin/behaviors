#!/usr/bin/env ruby

# Runs `.behaviors` files and reports pass/fail/error per test (docs/guides/behaviors.md).
# Exits nonzero if any test failed or errored, or a file failed to parse.
#
#   bin/behaviors path/to/domain.behaviors
#   bin/behaviors path/to/directory              # sweeps **/*.behaviors

# The logic is `Hecks::CLI::Behaviors` (lib/hecks/cli/behaviors.rb), which Custodian's
# `Operation.RunBehaviors` also runs.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("behaviors")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/behaviors"

Hecks::CLI::Behaviors.call(ARGV, program: "bin/behaviors")
