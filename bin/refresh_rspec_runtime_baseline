#!/usr/bin/env ruby

# Regenerates the committed runtime baselines the sharded CI jobs group from.
# The body lives in lib/hecks/cli/refresh_rspec_runtime_baseline.rb; this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("refresh_rspec_runtime_baseline")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/refresh_rspec_runtime_baseline"

exit(Hecks::CLI::RefreshRspecRuntimeBaseline.call(ARGV, root: File.expand_path("..", __dir__)))
