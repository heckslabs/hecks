#!/usr/bin/env ruby

# Measures command-dispatch throughput and p50/p99 latency for each persistence adapter
# and the Rust binary. Never fails on a slow number; see docs/benchmarks.md.
#
#   bin/bench                                  # everything, three runs each
#   bin/bench --targets ruby:memory,rust       # just those targets
#   bin/bench --domain pizzas --runs 5
#   bin/bench --format json --output tmp/bench.json
#
# Targets that need an unreachable Postgres or a missing `cargo` are skipped.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("bench")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "hecks/bench"

exit Hecks::Bench::CLI.run(ARGV)
