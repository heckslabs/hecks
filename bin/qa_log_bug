#!/usr/bin/env ruby

# Logs a bug to the QualityControl ledger: proven, numbered, triaged.
# The body lives in lib/hecks/quality_control/cli/qa_log_bug.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_log_bug")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/quality_control/cli/qa_log_bug"

exit(Hecks::QualityControlCli::QaLogBug.call(ARGV, root: File.expand_path("..", __dir__)))
