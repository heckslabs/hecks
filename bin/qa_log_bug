#!/usr/bin/env ruby

# Log a bug the only way the ledger allows — proven, numbered, triaged.
#
# `QualityControl::Bug.Log` (qa/bluebook/quality_control.bluebook) takes
# a `demonstration` as a required argument — this chapter's one absolute
# rule, "a bug is logged with the failing test that proves it, or it is
# not logged." What the ledger cannot check is whether the demonstration
# actually fails: a string is a string, and an agent under pressure can
# type a command that passes and call it a proof. This script closes
# that gap mechanically — it runs `--demonstration` first and refuses,
# exit 1, unless the command exits non-zero. A passing demonstration
# proves nothing and is not logged.
#
# `--reproduced no` is the one deliberate exception, for a finding an
# agent is confident is real but cannot get to reproduce reliably
# (flaky, environment-sensitive, timing-dependent) — without it, that
# finding was simply lost: never logged at all, because the must-fail
# check above has no reliable pass/fail signal to check. `--demonstration`
# is still required with `--reproduced no` — it must still be a real
# reproduction script or command, an agent's own best-effort attempt,
# saved as actual runnable code — but it is not run, and is checked only
# for looking like runnable code rather than prose (`looks_runnable?`,
# below). Default remains `yes`, unchanged: every ordinary bug still
# demands a demonstration that actually fails.
#
# **It also mints the number**. Picking the next Bug number by reading
# `Bug.All` and adding one, as `.claude/skills/hecks_qa/SKILL.md` once
# instructed, is a race: a real BUG#21 was assigned twice this way, by two
# agents each reading the same highest number before the other's `Log`
# landed. `next_reference` below reads the
# highest `sequence` over `Bug.All` and takes the next one, then walks
# forward past any reference somehow already on file — so a collision
# on the reference is a refusal (`AlreadyExists`) this script retries
# by minting again, never a silent double-assignment.
#
# **And it records the judgment**. `--triage self_contained|bigger` is the
# one call "On a surprising check" always asked an agent to make and
# never asked it to write down; `Bug.Triage` is dispatched right after
# `Log`, so the bug reaches the ledger already carrying it and
# `Bug.Untriaged`/`BugsByDisposition` can say how much judgment is
# still owed.
#
#   bin/qa_log_bug --sweep <sweep-id> --title "…" \
#     --demonstration "bundle exec rspec spec/x_spec.rb -e 'the case'" \
#     --symptom "…" --expectation "…" --submitter "<who>" \
#     --triage self_contained|bigger [--tag word]… [--reproduced yes|no]
#
# **Exit codes**:
#   0  logged — the minted reference is the last line of stdout
#      (`logged BUG#n …`), for a caller to read back.
#   1  refused — the demonstration passed (or, with `--reproduced no`,
#      does not look like a runnable script/command), an argument is
#      missing, the sweep does not exist, or the ledger would not boot.
#      Nothing was written.
#
# **What this deliberately does not do**: decide whether a surprise is a
# real bug (that judgment happens before this is ever run), write the
# failing test, fix anything, or open a PR (`bin/qa_open_pr`).

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
# ADR 0033 — see bin/run's own identical require: the era/lineage
# subsystem no longer loads with core, and this ledger's `persisted_by
# "PostgresEra"` binding needs it explicitly.
require "hecks/ports/persistence/plugins/era"
require "open3"

ROOT = File.expand_path("..", __dir__)
# `QA_SWEEP_DOMAIN_DIR` — the same escape hatch `bin/qa_sweep` has, for
# the same one reason (read that script's own comment by the constant):
# a spec drives this real script against a disposable fixture ledger.
DOMAIN_DIR = ENV.fetch("QA_SWEEP_DOMAIN_DIR", File.join(ROOT, "qa/bluebook"))

EXIT_OK      = 0
EXIT_REFUSED = 1

USAGE = "usage: bin/qa_log_bug --sweep <sweep-id> --title \"…\" --demonstration \"<command that must FAIL>\" " \
        "--symptom \"…\" --expectation \"…\" --submitter \"<who>\" --triage self_contained|bigger " \
        "[--tag word]… [--reproduced yes|no]".freeze

DISPOSITIONS = %w[self_contained bigger].freeze
REPRODUCED   = %w[yes no].freeze

options = { tags: [], reproduced: "yes" }
until ARGV.empty?
  arg = ARGV.shift
  case arg
  when "-h", "--help"
    puts USAGE
    exit EXIT_OK
  when "--sweep", "--title", "--demonstration", "--symptom", "--expectation", "--submitter", "--triage",
       "--reproduced"
    value = ARGV.shift
    abort "#{USAGE}\n#{arg} needs a value" if value.nil? || value.empty?
    options[arg.delete_prefix("--").to_sym] = value
  when "--tag"
    value = ARGV.shift
    abort "#{USAGE}\n--tag needs a word" if value.nil? || value.empty?
    options[:tags] << value
  else
    abort "#{USAGE}\nunexpected argument: #{arg.inspect}"
  end
end

%i[sweep title demonstration symptom expectation submitter triage].each do |key|
  abort "#{USAGE}\n--#{key} is required" unless options[key]
end
unless DISPOSITIONS.include?(options[:triage])
  abort "#{USAGE}\n--triage must be one of #{DISPOSITIONS.join('|')}, got #{options[:triage].inspect}"
end
unless REPRODUCED.include?(options[:reproduced])
  abort "#{USAGE}\n--reproduced must be one of #{REPRODUCED.join('|')}, got #{options[:reproduced].inspect}"
end

# ── does `--demonstration` look like code, not prose? ──────────────────
#
# Only meaningful when the must-fail check below is skipped (`--reproduced
# no`) — the must-fail check itself is a far stronger proof that the
# string is real runnable code (it ran it), so this only needs to run on
# the path that never executes the string at all. A real path already on
# disk (a saved spec/script — `tmp/qa-repro-attempts/…`, or a file the
# fix work will carry alongside it) or a line that plainly launches a
# command (`bundle exec …`, `bin/…`, `./…`, a bare interpreter, or a
# direct `Hecks::Fuzzing::Replay.call` snippet) both count; a sentence
# describing what happened does not.
#
# @param str [String] the `--demonstration` value to inspect
# @return [Boolean] true if `str` looks like a real file path or a
#   shell/ruby/etc. invocation, rather than a sentence of prose
def looks_runnable?(str)
  first = str.to_s.strip.split(/\s+/).first.to_s
  return true if first.start_with?("/") && File.exist?(first)
  return true if File.exist?(File.expand_path(first, ROOT))
  return true if first.match?(%r{\A(bundle|bin/|\./|rspec|ruby|sh|bash|zsh|python3?|node|cargo)\b})
  return true if str.match?(/\.(rb|sh|py|rs|js)\b/)
  return true if str.include?("Hecks::Fuzzing::Replay")

  false
end

# ── run the demonstration, and refuse a passing one ────────────────────
#
# The one thing the ledger cannot check, checked here — unless
# `--reproduced no` says there is no reliable signal to check. Run
# through `sh -c` exactly the way a human would paste it, from the
# repository root, with its output captured and its tail printed either
# way — a refusal should show why the command passed, and a logged bug
# should show the failure it is being logged with.
if options[:reproduced] == "no"
  unless looks_runnable?(options[:demonstration])
    abort "#{USAGE}\nrefused: --demonstration doesn't look like a runnable script or command — " \
          "#{options[:demonstration].inspect}\n" \
          "with --reproduced no there is no pass/fail signal to check, but the demonstration must still be " \
          "real, saved, runnable code (a file path or a shell/ruby invocation), never prose describing what " \
          "happened. Nothing was logged."
  end
  puts "reproduced=no — skipping the must-fail check (no reliable pass/fail signal for this finding)"
  puts "demonstration (best-effort, not run): #{options[:demonstration]}"
else
  demo_out, demo_status = Open3.capture2e("sh", "-c", options[:demonstration], chdir: ROOT)
  tail = demo_out.lines.last(15).join

  if demo_status.success?
    puts tail
    abort "refused: the demonstration PASSED (exit 0) — #{options[:demonstration].inspect}\n" \
          "a bug is logged with the failing test that proves it; a passing command proves nothing. " \
          "Nothing was logged."
  end

  puts "demonstration failed as required (exit #{demo_status.exitstatus.inspect}):"
  puts tail
end
puts

# ── boot the ledger for real ───────────────────────────────────────────

runtime = begin
  Hecks.boot(DOMAIN_DIR)
rescue StandardError => e
  abort "the QualityControl ledger did not boot — fix the ledger itself before logging against it " \
        "(#{e.class}: #{e.message})"
end

# Queries this ledger's QualityControl domain by verb suffix, saving every
# caller from repeating the `"QualityControl::"` prefix.
#
# @param runtime [Runtime::Dispatcher] the booted QualityControl ledger
# @param name [String] the verb suffix, such as `"Bug.All"`
# @param args [Hash{Symbol => Object}] the query's declared arguments, if any
# @return [Array<Hash>] one deep-frozen Hash per matching record, as
#   `Runtime::Dispatcher#query` returns it
def q(runtime, name, **args) = runtime.query("QualityControl::#{name}", **args)

sweep = QualityControl::Sweep.find(options[:sweep])
abort "no such sweep: #{options[:sweep].inspect} — the sweep id is on bin/qa_sweep's own FOUND SOMETHING report" unless sweep

# ── mint the reference ────────────────────────────────────────────────
#
# The highest sequence on file, plus one — then forward past any
# reference that somehow already exists (a hand-typed `BUG#99` from a
# session that skipped ahead), so the minted pair is free on both the
# sequence and the reference. Re-read on every attempt: two concurrent
# minters both see the same maximum, both try the same number, and the
# loser's `Log` is refused (`AlreadyExists`) rather than landing a twin —
# `mint_and_log!` below retries from a fresh read.
#
# @param runtime [Runtime::Dispatcher] the booted QualityControl ledger to read
#   `Bug.All` from
# @return [Array(Integer, String)] the next free sequence number and its
#   `"BUG#n"` reference
def next_reference(runtime)
  rows = q(runtime, "Bug.All")
  taken = rows.map { |row| row[:reference][:value] }
  sequence = rows.map { |row| row[:sequence][:value] }.max.to_i + 1
  sequence += 1 while taken.include?("BUG##{sequence}")
  [sequence, "BUG##{sequence}"]
end

# Retries the mint-and-log dance up to three times against a live race
# with another minter (see `next_reference`, above).
#
# @param runtime [Runtime::Dispatcher] the booted QualityControl ledger to mint
#   and log against
# @param sweep [Facade::Handle] the Sweep record this bug is filed against
# @param options [Hash{Symbol => Object}] the parsed CLI options: `:title`,
#   `:demonstration`, `:symptom`, `:expectation`, `:submitter`, `:reproduced`
#   (all String), and `:tags` (Array<String>)
# @return [Facade::Handle] the newly logged Bug record
def mint_and_log!(runtime, sweep, options)
  3.times do
    sequence, reference = next_reference(runtime)
    begin
      return QualityControl::Bug.log!(
        sweep:         sweep.id,
        reference:     { value: reference },
        sequence:      { value: sequence },
        title:         { value: options[:title] },
        demonstration: { value: options[:demonstration] },
        symptom:       { value: options[:symptom] },
        expectation:   { value: options[:expectation] },
        submitter:     { value: options[:submitter] },
        reproduced:    { value: options[:reproduced] },
        **(options[:tags].empty? ? {} : { tags: options[:tags].map { |tag| { value: tag } } })
      )
    rescue Hecks::Runtime::AlreadyExists
      puts "#{reference} was taken between reading Bug.All and logging — minting again"
    end
  end
  abort "could not mint a free BUG# reference in three attempts — another minter is racing this one; run again"
end

bug = mint_and_log!(runtime, sweep, options)
bug = bug.triage!(disposition: { value: options[:triage] })

puts "logged #{bug.id} (sequence #{bug.sequence.value}, #{bug.disposition.value}, " \
     "reproduced=#{bug.reproduced.value}) against #{sweep.id}: #{options[:title]}"
exit EXIT_OK
