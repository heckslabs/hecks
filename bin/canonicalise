#!/usr/bin/env ruby

# Sorts a JSON document's object keys, recursively — key order is not
# semantics, so a diff a human reads should not have to notice it moved.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("canonicalise")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/canonical_json"

puts Hecks::CanonicalJson.pretty(File.read(ARGV.fetch(0)))
