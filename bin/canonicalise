#!/usr/bin/env ruby

# Sorts a JSON document's object keys, recursively.
# The body lives in lib/hecks/cli/canonicalise.rb; this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("canonicalise")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/canonicalise"

exit(Hecks::CLI::Canonicalise.call(ARGV))
