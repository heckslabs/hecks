#!/usr/bin/env ruby

# Checks Rust comments against docs/COMMENT_STYLE_GUIDE_RUST.md, fixing the
# mechanical categories with --fix. Not a CI gate; run by hand.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("standardize_comments_rust")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/tools"

Hecks::Tools.script("standardize_comments_rust", ARGV)
