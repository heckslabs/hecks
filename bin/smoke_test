#!/usr/bin/env ruby

# Boots a real domain and dispatches one synthesized call per declared
# command and per declared report, catching bugs static analysis alone
# cannot see (unlike `bin/model_check`, which never dispatches). Every
# failure is collected and reported together, not just the first.
#
# Proves nothing crashes, not that an answer is right: a call that
# dispatches cleanly but answers wrong will not be caught here.
#
# Needs a real `.hecksagon`/`.world` bound to a real adapter; a bare
# `.bluebook` has nothing to dispatch commands against.

# The logic is `Hecks::CLI::SmokeTest` (lib/hecks/cli/smoke_test.rb), which
# `hecks smoke_test` also runs.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("smoke_test")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/smoke_test"

Hecks::CLI::SmokeTest.call(ARGV, root: File.expand_path("..", __dir__))
