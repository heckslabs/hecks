#!/usr/bin/env ruby

# Generates the two capability enums the hand-written Rust kernel
# (rust/src/kernel/attribute_shapes/*.rs, rust/src/kernel/
# expression_operators/*.rs) is matched against — read this alongside
# bin/project_rust's own header, which generates the domain-specific
# side of the same crate from a bluebook's canonical IR. This generates
# the language-level side: not "what commands does Pizzas declare" but
# "what attribute shapes and expression operators does the Ruby grammar
# itself admit, that every generated domain's hand-written kernel floor
# has to interpret correctly no matter which domain is compiled in."
#
# Two ground truths, read rather than restated, exactly the way
# bin/project_rust's own header insists on for the domain side:
#
#   attribute shapes  <- Hecks::Runtime::Value::Coercion::SHAPES
#                        (lib/hecks/runtime/value/coercion.rb) — the
#                        four branches `for_attribute` itself takes, named
#                        once, right where the branching happens.
#
#   expression operators <- Hecks::Grammar.admitted_operators, the
#                        same live-booted call bin/expression_projection
#                        uses to write lib/hecks/bluebook/expression/
#                        projection.json — replaying the real admission
#                        ledger through the real Expression chapter, never
#                        a hand-copied list. Grouped by `category`, the
#                        field Evaluator::PROJECTION already partitions
#                        comparison operators by (evaluator.rb:26) — this
#                        script reuses the same field for the coarser,
#                        per-interpreter-node grouping the kernel actually
#                        branches on (six comparison symbols collapse to
#                        one `Compare` node, three sign-test symbols to
#                        one `SignTest` node — see expr.rs).
#
# Writes rust/src/kernel/attribute_shapes/mod.rs and rust/src/kernel/
# expression_operators/mod.rs — the `pub mod <name>;` lines and the enum,
# together, on purpose: the individual `<name>.rs` files under each
# directory are hand-written interpretation logic (this script never
# touches them), but the roster of which names must exist is grammar-
# derived, so regenerating after a grammar change can point `pub mod` at
# a file nobody has written yet — a plain "unresolved module" compile
# error, the same class of guarantee the enum's own exhaustive match
# sites give once a human closes the gap by adding the file
# (bin/rust_kernel_coverage checks for exactly that file, mechanically).
#
# A third capability, query comparators, is deliberately not written here.
# `Hecks::QuerySpecification::Common::COMPARATORS` (lib/hecks/
# query_specification/common/comparators.rb) — `eq`/`ne`/`gt`/`gte`/`lt`/
# `lte`/`in`/`contains`, the same eight names `Vocabulary::QueryComparator`
# (language/bluebook/vocabulary.bluebook) declares — has a real kernel
# dispatch site: `rust/src/kernel/cli.rs`'s single-comparator "query" step
# (the object form) dispatches over `rust/src/kernel/query_comparators.rs`'s
# own enum; see that file's own header for the full story, including what
# still, deliberately, does not dispatch (a named/declared bluebook query,
# the string form of the same step).
#
# Because a real dispatch site exists, `query_comparators.rs` looks like
# every other hand-written file under rust/src/kernel/ rather than like
# `attribute_shapes`/`expression_operators` (a generator-owned roster plus
# hand-written interpretation files behind it): the enum and its
# interpretation are one file, hand-maintained together, the same way
# `cli.rs`/`dispatch.rs`/`repository.rs` already are. This script has
# nothing left to regenerate there without overwriting that hand-written
# dispatch logic, so it never touches `query_comparators.rs`. A ninth
# `Vocabulary::QueryComparator` name (`none_in_state`) already needed a
# human to update `QueryComparator::ALL`/`parse`/`matches`/
# `none_in_state_matches` by hand (item #9, whole-project
# table-unification survey) — the same way a ninth `AttributeShape` needs a
# human to write `rust/src/kernel/attribute_shapes/<name>.rs`. `emit_mod`
# only ever writes the roster for a capability, never its interpretation.
#
#   bin/project_kernel_capabilities

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "hecks/grammar"
require "hecks/runtime/value/coercion"
require "fileutils"
require "tempfile"

ROOT = File.expand_path("..", __dir__)

# Writes `content` to `target` through a temp file and atomic rename, so a
# reader never observes a partially written file even if the process is
# killed mid-write.
#
# @param target [String] absolute path of the file to write
# @param content [String] full file content to write
# @return [void]
def write_atomically(target, content)
  FileUtils.mkdir_p(File.dirname(target))
  Tempfile.create(File.basename(target), File.dirname(target)) do |tmp|
    tmp.write(content)
    tmp.flush
    File.rename(tmp.path, target)
  end
  puts "wrote #{target}"
end

# snake_case grammar/Ruby name -> PascalCase Rust variant name. Plain
# ASCII splitting on "_" — every name this ever sees (`SHAPES`' own
# symbols, Grammar's own `category` strings) is already a simple
# lowercase/underscore token, never anything richer.
#
# @param name [String, Symbol] the snake_case grammar or Ruby name
# @return [String] the PascalCase Rust variant name
def pascal(name)
  name.to_s.split("_").map { |part| part[0].upcase + part[1..] }.join
end

# Writes one capability's `mod.rs`: the `pub mod <name>;` line per name and
# the exhaustive enum over them, together — see this script's own header for
# why the roster and the module list are generated as one file.
#
# @param target [String] absolute path of the `mod.rs` file to write
# @param header [String] the ground-truth comment block placed above the
#   generated module declarations
# @param enum_name [String] the Rust enum's name, `"AttributeShape"` or
#   `"OperatorCategory"`
# @param names [Array<String, Symbol>] one entry per variant/module, in the
#   order they must appear
# @param doc_line [String] names the Ruby source of truth, quoted in the
#   generated enum's own doc comment
# @return [void]
def emit_mod(target, header:, enum_name:, names:, doc_line:)
  variants = names.map { |name| "    #{pascal(name)}," }.join("\n")
  mods     = names.map { |name| "pub mod #{name};" }.join("\n")

  content = <<~RUST
    // GENERATED by bin/project_kernel_capabilities from #{doc_line}.
    // Do not hand-edit — re-run bin/project_kernel_capabilities instead.
    //
    #{header}

    #{mods}

    /// One variant per real #{enum_name == 'AttributeShape' ? 'attribute shape' : 'expression-operator category'} the Ruby
    /// grammar admits, in the order #{doc_line} declares them. Every match
    /// over this enum in the kernel (rust/src/kernel/expr.rs) is written
    /// WITHOUT a wildcard `_ =>` arm — see expr.rs's own header for why:
    /// a wildcard here would let a newly-admitted capability compile
    /// silently into a router that never calls the new file this same
    /// regeneration adds a `pub mod` line for above.
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum #{enum_name} {
    #{variants}
    }

    impl #{enum_name} {
        /// The `rust/src/kernel/#{enum_name == 'AttributeShape' ? 'attribute_shapes' : 'expression_operators'}/<name>.rs` file this
        /// variant names — `bin/rust_kernel_coverage`'s own existence
        /// check reads this, so the file-name spelling here is the ONE
        /// place that ever needs to change if a name is renamed.
        pub fn module_name(&self) -> &'static str {
            match self {
    #{names.map { |name| "            #{enum_name}::#{pascal(name)} => #{name.to_s.inspect}," }.join("\n")}
            }
        }

        pub const ALL: &'static [#{enum_name}] = &[#{names.map { |name| "#{enum_name}::#{pascal(name)}" }.join(', ')}];
    }
  RUST

  write_atomically(target, content)
end

# ── Attribute shapes ──────────────────────────────────────────────────
shape_names = Hecks::Runtime::Value::Coercion::SHAPES
emit_mod(
  File.join(ROOT, "rust/src/kernel/attribute_shapes/mod.rs"),
  header:    <<~HEADER.strip,
    // Ground truth: Hecks::Runtime::Value::Coercion::SHAPES
    // (lib/hecks/runtime/value/coercion.rb) — the four branches
    // `for_attribute` itself takes, read directly rather than
    // re-derived here.
  HEADER
  enum_name: "AttributeShape",
  names:     shape_names,
  doc_line:  "Coercion::SHAPES"
)

# ── Expression operators ──────────────────────────────────────────────
# `category`, in first-appearance order over the live admission ledger —
# never alphabetized, so a re-run doesn't reshuffle variant order for no
# reason and produce a no-op-but-noisy diff.
operator_categories = Hecks::Grammar.admitted_operators.map { |op| op[:category] }.uniq
emit_mod(
  File.join(ROOT, "rust/src/kernel/expression_operators/mod.rs"),
  header:    <<~HEADER.strip,
    // Ground truth: Hecks::Grammar.admitted_operators (lib/hecks/
    // grammar.rb), the SAME live-booted call bin/expression_projection
    // uses — grouped by the `category` field Evaluator::PROJECTION already
    // partitions comparison operators by (evaluator.rb).
  HEADER
  enum_name: "OperatorCategory",
  names:     operator_categories,
  doc_line:  "Grammar.admitted_operators's own `category` field"
)

# ── **Query comparators** — no longer generated here. See this script's own
# header for the full story: rust/src/kernel/query_comparators.rs is now
# hand-maintained, with a real dispatch site, the same as every other
# hand-written file under rust/src/kernel/.
