#!/usr/bin/env ruby

# Tags the merged release commit, publishes the gem, and gets @hecks/client published to npm.
# The body lives in lib/hecks/cli/release.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("release")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/release"

exit(Hecks::CLI::Release.call(ARGV, root: File.expand_path("..", __dir__)))
