#!/usr/bin/env ruby
# frozen_string_literal: true

# Performs the release once the release PR has merged: tags the merge commit,
# publishes the gem to rubygems.org, and publishes the JavaScript client
# (@hecks/client) to npm. The logic lives in Hecks::Release::Runner; this
# script parses flags and calls it.
#
# The release PR is still hand-made (version bump, README, changelog entry, the
# client bumped to match); see "Releasing" in CONTRIBUTING.md. After it merges:
#
#   git checkout main && git pull --ff-only
#   bin/release --dry-run    # every check and build, nothing tagged or published
#   bin/release              # tag, gem, npm — asks before each irreversible step
#
# It refuses unless the checkout is a clean `main` equal to origin/main, the
# gem and packages/hecks-client are at one version, and the changelog has a
# heading for it. It asks RubyGems and npm what is already published and skips
# that, so a run that died between the gem and the package is finished by
# running it again (or `bin/release --npm-only`).
#
# Flags:
#   --dry-run    run every check, `gem build` (then delete the .gem) and
#                `npm publish --dry-run`; tag, push and publish nothing, and
#                never call `op`
#   --gem-only   skip the npm step
#   --npm-only   skip the gem step
#   --yes        answer the confirmations yes (the tag, then the publish)
#   --help       print this usage
#
# Exit status: 0 done or nothing to do, 1 a check or step failed (or a
# confirmation was declined), 2 usage error.
#
# One-time setup, outside this script. The gem side is described in
# bin/release_gem; the npm side is:
#   - npmjs.com > Access Tokens > Generate New Token > Granular Access Token,
#     with "Read and write" on packages under the @hecks scope
#   - that token stored as a concealed field named "publish token" on the npm
#     login item ("npmmjs") in the Hecks vault, next to the "RubyGems API Key"
#     item; release/npm_publish.env references it as
#     op://Hecks/npmmjs/publish token, and the vault, item or field can be
#     edited there
#   - npm is restricting tokens that bypass two-factor authentication (account
#     changes from August 2026, direct publishing from January 2027), so the
#     durable setup is a token that requires a one-time code: give the login
#     item an authenticator secret and uncomment the NPM_CONFIG_OTP line in
#     release/npm_publish.env
# The login's username and password alone cannot publish; the token field is
# what `op run` hands to npm.
#
# `op run` resolves release/npm_publish.env into `npm publish`'s environment
# only (Touch ID-gated), npm expands the token in a throwaway user config that
# holds only a placeholder, and nothing secret is printed or written.

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "optparse"
require "hecks/release/runner"

ROOT_DIR = File.expand_path("..", __dir__)

flags = { dry_run: false, gem_only: false, npm_only: false, yes: false }
parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/release [--dry-run] [--gem-only | --npm-only] [--yes]"
  opts.separator("Tags the merged release commit, then publishes the gem and @hecks/client.")
  opts.on("--dry-run", "run every check and build; tag, push and publish nothing") { flags[:dry_run] = true }
  opts.on("--gem-only", "publish the gem only") { flags[:gem_only] = true }
  opts.on("--npm-only", "publish the npm package only (resume after a partial release)") { flags[:npm_only] = true }
  opts.on("--yes", "answer the confirmations yes") { flags[:yes] = true }
  opts.on("--help", "print this usage") do
    puts opts
    exit 0
  end
end

begin
  parser.parse!(ARGV)
  raise OptionParser::InvalidArgument, ARGV.join(" ") unless ARGV.empty?

  options = Hecks::Release::Runner::Options.new(**flags)
rescue OptionParser::ParseError, ArgumentError => e
  warn "bin/release: #{e.message}"
  warn parser
  exit 2
end

exit Hecks::Release::Runner.new(root: ROOT_DIR, options: options).call
