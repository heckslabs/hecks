#!/usr/bin/env ruby

# A CODEMOD FOR ROADMAP I3 — command facts passed to `dispatch` as loose
# keyword arguments are deprecated (removed in hecks
# Hecks::Runtime::Dispatcher::LEGACY_ARGS_REMOVAL); this rewrites existing
# callers to `to:` / `with:`.
#
# TWO STEPS, because the call's text alone cannot say which loose keyword
# is the receiver's identity and which is a fact — that is the target
# command's IR (see lib/hecks/codemod/legacy_dispatch_recorder.rb):
#
#   1. Record — run whatever exercises your callers (your test suite)
#      with the recorder armed. Every loose-keyword dispatch appends how its
#      facts split to the recording:
#
#        bin/codemod_legacy_dispatch_args record -- bundle exec <your test command>
#
#      Equivalent by hand, for a runner you launch some other way:
#
#        RUBYOPT="-r$PWD/lib/hecks/codemod/legacy_dispatch_recorder.rb" \
#        HECKS_LEGACY_DISPATCH_RECORD=$PWD/tmp/legacy_dispatch_args.jsonl \
#        HECKS_DEPRECATIONS=warn <command>
#
#   2. Rewrite — a dry run prints the diff and every skipped site with its
#      reason; --write applies it:
#
#        bin/codemod_legacy_dispatch_args [--write] [--recording PATH]
#
# A call site no recorded run reached is not rewritten (and not listed):
# a warning names it the first time it runs.
#
# NOT `Hecks::Codemod::Runner` — that runner edits .bluebook source and
# proves the rewrite by re-booting and diffing the IR. The proof here is
# behavioral instead: run the same command again after --write, with the
# deprecation raising (spec/spec_helper.rb does), and it must stay green.

require "fileutils"
require "open3"
require "tempfile"

ROOT = File.expand_path("..", __dir__)
RECORDER = File.join(ROOT, "lib/hecks/codemod/legacy_dispatch_recorder.rb")
DEFAULT_RECORDING = File.join(ROOT, "tmp/legacy_dispatch_args.jsonl")

def usage!
  warn "usage: bin/codemod_legacy_dispatch_args record [--recording PATH] -- COMMAND..."
  warn "       bin/codemod_legacy_dispatch_args [--write] [--recording PATH]"
  exit 2
end

args = ARGV.dup
recording = DEFAULT_RECORDING
if (flag = args.index("--recording"))
  recording = File.expand_path(args.delete_at(flag + 1) || usage!)
  args.delete_at(flag)
end

if args.first == "record"
  separator = args.index("--") || usage!
  command = args[(separator + 1)..]
  usage! if command.empty?

  FileUtils.mkdir_p(File.dirname(recording))
  env = {
    "RUBYOPT"                      => [ENV.fetch("RUBYOPT", nil), "-r#{RECORDER}"].compact.join(" "),
    "HECKS_LEGACY_DISPATCH_RECORD" => recording,
    "HECKS_DEPRECATIONS"           => "warn"
  }
  exec(env, *command)
end

$LOAD_PATH.unshift File.join(ROOT, "lib")
require "hecks/codemod/legacy_dispatch_args"

write = args.delete("--write")
usage! unless args.empty?
abort "no recording at #{recording} — run the record step first" unless File.exist?(recording)

codemod = Hecks::Codemod::LegacyDispatchArgs
by_file = codemod.plans(recording).group_by { |(path, _), _| path }

outcomes = []
by_file.sort.each do |path, sites|
  unless File.exist?(path)
    outcomes << codemod::Outcome.new(path: path, line: 0, status: :skipped, reason: "file not found")
    next
  end

  text, file_outcomes = codemod.rewrite(path, sites.to_h { |(_, line), plan| [line, plan] })
  outcomes.concat(file_outcomes)
  next if text == File.read(path)

  if write
    File.write(path, text)
  else
    Tempfile.create(["rewritten", File.extname(path)]) do |file|
      file.write(text)
      file.flush
      diff, = Open3.capture2("diff", "-u", "--label", path, "--label", "#{path} (rewritten)", path, file.path)
      puts diff
    end
  end
end

relative = ->(path) { path.start_with?("#{ROOT}/") ? path.delete_prefix("#{ROOT}/") : path }
skipped = outcomes.select { |outcome| outcome.status == :skipped }
unless skipped.empty?
  puts "== skipped (#{skipped.size}) =="
  skipped.each { |outcome| puts "  #{relative.call(outcome.path)}:#{outcome.line} — #{outcome.reason}" }
end

rewritten = outcomes.select { |outcome| outcome.status == :rewritten }
puts "== #{write ? 'rewritten' : 'would rewrite (dry run — nothing written; pass --write)'}: #{rewritten.size} call sites =="
rewritten.group_by { |outcome| relative.call(outcome.path).split("/").first }.sort.each do |top, group|
  puts "  #{top}: #{group.size}"
end
