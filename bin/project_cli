#!/usr/bin/env ruby

# Mints a command-line binary for a domain, named after its bluebook.
#
#   bin/project_cli                    # every domain in this checkout
#   bin/project_cli qa                 # just this one
#
# `Hecks.bluebook "QualityControl"` becomes `qa/quality_control` — beside the
# domain it drives, not in `bin/` — and from
# then on:
#
#   qa/quality_control                       every verb, and every question
#   qa/quality_control bug.discover --help   what it wants, and how it refuses
#   examples/pizzas/pizzas create_pizza name=Margherita …
#
# WHAT IS GENERATED IS A LAUNCHER, NOT A CLI. Each file is a dozen lines
# pinning one directory and handing over to `Facade::CliRunner` — the surface
# still comes from `Projector.call(:cli, …)` at the moment it runs, so editing
# a chapter changes the binary's behaviour without regenerating anything. That
# is the whole reason the projection answers a SURFACE rather than a program:
# a generated dispatcher would need re-minting on every bluebook edit, and
# would be a second copy of the parse-and-dispatch besides.
#
# Re-run it when a domain is added or renamed. Nothing else.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "fileutils"

ROOT   = File.expand_path("..", __dir__)
FOLDER = Hecks::Adapters::Folder.new

def domains
  Dir.glob(File.join(ROOT, "**/*.hecksagon"))
     .map { |path| FOLDER.domain_root(File.dirname(path)) }
     .compact
     .map { |path| path.delete_prefix("#{ROOT}/") }
     .grep_v(%r{\A(rust|deploy|tmp|coverage)/})
     .uniq.sort
end

# The name comes from `Hecks.bluebook "…"`, not from the directory — a domain
# renamed with `formerly_known_as` gets a binary under its new name, and the
# directory it happens to sit in is nobody's business.
def bluebook_name(path)
  Hecks.boot(File.join(ROOT, path), install_facade: false).registry.bluebooks.keys.first
rescue StandardError => e
  warn "  #{path}: cannot boot — #{e.message.lines.first.strip}"
  nil
end

# A DOMAIN'S COMMAND LINE LIVES WITH THE DOMAIN.
#
# These used to be minted into `bin/`, which put a chapter's front door a
# directory away from the chapter, its adapters, its translations and its
# docs — so `qa/` held everything about the practice except the way anybody
# actually runs it. Beside the domain, a folder is the whole unit: hand
# somebody `qa/` and they have the tool, not a pointer to one.
#
# AND THEN EVERYTHING IS RELATIVE. The launcher sits IN the domain root, so
# the domain it boots is simply `__dir__` — no path to spell, nothing to
# re-point when a directory moves. Only `lib` is left to reach, and that is
# counted from how deep the domain sits: `qa/` is one up, `examples/pizzas/`
# is two. A checkout can be cloned anywhere and no line here knows where.
def launcher(path, name)
  snake = Hecks::Naming.snake(name)
  up    = "../" * path.count("/").succ

  <<~RUBY
    #!/usr/bin/env ruby

    # #{name}'s command line — GENERATED by bin/project_cli. Do not edit.
    #
    # A launcher, not a CLI: the verbs, their arguments and their refusals are
    # projected from the bluebook beside it every time this runs, so a change
    # to the chapter shows up here without re-minting anything.
    #
    #   #{path}/#{snake}                  every verb, and every question
    #   #{path}/#{snake} <verb> --help    what it wants, and how it refuses

    $LOAD_PATH.unshift File.expand_path("#{up}lib", __dir__)

    require "hecks"

    runtime = begin
      Hecks.boot(__dir__, install_facade: false)
    rescue StandardError => e
      abort "cannot open #{name}: \#{e.message.lines.first.strip}"
    end

    text, status = Hecks::Facade::CliRunner.call(
      runtime: runtime, argv: ARGV, program: "#{path}/#{snake}"
    )
    status.zero? ? puts(text) : abort(text)
  RUBY
end

wanted = ARGV.empty? ? domains : ARGV.map { |path| path.delete_prefix("#{ROOT}/").chomp("/") }

wanted.each do |path|
  name  = bluebook_name(path) or next
  snake = Hecks::Naming.snake(name)
  file  = File.join(ROOT, path, snake)

  File.write(file, launcher(path, name))
  FileUtils.chmod("+x", file)

  # THE OLD ADDRESS IS REMOVED, not left to rot. A stale `bin/pizzas` still
  # boots and still works, which is exactly what makes it dangerous: two
  # launchers for one chapter, and no way to tell from the outside which one
  # somebody's muscle memory is running.
  stale = File.join(ROOT, "bin", snake)
  FileUtils.rm_f(stale)

  puts "  #{path}/#{snake}  ->  #{name}"
end
