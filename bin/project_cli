#!/usr/bin/env ruby

# Mints a command-line binary for a domain, named after its bluebook and placed beside it,
# not in `bin/` (`Hecks.bluebook "QualityControl"` becomes `qa/quality_control`).
#
#   bin/project_cli                    # every domain in this checkout
#   bin/project_cli qa                 # just this one
#   qa/quality_control bug.discover --help
#
# A launcher, not a generated CLI: it dispatches to `Facade::CliRunner`, so editing a chapter
# changes behavior with no regenerating. Re-run only when a domain is added or renamed.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/project_cli"

Hecks::CLI::ProjectCli.call(ARGV, program: "bin/project_cli", root: File.expand_path("..", __dir__))
