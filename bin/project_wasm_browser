#!/usr/bin/env ruby

# Builds the rust/web wasm-bindgen crate over the generated domain code
# (rust/dist/browser/<domain>/).
#
#   bin/project_wasm_browser <domain>
#
# A shim: the work is Hecks::RustBuild (lib/hecks/rust_build/).

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_wasm_browser")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/rust_build"

exit Hecks::RustBuild.run("project_wasm_browser", ARGV)
