#!/usr/bin/env ruby

# Copies each aggregate's current state from a Heki data directory into the repository that the
# domain's `.hecksagon`/`.world` files bind today (e.g. `PostgresEra`). Domain-agnostic.

#   bin/qa_postgres_migrate <domain_dir> <heki_data_dir> [aggregate_name ...]           # dry run
#   bin/qa_postgres_migrate <domain_dir> <heki_data_dir> [aggregate_name ...] --force    # apply

# One `save` per id from `Heki#all`, not a journal replay: state is kept byte-for-byte, the
# per-append history is not. The Heki side is only read. An id the destination holds under a
# different state is always refused, so a second run is idempotent.
# Only aggregates with a `<storage_name>.heki` file in <heki_data_dir> are considered; trailing
# names (`hecks_name` or `storage_name`) narrow further.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
# The era subsystem does not load with core; a `PostgresEra` domain needs it (ADR 0033).
require "hecks/ports/persistence/plugins/era"
require_relative "../lib/hecks/adapters/driven/heki"

def usage_and_exit(message = nil)
  warn "bin/qa_postgres_migrate: #{message}" if message
  warn "usage: bin/qa_postgres_migrate <domain_dir> <heki_data_dir> [aggregate_name ...] [--force]"
  exit 1
end

force = ARGV.delete("--force")

domain_dir = ARGV.shift
usage_and_exit("no domain directory given") if domain_dir.nil?
usage_and_exit("no such domain directory #{domain_dir.inspect}") unless Dir.exist?(domain_dir)

heki_dir = ARGV.shift
usage_and_exit("no Heki data directory given") if heki_dir.nil?
usage_and_exit("no such Heki data directory #{heki_dir.inspect}") unless Dir.exist?(heki_dir)
heki_dir = File.expand_path(heki_dir)

wanted = ARGV.dup

runtime  = Hecks.boot(domain_dir)
registry = runtime.registry

# A candidate is an aggregate whose own `.heki` file exists, whatever it is bound to now.
candidates = registry.bluebooks.each_with_object([]) do |(domain_name, bluebook), all|
  bluebook.aggregates.each do |aggregate|
    next unless wanted.empty? || wanted.include?(aggregate.hecks_name) || wanted.include?(aggregate.storage_name)

    heki_path = File.join(heki_dir, "#{aggregate.storage_name}.heki")
    next unless File.exist?(heki_path)

    all << { domain_name: domain_name, aggregate: aggregate, heki_path: heki_path }
  end
end

if candidates.empty?
  puts "bin/qa_postgres_migrate: no aggregate matched #{wanted.empty? ? '(any)' : wanted.inspect} with a " \
       "corresponding .heki file under #{heki_dir}"
  exit 0
end

# Deep comparison independent of key type and hash order; only array order is meaningful.
# `spec/qa_postgres_migration_spec.rb` pins this for conflict detection.
def canonical(value)
  case value
  when Hash
    value.each_with_object({}) { |(k, v), h| h[k.to_s] = canonical(v) }.sort.to_h
  when Array
    value.map { |v| canonical(v) }
  else
    value
  end
end

migrated = []
skipped  = []
conflicts = []

candidates.each do |candidate|
  domain_name = candidate[:domain_name]
  aggregate   = candidate[:aggregate]

  # Guarded like a factory-built repository so a Heki store decodes through the state codec.
  source = Hecks::Ports::Persistence::CodecBoundary.guard!(
    Hecks::Adapters::Heki.new(aggregate: aggregate, settings: { dir: heki_dir }, root: nil)
  )
  dest = registry.repository(domain_name, aggregate)

  source.all.each do |instance|
    existing = dest.find(instance.id)

    if existing.nil?
      dest.save(instance) if force
      migrated << "#{aggregate.storage_name}/#{instance.id}"
    elsif canonical(existing.state) == canonical(instance.state)
      skipped << "#{aggregate.storage_name}/#{instance.id}"
    else
      conflicts << "#{aggregate.storage_name}/#{instance.id}"
    end
  end
end

label = force ? "MIGRATED" : "WOULD MIGRATE"
migrated.each { |id| puts "#{label} #{id}" }
skipped.each { |id| puts "SKIP #{id}: destination already holds the identical state" }
conflicts.each do |id|
  warn "REFUSED #{id}: the destination already holds a DIFFERENT state for this id — " \
       "not overwritten, --force or not. Resolve by hand (compare the two states, decide " \
       "which is authoritative) before migrating this id again."
end

puts "" unless migrated.empty? && skipped.empty? && conflicts.empty?
puts "#{force ? 'migrated' : 'would migrate'} #{migrated.size}, skipped #{skipped.size} " \
     "(already caught up), refused #{conflicts.size} (conflicting data)"
puts "re-run with --force to apply" unless force || migrated.empty?

exit(conflicts.empty? ? 0 : 1)
