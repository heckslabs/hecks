#!/usr/bin/env ruby

# Copies each aggregate's state from a Heki directory.
# The body lives in lib/hecks/quality_control/cli/qa_postgres_migrate.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_postgres_migrate")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/quality_control/cli/qa_postgres_migrate"

exit(Hecks::QualityControlCli::QaPostgresMigrate.call(ARGV))
