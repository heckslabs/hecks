#!/usr/bin/env ruby

# Runs one spec file filtered to one example, through RSpec::Core::Runner directly, so a
# `bin/qa_log_bug --demonstration` string needs no rspec `-e` quoting by hand.
#
#   bin/spec_example <spec_file> <example description substring>
#
# The exit status is RSpec's own: 0 when every example passed.

require "rspec/core"

abort "usage: bin/spec_example <spec_file> <example description substring>" if ARGV.length != 2

exit RSpec::Core::Runner.run(["--example", ARGV[1], ARGV[0]])
