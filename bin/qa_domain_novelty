#!/usr/bin/env ruby

# Does a new stress domain earn its place?
# The body lives in lib/hecks/quality_control/cli/qa_domain_novelty.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_domain_novelty")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/quality_control/cli/qa_domain_novelty"

exit(Hecks::QualityControlCli::QaDomainNovelty.call(ARGV, root: File.expand_path("..", __dir__)))
