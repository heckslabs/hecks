#!/usr/bin/env ruby

# Refreshes every read-model projection a domain declares, by hand.
# The body lives in lib/hecks/cli/refresh_projections.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/refresh_projections"

exit(Hecks::CLI::RefreshProjections.run(ARGV))
