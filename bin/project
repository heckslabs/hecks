#!/usr/bin/env ruby

# Refreshes every read-model projection a domain declares, by hand —
# the same catch-up a boot runs lazily, forced now rather than on
# first read.
#
#   bin/project <domain>

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks"
require "hecks/cli/refresh_projections"

Hecks::CLI::RefreshProjections.call(Hecks.boot(ARGV.fetch(0)))
