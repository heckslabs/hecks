#!/usr/bin/env ruby

# Checks CI for every PR the QualityControl ledger tracks as open.
# The body lives in lib/hecks/quality_control/cli/qa_pr_check.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_pr_check")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/quality_control/cli/qa_pr_check"

exit(Hecks::QualityControlCli::QaPrCheck.call(ARGV, root: File.expand_path("..", __dir__)))
