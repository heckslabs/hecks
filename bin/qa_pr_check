#!/usr/bin/env ruby

# Checks CI for every PR the QualityControl ledger tracks as open (Patch and Improvement).
# Starts a Clearance per unsettled head commit and lets the CI port's policies record the verdict.
#
#   bin/qa_pr_check
#
# Exit codes: 0 nothing to act on; 1 operational error (gh, bad sha, ledger boot);
# 2 a newly-red PR, with the details on stdout.
#
# A commit's Clearance is minted once and never re-asked; pending checks are skipped, since
# the CI port has no way to say "ask again later".

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
# The ledger's `persisted_by "PostgresEra"` binding needs the era plugin, which core does not load.
require "hecks/ports/persistence/plugins/era"
require "json"
require "open3"

ROOT       = File.expand_path("..", __dir__)
# Lets `spec/qa_tick_spec.rb` point `bin/qa_tick` at a disposable fixture ledger,
# as `bin/qa_sweep` does.
DOMAIN_DIR = ENV.fetch("QA_SWEEP_DOMAIN_DIR", File.join(ROOT, "qa/bluebook"))

EXIT_OK        = 0
EXIT_ERROR     = 1
EXIT_NEWLY_RED = 2

USAGE = "usage: bin/qa_pr_check".freeze

SHA_PATTERN = /\A[0-9a-fA-F]{7,40}\z/

unless ARGV.empty?
  if %w[-h --help].include?(ARGV.first)
    puts USAGE
    exit EXIT_OK
  end
  abort "#{USAGE}\nthis script takes no arguments — it checks every PR QualityControl::Patch or " \
        "QualityControl::Improvement tracks as open, every time"
end

# Runs `gh` and returns stdout, stderr and the status.
# With `--json`, gh exits 0 whatever the checks say, so the status only means the call succeeded.
def gh(*)
  Open3.capture3("gh", *)
end

# Only this boot binds `GithubChecks` to the CI port; other loads leave the port dormant.

runtime = begin
  Hecks.boot(DOMAIN_DIR)
rescue StandardError => e
  abort "the QualityControl ledger did not boot — fix the ledger itself before checking PRs against it " \
        "(#{e.class}: #{e.message})"
end

def q(runtime, name, **args) = runtime.query("QualityControl::#{name}", **args)

# Reads nested row fields by `[]`, because `Hecks::Runtime::Value` does not answer `Hash#dig`.
def field(row, *path)
  path.reduce(row) { |held, key| held.nil? ? nil : held[key] }
end

def clearance_for_commit(runtime, sha)
  q(runtime, "Clearance.All").find { |row| field(row, :commit, :value) == sha }
end

# Two worklists, checked the same way. The citation is what a row references: a `Bug` for a
# `Patch`, an optional `Angle` for an `Improvement`.
WORKLISTS = [
  { aggregate: "Patch",       citation_field: :bug,   citation_label: "bug" },
  { aggregate: "Improvement", citation_field: :angle, citation_label: "angle" }
].freeze

worklists = WORKLISTS.to_h { |w| [w, q(runtime, "#{w[:aggregate]}.Open")] }

if worklists.values.all?(&:empty?)
  puts "no PRs tracked as open by QualityControl::Patch or QualityControl::Improvement — nothing to check"
  exit EXIT_OK
end

# Retires a Patch/Improvement whose PR GitHub reports merged or closed; nothing else tells the
# ledger. Returns true if it retired one.
def retire_if_settled?(view, number, label, runtime, aggregate)
  case view[:state]
  when "MERGED"
    runtime.dispatch_flat("QualityControl::#{aggregate}.Merge", { id: number })
    puts "#{label}: merged — retired from the worklist"
    true
  when "CLOSED"
    runtime.dispatch_flat("QualityControl::#{aggregate}.Close", { id: number })
    puts "#{label}: closed without merging — retired from the worklist"
    true
  else
    false
  end
end

# True when every check has finished, so a verdict is worth asking for. Pending stays out here
# because the CI port cannot express "ask again later". A gh failure is appended to
# `operational_errors`.
def checks_settled?(number, label, citation, sha, operational_errors)
  checks_out, checks_err, checks_status = gh("pr", "checks", number.to_s,
                                             "--json", "name,state,bucket,workflow")
  unless checks_status.success?
    operational_errors << "#{label}: gh pr checks failed — #{checks_err.strip.empty? ? checks_out.strip : checks_err.strip}"
    return false
  end

  checks = JSON.parse(checks_out, symbolize_names: true)
  if checks.empty?
    puts "#{label}, #{citation}, #{sha[0, 7]}: gh reports no checks at all yet — skipping this run"
    return false
  end

  if checks.any? { |c| c[:bucket] == "pending" }
    puts "#{label}, #{citation}, #{sha[0, 7]}: checks still running — skipping this run"
    return false
  end

  true
end

# Checks one tracked PR, appending to `newly_red` or `operational_errors` in place.
# The live head sha is read from gh each run, since a push mints a new commit to clear.
def check_one_pr(row, runtime, newly_red, operational_errors, aggregate:, citation_field:, citation_label:)
  number   = field(row, :number, :value)
  cited    = field(row, citation_field)
  citation = cited ? "#{citation_label} #{cited}" : "no #{citation_label} cited"
  label    = "#{aggregate} PR ##{number} (#{field(row, :branch, :value)})"

  view_out, view_err, view_status = gh("pr", "view", number.to_s,
                                       "--json", "state,headRefOid,url")
  unless view_status.success?
    operational_errors << "#{label}: gh pr view failed — #{view_err.strip.empty? ? view_out.strip : view_err.strip}"
    return
  end

  view = JSON.parse(view_out, symbolize_names: true)
  return if retire_if_settled?(view, number, label, runtime, aggregate)

  sha = view[:headRefOid].to_s
  unless sha.match?(SHA_PATTERN)
    operational_errors << "#{label}: head commit #{sha.inspect} does not look like a sha — skipping"
    return
  end

  if (existing = clearance_for_commit(runtime, sha))
    puts "#{label}, #{citation}, #{sha[0, 7]}: already cleared (#{existing[:status]}) — settled once, not re-checked"
    return
  end

  return unless checks_settled?(number, label, citation, sha, operational_errors)

  ask_the_ledger(sha, label, citation, number, runtime, newly_red, aggregate: aggregate)
end

# Starts a Clearance and asks the CI port for a verdict. ClearOnPass/RefuseOnFail settle the
# record synchronously, so `find` sees it straight away; a red one is appended to `newly_red`.
def ask_the_ledger(sha, label, citation, number, runtime, newly_red, aggregate:)
  QualityControl::Clearance.start!(commit: { value: sha })
  runtime.dispatch_flat("QualityControl::Clearance.CI.Run", { commit: sha })

  cleared = QualityControl::Clearance.find(sha)
  summary = cleared.summary.to_h[:value]

  if cleared.status == "green"
    puts "#{label}, #{citation}, #{sha[0, 7]}: CLEARED — #{summary}"
    return
  end

  puts "#{label}, #{citation}, #{sha[0, 7]}: RED — #{summary}"
  newly_red << { aggregate: aggregate, pr: number, citation: citation, commit: sha, refusal: summary }
end

newly_red = []
operational_errors = []

worklists.each do |worklist, rows|
  rows.each { |row| check_one_pr(row, runtime, newly_red, operational_errors, **worklist) }
end

unless operational_errors.empty?
  puts
  puts "operational error(s):"
  operational_errors.each { |message| puts "  #{message}" }
end

if newly_red.any?
  puts
  puts "=" * 72
  puts "FOUND #{newly_red.length} NEWLY-RED PR(S) — BugCiWatch/ImprovementCiWatch already dispatched " \
       "the matching Regress for each, by aggregate."
  puts "An agent picks up the investigation from here: the same judgment"
  puts "SKILL.md's own \"on a surprising check\" section describes for a sweep's"
  puts "own find — self-contained fix with a regression test and a draft PR,"
  puts "or leave the record for something bigger. Never re-verify from this script."
  puts "=" * 72
  newly_red.each do |finding|
    puts
    puts "aggregate: #{finding[:aggregate]}"
    puts "citation:  #{finding[:citation]}"
    puts "pr:        ##{finding[:pr]}"
    puts "commit:    #{finding[:commit]}"
    puts "refusal:   #{finding[:refusal]}"
  end
  exit EXIT_NEWLY_RED
end

exit EXIT_ERROR if operational_errors.any?

puts
puts "clean — every PR QualityControl::Patch or QualityControl::Improvement tracks as open is either " \
     "already cleared, still running, or was retired this run."
exit EXIT_OK
