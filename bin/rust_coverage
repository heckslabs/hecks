#!/usr/bin/env ruby

# Reports whether each construct in a domain's IR has a routed Rust implementation.
#
#   bin/rust_coverage <domain> [--codegen=ruby|rust]
#   bin/rust_coverage --check-allowlist
#
# A shim: the work is Hecks::RustBuild (lib/hecks/rust_build/).

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("rust_coverage")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/rust_build"

exit Hecks::RustBuild.run("rust_coverage", ARGV)
