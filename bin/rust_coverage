#!/usr/bin/env ruby

# Reports whether each construct in a domain's IR has a real, routed
# implementation under rust/src/generated/<domain> (ADR 0054a).
#
#   bin/rust_coverage <domain> [--codegen=ruby|rust]
#   bin/rust_coverage --check-allowlist

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("rust_coverage")

require "fileutils"
require "json"
require "open3"
require "tmpdir"

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

GENERATED_ROOT = File.expand_path("../rust/src/generated", __dir__)

codegen_flags, positional = ARGV.partition { |arg| arg.start_with?("--codegen") }
codegen = codegen_flags.empty? ? "ruby" : codegen_flags.last.delete_prefix("--codegen=")
%w[ruby rust].include?(codegen) or abort "--codegen must be `ruby` or `rust` (got #{codegen_flags.last.inspect})"

target = positional.shift or abort "usage: bin/rust_coverage <generated-module-name> [--codegen=ruby|rust]  " \
                                   "(e.g. pizzas, banking, governance, identity)\n       " \
                                   "bin/rust_coverage --check-allowlist"

# Entity-scoped query ids at any depth (Domain::Aggregate.Entity.Query);
# mirrors domain_generator.rb's entity_query_entries.
def entity_query_ids(owner_id, entities)
  entities.flat_map do |entity|
    entity_id = "#{owner_id}.#{entity.fetch(:name)}"
    entity.fetch(:queries, []).map { |q| "#{entity_id}.#{q.fetch(:name)}" } +
      entity_query_ids(entity_id, entity.fetch(:entities, []))
  end
end

# Expected [kind, id] pairs derived from IR, independent of the manifest;
# the cross-check below compares manifest entries against this baseline.
# rubocop:disable-next Metrics/AbcSize
# rubocop:disable-next Metrics/CyclomaticComplexity
# rubocop:disable-next Metrics/PerceivedComplexity
def expected_from_ir(payload)
  domain_name = payload.fetch(:name)
  expected = []

  payload.fetch(:aggregates).each do |aggregate|
    aggregate_id = "#{domain_name}::#{aggregate.fetch(:name)}"
    expected << [:aggregate, aggregate_id]

    aggregate.fetch(:commands).each { |c| expected << [:command, "#{aggregate_id}.#{c.fetch(:name)}"] }
    aggregate.fetch(:queries).each { |q| expected << [:query, "#{aggregate_id}.#{q.fetch(:name)}"] }
    entity_query_ids(aggregate_id, aggregate.fetch(:entities)).each { |id| expected << [:query, id] }

    aggregate.fetch(:entities).each do |entity|
      entity_id = "#{aggregate_id}.#{entity.fetch(:name)}"
      expected << [:entity, entity_id]
      entity.fetch(:commands).each { |c| expected << [:entity_command, "#{entity_id}.#{c.fetch(:name)}"] }
    end

    aggregate.fetch(:ports).each do |port|
      port.fetch(:operations).each do |op|
        expected << [:port_operation, "#{aggregate_id}.#{port.fetch(:name)}.#{op.fetch(:name)}"]
      end
    end
  end

  payload.fetch(:read_models).each { |rm| expected << [:read_model, "#{domain_name}::#{rm.fetch(:name)}"] }
  payload.fetch(:policies).each { |p| expected << [:policy, "#{domain_name}::#{p.fetch(:name)}"] }
  payload.fetch(:process_managers).each { |pm| expected << [:process_manager, "#{domain_name}::#{pm.fetch(:name)}"] }

  # `.fetch(:lineage, {})`, not a bare fetch: an ir.json regenerated
  # before this key existed has none, and that means "nothing to
  # expect," not a KeyError.
  payload.fetch(:lineage, {}).fetch(:capable_aggregates, []).each do |aggregate|
    expected << [:lineage_aggregate, "#{domain_name}::#{aggregate.fetch(:name)}"]
  end

  expected
end

# Parses a generated module's ir.json and manifest.json, adding a
# synthetic `unaccounted` finding for any IR construct the manifest omits.
def coverage_findings(mod_dir)
  ir_path = File.join(mod_dir, "ir.json")
  File.exist?(ir_path) or abort "#{ir_path}: missing — this generated tree predates ir.json (bin/project_rust " \
                                "writes it now); re-run bin/project_rust for this domain"
  ir = JSON.parse(File.read(ir_path), symbolize_names: true)

  manifest_path = File.join(mod_dir, "manifest.json")
  File.exist?(manifest_path) or abort "#{manifest_path}: missing — re-run bin/project_rust for this domain to write it"
  manifest = JSON.parse(File.read(manifest_path), symbolize_names: true)

  [ir, manifest + unaccounted_findings(ir, manifest)]
end

# Deliberate, documented gaps only, matched by kind + gap_class +
# construct (never regex over `reason` prose) — shrink-only, so
# `--check-allowlist` fails once a rule excuses no gap anywhere.
ALLOWLIST = [].freeze

# Whether an allowlist rule's kind/gap_class/construct triple matches a
# finding's own.
def allowlist_rule_matches?(rule, finding)
  rule[:kind] == finding[:kind].to_s &&
    rule[:gap_class] == finding[:gap_class].to_s &&
    rule[:construct] == finding[:construct].to_s
end

# The first `ALLOWLIST` rule that excuses a finding, if any.
def allowlisted(finding) = ALLOWLIST.find { |rule| allowlist_rule_matches?(rule, finding) }

# Synthetic `unaccounted` finding for each expected [kind, id] pair with
# no manifest entry at all — a gap in the manifest-writer itself.
def unaccounted_findings(payload, manifest)
  manifest_ids = manifest.each_with_object(Hash.new do |h, k|
    h[k] = Set.new
  end) { |entry, index| index[entry[:kind].to_sym] << entry[:id] }
  expected_from_ir(payload).reject { |kind, id| manifest_ids[kind].include?(id) }.map do |kind, id|
    { kind: kind.to_s, id: id, generated: false, gap_class: "unaccounted", construct: "unaccounted",
      reason: "expected per ir.json, but manifest.json has NO entry for it at all — not even a " \
              "recorded skip; the generator's own accounting missed this construct entirely" }
  end
end

# Whether a finding is a real functional gap: not generated, or
# generated but unrouted.
def functional_gap?(finding) = finding[:generated] == false || finding[:routed] == false

# The shrink-only check: every rule must still excuse a real gap
# somewhere under rust/src/generated/; nothing else runs here.
if target == "--check-allowlist"
  all_gaps = Dir.glob(File.join(GENERATED_ROOT, "*/ir.json")).flat_map do |ir_path|
    coverage_findings(File.dirname(ir_path))[1].select { |finding| functional_gap?(finding) }
  end
  stale = ALLOWLIST.reject { |rule| all_gaps.any? { |finding| allowlist_rule_matches?(rule, finding) } }
  if stale.empty?
    puts "bin/rust_coverage --check-allowlist: all #{ALLOWLIST.size} rules still excuse a real gap"
    exit 0
  end
  stale.each do |rule|
    warn "STALE ALLOWLIST RULE: #{rule.slice(:kind, :gap_class, :construct)} matches no gap in any generated " \
         "module — the gap it excused is gone; delete the rule"
  end
  exit 1
end

domain  = target
mod_dir = File.join(GENERATED_ROOT, domain)
Dir.exist?(mod_dir) or abort "#{mod_dir}: no such generated module — run bin/project_rust first, or check " \
                             "rust/src/generated/ for the actual directory name"
# Regenerates this domain's manifest via hecks-codegen into a scratch
# dir. `cargo run`, not a hardcoded target/debug path, so
# CARGO_TARGET_DIR and rust-toolchain.toml are honored.
if codegen == "rust"
  ir_path = File.join(mod_dir, "ir.json")
  File.exist?(File.join(mod_dir, "manifest.json")) or abort "#{mod_dir}: no committed manifest.json — re-run " \
                                                            "bin/project_rust for this domain to write it"
  scratch = Dir.mktmpdir("rust-coverage-codegen-")
  at_exit { FileUtils.rm_rf(scratch) }
  codegen_dir = File.expand_path("../rust/codegen", __dir__)
  out_dir = File.join(scratch, domain)
  output, status = Open3.capture2e("cargo", "run", "--quiet", "--", "domain", ir_path, domain, domain, out_dir,
                                   chdir: codegen_dir)
  status.success? or abort "hecks-codegen domain failed for #{domain}:\n#{output}"
  # `hecks-codegen domain` writes no ir.json sidecar; the cross-check reads
  # the same committed IR the generator was just handed.
  FileUtils.cp(ir_path, File.join(out_dir, "ir.json"))
  mod_dir = out_dir
end

ir, findings = coverage_findings(mod_dir)

# IMPLEMENTED requires both generated and routed (where routing applies);
# a `dispatch_*` that compiles but nothing can call is not "working," so
# `routed: false` buckets like `generated: false`.
implemented, remainder = findings.partition { |f| f[:generated] && f[:routed] != false }
deferred, gap          = remainder.partition { |f| allowlisted(f) }

# Prints one report section: a labeled count, then each entry's kind,
# id, gap class, and reason.
def print_bucket(label, entries)
  puts "\n#{label} (#{entries.size})"
  entries.sort_by { |e| [e[:kind].to_s, e[:id]] }.each do |e|
    line = "  [#{e[:kind]}] #{e[:id]}"
    line += " (#{e[:gap_class]})" if e[:gap_class]
    puts line
    puts "      #{e[:reason]}" if e[:reason]
  end
end

puts "=" * 72
puts "bin/rust_coverage #{domain}  (source: manifest.json)"
puts "=" * 72
puts "#{ir.fetch(:name)} — #{findings.size} constructs accounted for " \
     "(#{implemented.size} implemented, #{deferred.size} deferred, #{gap.size} GAP)"

print_bucket("IMPLEMENTED", implemented) unless implemented.empty?

puts "\nDEFERRED (#{deferred.size}) — on the allowlist, with its cited reason"
deferred.sort_by { |e| [e[:kind].to_s, e[:id]] }.each do |e|
  rule = allowlisted(e)
  puts "  [#{e[:kind]}] #{e[:id]}"
  puts "      allowlist: #{rule[:doc]}"
end

puts "\nGAP (#{gap.size}) — missing, and NOT on the allowlist: a real, actionable finding"
gap.sort_by { |e| [e[:kind].to_s, e[:id]] }.each do |e|
  line = "  [#{e[:kind]}] #{e[:id]}"
  line += " (#{e[:gap_class]})" if e[:gap_class]
  puts line
  puts "      #{e[:reason]}" if e[:reason]
end

puts
exit(gap.empty? ? 0 : 1)
