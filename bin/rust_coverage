#!/usr/bin/env ruby

# THE COVERAGE CHECKER — a different question than bin/rust_conformance
# asks, deliberately, not a replacement for it.
#
# bin/rust_conformance is an EQUIVALENCE checker: it runs the SAME script
# through Ruby and through the generated Rust artifact and diffs the
# output byte-for-byte. That is exactly the right tool for "did these two
# things agree?" — but it is structurally blind to a whole CLASS of gap:
# a construct the generator never emits anything for at all has no case in
# the corpus to disagree about, so it never shows up as a mismatch. A
# NAMED/declared query outside `rust/project/queries.rb`'s own generated
# subset is the standing example TODAY (a real, non-empty subset now
# genuinely does execute — spec/corpus/rust_conformance/named_queries.json
# proves it byte-for-byte) — `rust/src/kernel/cli.rs` still refuses
# anything that subset doesn't cover, which means a corpus script
# containing one of THOSE query steps either never gets written in the
# first place, or gets written and both sides just... agree to refuse it.
# Either way, conformance stays green. The gap is real; the equivalence
# harness simply cannot see it, by design, because there is nothing on
# the Rust side to compare Ruby's answer against.
#
# This tool asks the other question: for a domain's canonical Bluebook IR
# (the same JSON `bin/ir <domain>` prints), walk EVERY construct it
# declares and ask "does `bin/project_rust`'s generated output for this
# domain actually have a real implementation of this, or not?" — a
# COVERAGE question, answerable even when there is no runnable comparison
# to make. It reports three buckets:
#
#   IMPLEMENTED  generated, and reachable via kernel/cli.rs's JSON router
#   DEFERRED     missing, but on the allowlist below with a cited reason
#                (a KNOWN, deliberate gap — see ALLOWLIST's own header)
#   GAP          missing, and NOT on the allowlist — a real, actionable
#                finding; exits non-zero so this can gate CI later
#
# TWO KINDS OF "missing," and this tool is honest about which is which
# (`gap_class` on every finding, sourced from the manifest itself — see
# rust/project/domain_generator.rb's `manifest_entry` for the full
# argument):
#
#   "whole_kind"    an entire CONSTRUCT KIND has no code path in the
#                   generator at all, for any domain — `query` and
#                   `read_model` are the two known examples today. Loud
#                   by nature: nothing named "query" or "read_model" ever
#                   quietly slips through, because NOTHING of that kind
#                   ever generates, for anyone, ever. Low-risk to miss.
#   "per_instance"  the construct kind mostly works — nine sibling
#                   commands on the same aggregate generate correctly —
#                   but THIS declared instance individually failed one of
#                   the generator's own named checks (an unsupported
#                   `then_set` shape, an identity `extract_id` can't
#                   resolve, ...). This is the dangerous kind: it is
#                   exactly the sort of thing that's easy to stop
#                   noticing once the loud "whole_kind" gaps are already
#                   priced in. This tool reports both, but flags which is
#                   which so a reader doesn't have to guess.
#
# SOURCE OF TRUTH — two modes, and this run tells you which one it used:
#
#   Manifest mode (preferred). `bin/project_rust` itself now writes
#   `rust/src/generated/<domain>/manifest.json` — one entry per construct
#   it made a generate/skip decision about, written by the SAME code that
#   made the decision, at the moment it made it. This is ground truth,
#   not a reconstruction: nothing here has to guess why a command didn't
#   route by re-deriving the generator's own logic a second time.
#
#   Fallback mode. If a domain's own `manifest.json` doesn't exist (an
#   older generated tree, or a domain whose Bluebook source doesn't even
#   live in this checkout — Embryonaut's does not; its own hecksagon
#   lives in a separate repository this branch merely references — so
#   `bin/project_rust` can't be re-run here to produce one), this tool
#   falls back to regex-scanning the domain's own already-generated
#   `registry.rs` for the exact quoted verb strings `rust/project/
#   registry.rb`'s `emit_registry` writes as match-arm keys
#   (`"Domain::Aggregate.Command" => { ... }`). This is REAL, WORKING
#   fallback — good enough to answer "is this specific verb routable" —
#   but strictly less trustworthy than the manifest: it can only see
#   what's PRESENT, never WHY something is absent (no per-instance
#   reason text survives regex-scanning generated source the way it
#   survives being written down at decision time), and it cannot verify
#   policy/process-manager routing at all (their own generated table
#   carries no policy/PM *name*, only event/target-verb data — see
#   `derive_manifest_from_source`'s own note). Findings produced this way
#   say so explicitly in their own `reason` text.
#
#   bin/rust_coverage <domain>
#
# `<domain>` is a directory name under rust/src/generated/ — "pizzas",
# "banking", "embryonaut", "governance", "identity", "meta" — whichever
# this checkout has actually generated (see rust/src/generated/ itself
# for the current list; `merged.rs`'s presence marks an independently
# selectable domain rather than a shared framework chapter, the same
# distinction bin/project_rust's own root mod.rs comment draws).

require "json"

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

#   bin/rust_coverage --check-allowlist
#
# fails when an ALLOWLIST rule (below) matches no gap in ANY generated
# module under rust/src/generated/ — the allowlist is shrink-only, so a
# rule whose gap was closed must be deleted, not left to excuse a future one.

GENERATED_ROOT = File.expand_path("../rust/src/generated", __dir__)

target = ARGV.shift or abort "usage: bin/rust_coverage <generated-module-name>  " \
                             "(e.g. pizzas, banking, embryonaut, governance, identity)\n       " \
                             "bin/rust_coverage --check-allowlist"

# ENTITY-SCOPED QUERY IDS, at any depth — `Domain::Aggregate.Entity.Query`.
# Mirrors domain_generator.rb's `entity_query_entries`, which records each
# one as a whole-kind gap.
def entity_query_ids(owner_id, entities)
  entities.flat_map do |entity|
    entity_id = "#{owner_id}.#{entity.fetch(:name)}"
    entity.fetch(:queries, []).map { |q| "#{entity_id}.#{q.fetch(:name)}" } +
      entity_query_ids(entity_id, entity.fetch(:entities, []))
  end
end

# ── EXPECTED CONSTRUCTS, DERIVED DIRECTLY FROM IR — independent of
# whatever the manifest (or the fallback deriver) says about itself. This
# is what makes the cross-check below possible: a construct that's
# expected per the IR but has NO manifest entry whatsoever — not even a
# `generated: false` one — is a gap in the MANIFEST-WRITER itself, the
# single most dangerous failure mode this tool can catch (a construct
# that isn't just ungenerated, but that `bin/project_rust` never even
# considered). Every finding this tool ever reports traces back to one of
# these `[kind, id]` pairs.
# A flat walk of the IR's own fixed schema — one `expected <<` per
# construct kind the IR can declare, in the shape the IR itself already
# has. Each line is already one construct kind; splitting by kind would
# not shrink any individual line, only relocate it.
# rubocop:disable-next Metrics/AbcSize
# rubocop:disable-next Metrics/CyclomaticComplexity
# rubocop:disable-next Metrics/PerceivedComplexity
def expected_from_ir(payload)
  domain_name = payload.fetch(:name)
  expected = []

  payload.fetch(:aggregates).each do |aggregate|
    aggregate_id = "#{domain_name}::#{aggregate.fetch(:name)}"
    expected << [:aggregate, aggregate_id]

    aggregate.fetch(:commands).each { |c| expected << [:command, "#{aggregate_id}.#{c.fetch(:name)}"] }
    aggregate.fetch(:queries).each { |q| expected << [:query, "#{aggregate_id}.#{q.fetch(:name)}"] }
    entity_query_ids(aggregate_id, aggregate.fetch(:entities)).each { |id| expected << [:query, id] }

    aggregate.fetch(:entities).each do |entity|
      entity_id = "#{aggregate_id}.#{entity.fetch(:name)}"
      expected << [:entity, entity_id]
      entity.fetch(:commands).each { |c| expected << [:entity_command, "#{entity_id}.#{c.fetch(:name)}"] }
    end

    aggregate.fetch(:ports).each do |port|
      port.fetch(:operations).each do |op|
        expected << [:port_operation, "#{aggregate_id}.#{port.fetch(:name)}.#{op.fetch(:name)}"]
      end
    end
  end

  payload.fetch(:read_models).each { |rm| expected << [:read_model, "#{domain_name}::#{rm.fetch(:name)}"] }
  payload.fetch(:policies).each { |p| expected << [:policy, "#{domain_name}::#{p.fetch(:name)}"] }
  payload.fetch(:process_managers).each { |pm| expected << [:process_manager, "#{domain_name}::#{pm.fetch(:name)}"] }

  # `payload[:lineage]` — a BINDING fact (Projector::Exporter.lineage's own
  # header), not part of `[:aggregates]`'s own canonical shape, so it's
  # its own top-level key rather than a field on each aggregate above.
  # `.fetch(:lineage, {})` — not a bare `.fetch(:lineage)` — because a
  # domain regenerated before this key existed (a stale checked-in
  # payload.json this checkout can't refresh, e.g. Embryonaut's) simply has
  # none, and that must read as "nothing to expect here," never a
  # KeyError this tool's own manifest cross-check would otherwise raise
  # on.
  payload.fetch(:lineage, {}).fetch(:capable_aggregates, []).each do |aggregate|
    expected << [:lineage_aggregate, "#{domain_name}::#{aggregate.fetch(:name)}"]
  end

  expected
end

# ONE AGGREGATE'S OWN MANIFEST ROWS — pulled out of derive_manifest_from_source
# because everything it computes (aggregate_id/aggregate_file/
# aggregate_generated) is scoped to this one aggregate and used nowhere
# else in the method; the four `each` walks below it (commands, entities,
# ports, queries) are its own nested constructs, not shared with any
# OTHER aggregate's rows.
def aggregate_manifest_rows(domain_name, aggregate, mod_dir, routed_verbs)
  aggregate_id = "#{domain_name}::#{aggregate.fetch(:name)}"
  aggregate_file = File.join(mod_dir, "#{aggregate.fetch(:name).downcase}.rs")
  aggregate_generated = File.exist?(aggregate_file)

  rows = [aggregate_row(aggregate_id, aggregate_file, aggregate_generated, mod_dir)]
  aggregate.fetch(:commands).each { |command| rows << command_row(aggregate_id, command, routed_verbs) }
  aggregate.fetch(:entities).each { |entity| rows.concat(entity_rows(aggregate_id, entity, aggregate_generated, routed_verbs)) }
  aggregate.fetch(:ports).each { |port| rows.concat(port_rows(aggregate_id, port, routed_verbs)) }
  aggregate.fetch(:queries).each { |query| rows << query_row(aggregate_id, query) }
  entity_query_ids(aggregate_id, aggregate.fetch(:entities)).each do |id|
    rows << query_row(id.rpartition(".").first, { name: id.rpartition(".").last })
  end
  rows
end

def aggregate_row(aggregate_id, aggregate_file, aggregate_generated, mod_dir)
  {
    kind: "aggregate", id: aggregate_id, generated: aggregate_generated,
    **(if aggregate_generated
         {}
       else
         { gap_class: "per_instance", construct: "fallback_unverified",
           reason:    "fallback mode: no #{File.basename(aggregate_file)} found " \
                      "under #{mod_dir}" }
       end)
  }
end

def command_row(aggregate_id, command, routed_verbs)
  verb = "#{aggregate_id}.#{command.fetch(:name)}"
  routed = routed_verbs.include?(verb)
  {
    kind: "command", id: verb, generated: routed, routed: routed,
    **(if routed
         {}
       else
         { gap_class: "per_instance", construct: "fallback_unverified",
           reason:    "fallback mode: no \"#{verb}\" match arm in registry.rs — this checkout " \
                      "can't re-run bin/project_rust for this domain to get a real manifest, so " \
                      "this only says the verb isn't ROUTED; it can't say whether a dispatch_* " \
                      "function exists but is merely unrouted, or was never generated at all" }
       end)
  }
end

def entity_rows(aggregate_id, entity, aggregate_generated, routed_verbs)
  entity_id = "#{aggregate_id}.#{entity.fetch(:name)}"
  rows = [{ kind: "entity", id: entity_id, generated: aggregate_generated }]
  entity.fetch(:commands).each do |command|
    verb = "#{entity_id}.#{command.fetch(:name)}"
    routed = routed_verbs.include?(verb)
    rows << {
      kind: "entity_command", id: verb, generated: routed, routed: routed,
      **(if routed
           {}
         else
           { gap_class: "per_instance", construct: "fallback_unverified",
             reason:    "fallback mode: no \"#{verb}\" match arm in registry.rs (see command's " \
                        "own fallback note above — same caveat applies)" }
         end)
    }
  end
  rows
end

def port_rows(aggregate_id, port, routed_verbs)
  port.fetch(:operations).map do |operation|
    verb = "#{aggregate_id}.#{port.fetch(:name)}.#{operation.fetch(:name)}"
    routed = routed_verbs.include?(verb)
    {
      kind: "port_operation", id: verb, generated: routed, routed: routed,
      **(if routed
           {}
         else
           { gap_class: "per_instance", construct: "fallback_unverified",
             reason:    "fallback mode: no \"#{verb}\" match arm in registry.rs" }
         end)
    }
  end
end

def query_row(aggregate_id, query)
  {
    kind: "query", id: "#{aggregate_id}.#{query.fetch(:name)}", generated: false,
    gap_class: "whole_kind", construct: "no_generated_code_path",
    reason: 'the "query" construct has no generated code path at all — matches kernel/cli.rs\'s own ' \
            'refusal for a "query" step ("query steps are not generated yet")'
  }
end

# READ MODELS/POLICIES/PROCESS MANAGERS/LINEAGE — the domain-wide (not
# per-aggregate) manifest rows, pulled out for the same reason as
# aggregate_manifest_rows just above. See the inline comments on the
# policy/process-manager and lineage rows for why each is shaped the way
# it is (UNVERIFIABLE vs. unconditionally generated).
def domain_wide_manifest_rows(domain_name, payload)
  rows = []

  rows.concat(payload.fetch(:read_models).map do |read_model|
    {
      kind: "read_model", id: "#{domain_name}::#{read_model.fetch(:name)}", generated: false,
      gap_class: "whole_kind", construct: "no_generated_code_path",
      reason: 'the "read_model" construct has no generated code path at all — a distinct construct from ' \
              '"query" (ReadModel, a cross-aggregate ask) that happens to share the same fate'
    }
  end)

  # POLICIES/PROCESS MANAGERS — deliberately reported as UNVERIFIABLE
  # rather than guessed at. `emit_policy_table`'s own generated rows
  # carry `event_name`/`event_qualifier`/`target_verb`, never the
  # policy's own declared NAME — there is no string in registry.rs this
  # fallback could match a policy's `id` against with any confidence, so
  # rather than produce a false IMPLEMENTED or a false GAP, `generated`
  # is left `nil` — this tool's own report renders that as its own
  # UNKNOWN bucket, excluded from the exit-code gate. Same reasoning for
  # process managers (the table for those carries `name` — so it COULD
  # be matched — but is kept consistent with policies here rather than
  # having only one of the two silently gain precision fallback mode
  # can't actually promise across the board).
  payload.fetch(:policies).each do |policy|
    rows << { kind: "policy", id: "#{domain_name}::#{policy.fetch(:name)}", generated: nil,
              reason: "fallback mode cannot verify policy routing from registry.rs alone (the generated " \
                      "policy table carries no policy name, only event/target-verb data) — this domain's " \
                      "real manifest.json would need bin/project_rust re-run against its own Bluebook " \
                      "source, which isn't in this checkout" }
  end
  payload.fetch(:process_managers).each do |pm|
    rows << { kind: "process_manager", id: "#{domain_name}::#{pm.fetch(:name)}", generated: nil,
              reason: "fallback mode does not attempt process-manager verification either, for " \
                      "consistency with the policy caveat above" }
  end

  # UNCONDITIONALLY generated, same as domain_generator.rb's own manifest
  # entry for this kind — not a registry.rs-routed construct at all
  # (rust/project.rb's own header: deliberately never reaches the WASM
  # kernel), so there is nothing HERE for regex-scanning to be uncertain
  # about the way a command/query verb's routing is. rust/host's
  # journal::read_lineage_head_all/_by_id + append_lineage_mutation are
  # generic over storage_name and already compiled in unconditionally —
  # true for any domain's payload.json that names one, fallback mode or not.
  payload.fetch(:lineage, {}).fetch(:capable_aggregates, []).each do |aggregate|
    rows << { kind: "lineage_aggregate", id: "#{domain_name}::#{aggregate.fetch(:name)}",
              generated: true, routed: true,
              reason: "read via rust/host's journal::read_lineage_head_all/_by_id, written via " \
                      "journal::append_lineage_mutation — both generic over storage_name, verified " \
                      "independent of this domain's own manifest.json" }
  end

  rows
end

# ── FALLBACK MANIFEST DERIVATION — see this file's own header,
# "Fallback mode." Used only when `manifest.json` doesn't exist for this
# domain. Reads the SAME quoted verb strings `emit_registry` (rust/
# project/registry.rb) writes into `registry.rs`'s own match arms —
# `"Domain::Aggregate.Command" => { ... }` for a top-level command,
# `"Domain::Aggregate.Entity.Command" => { ... }` for an entity command,
# `"Domain::Aggregate.Port.Operation" => { ... }` for a port operation —
# all three shapes are the exact same `c[:verb].inspect => {` /
# `p[:verb].inspect => {` pattern regardless of which of the three arm
# builders (`aggregate_arms`/`entity_arms`/`port_arms`) wrote them, so one
# regex covers all three.
def derive_manifest_from_source(payload, mod_dir)
  domain_name = payload.fetch(:name)
  registry_src = File.exist?(File.join(mod_dir, "registry.rs")) ? File.read(File.join(mod_dir, "registry.rs")) : ""
  routed_verbs = registry_src.scan(/^\s*"([A-Za-z0-9_:.]+)"\s*=>\s*\{/).flatten.to_set

  manifest = []
  payload.fetch(:aggregates).each do |aggregate|
    manifest.concat(aggregate_manifest_rows(domain_name, aggregate, mod_dir, routed_verbs))
  end
  manifest.concat(domain_wide_manifest_rows(domain_name, payload))
  manifest
end

# ONE GENERATED MODULE'S FINDINGS — `[ir, findings, mode]`. Every construct
# the IR declares lands in `findings` exactly once: from the manifest (or
# the fallback deriver), or as a synthetic `unaccounted` gap when neither
# recorded it (see the CROSS-CHECK note below).
def coverage_findings(mod_dir)
  ir_path = File.join(mod_dir, "ir.json")
  File.exist?(ir_path) or abort "#{ir_path}: missing — this generated tree predates ir.json (bin/project_rust " \
                                "writes it now); re-run bin/project_rust for this domain"
  ir = JSON.parse(File.read(ir_path), symbolize_names: true)

  manifest_path = File.join(mod_dir, "manifest.json")
  if File.exist?(manifest_path)
    manifest = JSON.parse(File.read(manifest_path), symbolize_names: true)
    mode = :manifest
  else
    warn "#{File.basename(mod_dir)}: no manifest.json — falling back to regex-derived coverage from registry.rs " \
         "(see this file's own \"Fallback mode\" header for exactly what that can and can't tell you)"
    manifest = derive_manifest_from_source(ir, mod_dir)
    mode = :fallback
  end

  [ir, manifest + unaccounted_findings(ir, manifest, mode), mode]
end

# ── THE ALLOWLIST — every entry here is sourced from something this
# BRANCH's own docs already say, quoted or closely paraphrased, not
# invented to make a run come back clean. Per this task's own governing
# rule: a finding only belongs here because it is ALREADY documented
# elsewhere as a deliberate deferral — never because this tool happened
# to find it missing and a clean run looked nicer. Anything genuinely new
# stays a GAP, on purpose, so it actually gets seen.
#
# Matching is STRUCTURED: `kind` + `gap_class` + `construct`, the three
# fields domain_generator.rb's `manifest_entry` writes for every recorded
# gap (the construct is set by the generator branch that made the skip —
# rust/project/skip_reason.rb). Never a regex over `reason` prose: that
# text is free to change, and a new, unclassified kind of skip must not
# slip under a familiar-sounding rule. A rule still names a general shape
# (every reference-hop query, not today's two instances), and
# `bin/rust_coverage --check-allowlist` fails the moment a rule excuses no
# gap in any generated module (spec/rust_coverage_allowlist_spec.rb), so
# the list can only shrink.
#
# REMOVED AS STALE in Phase 4 — each matched no gap in any generated module:
# the `entity_command` "entity nested two levels deep" rule (BUG#11/BUG#19
# route those commands now), and the `read_model` "out of scope for this
# generator: offset/cursor/..." rule (banking's read models all generate
# now, and the reason text it matched is no longer produced).
ALLOWLIST = [
  {
    kind:      "command",
    gap_class: "per_instance",
    construct: "optional_source",
    doc:       "rust/project/commands.rb#optional_source_mismatches — a generated Rust struct's shape is fixed at " \
               "compile time, so an optional argument feeding a field nothing else Option-wraps is skipped, loudly",
    note:      "meta's nine Bluebook::*.Declare commands (description:/provenance:/position:/...) are every instance; " \
               "no business domain in the corpus hits this shape."
  },
  {
    kind:      "query",
    gap_class: "per_instance",
    construct: "reference_hop_where",
    doc:       "rust/project/queries.rb#query_hop_plan — a SINGLE hop is generated (folded by " \
               "kernel::read_model::apply_reference_hops); a chain of more than one hop is not yet " \
               "(docs/1.0-readiness.md item 2 tracks the reference-hop gap on the Postgres side)",
    note:      "ReferralChain::Referral.FromGoodSponsors (member/sponsor/standing, two hops)."
  },
  {
    kind:      "query",
    gap_class: "whole_kind",
    construct: "entity_query",
    doc:       "rust/project/domain_generator.rb#entity_query_entries — only an aggregate's own declared queries " \
               "reach the generated QUERIES table; an entity-scoped query has no generated code path",
    note:      "Banking::Account.LedgerEntry.Reversed, ATMCard.Withdrawal.Recent, SafeDepositBox.Visit.Recent, " \
               "Chess::Game.Piece.OnBoard. First recorded in the manifest in Phase 4 — before that the fuzzer " \
               "tolerated their refusals only because it matched Rust's wording, and this tool never expected them."
  },
  {
    kind:      "query",
    gap_class: "whole_kind",
    construct: "no_generated_code_path",
    doc:       "rust/src/generated/embryonaut/registry.rs and merged.rs (own HAND-PATCHED notes, both files, right " \
               "above their empty QUERIES const)",
    note:      "Embryonaut runs in fallback mode only: its bluebook lives in a separate repository, so bin/project_rust " \
               "can't give it a manifest here, and the fallback deriver records each of its queries as having no " \
               "generated code path. Delete this rule the day that domain is regenerated with a real manifest."
  }
].freeze
# REMOVED, NOT WIDENED — the cross-domain-policy `kind: "policy"` entry
# that used to live here (matching `reason_match: /cross-domain policy/`,
# 0013's own Consequences: "omitted from the generated table entirely").
# `rust/project/reactions.rb`'s `emit_cross_domain_policy_table` now
# represents these instead of dropping them (`CrossDomainPolicyRule`,
# `kernel::orchestrate`'s own header) — `domain_generator.rb`'s manifest
# entry for EVERY policy, cross-domain or not, is `generated: true,
# routed: true` now, so no finding this rule used to match can be
# produced anymore; leaving a dead rule in place would silently stop
# testing anything the day it's removed for real, which is worse than
# just removing it now with this note explaining why.
#
# WHAT THIS TOOL CAN AND CANNOT ATTEST TO, PRECISELY: "generated and
# reachable through kernel/cli.rs's JSON router" (this file's own header)
# is now true for a cross-domain policy — `kernel::orchestrate` matches
# it exactly like a same-domain one and `kernel::cli::run` carries the
# match out as a `PendingCrossDomainReaction` in its own JSON output
# ("cross_domain_reactions"). What this tool CANNOT attest to, and never
# could — it is a codegen-coverage tool, not a live-infrastructure
# prober — is whether a REAL cross-Lambda delivery attempt (rust/host's
# `lambda_client.rs`, invoked from `dispatch::handle` after this) actually
# reaches a live target Lambda: that needs two real domains' Lambdas
# deployed and invocable, which no environment this tool runs in has.
# `rust/host/src/lambda_client.rs`'s own header states exactly what IS
# proven here (function-name computation, request-payload shape, refusal-
# vs-fault classification, all via `cargo test` against a mock
# `LambdaInvoker`) versus what remains structurally-argued-but-
# unverified-without-live-AWS (`AwsLambdaInvoker` itself). That caveat
# belongs there, not as a permanent allowlist entry here — this tool's
# own IMPLEMENTED bucket was never a claim of live-infrastructure proof
# for ANY finding in it (a generated Postgres write path isn't re-proven
# against a live database by this tool either).
# NO LONGER "STRUCTURALLY CAN'T SURFACE" — this comment used to explain
# why era/lineage-bound aggregate support had no allowlist entry: nothing
# in `ir[:aggregates]` (a current-era snapshot) ever named an aggregate's
# adapter binding, so `expected_from_ir` had no way to even enumerate it
# as a raw finding here. `Exporter.lineage` (lib/hecks/projector/
# exporter.rb) closed exactly that gap — `ir[:lineage][:capable_aggregates]`
# is now a real, exported list, `expected_from_ir`/both manifest builders
# above both walk it under `kind: "lineage_aggregate"`, and every such
# aggregate reports IMPLEMENTED: rust/host's `journal::
# read_lineage_head_all/_by_id` (read) and `journal::
# append_lineage_mutation` (write, already generic before this) cover
# ANY aggregate this list ever names, unconditionally — proven for a
# non-Member aggregate by `journal::lineage_tests::
# read_lineage_head_reads_any_aggregates_view_generically`.
#
# STILL A REAL, NAMED BOUNDARY, THOUGH — not everything era/lineage-
# shaped moved. Era MINTING, shape-diff detection, and translation-rule
# SQL compilation (`Runtime::EraGuard`/`EraTamper`, the Postgres
# adapter's own `lineage_manager/*`) stay Ruby-only, permanently, by
# architecture (ADR 0007: Rust generates code, never parses bluebook/
# translation-rule DSL source) — not a gap this tool could ever allowlist
# its way past, because there is no Rust-side construct for it to be a
# gap IN. What `lineage_aggregate` findings attest to is narrower and
# real: rust/host can READ the already-translated current head Ruby's
# own SQL compiles, and WRITE into the era Ruby's own `hecks_eras`
# names as current — not that rust/host can MINT an era or DETECT drift
# itself. rust/project.rb's own header carries the full architectural
# argument.
def allowlist_rule_matches?(rule, finding)
  rule[:kind] == finding[:kind].to_s &&
    rule[:gap_class] == finding[:gap_class].to_s &&
    rule[:construct] == finding[:construct].to_s
end

def allowlisted(finding) = ALLOWLIST.find { |rule| allowlist_rule_matches?(rule, finding) }

# ── CROSS-CHECK — every EXPECTED [kind, id] pair (derived straight from
# IR, above) that has NO manifest entry at all, in either mode, becomes
# its own synthetic finding: a gap in the manifest-writer itself, worth
# telling apart from an honestly-recorded `generated: false`. See this
# file's own header on why this is the single most dangerous case to
# miss.
def unaccounted_findings(payload, manifest, mode)
  manifest_ids = manifest.each_with_object(Hash.new do |h, k|
    h[k] = Set.new
  end) { |entry, index| index[entry[:kind].to_sym] << entry[:id] }
  expected_from_ir(payload).reject { |kind, id| manifest_ids[kind].include?(id) }.map do |kind, id|
    { kind: kind.to_s, id: id, generated: false, gap_class: "unaccounted", construct: "unaccounted",
      reason: "expected per ir.json, but #{mode == :manifest ? 'manifest.json' : 'the fallback deriver'} " \
              "has NO entry for it at all — not even a recorded skip; the generator's own accounting " \
              "missed this construct entirely" }
  end
end

def functional_gap?(finding) = finding[:generated] == false || finding[:routed] == false

# THE SHRINK-ONLY CHECK — every rule must still excuse at least one real gap
# somewhere under rust/src/generated/. Nothing else runs in this mode.
if target == "--check-allowlist"
  all_gaps = Dir.glob(File.join(GENERATED_ROOT, "*/ir.json")).flat_map do |ir_path|
    coverage_findings(File.dirname(ir_path))[1].select { |finding| functional_gap?(finding) }
  end
  stale = ALLOWLIST.reject { |rule| all_gaps.any? { |finding| allowlist_rule_matches?(rule, finding) } }
  if stale.empty?
    puts "bin/rust_coverage --check-allowlist: all #{ALLOWLIST.size} rules still excuse a real gap"
    exit 0
  end
  stale.each do |rule|
    warn "STALE ALLOWLIST RULE: #{rule.slice(:kind, :gap_class, :construct)} matches no gap in any generated " \
         "module — the gap it excused is gone; delete the rule"
  end
  exit 1
end

domain  = target
mod_dir = File.join(GENERATED_ROOT, domain)
Dir.exist?(mod_dir) or abort "#{mod_dir}: no such generated module — run bin/project_rust first, or check " \
                             "rust/src/generated/ for the actual directory name"
ir, findings, mode = coverage_findings(mod_dir)

# ── CLASSIFY — a construct only counts as IMPLEMENTED when it is BOTH
# generated AND (where the construct has a routing concept at all)
# actually reachable through kernel/cli.rs's JSON router. A `dispatch_*`
# function that compiles but that nothing can ever call is not "working"
# in any sense a coverage report should paper over, so `routed: false`
# is treated exactly like `generated: false` for bucketing purposes —
# the distinction stays visible in the reason text, not in which bucket
# it lands in.
implemented, remainder = findings.partition { |f| f[:generated] && f[:routed] != false }
unknown, remainder     = remainder.partition { |f| f[:generated].nil? }
deferred, gap          = remainder.partition { |f| allowlisted(f) }

def print_bucket(label, entries)
  puts "\n#{label} (#{entries.size})"
  entries.sort_by { |e| [e[:kind].to_s, e[:id]] }.each do |e|
    line = "  [#{e[:kind]}] #{e[:id]}"
    line += " (#{e[:gap_class]})" if e[:gap_class]
    puts line
    puts "      #{e[:reason]}" if e[:reason]
  end
end

puts "=" * 72
puts "bin/rust_coverage #{domain}  (source: #{mode == :manifest ? 'manifest.json' : 'FALLBACK — registry.rs regex scan'})"
puts "=" * 72
puts "#{ir.fetch(:name)} — #{findings.size} constructs accounted for " \
     "(#{implemented.size} implemented, #{deferred.size} deferred, #{gap.size} GAP, #{unknown.size} unknown)"

print_bucket("IMPLEMENTED", implemented) unless implemented.empty?

puts "\nDEFERRED (#{deferred.size}) — on the allowlist, with its cited reason"
deferred.sort_by { |e| [e[:kind].to_s, e[:id]] }.each do |e|
  rule = allowlisted(e)
  puts "  [#{e[:kind]}] #{e[:id]}"
  puts "      allowlist: #{rule[:doc]}"
end

# UNKNOWN FAILS THE RUN. Fallback mode can't tell whether a policy/process
# manager is routed; an unverifiable construct is not a covered one, and a
# bucket that never affects the exit code is a filter, not a partition. No
# CI-checked module produces one today (embryonaut, the only fallback-mode
# module, declares no policies or process managers).
print_bucket("UNKNOWN — fallback mode couldn't verify either way (fails the run)", unknown) unless unknown.empty?

puts "\nGAP (#{gap.size}) — missing, and NOT on the allowlist: a real, actionable finding"
gap.sort_by { |e| [e[:kind].to_s, e[:id]] }.each do |e|
  line = "  [#{e[:kind]}] #{e[:id]}"
  line += " (#{e[:gap_class]})" if e[:gap_class]
  puts line
  puts "      #{e[:reason]}" if e[:reason]
end

puts
exit(gap.empty? && unknown.empty? ? 0 : 1)
