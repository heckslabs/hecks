#!/usr/bin/env ruby
# frozen_string_literal: true

# Prints, one per line, the spec files with at least one example matching an RSpec tag filter.
# ci.yml hands the list to `parallel_rspec` instead of the whole `spec` directory.
#
# Why: given every spec file, parallel_tests ignores the runtime log unless it covers ~67% of
# them, so a tag-filtered job silently groups by file size. A dry run, not grep, picks the
# files so inherited tags, `~fuzzing` and shared examples count.

# The list is committed (.github/postgres_io_spec_files.txt). `--write FILE` refreshes it;
# `--check FILE` (CI's postgres_io_file_list job) fails on a stale list.
#
#   bin/rspec_io_parallel_files '<exclude-pattern regex>' -- --tag io --tag ~fuzzing

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("rspec_io_parallel_files")

require "json"
require "open3"

mode, list_path = ARGV.shift(2) if %w[--check --write].include?(ARGV.first)
abort "#{$PROGRAM_NAME}: #{mode} needs a file path" if mode && list_path.nil?

exclude_pattern_arg, *rest = ARGV
separator_index = rest.index("--")
abort "usage: #{$PROGRAM_NAME} '<exclude-pattern regex>' -- <rspec tag args...>" unless exclude_pattern_arg && separator_index
tag_args = rest[(separator_index + 1)..]
abort "usage: #{$PROGRAM_NAME} '<exclude-pattern regex>' -- <rspec tag args...>" if tag_args.nil? || tag_args.empty?

exclude_pattern = Regexp.new(exclude_pattern_arg)

candidates = Dir["spec/**/*_spec.rb"].grep_v(exclude_pattern).sort
if candidates.empty?
  abort "bin/rspec_io_parallel_files: found ZERO candidate spec files after applying the exclude pattern — " \
        "that's almost certainly a broken pattern or an empty checkout, not a real empty test suite. Refusing " \
        "to silently hand parallel_rspec nothing to run."
end

dry_run_cmd = ["bundle", "exec", "rspec", "--dry-run", *tag_args, "--format", "json", *candidates]
stdout_str, stderr_str, status = Open3.capture3(*dry_run_cmd)
unless status.success?
  warn stderr_str
  abort "bin/rspec_io_parallel_files: `#{dry_run_cmd.join(' ')}` exited #{status.exitstatus} — " \
        "see stderr above. Refusing to guess a file list from a failed dry run."
end

json_start = stdout_str.index('{"version"')
abort "bin/rspec_io_parallel_files: couldn't find RSpec's JSON output in the dry-run's stdout:\n#{stdout_str}" unless json_start

data = JSON.parse(stdout_str[json_start..])
files = (data["examples"] || []).map { |e| e.fetch("file_path").sub(%r{\A\./}, "") }.uniq.sort

if files.empty?
  abort "bin/rspec_io_parallel_files: #{candidates.size} candidate files, but the dry run matched ZERO examples " \
        "under `#{tag_args.join(' ')}` — that's almost certainly a broken tag filter, not a real empty set. " \
        "Refusing to silently hand parallel_rspec nothing to run."
end

warn "bin/rspec_io_parallel_files: #{files.size} of #{candidates.size} candidate files carry a matching example " \
     "(#{data['examples'].size} examples total) under `#{tag_args.join(' ')}`"

def named(heading, paths)
  "  #{heading}:\n    #{paths.join("\n    ")}"
end

case mode
when "--write"
  File.write(list_path, "#{files.join("\n")}\n")
when "--check"
  committed = File.exist?(list_path) ? File.readlines(list_path, chomp: true).reject(&:empty?) : []
  missing = files - committed
  stale = committed - files
  unless missing.empty? && stale.empty?
    warn "#{list_path} is out of date."
    warn named("carries a matching example but is not listed (would never run in the shards)", missing) if missing.any?
    warn named("listed but carries no matching example any more", stale) if stale.any?
    abort "Refresh it and commit the result:\n  " \
          "bin/rspec_io_parallel_files --write #{list_path} '#{exclude_pattern_arg}' -- #{tag_args.join(' ')}"
  end
else
  puts files
end
