#!/usr/bin/env ruby

# Prints the spec files with at least one example matching an RSpec tag filter.
# The body lives in lib/hecks/cli/rspec_io_parallel_files.rb; this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("rspec_io_parallel_files")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/rspec_io_parallel_files"

exit(Hecks::CLI::RspecIoParallelFiles.call(ARGV))
