#!/usr/bin/env ruby

# Regenerates the domain and cross-compiles it to wasm32-wasip1 (rust/dist/<domain>.wasm).
#
#   bin/project_wasm <domain>
#
# A shim: the work is Hecks::RustBuild (lib/hecks/rust_build/).

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_wasm")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/rust_build"

exit Hecks::RustBuild.run("project_wasm", ARGV)
