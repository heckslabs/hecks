#!/usr/bin/env ruby

# The WASM projector — wraps THE SAME Rust binary bin/project_rust already
# generates, rather than a second, WASM-specific implementation (decision
# docs/decisions/0012-wasm-via-wasi-stdio.md, echoing 0007's own "WASM is a
# compile target of the same generated artifact, not a separate
# implementation"). rust/src/main.rs's stdin/stdout JSON CLI contract
# (kernel/cli.rs) uses nothing but std — no filesystem, no network, no OS
# calls — so it compiles for wasm32-wasip1 completely unchanged; WASI
# implements stdin/stdout the same way a native process does. This script
# is the only thing that's new: regenerate, then cross-compile.
#
#   bin/project_wasm <domain>
#
# Produces rust/dist/<domain>.wasm — run it with `wasmtime run
# rust/dist/<domain>.wasm < script.json` (or any other WASI-preview1 host).

domain = ARGV.shift or abort "usage: bin/project_wasm <domain>"

root = File.expand_path("..", __dir__)
target_mod_name = File.basename(domain)

# SAME GENERATOR AS bin/project_rust (ADR 0054a, B3) — regeneration goes
# through `bin/project_rust`, whose default is now `hecks-build`, so the
# .wasm a `make deploy`-generated Makefile ships is built from exactly
# what the codegen drift check holds the committed tree to.
# `HECKS_RUBY_CODEGEN=1` passes through to it (temporary, until B5).
# `HECKS_PARSER`/`HECKS_CODEGEN` are deprecated no-ops here too; the
# Ruby-free equivalent is `hecks-build <domain> --wasm` (rust/build's
# `build_wasm` runs the same cross-compile steps as below).
%w[HECKS_PARSER HECKS_CODEGEN].each do |var|
  next unless ENV.key?(var)

  warn "bin/project_wasm: #{var} is deprecated and ignored — hecks-build is now the default generator (ADR 0054a)"
end

unless system("rustup target list --installed 2>/dev/null | grep -qx wasm32-wasip1")
  abort <<~MSG
    wasm32-wasip1 isn't installed for this toolchain. Install it once with:

        rustup target add wasm32-wasip1

    then re-run bin/project_wasm.
  MSG
end

puts "== regenerating rust/src/generated/ for #{domain} =="
system(File.join(root, "bin", "project_rust"), domain, exception: true)

puts "== cargo build --release --target wasm32-wasip1 =="
Dir.chdir(File.join(root, "rust")) do
  # `rustup run` rather than a bare `cargo` — a `cargo`/`rustc` earlier on
  # PATH than rustup's own shims (Homebrew installs one; found live on this
  # machine) is a DIFFERENT toolchain that never saw `rustup target add`,
  # and fails with "can't find crate for `std`" despite the target check
  # above passing (that check asks rustup, correctly; a bare `cargo build`
  # doesn't necessarily run through rustup at all).
  system("rustup", "run", "stable", "cargo", "build", "--release", "--target", "wasm32-wasip1", exception: true)
end

dist_dir = File.join(root, "rust", "dist")
require "fileutils"
FileUtils.mkdir_p(dist_dir)

built = File.join(root, "rust", "target", "wasm32-wasip1", "release", "rust.wasm")
out   = File.join(dist_dir, "#{target_mod_name}.wasm")
FileUtils.cp(built, out)

puts "wrote #{out}"
puts %(run it: wasmtime run #{out} < script.json)

# The plain-JSON sidecar domain_generator.rb writes beside metadata.rs
# — rust/host has no path dependency on this crate (see that file's
# own comment), so a Rust-native web layer reads this file at runtime
# instead. Copied alongside the .wasm artifact, not embedded in it,
# same reasoning HECKS_WASM_PATH already gets an external file rather
# than a compiled-in constant.
ir_json = File.join(root, "rust", "src", "generated", target_mod_name, "ir.json")
if File.exist?(ir_json)
  ir_out = File.join(dist_dir, "#{target_mod_name}.ir.json")
  FileUtils.cp(ir_json, ir_out)
  puts "wrote #{ir_out}"
end
