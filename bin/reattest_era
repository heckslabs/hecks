#!/usr/bin/env ruby

# Re-attests an era's held text after a digest-integrity refusal, once a human has read it.
# Refuses without --accept; each attestation (old digest, new digest, when) is logged.
# The digest is tamper-evidence against drift, not against an adversary.
#
#   bin/reattest_era <domain> <era ordinal> [--accept]

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("reattest_era")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/tools"

Hecks::Tools.script("reattest_era", ARGV)
