#!/usr/bin/env ruby

# Differential harness (ADR 0010): replays a corpus script through the Ruby interpreter
# (`Fuzzing::Replay`) and prints or diffs the JSON surface a Rust artifact must reproduce.

#   bin/rust_conformance <domain> <script.json>
#     Prints Ruby's result as JSON; saved to a file it becomes a pinned expectation.
#   bin/rust_conformance <domain> <script.json> <rust_output.json>
#     Diffs Ruby's result against another artifact's JSON for the same pair.
#   bin/rust_conformance <domain> <script.json> native|<module.wasm>|<binary>
#     Runs Rust live with the script on stdin: `native` is rust/target/{release,debug}/rust,
#     a `.wasm` path runs under `wasmtime`, an executable path runs directly.
#   bin/rust_conformance <domain> <script.json> build
#     Builds the domain's own Cargo feature (its directory basename) and runs that binary.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("rust_conformance")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "hecks/fuzzing"
require "json"
require "open3"

def run_subprocess(cmd, stdin_data)
  stdout, status = Open3.capture2(*cmd, stdin_data: stdin_data)
  abort "#{cmd.join(' ')} exited #{status.exitstatus}:\n#{stdout}" unless status.success?

  stdout
end

# HECKS_RUST_DIR names the workspace whose build to run, and CARGO_TARGET_DIR where its output
# went; unset, this checkout's rust/ and rust/target.
def rust_dir = ENV.fetch("HECKS_RUST_DIR", File.expand_path("../rust", __dir__))

def target_dir = ENV.fetch("CARGO_TARGET_DIR", File.join(rust_dir, "target"))

def native_binary
  %w[release debug]
    .map { |profile| File.join(target_dir, profile, "rust") }
    .find { |path| File.executable?(path) }
end

domain = ARGV.shift or abort "usage: bin/rust_conformance <domain> <script.json> " \
                             "[rust_output.json | native | build | path/to/binary | path/to/module.wasm]"
script = ARGV.shift or abort "usage: bin/rust_conformance <domain> <script.json> " \
                             "[rust_output.json | native | build | path/to/binary | path/to/module.wasm]"
other  = ARGV.shift

steps  = JSON.parse(File.read(script)).fetch("steps")
result = Hecks::Fuzzing::Replay.call(domain, steps)

comparable = {
  "instances" => result[:instances].transform_values { |state| JSON.parse(JSON.generate(state)) },
  "events"    => result[:events].map do |e|
    { "name" => e[:name], "aggregate" => e[:aggregate], "id" => e[:id].to_s, "payload" => JSON.parse(JSON.generate(e[:payload])) }
  end,
  "refusals"  => result[:refusals].map { |r| { "verb" => r[:verb], "error" => r[:error], "kind" => r[:kind]&.split("::")&.last } }
}

# `verb`/`ok` only, as `Hecks::Fuzzing::Differential` compares; omitted when there are none.
ruby_dry_runs = result[:dry_runs].map { |d| { "verb" => d[:verb].to_s, "ok" => d[:ok] } }
comparable["dry_runs"] = ruby_dry_runs unless ruby_dry_runs.empty?

unless other
  puts JSON.pretty_generate(comparable)
  exit 0
end

their_json =
  case other
  when "native"
    bin = native_binary or abort "no native rust binary found under rust/target/{release,debug}/rust — run " \
                                 "`cd rust && cargo build` first"
    run_subprocess([bin], File.read(script))
  when "build"
    # Built on demand because `native` runs whichever domain the crate's default feature names;
    # same `RustConformanceHelpers#build_rust_for` as `bin/qa_sweep`.
    require_relative "../spec/support/rust_conformance_helpers"
    builder = Object.new.extend(RustConformanceHelpers)
    feature = File.basename(domain.chomp("/"))
    bin = builder.build_rust_for(feature, rust_dir) or
    abort "no `#{feature}` feature in rust/Cargo.toml — run bin/project_rust #{domain} first"
    run_subprocess([bin], File.read(script))
  when /\.wasm\z/
    abort "#{other}: no such file — run bin/project_wasm #{domain} first" unless File.exist?(other)
    run_subprocess(%w[wasmtime run] + [other], File.read(script))
  when ->(path) { !path.end_with?(".json") && File.file?(path) && File.executable?(path) }
    # A pinned per-domain binary, as named by `bin/qa_sweep`'s `replay:` line.
    run_subprocess([other], File.read(script))
  else
    File.read(other)
  end

theirs = JSON.parse(their_json)

# `emitted_*` fields are Rust-only snapshot flags (ADR 0048) with no Ruby analog; strip them
# rather than compare them.
if theirs["instances"].is_a?(Hash)
  theirs["instances"].each_value do |record|
    record.reject! { |key, _| key.start_with?("emitted_") } if record.is_a?(Hash)
  end
end

# `occurred_at` is a Rust-only wall-clock stamp that two runs can never match; strip it.
if theirs["events"].is_a?(Array)
  theirs["events"].each { |event| event.delete("occurred_at") if event.is_a?(Hash) }
end

# Ad-hoc filter steps carry no kind comparison: C8.3 (docs/semantics/bluebook-semantics.md) is
# open (RuntimeError in Ruby, TypeMismatch in Rust); the message stays byte-exact.
[comparable, theirs].each do |side|
  next unless side["refusals"].is_a?(Array)

  side["refusals"].each { |r| r.delete("kind") if r.is_a?(Hash) && r["verb"].to_s.start_with?("filter ") }
end

[comparable, theirs].each do |side|
  next unless side["refusals"].is_a?(Array)

  side["refusals"].each { |r| r.delete("kind") if r.is_a?(Hash) && r["verb"].to_s.start_with?("filter ") }
end

mismatches = []

%w[instances events refusals].each do |key|
  next if comparable[key] == theirs[key]

  mismatches << "#{key}:\n  ruby:  #{comparable[key].inspect}\n  other: #{theirs[key].inspect}"
end

their_dry_runs = Array(theirs["dry_runs"]).map { |d| d.slice("verb", "ok") }
if (comparable["dry_runs"] || []) != their_dry_runs
  mismatches << "dry_runs:\n  ruby:  #{comparable['dry_runs'].inspect}\n  other: #{their_dry_runs.inspect}"
end

if mismatches.empty?
  puts "#{domain} / #{script}: matches."
  exit 0
else
  warn "#{domain} / #{script}: #{mismatches.size} mismatch(es)\n\n#{mismatches.join("\n\n")}"
  exit 1
end
