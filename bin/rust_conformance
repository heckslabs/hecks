#!/usr/bin/env ruby

# Replays a corpus script through Ruby and diffs it against a Rust artifact.
#
#   bin/rust_conformance <domain> <script.json> [rust_output.json | native | build | ...]
#
# A shim: the work is Hecks::RustBuild (lib/hecks/rust_build/).

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("rust_conformance")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/rust_build"

exit Hecks::RustBuild.run("rust_conformance", ARGV)
