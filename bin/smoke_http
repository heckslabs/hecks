#!/usr/bin/env ruby
# frozen_string_literal: true

# Signed-webhook and idempotency checks against any running HTTP service.
#
#   SMOKE_WEBHOOK_SECRET=... bin/smoke_http --url http://127.0.0.1:4322 --path /webhooks/events
#
# The body lives in lib/hecks/cli/smoke_http.rb, which Custodian's `Operation.SmokeHttp` also
# runs; this file only starts it. See `--help` for flags; each also has an env var.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("smoke_http")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/smoke_http"

exit Hecks::CLI::SmokeHttp.main(ARGV)
