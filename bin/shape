#!/usr/bin/env ruby

# Prints the storage-shape projection of a bluebook, or one era label per domain.
# The body lives in lib/hecks/cli/shape.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("shape")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/shape"

Hecks::CLI::Shape.call(ARGV)
