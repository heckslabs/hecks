#!/usr/bin/env ruby

# Generates random-but-valid command/query sequences from a domain's own IR
# (Hecks::Fuzzing::SequenceGenerator) and checks each one the way a
# single runtime actually can: replay it (Hecks::Fuzzing::Replay) and
# ask whether anything broke — an exception Replay's own per-step isolation
# didn't catch (a genuine interpreter defect, not a domain refusal), a
# declared property that doesn't hold (Hecks::Fuzzing::Properties —
# lifecycle values staying inside their declared set, saga advances
# following declared handlers), or two replays of the same steps producing
# different histories (Properties.replay_is_deterministic — the runtime
# promises nothing is minted, so this should never fire).
#
# This used to shell out to bin/parity and treat a cross-runtime SPLIT as
# the finding. That comparison was retired for a while (docs/implemented/
# rust-experiment.md — reversed 2026-08-07, Rust came back for real) —
# STALE the moment it did: a real cross-runtime differential exists again,
# `spec/rust_conformance_fuzz_spec.rb` (PRD 04), generating sequences the
# identical way this script does and diffing each one against the
# compiled Rust binary. This script's own job stays single-runtime on
# purpose (a property violation or an uncaught exception, checked here,
# needs no subprocess or second boot) — it's just no longer true that NO
# cross-runtime check exists at all; it lives in that spec now, not here.
#
# On the first finding, shrinks it (repeatedly trying to remove one step at
# a time, keeping the removal if the SAME finding still reproduces) and
# saves the result under tmp/fuzz-failures/ — small enough to actually
# debug, not just a seed number to re-run blind.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "hecks/fuzzing"
require "json"
require "tmpdir"
require "fileutils"

ROOT = File.expand_path("..", __dir__)

def write_script(steps, path, seed, domain_name)
  File.write(path, JSON.pretty_generate(
                     name:  "#{domain_name}-fuzz",
                     note:  "generated by bin/fuzz — seed #{seed}",
                     steps: steps
                   ))
end

# :clean / :property_violation / :crash.
#
# Replay.call already isolates a DOMAIN_REFUSAL or an EvaluationError PER
# STEP (the domain declining a step, recorded and not fatal) — so anything
# that still propagates out of it is, by construction, something that
# escaped that isolation : a real interpreter defect, not an expected
# refusal. That is the whole reason this needs no second-opinion
# subprocess : "did this break" is answerable from inside the one runtime.
def outcome(domain, steps, adapter = :memory)
  history = Hecks::Fuzzing::Replay.call(domain, steps, adapter: adapter)
  violations = Hecks::Fuzzing::Properties.check(history).reject { |_, result| result == true }
  return [:clean, nil] if violations.empty?

  [:property_violation, violations.map { |name, message| "#{name}: #{message}" }.join("; ")]
rescue StandardError => e
  [:crash, "#{e.class}: #{e.message}"]
end

# WHICH FINDING THIS IS, so twenty seeds that all found one bug read as one
# bug. A property violation's signature is the property's own name ; a
# crash's is the exception class — both stable across the exact values a
# shrink candidate happens to carry, which is the whole difference between
# a report and a pile.
def signature_of(message)
  return "unknown" unless message

  message.split(":").first
end

DRAW_LIMIT = 5

def fuzz_domain(domain, seeds, steps, adapter = :memory)
  domain = domain.chomp("/")
  name = File.basename(domain)
  puts "── #{name}#{" (#{adapter})" unless adapter == :memory}"

  failures = []
  clean = 0
  drawn = 0
  cap = seeds * DRAW_LIMIT

  while (clean + failures.length) < seeds && drawn < cap
    drawn += 1
    seed = drawn
    generated = begin
      Hecks::Fuzzing::SequenceGenerator.generate(domain, seed: seed, steps: steps, adapter: adapter)
    rescue Hecks::Runtime::WiringError => e
      # A `compute`/`rekey` translation rule is an era/Postgres-only
      # construct (lib/hecks/ports/persistence/plugins/era/era_check.rb)
      # — it needs a real SQL migration to interpret, so it CANNOT boot
      # under IsolatedBoot's Memory (or :sqlite) rebind, whatever adapter
      # this sweep picked; `Loader.check_compute_rules_backstop!` refuses
      # by design the moment nothing era-aware is loaded to interpret it
      # (lib/hecks/runtime/loader.rb's own comment: a loaded era plugin
      # would refuse more specifically, "...is bound to Memory" — this is
      # the same refusal, just from the plugin-free path IsolatedBoot
      # always takes). Not a bug in this domain or in fuzzing — every
      # OTHER domain in the sweep is still fuzzable, so one unfuzzable
      # domain skipping itself beats the whole sweep dying on the first
      # `compute`/`rekey` domain anyone ever adds to the corpus (examples/
      # directory is the first, closing the audit's own "no rekey
      # anywhere in the example corpus" gap — this domain is why this
      # rescue exists). Real coverage for compute/rekey stays where it
      # already lives: spec/adapters/driven/postgres_era/*_spec.rb,
      # `io: true`, against a real Postgres.
      raise unless e.message.include?("a compute/rekey rule is declared")

      :skip
    end
    if generated == :skip
      puts "   skipped — declares compute/rekey, which only an era/Postgres-bound boot can interpret " \
           "(not fuzzable under :#{adapter})"
      return true
    end
    verdict, message = outcome(domain, generated, adapter)

    if verdict == :clean
      determinism = Hecks::Fuzzing::Properties.replay_is_deterministic(domain, generated, adapter: adapter)
      if determinism == true
        clean += 1
        next
      end
      verdict = :nondeterminism
      message = determinism
    end

    failures << { seed: seed, steps: generated, verdict: verdict, message: message,
                  signature: "#{verdict}: #{signature_of(message)}" }
  end

  report(domain, name, seeds, drawn, clean, failures, adapter)
end

# One sweep at a time, trying to remove each remaining step ; keep the
# removal only when the SAME finding still reproduces without it. Repeats
# full sweeps until one changes nothing. Not globally minimal, but reliably
# strips the steps that were never relevant to the finding.
def shrink(domain, steps, signature, adapter = :memory)
  current = steps.dup
  loop do
    changed = false
    index = 0
    while index < current.length
      candidate = current[0...index] + current[(index + 1)..]
      if candidate.empty?
        index += 1
        next
      end
      verdict, message = outcome(domain, candidate, adapter)
      if "#{verdict}: #{signature_of(message)}" == signature
        current = candidate
        changed = true
      else
        index += 1
      end
    end
    break unless changed
  end
  shrink_arguments(domain, current, signature, adapter)
end

# THEN INSIDE EACH SURVIVING STEP. Removing whole steps leaves every
# argument of the ones that remain, so an irrelevant value rides along
# looking implicated. Arguments are dropped one at a time and kept dropped
# only while the same finding still reproduces ; an argument the domain
# requires will change the refusal and stop reproducing, so it comes
# straight back.
#
# ACCEPTED DROPS ACCUMULATE. `original_keys` is read once, up front, only
# to know WHICH keys are worth trying — the trim itself is always computed
# from `step`'s OWN CURRENT args (re-read every iteration), which is
# `candidate[position]` from the previous accepted drop when there was one.
# Reading a stale, pre-loop `args` snapshot here instead (as this once did)
# means every trim starts over from the ORIGINAL argument set minus one
# key, so accepting a second drop silently un-drops the first — a shrunk
# candidate that looked minimal after N accepted drops actually only ever
# carried the LAST one.
# A step's own args are read by whichever spelling it actually carries —
# key? first, never `||`, which cannot tell a genuinely stored `false`
# argument value apart from an absent "args" key and would silently
# prefer the OTHER spelling instead.
def args_of(step)
  step.key?("args") ? step["args"] : step[:args]
end

def shrink_arguments(domain, steps, signature, adapter = :memory)
  steps.each_with_index do |step, position|
    original_keys = args_of(step)
    next unless original_keys.is_a?(Hash)

    original_keys.each_key do |key|
      current_args = args_of(step)
      trimmed = current_args.reject { |name, _| name == key }
      candidate = steps.map(&:dup)
      candidate[position] = step.merge("args" => trimmed)

      verdict, message = outcome(domain, candidate, adapter)
      next unless "#{verdict}: #{signature_of(message)}" == signature

      steps = candidate
      step = candidate[position]
    end
  end
  steps
end

# The sweep's final report: one sequential print-then-shrink-then-save
# pass over each distinct failure group. The per-group block (shrink,
# derive the save path, write the repro script, print where it landed)
# is print-order-dependent on the summary lines above it and has no
# meaningful life split from the "print the report" it's part of — pulling
# it into its own method would just thread domain/name/save_dir/seeds/
# adapter through unchanged. No spec exercises this CLI-output function
# directly (spec/bin_fuzz_spec.rb covers `args_of`/`shrink_arguments`
# only), so there's nothing to verify a split against.
# rubocop:disable-next Metrics/AbcSize
def report(domain, name, seeds, drawn, clean, failures, adapter = :memory)
  executed = clean + failures.length
  puts "   #{executed} seeds executed (#{drawn} drawn) — #{clean} clean, #{failures.length} found something"

  if executed < seeds
    puts "   SHORT — asked for #{seeds} executing seeds and drew #{drawn} to find #{executed}."
    puts "          The generator is not reaching state ; this sweep proves less than it looks."
  end

  if failures.empty?
    puts
    return true
  end

  grouped = failures.group_by { |failure| failure[:signature] }
  puts "   #{grouped.size} distinct finding(s):"
  save_dir = File.join(ROOT, "tmp/fuzz-failures")
  FileUtils.mkdir_p(save_dir)

  grouped.each_value.with_index(1) do |group, number|
    seeds_hit = group.map { |failure| failure[:seed] }
    smallest  = group.min_by { |failure| failure[:steps].length }

    puts
    puts "   (#{number}) #{group.first[:signature]} — #{group.first[:message]}"
    puts "       #{group.length} of #{seeds} seeds: #{seeds_hit.first(8).join(', ')}#{', …' if seeds_hit.length > 8}"

    shrunk = shrink(domain, smallest[:steps], smallest[:signature], adapter)
    save_path = File.join(save_dir, "#{name}-seed#{smallest[:seed]}.json")
    write_script(shrunk, save_path, smallest[:seed], name)

    puts "       shrunk #{smallest[:steps].length} steps -> #{shrunk.length}"
    puts "       reproduce: bin/run #{domain} #{save_path}"
  end

  puts
  false
end

seeds = 20
steps = 30
domain_arg = nil
# PRD 02 (docs/future-features.md) — which persistence this run's every
# ephemeral boot answers through (IsolatedBoot#call's own `adapter:`).
# `memory` (default) is unchanged from before this flag existed. `sqlite`
# is a real on-disk adapter at roughly the same cost as Memory — safe to
# reach for whenever Memory-only coverage is in doubt. `postgres` needs a
# real, reachable local server (same `PostgresProbe`-shaped reachability
# every other real-Postgres spec in this repo already requires) and pays
# a real round trip per dispatch, so it is meaningfully slower — pass
# smaller `--seeds`/`--steps` than the Memory/Sqlite default, this flag
# does not scale them down for you.
adapter = :memory
until ARGV.empty?
  case (arg = ARGV.shift)
  when "--seeds" then seeds = Integer(ARGV.shift)
  when "--steps" then steps = Integer(ARGV.shift)
  when "--adapter"
    adapter = ARGV.shift.to_s.downcase.to_sym
    unless [:memory, :sqlite, :postgres].include?(adapter)
      warn "unknown --adapter #{adapter} — memory, sqlite, or postgres"
      exit 1
    end
  else domain_arg = arg
  end
end

if adapter == :postgres
  # NOT spec/support/postgres_probe.rb — bin/ ships independently of
  # spec/, so this repeats that file's own tiny reachability probe
  # rather than reaching across the tree for it. Same check, same
  # reasoning: a real `PG.connect` round trip, asked once, up front.
  begin
    require "pg"
    PG.connect(dbname: "postgres").close
  rescue LoadError, PG::Error => e
    warn "--adapter postgres needs a reachable local Postgres — #{e.class}: #{e.message}"
    exit 1
  end
end

# EVERY DOMAIN IN THE PROJECT, not a hand-kept list. This used to be
# `examples/*/` plus the grammar, and what that list left out mattered:
# the generator can only produce a null by OMITTING AN OPTIONAL
# ARGUMENT, and between them the example domains hold exactly ONE
# non-list optional command attribute — measured, 2400 generated steps
# produced zero nulls. `lib/hecks/framework` alone holds 29, and
# the language's own chapters hold 96. A differential oracle only ever
# sees what its corpus can express, which is the same lesson the
# adapter-agreement gate taught this week by having no null in its
# fixture at all.
#
# Discovered rather than listed, so a domain added anywhere is swept
# without anyone remembering to add it here. The exclusions are all
# "not a domain": build artifacts and their vendored copies, the Rust
# parser's own fixtures, frozen era archives, translation files (which
# are not chapters), and lib/hecks/forms/examples — a presentation
# config that merely wears the .bluebook extension while actually
# calling `Hecks::Forms.configure`.
# `spec/fixtures/eras` and `spec/fixtures/model_check` are the two that
# are NOT domains despite looking like directories full of them:
# `eras/` holds a dozen deliberately CONFLICTING versions of one domain
# (base.bluebook beside bump_identity, bump_cardinality, ...) for era
# comparison, and loading them together means nothing and refuses;
# `model_check/` holds domains broken ON PURPOSE so the model checker
# has something to find. `spec/fixtures` itself stays in — those are
# ordinary, separate, well-formed domains that merely share a folder.
EXCLUDED_FROM_SWEEP = %r{
  /\.aws-sam/ | ^rust/ | /data/eras/ | /translations/
  | ^lib/hecks/forms/examples/
  | ^spec/fixtures/(eras|model_check)/
}x

def sweepable_domains(root)
  Dir.chdir(root) do
    Dir.glob("**/*.bluebook")
       .grep_v(EXCLUDED_FROM_SWEEP)
       .map { |path| File.dirname(path) }
       .map { |dir| File.basename(dir) == "bluebook" ? File.dirname(dir) : dir }
       .uniq.sort
       .map { |dir| File.join(root, dir) }
  end
end

domains = domain_arg ? [domain_arg] : sweepable_domains(ROOT)

ok = domains.reduce(true) { |all_ok, domain| fuzz_domain(domain, seeds, steps, adapter) && all_ok }

if ok
  puts "CLEAN — no generated sequence broke a property or the interpreter."
  exit 0
else
  puts "FUZZ FOUND SOMETHING."
  exit 1
end
