#!/usr/bin/env ruby

# Fuzzes domains with generated command/query sequences, replaying each and checking properties.
# Shrinks each distinct finding and saves it under tmp/fuzz-failures/.
#
#   bin/fuzz [domain] [--seeds N] [--steps N] [--workers N] [--adapter memory|sqlite|postgres]
#
# Single-runtime on purpose; the cross-runtime differential is spec/rust_conformance_fuzz_spec.rb.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("fuzz")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/tools"

Hecks::Tools.script("fuzz", ARGV)
