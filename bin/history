#!/usr/bin/env ruby

# Prints every journal entry a domain's append-only adapters hold, as
# JSON — the full write history, not just the current head.
#
#   bin/history <domain>

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "json"

domain = ARGV.fetch(0)
runtime = Hecks.boot(domain)

# Reads one aggregate's full journal as plain JSON-ready hashes.
#
# @param repository [Object] the aggregate's repository, as `Runtime::Registry#repository`
#   returns it
# @param _aggregate [Bluebook::Aggregate] the aggregate being read; unused — kept so every
#   call site passes the same two arguments regardless of repository kind
# @return [Array<Hash{String => Object}>] one hash per entry (`"operation"`, `"id"`,
#   `"state"`) when `repository` is a `Ports::Persistence::AppendOnly`; `[]` for any other
#   repository kind
def entries_for(repository, _aggregate)
  case repository
  when Hecks::Ports::Persistence::AppendOnly
    repository.entries.map { |entry| { "operation" => entry.operation, "id" => entry.id, "state" => entry.state } }
  else
    []
  end
end

history = runtime.registry.bluebooks.each_with_object({}) do |(domain_name, bluebook), all|
  bluebook.aggregates.each do |aggregate|
    repository = runtime.registry.repository(domain_name, aggregate)
    entries = entries_for(repository, aggregate)
    all[aggregate.storage_name] = entries
  end
end

puts JSON.generate(history)
