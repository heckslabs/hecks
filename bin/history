#!/usr/bin/env ruby

# Prints every journal entry a domain's append-only adapters hold, as JSON.
# The body lives in lib/hecks/cli/history.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("history")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/history"

Hecks::CLI::History.call(ARGV)
