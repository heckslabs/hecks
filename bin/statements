#!/usr/bin/env ruby

# Prints a booted domain's declared facts as plain English sentences.
# The body lives in lib/hecks/cli/statements.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("statements")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/statements"

exit(Hecks::CLI::Statements.call(ARGV))
