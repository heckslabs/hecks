#!/usr/bin/env ruby

# Prints a booted domain's declared facts as plain English sentences, via Projections::Statements.
#
#   bin/statements <domain-path> <ChapterName>
#   bin/statements examples/pizzas Pizzas

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"

domain_path  = ARGV[0] or abort "usage: bin/statements <domain-path> <ChapterName>"
chapter_name = ARGV[1] or abort "usage: bin/statements <domain-path> <ChapterName>"

runtime = Hecks.boot(File.expand_path(domain_path, Dir.pwd))
chapter = runtime.registry.bluebook(chapter_name)

Hecks::Projector.call(:statements, bluebook: chapter).each { |statement| puts statement }
