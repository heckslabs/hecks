#!/usr/bin/env ruby

# Generates domains nobody wrote and checks them the way the rotation does.
# The body lives in lib/hecks/quality_control/cli/qa_generated_domains.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_generated_domains")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/quality_control/cli/qa_generated_domains"

exit(Hecks::QualityControlCli::QaGeneratedDomains.call(ARGV, root: File.expand_path("..", __dir__)))
