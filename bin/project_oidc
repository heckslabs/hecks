#!/usr/bin/env ruby

# Projects every domain's OIDC client/scope manifest into `<domain>/oidc.json`
# — the artifact half of §11, `Hecks::Projections::OIDC`, made
# producible outside a spec run.
#
#   bin/project_oidc                    # every domain in this checkout
#   bin/project_oidc examples/banking   # just this one
#
# `bundler/setup`, unlike every sibling `bin/project_*` — those emit
# hand-formatted Ruby source, this one is the first to write its artifact
# through bare `JSON.pretty_generate` (`Projector.write`'s own default
# path). Confirmed live: an empty array pretty-prints as `[]` under the
# `json` gem this Gemfile.lock pins (2.7.2) but `[\n\n]` under the
# newest one RubyGems would otherwise hand an un-bundled `ruby` — a real
# diff `spec/oidc_manifest_spec.rb` would report as drift depending on
# nothing but which gem happened to resolve. Pinning here is what makes
# "run this script" and "what the spec expects" the same claim regardless
# of how either gets invoked.

require "bundler/setup"

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"

ROOT   = File.expand_path("..", __dir__)
FOLDER = Hecks::Adapters::Folder.new

# The same discovery `bin/project_cli` already uses — every `.hecksagon` in
# the checkout names a domain root, `rust/`, `deploy/`, `tmp/` and
# `coverage/` are never domains.
def domains
  Dir.glob(File.join(ROOT, "**/*.hecksagon"))
     .map { |path| FOLDER.domain_root(File.dirname(path)) }
     .compact
     .map { |path| path.delete_prefix("#{ROOT}/") }
     .grep_v(%r{\A(rust|deploy|tmp|coverage)/})
     .uniq.sort
end

wanted = ARGV.empty? ? domains : ARGV.map { |path| path.delete_prefix("#{ROOT}/").chomp("/") }

wanted.each do |path|
  runtime = Hecks.boot(File.join(ROOT, path), install_facade: false)
  name    = runtime.registry.bluebooks.keys.first

  unless name
    warn "  #{path}: no bluebook found — skipped"
    next
  end

  bluebook = runtime.registry.bluebook(name)
  out      = File.join(ROOT, path, "oidc.json")

  Hecks::Projector.write(Hecks::Projector.call(:oidc, bluebook: bluebook), out)
  puts "  #{path}/oidc.json  <-  #{name}"
rescue StandardError => e
  warn "  #{path}: cannot project — #{e.message.lines.first.strip}"
end
