#!/usr/bin/env ruby

# Projects each domain's OIDC client/scope manifest (Hecks::Projections::OIDC) into `oidc.json`.
#
#   bin/project_oidc                    # every domain in this checkout
#   bin/project_oidc examples/banking   # just this one
#
# `bundler/setup` pins the `json` gem: newer releases pretty-print an empty array as `[\n\n]`,
# a diff spec/oidc_manifest_spec.rb would report as drift.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_oidc")

require "bundler/setup"

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "hecks/cli/project_oidc"

root = File.expand_path("..", __dir__)

Hecks::CLI::ProjectOidc.call(root: root, wanted: ARGV).each do |outcome|
  if outcome.error
    warn "  #{outcome.path}: #{outcome.error}"
  else
    puts "  #{outcome.path}/oidc.json  <-  #{outcome.chapter}"
  end
end
