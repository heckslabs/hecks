#!/usr/bin/env ruby

# Executes a step list — commands and queries, declared as JSON — and
# reports instances, events, refusals, reactions, sagas, and query rows.
#
#   bin/run <domain> <script.json>
#   bin/run <domain> -            # the same script, on stdin
#   bin/run <domain> '{"steps":[…]}'
#   bin/run qa '{"steps":[{"query":"QualityControl::Bug.Unfixed"}]}'

# The logic is `Hecks::CLI::Run` (lib/hecks/cli/run.rb), which `hecks run` also runs.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/cli/run"

Hecks::CLI::Run.call(ARGV, program: "bin/run")
