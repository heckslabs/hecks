#!/usr/bin/env ruby

# One racer of Hecks::Fuzzing::ConcurrentDispatch.
# The body lives in lib/hecks/quality_control/cli/qa_concurrency_racer.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_concurrency_racer")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/quality_control/cli/qa_concurrency_racer"

exit(Hecks::QualityControlCli::QaConcurrencyRacer.call(ARGV))
