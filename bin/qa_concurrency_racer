#!/usr/bin/env ruby

# One racer of Hecks::Fuzzing::ConcurrentDispatch, run as its own OS process.
#
# Spawned, not forked: the caller (bin/qa_sweep) holds live PostgresEra connections, and fork
# duplicates their file descriptors and SSL state, corrupting them when a child exits.
#
#   bin/qa_concurrency_racer <domain-path> <database> <schema> <verb> <args-json>
#
# Prints one line, "succeeded", "refused" or "crashed:<class>: <message>", and always exits 0.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_concurrency_racer")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "hecks/ports/persistence/plugins/era"
require "hecks/fuzzing/concurrent_dispatch"
require "json"

domain_path, database, schema, verb, args_json = ARGV
abort "usage: bin/qa_concurrency_racer <domain-path> <database> <schema> <verb> <args-json>" \
  unless domain_path && database && schema && verb && args_json

step = { "verb" => verb, "args" => JSON.parse(args_json) }

outcome = Hecks::Fuzzing::ConcurrentDispatch.boot_preserving_schema(domain_path, database: database, schema: schema) do |copy|
  Hecks::Fuzzing::ConcurrentDispatch.dispatch_one(Hecks.boot(copy), step)
end

puts outcome
