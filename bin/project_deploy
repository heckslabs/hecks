#!/usr/bin/env ruby

# The AWS deployment CLI (ADR 0018): resolves a domain's declared
# `deployed_to(...)` target and dispatches to the matching Projector export.
#
#   bin/project_deploy <domain> [--tenant=<slug>] [--schema=<name>]
#       [--out=<dir>] [--environment=<name>]
#
# `--environment=<name>` layers an overlay `.world` file over the base one;
# a missing overlay is an error, never a silent no-op. `--out=<dir>` writes
# the generated recipe elsewhere, for a domain that lives in a client's repo.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_deploy")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks"
require "hecks/cli/project_deploy"
require "optparse"

options = {}
OptionParser.new do |parser|
  parser.on("--tenant=SLUG") { |v| options[:tenant] = v }
  parser.on("--schema=NAME") { |v| options[:schema] = v }
  parser.on("--out=DIR") { |v| options[:out] = v }
  parser.on("--environment=NAME") { |v| options[:environment] = v }
end.parse!(ARGV)

domain = ARGV.shift or abort "usage: bin/project_deploy <domain> [--tenant=<slug>] [--schema=<name>] [--out=<dir>] [--environment=<name>]"

begin
  rendered = Hecks::CLI::ProjectDeploy.call(domain: domain, **options)
rescue Hecks::CLI::ProjectDeploy::Refusal => e
  abort e.message
end

rendered.written.each { |path| puts "wrote #{path}" }
puts
puts "deploy from #{rendered.out_dir} — one command, nothing to type, nothing to remember:"
puts "    make deploy"
