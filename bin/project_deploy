#!/usr/bin/env ruby

# The AWS deployment CLI (ADR 0018): resolves a domain's declared
# `deployed_to(...)` target and dispatches to the matching Projector export.
#
#   bin/project_deploy <domain> [--tenant=<slug>] [--schema=<name>]
#       [--out=<dir>] [--environment=<name>]
#
# `--environment=<name>` layers an overlay `.world` file over the base one;
# a missing overlay is an error, never a silent no-op. `--out=<dir>` writes
# the generated recipe elsewhere, for a domain that lives in a client's repo.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_deploy")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks"
require "fileutils"

require "optparse"

# `--tenant`/`--schema` are the per-tenant override for shared-database
# hosting (see Runtime::TenantCheck's own header for the Ruby-side story).
# They rewrite `deploy_settings` before `infra_name`/`hecks_schema` are
# computed below, so everything downstream that reads those two variables
# needs no separate tenant-aware path. `stack_name` is appended to, not
# replaced — re-running with the same `--tenant` must regenerate the same
# stack, not a new one.
tenant_options = {}
out_option = nil
environment_option = nil
OptionParser.new do |parser|
  parser.on("--tenant=SLUG") { |v| tenant_options[:tenant] = v }
  parser.on("--schema=NAME") { |v| tenant_options[:schema] = v }
  parser.on("--out=DIR") { |v| out_option = v }
  parser.on("--environment=NAME") { |v| environment_option = v }
end.parse!(ARGV)

if tenant_options[:schema] && !tenant_options[:tenant]
  abort "--schema needs --tenant=<slug> — a schema override with no tenant to scope it to is meaningless"
end

domain = ARGV.shift or abort "usage: bin/project_deploy <domain> [--tenant=<slug>] [--schema=<name>] [--out=<dir>] [--environment=<name>]"
root = File.expand_path("..", __dir__)
domain_name = File.basename(domain)
world_file = File.join(domain, "bluebook", "#{domain_name}.world")

# Falls back to the sole `*.world` file under `<domain>/bluebook/` when
# it isn't named after the directory (QualityControl is the one domain
# that isn't) — never picked when there's more than one candidate, since
# guessing which one is "the" domain isn't this generator's call to make.
unless File.exist?(world_file)
  candidates = Dir.glob(File.join(domain, "bluebook", "*.world"))
  world_file = candidates.first if candidates.size == 1
end

File.exist?(world_file) or abort "#{world_file} does not exist — a domain needs a .world file to declare deployed_to(\"AwsLambda\") or deployed_to(\"AwsFargate\")"

# The `.world` file's own basename, not `domain_name` — they usually
# match, but QualityControl's chapter files share the file's basename,
# not its directory's.
bluebook_basename = File.basename(world_file, ".world")

registry = Hecks::Runtime::Registry.new
Hecks.with_registry(registry) do
  Kernel.load(world_file)
  if environment_option
    overlay_file = File.join(domain, "bluebook", "environments", "#{environment_option}.world")
    File.exist?(overlay_file) or abort "#{overlay_file} does not exist — --environment=#{environment_option} needs that overlay"
    Kernel.load(overlay_file)
  end
end

# The world's own declared name, not the directory's.
world = registry.worlds.values.first or
  abort "#{world_file} declares no Hecks.world block at all"

# Must match Ruby's own `hecks_eras.domain` string exactly (`world.domain`,
# not the directory's lowercase basename) — rust/host's boot-time
# `era_exists` check refuses forever otherwise.
declared_domain_name = world.domain

deploy_settings = world.for_verb("deployed_to")

# Applied before `infra_name` is computed, so `out_dir` below agrees
# with whatever stack name `Lambda`/`Fargate` generate — they re-apply
# this same override internally against the `world`/`tenant:` they're handed.
if tenant_options[:tenant]
  base_stack_name = deploy_settings[:stack_name] || domain_name
  deploy_settings = deploy_settings.merge(stack_name: "#{base_stack_name}-#{tenant_options[:tenant]}")
end

# Every AWS-facing name below (stack, logical ids, S3 prefixes, secret
# names) reads this, not `domain_name`. They diverge only when a domain's
# declared identity has moved on since its stack was created — a
# CloudFormation stack can't be renamed in place, so `stack_name` pins
# the original forever.
infra_name = deploy_settings[:stack_name] || domain_name

# Loads the whole registry a domain boots with, not just its own
# `.bluebook` — a cross-domain invoke grant can live in any attached
# chapter. `root:` is required or `uses_embryonaut_bluebook` refuses
# with "needs a registry with a root to vendor from".
cross_domain_registry = Hecks::Runtime::Registry.new(root: File.expand_path(domain))
Hecks.with_registry(cross_domain_registry) do
  Kernel.load(File.expand_path("../lib/hecks/ports/persistence.port", __dir__))
  Kernel.load(File.expand_path("../lib/hecks/ports/extraction.port", __dir__))
  Kernel.load(File.expand_path("../lib/hecks/adapters/driven/memory.adapter", __dir__))
  Kernel.load(File.expand_path("../lib/hecks/adapters/driven/prism.adapter", __dir__))
  Kernel.load(File.join(domain, "bluebook", "#{bluebook_basename}.bluebook"))
  hecksagon_file = File.join(domain, "bluebook", "#{bluebook_basename}.hecksagon")
  Kernel.load(hecksagon_file) if File.exist?(hecksagon_file)
end

domain_chapter = cross_domain_registry.bluebook(declared_domain_name) or
  abort "#{world_file} declares no #{declared_domain_name} chapter — #{bluebook_basename}.bluebook's own Hecks.bluebook name has to match world.domain."

out_dir = out_option ? File.expand_path(out_option) : File.join(root, "deploy", infra_name)

# Each adapter maps to a registered `Projector` export (`needs_world: true`);
# this script only finds which one to call and where to write its output.
target_key =
  case deploy_settings[:adapter]
  when "AwsLambda" then :aws_lambda
  when "AwsFargate" then :aws_fargate
  else
    abort <<~MSG
      #{world_file} declares no deployed_to("AwsLambda") or deployed_to("AwsFargate") block. Add one, e.g.:

          deployed_to("AwsLambda") do
            region "us-east-1"
            memory 512
            timeout 10
          end

      or:

          deployed_to("AwsFargate") do
            region "us-east-1"
            cpu 256
            memory 512
            port 8080
          end

      then re-run bin/project_deploy #{domain}.
    MSG
  end

# `Lambda`/`Fargate` raise `ArgumentError` for a domain's own deploy
# conflicts; caught here so the message reaches stderr with a failing
# exit code instead of a backtrace.
begin
  artifact = Hecks::Projector.call(
    target_key,
    bluebook: domain_chapter,
    options: {
      tenant: tenant_options,
      domain_dir: domain,
      root: root,
      world_file: world_file,
      cross_domain_registry: cross_domain_registry
    },
    world: world
  )
  # Only when the domain declared `smoke true`; otherwise nothing is added.
  artifact = artifact.merge(Hecks::Projections::Deploy::Smoke.files(deploy_settings, stack_name: infra_name))
rescue ArgumentError => e
  abort e.message
end

# Name the 3.0.0 form of every bin/ script the generated Makefile and scripts call.
artifact = Hecks::ThreeZero.annotate_deploy_files(artifact)
written = Hecks::Projector.write(artifact, out_dir, as: :files)

written.each { |path| puts "wrote #{path}" }
puts
puts "deploy from #{out_dir} — one command, nothing to type, nothing to remember:"
puts "    make deploy"
