#!/usr/bin/env ruby

# Serves the banking example's rendered forms and views on the in-memory adapter.
# The body lives in lib/hecks/cli/present.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("present")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/present"

Hecks::CLI::Present.call(ARGV)
