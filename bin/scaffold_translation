#!/usr/bin/env ruby

# The scaffold writes translations; humans resolve ambiguity. Diffs the
# held era against the current bluebook and writes the edge file:
# confident rules inline, ambiguities as parse-refusing `unresolved`
# lines. Never proposes a compute or a drop — those are decisions.
# Re-running regenerates the file, matched by shape pair.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
# ADR 0033 — the translation/scaffold machinery lives in the era
# persistence plugin now; this tool has no reason to exist without it.
require "hecks/ports/persistence/plugins/era"

domain_path = ARGV.shift or abort "usage: bin/scaffold_translation <domain>"

loading = Hecks::Ports::Loading.bootstrap
directory = loading.bluebook_directory(domain_path)
registry = Hecks::Runtime::Registry.new(root: File.dirname(directory))
Hecks.with_registry(registry) do
  loading.load_library
  loading.load_project(loading.shared_root(nil, directory))
  # deliberately not translations/*.bluebook: an unresolved edge file
  # refuses to load, and regenerating it is this tool's whole job
  loading.load_each(directory, %w[*.port *.adapter])
  loading.load_bluebooks(directory)
  loading.load_each(directory, %w[*.hecksagon *.world])

  # Environment overlay — this tool's own registry build never called
  # `load_domain`'s `environment:` handling (folder.rb) either, the
  # same gap `bin/project_rust` had (see that fix's own comment): a
  # domain that splits `persisted_by` per environment declares none in
  # its base `.hecksagon` at all, so `BindingPolicy.resolve` raised "no
  # persisted_by bind" for `bluebook.aggregates.first` here too —
  # confirmed live scaffolding lifeadelics' own era-1-to-current
  # translation. Same opt-in, same reasoning: a silent no-op for every
  # other domain, which never sets this.
  if (target_environment = ENV.fetch("HECKS_PROJECT_ENVIRONMENT", nil))
    loading.load_each(directory, [File.join("environments", "#{target_environment}.hecksagon")])
    loading.load_each(directory, [File.join("environments", "#{target_environment}.world")])
  end
end

bluebook = registry.bluebooks.values.first or abort "no bluebook in #{directory}"
first = bluebook.aggregates.first or abort "#{bluebook.name} declares no aggregates"
adapter_name = Hecks::Ports::Persistence::BindingPolicy.resolve(registry, bluebook.name, first).adapter
capable =
  begin
    adapter_class = registry.adapter_class(adapter_name)
    adapter_class.respond_to?(:lineage_capable?) && adapter_class.lineage_capable?
  rescue StandardError
    false
  end

current_shape = Hecks::Runtime::StorageShape.project(bluebook)
manager = Hecks::Adapters::PostgresEra::LineageManager

if capable
  # Settings resolve under the world-declared adapter name — `World#
  # for_binding` keys settings by whatever name the `.world` file
  # itself qualified them with, e.g.
  # `persisted_by("PostgresEra") do database ... end`), never the
  # of its own in a domain that only ever declared `"Postgres"`, so
  # looking those up under the bypassed name would find nothing at all.
  settings = registry.world(bluebook.name)&.for_binding(Hecks::Ports::Persistence::VERB, adapter_name) || {}
  # `HECKS_SCHEMA` — a Shared-mode domain's `.world` file deliberately
  # declares no `schema` of its own (lifeadelics.world's own comment:
  # "the AWS Lambda's own HECKS_SCHEMA... is what actually scopes
  # production; this local default is for anyone booting
  # `environment: production` outside Lambda, which nothing does today").
  # Something does now — this tool, run by hand over a bastion tunnel
  # for exactly this reason — so it needs the same schema Lambda's own
  # template.yaml bakes in, supplied the same way (an env var), not a
  # hardcoded guess or a change to that project's own `.world` file.
  settings = settings.merge(schema: ENV["HECKS_SCHEMA"]) if ENV["HECKS_SCHEMA"]
  db = Hecks::Adapters::PostgresEra.connect_for(bluebook.name, settings)
  lineage = Hecks::Adapters::PostgresEra::Lineage.new(db, bluebook.name)
  lineage.ensure_base!
  if lineage.eras.empty?
    lineage.hold_first!(Hecks::Runtime::EraCheck.source_text_for(bluebook, directory),
                        projection: Hecks::Runtime::StorageShape.project(bluebook))
    puts "#{bluebook.name} held era 1 just now — nothing to scaffold."
    exit 0
  end
  latest = lineage.eras.last
  held_bluebook = manager.shadow(latest[:held_text])
  if Hecks::Runtime::StorageShape.project(held_bluebook) == current_shape
    puts "#{bluebook.name} matches era #{latest[:ordinal]} — nothing to scaffold."
    exit 0
  end
  path = manager.scaffold!(registry, bluebook, lineage, latest, directory)
  diffed = Hecks::Translation::Scaffold.diff(held_bluebook, bluebook)
  db.close
else
  # Eras belong to the adapters that can carry data across them. An
  # edge scaffolded for an adapter that cannot apply it would be a
  # document describing a translation nothing will ever run.
  abort "#{bluebook.name} is bound to #{adapter_name}, which holds no eras — " \
        "a translation edge is only applied by a lineage-capable adapter. " \
        "Bind PostgresEra, or change the shape and its stored data by hand."
end

text = File.read(path)
unresolved = text.scan(/^\s*unresolved /).size
unclaimed = defined?(diffed) && diffed ? diffed[:unclaimed] : []
puts "wrote #{path}"
unclaimed.each do |name|
  puts "UNCLAIMED: #{name} existed and now doesn't, and its successor is ambiguous — " \
       "add `aggregate \"NewName\", was: #{name.inspect}` (with its rules) or `retired #{name.inspect}` by hand."
end
if unresolved.zero? && unclaimed.empty?
  puts "0 unresolved — this shape change costs one extra boot and no typing. Check it with bin/translation_audit, then boot."
else
  if unresolved.positive?
    puts "#{unresolved} unresolved — decide what each became (rename/move/convert/drop, or compute on PostgresEra), " \
         "then boot."
  end
end
