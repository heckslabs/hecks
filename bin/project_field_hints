#!/usr/bin/env ruby

# Generates rust/host/src/field_hints.rs — the four regex hints
# Hecks::Forms::FieldShape#text_field (lib/hecks/
# forms/field_shape.rb) matches a text attribute's own name
# (and, for email/url, its own `pattern:`) against, to guess an HTML
# input type or a textarea kind for a field nothing more specific
# already answered (no `pattern:`, no `admits:`, not a closed set).
#
# Ground truth: Vocabulary::FieldHint (language/bluebook/
# vocabulary.bluebook) — the same declared table FieldShape's four Ruby
# constants are built from, read here instead of re-typed a second time.
# rust/host/src/web.rs's own `text_field` is the consumer — its own
# header explains why a web ui written in Rust needs the same hint
# vocabulary Ruby's hecks_on_web/FieldShape already declares.
#
# Why rust/host/src/, not rust/src/kernel/ (where bin/project_kernel_
# capabilities writes its own generated enums, the closest precedent
# for this script): rust/host/Cargo.toml says plainly it takes "no path
# dependency on `rust`" (the kernel crate this repo's WASM projection
# targets) — it treats the compiled `.wasm` module as opaque, loaded
# through wasmtime at runtime, never a Rust library linked in-process.
# web.rs, the one consumer of this file, lives entirely inside the
# rust/host crate, so the generated file has to live there too or
# nothing could ever `use` it.
#
# `Regex::new` runs once per pattern, in a `LazyLock` — not per call —
# matching web.rs's own `OnceLock` convention (`ir()`, this file's
# sibling) for "compute lazily, once, and hold it".
#
#   bin/project_field_hints

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "fileutils"
require "tempfile"

ROOT   = File.expand_path("..", __dir__)
TARGET = File.join(ROOT, "rust/host/src/field_hints.rs")

def write_atomically(target, content)
  FileUtils.mkdir_p(File.dirname(target))
  Tempfile.create(File.basename(target), File.dirname(target)) do |tmp|
    tmp.write(content)
    tmp.flush
    File.rename(tmp.path, target)
  end
  puts "wrote #{target}"
end

# "email" -> "EMAIL_HINT" — matching FieldShape's own Ruby constant
# spelling exactly, so a reader can find either side from the other's
# name alone.
def const_name(name) = "#{name.upcase}_HINT"

meta       = Hecks::Bluebook::MetaValidator.grammar_registry.bluebook("Bluebook")
vocabulary = meta.aggregates.find { |a| a.hecks_name == "Vocabulary" }
field_hint = vocabulary.value_objects.find { |vo| vo.hecks_name == "FieldHint" }
hints      = field_hint.members.map(&:to_h)

consts = hints.map do |hint|
  <<~RUST
    /// #{hint[:name].capitalize} hint, resolving to `#{hint[:resolves_to]}` on a match —
    /// Vocabulary::FieldHint's own declared pattern, unmodified (the
    /// same text `Regexp#source` reads off FieldShape's own
    /// #{const_name(hint[:name])}, which is built from this same row).
    /// `(?i)` up front is this crate's spelling
    /// of Ruby's trailing `/i` — the WHOLE pattern is case-insensitive
    /// on both sides, never partially.
    pub static #{const_name(hint[:name])}: LazyLock<Regex> =
        LazyLock::new(|| Regex::new(r#"(?i)#{hint[:pattern]}"#).expect("declared field-hint pattern must compile"));
  RUST
end.join("\n")

content = <<~RUST
  // GENERATED by bin/project_field_hints from Vocabulary::FieldHint
  // (lib/hecks/language/bluebook/vocabulary.bluebook). Do not
  // hand-edit — re-run bin/project_field_hints instead.
  //
  // web.rs's `text_field` matches these in the SAME precedence Ruby's
  // own `text_field` does: EMAIL_HINT, then URL_HINT, then TEL_HINT —
  // against `html_type`, first match wins — then, only if `html_type`
  // stayed "text", TEXTAREA_HINT against `kind`.

  use regex::Regex;
  use std::sync::LazyLock;

  #{consts}
RUST

write_atomically(TARGET, content)
