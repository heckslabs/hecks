#!/usr/bin/env ruby

# Generates rust/host/src/field_hints.rs, the regex hints web.rs's `text_field` uses to guess
# an HTML input type. Source: Vocabulary::FieldHint, the table FieldShape's constants come from.
#
# It lives in rust/host, not rust/src/kernel: the host crate takes no path dependency on the
# kernel crate. Each pattern compiles once, in a `LazyLock`.
#
#   bin/project_field_hints

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_field_hints")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "fileutils"
require "tempfile"

ROOT   = File.expand_path("..", __dir__)
TARGET = File.join(ROOT, "rust/host/src/field_hints.rs")

# Writes via a temp file and rename so a reader never sees a partial file.
def write_atomically(target, content)
  FileUtils.mkdir_p(File.dirname(target))
  Tempfile.create(File.basename(target), File.dirname(target)) do |tmp|
    tmp.write(content)
    tmp.flush
    File.rename(tmp.path, target)
  end
  puts "wrote #{target}"
end

# "email" -> "EMAIL_HINT", the same spelling as FieldShape's Ruby constant.
def const_name(name) = "#{name.upcase}_HINT"

meta       = Hecks::Bluebook::MetaValidator.grammar_registry.bluebook("Bluebook")
vocabulary = meta.aggregates.find { |a| a.hecks_name == "Vocabulary" }
field_hint = vocabulary.value_objects.find { |vo| vo.hecks_name == "FieldHint" }
hints      = field_hint.members.map(&:to_h)

consts = hints.map do |hint|
  <<~RUST
    /// #{hint[:name].capitalize} hint, resolving to `#{hint[:resolves_to]}` on a match —
    /// Vocabulary::FieldHint's own declared pattern, unmodified (the
    /// same text `Regexp#source` reads off FieldShape's own
    /// #{const_name(hint[:name])}, which is built from this same row).
    /// `(?i)` up front is this crate's spelling
    /// of Ruby's trailing `/i` — the WHOLE pattern is case-insensitive
    /// on both sides, never partially.
    pub static #{const_name(hint[:name])}: LazyLock<Regex> =
        LazyLock::new(|| Regex::new(r#"(?i)#{hint[:pattern]}"#).expect("declared field-hint pattern must compile"));
  RUST
end.join("\n")

content = <<~RUST
  // GENERATED by bin/project_field_hints from Vocabulary::FieldHint
  // (lib/hecks/language/bluebook/vocabulary.bluebook). Do not
  // hand-edit — re-run bin/project_field_hints instead.
  //
  // web.rs's `text_field` matches these in the SAME precedence Ruby's
  // own `text_field` does: EMAIL_HINT, then URL_HINT, then TEL_HINT —
  // against `html_type`, first match wins — then, only if `html_type`
  // stayed "text", TEXTAREA_HINT against `kind`.

  use regex::Regex;
  use std::sync::LazyLock;

  #{consts}
RUST

write_atomically(TARGET, content)
