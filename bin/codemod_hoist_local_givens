#!/usr/bin/env ruby

# Hoists `given`s that two or more commands under one owner repeat verbatim into a single
# owner-level `given`, leaving bare references behind. Single-owner groups in example domains only.
#
# Not Hecks::Codemod::Runner: hoisting adds an owner-level precondition, so the exported IR
# cannot stay byte-identical. The invariant checked instead is each command's effective rules.
#
# Inserted right after the owner's opening line: `command` calls are deferred to
# `drain_pending!`, so the position of `given` inside the owner does not matter (ADR 0028).
#
# Usage: bin/codemod_hoist_local_givens [--dry-run]

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("codemod_hoist_local_givens")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/tools"

Hecks::Tools.script("codemod_hoist_local_givens", ARGV)
