#!/usr/bin/env ruby

# MCP server exposing Hecks::QueryIR's queries as tools, over stdio.
# The body lives in lib/hecks/cli/serve_query_ir_mcp.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("hecks_query_ir_mcp")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/serve_query_ir_mcp"

Hecks::CLI::ServeQueryIrMcp.call(ARGV)
