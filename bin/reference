#!/usr/bin/env ruby

# Regenerates docs/implemented/reference/ from the language's Syntax chapter.
# Tables come from the declaration, prose is kept from the committed pages.
#
#   bin/reference

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"

root      = File.expand_path("..", __dir__)
directory = File.join(root, "docs/implemented/reference")
chapter   = Hecks::Bluebook::MetaValidator.grammar_registry.bluebook("Bluebook")

written = Hecks::Projector.write(
  Hecks::Projector.call(:reference, bluebook: chapter, options: { from: directory }),
  directory, as: :files
)
Hecks::Doc::Reference.write_readme!(root)

puts "wrote #{written.size} pages to docs/implemented/reference/, and regenerated README.md's own indexes"

# Both coverage gates, reported together; bin/doc_coverage asks the same as an exit status.
{
  "prose"             => Hecks::Doc::Reference.undocumented(directory),
  "a running example" => Hecks::Doc::Reference.unexemplified(directory)
}.each do |owed, missing|
  if missing.empty?
    puts "every live word carries #{owed}."
  else
    puts "#{missing.size} word(s) still carry no #{owed}:"
    missing.each { |word| puts "  #{word}" }
  end
end
