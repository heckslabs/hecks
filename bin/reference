#!/usr/bin/env ruby

# Regenerates docs/implemented/reference/ from the language's Syntax chapter.
# The body lives in lib/hecks/cli/reference.rb; this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("reference")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/reference"

exit(Hecks::CLI::Reference.call(root: File.expand_path("..", __dir__)))
