#!/usr/bin/env ruby

# Regenerates spec/fixtures/persistence_legacy/ via the real adapters; needs Postgres and sqlite3.
# The body lives in lib/hecks/cli/regenerate_persistence_legacy_fixtures.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("regenerate_persistence_legacy_fixtures")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/regenerate_persistence_legacy_fixtures"

exit(Hecks::CLI::RegeneratePersistenceLegacyFixtures.call(root: File.expand_path("..", __dir__)))
