#!/usr/bin/env ruby

# Regenerates spec/fixtures/persistence_legacy/ via the real adapters; needs Postgres and sqlite3.
# Do not re-run once adapters write through the state codec: it would overwrite the baseline.
#
#   bin/regenerate_persistence_legacy_fixtures
#
# A shim: the work is Hecks::PersistenceLegacyFixture::Regenerate
# (lib/hecks/persistence_legacy_fixture/regenerate.rb).

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("regenerate_persistence_legacy_fixtures")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/persistence_legacy_fixture"

puts Hecks::PersistenceLegacyFixture::Regenerate.call
