#!/usr/bin/env ruby

# Runs the translation audit's three layers standalone against a domain's
# latest or pending edge. Read-only except --approve.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("translation_audit")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/tools"

Hecks::Tools.script("translation_audit", ARGV)
