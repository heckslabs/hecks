#!/usr/bin/env ruby

# One QA tick: pr check, sweep --all, generated domains, one report.
# The body lives in lib/hecks/quality_control/cli/qa_tick.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_tick")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/quality_control/cli/qa_tick"

exit(Hecks::QualityControlCli::QaTick.call(ARGV, root: File.expand_path("..", __dir__)))
