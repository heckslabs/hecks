#!/usr/bin/env ruby

# Projects a booted domain into its Ubiquitous Language glossary: `glossary.md` plus
# `html/index.html` rendered from it, written into the domain's own `glossary/` folder.
#
#   bin/project_glossary <domain-path> <ChapterName>
#   bin/project_glossary examples/banking Banking
#   bin/project_glossary qa QualityControl
#   # => examples/banking/glossary/glossary.md
#   #    examples/banking/glossary/html/index.html

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_glossary")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/project_glossary"

Hecks::CLI::ProjectGlossary.call(ARGV)
