#!/usr/bin/env ruby

# Projects a booted domain's own declaration into its Ubiquitous
# Language glossary — one alphabetized Markdown table, one entry per
# term the bluebook declares (Aggregate, Entity, Value Object, Command,
# Query, Read Model, Event, Role, Saga). The projection itself is
# Projections::Glossary (see its own header for the DDD framing); this
# boots the given domain, finds its one real chapter, and asks the
# registry for it.
#
#   bin/project_glossary <domain-path> <ChapterName>
#   bin/project_glossary examples/banking Banking

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "fileutils"

domain_path  = ARGV[0] or abort "usage: bin/project_glossary <domain-path> <ChapterName>"
chapter_name = ARGV[1] or abort "usage: bin/project_glossary <domain-path> <ChapterName>"

runtime = Hecks.boot(File.expand_path(domain_path, Dir.pwd))
chapter = runtime.registry.bluebook(chapter_name)

directory = File.expand_path("../docs/generated/glossary", __dir__)
FileUtils.mkdir_p(directory)
path = File.join(directory, "#{Hecks::Naming.snake(chapter_name)}.md")

File.write(path, Hecks::Projector.call(:glossary, bluebook: chapter))

puts "wrote #{path}"
