#!/usr/bin/env ruby

# Projects a booted domain's own declaration into its Ubiquitous
# Language glossary — the document every domain carries with it, for
# the whole team (Projections::Glossary's own header has the DDD
# framing). Two files, one source: `glossary.md`, and `html/index.html`
# rendered from that Markdown, written into the domain's own folder:
#
#   bin/project_glossary <domain-path> <ChapterName>
#   bin/project_glossary examples/banking Banking
#   bin/project_glossary qa QualityControl
#   # => examples/banking/glossary/glossary.md
#   #    examples/banking/glossary/html/index.html
#
# A field the deployment marks sensitive (`has_phi(readable_by:)` in the
# domain's `.hecksagon`) is tagged in the glossary with its category.
#
# spec/glossary_spec.rb re-projects every one and refuses a diff, so the
# committed glossary can never lag the bluebook it describes.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"

domain_path  = ARGV[0] or abort "usage: bin/project_glossary <domain-path> <ChapterName>"
chapter_name = ARGV[1] or abort "usage: bin/project_glossary <domain-path> <ChapterName>"

domain  = File.expand_path(domain_path, Dir.pwd)
runtime = Hecks.boot(domain)
chapter = runtime.registry.bluebook(chapter_name)

markings = runtime.registry.pending_privacy_markings.select do |marking|
  marking[:domain].to_s.start_with?("#{chapter_name}::")
end

written = Hecks::Projector.write(
  Hecks::Projector.call(:glossary, bluebook: chapter, options: { markings: markings }),
  File.join(domain, "glossary"), as: :files
)

puts "wrote #{written.size} file(s):"
written.each { |path| puts "  #{path}" }
