#!/usr/bin/env ruby

# Prints one generated, valid dispatch sequence for a domain, using the generator bin/fuzz drives.
#
#   bin/generate <domain> [--seed N] [--steps N] [--adversarial fraction]
#
# --adversarial mutates the sequence as bin/qa_sweep does; 0 (off) by default.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("generate")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/tools"

Hecks::Tools.script("generate", ARGV)
