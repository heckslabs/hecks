#!/usr/bin/env ruby

# Prints one generated, valid dispatch sequence for a domain, using the generator bin/fuzz drives.
#
#   bin/generate <domain> [--seed N] [--steps N] [--adversarial fraction]
#
# --adversarial mutates the sequence as bin/qa_sweep does; 0 (off) by default.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "hecks/fuzzing"
require "json"

USAGE = "usage: bin/generate <domain> [--seed N] [--steps N] [--adversarial FRACTION]".freeze

domain = ARGV.shift or abort USAGE

seed  = 1
steps = 30
adversarial = 0.0
until ARGV.empty?
  case ARGV.shift
  when "--seed"        then seed  = Integer(ARGV.shift)
  when "--steps"       then steps = Integer(ARGV.shift)
  when "--adversarial" then adversarial = Float(ARGV.shift)
  else abort USAGE
  end
end

generated = Hecks::Fuzzing::SequenceGenerator.generate(domain, seed: seed, steps: steps, adversarial: adversarial)

puts JSON.pretty_generate(
  name:  "#{File.basename(domain)}-generated",
  note:  "generated by bin/generate — seed #{seed}, #{steps} steps requested (#{generated.length} produced)",
  steps: generated
)
