#!/usr/bin/env ruby

# Runs one claim, sweep, conclude/release cycle against a QualityControl target.
# The body lives in lib/hecks/quality_control/cli/qa_sweep.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_sweep")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/quality_control/cli/qa_sweep"

exit(Hecks::QualityControlCli::QaSweep.call(ARGV, root: File.expand_path("..", __dir__)))
