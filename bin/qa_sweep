#!/usr/bin/env ruby

# ONE CLAIM -> SWEEP -> CONCLUDE/RELEASE CYCLE, MECHANICAL END TO END.
#
# `.claude/skills/hecks_qa/SKILL.md` used to walk an agent through six
# manual `bin/run` calls (boot check, pick a target, claim it, open a
# sweep, run the existing fuzz infrastructure by hand and log a `Check`
# per dispatch, conclude and release) — pure orchestration, no judgment,
# and every single sweep re-paid the LLM the cost of babysitting it one
# CLI call at a time. This script IS that orchestration, run once,
# deterministically, with zero agent involvement on a clean sweep.
#
# THE ONE THING THIS SCRIPT DELIBERATELY DOES NOT DO: decide whether a
# surprising check is a real bug, write the failing test that proves it
# (`QualityControl::Bug.Log` requires a `demonstration` — an actual
# reproducing test/command — which needs judgment to construct honestly),
# or open a fix PR. The moment any check comes back surprised, this
# script stops, prints a structured report, and exits nonzero — an agent
# picks it up from there, following ONLY the judgment section that is all
# that is left of `.claude/skills/hecks_qa/SKILL.md`'s own "running one
# sweep" step.
#
#   bin/qa_sweep                     # least-recently-swept waiting target
#   bin/qa_sweep banking              # a named target, by its own reference
#   bin/qa_sweep pizzas --seeds 25    # more seeded sequences per sweep
#   bin/qa_sweep pizzas --steps 50    # longer sequences per sweep
#   bin/qa_sweep --all                # every currently-waiting target, in parallel
#   bin/qa_sweep --all --seeds 25     # same, more seeded sequences per target
#   bin/qa_sweep pizzas --adversarial 0.5   # mutate half the generated command steps
#   bin/qa_sweep --all --adversarial 0      # turn adversarial generation OFF
#   bin/qa_sweep pizzas --self-consistency false   # differential comparison only
#   bin/qa_sweep directory --persistence-parity   # Memory vs real PostgresEra, one target only
#   bin/qa_sweep banking --release --notes "…"    # a PERSON puts a suspended target back (see below)
#
# ADVERSARIAL BY DEFAULT. Every sequence this script generates goes
# through `SequenceGenerator`'s adversarial layer (`lib/hecks/fuzzing/
# sequence_generator/adversary.rb` — the argument shapes BUG#7–#16 were
# actually found through: an undeclared `to:`/`with:`/`id:` on flat
# args, a blank creating identity, a single-field value object as bare
# null/`{}`, a duplicate caller-supplied entity identity, a mapped
# argument left out, an unknown+mismatched+absent triple, and a
# preference for entity commands two or more hops deep). The FRACTION of
# command steps mutated is `QualityControlDials::ADVERSARIAL_FRACTION`
# (top of qa/bluebook/quality_control.bluebook — the same place
# `CADENCE_SECONDS`/`PR_CAP_PER_DAY` live, and for the same reason: a
# human's number, changed by editing that file). `--adversarial N`
# overrides it for one run; `--adversarial 0` turns the layer off
# entirely, which reproduces exactly the sequences this script generated
# before the layer existed (same seed, same steps — the layer draws
# nothing from the RNG when off). `--all` forwards whichever value it
# resolved to every child it spawns. The "reproduce:" line on a FOUND
# SOMETHING report carries the `adversarial:` fraction that was in
# effect, and every step that was mutated is listed with what was done
# to it, so the Bug can name the mechanism.
#
# A SECOND COMPARISON AXIS, ALSO ON BY DEFAULT. Every check described
# above is DIFFERENTIAL — Ruby vs the compiled Rust conformance binary
# (`diff_ruby_vs_rust`), or, with no binary, Ruby's own declared
# properties (`ruby_only_outcome`). Differential comparison can never
# catch a bug where both engines are wrong the SAME way, or where one
# engine is self-inconsistent with nothing to differentially compare it
# against. `Hecks::Fuzzing::SelfConsistency` (lib/hecks/fuzzing/
# self_consistency.rb — read that file's own header for the full
# mechanism) asks a DIFFERENT question of the SAME already-generated
# sequence and its already-produced state — adversarially mutated or
# not, the two layers compose for free: this pass reads whatever
# `history` the dispatch of THAT sequence produced, with no idea whether
# it was adversarial — does ONE engine agree with ITSELF? Cold
# rehydration from its own durable journal, replay idempotency, and
# every value object's own JSON round trip, on Ruby; the compiled
# binary's own `"seed"`-based rehydration door, on Rust, whenever one
# exists to ask. `QualityControlDials::SELF_CONSISTENCY_CHECKS` (qa/
# bluebook/quality_control.bluebook, same file/same pattern
# `ADVERSARIAL_FRACTION` lives in) is the dial; `--self-consistency
# true`/`--self-consistency false` overrides it for one run. A
# self-consistency finding is reported and exits exactly the way a
# differential divergence already does (see `run_one_seed`'s own
# `divergences` array, below) — this is not a second report format, it
# is more entries in the same one. NOT wired into `--persistence-parity`
# below — that mode already pays for real Postgres I/O per dispatch
# (`PERSISTENCE_PARITY_SEED_CAP` exists specifically to bound that cost),
# and self-consistency's own Heki-backed cold reads are real disk I/O of
# their own; compounding both costs onto one already-expensive,
# deliberately-capped mode was left out on purpose, not missed.
#
# `--persistence-parity` — A GENUINELY NEW AXIS, NOT A REPLACEMENT for the
# Ruby-vs-Rust differential mode above: Memory vs a real, disposable
# `PostgresEra` database, both sides the SAME Ruby engine
# (`Hecks::Fuzzing::PersistenceParity`, lib/hecks/fuzzing/persistence_
# parity.rb — read its own header for the full design). Opt-in and
# single-target only (never `--all`, see the abort just below argument
# parsing) for two reasons: cost (a real `PG.connect` and real SQL per
# dispatch — `QualityControlDials::PERSISTENCE_PARITY_SEED_CAP`,
# qa/bluebook/quality_control.bluebook, clamps `--seeds` down for exactly
# this reason) and relevance (only a domain that actually binds
# `PostgresEra` gains anything from this comparison at all — see the
# eligibility check right after target resolution, below). This script
# owns the disposable database's own lifecycle — created once, up front,
# a throwaway schema unique to THIS sweep dropped again once it ends,
# clean or surprised — never a shared, leaked-forever scratch database the
# way `IsolatedBoot`'s own `:postgres` mode uses for `bin/fuzz`; see
# `rebind_to_postgres_era!`'s own header (isolated_boot.rb) for why that
# distinction matters here specifically.
#
# CLEAN-STREAK DEPTH ESCALATION — WHY TWO SWEEPS OF THE SAME TARGET CAN
# RUN A DIFFERENT NUMBER OF SEEDS. A fixed `--seeds 10 --steps 25` forever
# tests a target identically on its first ever pass and its five-hundredth
# clean pass in a row — and real bugs this practice found (BUG#14/#15/#16)
# turned up at seeds 2-4 on targets whose own seed 1 held clean, which a
# permanently shallow sweep would never reach. So `--seeds`/`--steps`, when
# neither is given explicitly, are DERIVED from `Target.clean_streak`
# (qa/bluebook/quality_control.bluebook) — how many consecutive clean
# releases this target has racked up since anything last surprised it:
#
#   clean_streak    seeds   steps    (tier)
#   0-4             10      25       fresh, or just surprised — the old default
#   5-19            25      50       proven clean for a while — go wider
#   20+             50      100      the ceiling — never wider than this
#
# See `QualityControlDials::WIDENING_TIERS` (qa/bluebook/quality_control.
# bluebook — a DIAL now, edited and reviewed where every other dial is,
# not policy data living in this script) for the exact table and the
# reasoning behind its own three numbers, and `Hecks::Fuzzing::SweepDepth
# .for_streak` (lib/hecks/fuzzing/sweep_depth.rb) for the one reader of
# it, called below exactly the way `RotationPriority.pick` already is.
#
# `--seeds N` / `--steps N` ON THE COMMAND LINE ALWAYS WIN — exactly the
# way `--seeds` already overrode the single old default, before this
# feature existed. Given explicitly, either flag is used VERBATIM and the
# streak is never consulted for that one; omitted, the streak decides.
# `--all` passes an explicit override through to every child it spawns
# uniformly (every target swept at the same forced depth); omitted, each
# child derives its OWN depth from its OWN target's OWN streak, since two
# targets in the same rotation rarely share one.
#
# THIS COMPOSES WITH ADVERSARIAL MODE, SELF-CONSISTENCY, AND PERSISTENCE-
# PARITY, NOT AGAINST ANY OF THEM — every dial above answers a different
# question (what shape of sequence to generate, whether an engine agrees
# with itself, which adapter to compare against) than this one does (how
# many sequences, how long each is). None of them reads another's own
# constant, and none needed to change to thread this one through.
#
# EXIT CODES — the only contract an agent (or a loop) needs to read:
#   0  clean — every generated sequence held, the sweep concluded and the
#      target released. Nothing else to do; relay the printed summary.
#   1  an operational error — the ledger would not boot, the named target
#      does not exist, it is already held by somebody else and the claim
#      has not gone stale, `--seeds` was not a positive integer, and so
#      on. Fix the actual problem; there is nothing here for an agent to
#      pick up as QA work.
#   2  FOUND SOMETHING — a generated sequence surprised the check. The
#      sweep is left OPEN and the target is SUSPENDED — by the ledger's
#      own `SuspendOnSurprise` policy (qa/bluebook/quality_control.
#      bluebook, its own foot), the moment `Sweep.Check.Surprised` lands
#      carrying the target's reference, not by anything this script
#      dispatches on its own. No Bug is logged (that step needs a
#      human/agent judgment call, never this script's own guess — `bin/
#      qa_log_bug` is the door for it), and nothing is concluded or
#      released: a suspended target stays out of `Target.Rotation` AND
#      out of `--all`'s stale-hold reclaim until a PERSON runs
#      `bin/qa_sweep <target> --release --notes "…"` (below). Full
#      reproduction details are on stdout, above the exit.
#
# `--release --notes "…"` — THE ONE VERB HERE A PERSON RUNS, NOT THE LOOP.
# A suspended target comes back through exactly the arithmetic the clean
# path runs at the bottom of this file, and nowhere else: every sweep
# still open against the target is concluded with the notes given (or
# abandoned, if it never made a check — `Sweep.Conclude` refuses those),
# the bugs those sweeps logged (`Bug.FoundIn`) are counted as this
# period's yield, `next_streak` is 0 if any check ever surprised, and
# `Target.Release` is dispatched with all of that plus the capabilities
# this script infers for the chapter (`inferred_capabilities`, below).
# SKILL.md used to walk a human through that arithmetic by hand; a
# person now types the notes and nothing else. `--release` also works
# on a merely `held` target (a stale hold whose release never landed)
# — `Target.Release` accepts both — but never on a `waiting` one.
#
# `--all` — WHY A SECOND MODE OF THE SAME SCRIPT, NOT A SEPARATE ONE.
# Sweeping the whole rotation used to mean dispatching one LLM subagent
# per waiting target, each babysitting its own `bin/qa_sweep <target>`
# run — real wall-clock cost (and real token cost) paid just to fan work
# out that has no judgment in it at all on the clean path. `--all` makes
# the routine case genuinely mechanical: query the rotation once, spawn
# one REAL `bundle exec ruby bin/qa_sweep <target> --seeds N` OS process
# per waiting target — the exact same single-target path this file
# already has, run as a normal, independent invocation of THIS SAME
# SCRIPT, not a copy of its logic — wait for all of them, and print one
# consolidated report.
#
# BOUNDED, SINCE `QualityControlDials::SWEEP_MAX_PARALLEL` EXISTS. `--all`
# used to spawn every waiting target at once — on a ten-target rotation,
# ten concurrent Rust conformance builds and ten Ruby runtimes on one
# machine. `run_pool` below keeps at most the dial's worth alive, and
# starts the next the moment one exits (`Process.wait2(-1)`), so the
# whole pass still takes roughly as long as the slowest FEW targets, not
# the sum of all of them, without ever fanning out past what the dial
# allows.
#
# AND IT RECLAIMS STALE HOLDS. "A claim that goes stale is taken by
# whoever is next" (the ledger's own header) — `Target.Claim`'s given
# already lets a `held` target be re-claimed once `claimed_at + window
# <= now`, but `Target.Rotation` is `where(status: "waiting")` alone and
# nothing ever OFFERED a stale hold to `--all`. So a hold whose release
# never landed (a child killed mid-sweep, a machine that slept) dropped
# out of the rotation for good, silently — found live 2026-09-11, eight
# of ten targets sitting `held` by `qa_sweep` on claims hours old, and
# `--all` printing "rotation is empty". `stale_holds` below is that
# given's arithmetic restated in Ruby (a `where` cannot add two fields),
# and every row it returns is queued beside the waiting ones and named
# in the report ("reclaimed stale hold: …"). `suspended` and `shelved`
# are NOT reclaimed, by design: both wait for a person.
#
# A SPAWNED PROCESS, DELIBERATELY, NOT `Kernel#fork`. By the time `--all`
# picks a target, this process has already called `Hecks.boot`, which
# means it already holds a live Postgres connection (`QualityControl`'s
# own ledger is `PostgresEra`-backed — see `qa/bluebook/quality_control.
# hecksagon`). `fork`ing after that duplicates this process's own file
# descriptors, the live socket included — the child inherits a copy of
# the SAME connection and any write either process makes down it can
# corrupt what the other reads. `Process.spawn` sidesteps this
# entirely: each child execs a genuinely fresh `ruby`, which means a
# fresh `Hecks.boot`, which means its OWN Postgres connection, opened
# from scratch — exactly what an ordinary `bin/qa_sweep <target>` already
# does today, run one more time.
#
# WHY THIS IS SAFE WITHOUT A SECOND LOCK OF ITS OWN. Every child names a
# DIFFERENT target — this process enumerates the rotation exactly once,
# up front, and never lets a child auto-pick (see `run_all_mode` below);
# two children can never even attempt the same claim. What actually
# guards against a collision — a child racing some OTHER concurrent
# sweep (another `--all` run, a human's own manual `bin/qa_sweep
# <target>`, a stale claim's window closing at just the wrong moment) —
# is `QualityControl::Target.claim!`'s own `given` clause, dispatched
# against a `PostgresEra`-bound aggregate: `run_dispatch_order_with_
# isolation` (`lib/hecks/runtime/interpreting.rb`) takes a REAL Postgres
# advisory lock (`with_write_lock`, ADR 0036) for the whole hydrate-
# through-save of that dispatch, from EVERY process touching this ledger,
# not just this script's own children. `--all` adds no concurrency
# control of its own because none is needed — the ledger it dispatches
# against already had to be safe for exactly this shape of access
# (`rust/host` talking to the same tables from its own separate OS
# process), and `spec/adapters/driven/postgres_era_concurrent_dispatch_
# spec.rb` proves that mechanism directly, with real forked processes,
# already.
#
# WHAT THIS REUSES RATHER THAN REINVENTS — see each file's own header:
#   `Hecks::Fuzzing::SequenceGenerator` / `Hecks::Fuzzing::Replay` — the
#     exact seeded-sequence generation and in-process replay `bin/fuzz`
#     and `spec/rust_conformance_fuzz_spec.rb` already use.
#   `Hecks::Fuzzing::Properties.check` — the single-runtime property/
#     exception battery `bin/fuzz` grades a generated sequence against,
#     used here as the fallback when a domain has no compiled Rust
#     binary to differential-fuzz against instead (not every domain
#     does — `rust/Cargo.toml` declares a feature per domain that has
#     one; `qa/stress_domains/ledger_ordering/NOTES.md` is the exact,
#     already-documented case of a domain this repository shipped
#     WITHOUT one).
#   `RustConformanceHelpers` (spec/support/rust_conformance_helpers.rb)
#     — the Ruby-vs-Rust build/diff/known-gap-filtering machinery
#     `spec/rust_conformance_fuzz_spec.rb` itself is built on. Required
#     directly from spec/support/ rather than re-derived: it declares no
#     RSpec dependency of its own (only `fileutils`), so it is exactly
#     as reusable from a bin/ script as from a spec file.
#
# THE ENTITY-ADDRESSING CONVENTION — SPELLED OUT BECAUSE IT IS EASY TO
# GET WRONG THE OTHER WAY. `Sweep.Check.Held`/`.Surprised` are ENTITY
# commands (`entity "Check"` inside `aggregate "Sweep"`,
# qa/bluebook/quality_control.bluebook). The CLI form (`bin/run ... held
# to.aggregate=<sweep-id> to.entity=<n> ...`) projects that addressing as
# TWO separate arguments — see `Projector::CliProjector#receiver_options`
# — but that is a CLI-LAYER translation, not what the runtime itself
# wants. Dispatched directly, in-process, the way this script and
# `spec/quality_control_spec.rb`'s own `check` helper both do it, it is
# `id: <the Sweep's own id>` plus the entity's own identity attribute
# (`sequence: { value: n }`) as an ordinary command argument — confirmed
# live against a real boot of this exact chapter while this script was
# being written, not assumed from reading the CLI projector alone.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
# ADR 0033 — see bin/run's own identical require: the era/lineage
# subsystem no longer loads with core, and this ledger's `persisted_by
# "PostgresEra"` binding (`qa/bluebook/quality_control.hecksagon`) needs
# it explicitly — `PostgresEra` IS the era plugin's own adapter.
require "hecks/ports/persistence/plugins/era"
require "hecks/fuzzing"
require "hecks/fuzzing/self_consistency"
require "json"
require "open3"
require "tempfile"
require "securerandom"

ROOT = File.expand_path("..", __dir__)
require_relative "../spec/support/rust_conformance_helpers"

# `QA_SWEEP_DOMAIN_DIR` — an escape hatch, not a feature. Every REAL
# invocation of this script, single-target or `--all`, boots the one
# true ledger at `qa/bluebook`; nothing here ever points anywhere else
# on its own. The override exists ONLY so an isolated spec can stand up
# its own throwaway `QualityControl`-shaped ledger (same `.bluebook`,
# a fixture `.hecksagon`/`.world` pointing at a disposable Postgres
# database) and drive REAL `bin/qa_sweep`/`bin/qa_sweep --all`
# subprocesses against it — proving the actual claim/spawn/aggregate
# mechanics this file implements, not a stand-in for them, without
# leaving the practice's own live rotation different after every CI run
# (`spec/quality_control_spec.rb`'s own header explains why that would be
# unacceptable). `--all` spawns children with `Process.spawn`'s default
# environment inheritance, so setting this once in a parent process's own
# `ENV` reaches every child it spawns for free.
DOMAIN_DIR         = ENV.fetch("QA_SWEEP_DOMAIN_DIR", File.join(ROOT, "qa/bluebook"))

# `QA_SWEEP_RUST_DIR` — THE SAME ESCAPE HATCH, ONE LEVEL OVER. Every REAL
# invocation builds/diffs against the one true `rust/` crate; nothing
# here ever points anywhere else on its own. The override exists ONLY so
# an isolated spec can point a real `bin/qa_sweep` subprocess's
# differential mode at its OWN small, hand-maintained fixture Cargo
# crate instead — `spec/qa_sweep_all_spec.rb`'s own "found something"
# example, and that fixture crate's own `Cargo.toml` header, explain why:
# a divergence this spec owns outright, forever, rather than one that
# depends on this repository's own live `qa/stress_domains/` rotation
# staying broken to keep proving anything. `RustConformanceHelpers#
# build_rust_for`/`#build_and_pin` already take `rust_dir` as a plain
# argument — this constant is the only thing that needed to stop being
# hardcoded for that to reach all the way through.
RUST_DIR           = ENV.fetch("QA_SWEEP_RUST_DIR", File.join(ROOT, "rust"))
DEFAULT_TARGETS    = { "pizzas" => "examples/pizzas", "banking" => "examples/banking" }.freeze

EXIT_OK = 0
EXIT_ERROR           = 1
EXIT_FOUND_SOMETHING = 2

USAGE = "usage: bin/qa_sweep [target-reference] [--seeds N] [--steps N] [--adversarial FRACTION] " \
        "[--self-consistency true|false]\n       " \
        "bin/qa_sweep --all [--seeds N] [--steps N] [--adversarial FRACTION] " \
        "[--self-consistency true|false]\n       " \
        "bin/qa_sweep <target-reference> --persistence-parity [--seeds N]\n       " \
        "bin/qa_sweep <target-reference> --release --notes \"what a person concluded, 40+ chars\"".freeze

# `PostgresEra`-BOUND ONLY — the one signal this script uses to decide a
# target is worth the real `PG.connect`-per-dispatch cost
# `--persistence-parity` pays (see this file's own top-of-file comment).
# A domain with no `persisted_by("PostgresEra")` binding at all — every
# domain in the DEFAULT rotation today (pizzas, banking) — would just
# have `IsolatedBoot#rewrite_bindings!` force one onto it that its own
# `.world` never declared, comparing Memory against an adapter the domain
# was never meant to run under: trivial agreement at best (ordinary
# aggregate command dispatch doesn't touch the adapter at all), a
# meaningless "PostgresEra refuses this domain's own real binding"
# confusion at worst. Matches BOTH spellings `IsolatedBoot#rewrite_
# bindings!` itself already has to catch — aggregate-scoped
# (`Directory::Member.persisted_by("PostgresEra")`) and the bare,
# domain-level default (`persisted_by "PostgresEra"`, no parens, no
# receiver).
POSTGRES_ERA_BINDING = /persisted_by\s*\(?\s*"PostgresEra"/

def postgres_era_bound?(domain_path)
  Dir.glob(File.join(domain_path, "**", "*.hecksagon")).any? do |path|
    File.read(path).match?(POSTGRES_ERA_BINDING)
  end
end

# A THIN WRAPPER, NOT A REWRITE — `RustConformanceHelpers` is a plain
# module of instance methods meant to be `include`d into an RSpec example
# group; this is the same `include`, on a class with no RSpec anywhere
# near it, so the exact same build/diff/filter methods
# `spec/rust_conformance_fuzz_spec.rb` calls on `self` are called here on
# an instance instead.
class Differ
  include RustConformanceHelpers
end

# ── argument parsing ─────────────────────────────────────────────────
#
# `seeds_override`/`steps_override` START NIL, NOT AT A DEFAULT — nil is
# what says "the caller named nothing, derive it from the streak instead"
# (see `SweepDepth.for_streak`, below); a plain `10`/`25` here, the way `seeds`
# alone used to default, could never be told apart from a caller who
# typed `--seeds 10` on purpose, and the override would silently stop
# overriding anything once the streak-derived default ALSO happened to
# land on 10.

target_ref     = nil
seeds_override = nil
steps_override = nil
all_mode       = false
# `nil` until resolved — the dial is read AFTER the ledger boots (the
# bluebook file is what defines `QualityControlDials`), so an explicit
# `--adversarial`/`--self-consistency` is remembered here and the dial
# only consulted when none was given.
adversarial = nil
self_consistency = nil
persistence_parity_mode = false
release_mode  = false
release_notes = nil

until ARGV.empty?
  arg = ARGV.shift
  case arg
  when "-h", "--help"
    puts USAGE
    exit EXIT_OK
  when "--all"
    all_mode = true
  when "--persistence-parity"
    persistence_parity_mode = true
  when "--release"
    release_mode = true
  when "--notes"
    release_notes = ARGV.shift
    abort "#{USAGE}\n--notes needs the text a person concluded" unless release_notes
  when "--seeds"
    value = ARGV.shift
    abort "#{USAGE}\n--seeds needs a number" unless value

    begin
      seeds_override = Integer(value)
    rescue ArgumentError
      abort "#{USAGE}\n--seeds must be an integer, got #{value.inspect}"
    end
  when "--steps"
    value = ARGV.shift
    abort "#{USAGE}\n--steps needs a number" unless value

    begin
      steps_override = Integer(value)
    rescue ArgumentError
      abort "#{USAGE}\n--steps must be an integer, got #{value.inspect}"
    end
  when "--adversarial"
    value = ARGV.shift
    abort "#{USAGE}\n--adversarial needs a fraction between 0 and 1" unless value

    begin
      adversarial = Float(value)
    rescue ArgumentError
      abort "#{USAGE}\n--adversarial must be a number, got #{value.inspect}"
    end
    abort "#{USAGE}\n--adversarial must be between 0 and 1, got #{value}" unless adversarial.between?(0, 1)
  when "--self-consistency"
    value = ARGV.shift
    abort "#{USAGE}\n--self-consistency needs true or false" unless value

    case value
    when "true"  then self_consistency = true
    when "false" then self_consistency = false
    else abort "#{USAGE}\n--self-consistency must be true or false, got #{value.inspect}"
    end
  else
    abort "#{USAGE}\nunexpected argument: #{arg.inspect} (target already given: #{target_ref.inspect})" if target_ref

    target_ref = arg
  end
end

if seeds_override
  abort "#{USAGE}\n--seeds must be at least 1 — Sweep.Conclude refuses a sweep that checked nothing" if seeds_override < 1
end
abort "#{USAGE}\n--steps must be at least 1" if steps_override && steps_override < 1

if all_mode && target_ref
  abort "#{USAGE}\n--all sweeps every waiting target itself — it does not take a target-reference " \
        "(got #{target_ref.inspect})"
end

if all_mode && persistence_parity_mode
  abort "#{USAGE}\n--persistence-parity is single-target only (a real Postgres connection per dispatch, " \
        "genuinely expensive — see this file's own top-of-file comment) — it does not combine with --all"
end

if persistence_parity_mode && !target_ref
  abort "#{USAGE}\n--persistence-parity needs an explicit target-reference — it never auto-picks from the " \
        "rotation, since only a PostgresEra-bound domain gains anything from this comparison at all " \
        "(see this file's own top-of-file comment)"
end

if release_mode
  abort "#{USAGE}\n--release needs an explicit target-reference — the suspended target a person is putting back" unless target_ref
  unless release_notes
    abort "#{USAGE}\n--release needs --notes — what a person concluded is the one thing this script cannot supply"
  end
  if all_mode || persistence_parity_mode
    abort "#{USAGE}\n--release is its own mode — it does not combine with --all or --persistence-parity"
  end
end
abort "#{USAGE}\n--notes only means something with --release" if release_notes && !release_mode

# ── boot the ledger for real ───────────────────────────────────────────
#
# `Hecks.boot` with `install_facade` at its default (true) — exactly what
# bin/run's own JSON step-list form does — so `QualityControl::Target`,
# `QualityControl::Sweep` and friends land as real top-level constants
# this script dispatches through directly, the same door
# spec/quality_control_spec.rb uses.

runtime = begin
  Hecks.boot(DOMAIN_DIR)
rescue StandardError => e
  abort "the QualityControl ledger did not boot — fix the ledger itself before sweeping against it " \
        "(#{e.class}: #{e.message})"
end

def q(runtime, name, **args) = runtime.query("QualityControl::#{name}", **args)

# THE DIALS, read once the boot above has loaded the bluebook that
# defines them — `QualityControlDials` is a constant in qa/bluebook/
# quality_control.bluebook itself, not something this script carries a
# copy of. A ledger without a dial (an isolated spec's own fixture, say)
# runs the adversarial layer OFF (0.0) but self-consistency checking ON
# (`true`) — self-consistency checking needs no dial-declaring ledger to
# be worth running, unlike the adversarial layer's own "off is the safe
# default" stance.
adversarial ||= defined?(QualityControlDials::ADVERSARIAL_FRACTION) ? QualityControlDials::ADVERSARIAL_FRACTION.to_f : 0.0
if self_consistency.nil?
  self_consistency = defined?(QualityControlDials::SELF_CONSISTENCY_CHECKS) ? QualityControlDials::SELF_CONSISTENCY_CHECKS : true
end

# THE LOOP'S OWN IDENTITY, FROM THE DIAL — `held_by` on every claim this
# script takes, `engineer` on every sweep it opens, and the one literal
# `WaivedBy` (the ledger's own value object) refuses. Named in the
# bluebook rather than here so the refusal and the identity it refuses
# are edited in the same file; the fallback is the same literal, for a
# dial-less fixture ledger.
ENGINEER = defined?(QualityControlDials::AUTOMATED_ENGINEER) ? QualityControlDials::AUTOMATED_ENGINEER : "qa_sweep"

# THE WIDENING TABLE, FROM THE DIAL — `Hecks::Fuzzing::SweepDepth`'s own
# `DEFAULT_TIERS` is the identical three rows, for a ledger that declares
# none; read that module's header for why the table left this file.
WIDENING_TIERS = defined?(QualityControlDials::WIDENING_TIERS) ? QualityControlDials::WIDENING_TIERS : Hecks::Fuzzing::SweepDepth::DEFAULT_TIERS

# HOW MANY CHILDREN `--all` KEEPS ALIVE AT ONCE — see the top-of-file
# comment on the bounded pool. Four is the dial's own default too; a
# dial-less ledger gets the same number rather than the old unbounded
# fan-out.
SWEEP_MAX_PARALLEL = defined?(QualityControlDials::SWEEP_MAX_PARALLEL) ? QualityControlDials::SWEEP_MAX_PARALLEL : 4

# ── release arithmetic, shared by the clean path and --release ────────
#
# WHAT THIS SCRIPT CAN ALREADY TELL ABOUT A CHAPTER, RECORDED ON RELEASE
# — `Target.Release`'s `capabilities` (see that attribute's own comment
# in the bluebook: STORED so `Target.EligibleFor` can answer, never the
# decider of what runs). Two facts this script already derives for its
# own purposes: `postgres_era` from the same `.hecksagon` grep that gates
# `--persistence-parity`, and `rust` from `rust/Cargo.toml` declaring a
# feature named after the chapter — the exact test `RustConformance
# Helpers#build_rust_for` makes before it ever builds, restated here
# without the build so `--release` can answer it too. Comma-joined, the
# `Capabilities` value object's own shape.
def inferred_capabilities(domain_path)
  feature = File.basename(domain_path).downcase
  cargo_toml = File.join(RUST_DIR, "Cargo.toml")
  rust = File.exist?(cargo_toml) && File.read(cargo_toml).match?(/^#{Regexp.escape(feature)}\s*=\s*\[\]/)

  [("rust" if rust), ("postgres_era" if postgres_era_bound?(domain_path))].compact.join(",")
end

# `next_streak` — SEE `Target::Release`'s OWN COMMENT (qa/bluebook/
# quality_control.bluebook) FOR WHY THIS SCRIPT, NOT THE LEDGER, DOES
# THIS ARITHMETIC. Reads the STICKY per-check `ever_surprised` bit rather
# than trusting any loop's own local — belt and braces: the seed loop
# below always breaks the instant ANY seed surprises, but `Sweep::
# Conclude`/`Target::Release` are also reachable from `bin/run` by hand,
# and a call path that resolves a surprise (`Remake` then `Held`) before
# concluding must never read as clean just because the CURRENT outcome
# says "held" — that is exactly the case `ever_surprised` exists to
# still catch. `--release` reads it across every sweep it concludes.
def sweep_was_clean?(sweep)
  sweep.checks.none? { |c| c[:ever_surprised][:value] == "yes" }
end

# THE RELEASE ITSELF — one place, both callers. Decays whatever the
# target's `yield_score` already was and adds this period's own finds
# (`RotationPriority.next_yield_score`'s own comment), moves the streak
# the way `Target::Release`'s comment says the caller must, and records
# what this script inferred the chapter can be compared against.
def release_target!(target, domain_path, current_streak, surprises:, clean:)
  next_yield_score = Hecks::Fuzzing::RotationPriority.next_yield_score(
    old_score: target.yield_score.value, surprises_this_period: surprises
  )
  target.release!(now: { value: Time.now.to_i }, yield_score: { value: next_yield_score },
                  next_streak: { value: clean ? current_streak + 1 : 0 },
                  capabilities: { value: inferred_capabilities(domain_path) })
end

# ── --all: every waiting target, genuinely in parallel ────────────────
#
# See this file's own top-of-file comment ("`--all` — WHY A SECOND MODE
# OF THE SAME SCRIPT...") for the full design rationale. The four
# methods below are just its mechanics, kept separate from each other
# the same way the rest of this file already separates "run one seed"
# from "log it" from "report it": each stays small enough to read in one
# piece, and each is exactly what a spec exercises to prove its own one
# claim (real parallelism, no interleaved output, correct precedence).

# One REAL child process per target — an ordinary `bin/qa_sweep
# <target> --seeds N`, run through `bundle exec` exactly the way a human
# would type it by hand, with its combined stdout/stderr landing in a
# private, already-unlinked temp file rather than this process's own.
# `Process.spawn` returns immediately; nothing here blocks on the child,
# which is what lets the caller spawn every target before waiting on
# any of them (see `run_all_mode` below).
#
# `seeds_override`/`steps_override` ARE FORWARDED ONLY WHEN THE TOP-LEVEL
# CALLER ACTUALLY GAVE ONE — omitted (nil), each child derives its OWN
# depth from its OWN target's OWN `clean_streak`, exactly as an ordinary
# single-target `bin/qa_sweep <target>` already does with no `--all` in
# sight. Forwarding a streak-derived NUMBER computed up here instead would
# force every target in the rotation through whatever streak the FIRST
# one happened to have — the opposite of the whole point, since two
# targets in the same rotation essentially never share a streak.
# `--adversarial`/`--self-consistency`, BY CONTRAST, ARE ALWAYS forwarded,
# as the values THIS process resolved (flag or dial) — every child sweeps
# under the same settings its parent reported, rather than each
# re-reading the dials.
def spawn_sweep_child(target_reference, seeds_override, steps_override, adversarial, self_consistency)
  # Unlinked the instant it's open: the fd stays good for this
  # process's own later `rewind`/`read` (ordinary POSIX "delete while
  # open" semantics), but nothing survives on disk if this process
  # itself dies before ever reading it back — no cleanup step to
  # forget, and no fixed path a second concurrent `--all` run could
  # collide on.
  log = Tempfile.new(["qa_sweep-#{target_reference}-", ".log"])
  log.unlink

  args = [target_reference]
  args += ["--seeds", seeds_override.to_s] if seeds_override
  args += ["--steps", steps_override.to_s] if steps_override
  args += ["--adversarial", adversarial.to_s, "--self-consistency", self_consistency.to_s]

  pid = Process.spawn(
    "bundle", "exec", "ruby", File.join(ROOT, "bin/qa_sweep"), *args,
    out: log, err: log, chdir: ROOT
  )

  { target: target_reference, pid: pid, log: log }
end

# Reads back everything ONE already-exited child ever wrote. `status` is
# what `run_pool`'s own `Process.wait2(-1)` handed back for it — the
# reaping happens there, once for whichever child finishes next, which
# is what lets the pool refill without ever blocking on a specific pid.
def collect_sweep_child(child, status)
  child[:log].rewind
  output = child[:log].read
  child[:log].close

  { target: child[:target], exit_status: status.exitstatus, termsig: status.termsig, output: output }
end

# THE BOUNDED POOL — at most `max_parallel` children alive at once, the
# next spawned the instant any one exits. `Process.wait2(-1)` reaps
# whichever child finishes first (every child of this process is one of
# ours — nothing else is spawned concurrently), and `running` maps its
# pid back to the record `spawn_sweep_child` returned. Results come back
# in the ORDER THE TARGETS WERE QUEUED, not the order they finished, so
# the report reads the same way twice for the same rotation.
def run_pool(targets, max_parallel)
  pending = targets.dup
  running = {}
  results = {}

  until pending.empty? && running.empty?
    while running.size < max_parallel && (next_target = pending.shift)
      child = yield(next_target)
      running[child[:pid]] = child
    end

    pid, status = Process.wait2(-1)
    child = running.delete(pid)
    next unless child

    results[child[:target]] = collect_sweep_child(child, status)
  end

  targets.map { |target| results.fetch(target) }
end

# THE STALE-HOLD ARITHMETIC, `Target.Claim`'s OWN GIVEN RESTATED — see the
# top-of-file comment on why `--all` reclaims these at all. `now` is an
# argument for the same reason it is everywhere else in this practice: a
# pure function cannot ask the time.
def stale_holds(runtime, now)
  q(runtime, "Target.Held").select { |row| row[:claimed_at][:value] + row[:window][:value] <= now }
end

# ONE REPORT, never an interleaved one — every child's own output was
# captured into its OWN file the whole time (see `spawn_sweep_child`),
# so nothing here is racing anything else's `puts`; this just decides
# what order to print already-complete strings in. A clean target gets
# one line; an operational error gets its real message (short, but
# still the actual problem, not a summary of it); a genuine finding
# gets its FULL structured report, byte for byte — chapter, seed,
# reproduction steps, subject/expectation/observation, the divergence
# detail — because a human or a follow-up subagent has to act on
# exactly that, and a summary would be the one thing standing between
# them and doing so correctly.
#
# THE ONE LINE EVERY CHILD PRINTS, PARSED BACK OUT — every ordinary
# `bin/qa_sweep <target>` run (this method's own caller included, since
# `--all`'s children ARE ordinary runs) prints exactly one line of this
# shape (see `puts "resolved depth: ..."` below, in the single-target
# path) the moment it has claimed a target and worked out how hard to
# fuzz it. Scraping stdout instead of, say, a second IPC channel back to
# the parent is deliberate: the child's own log is ALREADY the single
# source of truth `print_all_mode_report` prints verbatim for a real
# finding, so reading the SAME text back out here can never disagree with
# what a human reading that report also sees.
RESOLVED_DEPTH_LINE = /^resolved depth: seeds=(\d+) steps=(\d+) \(clean_streak=(\d+)\)$/

def resolved_depth_for(output)
  match = output.match(RESOLVED_DEPTH_LINE)
  return "depth unknown (target errored before it could claim)" unless match

  "#{match[1]} seeds x #{match[2]} steps (clean streak #{match[3]})"
end

# EVERY TARGET, ITS OWN RESOLVED DEPTH — so a human can tell a target
# that just came off a 20-sweep clean streak (widest tier) from one
# freshly added to the rotation (narrowest), without re-deriving either
# by hand from `Target.clean_streak` itself. Pulled out of
# `print_all_mode_report` on its own (rather than inlined there) purely
# to keep that method's own branching count down — the report's other
# three sections (clean/errored/found) were already each their own `if`
# before this one existed.
def print_resolved_depths(results)
  return if results.empty?

  puts
  puts "resolved depth (by target):"
  results.each { |r| puts "  #{r[:target]}: #{resolved_depth_for(r[:output])}" }
end

def print_operational_errors(errored)
  return if errored.empty?

  puts
  puts "OPERATIONAL ERRORS (#{errored.size}) — read each message, fix the actual problem, don't retry blind:"
  errored.each do |r|
    label = r[:exit_status] ? "exit #{r[:exit_status]}" : "killed by signal #{r[:termsig]}"
    puts
    puts "-- #{r[:target]} (#{label}) --"
    puts r[:output].strip
  end
end

def print_found_something(found)
  return if found.empty?

  puts
  puts "FOUND SOMETHING (#{found.size}) — full report per target below; act on every one:"
  found.each do |r|
    puts
    puts "#" * 72
    puts "# #{r[:target]}"
    puts "#" * 72
    puts r[:output]
  end
end

def print_all_mode_report(results, elapsed, clean, found, errored)
  puts "=" * 72
  puts "CONSOLIDATED REPORT — #{results.size} target(s) swept, #{elapsed.round(1)}s wall-clock " \
       "(genuinely parallel — not the sum of every target's own sweep time)"
  puts "=" * 72
  puts
  puts "clean (#{clean.size}): #{clean.empty? ? 'none' : clean.map { |r| r[:target] }.join(', ')}"

  print_resolved_depths(results)
  print_operational_errors(errored)
  print_found_something(found)
end

# THE PRECEDENCE — a genuine finding always outranks an operational
# hiccup elsewhere: exit 2 the moment ANY child found something, no
# matter how many OTHER children also errored; exit 1 only when nothing
# was found but at least one child hit an operational problem; exit 0
# only when every single child came back clean. This is the same order
# a human skimming the report above would want acted on first — a real
# Ruby/Rust divergence is the whole reason this practice exists, an
# operational hiccup ("the ledger wouldn't boot", "the claim was
# already stale") is "go look, then maybe retry" work, one rung down.
def all_mode_exit_code(found, errored)
  return EXIT_FOUND_SOMETHING unless found.empty?
  return EXIT_ERROR unless errored.empty?

  EXIT_OK
end

# rubocop:disable-next Metrics/AbcSize
def run_all_mode(runtime, seeds_override, steps_override, adversarial, self_consistency, max_parallel)
  now     = Time.now.to_i
  waiting = q(runtime, "Target.Rotation").map { |row| row[:reference][:value] }
  stale   = stale_holds(runtime, now)
  targets = waiting + stale.map { |row| row[:reference][:value] }

  if targets.empty?
    puts "rotation is empty — nothing waiting to sweep, and no stale hold to reclaim. Clean no-op."
    exit EXIT_OK
  end

  puts "sweeping #{targets.size} target(s), at most #{max_parallel} at once: #{targets.join(', ')} " \
       "(adversarial fraction #{adversarial}, self-consistency #{self_consistency})"
  stale.each do |row|
    puts "reclaimed stale hold: #{row[:reference][:value]} (held by #{row[:held_by][:value]}, " \
         "#{now - row[:claimed_at][:value]}s ago)"
  end
  puts

  started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  results = run_pool(targets, max_parallel) do |target_reference|
    spawn_sweep_child(target_reference, seeds_override, steps_override, adversarial, self_consistency)
  end
  elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at

  clean   = results.select { |r| r[:exit_status] == EXIT_OK }
  found   = results.select { |r| r[:exit_status] == EXIT_FOUND_SOMETHING }
  errored = results.reject { |r| [EXIT_OK, EXIT_FOUND_SOMETHING].include?(r[:exit_status]) }

  print_all_mode_report(results, elapsed, clean, found, errored)
  exit all_mode_exit_code(found, errored)
end

run_all_mode(runtime, seeds_override, steps_override, adversarial, self_consistency, SWEEP_MAX_PARALLEL) if all_mode

# ── pick a target ───────────────────────────────────────────────────

# EXISTENCE-CHECKED, NOT BLIND. `Target.Rotation` being empty does not
# mean nothing has ever been `Identify`d — a target that is currently
# `held` or `shelved` is invisible to `Rotation` too (it only answers
# `where(status: "waiting")`), and re-`Identify`ing an id that already
# exists is a real refusal, not a no-op. So this only mints the two
# defaults that are not already on file, under whatever status they are
# actually in.
def seed_default_targets!(runtime)
  existing = q(runtime, "Target.All").map { |row| row[:reference][:value] }
  DEFAULT_TARGETS.each do |reference, path|
    next if existing.include?(reference)

    QualityControl::Target.identify!(reference: { value: reference }, path: { value: path })
  end
end

# THE ONE CALLER OF `Hecks::Fuzzing::RotationPriority.pick` — see that
# module's own header for why: `--all` (`run_all_mode`, above) sweeps
# every row `Target.Rotation` returns regardless of order, so weighting
# changes nothing about it. This is the only place a SINGLE target gets
# picked with no name given, which is exactly where weighting toward
# recent yield (without starving an exhausted target — the floor in
# `RotationPriority.pick`) actually matters.
def pick_target_row(runtime, target_ref)
  if target_ref
    row = q(runtime, "Target.All").find { |r| r[:reference][:value] == target_ref }
    return row if row

    known = q(runtime, "Target.All").map { |r| r[:reference][:value] }
    abort "no such target: #{target_ref.inspect} — known targets: #{known.inspect}"
  end

  rotation = q(runtime, "Target.Rotation")
  if rotation.empty?
    seed_default_targets!(runtime)
    rotation = q(runtime, "Target.Rotation")
  end
  if rotation.empty?
    abort "the rotation is empty even after seeding pizzas/banking — nothing waiting to sweep " \
          "(every known target is currently held or shelved)"
  end

  Hecks::Fuzzing::RotationPriority.pick(rotation, now: Time.now.to_i)
end

target_row       = pick_target_row(runtime, target_ref)
target_reference = target_row[:reference][:value]
target_path      = target_row[:path][:value]
domain_path = File.join(ROOT, target_path)

abort "target #{target_reference.inspect} names a path that does not exist on disk: #{domain_path}" \
  unless File.directory?(domain_path)

# BEFORE THE CLAIM — an ineligible target here is an operational error
# (exit 1), not a finding, and must never leave the target held or a
# sweep open. See POSTGRES_ERA_BINDING's own comment above for why this
# is the one signal used.
if persistence_parity_mode && !postgres_era_bound?(domain_path)
  abort "target #{target_reference.inspect} (#{target_path}) declares no persisted_by(\"PostgresEra\") " \
        "binding in its own .hecksagon — --persistence-parity has nothing to compare Memory against for " \
        "this domain. examples/directory is the known example that qualifies."
end

# ── claim it ─────────────────────────────────────────────────────────

target = QualityControl::Target.find(target_reference)
abort "target #{target_reference.inspect} vanished between being queried and being claimed" unless target

# ── --release: a person puts a suspended target back ──────────────────
#
# BEFORE THE CLAIM, because a suspended target cannot be claimed at all
# (`Claim` is `from: ["waiting", "held"]`) — and must not be: the whole
# point of `suspended` is that no sweep runs against it until exactly
# this. See the top-of-file comment on `--release` for the arithmetic;
# `release_target!` above is the same call the clean path makes.
if release_mode
  unless %w[suspended held].include?(target.status)
    abort "target #{target_reference.inspect} is #{target.status.inspect}, not suspended (or held) — " \
          "nothing to release"
  end

  open_sweeps = q(runtime, "Sweep.Sweeping").select { |row| row[:target] == target.id }
                                            .map { |row| QualityControl::Sweep.find(row[:reference][:value]) }
  surprises = 0
  clean     = !open_sweeps.empty?
  open_sweeps.each do |sweep|
    surprises += q(runtime, "Bug.FoundIn", sweep_id: { value: sweep.id }).size
    clean &&= sweep_was_clean?(sweep)
    if sweep.made.value.positive? || sweep.waived.value.positive?
      begin
        sweep.conclude!(notes: { value: release_notes })
      rescue Hecks::Runtime::InvariantViolation => e
        abort "--notes was refused by Sweep.Conclude — #{e.message}"
      end
      puts "concluded #{sweep.id} (#{sweep.made.value} check(s), #{surprises} bug(s) logged against it so far)"
    else
      # NEVER MADE A CHECK — `Sweep.Conclude`'s own gate refuses it, and
      # rightly: nothing was tested. Abandoned, so it leaves `Sweeping`.
      sweep.abandon!
      puts "abandoned #{sweep.id} (it never made a check)"
    end
  end

  # NO OPEN SWEEP AT ALL — a stale hold whose sweep never opened (a
  # crash between claim and open). Nothing was watched, so nothing is
  # known: `clean` is false and the streak goes to zero, the bluebook's
  # own "zero means no streak yet — the narrowest, cheapest pass until
  # it has proven itself clean again" stance, never a guessed +1.
  puts "no open sweep against #{target_reference} — releasing with the streak reset" if open_sweeps.empty?

  target = release_target!(target, domain_path, target.clean_streak.value, surprises: surprises, clean: clean)
  puts "released #{target_reference} (was #{release_mode ? 'suspended/held' : target.status}) — " \
       "status #{target.status}, clean_streak #{target.clean_streak.value}, yield_score #{target.yield_score.value}, " \
       "capabilities #{target.capabilities.value.inspect}"
  exit EXIT_OK
end

begin
  target = target.claim!(held_by: { value: ENGINEER }, now: { value: Time.now.to_i })
rescue Hecks::Runtime::GivenNotMet => e
  abort "target #{target_reference.inspect} is already held and its claim has not gone stale yet (#{e.message})"
end

# ── size this pass ───────────────────────────────────────────────────
#
# READ ONCE, RIGHT AFTER CLAIMING, AND HELD — `current_streak` is used
# TWICE more below (sizing this sweep now, via `SweepDepth.for_streak`;
# computing `next_streak` for `Target::Release` once the sweep concludes
# clean) and nothing between here and there ever changes `clean_streak`
# out from under this process — only `Target::Release` itself would, and
# that dispatch is the very last thing this script ever does.
current_streak = target.clean_streak.value
default_seeds, default_steps = Hecks::Fuzzing::SweepDepth.for_streak(current_streak, tiers: WIDENING_TIERS)
seeds              = seeds_override || default_seeds
steps_per_sequence = steps_override || default_steps

# `QualityControlDials::PERSISTENCE_PARITY_SEED_CAP` — ONE MORE DIAL,
# ONLY MEANINGFUL FOR `--persistence-parity`, and applied AFTER `seeds`
# is finally resolved above (an explicit `--seeds`, or whatever the
# streak just widened to) — clamps DOWN, never up, and only when the
# flag is actually set: an ordinary differential sweep, streak-widened
# or not, is unaffected. Real PostgresEra I/O per dispatch is genuinely
# expensive, so a target that has earned the widest tier (50 seeds) on
# its own clean streak still gets capped down the same way an explicit
# `--seeds 50 --persistence-parity` would.
if persistence_parity_mode && seeds > QualityControlDials::PERSISTENCE_PARITY_SEED_CAP
  puts "note: --seeds #{seeds} exceeds QualityControlDials::PERSISTENCE_PARITY_SEED_CAP " \
       "(#{QualityControlDials::PERSISTENCE_PARITY_SEED_CAP}) — clamping down. Real PostgresEra I/O per " \
       "dispatch is genuinely expensive; edit that dial in qa/bluebook/quality_control.bluebook to run more."
  seeds = QualityControlDials::PERSISTENCE_PARITY_SEED_CAP
end

puts "resolved depth: seeds=#{seeds} steps=#{steps_per_sequence} (clean_streak=#{current_streak})"

# ── open a sweep ─────────────────────────────────────────────────────
#
# GLOBALLY UNIQUE ON PURPOSE — `Sweep` is `identified_by :reference`
# with no scoping to its target, so two sweeps opened in the same wall
# second against two DIFFERENT targets must not collide; folding the
# target's own reference in alongside the timestamp gets that for free,
# and a second sweep against the SAME target in the same second cannot
# happen anyway (the claim just taken above serialises that).

sweep_reference = "SW-#{target_reference}-#{Time.now.to_i}"
sweep = QualityControl::Sweep.open!(target: target.id, reference: { value: sweep_reference },
                                    engineer: { value: ENGINEER })

# ── the existing fuzz infrastructure, called in-process ────────────────

differ  = Differ.new
feature = File.basename(domain_path).downcase

# `--persistence-parity` NEVER TOUCHES THE RUST BUILD AT ALL — a
# genuinely different axis (Memory vs real PostgresEra, both sides
# Ruby — see lib/hecks/fuzzing/persistence_parity.rb's own header), not
# a third fallback tier below `:differential`/`:ruby_only`. Attempting
# `build_rust_for` here would be wasted work at best (`directory` names
# no `rust/Cargo.toml` feature at all) and a confusing false signal at
# worst, for a mode this flag already opted OUT of the Rust comparison
# for.
if persistence_parity_mode
  binary = nil
  mode   = :persistence_parity
else
  binary = differ.build_rust_for(feature, RUST_DIR)
  mode   = binary ? :differential : :ruby_only
end

# ── the persistence-parity axis's own disposable database ──────────────
#
# OWNED HERE, NOT INSIDE `IsolatedBoot` — see `rebind_to_postgres_era!`'s
# own header (isolated_boot.rb) for why that mode REQUIRES a caller-
# supplied `database:`/`schema:` rather than defaulting to a shared
# constant the way `:postgres` does. `QA_PERSISTENCE_PARITY_DATABASE` is
# a FIXED, dedicated, never-the-real-ledger name — created idempotently
# if it doesn't already exist, same as `IsolatedBoot`'s own `:postgres`
# scratch database, and never dropped by this script (dropping a
# database out from under a concurrent sweep against a DIFFERENT schema
# in it would be destructive; only the schema below is this run's own to
# destroy). `persistence_parity_schema` IS unique per run — the target's
# own reference plus this process's pid plus eight random hex digits —
# and IS dropped again in the `ensure` around the seed loop below,
# whether this sweep ends clean, surprised, or crashes outright: nothing
# from this run is ever left behind.
persistence_parity_database = "hecks_qa_persistence_parity"
persistence_parity_schema   = nil

if persistence_parity_mode
  require "pg"
  persistence_parity_schema = "qa_pp_#{target_reference}_#{Process.pid}_#{SecureRandom.hex(4)}"

  admin = PG.connect(dbname: "postgres")
  exists = admin.exec_params(
    "SELECT 1 FROM pg_database WHERE datname = $1", [persistence_parity_database]
  ).ntuples.positive?
  admin.exec(%(CREATE DATABASE "#{persistence_parity_database}")) unless exists
  admin.close
end

# SHARED BY BOTH DIFFERENTIAL-FAMILY MODES — `ruby_result`/`history`
# either way carries a `:self_consistency` key ONLY when `Replay.call`
# was asked for one (`self_consistency: true`); flattened from
# `{rehydration:, idempotency:, value_object_round_trip:}` into the SAME
# flat `divergences` shape every other finding already uses, so the
# existing report/exit-code path (`run_one_seed`'s own
# `divergences.empty?`) needs no special case for where a finding came
# from.
def self_consistency_divergences(history)
  return [] unless history[:self_consistency]

  history[:self_consistency].values.flatten(1)
end

# THE ACTUAL RUBY-VS-RUST DIFF `spec/rust_conformance_fuzz_spec.rb` runs
# per generated seed, factored out unchanged rather than re-derived —
# same fields compared (instances, events, refusals, queries, sagas,
# reactions), same known-gap filtering, same wire-precision reduction.
# One long method because the spec's own block is: five independently
# gated comparisons that share `ruby_result`/`rust_output` and would
# just re-thread those two locals through five smaller methods for no
# real gain — the spec itself keeps this inline in one `it` block for
# the identical reason.
# rubocop:disable-next Metrics/AbcSize
# rubocop:disable-next Metrics/CyclomaticComplexity
# rubocop:disable-next Metrics/PerceivedComplexity
# rubocop:disable-next Metrics/MethodLength
def diff_ruby_vs_rust(differ, domain_path, steps, binary, self_consistency:)
  ruby_result    = Hecks::Fuzzing::Replay.call(domain_path, steps, self_consistency: self_consistency)
  ruby_instances = JSON.parse(JSON.generate(ruby_result[:instances]))
  ruby_events    = JSON.parse(JSON.generate(ruby_result[:events]))
  ruby_refusals  = ruby_result[:refusals].map do |r|
    { "verb" => r[:verb].to_s, "kind" => r[:kind].to_s.split("::").last, "error" => r[:error] }
  end
  ruby_queries = JSON.parse(JSON.generate(ruby_result[:queries].map { |row| row.except(:instances_at) }))
  ruby_sagas   = JSON.parse(JSON.generate(ruby_result[:sagas]))

  stdout, status = Open3.capture2(binary, stdin_data: JSON.generate({ "steps" => steps }))
  return [{ field: "process", detail: "rust binary exited #{status.exitstatus}: #{stdout}" }] unless status.success?

  rust_output = JSON.parse(stdout)
  # A DEEP COPY, TAKEN BEFORE `strip_emitted_flags!` MUTATES IN PLACE —
  # the self-consistency seed below needs the WIRE-REAL `"instances"`
  # `Store::instances()` actually produced, `emitted_*` bookkeeping
  # fields and all: `Store::from_seed` requires them (found live, while
  # this integration was being written — feeding it the STRIPPED copy
  # the differential comparison uses refused with "Account.emitted_fee_
  # applied: missing from JSON args," which is this integration's own
  # bug, not a real one — a real host round-tripping `Store::instances()`
  # through `Store::from_seed` never strips anything at all).
  rust_live_instances = JSON.parse(JSON.generate(rust_output["instances"])) if self_consistency
  differ.strip_emitted_flags!(rust_output["instances"])
  differ.strip_emitted_flags!(rust_output["queries"])
  differ.strip_occurred_at!(rust_output["events"])

  divergences = []
  divergences << { field: "instances", ruby: ruby_instances, rust: rust_output["instances"] } \
    unless rust_output["instances"] == ruby_instances
  divergences << { field: "events", ruby: ruby_events, rust: rust_output["events"] } \
    unless rust_output["events"] == ruby_events

  by_kind = ->(r) { r.slice("verb", "kind") }
  gap     = ->(r) { differ.known_refusal_gap?(r) || differ.structural_refusal_gap?(r) }
  rust_refusals       = rust_output["refusals"].reject(&gap).map(&by_kind)
  kept_ruby_refusals  = ruby_refusals.reject(&gap).map(&by_kind)
  divergences << { field: "refusals", ruby: kept_ruby_refusals, rust: rust_refusals } \
    unless rust_refusals == kept_ruby_refusals

  wordless      = ->(row) { differ.reduce_to_wire_precision(row.except("error", "reference_error")) }
  not_generated = differ.structurally_refused_verbs(rust_output)
  rust_queries      = rust_output["queries"].reject(&gap).map(&wordless)
  kept_ruby_queries = ruby_queries.reject { |row| gap.call(row) || not_generated.include?(row["query"]) }.map(&wordless)
  divergences << { field: "queries", ruby: kept_ruby_queries, rust: rust_queries } \
    unless rust_queries == kept_ruby_queries

  divergences << { field: "sagas", ruby: ruby_sagas, rust: rust_output["sagas"] } \
    unless rust_output["sagas"] == ruby_sagas

  cross_domain = differ.cross_domain_policy_names(rust_output)
  kept_ruby_reactions = JSON.parse(JSON.generate(ruby_result[:reactions]))
                            .reject { |r| cross_domain.include?(r["policy"]) || differ.known_reaction_gap?(r) }
  rust_reactions = rust_output.fetch("reactions").reject { |r| differ.known_reaction_gap?(r) }
  divergences << { field: "reactions", ruby: kept_ruby_reactions, rust: rust_reactions } \
    unless rust_reactions == kept_ruby_reactions

  # SELF-CONSISTENCY — A SECOND AXIS, NOT A SEPARATE REPORT. `ruby_result`
  # already carries every self-consistency finding this SAME replay
  # produced (`Replay.call`'s own `self_consistency:` kwarg, computed
  # while its runtime was still live — see that file's own comment).
  # `rust_live_instances` (captured above, BEFORE the stripping this
  # method's own differential comparison needs) is the seed for the Rust
  # binary's OWN rehydration door (`Hecks::Fuzzing::SelfConsistency`'s own
  # header explains the mechanism) rather than re-derived or re-dispatched.
  if self_consistency
    divergences.concat(self_consistency_divergences(ruby_result))
    divergences.concat(Hecks::Fuzzing::SelfConsistency.check_rust_rehydration(binary, differ, rust_live_instances))
    divergences.concat(Hecks::Fuzzing::SelfConsistency.check_rust_idempotency(binary, differ, rust_live_instances))
  end

  divergences
end

# THE SINGLE-RUNTIME FALLBACK — `bin/fuzz`'s own `outcome` function,
# unchanged: a declared property violated, or an exception that escaped
# `Replay.call`'s own per-step DOMAIN_REFUSAL isolation (a real
# interpreter defect, not an expected refusal). Reached only when this
# domain has no compiled Rust binary to differential-fuzz against —
# `qa/stress_domains/ledger_ordering/NOTES.md` is the standing example of
# exactly that (authored Ruby-only; `bin/project_rust` for it was never
# run) — matching `bin/fuzz`'s own documented scope exactly rather than
# inventing a narrower or wider one.
#
# RETURNS `[verdict, message, divergences]` — `verdict`/`message` are the
# original two-value contract (`:clean`/`nil`, `:property_violation`/a
# joined "name: message" string, `:crash`/the exception's own message);
# `divergences` is the SAME flat, `field:`-keyed shape `diff_ruby_vs_rust`
# already returns, so `run_one_seed` can treat a Ruby-only self-
# consistency finding exactly like a property violation, never a
# separate case.
def ruby_only_outcome(domain_path, steps, self_consistency:)
  history     = Hecks::Fuzzing::Replay.call(domain_path, steps, self_consistency: self_consistency)
  violations  = Hecks::Fuzzing::Properties.check(history).reject { |_, result| result == true }
  divergences = violations.map { |name, message| { field: name.to_s, detail: message } }
  divergences.concat(self_consistency_divergences(history)) if self_consistency

  return [:clean, nil, []] if divergences.empty?

  message = violations.map { |name, msg| "#{name}: #{msg}" }.join("; ")
  message = "self-consistency check(s) failed: #{divergences.map { |d| d[:field] }.join(', ')}" if message.empty?
  [:property_violation, message, divergences]
rescue StandardError => e
  [:crash, "#{e.class}: #{e.message}", [{ field: "crash", detail: "#{e.class}: #{e.message}" }]]
end

def log_check!(sweep, subject:, expectation:)
  sweep.check!(subject: { value: subject }, expectation: { value: expectation })
end

# `id:` addresses the Sweep aggregate the Check entity lives under;
# `sequence:` is the Check's own identity within it — see this script's
# own header comment on why this is NOT `to.aggregate=`/`to.entity=`.
def mark_held!(runtime, sweep, sequence, observation)
  runtime.dispatch("QualityControl::Sweep.Check.Held", id: sweep.id,
                    sequence: { value: sequence }, observation: { value: observation })
end

# `target:` RESTATED — what `SuspendOnSurprise` (the ledger's own policy)
# reads to take the target out of the rotation; see `Sweep::Check::
# Surprised`'s own comment in the bluebook. The suspension happens INSIDE
# this dispatch, as a reaction, before it returns — nothing below has to
# dispatch `Target.Suspend` itself.
def mark_surprised!(runtime, sweep, sequence, observation, target_reference)
  runtime.dispatch("QualityControl::Sweep.Check.Surprised", id: sweep.id,
                    sequence: { value: sequence }, observation: { value: observation },
                    target: { value: target_reference })
end

mode_label =
  case mode
  when :differential
    "Ruby vs compiled Rust (#{feature})"
  when :persistence_parity
    "Memory vs real PostgresEra (#{feature}) — persistence-adapter parity"
  else
    "Ruby-only property/exception check (no compiled Rust binary for #{feature})"
  end

puts "sweeping #{target_reference} (#{target_path}) — #{mode_label}, #{seeds} seed(s), " \
     "#{steps_per_sequence} steps each, adversarial fraction #{adversarial}, self-consistency #{self_consistency}"

# THE PERSISTENCE-PARITY OUTCOME — `Hecks::Fuzzing::PersistenceParity
# .diff`, called once per seed against THIS SWEEP'S OWN disposable
# schema (dropped between seeds by `IsolatedBoot#ensure_postgres_era_
# schema!` itself, the same zero-history guarantee every other adapter
# mode already gives — see that method's own header). A real
# `PG::Error`/`WiringError` escaping the diff itself (the connection
# refused mid-run, a malformed `.world`) is a crash, not a divergence —
# the same `[:crash, ...]` shape `ruby_only_outcome` already uses right
# above, for the identical reason: an operational failure mid-sweep is
# still something this script needs to SURFACE, never swallow silently.
def persistence_parity_outcome(domain_path, steps, database, schema)
  divergences = Hecks::Fuzzing::PersistenceParity.diff(domain_path, steps, database: database, schema: schema)
  [divergences.empty? ? :clean : :divergence, divergences]
rescue StandardError => e
  [:crash, [{ field: "process", detail: "#{e.class}: #{e.message}" }]]
end

# ONE SEED, EVERY MODE — pulled out of the loop below so that loop reads
# as "run a seed, log it, stop on a surprise" rather than burying that
# shape under each mode's own detail. Returns everything the loop and
# (on a surprise) the final report need; nothing here talks to the
# ledger — that stays the loop's own job. `database:`/`schema:` are only
# ever non-nil for `:persistence_parity` — every other mode ignores them.
#
# A GENERATOR CRASH IS A FINDING TOO. `SequenceGenerator` dispatches
# every candidate step against a live throwaway runtime as it builds
# the sequence, rescuing only genuine domain refusals — anything else
# escaping it means an adversarial (or ordinary) step broke Ruby's own
# interpreter before a replay was ever attempted. That is exactly the
# kind of surprise this script exists to stop on, not an operational
# error to abort with.
#
# THREE MODES, ONE METHOD — the same reason `diff_ruby_vs_rust` above
# stays one long method rather than three short ones: each `case` branch
# shares `steps`/`subject`/`expectation`/`clean`/`observation` with the
# other two, and splitting per mode would just re-thread those locals
# through three call sites for no real gain. `:persistence_parity` never
# receives `self_consistency` at all (see this file's own top-of-file
# comment on why that composition was left out on purpose).
#
# `steps_per_sequence` IS A PARAMETER, NOT A CONSTANT — it used to be
# the fixed `STEPS_PER_SEQUENCE`; now it is resolved once above from
# either `--steps` or `widen_for_streak` and threaded in here explicitly,
# the same way `seed`/`binary`/`domain_path`/`adversarial` already are.
# rubocop:disable-next Metrics/MethodLength
def run_one_seed(mode, differ, domain_path, feature, binary, seed, steps_per_sequence, adversarial, self_consistency,
                 database: nil, schema: nil)
  shape = "#{steps_per_sequence} steps, adversarial #{adversarial}"
  begin
    steps = Hecks::Fuzzing::SequenceGenerator.generate(domain_path, seed: seed, steps: steps_per_sequence,
                                                                    adversarial: adversarial)
  rescue StandardError => e
    return { subject: "#{feature} fuzz seed #{seed} (#{shape}) — sequence generation",
             expectation: "SequenceGenerator builds every step without anything but a domain refusal escaping " \
                          "its own inline dispatch",
             divergences: [{ field: "generator_crash", detail: "#{e.class}: #{e.message}\n#{e.backtrace.first(6).join("\n")}" }],
             clean: false, observation: "generator crashed: #{e.class}: #{e.message}", steps: [] }
  end

  case mode
  when :differential
    subject     = "#{feature} fuzz seed #{seed} (#{shape}) vs compiled Rust (#{feature})"
    expectation = "Ruby and the compiled Rust conformance binary agree on instances, events, refusals, " \
                  "reactions, sagas and queries across all #{steps_per_sequence} generated steps"
    expectation += ", and each engine agrees with itself on rehydration/idempotency/value-object round trip" \
      if self_consistency
    divergences = diff_ruby_vs_rust(differ, domain_path, steps, binary, self_consistency: self_consistency)
    clean       = divergences.empty?
    observation = if clean
                    "agreed across all #{steps_per_sequence} steps"
                  else
                    "diverged on: #{divergences.map { |d| d[:field] }.join(', ')}"
                  end
  when :persistence_parity
    subject     = "#{feature} fuzz seed #{seed} (#{shape}) — Memory vs real PostgresEra"
    expectation = "Memory and a real, disposable PostgresEra-backed boot agree on instances, events, " \
                  "refusals, reactions, sagas and queries across all #{steps_per_sequence} generated steps"
    _verdict, divergences = persistence_parity_outcome(domain_path, steps, database, schema)
    clean       = divergences.empty?
    observation = if clean
                    "agreed across all #{steps_per_sequence} steps"
                  else
                    "diverged on: #{divergences.map { |d| d[:field] }.join(', ')}"
                  end
  else
    subject     = "#{feature} fuzz seed #{seed} (#{shape}), Ruby-only (no Rust binary)"
    expectation = "no declared property is violated and the interpreter does not crash across all " \
                  "#{steps_per_sequence} generated steps"
    expectation += ", and Ruby agrees with itself on rehydration/idempotency/value-object round trip" \
      if self_consistency
    verdict, message, divergences = ruby_only_outcome(domain_path, steps, self_consistency: self_consistency)
    clean       = verdict == :clean
    observation = clean ? "clean across all #{steps_per_sequence} steps" : "#{verdict}: #{message}"
  end

  { subject: subject, expectation: expectation, divergences: divergences, clean: clean, observation: observation,
    steps: steps }
end

surprise = nil

begin
  (1..seeds).each do |seed|
    result = run_one_seed(mode, differ, domain_path, feature, binary, seed, steps_per_sequence, adversarial,
                          self_consistency, database: persistence_parity_database, schema: persistence_parity_schema)

    sweep    = log_check!(sweep, subject: result[:subject], expectation: result[:expectation])
    sequence = sweep.checks.last[:sequence][:value]

    if result[:clean]
      mark_held!(runtime, sweep, sequence, result[:observation])
      puts "  seed #{seed}: held"
      next
    end

    mark_surprised!(runtime, sweep, sequence, result[:observation], target_reference)
    puts "  seed #{seed}: SURPRISED"
    surprise = result.merge(seed: seed)
    break
  end
ensure
  # THE DISPOSABLE SCHEMA'S OWN TEARDOWN — runs whether this sweep ends
  # clean, surprised, or crashes outright (a Ruby `ensure` runs across
  # `exit`, which raises `SystemExit` under the hood, the same as any
  # other exception unwinding through here). The DATABASE itself is
  # deliberately left standing (see its own creation comment above) —
  # only the schema this ONE run minted is this run's own to destroy.
  if persistence_parity_schema
    admin = PG.connect(dbname: persistence_parity_database)
    admin.exec("SET client_min_messages = warning")
    admin.exec("DROP SCHEMA IF EXISTS #{admin.quote_ident(persistence_parity_schema)} CASCADE")
    admin.close
  end
end

# ── report and exit ─────────────────────────────────────────────────

if surprise
  puts
  puts "=" * 72
  puts "FOUND SOMETHING — sweep #{sweep_reference} left OPEN, target #{target_reference} SUSPENDED."
  puts "No Bug was logged (that needs a real failing-test demonstration, which"
  puts "needs judgment this script does not have — bin/qa_log_bug is the door)"
  puts "and the sweep was not concluded. The ledger's own SuspendOnSurprise"
  puts "policy took the target out of the rotation; it stays out until a PERSON"
  puts "runs: bin/qa_sweep #{target_reference} --release --notes \"…\""
  puts "An agent decides from here: self-contained fix with a regression test"
  puts "and a PR (bin/qa_open_pr), or a Bug left open for something bigger."
  puts "Never waived here, never filed upstream from here."
  puts "=" * 72
  puts
  puts "domain:      #{target_path} (#{domain_path})"
  puts "target:      #{target_reference}"
  puts "sweep:       #{sweep_reference} (id #{sweep.id})"
  puts "mode:        #{mode}"
  puts "seed:        #{surprise[:seed]}"
  puts "steps:       #{steps_per_sequence}"
  puts "adversarial: #{adversarial}"
  puts "self-consistency: #{self_consistency}"
  puts "streak:      clean_streak was #{current_streak} going into this pass"
  puts "reproduce:   Hecks::Fuzzing::SequenceGenerator.generate(#{domain_path.inspect}, " \
       "seed: #{surprise[:seed]}, steps: #{steps_per_sequence}, adversarial: #{adversarial})"
  puts "subject:     #{surprise[:subject]}"
  puts "expectation: #{surprise[:expectation]}"
  puts "observation: #{surprise[:observation]}"
  puts

  # ONE GENERIC PRINTER, NOT ONE SHAPE PER CHECK KIND. A differential
  # divergence carries `:ruby`/`:rust`; a persistence-parity one carries
  # `:memory`/`:postgres_era` (`Hecks::Fuzzing::PersistenceParity`'s own
  # header explains why that's a genuinely different PAIRING, not a
  # relabeling of the same one); a process-level failure carries
  # `:detail`; `Hecks::Fuzzing::SelfConsistency`'s own findings carry YET
  # different keys again (`:live`/`:rehydrated`, `:once`/`:twice`,
  # `:original`/`:rehydrated`/`:error`) because "live state vs a cold
  # read" and "ruby vs rust" are different claims and deserve different
  # labels. Printing every key but `:field` (and the redundant
  # `:domain`/`:aggregate`/`:type`, already named by the field line
  # itself once folded in below) is what lets this stay ONE printer for
  # every divergence shape this script has ever produced or ever will,
  # rather than growing a new hardcoded branch per check kind — `mode:`,
  # printed just above, is what tells a reader which pairing a given
  # report's own divergences use.
  surprise[:divergences].each do |divergence|
    label = [divergence[:field], divergence[:domain], divergence[:aggregate], divergence[:type]].compact.join(" ")
    puts "-- #{label} --"
    divergence.except(:field, :domain, :aggregate, :type).each do |key, value|
      puts "#{key}: #{value.inspect}"
    end
    puts
  end

  # WHICH STEPS WERE MUTATED, AND HOW — the step's own `"adversarial"`
  # metadata (adversary.rb), printed beside the exact args both engines
  # replayed, so whoever logs the Bug can name the mechanism (the
  # `bug` field is the class it was injected to exercise) rather than
  # reverse-engineer it from a refusal diff. Every step is listed, in
  # order, so a divergence's own verb can be matched back to its step;
  # unmutated steps are marked as such.
  puts "-- generated steps (index: verb, adversarial mutation if any) --"
  surprise[:steps].each_with_index do |step, index|
    label    = %w[verb query dry_run].filter_map { |key| step[key] if step.key?(key) }.first
    mutation = step["adversarial"] ? JSON.generate(step["adversarial"]) : "(not mutated)"
    puts "#{index}: #{label}  #{mutation}"
    puts "   args: #{JSON.generate(step['args'])}" if step["adversarial"]
  end
  puts

  exit EXIT_FOUND_SOMETHING
end

notes = "domain=#{target_reference} path=#{target_path} mode=#{mode} feature=#{feature} seeds=#{seeds} " \
        "steps=#{steps_per_sequence} adversarial=#{adversarial} self_consistency=#{self_consistency} — " \
        "every seed held, no divergence or property violation found."
sweep.conclude!(notes: { value: notes })

# ZERO SURPRISES, THIS PATH ONLY — this line is only ever reached when
# every seed held (the `exit EXIT_FOUND_SOMETHING` above already left
# this process for a surprise). `release_target!` (above) still DECAYS
# whatever the target's `yield_score` already was from an earlier,
# bug-bearing release — a clean pass is real evidence too, the evidence
# that a hot streak is cooling off — and `sweep_was_clean?` re-reads the
# sticky `ever_surprised` bit rather than trusting this loop's own
# `surprise` local (belt and braces; that method's own comment says why).
target = release_target!(target, domain_path, current_streak, surprises: 0, clean: sweep_was_clean?(sweep))

puts
puts "clean — #{target_reference} concluded and released. clean_streak: #{current_streak} -> #{target.clean_streak.value}. " \
     "capabilities: #{target.capabilities.value.inspect}"
puts notes
exit EXIT_OK
