#!/usr/bin/env ruby

# Lints the Makefiles bin/project_deploy generates for prod-touching recipes that hide failure.
# A pattern match over Make/shell text, not a static analyzer: read each message first.
#
#   bin/lint_deploy_recipes                      # lints 3 generated fixture Makefiles
#   bin/lint_deploy_recipes path/to/Makefile …   # lints the given Makefile(s)
#
# Exits 0 when clean; exits 1 with a report otherwise.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("lint_deploy_recipes")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks"
require "hecks/projections/deploy/recipe_lint"

# The linter, under the name the specs and this script have always used.
DeployRecipeLint = Hecks::Projections::Deploy::RecipeLint

if $PROGRAM_NAME == __FILE__
  if %w[-h --help].include?(ARGV.first)
    puts "usage: bin/lint_deploy_recipes [Makefile ...]"
    puts "  no args: generates 3 representative fixture domains (own/shared/oauth)"
    puts "           via the real project_deploy, lints each one's Makefile"
    puts "  with args: lints the given Makefile(s) directly (e.g. deploy/<domain>/Makefile)"
    exit 0
  end

  begin
    violations = ARGV.empty? ? DeployRecipeLint.lint_fixtures : DeployRecipeLint.lint_files(ARGV)
  rescue ArgumentError => e
    abort "bin/lint_deploy_recipes: #{e.message}"
  end

  if violations.empty?
    puts "bin/lint_deploy_recipes: no violations found."
    exit 0
  end

  warn "bin/lint_deploy_recipes: #{violations.size} violation(s) found:\n\n"
  violations.each { |v| warn "  #{v}\n" }
  exit 1
end
