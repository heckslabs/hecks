#!/usr/bin/env ruby

# Lints the Makefiles bin/project_deploy generates for prod-touching recipes that hide failure.
# A pattern match over Make/shell text, not a static analyzer: read each message first.
#
#   bin/lint_deploy_recipes                      # lints 3 generated fixture Makefiles
#   bin/lint_deploy_recipes path/to/Makefile …   # lints the given Makefile(s)
#
# Exits 0 when clean; exits 1 with a report otherwise.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("lint_deploy_recipes")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/tools"

Hecks::Tools.script("lint_deploy_recipes", ARGV)
