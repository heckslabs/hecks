#!/usr/bin/env ruby

# An MCP door onto the storehouse bus — one MCP server for every booted
# domain, not one per command. `docs/hecks-survey-what-we-wish-we-had.md`
# and `docs/future-features.md`'s own "if we build three" #1 pick,
# extended past the original six tools with the rest of that same
# survey's ranked wishlist: `dispatch` (with `dry_run`/`steps`/`source`),
# `query`, `state`, `catalog`, `describe`, `validate` (with `deep`),
# `domains`, `history`, `behaviors`, `follow`. All the logic and the JSON
# shape it answers with live in `Hecks::Storehouse` (lib/hecks/
# storehouse.rb); the JSON-RPC plumbing is `Hecks::CLI::McpDoor`
# (lib/hecks/cli/mcp_door.rb), which `hecks mcp` also runs.
#
# **Stdio only, enforced** — this door has no authentication and must not be
# exposed over a network. `Hecks::CLI::Mcp.call` runs
# `Hecks::McpStdioGuard.enforce_stdio!` before the framework loads, refusing
# an argument or a `HECKS_MCP_*` option asking for another transport, or an
# internet-protocol socket on stdin/stdout. `role:`/`actor_id:` are a
# caller-asserted identity, not a credential. See
# `docs/decisions/0062-mcp-servers-need-real-authentication-before-any-network-transport.md`.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/mcp"

Hecks::CLI::Mcp.call(ARGV)
