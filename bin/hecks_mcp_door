#!/usr/bin/env ruby

# An MCP door onto the storehouse bus: one server per booted domain, exposing
# dispatch/query/state/catalog/describe/validate/domains/history/behaviors/follow.
# Logic lives in `Hecks::Storehouse`; JSON-RPC plumbing in `Hecks::CLI::McpDoor`.
#
# Stdio only, enforced — `Hecks::CLI::Mcp.call` refuses another transport or an
# internet-protocol socket. `role:`/`actor_id:` are caller-asserted, not a
# credential (ADR 0062).

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/mcp"

Hecks::CLI::Mcp.call(ARGV)
