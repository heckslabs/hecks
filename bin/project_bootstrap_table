#!/usr/bin/env ruby

# Projects the grammar's bootstrap-window fallbacks into
# lib/hecks/bluebook/dsl/bootstrap_table.rb, from the Keyword rows'
# own calls:/resolves_via:/disambiguator: columns.
#
#   bin/project_bootstrap_table

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_bootstrap_table")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/projection_files"

Hecks::ProjectionFiles.run(:bootstrap_table)
