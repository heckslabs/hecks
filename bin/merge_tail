#!/usr/bin/env ruby

# Tail-merge: interleaves the old world's post-cut writes into the
# live head by their recorded global ordinals, one transaction only.
#
# A record touched by both worlds since the cut refuses until it has
# an explicit winner:
#
#   bin/merge_tail <domain> [--winner <id>=old] [--winner <id>=new] ...

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("merge_tail")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/tools"

Hecks::Tools.script("merge_tail", ARGV)
