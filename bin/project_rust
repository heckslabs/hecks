#!/usr/bin/env ruby

# Generates Rust source for one domain into rust/src/generated/ — the
# driver for `RustProjection` (rust/project.rb, alongside the Rust crate
# it targets, not under lib/hecks/), which carries the architecture
# and what-is/isn't-generated notes in full.
#
#   bin/project_rust <domain>

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "hecks/bluebook/meta_validator"
require_relative "../rust/project"
require "fileutils"
require "json"

# `merged.rs` (both meta's own and a target domain's own, below) needs
# each read model's own `group_by_fn_body` written into the SAME file
# `emit_read_model_table` is about to reference by bare function name —
# `registry.rs` gets this via `domain_generator.rb`'s own emission loop,
# but `merged.rs` is a wholly separate `File.open` block this script
# builds itself, so it needs the identical emission repeated here.
def emit_group_by_bodies(file, read_models)
  read_models.each do |rmd|
    next unless rmd[:group_by_fn_body]

    file.puts rmd[:group_by_fn_body]
    file.puts
  end
end

# ADR 0033 — the era/lineage subsystem (including `PostgresEra`) moved
# behind a loadable persistence plugin core no longer requires. This
# generator has to handle whatever domain it's pointed at, lineage-capable
# or not, so it requires the plugin directly and unconditionally — a
# legitimate, explicit consumer, not a core-boundary violation. This also
# defines the `Hecks::Adapters::PostgresEra` CLASS constant
# (`lineage_capable?`'s own singleton method lives there — the plain,
# non-era `Postgres` class does NOT declare it at all), so `registry.
# adapter_class("PostgresEra")` (Runtime::EraCheck's own capability
# lookup, reused below) can resolve it. Safe at generator time and every
# other time: `require "pg"` is lazy, inside `PostgresEra.connect_for`
# only (that file's own comment) — nothing here opens or even attempts a
# database connection.
require "hecks/ports/persistence/plugins/era"

domain = ARGV.shift or abort "usage: bin/project_rust <domain>"

# DOMAIN-NAME LANDMINE GUARD (R5) — validated FIRST, before ANY side
# effect this script has (including the `meta`/`active` directory wipes
# below, in BOTH the opt-in and default paths) — an earlier version of
# this guard sat right before the `meta`/`active` `FileUtils.rm_rf`
# calls further down, which meant an invalid domain name still wiped
# `rust/src/generated/meta/` before the abort fired, leaving it deleted
# and never regenerated (found live, from a real negative-path test run
# against a domain named "version" during this fix's own verification).
# `target_mod_name` becomes, unescaped, a directory name, a literal Rust
# module identifier (`pub mod #{name};`), AND a Cargo feature name
# (rust/Cargo.toml) — two distinct ways that can go wrong:
#
#   1. Not a legal, unadorned Rust identifier (contains `-`, starts with
#      a digit, is empty, ...) — `pub mod 2pizzas;` / `pub mod my-app;`
#      is a syntax error, not a name Rust can even parse.
#   2. A legal identifier that collides with something else load-bearing:
#      - a Rust keyword (`RUST_KEYWORDS`, `rust/project/naming.rb`) —
#        `pub mod type;` doesn't compile either, module names get no
#        raw-identifier (`r#type`) escape hatch the way struct FIELDS do
#        (`rust_ident_field`).
#      - a Cargo.toml key the feature-sync regex (further down, and in
#        `rust/project_rust_pipeline.rb`) would false-positive against
#        if it weren't scoped to `[features]` — `version`/`edition`/
#        `name`/`path` are exactly the `[package]`/`[lib]`/`[[bin]]`
#        keys that used to risk matching.
#      - `default` itself — Cargo reserves that name for the
#        auto-enabled feature set; a domain can't also own it.
#
# The predicate itself (and the reserved-word lists it checks) lives in
# `rust/project/naming.rb` alongside `RUST_KEYWORDS`, unit-tested
# directly there rather than only reachable by shelling this whole
# script out. `RustProjection::Projector` is already loaded by the
# `require_relative "../rust/project"` above.
unless RustProjection::Projector.valid_domain_mod_name?(File.basename(domain))
  abort "bin/project_rust: domain name #{File.basename(domain).inspect} (from #{domain.inspect}) can't be used " \
        "as-is — it has to double as a Rust module identifier and a Cargo feature name, and this one is " \
        "either not a plain lowercase identifier, is a Rust keyword, or collides with a reserved Cargo.toml " \
        "key (#{RustProjection::Projector::CARGO_RESERVED_DOMAIN_NAMES.join(', ')}). Rename the domain directory."
end

# STAGE 8 OPT-IN — `HECKS_PARSER=rust HECKS_CODEGEN=rust bin/project_rust
# <domain>` runs the ENTIRE pipeline (parse AND codegen) through
# `rust/parser`'s `hecks-parse`/`rust/codegen`'s `hecks-codegen`
# instead, with ZERO `Kernel.load` of any domain bluebook — see
# `rust/project_rust_pipeline.rb`'s own header for the full contract
# and its one deliberately-named gap (`manifest.json`, coverage
# bookkeeping only). The `lineage` sidecar key this comment used to name
# as that gap is CLOSED — `derive_lineage` computes it there for real,
# proven byte-exact against this default path's own `Exporter.lineage`
# by `spec/project_rust_pipeline_spec.rb` for both pizzas (a real
# capable aggregate) and banking (real binds, zero capable).
#
# PAIRED, not independently toggleable: `HECKS_PARSER=rust` alone would
# mean "parse in Rust, then hand a Rust-shaped ir.json to the STILL-Ruby
# `RustProjection::DomainGenerator` below" — that already works today
# (`domain_generator.rb`'s own `json_shaped` seam exists for exactly
# this), but it is a DIFFERENT, narrower experiment than "compile
# entirely in Rust" and isn't what this stage is verifying end-to-end.
# `HECKS_CODEGEN=rust` alone (Ruby parses, Rust generates) has no
# real use today either: `hecks-codegen` only reads the `ir.json` SHAPE,
# never Ruby's own live IR objects, so there's no seam for Ruby-parsed
# input to skip. Requiring BOTH keeps the opt-in meaning exactly one
# thing — the plan's own "no Ruby involved at build time" — rather than
# a matrix of half-Rust configurations nothing exercises or verifies.
#
# THE DEFAULT (no env vars, or only one of the two set) is the
# ORIGINAL body below, UNCHANGED — every other concurrent session in
# this repo calling `bin/project_rust` for unrelated work keeps getting
# exactly what it always has.
if ENV["HECKS_PARSER"] == "rust" && ENV["HECKS_CODEGEN"] == "rust"
  require_relative "../rust/project_rust_pipeline"
  RustProjectPipeline.call(domain)
else

  # EVERY IR HANDED TO THE GENERATOR GOES THROUGH REAL JSON FIRST — never
  # the live Hash `Exporter.call` returns. That Hash carries real Ruby
  # Symbols (`Attribute#to_h`'s `name:`, `Mutation#to_h`'s
  # `op:`/`target:`); the `ir.json` sidecar the generator writes alongside
  # its .rs files — and which a Rust-side parser is being built to produce
  # directly, without booting Ruby at all — can only carry Strings. Passing
  # the live Hash straight through would let rust/project/*.rb quietly
  # depend on the Symbol spelling, and that dependency would only surface
  # the day the producer changed. This is the seam: the generator is only
  # ever exercised against the shape its future input actually has.
  def json_shaped(payload) = JSON.parse(JSON.generate(payload), symbolize_names: true)

  # `root:` — WITHOUT IT, a domain declaring `uses_embryonaut_bluebook`
  # (lifeadelics is the first real one) refuses here with "needs a
  # registry with a root to vendor from": EmbryonautBluebook.load!
  # resolves `<root>/vendor/embryonaut_bluebooks/<name>/bluebook/` off
  # this registry's own root, same as any other boot
  # (Runtime::Loader.boot's own `root: File.dirname(directory)`) — this
  # generator built its own bare registry before vendoring existed as a
  # feature and was never updated once it did. `domain` itself IS the
  # root here (not its parent) — a domain's `vendor/` sits directly
  # inside its own directory (`<domain>/vendor/embryonaut_bluebooks/`),
  # not beside it the way Runtime::Loader.boot's `directory` (the
  # nested `bluebook/` subfolder one level down) needs its OWN parent.
  target_registry = Hecks::Runtime::Registry.new(root: File.expand_path(domain))
  # Declared BEFORE the block below, not first-assigned inside it — a
  # block passed to a method call (unlike `if`/`while`) opens its own
  # local scope, so a variable only ever assigned inside `with_registry
  # do ... end` would vanish the moment the block returns.
  domain_bluebook_path = nil
  Hecks.with_registry(target_registry) do
    Kernel.load(File.expand_path("../lib/hecks/ports/persistence.port", __dir__))
    Kernel.load(File.expand_path("../lib/hecks/ports/extraction.port", __dir__))
    Kernel.load(File.expand_path("../lib/hecks/adapters/driven/memory.adapter", __dir__))
    Kernel.load(File.expand_path("../lib/hecks/adapters/driven/prism.adapter", __dir__))
    # The DSL declaration (name + fields), NOT the Ruby class required
    # above — `registry.adapters["PostgresEra"]` (an Adapter, from THIS
    # load) and `registry.adapter_class("PostgresEra")` (the Ruby class,
    # from the `require` above) are two separate lookups `EraCheck.
    # lineage_capable?` checks in sequence; both have to be present or it
    # silently (and correctly, for any OTHER unloaded adapter) answers
    # false.
    Kernel.load(File.expand_path("../lib/hecks/adapters/driven/postgres_era.adapter", __dir__))
    # EVERY *.bluebook FILE DIRECTLY IN THE DOMAIN'S OWN DIRECTORY, not
    # just one — Wave 7's own reference-decluttering split banking's
    # aggregates across 8 sibling files (customer_relationships.bluebook,
    # deposit_accounts.bluebook, ...), none of which "#{File.basename(
    # domain)}.bluebook" (banking.bluebook, itself declaring ZERO
    # aggregates now — confirmed live: `grep -c 'aggregate "'
    # banking.bluebook` is 0) would ever match alone. `Adapters::Folder#
    # load_bluebooks`'s own default `["*.bluebook"]` pattern, `Dir[]`-
    # sorted, loads all of them together, banking.bluebook itself first
    # (alphabetically ahead of every split sibling) — the SAME load
    # order the single explicit `Kernel.load` used to give it alone.
    bluebook_directory = File.join(domain, "bluebook")
    domain_bluebook_path = File.join(bluebook_directory, "#{File.basename(domain)}.bluebook")
    Hecks::Adapters::Folder.new.load_bluebooks(bluebook_directory)

    # ALSO every translations/*.bluebook edge — same directory's own
    # `translations/` subdirectory, same load-order position Vocabulary's
    # own "LoadOrder" entry gives them (between the domain's own
    # .bluebook and .hecksagon) — this generator's registry build was
    # never updated to include this step, so `target_registry.
    # translations` was always empty here, and `Exporter.translations`
    # (the `translations` ir.json key) had nothing real to export.
    # `Adapters::Folder#load_bluebooks`'s own default pattern never
    # matches this — a different subdirectory, not `bluebook_directory`
    # itself — so it stays a separate, explicit glob. `Dir[]` is already
    # sorted (Ruby's own glob guarantee, same reason `load_each`'s own
    # `.sort` reads as redundant to rubocop), so multiple edges in one
    # domain load in a stable, name-determined order without needing to
    # say so here.
    Dir[File.join(bluebook_directory, "translations", "*.bluebook")].each { |file| Kernel.load(file) }

    # ALSO every .hecksagon file in the folder — this is what
    # actually fires `uses_framework`, which `Kernel.load`s that framework
    # member's own .bluebook into this SAME registry as a side effect
    # (HecksagonBuilder#uses_framework -> Framework.load!, hecksagon_
    # builder.rb:31-34 / framework.rb:37-46) — the same mechanism the app
    # itself already relies on at real boot time, not a new one. A domain
    # with no .hecksagon (or one that attaches nothing) leaves
    # target_registry.bluebooks with just its own single entry, exactly
    # as before this line existed.
    Dir.glob(File.join(bluebook_directory, "*.hecksagon")).each { |file| Kernel.load(file) }
  end

  # Still .keys.first, unchanged from before .hecksagon was ever loaded
  # here — the target domain's OWN chapter is always loaded first,
  # before .hecksagon's uses_framework calls add anything else, so
  # insertion order (Ruby Hash's own guarantee) already puts it first
  # regardless of how many framework chapters get pulled in after it.
  target_domain_name = target_registry.bluebooks.keys.first
  target_ir = json_shaped(Hecks::Projector::Exporter.call(target_registry).fetch(target_domain_name))

  # MERGED IN, NOT PART OF `Exporter.call`'s OWN OUTPUT — see `Exporter.
  # lineage`'s own header: a binding fact, not a shape fact, so it rides
  # alongside the canonical per-domain IR as its own top-level key rather
  # than inside it (ADR 0001 stays true: `bluebook.to_h` itself never
  # mentions an adapter). Every consumer of `target_ir` from here on
  # (metadata.rs's embedded IR_JSON, the `ir.json` sidecar rust/host
  # already reads at runtime, manifest.json) sees it the same way.
  target_ir[:lineage] = json_shaped(Hecks::Projector::Exporter.lineage(target_registry, target_domain_name))

  # SAME SEAM, SAME REASONING — `Exporter.translations` walks the whole
  # registry (a shared registry can hold another domain's edges too, the
  # same way it can hold another domain's bluebook via uses_framework),
  # filtered down to this target domain's own before it ever reaches
  # `target_ir`. Each edge already carries its own precompiled SQL
  # (`compiled_state_expression`/`compiled_id_expression` —
  # Translation::RuleCompiler, the SAME code head_compiler.rb's real
  # per-mint assembly calls, not a second compiler) — a future
  # boot-time-mint consumer never needs to compile SQL itself, only
  # execute what Ruby already compiled.
  target_ir[:translations] = json_shaped(
    Hecks::Projector::Exporter.translations(target_registry).select { |edge| edge[:domain] == target_domain_name }
  )

  # THE RAW BLUEBOOK SOURCE TEXT — a binding fact same as `lineage`/
  # `translations` above (not part of `bluebook.to_h`'s own canonical
  # IR, which describes SHAPE, never the literal text that declared it —
  # ADR 0001 again), but one a future Rust-side mint needs verbatim:
  # `hecks_eras.held_text` is this exact string, byte for byte, and the
  # integrity digest every held era is checked against
  # (era_store.rb's own `verify_integrity!`) is SHA256 of THIS text, not
  # of anything re-derived from the parsed IR. Read directly off disk —
  # the SAME file `Kernel.load` just parsed a few lines up — rather than
  # reconstructed from `bluebook.to_h`, which would produce a
  # DIFFERENT (re-serialized, not authored) text and a digest nothing
  # already stored would ever match.
  target_ir[:source_text] = File.read(domain_bluebook_path)

  # THE SELF-HOSTED LANGUAGE, COMPILED IN TOO. `lib/hecks/language/bluebook/`
  # declares what a bluebook IS — Bluebook, Aggregate, Command, ValueObject,
  # Query, Entity, Member, Policy, ProcessManager, Handler, Dispatch,
  # Vocabulary, Syntax, ReadModel — in the SAME DSL any business domain uses,
  # so it goes through the identical codegen pipeline as `target_ir` below,
  # not a special case. `MetaValidator.grammar_registry` is the real boot
  # sequence (nine files, in the declared order, merged into one chapter,
  # then judged through its own fixpoint) — reused here rather than
  # re-derived, so this can never silently drift from what MetaValidator
  # itself actually loads.
  meta_ir = json_shaped(Hecks::Projector::Exporter.call(Hecks::Bluebook::MetaValidator.grammar_registry).fetch("Bluebook"))

  out_root = File.expand_path("../rust/src/generated", __dir__)
  FileUtils.mkdir_p(out_root)

  # SCOPED clearing, not a whole-tree wipe — multiple domains coexist on
  # disk now (Cargo features select which one actually compiles in, see
  # below), so regenerating Banking must not erase a previously-generated
  # Embryonaut and vice versa. Still cleared per-directory, not merely
  # written into: a previous run for THIS SAME domain/chapter leaves stale
  # .rs files behind otherwise (an aggregate that no longer exists).
  FileUtils.rm_rf(File.join(out_root, "meta"))
  # One-time migration: the old shared `active/` directory this file used
  # to write is retired — `active` is now a set of `#[cfg(feature = ...)]`
  # re-exports living directly in the root mod.rs below, one per domain
  # that has ever been generated, never a directory of its own.
  FileUtils.rm_rf(File.join(out_root, "active"))

  # Already validated at the very top of this script, before ANY side
  # effect (including the `meta`/`active` wipes above) — see that
  # guard's own header for why it moved there.
  target_mod_name = File.basename(domain)

  FileUtils.rm_rf(File.join(out_root, target_mod_name))
  meta_result = RustProjection::DomainGenerator.call(meta_ir, "the self-hosted language (lib/hecks/language/bluebook)",
                                                     File.join(out_root, "meta"), "meta")

  # META'S OWN merged.rs — meta has always gotten full codegen (aggregates,
  # commands, queries, and now read models), but until this line nothing
  # ever gave it the ONE FILE that makes a generated module SELECTABLE as
  # its own compiled artifact (`domains`/Cargo feature detection, below,
  # both key off "does this directory have its own merged.rs" — the exact
  # same test `bin/rust_coverage`'s own header already documents for what
  # makes a directory "an independently selectable domain rather than a
  # shared framework chapter"). Meta attaches no OTHER chapter of its own
  # (`uses_framework` is a business-domain concept; the self-hosted
  # language declares nothing of the kind), so its own merged registry is
  # just its single-chapter one, restated under the same "merged.rs"
  # filename every other domain already writes — real, not a special case:
  # without this, `Bluebook::WholeBluebook` (the language's own read model)
  # could be codegen'd but never actually RUN through kernel::cli's real
  # stdin/stdout contract, which is exactly what proving it byte-for-byte
  # against Ruby (spec/rust_conformance_meta_spec.rb) needs.
  meta_merged_path = File.join(out_root, "meta", "merged.rs")
  File.open(meta_merged_path, "w") do |f|
    f.puts RustProjection::Projector.emit_registry(meta_result[:aggregates])
    f.puts
    f.puts RustProjection::Projector.emit_reference_lookup(meta_result[:aggregates])
    f.puts
    f.puts RustProjection::Projector.emit_policy_table(meta_ir[:name], meta_ir[:policies], meta_ir[:aggregates])
    f.puts
    f.puts RustProjection::Projector.emit_cross_domain_policy_table(meta_ir[:name], meta_ir[:policies])
    f.puts
    f.puts RustProjection::Projector.emit_process_manager_table(meta_ir[:process_managers])
    f.puts
    f.puts RustProjection::Projector.emit_reference_key_table([[meta_ir[:name], meta_result[:aggregates].map { |a| a[:name] }]])
    f.puts
    f.puts RustProjection::Projector.emit_creates_table(meta_result[:aggregates])
    f.puts
    f.puts RustProjection::Projector.emit_identity_head_table(meta_result[:aggregates])
    f.puts
    f.puts RustProjection::Projector.emit_command_attributes_table(meta_result[:aggregates])
    f.puts
    f.puts RustProjection::Projector.emit_query_table(meta_result[:queries])
    f.puts
    emit_group_by_bodies(f, meta_result[:read_models])
    f.puts RustProjection::Projector.emit_read_model_table(meta_result[:read_models])
  end
  puts "wrote #{meta_merged_path}"
  File.open(File.join(out_root, "meta", "mod.rs"), "a") { |f| f.puts "pub mod merged;" }

  target_result = RustProjection::DomainGenerator.call(target_ir, domain, File.join(out_root, target_mod_name), target_mod_name)
  target_aggregates = target_result[:aggregates]
  target_queries = target_result[:queries]
  target_read_models = target_result[:read_models]

  # EVERY OTHER BLUEBOOK NOW IN THE REGISTRY — the target domain's own
  # uses_framework calls (fired by loading its .hecksagon, above) pulled
  # these in as a side effect. Each gets generated into its own module
  # (rust/src/generated/governance/, .../identity/, ...), exactly the
  # same call shape as `meta`/the target domain above — no chapter is
  # privileged. `chapter_mod_names` tracks the lowercase module name per
  # chapter so mod.rs (below) can declare all of them. Framework chapters
  # are SHARED across every domain that attaches them (Banking and
  # Embryonaut both use Governance/Identity) and their content is a pure
  # function of the framework bluebook alone, not of who's attaching it —
  # so clearing and regenerating one here is safe and idempotent
  # regardless of which OTHER domain last touched it. `framework_queries`
  # rides alongside `framework_aggregates` for the exact same reason —
  # Governance's `AssignmentsForActor`/Identity's `ResolvedBy` need to
  # reach the MERGED query table below, not just their own chapter's.
  chapter_mod_names = { target_mod_name => target_domain_name }
  framework_aggregates = []
  framework_queries = []
  framework_read_models = []
  framework_process_managers = []
  # ONE ENTRY PER CHAPTER (target first — see below), each carrying
  # exactly what emit_merged_policy_table/emit_merged_cross_domain_
  # policy_table need to qualify THAT chapter's own policies against
  # ITS OWN domain_name/aggregates, never the target's. See
  # reactions.rb's own header on emit_merged_policy_table for why this
  # exists at all — recovers a documented, deliberate gap, not a new
  # capability invented speculatively.
  policy_sources = [{ domain_name: target_domain_name, policies: target_ir[:policies], aggregates: target_ir[:aggregates] }]
  (target_registry.bluebooks.keys - [target_domain_name]).each do |chapter_name|
    chapter_mod_name = chapter_name.downcase
    chapter_mod_names[chapter_mod_name] = chapter_name
    chapter_ir = json_shaped(Hecks::Projector::Exporter.call(target_registry).fetch(chapter_name))
    FileUtils.rm_rf(File.join(out_root, chapter_mod_name))
    chapter_result = RustProjection::DomainGenerator.call(chapter_ir, "#{domain} (uses_framework #{chapter_name.inspect})",
                                                          File.join(out_root, chapter_mod_name), chapter_mod_name)
    framework_aggregates.concat(chapter_result[:aggregates])
    framework_queries.concat(chapter_result[:queries])
    framework_read_models.concat(chapter_result[:read_models])
    framework_process_managers.concat(chapter_ir[:process_managers])
    policy_sources << { domain_name: chapter_name, policies: chapter_ir[:policies], aggregates: chapter_ir[:aggregates] }
  end

  # ONE MERGED Store/dispatch_by_name, spanning the target domain AND
  # every framework chapter it attaches — registry.rb's own emit_registry
  # (and reactions.rb's emit_reference_key_table) already read each
  # aggregate's own chapter_mod:/domain_name: fields, so this is just
  # "call them once more over the union" (domain_generator.rb's own
  # header on why this is safe: nothing about a single-chapter call was
  # privileged in the first place). Policies/process managers DO merge
  # across chapters now — RECOVERED, not new: this used to only compile
  # in the target domain's own (the comment here used to read
  # "Governance/Identity declare none today... not attempted by this
  # pass"), invisible for exactly that reason until lifeadelics vendored
  # a chapter (embryonaut_bluebooks/payments) that DOES declare real
  # ones — found live, its own PaymentGateway.Succeeded port operation
  # dispatching cleanly but never triggering the Payment.Succeed its own
  # declared policy names, because the MERGED table those policies need
  # to live in was empty. See reactions.rb's own emit_merged_policy_
  # table header for the full story.
  #
  # Written into the TARGET DOMAIN'S OWN directory as `merged.rs` — never
  # a separate shared `active/` module — so it lives and dies with that
  # domain's own generated tree, coexisting with any other domain's
  # `merged.rs` the same way `registry.rs`/`mod.rs` (DomainGenerator's
  # own output, written above) already do. `mod.rs` was already written
  # by DomainGenerator.call for this domain; appended to, not replaced.
  merged_aggregates = target_aggregates + framework_aggregates
  merged_queries = target_queries + framework_queries
  merged_read_models = target_read_models + framework_read_models
  merged_path = File.join(out_root, target_mod_name, "merged.rs")
  # rubocop:disable-next Metrics/BlockLength
  File.open(merged_path, "w") do |f|
    f.puts RustProjection::Projector.emit_registry(merged_aggregates)
    f.puts
    f.puts RustProjection::Projector.emit_reference_lookup(merged_aggregates)
    f.puts
    f.puts RustProjection::Projector.emit_merged_policy_table(policy_sources)
    f.puts
    f.puts RustProjection::Projector.emit_merged_cross_domain_policy_table(policy_sources)
    f.puts
    f.puts RustProjection::Projector.emit_process_manager_table(target_ir[:process_managers] + framework_process_managers)
    f.puts
    f.puts RustProjection::Projector.emit_reference_key_table(
      chapter_mod_names.map { |mod_name, chapter_name|
        [chapter_name, (if mod_name == target_mod_name
                          target_aggregates
                        else
                          framework_aggregates.select { |a|
                            a[:chapter_mod] == mod_name
                          }
                        end).map { |a| a[:name] }]
      }
    )
    f.puts
    f.puts RustProjection::Projector.emit_creates_table(merged_aggregates)
    f.puts
    f.puts RustProjection::Projector.emit_identity_head_table(merged_aggregates)
    f.puts
    f.puts RustProjection::Projector.emit_command_attributes_table(merged_aggregates)
    f.puts
    f.puts RustProjection::Projector.emit_query_table(merged_queries)
    f.puts
    emit_group_by_bodies(f, merged_read_models)
    f.puts RustProjection::Projector.emit_read_model_table(merged_read_models)
  end
  puts "wrote #{merged_path}"
  File.open(File.join(out_root, target_mod_name, "mod.rs"), "a") { |f| f.puts "pub mod merged;" }

  # EVERY DOMAIN EVER GENERATED, SCANNED OFF DISK — not just the one this
  # run targeted. A directory counts as an activatable DOMAIN (as opposed
  # to a shared framework chapter like governance/identity, declared as a
  # plain module below but never independently selectable) exactly when
  # it carries its own merged.rs, the file this run just wrote for
  # `target_mod_name` and every prior run left behind for every domain
  # generated before it. This is what makes regenerating Embryonaut leave
  # Banking not merely present on disk but still fully SELECTABLE.
  all_dirs = Dir.children(out_root).select { |name| File.directory?(File.join(out_root, name)) }.sort
  domains  = all_dirs.select { |name| File.exist?(File.join(out_root, name, "merged.rs")) }

  root_mod_path = File.join(out_root, "mod.rs")
  # rubocop:disable-next Metrics/BlockLength
  File.open(root_mod_path, "w") do |f|
    f.puts "// GENERATED by bin/project_rust — re-run it to refresh this list."
    f.puts "pub mod meta;"
    (all_dirs - ["meta"]).each { |name| f.puts "pub mod #{name};" }
    f.puts
    f.puts "// `active` is whichever ONE domain's own merged Store/dispatch table"
    f.puts "// is selected by Cargo feature (rust/Cargo.toml, kept in sync with this"
    f.puts "// list by bin/project_rust) — kernel/cli.rs imports"
    f.puts "// `crate::generated::active::{dispatch_by_name, Store, ...}` unchanged"
    f.puts "// no matter which domain that resolves to."
    f.puts "//"
    f.puts "// DOMAIN FEATURES ARE MUTUALLY EXCLUSIVE (R5) — Cargo has no native"
    f.puts "// concept of that, and `default = [#{target_mod_name.inspect}]` in"
    f.puts "// Cargo.toml stays enabled unless a build passes"
    f.puts "// `--no-default-features`, so a plain `cargo build --features banking`"
    f.puts "// used to enable BOTH the default domain's feature and banking's,"
    f.puts "// producing two `pub use ... as active;` imports and a hard E0252."
    f.puts "// Fixed two ways below, entirely mechanically from `domains`/"
    f.puts "// `target_mod_name` (this run's new default) — never hand-maintained:"
    f.puts "//"
    f.puts "//   1. THE DEFAULT DOMAIN'S OWN re-export backs off whenever any OTHER"
    f.puts "//      domain feature is also enabled, so it never contends for `active`"
    f.puts "//      by accident — `cargo build --features banking` (still implicitly"
    f.puts "//      carrying the default feature) now resolves to banking alone,"
    f.puts "//      same as if `--no-default-features` had been passed explicitly."
    f.puts "//   2. Two NON-default domain features enabled TOGETHER (a genuine,"
    f.puts "//      not-accidental conflict — nothing makes that combination"
    f.puts "//      meaningful) still fail the build, but with an explicit"
    f.puts "//      `compile_error!` naming both features instead of a cryptic"
    f.puts "//      \"defined multiple times\"."
    domains.each do |name|
      other_domains = domains - [name]
      if name == target_mod_name && !other_domains.empty?
        guard = other_domains.map { |o| "feature = #{o.inspect}" }.join(", ")
        f.puts "#[cfg(all(feature = #{name.inspect}, not(any(#{guard}))))]"
      else
        f.puts "#[cfg(feature = #{name.inspect})]"
      end
      f.puts "pub use #{name}::merged as active;"
    end
    non_default_domains = domains - [target_mod_name]
    if non_default_domains.size > 1
      f.puts
      f.puts "// Explicit conflict guard — see point 2 above. Only fires when TWO"
      f.puts "// non-default domain features are both turned on; the default"
      f.puts "// domain's own feature never reaches here (point 1 already excludes"
      f.puts "// it whenever any other domain feature is present)."
      non_default_domains.combination(2).each do |a, b|
        f.puts "#[cfg(all(feature = #{a.inspect}, feature = #{b.inspect}))]"
        # NOTE: plain `a`/`b`/`domains.join` here, never `.inspect` — this
        # whole line is ALREADY inside one Rust string literal
        # (`compile_error!("...")`); embedding another `.inspect`'s own
        # `"quoted"` form would nest unescaped double quotes and produce
        # invalid Rust (the exact class of landmine this pass is fixing
        # elsewhere for domain names/descriptions — not repeating it here).
        f.puts "compile_error!(\"domain features are mutually exclusive — enable only one of: #{domains.join(', ')} " \
               "(both #{a} and #{b} are enabled)\");"
      end
    end
  end
  puts "wrote #{root_mod_path}"

  # CARGO.TOML KEPT IN SYNC — one feature per domain on disk (added if
  # missing, never removed here: a domain this run didn't touch stays
  # selectable, per the scoped-clearing change above), `default` set to
  # THIS run's own domain so a plain `cargo build`/`cargo test` keeps
  # behaving exactly like it always has — whichever domain you just ran
  # bin/project_rust for is what a bare build gives you. Any OTHER
  # still-present domain remains reachable explicitly:
  # `cargo build --no-default-features --features banking`.
  #
  # Inserted right after the `default = [...]` line, not appended to the
  # end of the file — Cargo.toml is TOML, and a bare `name = []` appended
  # past `[[bin]]` would parse as belonging to THAT table, not `[features]`.
  cargo_toml_path = File.expand_path("../rust/Cargo.toml", __dir__)
  cargo_toml = File.read(cargo_toml_path)
  unless cargo_toml.include?("[features]")
    cargo_toml = cargo_toml.sub(/\A/, <<~TOML)
      # ONE FEATURE PER GENERATED DOMAIN — selects which domain's own
      # generated::<domain>::merged module `generated::active` re-exports
      # (rust/src/generated/mod.rs). Kept in sync by bin/project_rust: a
      # feature is added here whenever a new domain is generated, never
      # removed (the domain's own generated/<name>/ directory is the
      # source of truth for whether it still exists). `default` tracks
      # whichever domain was generated MOST RECENTLY, so a bare
      # `cargo build`/`cargo test` keeps behaving exactly as it always
      # has; any other still-generated domain stays reachable via
      # `--no-default-features --features <name>`.
      [features]
      default = []

    TOML
  end
  # SCOPED TO THE `[features]` TABLE ONLY (R5) — checking `name = ` against
  # the WHOLE file (as a bare `cargo_toml =~ /^name\s*=/` used to) false-
  # positives against `[package]`'s `name`/`version`/`edition`, `[lib]`'s
  # `name`/`path`, `[[bin]]`'s `name`/`path` — real TOML keys that share a
  # word with a domain name (see the guard above, which now rejects a
  # domain named one of those outright, but this scoping is the honest
  # structural fix underneath it: a feature genuinely named e.g. `roster`
  # should only ever be looked up inside `[features]`).
  features_table = cargo_toml[/^\[features\](?:\n(?!\[).*)*$/] || ""
  domains.each do |name|
    next if features_table =~ /^#{Regexp.escape(name)}\s*=/

    cargo_toml = cargo_toml.sub(/^default\s*=.*$/) { "#{Regexp.last_match(0)}\n#{name} = []" }
    features_table = cargo_toml[/^\[features\](?:\n(?!\[).*)*$/] || ""
  end
  cargo_toml = cargo_toml.sub(/^default\s*=.*$/, "default = [#{target_mod_name.inspect}]")
  File.write(cargo_toml_path, cargo_toml)
  puts "wrote #{cargo_toml_path} (default feature: #{target_mod_name})"

end
