#!/usr/bin/env ruby

# Generates Rust source for one domain into rust/src/generated/.
#
#   bin/project_rust <domain>
#
# A shim: the work is Hecks::RustBuild (lib/hecks/rust_build/).

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_rust")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/rust_build"

exit Hecks::RustBuild.run("project_rust", ARGV)
