#!/usr/bin/env ruby

# Generates Rust source for one domain into rust/src/generated/; see
# rust/project.rb (RustProjection) for the full architecture.
#
#   bin/project_rust <domain>

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_rust")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "hecks/bluebook/meta_validator"
require_relative "../rust/project"
require "fileutils"
require "json"

# merged.rs needs each read model's group_by_fn_body written before
# emit_read_model_table references it by bare function name.
def emit_group_by_bodies(file, read_models)
  read_models.each do |rmd|
    next unless rmd[:group_by_fn_body]

    file.puts rmd[:group_by_fn_body]
    file.puts
  end
end

# Required unconditionally (the era/lineage subsystem is a loadable
# plugin per ADR 0033, not something core pulls in) so this generator
# works for any domain, lineage-capable or not; safe because
# `require "pg"` stays lazy inside PostgresEra.connect_for — nothing
# here opens a database connection.
require "hecks/ports/persistence/plugins/era"

domain = ARGV.shift or abort "usage: bin/project_rust <domain>"

# Validated before any side effect below (the meta/active directory
# wipes especially) — an invalid name must not leave
# rust/src/generated/meta/ deleted with nothing regenerated.
# `target_mod_name` becomes a directory name, a literal Rust `pub mod`
# identifier, and a Cargo feature name, so it must be a legal identifier
# and avoid Rust keywords, Cargo's reserved [package]/[lib]/[[bin]] keys,
# and `default` itself. See rust/project/naming.rb (RUST_KEYWORDS and
# the reserved Cargo names) for the checks.
unless RustProjection::Projector.valid_domain_mod_name?(File.basename(domain))
  abort "bin/project_rust: domain name #{File.basename(domain).inspect} (from #{domain.inspect}) can't be used " \
        "as-is — it has to double as a Rust module identifier and a Cargo feature name, and this one is " \
        "either not a plain lowercase identifier, is a Rust keyword, or collides with a reserved Cargo.toml " \
        "key (#{RustProjection::Projector::CARGO_RESERVED_DOMAIN_NAMES.join(', ')}). Rename the domain directory."
end

# HECKS_PARSER=rust HECKS_CODEGEN=rust runs the whole pipeline (parse and
# codegen) through rust/parser and rust/codegen instead, with no
# Kernel.load of any domain bluebook — see rust/project_rust_pipeline.rb
# for the full contract. Both flags are required together: either alone
# would exercise a narrower path nothing else needs, so the pairing keeps
# the opt-in meaning exactly one thing. The default below covers no env
# vars, or only one of the two set.
if ENV["HECKS_PARSER"] == "rust" && ENV["HECKS_CODEGEN"] == "rust"
  require_relative "../rust/project_rust_pipeline"
  RustProjectPipeline.call(domain)
else

  # Round-trips a Ruby value through JSON so generator code only ever sees
  # the String-keyed shape a real ir.json sidecar carries, never live
  # Ruby Symbols a future Rust-side parser's output couldn't produce.
  def json_shaped(payload) = JSON.parse(JSON.generate(payload), symbolize_names: true)

  # `root:` — without it, a domain declaring `uses_embryonaut_bluebook`
  # can't resolve vendor/embryonaut_bluebooks/<name>/bluebook/, since
  # EmbryonautBluebook.load! resolves that path off this registry's own
  # root. `domain` itself is the root here (not its parent) — a domain's
  # vendor/ sits directly inside its own directory.
  target_registry = Hecks::Runtime::Registry.new(root: File.expand_path(domain))
  # Declared here, not first-assigned inside the block below — a block
  # opens its own local scope, so a variable only assigned inside
  # `with_registry do ... end` would vanish once the block returns.
  bluebook_directory = nil
  Hecks.with_registry(target_registry) do
    Kernel.load(File.expand_path("../lib/hecks/ports/persistence.port", __dir__))
    Kernel.load(File.expand_path("../lib/hecks/ports/extraction.port", __dir__))
    Kernel.load(File.expand_path("../lib/hecks/adapters/driven/memory.adapter", __dir__))
    Kernel.load(File.expand_path("../lib/hecks/adapters/driven/prism.adapter", __dir__))
    # The DSL declaration (name + fields), not the Ruby class required
    # above — EraCheck.lineage_capable? checks both
    # registry.adapters["PostgresEra"] (from this load) and
    # registry.adapter_class("PostgresEra") (from the require above) in
    # sequence; either missing silently answers false.
    Kernel.load(File.expand_path("../lib/hecks/adapters/driven/postgres_era.adapter", __dir__))
    # Every *.bluebook file directly in the domain directory, not just
    # "<domain>.bluebook" — a domain can split its aggregates across
    # several sibling files, none matching that pattern alone. Loaded via
    # `Adapters::Folder#load_bluebooks`'s own sorted glob, so load order
    # stays stable regardless of how many sibling files exist.
    bluebook_directory = File.join(domain, "bluebook")
    Hecks::Adapters::Folder.new.load_bluebooks(bluebook_directory)

    # Also every translations/*.bluebook edge, in the same load-order
    # position Vocabulary's LoadOrder gives them (between the domain's
    # own .bluebook and .hecksagon). `load_bluebooks`'s default pattern
    # doesn't reach this subdirectory, so it's a separate, explicit glob;
    # `Dir[]` is already sorted, so multiple edges load in a stable order.
    Dir[File.join(bluebook_directory, "translations", "*.bluebook")].each { |file| Kernel.load(file) }

    # Also every .hecksagon file — this fires `uses_framework`, which
    # loads that framework member's own .bluebook into this same registry
    # as a side effect (HecksagonBuilder#uses_framework -> Framework.load!).
    Dir.glob(File.join(bluebook_directory, "*.hecksagon")).each { |file| Kernel.load(file) }

    # Every .world file too — its `default_adapter` binds the aggregates
    # a hecksagon leaves out (BindingPolicy.resolve), which
    # Exporter.persistence/lineage below both need. Loaded after the
    # hecksagons per Vocabulary's LoadOrder.
    Dir.glob(File.join(bluebook_directory, "*.world")).each { |file| Kernel.load(file) }

    # Mirrors `Adapters::Folder#load_domain`'s own `environment:` handling,
    # which this hand-rolled registry build otherwise skips — without it,
    # a domain that splits persistence wiring per environment
    # (bluebook/environments/*.hecksagon) has no `persisted_by` binds
    # merged in, and `BindingPolicy.resolve` raises "no persisted_by bind".
    #
    # Defaults to "production" when environments/production.hecksagon
    # exists (rust/host is the production runtime); override with
    # `HECKS_PROJECT_ENVIRONMENT`. Domains with no `environments/` stay
    # byte-identical.
    target_environment = ENV.fetch("HECKS_PROJECT_ENVIRONMENT") do
      prod = File.join(bluebook_directory, "environments", "production.hecksagon")
      File.exist?(prod) ? "production" : nil
    end
    if target_environment && !target_environment.empty?
      folder = Hecks::Adapters::Folder.new
      folder.load_each(bluebook_directory, [File.join("environments", "#{target_environment}.hecksagon")])
      folder.load_each(bluebook_directory, [File.join("environments", "#{target_environment}.world")])
    end
  end

  # Ruby Hash preserves insertion order, so the target domain's own
  # chapter (loaded first, above) stays keys.first regardless of how many
  # framework chapters get pulled in afterward.
  target_domain_name = target_registry.bluebooks.keys.first
  target_ir = json_shaped(Hecks::Projector::Exporter.call(target_registry).fetch(target_domain_name))

  # Merged in, not part of `Exporter.call`'s own output (a binding fact,
  # not a shape fact — ADR 0001: `bluebook.to_h` never mentions an
  # adapter), so it rides as its own top-level key alongside the IR.
  target_ir[:lineage] = json_shaped(Hecks::Projector::Exporter.lineage(target_registry, target_domain_name))

  # Same seam as lineage above — `Exporter.persistence` needs no
  # era-plugin guard (`BindingPolicy` is core) and covers every
  # aggregate; `rust/host` reads it to refuse loudly at boot against an
  # adapter it has no backend for.
  target_ir[:persistence] = json_shaped(Hecks::Projector::Exporter.persistence(target_registry, target_domain_name))

  # Same seam — `rust/host` reads the grant verb and assignment aggregate
  # from here instead of naming Governance directly. Omitted entirely
  # when nothing attached provides "authorization".
  authorization = Hecks::Projector::Exporter.authorization(target_registry, target_domain_name)
  target_ir[:authorization] = json_shaped(authorization) unless authorization.empty?

  # Same seam as authorization — rust/host reads this instead of
  # HECKS_MEMBERSHIP_AGGREGATE. Omitted entirely when nothing attached
  # provides "membership".
  membership = Hecks::Projector::Exporter.membership(target_registry, target_domain_name)
  target_ir[:membership] = json_shaped(membership) unless membership.empty?

  # Same seam as authorization/membership — rust/host reads this instead
  # of naming Identity:: verbs. Omitted entirely when nothing attached
  # provides "identity".
  identity = Hecks::Projector::Exporter.identity(target_registry, target_domain_name)
  target_ir[:identity] = json_shaped(identity) unless identity.empty?

  # Same seam again — rust/host's newsletter routes read this instead of
  # naming Newsletter::Subscriber verbs. Omitted entirely when nothing
  # attached provides "newsletter".
  newsletter = Hecks::Projector::Exporter.newsletter(target_registry, target_domain_name)
  target_ir[:newsletter] = json_shaped(newsletter) unless newsletter.empty?

  # And again for sending an issue — rust/host's send route reads this
  # instead of naming Newsletter::Issue.Send. Omitted entirely when
  # nothing attached provides "newsletter_issues".
  newsletter_issues = Hecks::Projector::Exporter.newsletter_issues(target_registry, target_domain_name)
  target_ir[:newsletter_issues] = json_shaped(newsletter_issues) unless newsletter_issues.empty?

  # And again for payments — rust/host's checkout and webhook routes read
  # this instead of naming Payments::Payment verbs. Omitted entirely when
  # nothing attached provides "payments".
  payments = Hecks::Projector::Exporter.payments(target_registry, target_domain_name)
  target_ir[:payments] = json_shaped(payments) unless payments.empty?

  # And again for events and registrations, and for the payment-processor
  # connection — rust/host's registration and payments-connection routes read
  # these instead of naming Event.Schedule, Registration.Request and
  # PaymentConnection's commands. Each omitted entirely when nothing attached
  # provides it.
  registrations = Hecks::Projector::Exporter.registrations(target_registry, target_domain_name)
  target_ir[:registrations] = json_shaped(registrations) unless registrations.empty?
  payment_connection = Hecks::Projector::Exporter.payment_connection(target_registry, target_domain_name)
  target_ir[:payment_connection] = json_shaped(payment_connection) unless payment_connection.empty?

  if !membership.empty? && identity.empty?
    abort "#{target_domain_name} provides membership but not identity — rust/host " \
          "Google sign-in cannot register or link an identity from ir.json. " \
          "Attach Identity (`uses_framework \"Identity\"` plus a sibling " \
          "Hecks.hecksagon \"Identity\") so the hecksagon, not a deploy-time " \
          "guess, names the identity verbs."
  end

  # Same seam — `Exporter.translations` walks the whole registry (which
  # can hold another domain's edges via uses_framework too), filtered to
  # this target domain before it reaches `target_ir`. Each edge already
  # carries its own precompiled SQL (Translation::RuleCompiler), so a
  # future boot-time-mint consumer only executes it, never recompiles.
  target_ir[:translations] = json_shaped(
    Hecks::Projector::Exporter.translations(target_registry).select { |edge| edge[:domain] == target_domain_name }
  )

  # The raw bluebook source text — a binding fact like lineage/translations
  # above, not part of `bluebook.to_h`'s canonical IR (ADR 0001), but one
  # a future Rust-side mint needs verbatim: `hecks_eras.held_text` is this
  # exact string, and era_store.rb's integrity digest is SHA256 of it, not
  # of anything re-derived from the parsed IR.
  #
  # `Runtime::EraCheck.source_text_for` finds the file(s) that actually
  # declare the bluebook by name, rather than guessing a path from the
  # domain directory's own basename — a guess that breaks whenever the
  # containing directory isn't itself named after the domain.
  target_ir[:source_text] = Hecks::Runtime::EraCheck.source_text_for(
    target_registry.bluebooks.fetch(target_domain_name), bluebook_directory, registry: target_registry
  )

  # The self-hosted language, compiled in too. `lib/hecks/language/bluebook/`
  # declares what a bluebook is (Aggregate, Command, ValueObject, Query,
  # Entity, Member, Policy, ProcessManager, Handler, Dispatch, Vocabulary,
  # Syntax, ReadModel) in the same DSL any business domain uses, so it goes
  # through the identical codegen pipeline as `target_ir`. Reuses
  # `MetaValidator.grammar_registry` (the real boot sequence) rather than
  # re-deriving it, so this can't silently drift from what MetaValidator
  # itself loads.
  meta_ir = json_shaped(Hecks::Projector::Exporter.call(Hecks::Bluebook::MetaValidator.grammar_registry).fetch("Bluebook"))

  # `HECKS_RUST_DIR` — which crate this projects into. Unset, it is this
  # repository's own `rust/`, exactly as always. `bin/qa_generated_domains
  # --rust` points it at a scratch copy of the crate, so projecting a
  # domain the generator wrote never touches the checked-in generated
  # tree or `rust/Cargo.toml`.
  rust_dir = ENV.fetch("HECKS_RUST_DIR", File.expand_path("../rust", __dir__))
  out_root = File.join(rust_dir, "src/generated")
  FileUtils.mkdir_p(out_root)

  # Scoped per-directory, not a whole-tree wipe — multiple domains coexist
  # on disk (Cargo features select which compiles in), so regenerating one
  # must not erase another. WriteIfChanged tracks writes instead of
  # rm_rf'ing first: `pop_and_prune`, once every write below finishes,
  # deletes only files this run never touched — the same stale-file
  # guarantee without bumping every untouched file's mtime.
  RustProjection::WriteIfChanged.push_directory(File.join(out_root, "meta"))
  # `active` is now a set of `#[cfg(feature = ...)]` re-exports in the
  # root mod.rs below, never a directory of its own — deleted outright
  # here, not tracked, since nothing should write here again.
  FileUtils.rm_rf(File.join(out_root, "active"))

  # Already validated at the top of this script, before any side effect.
  target_mod_name = File.basename(domain)

  RustProjection::WriteIfChanged.push_directory(File.join(out_root, target_mod_name))
  meta_result = RustProjection::DomainGenerator.call(meta_ir, "the self-hosted language (lib/hecks/language/bluebook)",
                                                     File.join(out_root, "meta"), "meta")

  # Meta gets its own merged.rs — the file that makes a generated module
  # selectable as its own compiled artifact (see bin/rust_coverage on what
  # makes a directory "an independently selectable domain"). Meta attaches
  # no other chapter, so this is just its single-chapter registry restated
  # under the same filename every other domain writes.
  meta_merged_path = File.join(out_root, "meta", "merged.rs")
  # rubocop:disable-next Metrics/BlockLength -- one line per emit_* table
  # call, same shape as the target domain's own merged_wrote block below.
  meta_merged_wrote = RustProjection::WriteIfChanged.block(meta_merged_path) do |f|
    f.puts RustProjection::Projector.emit_registry(meta_result[:aggregates])
    f.puts
    f.puts RustProjection::Projector.emit_reference_lookup(meta_result[:aggregates])
    f.puts
    f.puts RustProjection::Projector.emit_policy_table(meta_ir[:name], meta_ir[:policies], meta_ir[:aggregates])
    f.puts
    f.puts RustProjection::Projector.emit_cross_domain_policy_table(meta_ir[:name], meta_ir[:policies])
    f.puts
    f.puts RustProjection::Projector.emit_process_manager_table(meta_ir[:process_managers])
    f.puts
    f.puts RustProjection::Projector.emit_reference_key_table([[meta_ir[:name], meta_result[:aggregates].map { |a| a[:name] }]])
    f.puts
    f.puts RustProjection::Projector.emit_creates_table(meta_result[:aggregates])
    f.puts
    f.puts RustProjection::Projector.emit_identity_head_table(meta_result[:aggregates])
    f.puts
    f.puts RustProjection::Projector.emit_entity_identity_head_table(meta_result[:aggregates])
    f.puts
    f.puts RustProjection::Projector.emit_command_attributes_table(meta_result[:aggregates])
    f.puts
    f.puts RustProjection::Projector.emit_query_table(meta_result[:queries])
    f.puts
    f.puts RustProjection::Projector.emit_query_arg_check_table(meta_result[:queries])
    f.puts
    emit_group_by_bodies(f, meta_result[:read_models])
    f.puts RustProjection::Projector.emit_read_model_table(meta_result[:read_models])
  end
  puts(meta_merged_wrote ? "wrote #{meta_merged_path}" : "#{meta_merged_path} unchanged")
  meta_mod_path = File.join(out_root, "meta", "mod.rs")
  # Appended, not overwritten — a bare File.open("a") would append this
  # same line again on every call, growing the file and bumping its mtime
  # regardless. Skipped once the line is already present.
  unless File.exist?(meta_mod_path) && File.read(meta_mod_path).include?("pub mod merged;")
    File.open(meta_mod_path, "a") { |f| f.puts "pub mod merged;" }
  end
  RustProjection::WriteIfChanged.pop_and_prune(File.join(out_root, "meta"))

  target_result = RustProjection::DomainGenerator.call(target_ir, domain, File.join(out_root, target_mod_name), target_mod_name)
  target_aggregates = target_result[:aggregates]
  target_queries = target_result[:queries]
  target_read_models = target_result[:read_models]

  # Every other bluebook now in the registry — the target's own
  # uses_framework calls (fired above) pulled these in as a side effect.
  # Each is generated into its own module (rust/src/generated/governance/,
  # .../identity/, ...), the same call shape as meta/the target domain
  # above; no chapter is privileged. Framework chapters are shared across
  # every domain that attaches them and are a pure function of the
  # framework bluebook alone, so regenerating one here is safe and
  # idempotent regardless of which other domain last touched it.
  chapter_mod_names = { target_mod_name => target_domain_name }
  framework_aggregates = []
  framework_queries = []
  framework_read_models = []
  framework_process_managers = []
  # One entry per chapter (target first), carrying exactly what
  # emit_merged_policy_table/emit_merged_cross_domain_policy_table need
  # to qualify that chapter's own policies against its own aggregates,
  # never the target's.
  policy_sources = [{ domain_name: target_domain_name, policies: target_ir[:policies], aggregates: target_ir[:aggregates] }]
  # Labels each chapter by how the target actually attached it. Checked
  # across every hecksagon the registry loaded, not just the target's own
  # — a chapter a sibling hecksagon vendors in (or pulls in transitively
  # via its own uses_framework) is still labeled correctly, never
  # mislabeled just because the check looked only at the target's own
  # hecksagon. A vendored name is recorded lowercase and resolved to the
  # chapter name via `Naming.pascal`.
  all_vendored_names = target_registry.hecksagons.values.flat_map(&:vendored_bluebooks)
  (target_registry.bluebooks.keys - [target_domain_name]).each do |chapter_name|
    chapter_mod_name = chapter_name.downcase
    chapter_mod_names[chapter_mod_name] = chapter_name
    chapter_ir = json_shaped(Hecks::Projector::Exporter.call(target_registry).fetch(chapter_name))
    vendored_name = all_vendored_names.find { |name| Hecks::Naming.pascal(name.to_s) == chapter_name }
    attachment_label =
      if vendored_name
        "uses_embryonaut_bluebook #{vendored_name.inspect}"
      else
        "uses_framework #{chapter_name.inspect}"
      end
    chapter_result = nil
    RustProjection::WriteIfChanged.track_directory(File.join(out_root, chapter_mod_name)) do
      chapter_result = RustProjection::DomainGenerator.call(chapter_ir, "#{domain} (#{attachment_label})",
                                                            File.join(out_root, chapter_mod_name), chapter_mod_name,
                                                            merged_module: false)
    end
    framework_aggregates.concat(chapter_result[:aggregates])
    framework_queries.concat(chapter_result[:queries])
    framework_read_models.concat(chapter_result[:read_models])
    framework_process_managers.concat(chapter_ir[:process_managers])
    policy_sources << { domain_name: chapter_name, policies: chapter_ir[:policies], aggregates: chapter_ir[:aggregates] }
  end

  # One merged Store/dispatch_by_name spanning the target domain and every
  # framework chapter it attaches — the same call shape works over the
  # union since nothing about a single-chapter call was privileged.
  # Policies and process managers merge across chapters too: leaving that
  # to just the target domain misses a vendored chapter's own policies
  # (see reactions.rb's emit_merged_policy_table header).
  #
  # Written into the target domain's own directory as `merged.rs`,
  # coexisting with any other domain's `merged.rs` the way `mod.rs`
  # already does.
  merged_aggregates = target_aggregates + framework_aggregates
  merged_queries = target_queries + framework_queries
  merged_read_models = target_read_models + framework_read_models
  merged_path = File.join(out_root, target_mod_name, "merged.rs")
  # rubocop:disable-next Metrics/BlockLength
  merged_wrote = RustProjection::WriteIfChanged.block(merged_path) do |f|
    f.puts RustProjection::Projector.emit_registry(merged_aggregates)
    f.puts
    f.puts RustProjection::Projector.emit_reference_lookup(merged_aggregates)
    f.puts
    f.puts RustProjection::Projector.emit_merged_policy_table(policy_sources)
    f.puts
    f.puts RustProjection::Projector.emit_merged_cross_domain_policy_table(policy_sources)
    f.puts
    f.puts RustProjection::Projector.emit_process_manager_table(target_ir[:process_managers] + framework_process_managers)
    f.puts
    f.puts RustProjection::Projector.emit_reference_key_table(
      chapter_mod_names.map { |mod_name, chapter_name|
        [chapter_name, (if mod_name == target_mod_name
                          target_aggregates
                        else
                          framework_aggregates.select { |a|
                            a[:chapter_mod] == mod_name
                          }
                        end).map { |a| a[:name] }]
      }
    )
    f.puts
    f.puts RustProjection::Projector.emit_creates_table(merged_aggregates)
    f.puts
    f.puts RustProjection::Projector.emit_identity_head_table(merged_aggregates)
    f.puts
    f.puts RustProjection::Projector.emit_entity_identity_head_table(merged_aggregates)
    f.puts
    f.puts RustProjection::Projector.emit_command_attributes_table(merged_aggregates)
    f.puts
    f.puts RustProjection::Projector.emit_query_table(merged_queries)
    f.puts
    f.puts RustProjection::Projector.emit_query_arg_check_table(merged_queries)
    f.puts
    emit_group_by_bodies(f, merged_read_models)
    f.puts RustProjection::Projector.emit_read_model_table(merged_read_models)
  end
  puts(merged_wrote ? "wrote #{merged_path}" : "#{merged_path} unchanged")
  target_mod_path = File.join(out_root, target_mod_name, "mod.rs")
  # Same append-guard as the meta chapter's own merged.rs above — skip
  # re-appending an already-present line rather than growing the file
  # (and bumping its mtime) on every regeneration.
  unless File.exist?(target_mod_path) && File.read(target_mod_path).include?("pub mod merged;")
    File.open(target_mod_path, "a") { |f| f.puts "pub mod merged;" }
  end
  RustProjection::WriteIfChanged.pop_and_prune(File.join(out_root, target_mod_name))

  # Every domain ever generated, scanned off disk — not just this run's
  # target. A directory counts as an activatable domain (vs. a shared
  # framework chapter like governance/identity, always compiled in but
  # never independently selectable) exactly when it carries its own
  # merged.rs.
  all_dirs = Dir.children(out_root).select { |name| File.directory?(File.join(out_root, name)) }.sort
  domains  = all_dirs.select { |name| File.exist?(File.join(out_root, name, "merged.rs")) }

  root_mod_path = File.join(out_root, "mod.rs")
  # rubocop:disable-next Metrics/BlockLength
  root_mod_wrote = RustProjection::WriteIfChanged.block(root_mod_path) do |f|
    f.puts "// GENERATED by bin/project_rust — re-run it to refresh this list."
    f.puts "//"
    f.puts "// BUG#25 — every DOMAIN (an entry in `domains`, below: a directory"
    f.puts "// carrying its own merged.rs and therefore its own Cargo feature) is"
    f.puts "// declared behind that SAME feature, so a broken or absent domain's"
    f.puts "// generated code is never even compiled into a build that selects a"
    f.puts "// DIFFERENT domain — `cargo build --features waybill` used to pull in"
    f.puts "// every OTHER domain's `pub mod` unconditionally, so one domain's own"
    f.puts "// non-compiling generated code (a `has_many` field, before this fix)"
    f.puts "// broke every feature's build, not just its own. A shared FRAMEWORK"
    f.puts "// chapter (governance/identity — no merged.rs of its own, so absent"
    f.puts "// from `domains`) stays unconditional: it has no single feature of its"
    f.puts "// own to gate behind, and is compiled in by whichever domain(s) attach"
    f.puts "// it via `uses_framework`."
    all_dirs.each do |name|
      f.puts "#[cfg(feature = #{name.inspect})]" if domains.include?(name)
      f.puts "pub mod #{name};"
    end
    f.puts
    f.puts "// `active` is whichever ONE domain's own merged Store/dispatch table"
    f.puts "// is selected by Cargo feature (rust/Cargo.toml, kept in sync with this"
    f.puts "// list by bin/project_rust) — kernel/cli.rs imports"
    f.puts "// `crate::generated::active::{dispatch_by_name, Store, ...}` unchanged"
    f.puts "// no matter which domain that resolves to."
    f.puts "//"
    f.puts "// DOMAIN FEATURES ARE MUTUALLY EXCLUSIVE (R5) — Cargo has no native"
    f.puts "// concept of that, and `default = [#{target_mod_name.inspect}]` in"
    f.puts "// Cargo.toml stays enabled unless a build passes"
    f.puts "// `--no-default-features`, so a plain `cargo build --features banking`"
    f.puts "// used to enable BOTH the default domain's feature and banking's,"
    f.puts "// producing two `pub use ... as active;` imports and a hard E0252."
    f.puts "// Fixed two ways below, entirely mechanically from `domains`/"
    f.puts "// `target_mod_name` (this run's new default) — never hand-maintained:"
    f.puts "//"
    f.puts "//   1. THE DEFAULT DOMAIN'S OWN re-export backs off whenever any OTHER"
    f.puts "//      domain feature is also enabled, so it never contends for `active`"
    f.puts "//      by accident — `cargo build --features banking` (still implicitly"
    f.puts "//      carrying the default feature) now resolves to banking alone,"
    f.puts "//      same as if `--no-default-features` had been passed explicitly."
    f.puts "//   2. Two NON-default domain features enabled TOGETHER (a genuine,"
    f.puts "//      not-accidental conflict — nothing makes that combination"
    f.puts "//      meaningful) still fail the build, but with an explicit"
    f.puts "//      `compile_error!` naming both features instead of a cryptic"
    f.puts "//      \"defined multiple times\"."
    domains.each do |name|
      other_domains = domains - [name]
      if name == target_mod_name && !other_domains.empty?
        guard = other_domains.map { |o| "feature = #{o.inspect}" }.join(", ")
        f.puts "#[cfg(all(feature = #{name.inspect}, not(any(#{guard}))))]"
      else
        f.puts "#[cfg(feature = #{name.inspect})]"
      end
      f.puts "pub use #{name}::merged as active;"
    end
    non_default_domains = domains - [target_mod_name]
    if non_default_domains.size > 1
      f.puts
      f.puts "// Explicit conflict guard — see point 2 above. Only fires when TWO"
      f.puts "// non-default domain features are both turned on; the default"
      f.puts "// domain's own feature never reaches here (point 1 already excludes"
      f.puts "// it whenever any other domain feature is present)."
      non_default_domains.combination(2).each do |a, b|
        f.puts "#[cfg(all(feature = #{a.inspect}, feature = #{b.inspect}))]"
        # Plain `a`/`b`/`domains.join` here, never `.inspect` — this whole
        # line already sits inside one Rust string literal
        # (`compile_error!("...")`), and `.inspect`'s own quoted form
        # would nest unescaped double quotes and produce invalid Rust.
        f.puts "compile_error!(\"domain features are mutually exclusive — enable only one of: #{domains.join(', ')} " \
               "(both #{a} and #{b} are enabled)\");"
      end
    end
  end
  puts(root_mod_wrote ? "wrote #{root_mod_path}" : "#{root_mod_path} unchanged")

  # Cargo.toml kept in sync — one feature per domain on disk (added if
  # missing, never removed: a domain this run didn't touch stays
  # selectable), `default` set to this run's own domain so a plain
  # `cargo build`/`cargo test` behaves as before. Other domains stay
  # reachable via `--no-default-features --features <name>`.
  #
  # Inserted right after `default = [...]`, not appended to the file's
  # end — Cargo.toml is TOML, and appending past [[bin]] would parse into
  # that table, not [features].
  cargo_toml_path = File.join(rust_dir, "Cargo.toml")
  cargo_toml = File.read(cargo_toml_path)
  unless cargo_toml.include?("[features]")
    cargo_toml = cargo_toml.sub(/\A/, <<~TOML)
      # ONE FEATURE PER GENERATED DOMAIN — selects which domain's own
      # generated::<domain>::merged module `generated::active` re-exports
      # (rust/src/generated/mod.rs). Kept in sync by bin/project_rust: a
      # feature is added here whenever a new domain is generated, never
      # removed (the domain's own generated/<name>/ directory is the
      # source of truth for whether it still exists). `default` tracks
      # whichever domain was generated MOST RECENTLY, so a bare
      # `cargo build`/`cargo test` keeps behaving exactly as it always
      # has; any other still-generated domain stays reachable via
      # `--no-default-features --features <name>`.
      [features]
      default = []

    TOML
  end
  # Scoped to the `[features]` table only — checking `name = ` against
  # the whole file would false-positive against `[package]`'s
  # `name`/`version`/`edition` or `[lib]`/`[[bin]]`'s `name`/`path`, real
  # TOML keys that can share a word with a domain name.
  features_table = cargo_toml[/^\[features\](?:\n(?!\[).*)*$/] || ""
  domains.each do |name|
    next if features_table =~ /^#{Regexp.escape(name)}\s*=/

    cargo_toml = cargo_toml.sub(/^default\s*=.*$/) { "#{Regexp.last_match(0)}\n#{name} = []" }
    features_table = cargo_toml[/^\[features\](?:\n(?!\[).*)*$/] || ""
  end
  cargo_toml = cargo_toml.sub(/^default\s*=.*$/, "default = [#{target_mod_name.inspect}]")
  # Skips the write when content is unchanged — an unconditional
  # File.write here bumps Cargo.toml's mtime and forces Cargo to treat
  # the whole crate as dirty on the next build, even a content-identical
  # wasm rebuild.
  wrote = RustProjection::WriteIfChanged.call(cargo_toml_path, cargo_toml)
  if wrote
    puts "wrote #{cargo_toml_path} (default feature: #{target_mod_name})"
  else
    puts "#{cargo_toml_path} unchanged (default feature already #{target_mod_name})"
  end

end
