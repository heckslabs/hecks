#!/usr/bin/env ruby

# Prints every aggregate's current records, as JSON — the head, not
# the journal (bin/history prints the full write history instead).
#
#   bin/stores <domain>

# The logic is `Hecks::CLI::Stores` (lib/hecks/cli/stores.rb), which
# `hecks stores` also runs.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("stores")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/stores"

Hecks::CLI::Stores.call(ARGV, program: "bin/stores")
