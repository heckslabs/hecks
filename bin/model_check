#!/usr/bin/env ruby

# Static analysis over the IR: unreachable lifecycle states, dead
# transitions, saga states no handler chain reaches, dispatches to
# commands that don't exist, handlers for events nothing emits.
#
# None of this is checked at runtime — a dead transition simply never
# fires, in silence.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/model_check"

Hecks::CLI::ModelCheck.call(ARGV, program: "bin/model_check", root: File.expand_path("..", __dir__))
