#!/usr/bin/env ruby

# Static analysis over the IR — unreachable lifecycle states, transitions
# nothing can ever fire, saga states no handler chain reaches, a
# compensation whose from_state is unreachable (the deadlock class),
# dispatches to a command that does not exist, handlers listening for an
# event nothing emits.
#
# Every one of these is a fact the runtime never checks: a dead
# transition simply never fires, in silence, and a saga stuck waiting
# for an unreachable state looks identical to one that is merely rare.
# This is the lightweight-formal-methods leg of the verification arc —
# TLA+/Alloy/P over the same IR the runtime dispatches against, so
# there is no second model to fall out of sync with the first.
#
# Boots every corpus member the same way corpus_spec walks it (each
# example, each grammar chapter) plus the language's own meta chapters
# — the checker checks the language too.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks"
require "hecks/bluebook/model_check"

ROOT = File.expand_path("..", __dir__)

def boot(source)
  registry = Hecks::Runtime::Registry.new
  Hecks.with_registry(registry) do
    Kernel.load(File.join(ROOT, "lib/hecks/ports/persistence.port"))
    Kernel.load(File.join(ROOT, "lib/hecks/ports/extraction.port"))
    Kernel.load(File.join(ROOT, "lib/hecks/adapters/driven/memory.adapter"))
    Kernel.load(File.join(ROOT, "lib/hecks/adapters/driven/prism.adapter"))
    folder = Hecks::Adapters::Folder.new
    if File.directory?(source)
      folder.load_bluebooks(source)
    else
      folder.load_bluebooks(File.dirname(source), [File.basename(source)])
    end

    # **The sibling hecksagon, if one exists** — a port attaches to its
    # aggregate/chapter from there, not the bluebook (see
    # hecksagon_builder.rb), so a deaf-policy check that never loads it
    # would see a policy reacting to an event nothing appears to emit.
    # No adapter needs to actually resolve here : recording a bind builds
    # IR only, `registry.verify!` (never called by this tool) is what
    # would need one.
    hecksagon = if File.directory?(source)
                  Dir.glob(File.join(source, "*.hecksagon")).min
                else
                  source.sub(/\.bluebook\z/, ".hecksagon")
                end
    Kernel.load(hecksagon) if hecksagon && File.exist?(hecksagon)
  end
  registry
end

# `known_domains:` — every bluebook/hecksagon name booted anywhere across
# this run, not just this one target — see `boot_all`'s own comment for
# how it's built. `nil` for the single-target CLI form (`bin/model_check
# some/domain`), where only that one target's own boot is ever seen —
# a real, accepted reduction in the cross-domain check's own reach for
# that narrower form, not a bug.
#
# `rust_target` — the domain has a Cargo feature in rust/Cargo.toml (the
# same inference `Fuzzing::TargetCapabilities` makes for bin/qa_sweep), so
# a `rust_reserved_name` finding is an error for it, not a warning.
# `STRICT` (`--strict`) makes it an error for every target.
def examine(name, registry, known_domains: nil)
  puts "── #{name}"

  rust_target = Hecks::Fuzzing::TargetCapabilities.rust_feature?(name, File.join(ROOT, "rust"))
  chapters = registry.bluebooks.values
  findings = chapters.flat_map do |chapter|
    Hecks::Bluebook::ModelCheck.call(chapter, hecksagon: registry.hecksagon(chapter.name), known_domains: known_domains,
                                              rust_target: rust_target, strict: STRICT)
  end

  allowed = Hecks::Bluebook::ModelCheck::ALLOWED_FINDINGS.fetch(name, [])
  matched, findings = findings.partition { |f| allowed.include?([f.kind, f.subject]) }
  matched.each { |f| puts "   ALLOWLISTED  #{f}" }

  stale = allowed - matched.map { |f| [f.kind, f.subject] }
  unless stale.empty?
    puts "   STALE ALLOWLIST ENTRIES (no longer found — remove them): #{stale.inspect}"
    return false
  end

  if findings.empty?
    puts "   clean — #{chapters.size} chapter(s), no dead states, no unreachable protocol steps"
    return true
  end

  errors, warnings = findings.partition { |f| f.severity == :error }
  puts "   #{errors.size} error(s), #{warnings.size} warning(s)"
  findings.each { |f| puts "     #{f}" }
  errors.empty?
end

# The language, examined through the same door its own conformance specs
# use — not a standalone Kernel.load of one grammar file. The nine
# GRAMMAR_FILES only assemble into one real "Bluebook" chapter together
# (they all open `Hecks.bluebook "Bluebook" do`), and grammar_registry is
# the judged, fixpointed graph — booting any one of them alone would
# check a ninth of the language and call it clean.
def examine_language
  ok = true
  %w[Bluebook World].each do |name|
    chapter = Hecks::Bluebook::MetaValidator.grammar_registry.bluebook(name)
    next unless chapter

    puts "── #{name} (the language itself)"
    findings = Hecks::Bluebook::ModelCheck.call(chapter, strict: STRICT)
    if findings.empty?
      puts "   clean — no dead states, no unreachable protocol steps"
    else
      errors, warnings = findings.partition { |f| f.severity == :error }
      puts "   #{errors.size} error(s), #{warnings.size} warning(s)"
      findings.each { |f| puts "     #{f}" }
      ok &&= errors.empty?
    end
  end
  ok
end

require "hecks/fuzzing/target_capabilities"

# `--strict` — a `rust_reserved_name` finding is an error for every target,
# not only for those with a Rust (Cargo feature) target.
STRICT = !ARGV.delete("--strict").nil?
domain_arg = ARGV.shift

if domain_arg
  registry = boot(Hecks::Corpus.bluebook_dir(domain_arg.chomp("/")) || domain_arg)
  ok = examine(File.basename(domain_arg.chomp("/")), registry)
else
  # **Every corpus kind** — examples, grammar chapters, framework members, the
  # QA ledger, stress domains and fixtures — read from the one table
  # spec/model_check_spec.rb reads too. Globbed separately, the two once
  # disagreed in both directions. A fixture a Corpus route sends elsewhere
  # (the broken-on-purpose model_check fixtures, the conflicting era
  # versions) is checked there, by its own destination, not here.
  targets = Hecks::Corpus.model_check_members
                         .map { |member| [member.stem, Hecks::Corpus.source_of(member)] }

  # Two passes over the same boots, not two boots — pass 1 boots every
  # target once (booting is the expensive part) and accumulates every
  # bluebook/hecksagon name any of them declares into one corpus-wide
  # set; pass 2 re-examines each already-booted registry against that
  # now-complete set, so a cross-domain check on the first target
  # examined still sees the last target's own domain names too — the
  # exact reason a single boot's own registry (Compliance never loaded
  # in the same registry as Banking, by design) cannot answer "does
  # this target domain exist anywhere in the corpus" on its own.
  booted = targets.map { |name, source| [name, boot(source)] }
  known_domains = booted.flat_map { |_, registry| registry.bluebooks.keys + registry.hecksagons.keys }.to_set

  ok = booted.reduce(true) { |all_ok, (name, registry)| examine(name, registry, known_domains: known_domains) && all_ok }
  ok = examine_language && ok
end

puts
puts ok ? "No dead states, no unreachable protocol steps." : "THE MODEL HAS FINDINGS."
exit(ok ? 0 : 1)
