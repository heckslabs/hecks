#!/usr/bin/env ruby

# Boots a domain (pizzas by default) and drops into IRB with its door
# installed — the fastest way to dispatch a real command by hand.
#
#   bin/console [domain]

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "irb"

# ADR 0033 — the era/lineage subsystem (including `PostgresEra`) moved
# behind a loadable persistence plugin core no longer requires by
# default. The pizzas example this script boots by default wires
# `PostgresEra`, so this console needs the plugin explicitly, same as
# bin/project_rust and every other consumer that boots a real domain.
require "hecks/ports/persistence/plugins/era"

DOMAIN  = ARGV.shift || File.expand_path("../examples/pizzas", __dir__)
RUNTIME = Hecks.boot(DOMAIN)

RUNTIME.registry.bluebooks.each_value do |bluebook|
  aggregates = bluebook.aggregates.map do |aggregate|
    "    #{aggregate.name}: #{aggregate.commands.map { |c| Hecks::Naming.snake(c.hecks_name) }.sort.join(', ')}"
  end

  puts <<~DOMAIN

        #{bluebook.name} — #{bluebook.vision}
    #{aggregates.join("\n")}
  DOMAIN
end

puts <<~BANNER

  hecks #{Hecks::VERSION}

  try:
    order = Order.create_pizza(name: { value: "Margherita" }, pizza: { price_cents: { cents: 1200 }, size: { value: "large" } })
    order.add_topping(topping: { value: "Basil" }, amount: { value: 3 })
    order.purchase(customer_name: { value: "Chris" }, amount: { cents: 1200 })
    order.status
    order.events.last

BANNER

IRB.start(__FILE__)
