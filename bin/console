#!/usr/bin/env ruby

# Boots a domain (pizzas on the in-memory adapter by default) and drops into
# IRB with its door installed, the fastest way to dispatch a real command by
# hand.
#
#   bin/console [domain]
#
# With no argument it boots `examples/pizzas/bluebook/pizzas.bluebook` against
# the Memory-bound `examples/pizzas/pizzas_behaviors.hecksagon`, so a bare
# console needs no database server (ADR 0073). Given a domain directory it
# boots that directory as it is wired, `examples/pizzas` included, which binds
# `PostgresEra` and so needs Postgres.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "irb"

# The era/lineage subsystem, `PostgresEra` included, is a persistence plugin
# core does not require by default (ADR 0033). A domain passed on the command
# line may bind it, so the console loads it; the Memory default boots with it
# loaded and never opens a connection.
require "hecks/ports/persistence/plugins/era"

PIZZAS = File.expand_path("../examples/pizzas", __dir__)

DEFAULT_FILES = [
  File.join(PIZZAS, "bluebook/pizzas.bluebook"),
  File.join(PIZZAS, "pizzas_behaviors.hecksagon")
].freeze

DOMAIN  = ARGV.shift
RUNTIME = DOMAIN ? Hecks.boot(DOMAIN) : Hecks.boot_files(DEFAULT_FILES)

RUNTIME.registry.bluebooks.each_value do |bluebook|
  aggregates = bluebook.aggregates.map do |aggregate|
    "    #{aggregate.name}: #{aggregate.commands.map { |c| "#{Hecks::Naming.snake(c.hecks_name)}!" }.sort.join(', ')}"
  end

  puts <<~DOMAIN

        #{bluebook.name} — #{bluebook.vision}
    #{aggregates.join("\n")}
  DOMAIN
end

puts <<~BANNER

  hecks #{Hecks::VERSION}

  try:
    order = Order.create_pizza!(name: { value: "Margherita" }, pizza: { price_cents: { cents: 1200 }, size: { value: "large" } })
    order.add_topping!(topping: { value: "Basil" }, amount: { value: 3 })
    order.purchase!(customer_name: { value: "Chris" }, amount: { cents: 1200 })
    order.status
    order.events.last

BANNER

IRB.start(__FILE__)
