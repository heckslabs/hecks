#!/usr/bin/env ruby

# Boots a domain (pizzas on Memory by default) and drops into IRB with its
# door installed, for dispatching a real command by hand.
#
#   bin/console [domain]
#
# No argument needs no database (ADR 0073); a domain directory boots as it is
# wired, which may bind PostgresEra.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("console")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "irb"

# The era/lineage subsystem is a persistence plugin core doesn't require by
# default (ADR 0033); a domain passed here may bind it.
require "hecks/ports/persistence/plugins/era"

PIZZAS = File.expand_path("../examples/pizzas", __dir__)

DEFAULT_FILES = [
  File.join(PIZZAS, "bluebook/pizzas.bluebook"),
  File.join(PIZZAS, "pizzas_behaviors.hecksagon")
].freeze

DOMAIN  = ARGV.shift
RUNTIME = DOMAIN ? Hecks.boot(DOMAIN) : Hecks.boot_files(DEFAULT_FILES)

RUNTIME.registry.bluebooks.each_value do |bluebook|
  aggregates = bluebook.aggregates.map do |aggregate|
    "    #{aggregate.name}: #{aggregate.commands.map { |c| "#{Hecks::Naming.snake(c.hecks_name)}!" }.sort.join(', ')}"
  end

  puts <<~DOMAIN

        #{bluebook.name} — #{bluebook.vision}
    #{aggregates.join("\n")}
  DOMAIN
end

puts <<~BANNER

  hecks #{Hecks::VERSION}

  try:
    order = Order.create_pizza!(name: { value: "Margherita" }, pizza: { price_cents: { cents: 1200 }, size: { value: "large" } })
    order.add_topping!(topping: { value: "Basil" }, amount: { value: 3 })
    order.purchase!(customer_name: { value: "Chris" }, amount: { cents: 1200 })
    order.status
    order.events.last

BANNER

IRB.start(__FILE__)
