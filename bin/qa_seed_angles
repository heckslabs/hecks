#!/usr/bin/env ruby

# Seeds the QualityControl ledger's Angle backlog.
# The body lives in lib/hecks/quality_control/cli/qa_seed_angles.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_seed_angles")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/quality_control/cli/qa_seed_angles"

exit(Hecks::QualityControlCli::QaSeedAngles.call(root: File.expand_path("..", __dir__)))
