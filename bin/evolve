#!/usr/bin/env ruby

# Walks a bluebook language change (syntax row, builder, golden) through its lifecycle.
#
#   bin/evolve status                             where every word stands
#   bin/evolve propose <word> --context Aggregate  a row enters, proposed
#   bin/evolve admit   <word> --context Aggregate  proposed -> admitted
#   bin/evolve deprecate <word> --context X        admitted -> deprecated
#   bin/evolve retire  <word> --context X          deprecated/admitted -> retired
#   bin/evolve rename  <word> --context X --to new
#
# Arguments follow the same lifecycle, addressed by --at or --named:

#   bin/evolve argument-propose <keyword> --context X --kind K [--at N] [--named name]
#     [--required true|false] [--fills F] [--pairs-shape verbatim]
#   bin/evolve argument-admit|argument-deprecate|argument-retire <keyword> --context X
#     [--at N] [--named name]

# Mutating commands regenerate the golden and run the gates; a failing gate restores every file.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("evolve")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/grammar/evolve"

ROOT = File.expand_path("..", __dir__)
Evolve = Hecks::Grammar::Evolve

SNAPSHOT_PATHS = (Evolve.syntax_paths + [File.join(ROOT, "spec/golden/ir/Bluebook.json")]).freeze

GATES = %w[
  spec/syntax_conformance_spec.rb
  spec/syntax_lifecycle_spec.rb
  spec/ir_golden_spec.rb
].freeze

# Reads a `--name value` flag off `ARGV`; `default` when absent or followed by another flag.
def option(name, default = nil) = Evolve.option(ARGV, name, default)

# Rewrites spec/golden/ir/Bluebook.json by running its spec with `GOLDEN=rewrite`.
def regenerate!
  system({ "GOLDEN" => "rewrite" },
         "bundle", "exec", "rspec", "spec/ir_golden_spec.rb",
         chdir: ROOT, out: File::NULL, err: File::NULL)
end

# Runs the syntax conformance, syntax lifecycle and golden IR specs.
def gates_pass?
  system("bundle", "exec", "rspec", *GATES, chdir: ROOT)
end

# Runs one grammar edit inside the snapshot/regenerate/gate sequence, restoring every snapshot
# if the block raises or a gate fails.
#
# @return [Boolean] true if the block ran and the gates held
def guarded(word, context, &)
  snapshots = SNAPSHOT_PATHS.to_h { |path| [path, File.read(path)] }
  Evolve.restore_on_raise(SNAPSHOT_PATHS, &)
  regenerate!
  if gates_pass?
    puts "\n#{context}.#{word} — the gates hold. Regenerated projections and the golden are in the tree."
    true
  else
    snapshots.each { |path, content| File.write(path, content) }
    puts "\nRESTORED — the gates refused, and the failures above are the checklist. " \
         "Nothing was changed."
    false
  end
rescue StandardError => e
  # `restore_on_raise` has already restored the files; this only reports.
  puts "\nRESTORED — #{e.message} Nothing was changed."
  false
end

command = ARGV.shift

case command
when "status"
  rows = Evolve.keyword_rows
  moving = rows.reject { |row| row[:status] == "admitted" }
  renamed = rows.reject { |row| row[:was].to_s.empty? }
  puts "#{rows.size} keyword rows; #{moving.size} not simply admitted; #{renamed.size} renamed"
  moving.each { |row| puts "  #{row[:status].ljust(10)} #{row[:context]}.#{row[:word]}" }
  renamed.each { |row| puts "  renamed    #{row[:context]}.#{row[:word]} (was #{row[:was]})" }
when "propose"
  word = ARGV.shift or abort "propose what word?"
  context = option("context") or abort "--context is required — a word is a word somewhere"
  ok = guarded(word, context) do
    Evolve.propose(word: word, context: context,
                   body: option("body", "none"), inner: option("inner", ""),
                   opens: option("opens", ""), fills: option("fills", ""))
  end
  if ok
    puts "Proposed. It reaches no projection until admitted. Before `bin/evolve admit`:"
    puts "  1. teach the #{context} builder the word (and its spec/dsl_spec example)"
  end
when "admit", "deprecate", "retire"
  to = { "admit" => "admitted", "deprecate" => "deprecated", "retire" => "retired" }.fetch(command)
  word = ARGV.shift or abort "#{command} what word?"
  context = option("context") or abort "--context is required"
  guarded(word, context) { Evolve.set_status(word: word, context: context, to: to) }
when "rename"
  word = ARGV.shift or abort "rename what word?"
  context = option("context") or abort "--context is required"
  to = option("to") or abort "--to is required — a rename goes somewhere"
  ok = guarded(word, context) { Evolve.rename(word: word, context: context, to: to) }
  if ok
    puts "Renamed. The old spelling keeps parsing — that is the point. Before this holds:"
    puts "  1. alias the new word to the old in the #{context} builder (alias_method :#{to}, :#{word})"
    puts "  2. add the identical-IR example to spec/dsl_spec.rb"
  end
when "argument-propose"
  keyword = ARGV.shift or abort "argument-propose which keyword's argument?"
  context = option("context") or abort "--context is required"
  kind = option("kind") or abort "--kind is required — text|symbol|number|flag|literal|constant|pairs|list"
  ok = guarded("#{keyword} argument", context) do
    Evolve.propose_argument(keyword: keyword, context: context, kind: kind,
                            required: option("required", "false"),
                            at: option("at", ""), named: option("named", ""),
                            fills: option("fills", ""), pairs_shape: option("pairs-shape"))
  end
  if ok
    puts "Proposed. It reaches no projection until admitted. Before `bin/evolve argument-admit`:"
    puts "  1. teach the #{context} builder's #{keyword} method the argument"
  end
when "argument-admit", "argument-deprecate", "argument-retire"
  to = { "argument-admit" => "admitted", "argument-deprecate" => "deprecated",
         "argument-retire" => "retired" }.fetch(command)
  keyword = ARGV.shift or abort "#{command} which keyword's argument?"
  context = option("context") or abort "--context is required"
  guarded("#{keyword} argument", context) do
    Evolve.set_argument_status(keyword: keyword, context: context, to: to,
                               at: option("at", ""), named: option("named", ""))
  end
else
  abort "usage: bin/evolve status|propose|admit|deprecate|retire <word> --context <Context> " \
        "[--body none|keywords|source|rows] [--inner X] [--opens X] [--fills x]\n   " \
        "or: bin/evolve argument-propose|argument-admit|argument-deprecate|argument-retire " \
        "<keyword> --context <Context> [--kind K] [--at N] [--named NAME] [--required true|false] " \
        "[--fills F]"
end
