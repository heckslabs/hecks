#!/usr/bin/env ruby

# Projects a booted domain into Mermaid diagrams: one stateDiagram-v2 per
# lifecycle aggregate, one erDiagram, and one flowchart of command/event/policy chains.
# spec/diagrams_spec.rb re-projects and diffs, so regenerate after any change here.
#
#   bin/project_diagrams <domain-path> <ChapterName>
#   bin/project_diagrams examples/pizzas Pizzas

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/project_diagrams"

Hecks::CLI::ProjectDiagrams.call(ARGV, program: "bin/project_diagrams", root: File.expand_path("..", __dir__))
