#!/usr/bin/env ruby

# Projects a booted domain's own shape into Mermaid diagrams — one
# stateDiagram-v2 per lifecycle-bearing aggregate/entity, one
# erDiagram for the whole domain's has_many/has_one/belongs_to/
# reference_to relationships, one flowchart for the whole domain's
# command-emits-event-triggers-policy dispatch chains. The projection
# itself is Projections::Diagrams (see its own header for why
# Mermaid); this boots the given domain, finds its one real chapter,
# and asks the registry for it. spec/diagrams_spec.rb re-projects
# through the same call and refuses a diff, so any of these changing
# without regenerating fails the ordinary suite, the same way
# rust/parser/src/keywords.rs already does for the grammar.
#
#   bin/project_diagrams <domain-path> <ChapterName>
#   bin/project_diagrams examples/pizzas Pizzas

# The logic is `Hecks::CLI::ProjectDiagrams` (lib/hecks/cli/project_diagrams.rb), which
# `hecks project_diagrams` also runs.

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/project_diagrams"

Hecks::CLI::ProjectDiagrams.call(ARGV, program: "bin/project_diagrams", root: File.expand_path("..", __dir__))
