#!/usr/bin/env ruby

# Identifies every corpus domain as a rotation Target.
# The body lives in lib/hecks/quality_control/cli/qa_seed_targets.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_seed_targets")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/quality_control/cli/qa_seed_targets"

exit(Hecks::QualityControlCli::QaSeedTargets.call(root: File.expand_path("..", __dir__)))
