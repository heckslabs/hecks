#!/usr/bin/env ruby

# Regenerates every corpus domain's committed Rust output with bin/project_rust.
# The domain list comes from Hecks::Corpus.rust_regen_order, never a hand-kept list.
#
# Order is fixed (sorted by relative path): domains that share governance/, identity/,
# Cargo.toml and generated/mod.rs stamp them with whichever ran last, so it must not flap.
# If the domain set or sort rule changes, re-run and commit the output; never hand-edit stamps.
#
#   bin/regen_codegen_domains         # discover, regenerate, print the plan
#   bin/regen_codegen_domains --check # regenerate into a scratch crate; fail on any difference
#
# --check never writes the working tree: it runs beside the parallel suite, which reads Cargo.toml.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("regen_codegen_domains")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/tools"

Hecks::Tools.script("regen_codegen_domains", ARGV)
