#!/usr/bin/env ruby

# The mechanical fix for a false-positive class that recurred at least
# eight times: a hand-maintained list of `bin/project_rust <domain>` lines in
# `.github/workflows/ci-checks.yml`'s `checks_codegen_drift` step regenerates
# only the domains named in it. Any domain added to `examples/`,
# `qa/stress_domains/`, or `spec/fixtures/rust_project/` with real, committed
# `rust/src/generated/<name>/` output — but never manually added to that
# list — silently stops being regenerated at all. Its committed Rust output
# can then drift arbitrarily far behind its own Bluebook source with nothing
# catching it, until a later, unrelated differential fuzz sweep trips over
# the staleness and reports what looks like a fresh Ruby/Rust divergence —
# but is actually the same already-fixed bug, just never regenerated into
# the artifact being fuzzed. This script replaces that hand-maintained list
# with a discovered one, so the gap cannot recur.
#
# Confirmed recurrences of exactly this class, by name, on the old
# hand-maintained list: `nested_pieces` (BUG#23), `referral_chain`,
# `has_many_fixture` (BUG#25), `lease_clock`, `corrections` (BUG#126),
# `chess` (BUG#138), and `generated_entity_no_identity` (BUG#122) — the last
# of which had two attempted fixes to the old list, neither of which
# actually landed (confirmed via `git show 63102c4d --
# .github/workflows/ci-checks.yml` being empty), before this script replaced
# the whole mechanism. `tenant_ledger` was a known, acknowledged instance of
# the same gap — flagged by name in the old list's own comment, deliberately
# left unfixed pending a real structural fix rather than patched as a
# drive-by in an unrelated change. Auditing the repo directly while building
# this script found the gap was even wider than any filed Bug had caught:
# `generated_reaction_wording`, `generated_revalued_shape`,
# `generated_route_append`, and `bug28_existence_fixture` all had real,
# committed `rust/src/generated/` output and were not in the old list
# either — nobody had filed a Bug for any of the four yet, but they were the
# exact same silent gap, just not yet tripped over by a fuzz sweep.
#
# The mechanism, replacing the maintained list entirely: `Hecks::Corpus.
# rust_regen_order` (lib/hecks/corpus.rb, also printed by `bin/corpus
# --rust-regen-order`) — every corpus domain directory whose name is a
# Cargo feature and whose `rust/src/generated/<name>/` module already
# exists, with that module's own metadata.rs stamp confirming it came from
# this directory (so a vendored copy of a domain never regenerates over
# the real one). This script, the fuzz bridge, and codegen parity all read
# that one list, rather than each hand-naming its own roots. That's the same
# rule the old hand-maintained list already followed by convention (every
# domain in it was added only after a human ran `bin/project_rust` once by
# hand and committed the result) — this script just makes the rule self-
# enforcing instead of relying on someone remembering to also edit this
# file. A brand-new domain added the normal way — write its Bluebook,
# `bundle exec bin/project_rust path/to/it` once by hand, commit the
# output — is auto-discovered on the next run, with zero edits to
# ci-checks.yml or this script itself.
#
# `embryonaut` never appears as a candidate in the first place: its Bluebook source lives
# in a separate client repo, not in this checkout, so there is no `examples/embryonaut`,
# `qa/stress_domains/embryonaut`, or `spec/fixtures/rust_project/embryonaut` directory here
# for the walk to ever find, even though `rust/src/generated/embryonaut/` is committed.
# `Hecks::Corpus::RUST_ELSEWHERE` names it explicitly instead (see this file's own comment
# on that constant, just above the domain walk below), routing it to the check that owns
# it — ADR 0057 records an earlier, defensive `EXCLUDED_DOMAINS` design for this same
# exclusion; the shipped mechanism reads `RUST_ELSEWHERE` instead, since `bin/corpus` and
# the fuzz bridge need the same list. It stays coverage-checked against its own committed
# snapshot only, same as `bin/rust_coverage embryonaut` (ci-checks.yml's "rust coverage:
# embryonaut" step) already treats it — see that tool's own "Fallback mode" header for
# exactly what that can and can't prove.
#
# Order is not arbitrary, and this script does not get to pick a
# convenient one — every domain below that declares `uses_framework
# "Governance"` (today: banking, compliance, pizzas, nested_pieces, and
# tenant_ledger, once swept in) regenerates `rust/src/generated/
# governance/*.rs` as a side effect, and each pass stamps that shared
# output's own "GENERATED by ... examples/<domain>" attribution comment
# with whichever domain ran last — content aside, that comment is real,
# load-bearing text a diff check would otherwise flag on every run
# regardless of whether anything actually drifted. The same is true of
# `uses_framework "Identity"` (today: only banking) for `rust/src/
# generated/identity/`, and of `rust/Cargo.toml`'s `default` feature and
# `rust/src/generated/mod.rs`'s domain-exclusivity `cfg`s, which track
# whichever domain ran last, period, Governance/Identity or not.
#
# So: domains are regenerated in a fixed, deterministic order — sorted by
# full relative path (`examples/...` before `qa/stress_domains/...` before
# `spec/fixtures/rust_project/...`, alphabetical within each) — so this
# can never flap between CI runs, and so which domain "wins" each shared
# module's stamp is a simple, checkable fact about the sorted list rather
# than a hand-maintained ordering someone has to keep re-verifying by
# running every line locally. Under this rule, `tenant_ledger` is the
# alphabetically-last `uses_framework "Governance"` domain (`qa/
# stress_domains/nested_pieces` < `qa/stress_domains/tenant_ledger`), so
# it wins `governance/`'s attribution stamp; the old hand-maintained list
# never included `tenant_ledger` at all, so `nested_pieces` won there
# instead. `banking` remains the sole `uses_framework "Identity"` domain, so
# it keeps winning `identity/`'s stamp regardless of sort order. The
# alphabetically-last domain overall — `spec/fixtures/rust_project/
# has_many_fixture` — wins `rust/Cargo.toml`'s `default` feature and
# `rust/src/generated/mod.rs`'s cfg comments; the old hand-maintained list
# instead placed `qa/stress_domains/waybill` last, so it won both there.
# Both are real, intentional changes this script's own
# first commit regenerates for real, not bugs — if the discovered domain
# set or the sort rule ever changes, re-run this script and commit
# whatever it produces; never hand-edit the "winning" stamps to fake a
# particular order.
#
#   bin/regen_codegen_domains         # discover, regenerate, print the plan
#   bin/regen_codegen_domains --check # same, then fail on any resulting
#                                      # diff under rust/src/generated/ or
#                                      # rust/Cargo.toml (what CI runs)

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/corpus"

# Runs `bin/project_rust domain` in a forked child, so the parent's already-built
# `MetaValidator.grammar_registry` is inherited instead of rebuilt per domain.
#
# @param project_rust [String] absolute path to `bin/project_rust`
# @param domain [String] the domain directory to regenerate, relative to the repo root
# @return [void]
def project_rust_in_fork(project_rust, domain)
  puts "== bin/project_rust #{domain} =="
  $stdout.flush
  pid = fork do
    ARGV.replace([domain])
    $PROGRAM_NAME = project_rust
    load project_rust
  end
  _, status = Process.wait2(pid)
  abort "bin/regen_codegen_domains: bin/project_rust #{domain} failed (#{status.inspect})" unless status.success?
  puts
end

# embryonaut is never in the list: Hecks::Corpus::RUST_ELSEWHERE routes
# it (and `meta`) to the check that owns it instead, and
# spec/corpus_rust_spec.rb proves no in-repo directory carries its name.
repo_root = File.expand_path("..", __dir__)
Dir.chdir(repo_root) do
  domains = Hecks::Corpus.rust_regen_order.map { |domain| domain.dir.delete_prefix("#{repo_root}/") }

  if domains.empty?
    abort "bin/regen_codegen_domains: discovered ZERO domains with committed rust/src/generated/ output in " \
          "Hecks::Corpus — that almost certainly means this script is running from the wrong " \
          "directory, or something upstream deleted rust/src/generated/ entirely. Refusing to silently treat " \
          "that as \"nothing to regenerate.\""
  end

  puts "bin/regen_codegen_domains: regenerating #{domains.size} domain(s), in this fixed order:"
  domains.each { |d| puts "  #{d}" }
  puts

  # **One boot, not one per domain**. Every `bin/project_rust` run builds
  # `MetaValidator.grammar_registry` — the same value every time, and most
  # of a small domain's whole run. Build it here once and fork: each child
  # inherits the memoized registry and then runs bin/project_rust exactly
  # as a fresh process would. Still one domain at a time, in the fixed
  # order above — the shared outputs depend on which domain ran last.
  require "hecks"
  require "hecks/bluebook/meta_validator"
  Hecks::Bluebook::MetaValidator.grammar_registry
  domains.each { |domain| project_rust_in_fork(File.join(repo_root, "bin/project_rust"), domain) }

  next unless ARGV.include?("--check")

  # **The existing gate, unchanged** — same two paths the old inline step
  # always diffed: `rust/src/generated/` (every domain's own generated
  # source, including the shared `governance`/`identity`/`meta` modules
  # any Governance/Identity-using domain above touches as a side effect)
  # and `rust/Cargo.toml` (the `default` feature `bin/project_rust`
  # rewrites on every run, per its own header).
  system("git", "diff", "--exit-code", "--", "rust/src/generated/", "rust/Cargo.toml", exception: true)
end
