#!/usr/bin/env ruby

# Projects the Bluebook chapter's Syntax aggregate into the Rust parser's keyword table.
#
#   bin/project_parser_table

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_parser_table")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/projection_files"

begin
  puts Hecks::ProjectionFiles.write(:parser_table)
rescue Hecks::ProjectionFiles::Refused => e
  abort e.message
end
