#!/usr/bin/env ruby

# Projects the chapter's own Syntax aggregate into the Rust parser's
# keyword table — the parser's grammar knowledge derived from
# hecks's self-description rather than hand-typed a second time.
#
# The projection itself is Projections::ParserTable; this asks the
# registry for it. spec/parser_table_spec.rb re-projects through the same
# call and refuses a diff, so grammar drift fails the ordinary suite.
#
#   bin/project_parser_table

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
require "fileutils"

chapter = Hecks::Bluebook::MetaValidator.grammar_registry.bluebook("Bluebook")
out     = File.expand_path("../rust/parser/src/keywords.rs", __dir__)
FileUtils.mkdir_p(File.dirname(out))

puts "wrote #{Hecks::Projector.write(
  Hecks::Projector.call(:parser_table, bluebook: chapter), out
)}"
