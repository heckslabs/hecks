#!/usr/bin/env ruby

# Generates reserved_names.rs from the RustReservedWord and CargoReservedName vocabularies.
# Written into rust/codegen and rust/build, which share no library dependency.
#
# Run bin/project_vocabulary first if vocabulary.bluebook changed.
#
#   bin/project_reserved_names

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_reserved_names")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/vocabulary"
require "fileutils"
require "tempfile"

ROOT = File.expand_path("..", __dir__)
TARGETS = [
  File.join(ROOT, "rust/codegen/src/reserved_names.rs"),
  File.join(ROOT, "rust/build/src/reserved_names.rs")
].freeze

TABLES = {
  "RUST_KEYWORDS"               => "RustReservedWord",
  "CARGO_RESERVED_DOMAIN_NAMES" => "CargoReservedName"
}.freeze

# Writes `content` to `target` through a temp file and atomic rename, so a
# reader never sees a partial file.
def write_atomically(target, content)
  FileUtils.mkdir_p(File.dirname(target))
  Tempfile.create(File.basename(target), File.dirname(target)) do |tmp|
    tmp.write(content)
    tmp.flush
    File.rename(tmp.path, target)
  end
  puts "wrote #{target}"
end

# A Rust string literal; every reserved word is a plain ASCII token.
def rust_lit(text) = text.inspect

consts = TABLES.map do |const, vocabulary|
  words = Hecks::Vocabulary.fetch(vocabulary)
  raise "vocabulary #{vocabulary} declares no members" if words.empty?

  lines = words.map { |word| "    #{rust_lit(word)}," }.join("\n")
  "/// The `#{vocabulary}` vocabulary, #{words.size} entries.\n" \
    "pub const #{const}: &[&str] = &[\n#{lines}\n];"
end

content = <<~RUST
  // GENERATED by bin/project_reserved_names from the RustReservedWord and
  // CargoReservedName vocabularies (lib/hecks/language/bluebook/
  // vocabulary.bluebook). Do not hand-edit — re-run bin/project_reserved_names.

  #{consts.join("\n\n")}
RUST

TARGETS.each { |target| write_atomically(target, content) }
