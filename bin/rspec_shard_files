#!/usr/bin/env ruby

# Prints the spec files assigned to one group of a runtime-balanced N-way split.
# The body lives in lib/hecks/cli/rspec_shard_files.rb; this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("rspec_shard_files")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/rspec_shard_files"

exit(Hecks::CLI::RspecShardFiles.call(ARGV))
