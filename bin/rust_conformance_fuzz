#!/usr/bin/env ruby

# Runs generated fuzz sequences through rust_conformance against a native or .wasm artifact.
#
#   bin/rust_conformance_fuzz <domain> <native|path/to/module.wasm> [seeds] [steps]
#
# A shim: the work is Hecks::RustBuild (lib/hecks/rust_build/).

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("rust_conformance_fuzz")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/rust_build"

exit Hecks::RustBuild.run("rust_conformance_fuzz", ARGV)
