#!/usr/bin/env ruby

# Projects the language's closed sets into lib/hecks/vocabulary.rb via the projector registry.
#
#   bin/project_vocabulary

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("project_vocabulary")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks/projection_files"

begin
  puts Hecks::ProjectionFiles.write(:vocabulary)
rescue Hecks::ProjectionFiles::Refused => e
  abort e.message
end
