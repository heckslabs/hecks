#!/usr/bin/env ruby

# Builds the hecks gem and pushes it to rubygems.org with a 1Password push key.
# The body lives in lib/hecks/cli/release_gem.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("release_gem")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/cli/release_gem"

exit(Hecks::CLI::ReleaseGem.call(root: File.expand_path("..", __dir__)))
