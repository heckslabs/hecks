#!/usr/bin/env ruby

# Opens a PR and records it in the QualityControl ledger in one step.
# The body lives in lib/hecks/quality_control/cli/qa_open_pr.rb;
# this file only starts it.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_open_pr")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/quality_control/cli/qa_open_pr"

exit(Hecks::QualityControlCli::QaOpenPr.call(ARGV, root: File.expand_path("..", __dir__)))
