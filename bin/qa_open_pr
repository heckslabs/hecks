#!/usr/bin/env ruby

# Opens a PR and records it in the QualityControl ledger in one step.
# The only door into `QualityControl::Patch.Open` / `Improvement.Open`.

#   bin/qa_open_pr --bug bug#n --title "…" [--body "…"]
#   bin/qa_open_pr --improvement [--angle angle-n] --title "…" [--body "…"]

# Refuses (exit 1, nothing opened or recorded) unless the ledger's own `Open` command would take
# the record and the `GitPr` adapter agrees. The command's `given`s are the rules, asked as a dry
# run before anything is opened: the branch starts with the practice's prefix; with `--bug`, the
# bug is `fixed`; with `--angle`, it is `investigating`. The adapter answers the rest: the tree
# is clean, `PR_CAP_PER_DAY` (0 = uncapped) is unmet since local midnight, and with `--bug`, the
# bug's commit is an ancestor of `HEAD`.
# Idempotent: an open PR is not re-created and a recorded number is not re-recorded.
# `QA_REPO_DIR` picks the checkout `git` runs in, so a spec can use a throwaway repo and fake `gh`.

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("qa_open_pr")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "hecks"
# The era subsystem does not load with core (ADR 0033); see bin/run.
require "hecks/ports/persistence/plugins/era"
require "hecks/quality_control/adapters/git_pr"

ROOT       = File.expand_path("..", __dir__)
DOMAIN_DIR = ENV.fetch("QA_SWEEP_DOMAIN_DIR", File.join(ROOT, "qa/bluebook"))
REPO_DIR   = ENV.fetch("QA_REPO_DIR", ROOT)

EXIT_OK      = 0
EXIT_REFUSED = 1

USAGE = "usage: bin/qa_open_pr --bug BUG#n --title \"…\" [--body \"…\"]\n       " \
        "bin/qa_open_pr --improvement [--angle ANGLE-n] --title \"…\" [--body \"…\"]".freeze

SHA_PATTERN = /\A[0-9a-fA-F]{7,40}\z/

# Stands in for the commit of a bug that is not fixed yet, so its dry run reaches the `given`.
PLACEHOLDER_COMMIT = "0000000".freeze

options = {}
until ARGV.empty?
  arg = ARGV.shift
  case arg
  when "-h", "--help"
    puts USAGE
    exit EXIT_OK
  when "--improvement"
    options[:improvement] = true
  when "--bug", "--angle", "--title", "--body"
    value = ARGV.shift
    abort "#{USAGE}\n#{arg} needs a value" if value.nil? || value.empty?
    options[arg.delete_prefix("--").to_sym] = value
  else
    abort "#{USAGE}\nunexpected argument: #{arg.inspect}"
  end
end

abort "#{USAGE}\n--title is required" unless options[:title]
abort "#{USAGE}\ngive --bug BUG#n OR --improvement, not both" if options[:bug] && options[:improvement]
abort "#{USAGE}\ngive --bug BUG#n or --improvement" unless options.key?(:bug) || options.key?(:improvement)
abort "#{USAGE}\n--angle only means something with --improvement" if options[:angle] && !options[:improvement]

git_pr = Hecks::Adapters::GitPr.new(repo_dir: REPO_DIR)

# Every rule the adapter enforces refuses the same way: exit 1, nothing opened or recorded.
def refusing
  yield
rescue Hecks::Adapters::GitPr::Refusal => e
  abort "refused: #{e.message}"
end

branch = refusing { git_pr.branch }
refusing { git_pr.assert_clean_tree! }

runtime = begin
  Hecks.boot(DOMAIN_DIR)
rescue StandardError => e
  abort "the QualityControl ledger did not boot — fix the ledger itself before opening a PR against it " \
        "(#{e.class}: #{e.message})"
end

def q(runtime, name, **args) = runtime.query("QualityControl::#{name}", **args)

# Falls back to a dial-less fixture ledger's values: uncapped, non-draft, no auto-merge.
def dial(name, fallback)
  return fallback unless defined?(QualityControlDials) && QualityControlDials.const_defined?(name)

  QualityControlDials.const_get(name)
end

PR_CAP_PER_DAY = dial(:PR_CAP_PER_DAY, 0)
DRAFT_ONLY     = dial(:DRAFT_ONLY, false)
AUTO_MERGE     = dial(:AUTO_MERGE, false)

bug = angle = nil

if options[:bug]
  bug = QualityControl::Bug.find(options[:bug])
  abort "refused: no such bug #{options[:bug].inspect}" unless bug
end

if options[:angle]
  angle = QualityControl::Angle.find(options[:angle])
  abort "refused: no such angle #{options[:angle].inspect}" unless angle
end

# What a refused `given` says to do next, by the rule's own wording; nothing for a rule it does
# not know.
def hint_for(rule, bug, angle, branch)
  case rule
  when "the bug is fixed"
    " (#{bug.id} is #{bug.status.inspect} — dispatch investigate and fix first " \
    "(bin/run qa/bluebook fix id=#{bug.id} reference.value=#{bug.id} commit.value=<sha>))"
  when "the angle is under investigation"
    " (#{angle.id} is #{angle.status.inspect} — dispatch angle.investigate first, so the lead " \
    "reads as picked up before something is built from it)"
  when "the branch is one this practice recognises as its own"
    " (the branch is #{branch.inspect}; a PR this practice opens is on a branch it can recognise " \
    "as its own, QualityControlDials::BRANCH_PREFIX)"
  else ""
  end
end

# Asks the ledger whether `verb` would take these facts, without recording anything. The number is
# one no record holds yet, so the dry run reaches the `given`s rather than `AlreadyExists`.
def refuse_unless_ledger_takes(runtime, verb, bug, angle, branch, **facts)
  runtime.dry_run?(verb, **facts)
rescue Hecks::Runtime::GivenNotMet => e
  hint = hint_for(e.message.split(" — ", 2).last, bug, angle, branch)
  abort "refused: #{e.message}#{hint} — a dry run of #{verb}, so nothing was opened or recorded"
end

def next_number(runtime, aggregate)
  q(runtime, "#{aggregate}.All").map { |row| row[:number][:value] }.max.to_i + 1
end

now = Time.now.to_i
recorded = { url: { value: "https://github.com/pull/0" }, title: { value: options[:title] },
             branch: { value: branch }, now: { value: now } }

if bug
  commit = bug.commit.to_h[:value].to_s
  refuse_unless_ledger_takes(runtime, "QualityControl::Patch.Open", bug, angle, branch,
                             bug: bug.id, number: { value: next_number(runtime, "Patch") },
                             commit: { value: commit.match?(SHA_PATTERN) ? commit : PLACEHOLDER_COMMIT },
                             **recorded)
else
  refuse_unless_ledger_takes(runtime, "QualityControl::Improvement.Open", bug, angle, branch,
                             **(angle ? { angle: angle.id } : {}),
                             number: { value: next_number(runtime, "Improvement") }, **recorded)
end

if PR_CAP_PER_DAY.positive?
  today = Time.now
  midnight = Time.new(today.year, today.month, today.day).to_i
  opened_today = q(runtime, "Patch.OpenedSince", since: { value: midnight }).size +
                 q(runtime, "Improvement.OpenedSince", since: { value: midnight }).size
  refusing { git_pr.assert_under_daily_cap!(opened_today: opened_today, cap: PR_CAP_PER_DAY) }
end

if bug
  commit = bug.commit.to_h[:value].to_s
  abort "refused: #{bug.id} carries no commit" unless commit.match?(SHA_PATTERN)

  refusing { git_pr.assert_ancestor!(commit: commit, owner: bug.id) }
end

view = git_pr.open_pull_request(branch)
if view
  puts "PR ##{view[:number]} already open for #{branch} — not re-creating"
else
  # The body names the ledger record so the PR and the ledger point at each other.
  cited = if bug then "Fixes #{bug.id}."
          elsif angle then "Builds #{angle.id}."
          else "Deliberate work, no Bug or Angle behind it."
          end
  body = options[:body] || "#{cited}\n\nOpened by bin/qa_open_pr and recorded in the QualityControl ledger."
  begin
    git_pr.create_pull_request(branch: branch, title: options[:title], body: body, draft: DRAFT_ONLY)
  rescue Hecks::Adapters::GitPr::CommandFailed => e
    abort e.message
  end

  view = git_pr.open_pull_request(branch)
  abort "gh pr create returned, but gh pr view #{branch} shows no open PR — record nothing" unless view
end

number = view[:number]
sha    = view[:headRefOid].to_s
abort "refused: gh reports head #{sha.inspect} for ##{number}, which does not look like a sha" unless sha.match?(SHA_PATTERN)

now = Time.now.to_i

if bug
  known = q(runtime, "Patch.All").map { |row| row[:number][:value] }
  if known.include?(number)
    puts "Patch ##{number} already recorded — not re-recording"
  else
    QualityControl::Patch.open!(
      bug: bug.id, number: { value: number }, url: { value: view[:url] },
      branch: { value: view[:headRefName] }, commit: { value: sha }, title: { value: view[:title] },
      now: { value: now }
    )
    puts "recorded Patch ##{number} for #{bug.id} at #{sha[0, 7]}"
  end
else
  known = q(runtime, "Improvement.All").map { |row| row[:number][:value] }
  if known.include?(number)
    puts "Improvement ##{number} already recorded — not re-recording"
  else
    QualityControl::Improvement.open!(
      **(angle ? { angle: angle.id } : {}),
      number: { value: number }, url: { value: view[:url] },
      branch: { value: view[:headRefName] }, title: { value: view[:title] },
      now: { value: now }
    )
    QualityControl::Improvement.find(number).land!(number: { value: number }, commit: { value: sha })
    for_angle = angle ? " for #{angle.id}" : ""
    puts "recorded Improvement ##{number}#{for_angle}, landed at #{sha[0, 7]}"
  end
end

if AUTO_MERGE
  begin
    git_pr.merge_when_green(number)
  rescue Hecks::Adapters::GitPr::CommandFailed => e
    abort "recorded, but #{e.message}"
  end
  puts "auto-merge queued for ##{number} (QualityControlDials::AUTO_MERGE)"
end

puts "#{view[:url]} (#{view[:headRefName]} @ #{sha[0, 7]}) — #{view[:title]}"
exit EXIT_OK
