#!/usr/bin/env ruby

# Removes a command's `attribute :field, Type` line when it only repeats what an `append:`
# target element already declares (see CommandBuilder#resolve_append_fields!).
# The edit/reboot/diff-or-revert machinery lives in Hecks::Codemod.
#
# Usage: bin/codemod_implicit_append_fields [--dry-run]

require_relative "../lib/hecks/three_zero"
Hecks::ThreeZero.notice("codemod_implicit_append_fields")

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "hecks/tools"

Hecks::Tools.script("codemod_implicit_append_fields", ARGV)
