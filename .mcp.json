{
  "mcpServers": {
    "hecks-query-ir": {
      "command": "ruby",
      "args": ["-I", "lib", "-e", "require 'hecks/query_ir_mcp/stdio_entry'; Hecks::QueryIrMcp.serve_stdio(ARGV)", "--"]
    },
    "hecks-mcp": {
      "command": "ruby",
      "args": ["-I", "lib", "-e", "require 'hecks/adapters/driving/mcp/stdio_entry'; Hecks::Adapters::Driving::Mcp.serve_stdio(ARGV)", "--"]
    }
  }
}
