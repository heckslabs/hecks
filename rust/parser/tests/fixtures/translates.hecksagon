# `translates` builds the same Policy IR as a bluebook `policy` block, reusing its
# `on`/`trigger`/`with:` (parse::policy::parse_body). It lives here because which foreign
# event to conform to is a wiring decision, not a fact about this domain's model.
Hecks.hecksagon "FixtureTranslates" do
  translates "RegisterProvisionedTenant" do
    on Provisioning::TenantProvisioned
    trigger Tenant::Register, with: { slug: :slug, domain: :domain }
  end
end
