# Lifecycle fixture: a fold onto the enclosing Aggregate/Entity, not its own category.
# `transition` takes a hash-rocket pair plus `from:`, as in examples/pizzas.
Hecks.bluebook "FixtureLifecycle" do
  aggregate "Widget" do
    lifecycle :status, default: "available" do
      transition "Activate" => "active", from: "available"
    end
  end
end
