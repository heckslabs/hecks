# Local half of the `translates` fixture: an ordinary aggregate and command.
# translates.hecksagon holds the policy that triggers `Tenant::Register`.
Hecks.bluebook "FixtureTranslates" do
  aggregate "Tenant" do
    identified_by :slug
    attribute :slug,   String
    attribute :domain, String

    command "Register" do
      role "Deployment"
      goal "Register a tenant a foreign domain already provisioned"

      attribute :slug,   String
      attribute :domain, String

      sets :slug
      sets :domain

      emits "TenantRegistered"
    end
  end
end
