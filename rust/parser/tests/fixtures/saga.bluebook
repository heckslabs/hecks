# One hand-written case per grammar form — ProcessManager (and, sharing
# its own builder in Ruby, Handler — ProcessManagerBuilder::HandlerBuilder,
# a nested class rather than a standalone one).
Hecks.bluebook "FixtureProcessManager" do
  process_manager "WidgetSetup" do
    correlates_by :"widget.id"
    starts_on "Widget.Created"

    transition "Widget.Created" => "started", from: "start" do
      dispatch Widget::Notify
    end
  end
end
