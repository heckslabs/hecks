# One hand-written case per grammar form — Saga (and, sharing
# its own builder in Ruby, Handler — SagaBuilder::HandlerBuilder,
# a nested class rather than a standalone one).
Hecks.bluebook "FixtureSaga" do
  saga "WidgetSetup" do
    correlates_by :"widget.id"
    starts_on "Widget.Created"

    transition "Widget.Created" => "started", from: "start" do
      dispatch Widget::Notify
    end
  end
end
