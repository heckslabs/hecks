  "source_text": "# Smallest domain that reaches the `has_many` list-of-references path in the Rust projection:\n# `Circle.Admit` sets the whole `members` list from a `list_of(Handle)` argument.\n# Round-tripped by spec/rust_project/has_many_spec.rb.\nHecks.bluebook \"HasManyFixture\" do\n  vision \"The smallest domain that reaches has_many's own Rust codegen path: one aggregate holding a list of references to another, set wholesale by one command.\"\n\n  core\n\n  aggregate \"Member\" do\n    description \"One admitted member, addressed by their own handle.\"\n\n    identified_by :handle\n    attribute :handle, Handle\n\n    value_object \"Handle\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a handle is not blank\") { !value.to_s.empty? }\n    end\n\n    command \"Join\" do\n      role \"Person\"\n      goal \"Register as a member, by handle\"\n\n      attribute :handle, Handle\n      sets :handle\n\n      emits \"MemberJoined\"\n    end\n  end\n\n  aggregate \"Circle\" do\n    description \"A circle of admitted members, addressed by its own id — has_many Members is the whole point of this fixture.\"\n\n    identified_by :id\n    attribute :id, CircleId\n    has_many Members\n\n    value_object \"CircleId\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a circle is referenced\") { !value.to_s.empty? }\n    end\n\n    command \"Open\" do\n      role \"Organizer\"\n      goal \"Start an empty circle\"\n\n      attribute :id, CircleId\n      sets :id\n\n      emits \"CircleOpened\"\n    end\n\n    # A `list_of(Handle)` argument sets the whole `has_many` list at once.\n    command \"Admit\" do\n      role \"Organizer\"\n      goal \"Admit a whole batch of already-joined members at once, by handle\"\n\n      reference_to Circle\n      attribute :members, list_of(Handle)\n      sets :members\n\n      emits \"MembersAdmitted\"\n    end\n  end\nend\n"
}