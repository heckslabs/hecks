  "source_text": "Hecks.bluebook \"Tallying\" do\n  # A CORPUS-OWNED DOMAIN (docs/semantics/bluebook-semantics.md, §3 —\n  # C3.3 integers, C3.4 floats, C3.6 strings, C3.8 bare\n  # argument types, C4.4 numeric effects). The value model's own\n  # bounds are only observable at their edges — a sum past ±2^63-1, a\n  # float sum past the largest finite double, a string that sorts\n  # differently by codepoint than by any locale — and no example domain\n  # goes there. This one exists to.\n  vision \"A tally counts, weighs and labels, and refuses to pretend past the edges of its numbers.\"\n  core\n\n  aggregate \"Tally\" do\n    identified_by :tag\n\n    attribute :tag,    Tag\n    attribute :count,  Count,  default: { value: 0 }\n    attribute :weight, Weight, default: { value: 0.0 }\n    attribute :label,  Label,  default: { value: \"\" }\n    attribute :limit,  Count,  optional: true\n    attribute :tags,   list_of(Label)\n\n    value_object \"Tag\", String\n\n    value_object \"Count\", Integer\n\n    value_object \"Weight\", Float\n\n    value_object \"Label\", String\n\n    command \"Open\" do\n      goal \"Start a tally\"\n      attribute :tag, Tag\n      emits \"TallyOpened\"\n    end\n\n    command \"SetCount\" do\n      goal \"Put the count somewhere\"\n      reference_to Tally\n      attribute :count, Count\n      sets :count\n      emits \"CountSet\"\n    end\n\n    # THE RULE READS THE SUM (C3.3): a given that adds two 64-bit\n    # integers whose sum does not fit is a FAULT, before any effect.\n    command \"Bump\" do\n      goal \"Add to the count, but only past zero\"\n      reference_to Tally\n      attribute :by, Count\n      given(\"the sum stays positive\") { count.value + by.value > 0 }\n      sets :count, increment: :by\n      emits \"CountBumped\"\n    end\n\n    # THE EFFECT ADDS (C3.3): no rule reads the sum, so the overflow\n    # surfaces in the increment itself.\n    command \"Add\" do\n      goal \"Add to the count\"\n      reference_to Tally\n      attribute :by, Count\n      sets :count, increment: :by\n      emits \"CountAdded\"\n    end\n\n    # THE ENSURES READS THE SETTLED STATE (C2.3): `count` is both this\n    # command's argument and the tally's field; inside the ensures it\n    # names the candidate, so the rule judges the increment, not the\n    # argument.\n    command \"Increase\" do\n      goal \"Add to the count and check the count grew by exactly five\"\n      reference_to Tally\n      attribute :count, Count\n      sets :count, increment: :count\n      ensures(\"the count grew by five\") { count.value == old.count.value + 5 }\n      emits \"CountIncreased\"\n    end\n\n    # THE GIVEN READS THE ARGUMENT FIRST (C2.2): `count` is both this\n    # command's argument and the tally's field; inside the given it\n    # names the argument, so the rule judges what the caller passed, not\n    # what the tally already holds.\n    command \"Lower\" do\n      goal \"Accept only a negative count argument\"\n      reference_to Tally\n      attribute :count, Count\n      given(\"the count argument is negative\") { count.value < 0 }\n      emits \"CountLowered\"\n    end\n\n    # THE RULE ADDS FLOATS (C3.4): a sum that is not finite is a FAULT.\n    command \"Weigh\" do\n      goal \"Add weight, but only while there is some\"\n      reference_to Tally\n      attribute :more, Weight\n      given(\"the total is positive\") { weight.value + more.value > 0 }\n      sets :weight, increment: :more\n      emits \"Weighed\"\n    end\n\n    # NUMERIC COMPARISON IS BY VALUE ACROSS INTEGER AND FLOAT (C3.2):\n    # a Float weight of 1.0 satisfies `== 1`.\n    command \"Certify\" do\n      goal \"Certify a tally that weighs exactly one\"\n      reference_to Tally\n      given(\"it weighs exactly one\") { weight.value == 1 }\n      emits \"Certified\"\n    end\n\n    # NIL (C3.5): an absent optional equals only nil; ordering against\n    # nil is a fault.\n    # `cap`, not `limit` — a given reads arguments first (C2.2), so an\n    # argument named `limit` would shadow the field this given asks about.\n    command \"Cap\" do\n      goal \"Set the cap, once\"\n      reference_to Tally\n      attribute :cap, Count\n      given(\"no cap yet\") { limit == nil }\n      sets :limit, to: :cap\n      emits \"Capped\"\n    end\n\n    command \"Check\" do\n      goal \"Confirm the count is under the cap\"\n      reference_to Tally\n      given(\"the count is under the cap\") { count.value < limit.value }\n      emits \"Checked\"\n    end\n\n    # APPEND AND REMOVE (C4.3): remove takes every structurally-equal\n    # element, append keeps order.\n    command \"TagWith\" do\n      goal \"Add a tag\"\n      reference_to Tally\n      attribute :label, Label\n      sets :tags, append: { value: :label }\n      emits \"Tagged\"\n    end\n\n    command \"Untag\" do\n      goal \"Remove every tag equal to the one given\"\n      reference_to Tally\n      attribute :label, Label\n      sets :tags, remove: :label\n      emits \"Untagged\"\n    end\n\n    # STRING ORDER IS CODEPOINT ORDER (C3.6): \"é\" sorts after \"m\",\n    # \"M\" sorts before it.\n    command \"Relabel\" do\n      goal \"Give the tally a label that sorts after m\"\n      reference_to Tally\n      attribute :label, Label\n      given(\"the label sorts after m\") { label.value > \"m\" }\n      sets :label\n      emits \"Relabelled\"\n    end\n\n    # BARE PRIMITIVE ARGUMENTS (C3.8): no value object wraps these, so the\n    # boundary itself holds each to its declared type. No rule or effect\n    # reads them; the command exists to be refused or accepted.\n    command \"Measure\" do\n      goal \"Take a measurement of each primitive kind\"\n      reference_to Tally\n      attribute :times,  Integer\n      attribute :ratio,  Float\n      attribute :note,   String\n      attribute :urgent, TrueClass\n      emits \"Measured\"\n    end\n\n    # NUMERIC EFFECTS (C4.4): `limit` is optional, so it starts absent and\n    # an absent target reads as 0. Each command moves it one way.\n    command \"RaiseLimit\" do\n      goal \"Raise the limit by an amount\"\n      reference_to Tally\n      attribute :by, Count\n      sets :limit, increment: :by\n      emits \"LimitRaised\"\n    end\n\n    command \"LowerLimit\" do\n      goal \"Lower the limit by an amount\"\n      reference_to Tally\n      attribute :by, Count\n      sets :limit, decrement: :by\n      emits \"LimitLowered\"\n    end\n\n    command \"ScaleLimit\" do\n      goal \"Scale the limit by a factor\"\n      reference_to Tally\n      attribute :factor, Count\n      sets :limit, multiply: :factor\n      emits \"LimitScaled\"\n    end\n\n    command \"ClampLimit\" do\n      goal \"Bring the limit into one to ten\"\n      reference_to Tally\n      sets :limit, clamp: [1, 10]\n      emits \"LimitClamped\"\n    end\n\n    # A NON-NUMERIC OPERAND (C4.4): a Label carries a String, so adding it\n    # to the count is a TypeMismatch refusal, not a fault.\n    command \"AddLabel\" do\n      goal \"Add a label's text to the count\"\n      reference_to Tally\n      attribute :label, Label\n      sets :count, increment: :label\n      emits \"LabelAdded\"\n    end\n  end\nend\n"
}