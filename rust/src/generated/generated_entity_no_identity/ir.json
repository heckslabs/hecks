  "source_text": "# GENERATED by Hecks::Fuzzing::DomainGenerator — seed 1005, forms composite_piece, multi_emit. Not hand-written; see bin/qa_generated_domains.\nHecks.bluebook \"GeneratedEntityNoIdentity\" do\n  vision \"A generated domain that puts composite_piece and multi_emit together.\"\n\n  core\n\n  aggregate \"Kiosk\" do\n    description \"A generated kiosk.\"\n\n    identified_by :code\n    attribute :code, KioskCode\n    attribute :lines, list_of(Line)\n\n    value_object \"KioskCode\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a KioskCode is not blank\") { !value.to_s.empty? }\n    end\n\n    value_object \"LineSequence\" do\n      attribute :value, Integer\n      invariant(\"a LineSequence is positive\") { value.positive? }\n    end\n\n    value_object \"LineBatch\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a LineBatch is not blank\") { !value.to_s.empty? }\n    end\n\n    value_object \"LineLabel\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a LineLabel is not blank\") { !value.to_s.empty? }\n    end\n\n    entity \"Line\" do\n      description \"A generated line.\"\n      identified_by :batch, :sequence\n      attribute :batch, LineBatch\n      attribute :sequence, LineSequence\n      attribute :label, LineLabel, optional: true\n\n      command \"Label\" do\n        goal \"Label it\"\n        attribute :label, LineLabel\n        sets :label\n        emits \"LineLabeled\"\n      end\n\n      command \"Settle\" do\n        goal \"Settle it\"\n        emits \"LineSettled\"\n      end\n    end\n\n    command \"Open\" do\n      goal \"Open it\"\n      attribute :code, KioskCode\n      sets :code\n      emits \"KioskOpened\"\n    end\n  end\nend\n"
