  "source_text": "Hecks.bluebook \"Lifeadelics\" do\n  vision \"Every Experience session on the calendar, and every registration's road from intent to a confirmed, paid seat.\"\n  core\n\n  aggregate \"Event\" do\n    description \"One scheduled session of an Experience — Yogadelics, Hikeadelics, and so on — with a price and a seat count.\"\n\n    identified_by :slug\n\n    value_object \"Slug\" do\n      attribute :value, String\n      invariant(\"an event has a slug\") { !value.to_s.empty? }\n    end\n\n    value_object \"Money\" do\n      attribute :cents, Integer\n      invariant(\"a price is never negative\") { cents >= 0 }\n    end\n\n    value_object \"EventName\" do\n      attribute :value, String\n      invariant(\"an event has a name\") { !value.to_s.empty? }\n    end\n\n    value_object \"Capacity\" do\n      attribute :value, Integer\n      invariant(\"a session needs at least one seat\") { value.positive? }\n    end\n\n    attribute :slug,     Slug\n    attribute :name,     EventName\n    attribute :price,    Money\n    attribute :capacity, Capacity\n\n    lifecycle :status, default: \"open\" do\n      transition \"Close\" => \"closed\", from: \"open\"\n    end\n\n    command \"Schedule\" do\n      role \"Organizer\"\n      goal \"Put a new session of an Experience on the calendar\"\n\n      attribute :slug,     Slug\n      attribute :name,     EventName\n      attribute :price,    Money\n      attribute :capacity, Capacity\n\n      emits \"EventScheduled\"\n    end\n\n    command \"Close\" do\n      role \"Organizer\"\n      goal \"Stop taking new registrations for this session\"\n\n      reference_to Event\n\n      given(\"an open session can be closed\") { status == \"open\" }\n\n      emits \"EventClosed\"\n    end\n  end\n\n  # WHAT WAS REGISTERED FOR, not the calendar entry itself, and not\n  # whether it's PAID FOR either, not anymore — Event owns the price and\n  # capacity; Registration owns WHO is coming; Payments::Payment\n  # (embryonaut_bluebooks, vendored — lifeadelics.hecksagon's own\n  # uses_embryonaut_bluebook \"payments\") owns whether money actually\n  # arrived. A registration and its payment share ONE reference —\n  # `registration_id` IS the Payment's own `reference`, minted once by\n  # whoever creates both (adapters/http_server.rb's POST /registrations)\n  # — so \"is this registration paid for\" is answered by asking Payment\n  # (`Payment.find(registration.id).status`), never stored here.\n  #\n  # USED TO TRACK ITS OWN pending/confirmed/declined, with ConfirmReceipt/\n  # RejectPayment reached through a PaymentGateway port's own Receive/\n  # Decline (RegistrationPaymentReceived/Declined) — removed wholesale,\n  # not deprecated: Payment already carries a full settle/refund/dispute\n  # lifecycle (Succeed/Fail/Refund/CompleteRefund/DeclineRefund/\n  # OpenDispute/WinDispute/Chargeback) this aggregate would otherwise be\n  # duplicating one state at a time, permanently behind (no refund\n  # tracking here ever existed; Payment's did from day one).\n  aggregate \"Registration\" do\n    description \"One person's road from intent to attend an Event — who's coming, not whether they've paid (that's Payments::Payment, same reference).\"\n\n    identified_by :registration_id\n\n    value_object \"RegistrationId\" do\n      attribute :value, String\n      invariant(\"a registration is identified\") { !value.to_s.empty? }\n    end\n\n    # GREW TO MATCH THE REAL INTAKE FORM (badass-coaching.net's own\n    # registration-yoga form, the questions asked when registering for\n    # a real event) — `medications`/`health_concerns` are the two\n    # fields a deployment-time `Privacy::Mark` (this bluebook never\n    # states it itself — see lifeadelics.hecksagon's own `uses_framework\n    # \"Privacy\"`) flags PHI; every other field is ordinary intake, not\n    # sensitive.\n    value_object \"Attendee\" do\n      attribute :first_name,        String\n      attribute :last_name,         String\n      attribute :email,             String\n      attribute :phone,             String\n      attribute :news_signup,       TrueClass, default: false\n      attribute :previous_sessions, TrueClass\n      attribute :first_time,        TrueClass\n      attribute :how_heard,         String\n      attribute :medications,       String, optional: true\n      attribute :health_concerns,   String, optional: true\n      attribute :aim,               String\n      attribute :notes,             String, optional: true\n\n      invariant(\"an attendee has a first name\") { !first_name.to_s.empty? }\n      invariant(\"an attendee has a last name\") { !last_name.to_s.empty? }\n      invariant(\"an attendee has an email\") { !email.to_s.empty? }\n      invariant(\"an attendee has a phone number\") { !phone.to_s.empty? }\n      invariant(\"an attendee has answered whether they've done sessions before\") { !previous_sessions.nil? }\n      invariant(\"an attendee has answered whether this is their first time\") { !first_time.nil? }\n      invariant(\"an attendee says how they heard about the event\") { !how_heard.to_s.empty? }\n      invariant(\"an attendee says what they hope to get out of attending\") { !aim.to_s.empty? }\n    end\n\n    reference_to Event, as: :event_slug\n\n    attribute :registration_id, RegistrationId\n    attribute :attendee,        Attendee\n\n    command \"Request\" do\n      role \"Guest\"\n      goal \"Register intent to attend an Event — the Payment sharing this same reference is what actually tracks payment\"\n\n      reference_to Event, as: :event_slug\n      attribute :registration_id, RegistrationId\n      attribute :attendee,        Attendee\n\n      emits \"RegistrationRequested\"\n    end\n  end\nend\n"
}