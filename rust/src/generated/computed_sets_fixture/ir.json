  "source_text": "# Pins `sets` taking arithmetic as its source: `*`, `-` and floor `/` over command arguments and\n# the record's own fields, each result wrapped in the target's single-field value object.\n#\n# Dispatched against both engines by spec/corpus/rust_conformance/computed_sets.json\nHecks.bluebook \"ComputedSetsFixture\" do\n  vision \"The smallest domain whose commands compute a value: a percentage refund, a difference and a floor share.\"\n\n  core\n\n  aggregate \"Settlement\" do\n    description \"A payment, and what is computed from it.\"\n\n    identified_by :ref\n\n    attribute :ref, SettlementRef\n    attribute :paid, Cents\n    attribute :refund, Cents, default: { value: 0 }\n    attribute :remaining, Cents, default: { value: 0 }\n    attribute :share, Cents, default: { value: 0 }\n\n    value_object \"SettlementRef\" do\n      attribute :value, String\n    end\n\n    value_object \"Cents\" do\n      attribute :value, Integer\n    end\n\n    value_object \"Percent\" do\n      attribute :value, Integer\n    end\n\n    command \"Open\" do\n      goal \"Record a payment\"\n\n      attribute :ref, SettlementRef\n      attribute :paid, Cents\n\n      sets :ref\n      sets :paid\n\n      emits \"SettlementOpened\"\n    end\n\n    # `paid` is the record's own field; `rate` and `shortfall` are arguments.\n    command \"Settle\" do\n      goal \"Refund a percentage of the payment and work out what remains\"\n\n      reference_to Settlement\n      attribute :rate, Percent\n      attribute :shortfall, Cents\n\n      sets :refund, to: paid * rate / 100\n      sets :remaining, to: paid - shortfall\n\n      emits \"SettlementSettled\"\n    end\n\n    command \"Share\" do\n      goal \"Split an amount into equal parts, rounding down\"\n\n      reference_to Settlement\n      attribute :amount, Cents\n      attribute :parts, Percent\n\n      sets :share, to: amount / parts\n\n      emits \"SettlementShared\"\n    end\n  end\nend\n"
}