  "source_text": "# Smallest domain with an optional value object held inside a value object (Panel.note), inside a\n# list member (Cell.note) and two levels down (Note.link), each with invariants that read a slot\n# an offered or stored value may leave out. Held to the same answers by Ruby and Rust through\n# spec/corpus/rust_conformance/optional_nested_value_object_*.json and, for a stored value's mint\n# audit, spec/rust_host_reference_validate_conformance_spec.rb.\nHecks.bluebook \"OptionalNestedValueObjectFixture\" do\n  vision \"The smallest domain whose value objects hold optional value objects, alone and in lists.\"\n\n  core\n\n  aggregate \"Layout\" do\n    description \"An ordered list of panels, each of which may carry a note, and cells that may too.\"\n\n    identified_by :key\n    attribute :key,    LayoutKey\n    attribute :panels, list_of(Panel)\n\n    value_object \"LayoutKey\" do\n      attribute :value, String, matches: :present\n      invariant(\"a layout is keyed\") { !value.to_s.empty? }\n    end\n\n    value_object \"Panel\" do\n      attribute :kind,  String\n      attribute :title, String, optional: true\n      attribute :note,  Note, optional: true\n      attribute :cells, list_of(Cell)\n\n      invariant(\"a panel has a kind\") { !kind.to_s.empty? }\n      invariant(\"a title is not blank when given\") { title.unset? || !title.to_s.empty? }\n      invariant(\"a callout carries a note\") { kind != \"callout\" || note.set? }\n      invariant(\"a quiet panel has no loud note\") { kind != \"quiet\" || note.tone != \"loud\" }\n    end\n\n    value_object \"Cell\" do\n      attribute :label, String\n      attribute :note,  Note, optional: true\n\n      invariant(\"a cell is labelled\") { !label.to_s.empty? }\n      invariant(\"a cell's note is short\") { note.unset? || note.text.size <= 40 }\n    end\n\n    value_object \"Note\" do\n      attribute :text, String\n      attribute :tone, String, optional: true\n      attribute :link, Link, optional: true\n\n      invariant(\"a note has words\") { !text.to_s.empty? }\n      invariant(\"a tone is calm or loud\") { tone.unset? || tone == \"calm\" || tone == \"loud\" }\n    end\n\n    value_object \"Link\" do\n      attribute :href,  String\n      attribute :label, String, optional: true\n\n      invariant(\"a link is a path\") { href.start_with?(\"/\") }\n      invariant(\"a link label is not blank when given\") { label.unset? || !label.to_s.empty? }\n    end\n\n    command \"Write\" do\n      role \"Editor\"\n      goal \"Start a layout's panels\"\n\n      attribute :key,    LayoutKey\n      attribute :panels, list_of(Panel)\n      sets :key\n      sets :panels\n\n      emits \"LayoutWritten\"\n    end\n\n    command \"Revise\" do\n      role \"Editor\"\n      goal \"Replace the panels\"\n\n      reference_to Layout\n      attribute :panels, list_of(Panel)\n      sets :panels\n\n      emits \"LayoutRevised\"\n    end\n  end\nend\n"
}