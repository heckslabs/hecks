  "source_text": "# GENERATED by Hecks::Fuzzing::DomainGenerator — seed 556518, forms has_default, composite_piece. Not hand-written; see bin/qa_generated_domains.\nHecks.bluebook \"CompositeLineLedger\" do\n  vision \"A generated domain that puts has_default and composite_piece together.\"\n\n  core\n\n  aggregate \"Venue\" do\n    description \"A generated venue.\"\n\n    identified_by :code\n    attribute :code, VenueCode\n    attribute :lines, list_of(Line)\n\n    value_object \"VenueCode\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a VenueCode is not blank\") { !value.to_s.empty? }\n    end\n\n    value_object \"VenueScore\" do\n      attribute :value, Integer\n    end\n\n    value_object \"LineSequence\" do\n      attribute :value, Integer\n      invariant(\"a LineSequence is positive\") { value.positive? }\n    end\n\n    value_object \"LineBatch\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a LineBatch is not blank\") { !value.to_s.empty? }\n    end\n\n    value_object \"LineLabel\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a LineLabel is not blank\") { !value.to_s.empty? }\n    end\n\n    value_object \"VenuePriority\" do\n      attribute :value, String, one_of: [\"red\", \"amber\", \"green\"]\n    end\n\n    entity \"Line\" do\n      description \"A generated line.\"\n      identified_by :batch, :sequence\n      attribute :batch, LineBatch\n      attribute :sequence, LineSequence\n      attribute :label, LineLabel, optional: true\n\n      command \"Label\" do\n        goal \"Label it\"\n        attribute :label, LineLabel\n        sets :label\n        emits \"VenueLineLabeled\"\n      end\n    end\n\n    command \"Open\" do\n      goal \"Open it\"\n      attribute :code, VenueCode\n      sets :code\n      emits \"VenueOpened\"\n    end\n\n    command \"Rescore\" do\n      goal \"Rescore it\"\n      reference_to Venue\n      attribute :amount, VenueScore\n      emits \"VenueRescored\"\n    end\n\n    command \"AddLine\" do\n      goal \"AddLine it\"\n      reference_to Venue\n      attribute :batch, LineBatch\n      attribute :sequence, LineSequence\n      sets :lines, append: { batch: :batch, sequence: :sequence }\n      emits \"VenueLineAdded\"\n    end\n\n    command \"Prioritize\" do\n      goal \"Prioritize it\"\n      reference_to Venue\n      attribute :priority, VenuePriority\n      emits \"VenuePrioritized\"\n    end\n  end\n\n  aggregate \"Hangar\" do\n    description \"A generated hangar.\"\n\n    identified_by :code\n    attribute :code, HangarCode\n\n    value_object \"HangarCode\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a HangarCode is not blank\") { !value.to_s.empty? }\n    end\n\n    value_object \"HangarScore\" do\n      attribute :value, Integer\n    end\n\n    command \"Open\" do\n      goal \"Open it\"\n      attribute :code, HangarCode\n      sets :code\n      emits \"HangarOpened\"\n    end\n\n    command \"Reopen\" do\n      goal \"Reopen it\"\n      reference_to Hangar\n      emits \"HangarReopened\"\n    end\n\n    command \"Rescore\" do\n      role \"Manager\"\n      goal \"Rescore it\"\n      reference_to Hangar\n      attribute :amount, HangarScore\n      emits \"HangarRescored\"\n    end\n  end\nend\n"
