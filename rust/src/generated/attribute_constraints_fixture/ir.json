  "source_text": "# Smallest domain that declares every attribute-level constraint the DSL has, at the aggregate, in\n# a value object it holds, in one that holds another three deep, and in list members at both\n# depths: a closed set (inline `one_of:`, type-position `one_of(...)`, a multi-field `member`\n# table), a declared set named by `admits:`, a `pattern:`, scalar shape (Integer, Float,\n# String), required against optional, and a size limit written as an invariant. Held to the same\n# answers by Ruby dispatch and Rust dispatch through\n# spec/corpus/rust_conformance/attribute_constraints_*.json and, for a stored value's mint audit,\n# spec/rust_host_reference_validate_conformance_spec.rb.\nHecks.bluebook \"AttributeConstraintsFixture\" do\n  vision \"The smallest domain that declares each attribute-level constraint at every depth.\"\n\n  core\n\n  aggregate \"Vocabulary\" do\n    description \"A named list of units, which a Shelf's attributes admit by name.\"\n\n    identified_by :name\n    attribute :name, VocabularyName\n\n    value_object \"VocabularyName\" do\n      attribute :value, String\n    end\n\n    value_object \"Unit\" do\n      attribute :value, String, one_of: [\"gram\", \"litre\"]\n    end\n\n    command \"Name\" do\n      role \"Editor\"\n      goal \"Record a vocabulary\"\n\n      attribute :name, VocabularyName\n      sets :name\n\n      emits \"VocabularyNamed\"\n    end\n  end\n\n  aggregate \"Shelf\" do\n    description \"A shelf of panels; every level declares the same kinds of constraint.\"\n\n    identified_by :key\n    attribute :key,    ShelfKey\n    attribute :band,   Band\n    attribute :unit,   UnitRef, admits: \"Vocabulary::Unit\"\n    attribute :stamp,  Stamp\n    attribute :count,  Count\n    attribute :ratio,  Ratio\n    attribute :note,   Note, optional: true\n    attribute :slugs,  list_of(Stamp)\n    attribute :panels, list_of(Panel)\n    attribute :spare,  Panel, optional: true\n\n    value_object \"UnitRef\" do\n      attribute :value, String\n    end\n\n    value_object \"Stamp\" do\n      attribute :value, String, pattern: '^[a-z]+$'\n    end\n\n    value_object \"Count\" do\n      attribute :value, Integer\n    end\n\n    value_object \"Ratio\" do\n      attribute :value, Float\n    end\n\n    value_object \"Note\" do\n      attribute :value, String\n    end\n\n    value_object \"ShelfKey\" do\n      attribute :value, String, matches: :no_whitespace\n    end\n\n    value_object \"Band\" do\n      attribute :size, String, one_of: [\"small\", \"medium\", \"large\"]\n    end\n\n    value_object \"Pairing\" do\n      attribute :code,  String\n      attribute :label, String\n\n      member code: \"p\", label: \"Pee\"\n      member code: \"q\", label: \"Cue\"\n    end\n\n    value_object \"Panel\" do\n      attribute :title,  String, pattern: '[A-Z][a-z]*'\n      attribute :unit,   String, admits: \"Vocabulary::Unit\"\n      attribute :band,   Band\n      attribute :count,  Integer\n      attribute :note,   String, optional: true\n      attribute :labels, list_of(String), pattern: '^[a-z]+$'\n      attribute :frame,  Frame, optional: true\n\n      invariant(\"a panel holds at most three labels\") { labels.size <= 3 }\n    end\n\n    value_object \"Frame\" do\n      attribute :slug,   String, pattern: '^[a-z0-9-]+$'\n      attribute :grade,  one_of(\"a\", \"b\", \"c\")\n      attribute :leaf,   Leaf\n      attribute :leaves, list_of(Leaf), optional: true\n    end\n\n    value_object \"Leaf\" do\n      attribute :band,    Band\n      attribute :code,    String, pattern: '^[a-z]+$'\n      attribute :unit,    String, admits: \"Vocabulary::Unit\"\n      attribute :count,   Integer\n      attribute :ratio,   Float\n      attribute :pairing, Pairing, optional: true\n      attribute :note,    String, optional: true\n\n      invariant(\"a code is at most four letters\") { code.size <= 4 }\n    end\n\n    command \"Write\" do\n      role \"Editor\"\n      goal \"Shelve a value of every shape\"\n\n      attribute :key,    ShelfKey\n      attribute :band,   Band\n      attribute :unit,   UnitRef, admits: \"Vocabulary::Unit\"\n      attribute :stamp,  Stamp\n      attribute :count,  Count\n      attribute :ratio,  Ratio\n      attribute :note,   Note, optional: true\n      attribute :slugs,  list_of(Stamp)\n      attribute :panels, list_of(Panel)\n      attribute :spare,  Panel, optional: true\n      sets :key\n      sets :band\n      sets :unit\n      sets :stamp\n      sets :count\n      sets :ratio\n      sets :note\n      sets :slugs\n      sets :panels\n      sets :spare\n\n      emits \"ShelfWritten\"\n    end\n  end\nend\n"
}