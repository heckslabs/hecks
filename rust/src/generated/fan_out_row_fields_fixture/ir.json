  "source_text": "# Pins a `for_each` policy's `with:` reading a fan-out row's own fields: `:charged` is a field of\n# each Charge row the query answers, `:label` is a field of the row and of the event's payload, and\n# the payload's value wins. The row's id still reaches the trigger under its row key.\n#\n# Dispatched against both engines by\n# spec/corpus/rust_conformance/fan_out_row_fields.json\nHecks.bluebook \"FanOutRowFieldsFixture\" do\n  vision \"The smallest domain whose cancellation refunds each charge it fans out to by what that charge holds.\"\n\n  core\n\n  aggregate \"Charge\" do\n    description \"A charge taken against a booking, refunded when the booking is cancelled.\"\n\n    identified_by :ref\n\n    attribute :ref, ChargeRef\n    attribute :booking, BookingKey\n    attribute :charged, Amount\n    attribute :label, Label\n    attribute :refunded, Amount, default: { value: 0 }\n    attribute :refund_label, Label, optional: true\n\n    value_object \"ChargeRef\" do\n      attribute :value, String\n    end\n\n    value_object \"BookingKey\" do\n      attribute :value, String\n    end\n\n    value_object \"Amount\" do\n      attribute :value, Integer\n    end\n\n    value_object \"Label\" do\n      attribute :value, String\n    end\n\n    command \"Take\" do\n      goal \"Take a charge\"\n\n      attribute :ref, ChargeRef\n      attribute :booking, BookingKey\n      attribute :charged, Amount\n      attribute :label, Label\n\n      sets :ref\n      sets :booking\n      sets :charged\n      sets :label\n\n      emits \"ChargeTaken\"\n    end\n\n    command \"Refund\" do\n      goal \"Refund what a charge holds\"\n\n      reference_to Charge\n      attribute :refunded, Amount\n      attribute :refund_label, Label\n\n      sets :refunded\n      sets :refund_label\n\n      emits \"ChargeRefunded\"\n    end\n\n    query \"ForBooking\" do\n      attribute :booking, BookingKey\n      where(booking: :booking)\n    end\n  end\n\n  aggregate \"Cancellation\" do\n    description \"A booking's cancellation.\"\n\n    identified_by :ref\n\n    attribute :ref, CancellationRef\n\n    value_object \"CancellationRef\" do\n      attribute :value, String\n    end\n\n    value_object \"BookingKey\" do\n      attribute :value, String\n    end\n\n    value_object \"Label\" do\n      attribute :value, String\n    end\n\n    command \"Cancel\" do\n      goal \"Cancel a booking\"\n\n      attribute :ref, CancellationRef\n      attribute :booking, BookingKey\n      attribute :label, Label\n\n      sets :ref\n\n      emits \"BookingCancelled\"\n    end\n  end\n\n  # `charge` is the row's id under its row key; `refunded` comes from each row's `charged`; `refund_label` is in the row too, but the\n  # event's own `label` is offered first.\n  policy \"RefundOnCancel\" do\n    on \"BookingCancelled\"\n    for_each \"Charge.ForBooking\"\n    trigger Charge::Refund, with: { charge: :charge, refunded: :charged, refund_label: :label }\n  end\nend\n"
}