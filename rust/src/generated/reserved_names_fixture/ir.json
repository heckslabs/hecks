  "source_text": "# Smallest domain whose aggregates are named for files the Rust generator writes itself:\n# `Metadata`, `Registry` and `Merged` each become a module beside the chapter's own\n# `metadata`, `registry` and `merged` modules. Round-tripped by spec/rust_generated/reserved_names_spec.rb.\nHecks.bluebook \"ReservedNamesFixture\" do\n  vision \"The smallest domain whose aggregate names collide with the modules the Rust generator owns.\"\n\n  core\n\n  aggregate \"Metadata\" do\n    description \"A record named for the generator's own metadata module.\"\n\n    identified_by :key\n    attribute :key, MetadataKey\n\n    value_object \"MetadataKey\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a metadata record is keyed\") { !value.to_s.empty? }\n    end\n\n    command \"Record\" do\n      role \"Person\"\n      goal \"Record a metadata entry\"\n\n      attribute :key, MetadataKey\n      sets :key\n\n      emits \"MetadataRecorded\"\n    end\n  end\n\n  aggregate \"Registry\" do\n    description \"A record named for the generator's own registry module.\"\n\n    identified_by :key\n    attribute :key, RegistryKey\n\n    value_object \"RegistryKey\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a registry record is keyed\") { !value.to_s.empty? }\n    end\n\n    command \"Enter\" do\n      role \"Person\"\n      goal \"Enter a registry entry\"\n\n      attribute :key, RegistryKey\n      sets :key\n\n      emits \"RegistryEntered\"\n    end\n  end\n\n  aggregate \"Merged\" do\n    description \"A record named for the generator's own merged module.\"\n\n    identified_by :key\n    attribute :key, MergedKey\n\n    value_object \"MergedKey\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a merged record is keyed\") { !value.to_s.empty? }\n    end\n\n    command \"Combine\" do\n      role \"Person\"\n      goal \"Combine a merged entry\"\n\n      attribute :key, MergedKey\n      sets :key\n\n      emits \"MergedCombined\"\n    end\n  end\nend\n"
