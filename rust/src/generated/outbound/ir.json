  "source_text": "Hecks.bluebook \"Outbound\" do\n  # A CORPUS-OWNED DOMAIN (docs/semantics/bluebook-semantics.md).\n  # Its `across` policies hand a domain that is not loaded their payload, so the conformance\n  # harness can read what each would deliver (ADR 0153): a `with:` of literals and `:id`, no\n  # `with:` (the payload unchanged), and a `with:` that reads a payload field.\n  vision \"A parcel is sent, forwarded or annotated, and another domain is told.\"\n  core\n\n  aggregate \"Parcel\" do\n    identified_by :tag\n\n    attribute :tag,  Tag\n    attribute :note, Note\n\n    value_object \"Tag\" do\n      attribute :value, String\n    end\n\n    value_object \"Note\" do\n      attribute :value, String\n    end\n\n    command \"Send\" do\n      goal \"Send a parcel on its way\"\n      attribute :tag, Tag\n      emits \"ParcelSent\"\n    end\n\n    command \"Forward\" do\n      goal \"Forward a parcel unchanged\"\n      attribute :tag, Tag\n      emits \"ParcelForwarded\"\n    end\n\n    command \"Annotate\" do\n      goal \"Write a note on a parcel\"\n      attribute :tag,  Tag\n      attribute :note, Note\n      emits \"ParcelAnnotated\"\n    end\n  end\n\n  policy \"FileOnSend\" do\n    on      Parcel::ParcelSent\n    trigger Filing::Open, with: { subject_kind: \"parcel\", subject_key: :id }\n    across  \"Registry\"\n  end\n\n  policy \"FileOnForward\" do\n    on      Parcel::ParcelForwarded\n    trigger Filing::Open\n    across  \"Registry\"\n  end\n\n  policy \"FileOnAnnotate\" do\n    on      Parcel::ParcelAnnotated\n    trigger Filing::Open, with: { subject_kind: \"annotation\", detail: :note }\n    across  \"Registry\"\n  end\nend\n"
