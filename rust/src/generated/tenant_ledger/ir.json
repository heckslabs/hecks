  "source_text": "# Stress domain: two tenant-scoped aggregates joined by a cross-tenant reference_to.\n# Feeds `commands_respect_tenant_scope` (lib/hecks/fuzzing/properties/guards.rb); see NOTES.md.\nHecks.bluebook \"TenantLedger\" do\n  vision \"Two tenant-scoped aggregates, a cross-tenant reference_to between them, an entity, and a saga that crosses tenants — enough surface to prove the write side has no TenantScope equivalent at all.\"\n\n  core\n\n  # `region` is the tenant field `commands_respect_tenant_scope` reads off any aggregate.\n  aggregate \"Ledger\" do\n    description \"One region's ledger — the record a cross-tenant Transfer.Request can name without ever proving it belongs to the same region.\"\n\n    identified_by :code\n\n    attribute :code,          LedgerCode\n    attribute :region,        LedgerRegion\n    attribute :balance_cents, LedgerAmountCents, default: { value: 0 }\n    attribute :entries,       list_of(Entry)\n\n    value_object \"LedgerCode\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a ledger is coded\") { !value.to_s.empty? }\n    end\n\n    value_object \"LedgerRegion\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a ledger names its region\") { !value.to_s.empty? }\n    end\n\n    value_object \"LedgerAmountCents\" do\n      attribute :value, Integer\n      invariant(\"an amount is never negative\") { value >= 0 }\n    end\n\n    value_object \"EntrySequence\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"an entry is sequenced\") { !value.to_s.empty? }\n    end\n\n    value_object \"EntryNote\" do\n      attribute :text, String\n    end\n\n    # Pass-through correlation field: never stored, but emitted in the event payload so the\n    # saga can correlate on it. Declared locally; value objects are not shared across aggregates.\n    value_object \"LedgerCreditReference\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a credit still names the transfer that asked for it\") { !value.to_s.empty? }\n    end\n\n    entity \"Entry\" do\n      description \"One posting into the ledger, in the order it landed.\"\n\n      identified_by :sequence\n\n      attribute :sequence, EntrySequence\n      attribute :amount_cents, LedgerAmountCents\n      attribute :note, EntryNote, optional: true\n\n      command \"Annotate\" do\n        role \"Auditor\"\n        goal \"Note something about a posting after the fact\"\n\n        attribute :note, EntryNote\n        sets :note\n\n        emits \"EntryAnnotated\"\n      end\n    end\n\n    command \"Open\" do\n      role \"Clerk\"\n      goal \"Start a ledger for one region\"\n\n      attribute :code,   LedgerCode\n      attribute :region, LedgerRegion\n\n      sets :code\n      sets :region\n\n      emits \"LedgerOpened\"\n    end\n\n    # Saga target, dispatched against whichever ledger Transfer.Request named. Role System\n    # means no tenant check; nothing else in the dispatch closes that gap.\n    command \"Credit\" do\n      role \"System\"\n      goal \"Credit funds into a ledger, settling a transfer that may or may not share this ledger's own region\"\n\n      reference_to Ledger\n      attribute :amount_cents, LedgerAmountCents\n      attribute :sequence,     EntrySequence\n      attribute :reference,    LedgerCreditReference\n\n      sets :balance_cents, increment: :amount_cents\n      sets :entries, append: { sequence: :sequence, amount_cents: :amount_cents }\n\n      emits \"LedgerCredited\"\n    end\n\n    query \"ByRegion\" do\n      description \"Ledgers open in one region, for a caller standing in that region.\"\n      order_by :code\n      authorize :ledger_access, tenant: :region\n    end\n  end\n\n  # `region` is a caller-supplied argument, never derived from the ledger named below.\n  aggregate \"Transfer\" do\n    description \"A request to move funds into some ledger — the ledger a caller names is never proven to share this transfer's own declared region.\"\n\n    identified_by :reference\n\n    attribute :reference,     TransferReference\n    attribute :region,        TransferRegion\n    # Crosses to a different tenant-scoped aggregate.\n    reference_to Ledger\n    attribute :amount_cents,  TransferAmountCents\n\n    value_object \"TransferReference\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a transfer is referenced\") { !value.to_s.empty? }\n    end\n\n    value_object \"TransferRegion\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a transfer names its own region\") { !value.to_s.empty? }\n    end\n\n    value_object \"TransferAmountCents\" do\n      attribute :value, Integer\n      invariant(\"an amount is never negative\") { value >= 0 }\n    end\n\n    # `region` and `ledger` are passed independently; `enforce_tenant_boundary`\n    # (runtime/command_rules/references.rb) refuses a ledger from another region.\n    command \"Request\" do\n      role \"Clerk\"\n      goal \"Ask that funds move into a ledger, in a region the caller declares independently of which ledger they name\"\n\n      attribute :reference, TransferReference\n\n      sets :reference\n      sets :region\n      sets :ledger\n      sets :amount_cents\n\n      emits \"TransferRequested\"\n    end\n\n    query \"ByRegion\" do\n      description \"Transfers requested from one region, for a caller standing in that region.\"\n      order_by :reference\n      authorize :transfer_access, tenant: :region\n    end\n  end\n\n  # Starts on TransferRequested, so a refused cross-tenant Request never begins this saga.\n  # Sagas carry no tenant check of their own.\n  process_manager \"SettleAcrossRegions\" do\n    correlates_by :\"reference.value\"\n    starts_on Transfer::TransferRequested\n    ends_on   Ledger::LedgerCredited\n\n    transition Transfer::TransferRequested => \"settling\", from: \"settling\" do\n      dispatch Ledger::Credit, with: { code: :ledger, amount_cents: :amount_cents,\n                                       sequence: :reference, reference: :reference }\n    end\n  end\nend\n"
}