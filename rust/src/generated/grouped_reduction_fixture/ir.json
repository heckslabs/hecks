  "source_text": "# The smallest domain whose read models group and reduce (ADR 0126): each reducer once over\n# one aisle-grouped shelf, and a sum nested two levels deep.\nHecks.bluebook \"GroupedReductionFixture\" do\n  vision \"Stock on shelves, added up by aisle and bay, the same in every runtime.\"\n\n  core\n\n  aggregate \"Item\" do\n    description \"One stocked line, addressed by its own code, kept in one aisle and bay.\"\n\n    identified_by :sku\n    attribute :sku, Sku\n    attribute :aisle, Aisle\n    attribute :bay, Bay\n    attribute :units, Units\n    attribute :weight, Weight\n    attribute :fragile, Fragile\n\n    value_object \"Sku\" do\n      attribute :value, String, matches: :present\n    end\n\n    value_object \"Aisle\" do\n      attribute :label, String, matches: :present\n    end\n\n    value_object \"Bay\" do\n      attribute :label, String, matches: :present\n    end\n\n    value_object \"Units\" do\n      attribute :count, Integer\n    end\n\n    value_object \"Weight\" do\n      attribute :kilograms, Float\n    end\n\n    value_object \"Fragile\" do\n      attribute :flag, TrueClass\n    end\n\n    command \"Shelve\" do\n      role \"Clerk\"\n      goal \"Put a line of stock on a shelf\"\n\n      attribute :sku, Sku\n      attribute :aisle, Aisle\n      attribute :bay, Bay\n      attribute :units, Units\n      attribute :weight, Weight\n      attribute :fragile, Fragile\n      sets :sku\n      sets :aisle\n      sets :bay\n      sets :units\n      sets :weight\n      sets :fragile\n\n      emits \"ItemShelved\"\n    end\n  end\n\n  read_model \"UnitsByAisle\" do\n    description \"The units on each aisle, added up.\"\n    include Item\n    group_by :aisle\n    sum :units\n  end\n\n  read_model \"LinesByAisle\" do\n    description \"How many lines stand on each aisle.\"\n    include Item\n    group_by :aisle\n    count\n  end\n\n  read_model \"MeanUnitsByAisle\" do\n    description \"The mean units of a line on each aisle.\"\n    include Item\n    group_by :aisle\n    avg :units\n  end\n\n  read_model \"LightestByAisle\" do\n    description \"The lightest line on each aisle.\"\n    include Item\n    group_by :aisle\n    min :weight\n  end\n\n  read_model \"HeaviestByAisle\" do\n    description \"The heaviest line on each aisle.\"\n    include Item\n    group_by :aisle\n    max :weight\n  end\n\n  read_model \"MedianUnitsByAisle\" do\n    description \"The median units of a line on each aisle.\"\n    include Item\n    group_by :aisle\n    median :units\n  end\n\n  read_model \"UpperUnitsByAisle\" do\n    description \"The units at the 90th percentile of the lines on each aisle.\"\n    include Item\n    group_by :aisle\n    percentile :units, at: 0.9\n  end\n\n  read_model \"AnyFragileByAisle\" do\n    description \"Whether any line on each aisle is fragile.\"\n    include Item\n    group_by :aisle\n    any :fragile\n  end\n\n  read_model \"AllFragileByAisle\" do\n    description \"Whether every line on each aisle is fragile.\"\n    include Item\n    group_by :aisle\n    all :fragile\n  end\n\n  read_model \"UnitsByAisleAndBay\" do\n    description \"The units in each bay of each aisle, added up.\"\n    include Item\n    group_by :aisle, :bay\n    sum :units\n  end\nend\n"
}