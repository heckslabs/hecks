  "source_text": "# Smallest domain with an optional value-object attribute whose value object holds lists of\n# other value objects, beside a required one of the same type: a live body and a draft that\n# is promoted to it, then cleared. Round-tripped by spec/rust_generated/optional_value_object_spec.rb.\nHecks.bluebook \"OptionalValueObjectFixture\" do\n  vision \"The smallest domain whose aggregate keeps a live body and an optional draft of the same nested shape.\"\n\n  core\n\n  aggregate \"Page\" do\n    description \"A body of blocks and an optional draft of one, set aside until it is put live.\"\n\n    identified_by :key\n    attribute :key,        PageKey\n    attribute :body,       Body\n    attribute :draft_body, Body, optional: true\n\n    value_object \"PageKey\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a page is keyed\") { !value.to_s.empty? }\n    end\n\n    value_object \"Body\" do\n      attribute :blocks, list_of(Block)\n    end\n\n    value_object \"Block\" do\n      attribute :kind,  String\n      attribute :level, Integer, optional: true\n      attribute :spans, list_of(Span)\n      attribute :items, list_of(Item)\n    end\n\n    value_object \"Item\" do\n      attribute :spans, list_of(Span)\n      attribute :depth, Integer, optional: true\n    end\n\n    value_object \"Span\" do\n      attribute :text,  String\n      attribute :marks, list_of(Mark)\n      attribute :href,  String, optional: true\n    end\n\n    value_object \"Mark\" do\n      attribute :name, String\n    end\n\n    command \"Write\" do\n      role \"Editor\"\n      goal \"Start a page's body\"\n\n      attribute :key,  PageKey\n      attribute :body, Body\n      sets :key\n      sets :body\n\n      emits \"PageWritten\"\n    end\n\n    command \"Revise\" do\n      role \"Editor\"\n      goal \"Replace the body readers see\"\n\n      reference_to Page\n      attribute :body, Body\n      sets :body\n\n      emits \"PageRevised\"\n    end\n\n    command \"SaveDraft\" do\n      role \"Editor\"\n      goal \"Keep an edit aside without changing what readers see\"\n\n      reference_to Page\n      attribute :draft_body, Body\n      sets :draft_body\n\n      emits \"PageDraftSaved\"\n    end\n\n    # Clearing is leaving out: `nothing` is never sent, so `draft_body` is set from nothing.\n    command \"PublishDraft\" do\n      role \"Editor\"\n      goal \"Make the saved edit what readers see, and clear it\"\n\n      reference_to Page\n      attribute :nothing, Body, optional: true\n\n      given(\"an edit is saved\") { draft_body.set? }\n      sets :body, to: state(:draft_body)\n      sets :draft_body, to: :nothing\n\n      emits \"PageDraftPublished\"\n    end\n  end\nend\n"
}