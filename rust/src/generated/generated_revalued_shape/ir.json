  "source_text": "# GENERATED by Hecks::Fuzzing::DomainGenerator — seed 1009, forms revalued_reference, has_query. Not hand-written; see bin/qa_generated_domains.\nHecks.bluebook \"GeneratedRevaluedShape\" do\n  vision \"A generated domain that puts revalued_reference and has_query together.\"\n\n  core\n\n  aggregate \"Hangar\" do\n    description \"A generated hangar.\"\n\n    identified_by :code\n    attribute :code, HangarCode\n    reference_to Venue\n\n    value_object \"HangarCode\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a HangarCode is not blank\") { !value.to_s.empty? }\n    end\n\n    value_object \"VenueHandle\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a VenueHandle is not blank\") { !value.to_s.empty? }\n    end\n\n    lifecycle :status, default: \"open\" do\n      transition \"Reopen\" => \"open\", from: \"closed\"\n    end\n\n    command \"Open\" do\n      goal \"Open it\"\n      reference_to Venue\n      attribute :code, HangarCode\n      sets :code\n      sets :venue\n      emits \"HangarOpened\"\n    end\n\n    command \"Repoint\" do\n      goal \"Repoint it\"\n      reference_to Hangar\n      attribute :venue, VenueHandle\n      sets :venue\n      emits \"HangarRepointed\"\n    end\n\n    command \"Reopen\" do\n      goal \"Reopen it\"\n      reference_to Hangar\n      emits \"HangarReopened\"\n    end\n\n    query \"Listed\" do\n      description \"Generated Listed.\"\n      where(:\"status\" => \"open\")\n      order_by :code\n    end\n  end\n\n  aggregate \"Venue\" do\n    description \"A generated venue.\"\n\n    identified_by :code\n    attribute :code, VenueCode\n\n    value_object \"VenueCode\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a VenueCode is not blank\") { !value.to_s.empty? }\n    end\n\n    command \"Open\" do\n      goal \"Open it\"\n      attribute :code, VenueCode\n      sets :code\n      emits \"VenueOpened\"\n    end\n  end\nend\n"
