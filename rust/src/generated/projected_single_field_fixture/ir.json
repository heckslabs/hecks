  "source_text": "# Pins `projects` over a remote field typed by a single-field value object: the projecting\n# aggregate holds the one scalar in the remote field's own type (Integer, String),\n# seeded when a command saves it and read back as that type.\n#\n# Dispatched against both engines by\n# spec/corpus/rust_conformance/projected_single_field_value_object.json\nHecks.bluebook \"ProjectedSingleFieldFixture\" do\n  vision \"The smallest domain whose Booking holds local copies of an Event's single-field value object fields, an Integer and a String.\"\n\n  core\n\n  aggregate \"Event\" do\n    description \"The record a Booking's projected fields are copies of.\"\n\n    identified_by :ref\n\n    attribute :ref, EventRef\n    attribute :starts_at, StartsAt\n    attribute :title, Title\n\n    value_object \"EventRef\" do\n      attribute :value, String\n    end\n\n    value_object \"StartsAt\" do\n      attribute :value, Integer\n    end\n\n    value_object \"Title\" do\n      attribute :value, String\n    end\n\n    command \"Schedule\" do\n      goal \"Schedule an event\"\n\n      attribute :ref, EventRef\n      attribute :starts_at, StartsAt\n      attribute :title, Title\n\n      sets :ref\n      sets :starts_at\n      sets :title\n\n      emits \"EventScheduled\"\n    end\n\n    command \"Reschedule\" do\n      goal \"Move an event\"\n\n      reference_to Event\n      attribute :starts_at, StartsAt\n\n      sets :starts_at\n\n      emits \"EventRescheduled\"\n    end\n  end\n\n  aggregate \"Booking\" do\n    description \"Refers to an Event and holds a local copy of its start time and title.\"\n\n    identified_by :ref\n\n    attribute :ref, BookingRef\n    reference_to Event\n\n    projects :starts_at, from: :\"event.starts_at\"\n    projects :title, from: :\"event.title\"\n\n    value_object \"BookingRef\" do\n      attribute :value, String\n    end\n\n    command \"Open\" do\n      goal \"Book an event\"\n\n      reference_to Event\n      attribute :ref, BookingRef\n\n      sets :ref\n\n      emits \"BookingOpened\"\n    end\n\n    command \"Touch\" do\n      goal \"Save a booking again, which seeds its projected fields afresh\"\n\n      reference_to Booking\n\n      emits \"BookingTouched\"\n    end\n  end\nend\n"
}