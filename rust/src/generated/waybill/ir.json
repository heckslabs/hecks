  "source_text": "# Stress domain: a process_manager whose dispatch leg targets a nested entity's command.\n# Pinned end to end by spec/waybill_spec.rb, including the entity-level compensation.\nHecks.bluebook \"Waybill\" do\n  vision \"A consignment saga that opens a manifest, reserves a slot on it, and tries to fill that slot through the saga's own dispatch — the first process manager anywhere in this corpus to target a nested entity's own command, rather than a plain aggregate's.\"\n\n  core\n\n  aggregate \"Consignment\" do\n    description \"A request to pack and ship one item, driving the Packing saga end to end.\"\n\n    attribute :reference, ConsignmentReference\n    identified_by :reference\n\n    attribute :number, SlotNumber\n    attribute :item,   ItemLabel\n\n    value_object \"ConsignmentReference\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a consignment is referenced\") { !value.to_s.empty? }\n    end\n\n    # Redeclared per aggregate: value objects are not shared across aggregates.\n    # Positive-only, so 0 survives routing but fails the invariant on a typed rebuild.\n    value_object \"SlotNumber\" do\n      attribute :value, Integer\n      invariant(\"a slot number is positive\") { value.positive? }\n    end\n\n    value_object \"ItemLabel\" do\n      attribute :text, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"an item is labeled\") { !text.to_s.empty? }\n    end\n\n    lifecycle :status, default: \"requested\" do\n      transition \"Ship\"   => \"shipped\",   from: \"requested\"\n      transition \"Cancel\" => \"cancelled\", from: \"requested\"\n    end\n\n    command \"Request\" do\n      role \"Customer\"\n      goal \"Request one item be packed onto a numbered slot and shipped\"\n\n      attribute :reference, ConsignmentReference\n      attribute :number,    SlotNumber\n      attribute :item,      ItemLabel\n\n      emits ConsignmentRequested\n    end\n\n    command \"Ship\", from: \"requested\" do\n      role \"System\"\n      goal \"Mark the consignment shipped once its slot is filled\"\n\n      reference_to Consignment\n\n      emits ConsignmentShipped\n    end\n\n    command \"Cancel\", from: \"requested\" do\n      role \"System\"\n      goal \"Cancel a consignment whose slot could not be filled\"\n\n      reference_to Consignment\n\n      emits ConsignmentCancelled\n    end\n\n    query \"Requested\" do\n      description \"Consignments still awaiting a packed, shipped slot.\"\n      where(status: \"requested\")\n      order_by :reference\n    end\n  end\n\n  aggregate \"Manifest\" do\n    description \"One manifest, holding numbered slots the Packing saga fills one at a time.\"\n\n    identified_by :reference\n\n    attribute :reference, ManifestReference\n    attribute :slots,     list_of(Slot)\n\n    value_object \"ManifestReference\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a manifest is referenced\") { !value.to_s.empty? }\n    end\n\n    value_object \"SlotNumber\" do\n      attribute :value, Integer\n      invariant(\"a slot number is positive\") { value.positive? }\n    end\n\n    value_object \"ItemLabel\" do\n      attribute :text, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"an item is labeled\") { !text.to_s.empty? }\n    end\n\n    command \"Open\" do\n      role \"Loader\"\n      goal \"Open a manifest for a consignment\"\n\n      attribute :reference, ManifestReference\n\n      emits ManifestOpened\n    end\n\n    command \"AddSlot\" do\n      role \"Loader\"\n      goal \"Reserve a numbered slot on the manifest\"\n\n      reference_to Manifest\n      attribute :number, SlotNumber\n\n      sets :slots, append: { number: :number }\n\n      emits SlotAdded\n    end\n\n    # `Fill` on this nested entity is the saga's entity-level dispatch target.\n    entity \"Slot\" do\n      description \"One numbered slot on the manifest, filled with one item.\"\n\n      identified_by :number\n\n      attribute :number, SlotNumber\n      attribute :item,   ItemLabel, optional: true\n\n      command \"Fill\" do\n        role \"Loader\"\n        goal \"Load an item into the slot\"\n\n        attribute :item, ItemLabel\n\n        sets :item\n\n        emits SlotFilled\n      end\n\n      # Compensating half of `Fill`; runs when that saga leg refuses.\n      command \"Clear\" do\n        role \"Loader\"\n        goal \"Clear a slot's item back out — the compensating half of Fill\"\n\n        attribute :item, ItemLabel\n\n        sets :item\n\n        emits SlotCleared\n      end\n    end\n  end\n\n  # Correlates on the dotted scalar shared by every aggregate a leg touches.\n  process_manager \"Packing\" do\n    correlates_by :\"reference.value\"\n    starts_on Consignment::ConsignmentRequested\n    ends_on   Consignment::ConsignmentShipped\n\n    # Leg 1: aggregate-level dispatch on the starting event.\n    transition Consignment::ConsignmentRequested => \"packing\", from: \"packing\" do\n      dispatch Manifest::Open, with: { reference: :reference }\n    end\n\n    # Leg 2: aggregate-level dispatch.\n    transition Manifest::ManifestOpened => \"packing\", from: \"packing\" do\n      dispatch Manifest::AddSlot, with: { reference: :reference, number: :number }\n    end\n\n    # Leg 3: entity-level dispatch, with a compensating entity command.\n    transition Manifest::SlotAdded => \"filling\", from: \"packing\" do\n      dispatch Manifest::Slot::Fill, with: { number: :number, item: :item } do\n        compensates Manifest::Slot::Clear, with: { number: :number, item: :item }\n      end\n    end\n\n    # Happy path; ends the saga via ConsignmentShipped.\n    transition Manifest::SlotFilled => \"filled\", from: \"filling\" do\n      dispatch Consignment::Ship, with: { reference: :reference }\n    end\n\n    # Compensating leg: fires when leg 3 refuses.\n    transition :refused => \"cancelled\", from: \"filling\" do\n      dispatch Consignment::Cancel, with: { reference: :reference }\n    end\n  end\nend\n"
}