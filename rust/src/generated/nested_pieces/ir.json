  "source_text": "# Stress domain: entity \"Card\" nested inside entity \"Board\" inside \"Workspace\", two hops deep.\n# Pins that an invariant-failing addressing identity answers NotFound at both hops.\nHecks.bluebook \"NestedPieces\" do\n  vision \"A workspace holding boards, each holding cards — two real levels of entity nesting, stressing whether the addressing-identity-vs-existence ordering question (BUG#3) recurs at a hop this corpus has never actually reached before.\"\n\n  core\n\n  aggregate \"Workspace\" do\n    description \"A workspace holding boards; each board holds cards.\"\n\n    identified_by :reference\n\n    attribute :reference, WorkspaceReference\n    attribute :boards,    list_of(Board)\n\n    value_object \"WorkspaceReference\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a workspace is referenced\") { !value.to_s.empty? }\n    end\n\n    command \"Open\" do\n      role \"Owner\"\n      goal \"Start a workspace\"\n\n      attribute :reference, WorkspaceReference\n\n      emits \"WorkspaceOpened\"\n    end\n\n    command \"AddBoard\" do\n      role \"Owner\"\n      goal \"Add a board to the workspace\"\n\n      reference_to Workspace\n      attribute :number, BoardNumber\n\n      sets :boards, append: { number: :number }\n\n      emits \"BoardAdded\"\n    end\n\n    # Integer identity, not String: routing refuses a blank identity before coercion, so only a\n    # non-blank value like \"0\" can fail the invariant inside `element_of`.\n    value_object \"BoardNumber\" do\n      attribute :value, Integer\n      invariant(\"a board number is positive\") { value.positive? }\n    end\n\n    value_object \"BoardLabel\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a board label is not blank\") { !value.to_s.empty? }\n    end\n\n    value_object \"CardSequence\" do\n      attribute :value, Integer\n      invariant(\"a card sequence is positive\") { value.positive? }\n    end\n\n    value_object \"CardNote\" do\n      attribute :text, String\n    end\n\n    entity \"Board\" do\n      description \"One board in the workspace, holding cards.\"\n\n      identified_by :number\n\n      attribute :number, BoardNumber\n      attribute :label,  BoardLabel, optional: true\n      attribute :cards,  list_of(Card)\n\n      command \"AddCard\" do\n        role \"Owner\"\n        goal \"Add a card to the board\"\n\n        attribute :sequence, CardSequence\n\n        sets :cards, append: { sequence: :sequence }\n\n        emits \"CardAdded\"\n      end\n\n      # Hop one: a missing, invariant-failing `board.number` answers NotFound.\n      command \"Label\" do\n        role \"Owner\"\n        goal \"Label the board\"\n\n        attribute :label, BoardLabel\n\n        sets :label\n\n        emits \"BoardLabeled\"\n      end\n\n      # A piece nested inside a piece (ADR 0026): `locate_chain` walks a second hop to reach it.\n      entity \"Card\" do\n        description \"One card on the board, with a sequence that must be positive.\"\n\n        identified_by :sequence\n\n        attribute :sequence, CardSequence\n        attribute :note,     CardNote, optional: true\n\n        # Hop two: a missing, invariant-failing `card.sequence` answers NotFound.\n        command \"Annotate\" do\n          role \"Owner\"\n          goal \"Add a note to the card\"\n\n          attribute :note, CardNote\n\n          sets :note\n\n          emits \"CardAnnotated\"\n        end\n      end\n    end\n  end\nend\n"
}