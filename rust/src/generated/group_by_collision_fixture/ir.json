  "source_text": "# The smallest domain whose group_by can collide (ADR 0061, decision D1):\n# PartsByBin groups by a field two parts may share (dispatch-time refusal);\n# PartsByBinAndRef covers the identity and is always accepted.\nHecks.bluebook \"GroupByCollisionFixture\" do\n  vision \"The smallest domain where two rows can reach the same group_by key path, and one where they cannot.\"\n\n  core\n\n  aggregate \"Part\" do\n    description \"One stocked part, addressed by its own reference, kept in one bin.\"\n\n    identified_by :ref\n    attribute :ref, Ref\n    attribute :bin, Bin\n\n    value_object \"Ref\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a part is referenced\") { !value.to_s.empty? }\n    end\n\n    value_object \"Bin\" do\n      attribute :label, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a bin is labelled\") { !label.to_s.empty? }\n    end\n\n    command \"Stock\" do\n      role \"Clerk\"\n      goal \"Stock a part into a bin\"\n\n      attribute :ref, Ref\n      attribute :bin, Bin\n      sets :ref\n      sets :bin\n\n      emits \"PartStocked\"\n    end\n  end\n\n  read_model \"PartsByBin\" do\n    description \"Every part, nested by its bin; two parts in one bin refuse.\"\n    include Part\n    group_by :bin\n  end\n\n  read_model \"PartsByBinAndRef\" do\n    description \"Every part, nested by its bin and then its own reference; no two parts can collide.\"\n    include Part\n    group_by :bin, :ref\n  end\nend\n"
}