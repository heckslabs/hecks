  "source_text": "# Stress domain: a lease whose clock arrives as an Integer argument, fuzzed against Rust.\n# Neither runtime reads a wall clock at dispatch, so \"now\" has to be data.\nHecks.bluebook \"LeaseClock\" do\n  vision \"One lease slot, acquired, renewed, and reclaimed against a clock value that always arrives as a plain Integer argument — never read off the wall clock — so the same generated sequence produces the same answer whether it runs against Ruby or a compiled Rust binary with no clock of its own.\"\n\n  core\n\n  aggregate \"Lease\" do\n    description \"A lease slot: held by one caller until an explicitly-passed clock value moves past its own recorded expiry.\"\n\n    identified_by :key\n\n    attribute :key,        LeaseKey\n    attribute :holder,     LeaseHolder, optional: true\n    attribute :expires_at, LeaseInstant, default: { value: 0 }\n\n    value_object \"LeaseKey\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a lease is keyed\") { !value.to_s.empty? }\n    end\n\n    value_object \"LeaseHolder\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a holder is named\") { !value.to_s.empty? }\n    end\n\n    # The clock as data: every `now` and expiry is this Integer, never a clock read.\n    value_object \"LeaseInstant\" do\n      attribute :value, Integer, default: 0\n      invariant(\"a clock reading is not before the epoch\") { !value.negative? }\n    end\n\n    lifecycle :status, default: \"free\" do\n      transition \"Acquire\" => \"held\", from: [\"free\", \"held\"]\n      transition \"Renew\"   => \"held\", from: \"held\"\n      transition \"Release\" => \"free\", from: \"held\"\n      transition \"Reap\"    => \"free\", from: \"held\"\n    end\n\n    command \"Register\" do\n      role \"Operator\"\n      goal \"Register a lease slot before anyone can acquire it\"\n\n      attribute :key, LeaseKey\n\n      sets :key\n\n      emits \"LeaseRegistered\"\n    end\n\n    # `expiry` is named apart from the stored `expires_at` so no `given` resolves the wrong one.\n    command \"Acquire\" do\n      role \"Client\"\n      goal \"Take a free lease, or one whose recorded expiry a passed clock value has already passed\"\n\n      reference_to Lease\n      attribute :holder, LeaseHolder\n      attribute :now,    LeaseInstant\n      needs :now\n      attribute :expiry, LeaseInstant\n\n      given(\"a live lease is not taken from its own holder\") { status != \"held\" || expires_at.value <= now.value }\n      given(\"a lease's own new expiry is set after the moment it is acquired\") { expiry.value > now.value }\n\n      sets :holder\n      sets :expires_at, to: :expiry\n\n      emits \"LeaseAcquired\"\n    end\n\n    command \"Renew\" do\n      role \"Client\"\n      goal \"Extend a held lease's expiry, while it is still live\"\n\n      reference_to Lease\n      attribute :now,    LeaseInstant\n      needs :now\n      attribute :expiry, LeaseInstant\n\n      given(\"only a still-live lease is renewed\") { expires_at.value > now.value }\n      given(\"a renewal always extends the expiry, never shortens it\") { expiry.value > expires_at.value }\n\n      sets :expires_at, to: :expiry\n\n      emits \"LeaseRenewed\"\n    end\n\n    command \"Release\" do\n      role \"Client\"\n      goal \"Hand a held lease back, before or after its own expiry\"\n\n      reference_to Lease\n\n      emits \"LeaseReleased\"\n    end\n\n    command \"Reap\" do\n      role \"Operator\"\n      goal \"Reclaim a lease its own holder never released, once its recorded expiry has actually passed\"\n\n      reference_to Lease\n      attribute :now,   LeaseInstant\n      needs :now\n      # A grace period past the expiry; a caller who names none gives the holder none.\n      attribute :grace, LeaseInstant, default: { value: 0 }\n\n      given(\"only a lease whose own recorded expiry, plus any grace, the passed clock has reached is reaped\") do\n        expires_at.value + grace.value <= now.value\n      end\n\n      emits \"LeaseReaped\"\n    end\n\n    # The second `where` keeps this off the codegen skip for `authorize`/`tenant:`-only queries.\n    query \"Expired\" do\n      description \"Leases currently held whose own recorded expiry a passed clock value has already reached.\"\n      attribute :now, LeaseInstant\n      needs :now\n      where(status: \"held\")\n      where(:\"expires_at.value\" => { lte: :now })\n      order_by :key\n    end\n  end\nend\n"
}