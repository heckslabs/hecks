  "source_text": "# GENERATED by Hecks::Fuzzing::DomainGenerator — seed 1013, forms list_attr, multi_emit. Not hand-written; see bin/qa_generated_domains.\nHecks.bluebook \"GeneratedRouteAppend\" do\n  vision \"A generated domain that puts list_attr and multi_emit together.\"\n\n  core\n\n  aggregate \"Hangar\" do\n    description \"A generated hangar.\"\n\n    identified_by :code\n    attribute :code, HangarCode\n\n    value_object \"HangarCode\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a HangarCode is not blank\") { !value.to_s.empty? }\n    end\n\n    value_object \"HangarTag\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a HangarTag is not blank\") { !value.to_s.empty? }\n    end\n\n    value_object \"HangarPriority\" do\n      attribute :value, String, one_of: [\"red\", \"amber\", \"green\"]\n    end\n\n    value_object \"HangarScore\" do\n      attribute :value, Integer\n    end\n\n    command \"Open\" do\n      goal \"Open it\"\n      attribute :code, HangarCode\n      sets :code\n      emits \"HangarOpened\"\n    end\n\n    command \"Retag\" do\n      goal \"Retag it\"\n      reference_to Hangar\n      attribute :tags, list_of(HangarTag)\n      emits \"HangarRetaged\"\n    end\n\n    command \"Prioritize\" do\n      goal \"Prioritize it\"\n      reference_to Hangar\n      attribute :priority, HangarPriority\n      emits \"HangarPrioritized\"\n    end\n\n    command \"Rescore\" do\n      goal \"Rescore it\"\n      reference_to Hangar\n      attribute :amount, HangarScore\n      emits \"HangarRescored\"\n    end\n  end\n\n  aggregate \"Kiosk\" do\n    description \"A generated kiosk.\"\n\n    identified_by :code\n    attribute :code, KioskCode\n    attribute :lines, list_of(Line)\n\n    value_object \"KioskCode\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a KioskCode is not blank\") { !value.to_s.empty? }\n    end\n\n    value_object \"KioskPriority\" do\n      attribute :value, String, one_of: [\"low\", \"high\"]\n    end\n\n    value_object \"KioskScore\" do\n      attribute :value, Integer\n    end\n\n    value_object \"LineSequence\" do\n      attribute :value, Integer\n      invariant(\"a LineSequence is positive\") { value.positive? }\n    end\n\n    value_object \"LineLabel\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a LineLabel is not blank\") { !value.to_s.empty? }\n    end\n\n    lifecycle :status, default: \"open\" do\n      transition \"Close\" => \"closed\", from: \"open\"\n      transition \"Reopen\" => \"open\", from: \"closed\"\n    end\n\n    entity \"Line\" do\n      description \"A generated line.\"\n      identified_by :sequence\n      attribute :sequence, LineSequence\n      attribute :label, LineLabel, optional: true\n\n      command \"Label\" do\n        goal \"Label it\"\n        attribute :label, LineLabel\n        sets :label\n        emits \"LineLabeled\"\n      end\n    end\n\n    command \"Open\" do\n      goal \"Open it\"\n      attribute :code, KioskCode\n      sets :code\n      emits \"KioskOpened\"\n    end\n\n    command \"Close\" do\n      goal \"Close it\"\n      reference_to Kiosk\n      emits \"KioskClosed\"\n    end\n\n    command \"Reopen\" do\n      goal \"Reopen it\"\n      reference_to Kiosk\n      emits \"KioskReopened\"\n    end\n\n    command \"Prioritize\" do\n      role \"Clerk\"\n      goal \"Prioritize it\"\n      reference_to Kiosk\n      attribute :priority, KioskPriority\n      emits \"KioskPrioritized\"\n    end\n\n    command \"Rescore\" do\n      role \"Manager\"\n      goal \"Rescore it\"\n      reference_to Kiosk\n      attribute :amount, KioskScore\n      emits \"KioskRescored\"\n    end\n\n    command \"AddLine\" do\n      role \"Manager\"\n      goal \"AddLine it\"\n      reference_to Kiosk\n      attribute :sequence, LineSequence\n      sets :lines, append: { sequence: :sequence }\n      emits \"LineAdded\"\n    end\n\n    query \"Listed\" do\n      description \"Generated Listed.\"\n      where(:\"status\" => \"open\")\n      order_by :code\n    end\n  end\nend\n"
