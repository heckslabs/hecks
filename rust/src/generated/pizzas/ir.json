  "source_text": "Hecks.bluebook \"Pizzas\" do\n  vision \"Put toppings on a pizza and sell it to a customer.\"\n  supporting\n\n  aggregate \"Order\" do\n    description \"An order that gathers toppings on a pizza and is eventually sold to a customer.\"\n\n    attribute :name,          PizzaName\n    attribute :pizza,         Pizza\n    attribute :toppings,      list_of(Topping)\n    # OPTIONAL — Wave 8 fix: genuinely unknown until `Purchase` (below)\n    # sets it; no pizza has a buyer's name at CreatePizza time. The same\n    # DSL knob `ATMCard`'s own `nickname` (banking) already uses for the\n    # identical \"not known until later\" shape.\n    attribute :customer_name, CustomerName, optional: true\n\n    identified_by :name\n\n    value_object \"PizzaName\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n\n      invariant(\"a pizza is named\") { !value.to_s.empty? }\n    end\n\n    value_object \"Price\" do\n      attribute :cents, Integer\n\n      invariant(\"a price is never negative\") { cents >= 0 }\n    end\n\n    value_object \"CustomerName\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n\n      invariant(\"a customer is named\") { !value.to_s.empty? }\n    end\n\n    value_object \"ToppingName\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n\n      invariant(\"a topping is named\") { !value.to_s.empty? }\n    end\n\n    value_object \"ToppingAmount\" do\n      attribute :value, Integer\n\n      invariant(\"an amount is positive\") { value.positive? }\n    end\n\n    value_object \"Topping\" do\n      attribute :name,   String, pattern: '[^ \\t\\n\\r]'\n      attribute :amount, Integer\n    end\n\n    # A NAMED, REUSABLE closed set — its own sibling value object, the same\n    # shape LedgerDirection/AccountKind use in the banking corpus, not the\n    # `attribute :size, one_of(...)` shorthand (which synthesises an\n    # ANONYMOUS value object and only reads naturally directly on an\n    # aggregate/entity/command attribute, unchanged by S3). `one_of:` is\n    # the field's own keyword here (ADR 0025's \"closed sets lose the\n    # wrapper block\") — before it existed, the inline shorthand genuinely\n    # could not be spelled inside a `value_object` block at all: it\n    # desugars by calling `one_of` on the enclosing builder, and a nested\n    # `value_object` already had its OWN differently-shaped `one_of`\n    # (the now-removed `one_of do member ... end` wrapper), so the two\n    # collided with a wrong-arity ArgumentError.\n    value_object \"Size\" do\n      attribute :value, String, one_of: [\"small\", \"large\"]\n    end\n\n    # WHAT WAS ORDERED, not who ordered it or whether it's been paid for —\n    # those live on Order itself, which has the identity and lifecycle a\n    # pizza never needed. Two large Margheritas with the same toppings are\n    # interchangeable value, exactly what a value object means.\n    value_object \"Pizza\" do\n      attribute :price_cents, Price\n      attribute :size,        Size\n    end\n\n    lifecycle :status, default: \"available\" do\n      transition \"Purchase\" => \"sold\", from: \"available\"\n    end\n\n    query \"Available\" do\n      where(status: \"available\")\n      order_by :name\n    end\n\n    # BOTH price queries reach through the nested Pizza value object with a\n    # dotted path — the shape that could not be asked at all when Pizza\n    # first became a value object. They were dropped then rather than\n    # answered wrongly; QuerySpecification::FieldPath is what let them\n    # return: one walk shared by the reference interpreter, both SQL\n    # dialects, and the build seal, so a nested ask answers identically\n    # everywhere or refuses to build.\n    query \"CostingLessThan\" do\n      attribute :ceiling, Price\n      where(:\"pizza.price_cents.cents\" => { lt: :ceiling })\n      order_by :name\n    end\n\n    # A LITERAL, not a kwarg — CostingLessThan's :ceiling is always resolved\n    # from the caller's args before it ever reaches the comparator, so it\n    # never exercised the literal-value path: a where-clause's own number\n    # is stringified when the query is declared (\"1000\", not 1000), and\n    # gt/gte/lte were never implemented against it at all until this query\n    # gave the corpus something to disagree about.\n    query \"Expensive\" do\n      where(:\"pizza.price_cents.cents\" => { gt: 1000 })\n      order_by :name\n    end\n\n    command \"CreatePizza\" do\n      role \"Chef\"\n      goal \"Put a new pizza on the menu\"\n\n      attribute :name,  PizzaName\n      attribute :pizza, Pizza\n\n      # Wave 8 fix — both already declared, required command attributes,\n      # never written: CreatePizza had zero mutations at all, so every\n      # created Order's own :name/:pizza came back nil regardless of\n      # what the caller sent.\n      sets :name\n      sets :pizza\n\n      emits PizzaCreated\n    end\n\n    # LIFECYCLE STATE AS A COMMAND GUARD (S10, ADR 0025) — `AddTopping`\n    # has no matching `transition` (customizing a pizza doesn't move its\n    # own state), so `from:` is the only thing gating it. `Purchase`\n    # DOES match the `transition` above; its own `from:` here is\n    # redundant with `admissible_transition` in the harmless direction.\n    command \"AddTopping\", from: \"available\" do\n      role \"Chef\"\n      goal \"Customize a pizza with an ingredient\"\n\n      reference_to Order\n      attribute :topping, ToppingName\n      attribute :amount, ToppingAmount\n\n      given(\"at most 10 toppings\")            { toppings.size < 10 }\n\n      sets :toppings, append: { name: :topping, amount: :amount }\n\n      emits ToppingAdded\n    end\n\n    command \"Purchase\", from: \"available\" do\n      role \"Customer\"\n      goal \"Buy the pizza\"\n\n      reference_to Order\n      attribute :amount, Price\n\n      given(\"a pizza needs at least one topping\") { toppings.size.positive? }\n      given(\"a payment was actually made\")         { amount.cents.positive? }\n      # NOT re-deciding WHETHER a payment happened — that's the external\n      # fact the comment below this command explains. This checks the\n      # fact ITSELF makes sense: an underpayment arriving from upstream\n      # (a data-entry error, a stale price quoted before an increase, a\n      # malformed webhook) shouldn't mark the pizza sold any more than a\n      # payment for an already-sold pizza should.\n      given(\"the payment covers the price\") { amount.cents >= pizza.price_cents.cents }\n\n      sets :customer_name\n      sets :status,        to: \"sold\"\n\n      emits PizzaPurchased\n    end\n  end\n\n  # A PAYMENT ARRIVING IS AN EXTERNAL FACT, NOT A DECISION THIS DOMAIN MAKES —\n  # the actual business rules (must have a topping, must still be available)\n  # stay on Purchase itself, reached only through this. See\n  # pizzas.hecksagon for the port this reacts to.\n  policy \"OnPizzaPaymentReceived\" do\n    on Order::PizzaPaymentReceived\n    trigger Order::Purchase\n  end\nend\n"
}