  "source_text": "# GENERATED by Hecks::Fuzzing::DomainGenerator — seed 1002, forms has_query, has_entity. Not hand-written; see bin/qa_generated_domains.\nHecks.bluebook \"GeneratedReactionWording\" do\n  vision \"A generated domain that puts has_query and has_entity together.\"\n\n  core\n\n  aggregate \"Desk\" do\n    description \"A generated desk.\"\n\n    identified_by :code\n    attribute :code, DeskCode\n\n    value_object \"DeskCode\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a DeskCode is not blank\") { !value.to_s.empty? }\n    end\n\n    value_object \"LineSequence\" do\n      attribute :value, Integer\n      invariant(\"a LineSequence is positive\") { value.positive? }\n    end\n\n    value_object \"LineLabel\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a LineLabel is not blank\") { !value.to_s.empty? }\n    end\n\n    value_object \"DeskScore\" do\n      attribute :value, Integer\n    end\n\n    lifecycle :status, default: \"open\" do\n      transition \"Close\" => \"closed\", from: \"open\"\n    end\n\n    command \"Open\" do\n      goal \"Open it\"\n      reference_to Parcel\n      attribute :code, DeskCode\n      sets :code\n      emits \"DeskOpened\"\n    end\n\n    command \"Close\" do\n      goal \"Close it\"\n      reference_to Desk\n      emits \"DeskClosed\"\n    end\n  end\n\n  aggregate \"Parcel\" do\n    description \"A generated parcel.\"\n\n    identified_by :code\n    attribute :code, ParcelCode\n\n    value_object \"ParcelCode\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a ParcelCode is not blank\") { !value.to_s.empty? }\n    end\n\n    value_object \"ParcelPriority\" do\n      attribute :value, String, one_of: [\"draft\", \"final\"]\n    end\n\n    value_object \"ParcelNote\" do\n      attribute :value, String, pattern: '[^ \\t\\n\\r]'\n      invariant(\"a ParcelNote is not blank\") { !value.to_s.empty? }\n    end\n\n    command \"Open\" do\n      goal \"Open it\"\n      attribute :code, ParcelCode\n      sets :code\n      emits \"ParcelOpened\"\n    end\n\n    command \"Annotate\" do\n      goal \"Annotate it\"\n      reference_to Parcel\n      attribute :note, ParcelNote, optional: true\n      emits \"ParcelAnnotated\"\n    end\n  end\n\n  policy \"OnDeskOpenedClose\" do\n    on Desk::DeskOpened\n    trigger Desk::Close\n  end\nend\n"
