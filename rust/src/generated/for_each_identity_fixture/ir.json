  "source_text": "# Pins a `for_each` policy whose query argument is the emitting aggregate's identity head. Cancel\n# references its own record and emits an event with an empty payload, so the record's id is the\n# only thing that can answer the query's `registration_id`.\n#\n# Dispatched against both engines by\n# spec/corpus/rust_conformance/for_each_identity_lent_to_query.json\nHecks.bluebook \"ForEachIdentityFixture\" do\n  vision \"The smallest domain whose cancellation settles the refunds still tracking its own registration.\"\n\n  core\n\n  aggregate \"Registration\" do\n    description \"A registration, cancelled by naming its own record.\"\n\n    identified_by :registration_id\n\n    attribute :registration_id, RegistrationId\n\n    value_object \"RegistrationId\" do\n      attribute :value, String\n    end\n\n    lifecycle :status, default: \"open\" do\n      transition \"Cancel\" => \"cancelled\", from: \"open\"\n    end\n\n    command \"Open\" do\n      goal \"Open a registration\"\n\n      attribute :registration_id, RegistrationId\n\n      sets :registration_id\n\n      emits \"RegistrationOpened\"\n    end\n\n    command \"Cancel\", from: \"open\" do\n      goal \"Cancel a registration\"\n\n      reference_to Registration\n\n      emits \"RegistrationCancelled\"\n    end\n  end\n\n  aggregate \"Refund\" do\n    description \"A refund tracked against a registration until it is settled.\"\n\n    identified_by :refund_id\n\n    attribute :refund_id, RefundId\n    attribute :registration_id, RegistrationId\n\n    value_object \"RefundId\" do\n      attribute :value, String\n    end\n\n    value_object \"RegistrationId\" do\n      attribute :value, String\n    end\n\n    lifecycle :status, default: \"tracking\" do\n      transition \"Settle\" => \"settled\", from: \"tracking\"\n    end\n\n    command \"Track\" do\n      goal \"Track a refund against a registration\"\n\n      attribute :refund_id, RefundId\n      attribute :registration_id, RegistrationId\n\n      sets :refund_id\n      sets :registration_id\n\n      emits \"RefundTracked\"\n    end\n\n    command \"Settle\", from: \"tracking\" do\n      goal \"Settle a tracked refund\"\n\n      reference_to Refund\n\n      emits \"RefundSettled\"\n    end\n\n    query \"Tracking\" do\n      attribute :registration_id, RegistrationId\n      where(registration_id: :registration_id, status: \"tracking\")\n    end\n  end\n\n  # The event carries nothing, so the query's `registration_id` is lent from the cancelled\n  # registration's own id.\n  policy \"SettleRefundOnCancel\" do\n    on \"RegistrationCancelled\"\n    for_each \"Refund.Tracking\"\n    trigger Refund::Settle\n  end\nend\n"
}