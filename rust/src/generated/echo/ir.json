  "source_text": "Hecks.bluebook \"Echo\" do\n  # A CORPUS-OWNED DOMAIN (docs/semantics/bluebook-semantics.md, C10.4).\n  # One policy that answers its own command's event with the same command, so a single Ping\n  # starts a chain that never ends on its own. The reaction depth bound is the only thing that\n  # stops it: five reactions below the root run, the sixth is recorded undelivered.\n  vision \"A ping is answered by another ping, until the reaction depth bound says enough.\"\n  core\n\n  aggregate \"Beacon\" do\n    identified_by :name\n\n    attribute :name, Name\n\n    value_object \"Name\" do\n      attribute :value, String\n    end\n\n    command \"Light\" do\n      goal \"Light a beacon\"\n      attribute :name, Name\n      emits \"BeaconLit\"\n    end\n\n    command \"Ping\" do\n      goal \"Ping a beacon, which makes the beacon ping again\"\n      reference_to Beacon\n      emits \"Pinged\"\n    end\n\n    policy \"PingAgain\" do\n      on      \"Pinged\"\n      trigger Beacon::Ping\n    end\n  end\n\n  # THE SAME BOUND, SEEN FROM A SAGA (C10.4). A lamp flickers into another flicker forever. The\n  # saga marks the lamp when it is lit, and that mark is compensable; the flicker the sixth\n  # reaction announces reaches the saga at the ceiling, so its leg is refused and the saga\n  # unwinds. The compensation is itself a reaction at that depth, so it is refused as well.\n  aggregate \"Lamp\" do\n    identified_by :name\n\n    attribute :name, Name\n\n    value_object \"Name\" do\n      attribute :value, String\n    end\n\n    command \"Install\" do\n      goal \"Install a lamp\"\n      attribute :name, Name\n      emits \"LampInstalled\"\n    end\n\n    command \"Light\" do\n      goal \"Light a lamp\"\n      reference_to Lamp\n      emits \"Lit\"\n    end\n\n    command \"Flicker\" do\n      goal \"Flicker a lamp, which makes the lamp flicker again\"\n      reference_to Lamp\n      emits \"Flickered\"\n    end\n\n    command \"Mark\" do\n      goal \"Mark a flicker as seen\"\n      reference_to Lamp\n      emits \"Marked\"\n    end\n\n    command \"Unmark\" do\n      goal \"Take back a mark\"\n      reference_to Lamp\n      emits \"Unmarked\"\n    end\n\n    command \"Retire\" do\n      goal \"Retire a lamp\"\n      reference_to Lamp\n      emits \"LampRetired\"\n    end\n\n    policy \"FlickerAgain\" do\n      on      \"Flickered\"\n      trigger Lamp::Flicker\n    end\n  end\n\n  process_manager \"Watch\" do\n    correlates_by :\"name.value\"\n    starts_on \"LampInstalled\"\n    ends_on   \"LampRetired\"\n\n    transition \"Lit\" => \"lit\", from: \"installed\" do\n      dispatch Lamp::Mark, with: { lamp: :name } do\n        compensates Lamp::Unmark, with: { lamp: :name }\n      end\n    end\n\n    transition \"Flickered\" => \"flickering\", from: \"lit\" do\n      dispatch Lamp::Mark, with: { lamp: :name }\n    end\n\n    transition :refused => \"unwound\", from: \"flickering\" do\n      dispatch Lamp::Retire, with: { lamp: :name }\n    end\n  end\nend\n"
