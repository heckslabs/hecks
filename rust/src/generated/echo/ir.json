  ],
  "source_text": "Hecks.bluebook \"Echo\" do\n  # A CORPUS-OWNED DOMAIN (docs/semantics/bluebook-semantics.md, C10.4).\n  # One policy that answers its own command's event with the same command, so a single Ping\n  # starts a chain that never ends on its own. The reaction depth bound is the only thing that\n  # stops it: five reactions below the root run, the sixth is recorded undelivered.\n  vision \"A ping is answered by another ping, until the reaction depth bound says enough.\"\n  core\n\n  aggregate \"Beacon\" do\n    identified_by :name\n\n    attribute :name, Name\n\n    value_object \"Name\" do\n      attribute :value, String\n    end\n\n    command \"Light\" do\n      goal \"Light a beacon\"\n      attribute :name, Name\n      emits \"BeaconLit\"\n    end\n\n    command \"Ping\" do\n      goal \"Ping a beacon, which makes the beacon ping again\"\n      reference_to Beacon\n      emits \"Pinged\"\n    end\n\n    policy \"PingAgain\" do\n      on      \"Pinged\"\n      trigger Beacon::Ping\n    end\n  end\n\n  # THE SAME BOUND, SEEN FROM A SAGA (C10.4). A lamp flickers into another flicker forever. The\n  # saga marks the lamp when it is lit, and that mark is compensable; the flicker the sixth\n  # reaction announces reaches the saga at the ceiling, so its leg is refused and the saga\n  # unwinds. The compensation is itself a reaction at that depth, so it is refused as well.\n  aggregate \"Lamp\" do\n    identified_by :name\n\n    attribute :name, Name\n\n    value_object \"Name\" do\n      attribute :value, String\n    end\n\n    command \"Install\" do\n      goal \"Install a lamp\"\n      attribute :name, Name\n      emits \"LampInstalled\"\n    end\n\n    command \"Light\" do\n      goal \"Light a lamp\"\n      reference_to Lamp\n      emits \"Lit\"\n    end\n\n    command \"Flicker\" do\n      goal \"Flicker a lamp, which makes the lamp flicker again\"\n      reference_to Lamp\n      emits \"Flickered\"\n    end\n\n    command \"Mark\" do\n      goal \"Mark a flicker as seen\"\n      reference_to Lamp\n      emits \"Marked\"\n    end\n\n    command \"Unmark\" do\n      goal \"Take back a mark\"\n      reference_to Lamp\n      emits \"Unmarked\"\n    end\n\n    command \"Retire\" do\n      goal \"Retire a lamp\"\n      reference_to Lamp\n      emits \"LampRetired\"\n    end\n\n    policy \"FlickerAgain\" do\n      on      \"Flickered\"\n      trigger Lamp::Flicker\n    end\n  end\n\n  # One level below the bound (C10.4): a strike sets off four reactions, so Burnt comes at depth\n  # four; the Blow it dispatches runs fifth and is refused (a fuse blows only unarmed), so the saga\n  # unwinds under the ceiling and its Unprime and Scrap still run.\n  aggregate \"Fuse\" do\n    identified_by :name\n\n    attribute :name, Name\n\n    value_object \"Name\" do\n      attribute :value, String\n    end\n\n    lifecycle :status, default: \"laid\" do\n      transition \"Arm\"  => \"armed\", from: \"laid\"\n      transition \"Blow\" => \"blown\", from: \"laid\"\n      mark :rests, \"laid\"\n      mark :terminal, \"armed\", \"blown\"\n    end\n\n    command \"Lay\" do\n      goal \"Lay a fuse\"\n      attribute :name, Name\n      emits \"FuseLaid\"\n    end\n\n    command \"Arm\" do\n      goal \"Arm a fuse\"\n      reference_to Fuse\n      emits \"Armed\"\n    end\n\n    command \"Prime\" do\n      goal \"Prime an armed fuse\"\n      reference_to Fuse\n      emits \"Primed\"\n    end\n\n    command \"Unprime\" do\n      goal \"Take back a priming\"\n      reference_to Fuse\n      emits \"Unprimed\"\n    end\n\n    command \"Strike\" do\n      goal \"Strike a fuse, which sparks, hisses, glows and burns\"\n      reference_to Fuse\n      emits \"Struck\"\n    end\n\n    command \"Spark\" do\n      goal \"Spark a struck fuse\"\n      reference_to Fuse\n      emits \"Sparked\"\n    end\n\n    command \"Hiss\" do\n      goal \"Hiss a sparked fuse\"\n      reference_to Fuse\n      emits \"Hissed\"\n    end\n\n    command \"Glow\" do\n      goal \"Glow a hissing fuse\"\n      reference_to Fuse\n      emits \"Glowed\"\n    end\n\n    command \"Burn\" do\n      goal \"Burn a glowing fuse\"\n      reference_to Fuse\n      emits \"Burnt\"\n    end\n\n    command \"Blow\" do\n      goal \"Blow a fuse that was never armed\"\n      reference_to Fuse\n      emits \"Blown\"\n    end\n\n    command \"Scrap\" do\n      goal \"Scrap a fuse that would not blow\"\n      reference_to Fuse\n      emits \"Scrapped\"\n    end\n\n    policy \"SparkOnStrike\" do\n      on      \"Struck\"\n      trigger Fuse::Spark\n    end\n\n    policy \"HissOnSpark\" do\n      on      \"Sparked\"\n      trigger Fuse::Hiss\n    end\n\n    policy \"GlowOnHiss\" do\n      on      \"Hissed\"\n      trigger Fuse::Glow\n    end\n\n    policy \"BurnOnGlow\" do\n      on      \"Glowed\"\n      trigger Fuse::Burn\n    end\n  end\n\n  process_manager \"Charge\" do\n    correlates_by :\"name.value\"\n    starts_on \"FuseLaid\"\n    ends_on   \"Scrapped\"\n\n    transition \"Armed\" => \"armed\", from: \"laid\" do\n      dispatch Fuse::Prime, with: { fuse: :name } do\n        compensates Fuse::Unprime, with: { fuse: :name }\n      end\n    end\n\n    transition \"Burnt\" => \"burning\", from: \"armed\" do\n      dispatch Fuse::Blow, with: { fuse: :name }\n    end\n\n    transition :refused => \"fizzled\", from: \"burning\" do\n      dispatch Fuse::Scrap, with: { fuse: :name }\n    end\n  end\n\n  process_manager \"Watch\" do\n    correlates_by :\"name.value\"\n    starts_on \"LampInstalled\"\n    ends_on   \"LampRetired\"\n\n    transition \"Lit\" => \"lit\", from: \"installed\" do\n      dispatch Lamp::Mark, with: { lamp: :name } do\n        compensates Lamp::Unmark, with: { lamp: :name }\n      end\n    end\n\n    transition \"Flickered\" => \"flickering\", from: \"lit\" do\n      dispatch Lamp::Mark, with: { lamp: :name }\n    end\n\n    transition :refused => \"unwound\", from: \"flickering\" do\n      dispatch Lamp::Retire, with: { lamp: :name }\n    end\n  end\nend\n"
}