package hecks:adapters@0.1.0;

interface secrets {
  /// Why the host would not answer: the grant does not name it, or the lookup itself failed.
  variant refusal {
    /// The component asked for something its grant does not declare; carries the name asked.
    undeclared(string),
    /// The grant allows it but the host could not carry it out; carries the reason.
    failed(string),
  }

  /// The value of the secret `name`, or none when the host holds no such value.
  get: func(name: string) -> result<option<string>, refusal>;
}
