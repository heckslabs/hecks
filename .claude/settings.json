{
  "permissions": {
    "deny": [
      "Bash(ruby:*)",
      "Bash(irb:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(perl:*)",
      "Bash(php:*)",
      "Bash(lua:*)",
      "Bash(bundle exec ruby:*)",
      "Bash(bundle exec irb:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(sh -c:*)",
      "Bash(bash -c:*)",
      "Bash(zsh -c:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "hook=\"${CLAUDE_PROJECT_DIR:-$(pwd)}/.claude/hooks/rubocop_post_edit.sh\"; [ -x \"$hook\" ] || exit 0; exec \"$hook\""
          }
        ]
      }
    ]
  }
}
