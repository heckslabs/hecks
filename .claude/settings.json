{
  "permissions": {
    "deny": [
      "Bash(ruby:*)",
      "Bash(irb:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(perl:*)",
      "Bash(php:*)",
      "Bash(lua:*)",
      "Bash(bundle exec ruby:*)",
      "Bash(bundle exec irb:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(sh -c:*)",
      "Bash(bash -c:*)",
      "Bash(zsh -c:*)"
    ],
    "allow": [
      "Bash(claude agents *)",
      "Bash(exe/hecks RedFlag.status*)",
      "Bash(exe/hecks agent_run.running*)",
      "Bash(exe/hecks agent_run.tidyable*)",
      "Bash(exe/hecks agents PlanReview.reviews*)",
      "Bash(exe/hecks style_run.check_comments! *)",
      "Bash(exe/hecks tickets Finding.open*)",
      "Bash(exe/hecks tickets Work.undone*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; hook=\"$d/.claude/hooks/orchestrator_guard.sh\"; [ -x \"$hook\" ] || exit 0; exec \"$hook\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\"; hook=\"$d/.claude/hooks/rubocop_post_edit.sh\"; [ -x \"$hook\" ] || exit 0; exec \"$hook\""
          }
        ]
      }
    ]
  }
}
