# Rekeys Directory's Member from `name` to `email`: `compute` sets the value, `rekey` the id.
# Both share one expression because Lineage#translate never touches an entry's id, only its state.
Hecks.data_translation "Directory", from: "dffb74", to: "632545" do
  aggregate "Member" do
    compute "name", to: "email",
            sql: "lower(regexp_replace((__s -> 'name') ->> 'value', '\\s+', '.', 'g')) || '@example.com'"
    rekey sql: "lower(regexp_replace((__s -> 'name') ->> 'value', '\\s+', '.', 'g')) || '@example.com'"
  end
end
