# Rekeys Directory's Member from `name` to `email`: `derive` computes the address from the name,
# `rekey_to` takes the id from it, and `drop` removes the name the address came from.
Hecks.data_translation "Directory", from: "dffb74", to: "632545" do
  aggregate "Member" do
    derive "email.value", as: 'concat(lower(replace(name.value, " ", ".")), "@example.com")'
    rekey_to "email.value"
    drop :name
  end
end
