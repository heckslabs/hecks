Hecks.behaviors "Pizzas" do
  vision "Examples of how a pizza is built, sold, and found through this domain."

  # `pizzas_behaviors.hecksagon` is a Memory-persisted sibling of
  # `pizzas.hecksagon` that lives OUTSIDE bluebook/, so an ordinary
  # directory boot of examples/pizzas never globs it up alongside the
  # real one.
  loads "pizzas.bluebook", "../pizzas_behaviors.hecksagon"

  test "CreatePizza puts a fresh pizza on the menu, available for sale" do
    tests "CreatePizza", on: "Order"
    input  name: "Margherita", pizza: { price_cents: { cents: 1200 }, size: "large" }
    expect status: "available", customer_name: nil
  end

  test "AddTopping refuses more than ten toppings" do
    tests "AddTopping", on: "Order"
    setup  "CreatePizza", name: "Loaded", pizza: { price_cents: { cents: 1500 }, size: "large" }
    setup  "AddTopping",  name: "Loaded", topping: "Basil",     amount: 1
    setup  "AddTopping",  name: "Loaded", topping: "Olives",    amount: 1
    setup  "AddTopping",  name: "Loaded", topping: "Mushroom",  amount: 1
    setup  "AddTopping",  name: "Loaded", topping: "Onion",     amount: 1
    setup  "AddTopping",  name: "Loaded", topping: "Pepper",    amount: 1
    setup  "AddTopping",  name: "Loaded", topping: "Sausage",   amount: 1
    setup  "AddTopping",  name: "Loaded", topping: "Bacon",     amount: 1
    setup  "AddTopping",  name: "Loaded", topping: "Pineapple", amount: 1
    setup  "AddTopping",  name: "Loaded", topping: "Anchovy",   amount: 1
    setup  "AddTopping",  name: "Loaded", topping: "Jalapeno",  amount: 1
    input  name: "Loaded", topping: "Extra Cheese", amount: 1
    expect refused: "at most 10 toppings"
  end

  test "Purchase refuses a pizza with no toppings on it" do
    tests "Purchase", on: "Order"
    setup  "CreatePizza", name: "Bare", pizza: { price_cents: { cents: 900 }, size: "small" }
    input  name: "Bare", customer_name: "Chris", amount: { cents: 900 }
    expect refused: "at least one topping"
  end

  test "Purchase sells the pizza and closes its lifecycle" do
    tests "Purchase", on: "Order"
    setup  "CreatePizza", name: "Sold Out", pizza: { price_cents: { cents: 1200 }, size: "large" }
    setup  "AddTopping",  name: "Sold Out", topping: "Basil", amount: 2
    input  name: "Sold Out", customer_name: "Chris", amount: { cents: 1200 }
    expect emits: ["PizzaPurchased"]
  end

  test "Purchase refuses a payment that does not cover the price" do
    tests "Purchase", on: "Order"
    setup  "CreatePizza", name: "Underpaid", pizza: { price_cents: { cents: 1200 }, size: "large" }
    setup  "AddTopping",  name: "Underpaid", topping: "Basil", amount: 1
    input  name: "Underpaid", customer_name: "Chris", amount: { cents: 500 }
    expect refused: "the payment covers the price"
  end

  # The processor's way in: the port only announces the payment, and OnPizzaPaymentReceived
  # carries it to Purchase, whose rules decide whether the pizza sells.
  test "a payment received through the gateway sells the pizza" do
    tests "Pizzas::Order.PaymentGateway.Receive"
    setup  "CreatePizza", name: "Paid For", pizza: { price_cents: { cents: 1200 }, size: "large" }
    setup  "AddTopping",  name: "Paid For", topping: "Basil", amount: 1
    input  to: "Paid For", with: { customer_name: { value: "Chris" }, amount: { cents: 1200 } }
    expect emits: ["PizzaPaymentReceived", "PizzaPurchased"]
  end

  test "an underpayment through the gateway is recorded, but sells nothing" do
    tests "Pizzas::Order.PaymentGateway.Receive"
    setup  "CreatePizza", name: "Short", pizza: { price_cents: { cents: 1200 }, size: "large" }
    setup  "AddTopping",  name: "Short", topping: "Basil", amount: 1
    input  to: "Short", with: { customer_name: { value: "Chris" }, amount: { cents: 500 } }
    expect emits: ["PizzaPaymentReceived"]
  end

  test "a payment through the gateway for a pizza with no toppings sells nothing" do
    tests "Pizzas::Order.PaymentGateway.Receive"
    setup  "CreatePizza", name: "Plain", pizza: { price_cents: { cents: 900 }, size: "small" }
    input  to: "Plain", with: { customer_name: { value: "Chris" }, amount: { cents: 900 } }
    expect emits: ["PizzaPaymentReceived"]
  end

  test "a sold pizza is no longer Available" do
    tests "Available", on: "Order", kind: :query
    setup  "CreatePizza", name: "Fresh",     pizza: { price_cents: { cents: 1000 }, size: "small" }
    setup  "CreatePizza", name: "Also Sold", pizza: { price_cents: { cents: 1100 }, size: "small" }
    setup  "AddTopping",  name: "Also Sold", topping: "Basil", amount: 1
    setup  "Purchase",    name: "Also Sold", customer_name: "Chris", amount: { cents: 1100 }
    expect count: 1
  end

  test "CostingLessThan finds a pizza under the ceiling named" do
    tests "CostingLessThan", on: "Order", kind: :query
    setup  "CreatePizza", name: "Bargain", pizza: { price_cents: { cents: 800 }, size: "small" }
    setup  "CreatePizza", name: "Splurge", pizza: { price_cents: { cents: 1800 }, size: "large" }
    input  ceiling: { cents: 1000 }
    expect count: 1
  end

  test "Available's own row can be checked directly, not just counted" do
    tests "Available", on: "Order", kind: :query
    setup  "CreatePizza", name: "Only One", pizza: { price_cents: { cents: 950 }, size: "small" }
    expect status: "available", name: { value: "Only One" }
  end
end
