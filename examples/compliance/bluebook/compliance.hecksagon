Hecks.hecksagon "Compliance" do
  # Every command here declares `role "Compliance officer"` — only real
  # access control once Governance can check it against something (S8).
  # A genuine standalone deploy (this domain's own Lambda, per this
  # file's own header two files up), so this attaches AND binds
  # Governance itself, the same sibling shape banking.hecksagon uses.
  uses_framework "Governance"

  # NO PER-AGGREGATE BINDS — compliance.world's own `default_adapter
  # "PostgresEra"` binds every aggregate this hecksagon leaves out, so
  # AccountFreezeReview, BoxSurrenderReview and PrivacyReview all persist
  # there without a line each.
end

# Governance binds Memory explicitly, which wins over compliance.world's
# `default_adapter` for this chapter.
Hecks.hecksagon "Governance" do
  Governance::RoleAssignment.persisted_by("Memory")
  Governance::RoleTransition.persisted_by("Memory")
end
