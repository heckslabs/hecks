Hecks.world "Compliance" do
  realm "Examples"
  # Project-wide defaults: `default_adapter` binds each aggregate
  # compliance.hecksagon leaves out; `default_database` supplies `database`
  # for every bound adapter that takes one. A chapter's own binds still win.
  default_adapter "PostgresEra"
  default_database "postgres://localhost/hecks_compliance"

  persisted_by("PostgresEra") do
    # Runs as your shell's default (usually superuser) Postgres user; the
    # deployed stack's RDS master user is not a superuser, so this is inert there.
    allow_superuser true
  end

  # Deliberately self-contained (not Shared mode, see banking.world): this
  # domain is deployed, verified, and torn down in one session, so Shared
  # mode's idle-cost tradeoff doesn't apply here.
  deployed_to("AwsLambda") do
    region "us-east-1"
    memory 512
    timeout 10
  end
end
