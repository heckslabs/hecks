Hecks.bluebook "EmbryonautVendoringDemo" do
  vision "The smallest possible consumer of a vendored embryonaut bluebook: its own tiny aggregate (Gadget), attached beside a vendored package's own Widget (../vendor/embryonaut_bluebooks/widgets) through `attaches ... from: :vendor`, exercising the same dispatch-table merge a gem `attaches` already proves for Governance/Identity in examples/banking — see docs/decisions/0058 for what this domain exists to prove and what it deliberately does not."
  supporting

  # No reference_to the vendored Widget: reference_to is same-chapter-scoped, even across
  # a framework or vendored attachment. Gadget and Widget only share the merged dispatch table.
  aggregate "Gadget" do
    description "One gadget: registered idle, then activated once."

    attribute :name,   GadgetName
    attribute :status, GadgetStatus

    identified_by :name

    value_object("GadgetName") { attribute :value, String }

    value_object "GadgetStatus" do
      attribute :value, String, one_of: ["idle", "active"]
    end

    command "Register" do
      goal "Register a gadget, idle"

      attribute :name, GadgetName

      sets :name
      sets :status, to: "idle"

      emits GadgetRegistered
    end

    command "Activate" do
      goal "Activate a gadget — once; an already-active gadget cannot activate again"

      reference_to Gadget

      given("only an idle gadget may activate") { status.value == "idle" }

      sets :status, to: "active"

      emits GadgetActivated
    end
  end
end
