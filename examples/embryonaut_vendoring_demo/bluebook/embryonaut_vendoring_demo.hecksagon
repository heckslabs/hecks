Hecks.hecksagon "EmbryonautVendoringDemo" do
  attaches "widgets", from: :vendor

  # Memory because this is an example corpus member, not a real deployment.
  persisted_by "Memory"
end

# A vendored bluebook brings its shape, not its persistence, so Widget is bound in a sibling
# hecksagon: BindingPolicy.resolve reads the hecksagon of the aggregate's own domain.
# Memory because this is an example corpus member (see banking.hecksagon).
Hecks.hecksagon "Widgets" do
  Widgets::Widget.persisted_by("Memory")
end
