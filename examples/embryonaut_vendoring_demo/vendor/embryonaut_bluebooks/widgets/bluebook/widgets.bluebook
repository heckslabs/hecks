Hecks.bluebook "Widgets" do
  vision "A vendored package's own smallest domain: one widget, created then retired — the fewest moving parts that still exercise a vendored attaches end to end (create, refuse, retire, query)."
  supporting

  # Vendored copy kept in this repo so the corpus proof stays self-contained; a real consumer
  # would check the package out separately under its own vendor/ directory.
  aggregate "Widget" do
    description "One widget: available until retired, never the other way around."

    attribute :name,   WidgetName
    attribute :status, WidgetStatus

    identified_by :name

    value_object("WidgetName") { attribute :value, String }

    value_object "WidgetStatus" do
      attribute :value, String, one_of: ["available", "retired"]
    end

    command "Create" do
      goal "Bring a widget into existence, available"

      attribute :name, WidgetName

      sets :name
      sets :status, to: "available"

      emits WidgetCreated
    end

    command "Retire" do
      goal "Retire a widget — once; a retired widget cannot retire again"

      reference_to Widget

      given("only an available widget may retire") { status.value == "available" }

      sets :status, to: "retired"

      emits WidgetRetired
    end

    query "Available" do
      description "Widgets still available — the vendored package's own smallest read model."
      where(status: "available")
    end
  end
end
