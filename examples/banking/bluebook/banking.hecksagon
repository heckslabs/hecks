Hecks.hecksagon "Banking" do
  attaches "Governance"
  attaches "Identity"

  # Domain-level default: every aggregate inherits both binds.
  persisted_by "Heki"
  projected_by "SqliteProjection"

  # Declarative only: records that Compliance emits this across the Lambda boundary.
  # A policy below does the reacting (ADR 0025).
  subscribe "Compliance.AccountFreezeReviewOpened"
end

# Framework members bring their shape, not their persistence: a persistence bind must live
# in a hecksagon registered under the aggregate's own domain name (BindingPolicy.resolve).
# Memory here because this is an example corpus member; a real app binds durable storage.
Hecks.hecksagon "Governance" do
  Governance::RoleAssignment.persisted_by("Memory")
  Governance::RoleTransition.persisted_by("Memory")
end

Hecks.hecksagon "Identity" do
  # `Register` declares a role; Governance must be attached for the role to be checked.
  attaches "Governance"
  Identity::Identity.persisted_by("Memory")
  Identity::ExternalIdentifier.persisted_by("Memory")
end

# Compliance is deliberately not `attaches`'d: it is a standalone domain reached
# cross-Lambda through the two `across "Compliance"` policies.
