Hecks.world "Banking" do
  realm "Examples"
  # (ADR 0025) Restates the chapter's own `version: "v1"` pin on the
  # world, so an unversioned FQN resolves to it here too.
  latest "v1"
  persisted_by("Heki") do
    dir "data"
  end

  projected_by("SqliteProjection") do
    database "data/banking_projection.sqlite3"
  end

  # `deployed_to` is a generic settings-bag verb like `persisted_by`/
  # `projected_by`; WorldBuilder needed no change to support it.
  deployed_to("AwsLambda") do
    region "us-east-1"
    memory 512
    timeout 10
    # "Shared" mode: no RDS/VPC of its own, borrows `owner`'s live instance
    # under its own Postgres schema (banking.*). A stack-specific owner
    # goes in an environment overlay, not here.
    database "Shared"
    owner "Platform"
  end
end
