#!/bin/sh
#
# pre-push — the suite and the static checks must pass before anything
# leaves this machine.
#
# Used to run `bin/parity` here specifically: two runtimes, three domains,
# four stages, ~40s, deliberately kept OUT of the fast rspec loop that runs
# constantly. That FIRST comparison mechanism is retired for good
# (docs/implemented/rust-experiment.md is itself a historical record now — read its own
# top banner before citing it as current) — but Rust was restarted days
# later and is very much alive, deployed live, with its own real
# differential harness (spec/rust_conformance_spec.rb, spec/codegen_parity
# _spec.rb, spec/parser_parity_spec.rb). Those stay OUT of this fast local
# hook on purpose, same reasoning the `io: true` comment below gives for
# query_agreement_spec.rb's own narrower exception — they want a Rust
# toolchain and real build time neither belongs in a ~40s local push gate,
# so CI runs them instead (`.github/workflows/*.yml`). What's true locally
# is: the RUBY suite plus the static model checker (unreachable lifecycle
# states, dead transitions, saga states no handler chain reaches — facts
# the runtime itself never checks at dispatch time) is the "whole truth"
# check FOR RUBY; Rust's own truth is CI's job, not this hook's.
#
# Install:  git config core.hooksPath .githooks   (relative — see below)
# Bypass:   git push --no-verify   (say why — a red suite is a real answer)
#
# ROOT is resolved via `git rev-parse --show-toplevel`, NOT `dirname "$0"`.
# core.hooksPath is repo-shared config (not per-worktree), so if it's ever
# set to an ABSOLUTE path, every worktree's push would invoke this exact
# same file — and `dirname "$0"` would then resolve to wherever THAT file
# lives (one specific checkout) instead of the worktree actually doing the
# push, silently testing the wrong tree. `git rev-parse --show-toplevel`
# reflects the invoking worktree's own root regardless of how hooksPath is
# configured, so this stays correct even if that drifts again.
#
# THE 7 CHECKS BELOW RUN CONCURRENTLY, NOT IN SERIES — the CI-speed
# effort's own "stop running independent things one after another"
# principle, applied here for the first time to something that runs on a
# developer's own machine rather than in GitHub Actions. Measured serial
# baseline (warm caches): ~70s total (parallel_rspec 30.9s + spec/fuzzing
# 28.1s + query_agreement_spec 4.5s + check_engine_agreement 0.2s +
# model_check 3.0s + doc_coverage 1.8s + rubocop 1.1s). None of the 7
# reads another's output or depends on another's result — each is already
# an independent invocation today, just historically run one after
# another for no reason stronger than "that's how the script was written."
#
# REAL MEASURED WIN IS ~25-30%, NOT THE 2X A NAIVE "JUST BACKGROUND ALL
# 7" READING OF THAT PRINCIPLE WOULD PREDICT — found by timing each of
# the 7 individually under real contention on a 12-core machine, not
# assumed from the aggregate. `parallel_rspec` and `spec/fuzzing` are
# both genuinely CPU-heavy; naively running all 7 concurrently at
# `parallel_rspec`'s own default worker count (`available CPUs`) starved
# `spec/fuzzing` badly enough (28.1s → 66s in one measured run) that
# total wall-clock came out THE SAME OR WORSE than the old serial script.
# See `RSPEC_WORKERS` below for the fix (capping `parallel_rspec` to half
# the machine's cores) that actually delivered a real, measured ~52s.
#
# Each check's own stdout/stderr is captured to its own file under a
# scratch dir (same "buffer per worker, print in a fixed order once
# everyone's done" pattern `bin/qa_sweep`'s own child-output capture
# already uses) rather than streamed live — seven processes writing to
# one terminal at once would interleave into something unreadable. `wait`
# blocks until every one of the 7 has actually finished; the exit code of
# each is read back from its own file (not from `wait`'s own exit status,
# which reflects a backgrounded shell FUNCTION's return, not necessarily
# the wrapped command's — the file is the one number this script actually
# trusts) and checked explicitly, one at a time, in the SAME fixed order
# and with the SAME per-check "[pre-push] ..." header and "BLOCKED — ..."
# wording the old serial script used — a push blocked on two failures
# reports both, not just whichever happened to be checked first, because
# every one of the 7 gets its own `if` check below regardless of whether
# an earlier one already failed.

ROOT=$(git rev-parse --show-toplevel)
WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT

cd "$ROOT"

# TAG-ONLY PUSHES SKIP THE SUITE — a tag introduces no new code; every
# commit it names either already went through this exact hook on
# whatever branch push actually landed it, or reached `main` through a
# merge CI itself gated. Re-running the full ~70s local suite on every
# release tag (`bin/release_gem`'s own prerequisite) added nothing but
# wait — the content was already checked and cannot change underneath
# an existing tag.
#
# STDIN, NOT $1/$2 — pre-push's positional args are the remote name and
# URL; which refs are actually moving arrives one line per ref on
# stdin, `<local-ref> <local-oid> <remote-ref> <remote-oid>`. This hook
# never read it before this — confirmed by grep, every push, tag
# included, paid the full suite unconditionally, so `git push origin
# v1.4.0` and `git push origin main` cost the identical ~70s.
#
# ONLY SKIP IF *EVERY* PUSHED REF IS A TAG WHOSE COMMIT IS ALREADY
# REACHABLE FROM SOME REMOTE-TRACKING BRANCH — not "any tag push",
# which would let an unverified commit ride in disguised as a tag.
# `git branch -r --contains <sha>` answers "did a branch push already
# carry this exact commit past this same hook (or CI)"; a push mixing
# a tag with a branch, or tagging a commit no remote branch has ever
# carried, falls through to the full suite below exactly as before —
# a false negative here just means paying for a suite run that turns
# out to be redundant, never the reverse.
TAG_SKIP_INELIGIBLE="$WORKDIR/tag_skip_ineligible"
PUSHED_REFS=$(cat)
if [ -n "$PUSHED_REFS" ]; then
  printf '%s\n' "$PUSHED_REFS" | while IFS=' ' read -r local_ref local_oid _remote_ref _remote_oid; do
    case "$local_ref" in
      refs/tags/*)
        if git branch -r --contains "$local_oid" 2>/dev/null | grep -q .; then
          continue
        fi
        ;;
    esac
    : >"$TAG_SKIP_INELIGIBLE"
    break
  done

  if [ ! -e "$TAG_SKIP_INELIGIBLE" ]; then
    printf '[pre-push] every pushed ref is a tag on an already-verified commit — skipping the local suite.\n\n'
    exit 0
  fi
fi

# Runs one check in the background, capturing its combined output to
# "$WORKDIR/<id>.log" and its exit code to "$WORKDIR/<id>.exit". The
# whole function call is what gets backgrounded by the caller (`&`); this
# function itself always returns 0 so a failing check never trips an
# unrelated `set -e` in some future edit of this file — the REAL exit
# code lives in the `.exit` file, which is what every check below
# actually reads.
run_check() {
  id="$1"
  shift
  "$@" >"$WORKDIR/$id.log" 2>&1
  echo $? >"$WORKDIR/$id.exit"
}

exit_of() {
  cat "$WORKDIR/$1.exit" 2>/dev/null || echo 1
}

# `parallel_rspec` DELIBERATELY CAPPED TO HALF THE MACHINE'S CORES, NOT
# LEFT AT ITS OWN DEFAULT (`available CPUs`) — found live on a 12-core
# machine, not guessed: at its default worker count, `parallel_rspec`
# alone already saturates every core, so running it concurrently with
# spec/fuzzing (the other genuinely CPU-heavy step here) starved fuzzing
# badly enough that total wall-clock came out THE SAME OR WORSE than the
# old fully-serial script (~70s either way) — confirmed by timing each of
# the 7 checks individually under contention, not assumed from the
# aggregate. Capping to half the core count measured ~26% faster
# end-to-end on that same machine (~70s → ~52s) — rspec itself takes
# longer (fewer of its own workers), but that cost is smaller than the
# contention it was inflicting on fuzzing at full width. Computed at
# runtime, not hardcoded to "6", so this adapts to whatever machine
# actually runs the hook rather than assuming this one's core count.
CPU_COUNT=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)
RSPEC_WORKERS=$((CPU_COUNT / 2))
if [ "$RSPEC_WORKERS" -lt 1 ]; then
  RSPEC_WORKERS=1
fi

run_check rspec bundle exec parallel_rspec spec -n "$RSPEC_WORKERS" &
run_check fuzzing bundle exec rspec spec/fuzzing --tag fuzzing &
run_check query_agreement bundle exec rspec spec/adapters/query_agreement_spec.rb --tag io &
run_check engine_agreement "$ROOT/bin/check_engine_agreement" &
run_check model_check "$ROOT/bin/model_check" &
run_check doc_coverage "$ROOT/bin/doc_coverage" &
run_check rubocop bundle exec rubocop -c .rubocop.yml &

wait

fail=0

printf '\n[pre-push] rspec (parallel)\n\n'
cat "$WORKDIR/rspec.log"
if [ "$(exit_of rspec)" -ne 0 ]; then
  printf '\n[pre-push] BLOCKED — the suite is red.\n'
  printf '           Fix it, or push with --no-verify and say why.\n\n'
  fail=1
fi

printf '\n[pre-push] spec/fuzzing — excluded from the parallel run above like any other local rspec\n\n'

# CLOSES A REAL GAP, found rather than assumed: `parallel_rspec spec`
# above sets no CI and passes no --tag, so it excludes spec/fuzzing
# (`fuzzing: true`, spec_helper.rb) the exact same way it excludes
# `io: true` — .githooks/post-commit covers every ordinary commit, but
# a commit made with --no-verify, or one whose post-commit run was
# skipped (SKIP_POST_COMMIT_FUZZING=1), would otherwise reach a push
# having never run it at all. Re-included here explicitly, the same
# `--tag <excluded-tag>` override the io step below already uses —
# ~18-20s on its own (properties_spec.rb's own live-generated-history
# replays are most of that), the one real cost of closing this gap.
cat "$WORKDIR/fuzzing.log"
if [ "$(exit_of fuzzing)" -ne 0 ]; then
  printf '\n[pre-push] BLOCKED — spec/fuzzing is red.\n'
  printf '           Fix it, or push with --no-verify and say why.\n\n'
  fail=1
fi

printf '\n[pre-push] adapter agreement — one declared query, every engine, same answer\n\n'

# WHY THIS ONE io SPEC AND NOT THE REST. `io: true` is excluded from the
# ordinary loop (spec_helper.rb) and included when CI=true — but that tag
# also covers the Rust conformance build, the deploy-contract specs and
# the build pipeline, which want a toolchain and real cloud resources and
# have no business in a ~40s pre-push. This one is different on both
# counts: it runs in about five seconds, and it DEGRADES rather than
# skipping — PostgresProbe means Memory-vs-Sqlite agreement still runs,
# and still means something, on a machine with no local Postgres.
#
# It earns the slot because of what it catches. Four query bugs have now
# shipped where two engines answered the same declared query differently
# — `ne:` with an empty string, array `in:`, `ne:` against a null field,
# and `in` on a numeric field. Every one of them is invisible to a
# self-consistent adapter spec: each engine looked fine alone. Catching
# that on push to GitHub rather than before is catching it a day late.
cat "$WORKDIR/query_agreement.log"
if [ "$(exit_of query_agreement)" -ne 0 ]; then
  printf '\n[pre-push] BLOCKED — the engines disagree about a declared query.\n'
  printf '           One of them is wrong; a self-consistent adapter spec\n'
  printf '           cannot tell you which. Fix it, or push with --no-verify\n'
  printf '           and say why.\n\n'
  fail=1
fi

printf '\n[pre-push] engine agreement — every declared comparator, both engines\n\n'

cat "$WORKDIR/engine_agreement.log"
if [ "$(exit_of engine_agreement)" -ne 0 ]; then
  printf '\n[pre-push] BLOCKED — a comparator is missing a shared case or cross-engine spec.\n'
  printf '           Fix it, or push with --no-verify and say why.\n\n'
  fail=1
fi

printf '\n[pre-push] model check — unreachable states, dead transitions, orphaned handlers\n\n'

cat "$WORKDIR/model_check.log"
if [ "$(exit_of model_check)" -ne 0 ]; then
  printf '\n[pre-push] BLOCKED — the model checker found something.\n'
  printf '           Fix it, or push with --no-verify and say why.\n\n'
  fail=1
fi

printf '\n[pre-push] docs coverage — words with no running example\n\n'

cat "$WORKDIR/doc_coverage.log"
if [ "$(exit_of doc_coverage)" -ne 0 ]; then
  printf '\n[pre-push] BLOCKED — the language ships something undocumented.\n'
  printf '           Write the missing sections and examples, or push with\n'
  printf '           --no-verify and say why.\n\n'
  fail=1
fi

printf '\n[pre-push] rubocop — static style/correctness gate\n\n'

cat "$WORKDIR/rubocop.log"
if [ "$(exit_of rubocop)" -ne 0 ]; then
  printf '\n[pre-push] BLOCKED — rubocop found an offense.\n'
  printf '           Fix it, or push with --no-verify and say why.\n\n'
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  exit 1
fi

printf '\n[pre-push] suite green, fuzzer green, engines agree, model checks clean, every word exemplified, rubocop clean.\n\n'

# ATTESTATION — Phase 7 of the CI speed effort ("let the pre-push hook
# prove its work"): everything above this line just verified, on THIS
# machine, exactly the work CI's own `rspec_shard` and four of
# `checks_static`'s five steps (model_check, engine_agreement,
# doc_coverage, rubocop — NOT lint_deploy_recipes, which this hook never
# runs) redo from scratch on every push. A git note under refs/notes/ci,
# keyed by `HEAD^{tree}` (a TREE object note, not a commit note — see
# .github/actions/check-attestation's own header for why that's the part
# that lets this survive into a merge_group run whose commit didn't exist
# yet when this note was written), carries an HMAC over the tree hash and
# the exact check names above, signed with a secret that lives ONLY in
# this machine's own keychain and as the matching GitHub Actions secret
# (HECKS_CI_ATTEST_KEY) — nowhere else, same trust boundary a solo repo
# already extends to its own laptop. CI re-derives the same HMAC and
# skips only the checks named here; it never trusts the note's own claim
# without recomputing it.
#
# BEST-EFFORT, NEVER BLOCKING — everything below is wrapped so a missing
# keychain entry (a fresh clone, a non-macOS machine, `security` not on
# PATH) or a failed `git push` of the notes ref (no write access, offline)
# degrades to "no attestation note travels with this push," not a blocked
# push. The checks above already gated correctness; this only ever adds a
# speed optimization CI is free to ignore.
#
# `--no-verify` ON THE NOTES PUSH IS LOAD-BEARING, NOT DEFENSIVE — found
# by actually running this, not guessed: `git push` of ANY ref invokes
# pre-push again, this same file included, since core.hooksPath applies
# to every push regardless of what's being pushed. Without `--no-verify`
# here, pushing refs/notes/ci re-entered this entire script (the full
# rspec suite included) a second time before the outer push of the actual
# branch could proceed — confirmed live: a real push took two full local
# suite runs instead of one until this flag was added. The inner
# recursive call's own attestation step would in turn try to push
# refs/notes/ci YET AGAIN; that this only cost one extra run rather than
# recursing without bound was incidental (the second push found the ref
# already up to date at origin and skipped invoking the hook a third
# time) — not a guarantee worth relying on.
ATTEST_KEY=$(security find-generic-password -a "$(whoami)" -s hecks-ci-attest-key -w 2>/dev/null || true)

if [ -n "$ATTEST_KEY" ]; then
  ATTEST_TREE=$(git rev-parse HEAD^{tree})
  ATTEST_CHECKS="doc_coverage,engine_agreement,model_check,rspec,rubocop"
  ATTEST_HMAC=$(printf '%s:%s' "$ATTEST_TREE" "$ATTEST_CHECKS" | openssl dgst -sha256 -hmac "$ATTEST_KEY" -r | awk '{print $1}')

  if git notes --ref=ci add -f -m "checks=$ATTEST_CHECKS
hmac=$ATTEST_HMAC" "$ATTEST_TREE" 2>/dev/null; then
    if git push --no-verify origin refs/notes/ci >/dev/null 2>&1; then
      printf '[pre-push] attestation note written and pushed for tree %s\n\n' "$ATTEST_TREE"
    else
      printf '[pre-push] attestation note written locally but the push failed (no write access, offline, or notes ref diverged) — push proceeding without it\n\n'
    fi
  fi
else
  printf '[pre-push] no local attestation key in keychain (service "hecks-ci-attest-key") — push proceeding without a CI attestation note\n\n'
fi
