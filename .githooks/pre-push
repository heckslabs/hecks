#!/bin/sh
#
# pre-push — runs the suite and static checks concurrently; a red check blocks the push.
# Rust conformance specs need a toolchain and build time, so CI runs them, not this hook.
#
# Install:  git config core.hooksPath .githooks
# Bypass:   git push --no-verify   (say why — a red suite is a real answer)
#
# ROOT comes from `git rev-parse --show-toplevel`, not `dirname "$0"`, since an absolute
# core.hooksPath makes every worktree run this one file. The checks themselves, and why each
# one blocks, are the `pre_push` stage in lib/hecks/gate/stages.yml; every check is reported
# even if an earlier one failed. Among them, `codegen_drift` catches a Bluebook `given` changing
# with nobody rerunning `hecks build.project_rust` (ADR 0057): CI's own `checks_codegen_drift` runs
# on `pull_request` and on a push to main, after the push has landed, so this is the one local
# backstop before it.
#
# A push of only unguarded lanes (the `Lane` rows of the Vocabulary chapter: `main`) skips the
# suite, since `main` takes pushes with no gate. HECKS_PRE_PUSH_GATE=1 runs it for such a push.

ROOT=$(git rev-parse --show-toplevel)
WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT

cd "$ROOT"

# `hecks` commands journal to the Hecks domain's database unless told otherwise; a push check
# has no use for one, so it runs on Memory, as a pull-request run does in CI.
HECKS_ENVIRONMENT=${HECKS_ENVIRONMENT:-memory}
export HECKS_ENVIRONMENT

# Tag-only pushes skip the suite when every pushed ref is a tag on a commit already reachable
# from a remote-tracking branch. Pushed refs arrive on stdin, not in $1/$2.
TAG_SKIP_INELIGIBLE="$WORKDIR/tag_skip_ineligible"
PUSHED_REFS=$(cat)
if [ -n "$PUSHED_REFS" ]; then
  printf '%s\n' "$PUSHED_REFS" | while IFS=' ' read -r local_ref local_oid _remote_ref _remote_oid; do
    case "$local_ref" in
      refs/tags/*)
        if git branch -r --contains "$local_oid" 2>/dev/null | grep -q .; then
          continue
        fi
        ;;
    esac
    : >"$TAG_SKIP_INELIGIBLE"
    break
  done

  if [ ! -e "$TAG_SKIP_INELIGIBLE" ]; then
    printf '[pre-push] every pushed ref is a tag on an already-verified commit — skipping the local suite.\n\n'
    exit 0
  fi
fi

# Unguarded lanes take pushes with no gate. The lanes come from the Lane rows, not from this file,
# and a push that names any other ref (a branch, a note) is checked as before.
if [ -z "${HECKS_PRE_PUSH_GATE:-}" ] && [ -n "$PUSHED_REFS" ]; then
  UNGUARDED=$(bundle exec ruby -Ilib -e 'require "hecks/vocabulary"
    Hecks::Vocabulary.rows("Lane").select { |lane| lane["guarded"] == "no" }
      .each { |lane| puts "refs/heads/#{lane["name"]}" }' 2>/dev/null)
  if [ -n "$UNGUARDED" ]; then
    GUARDED_PUSH="$WORKDIR/guarded_push"
    printf '%s\n' "$PUSHED_REFS" | while IFS=' ' read -r _local_ref _local_oid remote_ref _remote_oid; do
      if ! printf '%s\n' "$UNGUARDED" | grep -qx "$remote_ref"; then
        : >"$GUARDED_PUSH"
        break
      fi
    done

    if [ ! -e "$GUARDED_PUSH" ]; then
      printf '[pre-push] every pushed ref is an unguarded lane — skipping the local suite (HECKS_PRE_PUSH_GATE=1 runs it).\n\n'
      exit 0
    fi
  fi
fi

# The checks are data in lib/hecks/gate/stages.yml. `hecks gate_run.gate` runs a stage's checks together and
# prints every red one, so a failure does not hide the others. The tool is called directly, not
# through the launcher, so a red check's output arrives as text and not inside a journal record
# (`hecks gate_run.gate pre_push --wait` is the recorded form).
if ! bundle exec ruby -Ilib -e 'require "hecks/tools"; Hecks::Tools.script("gate", ARGV)' pre_push; then
  printf '\n[pre-push] BLOCKED. Fix it, or push with --no-verify and say why.\n\n'
  exit 1
fi

printf '\n[pre-push] every gate check is green.\n\n'

# Attestation: a git note under refs/notes/ci, keyed by HEAD^{tree} and carrying an HMAC
# signed with the keychain key hecks-ci-attest-key, tells CI which checks it can skip.
# Best-effort: a missing key or a failed notes push never blocks the push.
#
# The notes push needs --no-verify: otherwise it re-enters this hook and reruns the suite.
ATTEST_KEY=$(security find-generic-password -a "$(whoami)" -s hecks-ci-attest-key -w 2>/dev/null || true)

# The suite above ran against the working tree, and the note vouches for HEAD's tree: the two are
# the same thing only when nothing is modified or untracked, so a dirty tree attests nothing. A
# note over code the checks never saw would let CI skip a check on a tree nobody ran it against.
ATTEST_DIRTY=$(git status --porcelain --untracked-files=normal 2>/dev/null)

if [ -n "$ATTEST_DIRTY" ]; then
  printf '[pre-push] the working tree has uncommitted changes, so the checks did not run on HEAD alone — no CI attestation note written\n\n'
elif [ -n "$ATTEST_KEY" ]; then
  ATTEST_TREE=$(git rev-parse HEAD^{tree})
  ATTEST_CHECKS="doc_coverage,engine_agreement,model_check,rspec,rubocop"
  ATTEST_HMAC=$(printf '%s:%s' "$ATTEST_TREE" "$ATTEST_CHECKS" | openssl dgst -sha256 -hmac "$ATTEST_KEY" -r | awk '{print $1}')

  if git notes --ref=ci add -f -m "checks=$ATTEST_CHECKS
hmac=$ATTEST_HMAC" "$ATTEST_TREE" 2>/dev/null; then
    if git push --no-verify origin refs/notes/ci >/dev/null 2>&1; then
      printf '[pre-push] attestation note written and pushed for tree %s\n\n' "$ATTEST_TREE"
    else
      printf '[pre-push] attestation note written locally but the push failed (no write access, offline, or notes ref diverged) — push proceeding without it\n\n'
    fi
  fi
else
  printf '[pre-push] no local attestation key in keychain (service "hecks-ci-attest-key") — push proceeding without a CI attestation note\n\n'
fi
