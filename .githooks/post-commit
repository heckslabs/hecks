#!/bin/sh
#
# post-commit: runs the `post_commit` stage of lib/hecks/gate/stages.yml (spec/fuzzing) after each
# commit, outside the interactive spec loop. A failure is reported but cannot block the commit;
# pre-push re-runs it as a backstop.
#
# Install:  git config core.hooksPath .githooks
# Skip once: SKIP_POST_COMMIT_FUZZING=1 git commit ...

if [ -n "$SKIP_POST_COMMIT_FUZZING" ]; then
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel)

printf '\n[post-commit] gate stage post_commit (spec/fuzzing)\n\n'

# The tool is called directly, as pre-push does, so a red check's output arrives as text.
if ! (cd "$ROOT" && bundle exec ruby -Ilib -e 'require "hecks/tools"; Hecks::Tools.script("gate", ARGV)' post_commit); then
  printf '\n[post-commit] the post_commit stage is RED -- this commit is already made.\n'
  printf '              Fix it before your next push, or bypass permanently\n'
  printf '              per-commit with SKIP_POST_COMMIT_FUZZING=1.\n\n'
  exit 0
fi

printf '\n[post-commit] the post_commit stage is green.\n\n'
