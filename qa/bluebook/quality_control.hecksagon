# Live wiring for the QualityControl ledger, persisted through PostgresEra.
# The bluebook, its ports and its adapters ship in lib/hecks/quality_control/; this directory holds
# what belongs to this repository's QA practice: the wiring below, the sibling quality_control.world
# (the database name), the era's translations/ and the Governance binds in context_map.hecksagon.
Hecks::FrameworkBluebooks.load!("QualityControl")

Hecks.hecksagon "QualityControl" do
  attaches "Governance"
  attaches "Coder"
  attaches "Fixer"

  QualityControl::Target.persisted_by("PostgresEra")
  QualityControl::Sweep.persisted_by("PostgresEra")
  QualityControl::Bug.persisted_by("PostgresEra")
  QualityControl::Angle.persisted_by("PostgresEra")
  QualityControl::Ticket.persisted_by("PostgresEra")
  QualityControl::Patch.persisted_by("PostgresEra")
  QualityControl::Improvement.persisted_by("PostgresEra")
  QualityControl::DailyQuota.persisted_by("PostgresEra")
  QualityControl::Clearance.persisted_by("PostgresEra")
  QualityControl::MainCheck.persisted_by("PostgresEra")
  QualityControl::EventCursor.persisted_by("PostgresEra")
  QualityControl::EventReaction.persisted_by("PostgresEra")
  QualityControl::Maintenance.persisted_by("PostgresEra")
end

# The Fixer's wiring, declared in the Fixer's own block. Its attempts persist through PostgresEra,
# so the event pump reads them across processes; fixer.world names the database they land in.
Hecks.hecksagon "Fixer" do
  attaches "Governance"
  persisted_by "Memory"
  Fixer::Attempt.persisted_by("PostgresEra")
end
