# THE LIVE LEDGER'S OWN WIRING — separate from `spec/quality_control_spec.rb`'s
# inline `Hecks.hecksagon` block, which re-declares this same shape bound to
# Memory for fast, isolated tests (see that spec's own header on why). This
# file is what a real boot (`bin/model_check`, and eventually a running QA
# loop) reads.
#
# `PostgresEra`, NOT `Heki` — moved by `bin/qa_postgres_migrate` (see that
# script's own header) so the ledger's own history (a Sweep's checks, a
# Bug's tags, an Angle's backlog) survives in a real database rather than
# one worktree's own untracked `qa/data/*.heki` files. `quality_control.
# world` (sibling file) names the actual database — this file, like every
# other real domain's own `.hecksagon` (`examples/pizzas`, `examples/
# chess`, `examples/roster`, `examples/directory`), names only the
# adapter, never the connection.
Hecks.hecksagon "QualityControl" do
  uses_framework "Governance"

  QualityControl::Target.persisted_by("PostgresEra")
  QualityControl::Sweep.persisted_by("PostgresEra")
  QualityControl::Bug.persisted_by("PostgresEra")
  QualityControl::Angle.persisted_by("PostgresEra")
  QualityControl::Ticket.persisted_by("PostgresEra")
  QualityControl::Clearance.persisted_by("PostgresEra")

  # THE OUTSIDE WORLD, THROUGH A SWAPPABLE ADAPTER — no adapter is bound
  # here (deliberately dormant; see the loop's own design notes on why:
  # no GitHub issues are filed on Ticket's behalf yet). Declaring the port
  # is still real: it is what lets `Ticket.Submit` name a target for
  # `FileWhenSubmitted`'s policy to trigger, and what `bin/model_check`'s
  # deaf-policy check reads this file FOR.
  QualityControl::Ticket.port "IssueTracker" do
    asks "File", to: Ticket do
      answers "IssueFiled"
      refuses "IssueFilingRefused"
    end

    tells "Closed", to: Ticket do
      emits "IssueClosedUpstream"
    end
  end

  # BOUND, FOR REAL — `GithubChecks` (`qa/adapters/github_checks.{rb,
  # adapter}`) shells to `gh api repos/{owner}/{repo}/commits/<sha>/
  # check-runs` and answers or refuses accordingly. `Folder#load_project`
  # discovers it on its own: `qa/` is the nearest ancestor of this file
  # carrying an `adapters/` directory, so any real `Hecks.boot` under here
  # picks it up without a line in this file naming it — the same "an
  # adapter is bound by declaring `port "X"`, nothing wired here" shape
  # `IssueTracker`'s own comment above describes, except this one actually
  # is bound. `bin/qa_pr_check` is what dispatches `Clearance.CI.Run`; the
  # two policies at the foot of `quality_control.bluebook` (`ClearOnPass`,
  # `RefuseOnFail`) are what turn its answer or refusal into
  # `Clearance::Passed`/`Failed` — no direct dispatch of either left
  # anywhere in this ledger's own tooling.
  QualityControl::Clearance.port "CI" do
    asks "Run", to: Clearance do
      answers "SuitePassed"
      refuses "SuiteFailed"
    end
  end
end
