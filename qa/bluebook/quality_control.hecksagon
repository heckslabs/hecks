# Live wiring for the QualityControl ledger, in Postgres's revision layout.
# The bluebook, its ports and its adapters ship in lib/hecks/quality_control/; this directory holds
# what belongs to this repository's QA practice: the wiring below, the sibling quality_control.world
# (the database name), the era's translations/ and the Governance binds in context_map.hecksagon.
Hecks.hecksagon "QualityControl" do
  bluebook_from :gem
  attaches "Governance"
  attaches "Coder"
  attaches "Fixer"
  attaches "EventDelivery"

  QualityControl::Target.persisted_by("Postgres")
  QualityControl::Sweep.persisted_by("Postgres")
  QualityControl::Bug.persisted_by("Postgres")
  QualityControl::Angle.persisted_by("Postgres")
  QualityControl::Ticket.persisted_by("Postgres")
  QualityControl::Patch.persisted_by("Postgres")
  QualityControl::Improvement.persisted_by("Postgres")
  QualityControl::DailyQuota.persisted_by("Postgres")
  QualityControl::Clearance.persisted_by("Postgres")
  QualityControl::MainCheck.persisted_by("Postgres")
  QualityControl::Maintenance.persisted_by("Postgres")
  revisions true
end

# The Fixer's wiring, declared in the Fixer's own block. Its attempts persist in Postgres's revision layout,
# so the event pump reads them across processes; fixer.world names the database they land in.
Hecks.hecksagon "Fixer" do
  attaches "Governance"
  persisted_by "Memory"
  Fixer::Attempt.persisted_by("Postgres")
  revisions true
end

# The event pump's rows, EventDelivery's since ADR 0178: each consumer's cursor, each reaction
# recorded once, and each pump run. event_delivery.world names the database they land in.
Hecks.hecksagon "EventDelivery" do
  attaches "Governance"
  persisted_by "Memory"
  EventDelivery::Consumer.persisted_by("Postgres")
  EventDelivery::Reaction.persisted_by("Postgres")
  EventDelivery::Pump.persisted_by("Postgres")
  revisions true
end
