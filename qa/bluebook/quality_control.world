# THE LEDGER'S OWN CONNECTION — sibling to `quality_control.hecksagon`
# (which names only the adapter, `PostgresEra`) the same way `examples/
# pizzas/bluebook/pizzas.world` sits beside `pizzas.hecksagon`. `database`
# is read once, by `RepositoryFactory.build`, and merged into every
# QualityControl aggregate's own adapter settings — see `postgres_era.rb`'s
# own `connect_for` for why a bare dbname resolves through the local
# Postgres socket exactly the way `psql hecks_quality_control` already
# would, no URI required.
#
# `hecks_quality_control`, not the shorter `hecks_qa` the five template
# domains' own `hecks_<name>` naming might suggest — QualityControl is
# this repo's own PascalCase domain name, snake_cased in full, the same
# derivation `postgres_era.rb`'s own `@domain` default already uses
# (`aggregate.hecks_owner&.name`) for the journal/lock namespace this
# database holds. Matching it in the database name too means a `psql -l`
# reader can find this domain's own data by the same name the runtime
# itself already calls it internally.
#
# CHECK THIS NAME IS ACTUALLY FREE BEFORE YOUR FIRST REAL BOOT. A local
# Postgres on this same machine may already hold a database by this exact
# name from an earlier, unrelated experiment (`psql -l` to check) — found,
# live, during this binding's own migration work: `hecks_quality_control`
# already existed with `hecks_era_texts` rows old enough that shadow-
# parsing them against TODAY's grammar fails outright — confirmed live,
# 2026-09-10: five stale eras held from this binding's own earlier manual
# testing, all still spelling a hop query the PRE-ADR-0025 way
# (`where(:"bug.status" => ...)`, a dot — the reference-crossing operator
# is `/` now) which is not one of the "genuinely removed spellings"
# shadow-parsing exists to keep readable (`identified_by { }`/
# `belongs_to`/`has_one`/`has_many`, and `reference_to`'s default-naming
# fork — see `Runtime::EraGuard.shadow_parse`'s own comment), so it
# refuses loudly under the shadow/legacy fallback too, exactly like a
# live boot. Not a shape PostgresEra's own translation machinery can
# reconcile, because the DSL itself moved on, not just the domain. `bin/
# run qa/bluebook --help` refuses to boot at all against a database in
# that state. If `psql -l` shows this name already taken and boot refuses
# the same way, the fix is `dropdb hecks_quality_control` (empty of
# anything you want kept — confirm what it actually holds first), THEN
# `createdb hecks_quality_control` (PostgresEra provisions every TABLE it
# needs on first connect, idempotently, but never the database itself —
# `PG.connect(dbname: ...)` fails outright against a name with no
# database behind it at all), then reboot; renaming this setting to a
# still-free name works too.
Hecks.world "QualityControl" do
  realm "QA"
  persisted_by("PostgresEra") do
    database "hecks_quality_control"
  end

  # THE REAL, LIVE DEPLOY — the GitHub webhook driving adapter
  # (lib/hecks/adapters/driving/github_webhook.rb's own generic base,
  # qa/adapters/github_ci_webhook.rb's own QualityControl-specific
  # subclass) made reachable from GitHub for real, through the SAME
  # `bin/project_deploy` projection every other AwsLambda deploy in this
  # repo already goes through — never a hand-rolled one-off script; see
  # that generator's own header for the mechanism this extends.
  #
  # `dispatch "None"` — this domain has no `.bluebook`-shaped command
  # surface dispatched through rust/host's wasmtime host at all (no
  # `#{domain}.hecksagon`, no compiled `.wasm`); every real command this
  # webhook ever issues (`QualityControl::Clearance.start!`/`.passed!`/
  # `.failed!`) goes straight through Ruby, the same way `bin/qa_pr_check`
  # already does locally. So there is nothing for a rust/host dispatch
  # Lambda to ever serve — `dispatch "None"` skips generating one
  # entirely, and `qa/lambda_handler.rb` (this domain's own hand-written
  # driving-adapter wrapper, the SAME "opt-in by file presence"
  # convention Embryonaut's own `lambda_handler.rb` already established)
  # becomes this stack's ONLY Lambda.
  #
  # `handler_module "QaWebhookLambdaHandler"` — names the module
  # `qa/lambda_handler.rb` actually defines, so `bin/project_deploy`
  # never has to guess it.
  #
  # `secret_env "GITHUB_WEBHOOK_SECRET"` — a real, auto-generated (never
  # typed, never committed) Secrets Manager secret gets minted for this
  # deploy target and wired into the Lambda's own environment as
  # `GITHUB_WEBHOOK_SECRET_ARN`; `qa/lambda_handler.rb` fetches it at
  # cold start, over the SDK, and exposes the plaintext under
  # `ENV["GITHUB_WEBHOOK_SECRET"]` — never resolved into CloudFormation
  # or Lambda's own configuration, matching every other secret this
  # generator already handles this way (DATABASE_URL, SESSION_SECRET,
  # GOOGLE_CLIENT_ID/SECRET).
  #
  # "Postgres" (bin/project_deploy's own default) — a small, dedicated,
  # self-contained RDS instance for this domain alone; QualityControl's
  # own real, live ledger has no reason to borrow another domain's
  # instance ("Shared") or pay for Aurora Serverless.
  deployed_to("AwsLambda") do
    # NAMED EXPLICITLY, not left to default to "qa" (this domain's own
    # directory basename) — `hecks-quality-control-webhook`, clearly
    # identifiable and safely removable as its own stack, matching this
    # domain's own PascalCase-snake_cased database name convention
    # (this file's own header comment) rather than its shorter directory
    # name.
    stack_name "quality-control-webhook"
    region "us-east-1"
    # 1769MB/30s -- `dispatch "None"` makes bin/project_deploy read
    # THESE two directly for WebFunction's own MemorySize/Timeout
    # (every OTHER WebFunction still hardcodes 512/15; that pair only
    # means something real once WebFunction is a domain's SOLE Lambda —
    # see bin/project_deploy's own comment on the WebFunction Properties
    # block for the full reasoning). 1769MB (Lambda's own documented
    # "a full vCPU" threshold), not 512 -- `Hecks.boot`'s own real
    # cold-start cost (every bluebook parsed fresh — this domain's own
    # PLUS the whole framework's) is genuinely CPU-bound, and AWS
    # Lambda allocates CPU proportional to memory; 512MB (a small
    # fraction of one vCPU) still hadn't finished after 30s, confirmed
    # live via `aws logs tail` (`Init ... Status: timeout`, twice).
    memory 1769
    timeout 30
    database "Postgres"
    dispatch "None"
    handler_module "QaWebhookLambdaHandler"
    secret_env "GITHUB_WEBHOOK_SECRET"
  end
end
