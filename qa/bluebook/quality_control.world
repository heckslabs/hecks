# Connection for the QualityControl ledger; the sibling .hecksagon names only the adapter.
# Run `exe/hecks quality_control query sweep.create_ledger_role database.value=hecks_quality_control` once before the first boot.
Hecks.world "QualityControl" do
  realm "QA"
  # Connects as the ordinary role hecks_qa: a superuser bypasses the era write-fence
  # (row-level security), so the boot refuses one. hecks_qa owns the database.
  persisted_by("PostgresEra") do
    database "postgres://hecks_qa@localhost/hecks_quality_control"
  end

  # GitHub webhook deploy. There is no rust/host command surface here, so
  # qa/lambda_handler.rb is the stack's only Lambda. An auto-generated (never
  # typed, never committed) Secrets Manager secret gets minted for this
  # target; the handler reads it at cold start.
  deployed_to("AwsLambda") do
    stack_name "quality-control-webhook"
    region "us-east-1"
    # Unused for dispatch "None", but Deploy::LambdaTarget.Declare validates all four.
    memory 512
    timeout 15
    database "Postgres"
    dispatch "None"
    handler_module "QaWebhookLambdaHandler"
    secret_env "GITHUB_WEBHOOK_SECRET"
  end
end
