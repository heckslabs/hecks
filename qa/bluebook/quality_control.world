# Connection for the QualityControl ledger; the sibling .hecksagon names only the adapter.
# Run `exe/hecks quality_control query sweep.create_ledger_role database.value=hecks_quality_control` once before the first boot.
Hecks.world "QualityControl" do
  realm "QA"
  # Connects as the ordinary role hecks_qa: a superuser bypasses the era write-fence
  # (row-level security), so the boot refuses one. hecks_qa owns the database.
  # `mint_eras` is off: the Maintenance mint command turns it on for the one mint it runs, and a boot
  # of this world never mints, whatever the setting says.
  persisted_by("PostgresEra") do
    database "postgres://hecks_qa@localhost/hecks_quality_control"
    mint_eras false
  end
  # How far local main may drift from origin/main before each tick files the `push-due` Work row:
  # commits ahead, or hours since the oldest unpushed commit. A red last rehearsal on the current main
  # files it whatever these say. Without this line the thresholds are
  # `Hecks::Adapters::PushDueReader::DEFAULTS`, the same numbers.
  push_nudge "PushDueReader", commits: 20, hours: 24
  # The rehearsal reads a throwaway copy of the ledger, named by an environment variable so the
  # file holds no connection string; the copy is made beforehand and is never this database.
  rehearsed_by("Postgres") do
    connection_env "HECKS_QC_REHEARSAL_URL"
    mode "readonly_copy"
  end
end
