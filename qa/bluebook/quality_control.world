# Connection for the QualityControl ledger; the sibling .hecksagon names only the adapter.
# Run `exe/hecks quality_control query sweep.create_ledger_role database.value=hecks_quality_control` once before the first boot.
Hecks.world "QualityControl" do
  realm "QA"
  # Connects as the ordinary role hecks_qa: a superuser bypasses the era write-fence
  # (row-level security), so the boot refuses one. hecks_qa owns the database.
  persisted_by("PostgresEra") do
    database "postgres://hecks_qa@localhost/hecks_quality_control"
  end
end
