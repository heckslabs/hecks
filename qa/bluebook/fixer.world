# The Fixer's own database for its attempts (quality_control.hecksagon binds them to Postgres): a
# separate era and lineage from the QualityControl ledger's. Create it once before the first boot:
# `createdb -O hecks_qa hecks_fixer`.
Hecks.world "Fixer" do
  # Connects as the ordinary owner role hecks_qa (the boot refuses a superuser, which bypasses the
  # era write-fence). A disposable ledger that mints no eras: the boot applies a changed shape
  # itself, additive in place, breaking archived. See quality_control.world.
  persisted_by("Postgres") do
    database "postgres://hecks_qa@localhost/hecks_fixer"
    mint_eras false
    disposable_ledger true
  end
end
