# Second bluebook of the CaseEscalation stress domain, reached only through its `across` policy.
# Loaded into the same registry for in-process fuzzing; Ruby-only, not compiled to Rust.
Hecks.bluebook "VendorCompliance" do
  vision "One compliance review opened per vendor once one of its invoices is amended, with notes a compliance officer attaches — and a read model gathering a review together with its own notes, over a bluebook reached only by another domain's cross-domain policy."

  core

  aggregate "Review" do
    description "One compliance review opened against a vendor whose invoice was amended."

    identified_by :vendor

    attribute :vendor, Handle
    attribute :invoice, InvoiceReference

    value_object "Handle" do
      attribute :value, String, matches: :present
      invariant("a handle is not blank") { !value.to_s.empty? }
    end

    # Redeclared locally: this bluebook only sees the plain string from the event payload.
    value_object "InvoiceReference" do
      attribute :value, String, matches: :present
      invariant("an invoice reference is not blank") { !value.to_s.empty? }
    end

    lifecycle :status, default: "open" do
      transition "Close" => "closed", from: "open"
      mark :terminal, "closed"
    end

    # The policy has no with_spec, so the command must declare every key of the
    # ChargeAmended payload (both vendor and invoice) or the dispatch is refused.
    command "Open" do
      goal "Open a compliance review against a vendor"

      attribute :vendor, Handle, sets: true
      attribute :invoice, InvoiceReference, sets: true


      emits "ReviewOpened"
    end

    command "Close" do
      goal "Close a compliance review"

      reference_to Review

      emits "ReviewClosed"
    end

    query "All" do
      description "Every compliance review ever opened."
      order_by :vendor
    end
  end

  aggregate "Note" do
    description "A note attached to a review, by a compliance officer."

    identified_by :reference

    attribute :reference, NoteReference
    reference_to Review
    attribute :body, Body

    value_object "NoteReference" do
      attribute :value, String, matches: :present
      invariant("a note reference is not blank") { !value.to_s.empty? }
    end

    value_object "Body" do
      attribute :value, String, matches: :present
      invariant("a note body is not blank") { !value.to_s.empty? }
    end

    command "Attach" do
      goal "Attach a note to a review"

      attribute :reference, NoteReference, sets: true
      reference_to Review
      attribute :body, Body

      sets :review
      sets :body

      emits "NoteAttached"
    end
  end

  read_model "ReviewBoard" do
    description "One review and every note attached to it — the working set a compliance officer opens, gathered over a bluebook reached only by another domain's cross-domain policy."
    reference_to Review
    include Review
    include Note
  end
end
